    pageItem P175_USUARIO (
        type: popupLov
        label {
            label: Atendente
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) display_value
                     , u.usuario return_value
                from usuarios u      
                   , pessoas p
                where u.idgerente in (29, 80) -- Samuel, Adina
                  and u.idpessoa = p.idpessoa
                 -- and p.ativo = 'S'
                 -- and u.ativo = 'S'
                order by 1 
                ```
        }
        layout {
            sequence: 60
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        validation {
            maxLength: 4000
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button p175-filtrar (
        buttonName: P175_FILTRAR
        label: Filtrar
        layout {
            sequence: 90
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-filter
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: P152_FILTRAR
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 100
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-reply
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 94
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item!=value
            item: P175_ORIGEM
            value: 68
        }
    )

    button voltar-pedido (
        buttonName: VOLTAR_PEDIDO
        label: Pedido
        layout {
            sequence: 110
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-reply
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 68
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P175_ORIGEM
            value: 68
        }
    )

    process limpar-campo-ao-sair (
        name: Limpar Campo ao Sair
        type: clearSessionState
        clear {
            type: items
            items: P175_ORIGEM
        }
        execution {
            sequence: 10
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 789879409651628802
        }
    )

    branch (
        name: filtrar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 175
                items: {
                    P175_TELEFONE: &P175_TELEFONE.
                    P175_USUARIO: &P175_USUARIO.
                    P175_DATAINICIO: &P175_DATAINICIO.
                    P175_DATAFIM: &P175_DATAFIM.
                    P175_IDVENDEDORA: &P175_IDVENDEDORA.
                    P175_IDTAREFA: &P175_IDTAREFA.
                    P175_BUSCAR: S
                }
                successMessage: false
            }
        }
    )

)

