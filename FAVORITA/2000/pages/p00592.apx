page 592 (
    name: Incluir SubRemessas
    title: Incluir SubRemessas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG_27"';
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region incluir-subremessas (
        name: Incluir SubRemessas
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P592_DATAABERTURA (
        type: displayOnly
        label {
            label: Data Abertura
            alignment: left
        }
        layout {
            sequence: 40
            region: @incluir-subremessas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: DATAABERTURA
            used: always
        }
        default {
            type: expression
            plsqlExpression: to_char(systimestamp,'dd/mm/rrrr hh24:mi:ss')
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P592_DATAFECHAMENTO (
        type: displayOnly
