    pageItem P592_IDREMESSA (
        type: selectList
        label {
            label: Remessa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select descricao d,
                       idremessa r
                  from remessas
                 order by 1
                ```
        }
        layout {
            sequence: 20
            region: @incluir-subremessas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDREMESSA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

