    process precos-originais (
        name: Precos Originais
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vvalorvenda               number;
                  vperccomissaoconsultora   number;
                  vperccomissaodistribuidor number;
                  vperccomissaogerente      number;
                  --
                begin
                  --
                  for rprec in ( select pik.valorvendaoriginal,
                                        pik.perccomissaogerente,
                                        pik.perccomissaodistribuidor,
                                        pik.perccomissaoconsultora,
                                        pik.valorcomissaoatendente,
                                        pik.idedicaorevista,
                                        i.idprodutodetalhado,
                                        1 idpais,
                                        pik.idprecoitemkitvenda
                                 from favorita.precositenskitsvendas pik
                                    , favorita.itenskitsvendas i
                                 where pik.iditemkitvenda = i.iditemkitvenda 
                                   and i.idkitvenda = :P66_IDKITVENDA)
                  loop
                    --
                    select a.a.valorvenda
                     , a.a.perccomissaoconsultora
                     , a.a.perccomissaodistribuidor
                     , a.a.perccomissaogerente
                    into 
                       vvalorvenda
                     , vperccomissaoconsultora
                     , vperccomissaodistribuidor
                     , vperccomissaogerente
                    from(
