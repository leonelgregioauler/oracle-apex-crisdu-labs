    validation valida-atualizar-itens-ligados-a-pedidos-não-cancelados (
        name: Valida Atualizar Itens Ligados a Pedidos Não Cancelados
        execution {
            sequence: 80
        }
        validation {
            editableRegion: @itens-kits-vendas
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  vexist number;
                  --
                begin  
                     case :APEX$ROW_STATUS  
                     when 'C' then
                       --
                       select count(1)
                       into vexist
                       from favorita.kitsvendas k
                          , favorita.itenskitsvendas i
                          , favorita.itenspedidos ii
                          , favorita.pedidos p
                       where k.idkitvenda = i.idkitvenda
                         and i.idprodutodetalhado = ii.idprodutodetalhado
                         and ii.idkitvenda = k.idkitvenda
                         and ii.idpedido = p.idpedido
                         and p.datacancelamento is null
                         and k.idkitvenda = :P66_IDKITVENDA;
                       --
                       if vexist > 0 then
                         --
                         return 'Kit ja esta ligado a pedidos não cancelados';
                         --
                       end if;
                       --
                     when 'U' then  
                       --
                       select count(1)
                       into vexist
                       from favorita.kitsvendas k
                          , favorita.itenskitsvendas i
                          , favorita.itenspedidos ii
                          , favorita.pedidos p
                       where k.idkitvenda = i.idkitvenda
                         and i.idprodutodetalhado = ii.idprodutodetalhado
                         and ii.idkitvenda = k.idkitvenda
                         and ii.idpedido = p.idpedido
                         and p.datacancelamento is null
                         and k.idkitvenda = :P66_IDKITVENDA;
                       --
                       if vexist > 0 then
                         --
                         return 'Kit ja esta ligado a pedidos não cancelados';
                         --
                       end if;
                       --
                     when 'D' then  
                       --
                       select count(1)
                       into vexist
                       from favorita.kitsvendas k
                          , favorita.itenskitsvendas i
                          , favorita.itenspedidos ii
                          , favorita.pedidos p
                       where k.idkitvenda = i.idkitvenda
                         and i.idprodutodetalhado = ii.idprodutodetalhado
                         and ii.idkitvenda = k.idkitvenda
                         and ii.idpedido = p.idpedido
                         and p.datacancelamento is null
                         and k.idkitvenda = :P66_IDKITVENDA;
                       --
                       if vexist > 0 then
                         --
                         return 'Kit ja esta ligado a pedidos não cancelados';
                         --
                       end if;
                       --
                     end case;  
                end;
                ```
        }
        serverSideCondition {
            type: never
        }
    )

    process ajuste-precos-virtual (
        name: Ajuste Precos Virtual
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  vidkitvenda      number := :P66_IDKITVENDA;
                  --
                  vidprodutodetzerado number;
                  vcustoprodzerado    number;
                  vvalordescontar     number;
                  vidprecokitzerado   number;
                  --
                  vvalorconsultoraant number;
                  vvalorconsultorapos number;
                  vvalorconsultora    number;
                  vqtditensnzerados   number;
                  --
                  vexistezerado       number;
                  --
                begin
                  --
                  for rrev in ( select distinct p.idedicaorevista
                                from favorita.precositenskitsvendas p
                                   , favorita.itenskitsvendas i 
                                where i.iditemkitvenda = p.iditemkitvenda
                                  and i.idkitvenda =  vidkitvenda)
                  --
                  loop
                    --
                    begin 
                      --
                    select i.idprodutodetalhado
                         , p.idprecoitemkitvenda
                      into vidprodutodetzerado
                         , vidprecokitzerado
                    from favorita.precositenskitsvendas p
                       , favorita.itenskitsvendas i 
                    where i.iditemkitvenda = p.iditemkitvenda
                      and i.idkitvenda =  vidkitvenda
                      and p.idedicaorevista =  rrev.idedicaorevista
                      and p.valorvenda = 0;
                      --
                      vexistezerado := 1;
                      --
                    exception
                      when others then
                        --
                        vexistezerado := 0;
                        --
                    end;
                    --
                    if vexistezerado = 1 then
                      --
                      begin
                        --
                        select pp.valorcusto
                        into vcustoprodzerado
                        from favorita.precosprodutos pp
                        where pp.idprodutodetalhado = vidprodutodetzerado
                          and pp.idedicaorevista = rrev.idedicaorevista
                          and pp.idfilialromance = 100;
                        --
                      exception
                        when others then
                          --
                          select prd.valorcusto
                          into vcustoprodzerado
                          from precosprodutos prd
                          where prd.idprecoproduto = ( select max(idprecoproduto)
                                                       from precosprodutos pp
                                                       where pp.idprodutodetalhado = vidprodutodetzerado
                                                         and pp.valorcusto         is not null );
                          --
                      end;
                      --
                      select round(sum((p.valorvenda -(p.valorvenda * p.perccomissaoconsultora/100) * i.quantidade)),2) valor_consultora
                      into vvalorconsultoraant
                      from favorita.itenskitsvendas i
                         , favorita.precositenskitsvendas p
                      where i.iditemkitvenda = p.iditemkitvenda
                        and i.idkitvenda = vidkitvenda
                        and p.idedicaorevista = rrev.idedicaorevista;
                      --
                      select count(1)
                      into vqtditensnzerados
                      from favorita.itenskitsvendas i
                         , favorita.precositenskitsvendas p
                      where i.iditemkitvenda = p.iditemkitvenda
                        and i.idkitvenda = vidkitvenda
                        and p.valorvenda > 0
                        and p.idedicaorevista = rrev.idedicaorevista;
                      --
                      vvalordescontar := vcustoprodzerado + round(vcustoprodzerado/2,2);
                      --
                      vvalordescontar := round(vvalordescontar/vqtditensnzerados);
                      --
                      update favorita.precositenskitsvendas pi
                         set pi.valorvenda = (vcustoprodzerado + round(vcustoprodzerado/2,2))
                      where pi.idprecoitemkitvenda = vidprecokitzerado;
                      --
                      for rprec in ( select p.idprecoitemkitvenda
                                     from favorita.itenskitsvendas i
                                        , favorita.precositenskitsvendas p
                                     where i.iditemkitvenda = p.iditemkitvenda
                                       and i.idkitvenda = vidkitvenda
                                       and p.valorvenda > 0
                                       and p.idedicaorevista = rrev.idedicaorevista)
                      --
                      loop
                        --
                        update favorita.precositenskitsvendas p
                           set p.valorvenda = (p.valorvenda - vvalordescontar)
                        where p.idprecoitemkitvenda = rprec.idprecoitemkitvenda;
                        --
                        --commit;
                        --
                      end loop;
                      --
                      select round(sum((p.valorvenda -(p.valorvenda * p.perccomissaoconsultora/100) * i.quantidade)),2) valor_consultora
                      into vvalorconsultorapos
                      from favorita.itenskitsvendas i
                         , favorita.precositenskitsvendas p
                      where i.iditemkitvenda = p.iditemkitvenda
                        and i.idkitvenda = vidkitvenda
                        and p.idedicaorevista = rrev.idedicaorevista;
                      --
                      vvalorconsultora := vvalorconsultoraant - vvalorconsultorapos;
                      --
                      
                      --
                      update favorita.precositenskitsvendas pi
                         set pi.valorvenda = (pi.valorvenda + vvalorconsultora)
                      where pi.idprecoitemkitvenda = vidprecokitzerado;
                      --
                    end if;
                    --
                  end loop;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 90
        }
        advanced {
            executionMappingIdentifier: 113382144411208711
        }
        serverSideCondition {
            type: request=Value
            value: AJUSTE_PRECOS_VIRTUAL
        }
    )

