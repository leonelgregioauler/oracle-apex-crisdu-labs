    process operação-dml-em-kits-vendas (
        name: Operação DML em Kits Vendas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  :P66_FILIAISROMANCE := replace(:P66_FILIAISROMANCE,':',',');
                  --
                  PCK_CADASTROS_FAV.PRC_KITSVENDAS ( PIDKITVENDA       => :P66_IDKITVENDA
                                                   , PREFERENCIA       => :P66_REFERENCIA
                                                   , PDESCRICAO        => :P66_DESCRICAO
                                                   , PIDFILIALFAVORITA => :P66_IDFILIALFAVORITA
                                                   , PIDCATEGORIA      => :P66_IDCATEGORIA
                                                   , PHABILITARPARA    => :P66_HABILITARPARA
                                                   , PIDFILIALROMANCE  => :P66_IDFILIALROMANCE
                                                   , PFILIAISROMANCE   => :P66_FILIAISROMANCE
                                                   , PKITCAMPANHA      => :P66_KITCAMPANHA
                                                   , PDATAINICIAL      => :P66_DATAINICIAL
                                                   , PDATAFINAL        => :P66_DATAFINAL
                                                   , PCODIGOVIRTUALAGE => :P66_CODIGOVIRTUALAGE
                                                   , PIDENTIFICADORECOMMERCE => :P66_IDENTIFICADORECOMMERCE
                                                   , PMD5              => :P66_MD5
                                                   , POPERACAO_DML     => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 252456565833675127
        }
    )

