                                                                                         , pidprodutodetalhado => rprec.idprodutodetalhado
                                                                                         , pidpais             => rprec.idpais) a
                    from dual)a;
                    --
                    update precositenskitsvendas pik
                      set pik.valorvendaoriginal       = vvalorvenda
                        , pik.valorvenda               = vvalorvenda 
                        , pik.perccomissaoconsultora   = vperccomissaoconsultora
                        , pik.perccomissaodistribuidor = vperccomissaodistribuidor
                        , pik.perccomissaogerente      = vperccomissaogerente
                    where pik.idprecoitemkitvenda = rprec.idprecoitemkitvenda;
                    --
                    commit;
                    --
                  end loop;
                  --
                end;
