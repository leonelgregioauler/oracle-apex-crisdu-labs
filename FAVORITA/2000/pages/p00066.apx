page 66 (
    name: Cadastro de Kits Vendas
    title: Cadastro de Kits Vendas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    htmlHeader {
        htmlHeader:
            ```html
            <style>
              
                .caixa {
                    display: none;
                }
             
            
            </style>
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region itens-kits-vendas (
        name: Itens Kits Vendas
        type: tabform
        source {
            sqlQuery:
                ```sql
                select iditemkitvenda
                     , idkitvenda
                     , idprodutodetalhado
                     , quantidade 
                       -- , '<a href=javascript:apex.submit({request:''GERARPRECOS'',set:{''P66_IDITEMKITVENDA'':'||IDITEMKITVENDA||'}});><img src=/i/menu/pencil16x16.gif alt=Gerar Código border=0 width=16 height=16></a>' gerarprecos
                     , iditemkitvenda precoitemkitvenda
                     , brinde
                from itenskitsvendas
                where idkitvenda = :P66_IDKITVENDA
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P66_IDKITVENDA
        }
        reportLayout {
            numberOfRows: 150
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        messages {
            whenNoDataFound: Não encontrou informações.
        }

        column BRINDE (
            reportColumnQueryId: 6
            derivedColumn: N
            type: selectList
            heading {
                heading: Brinde
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC:Não;N,Sim;S
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 7
            }
        )

        column CHECK$01 (
            reportColumnQueryId: 7
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
        )

        column IDITEMKITVENDA (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDITEMKITVENDA
            }
        )

        column IDKITVENDA (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 3
            }
            default {
                type: item
                item: P66_IDKITVENDA
            }
        )

        column IDPRODUTODETALHADO (
            reportColumnQueryId: 3
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Produto Detalhado
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_util_fav.fnc_nomeprodutodetalhado(idprodutodetalhado, :P0_IDIDIOMA) as d
                         , idprodutodetalhado as r
                    from produtosdetalhados
                    where ativo = 'S'   
                     order by 1
                    ```
                displayNullValue: false
            }
            layout {
                sequence: 4
            }
            appearance {
                width: 130
            }
        )

        column PRECOITEMKITVENDA (
            reportColumnQueryId: 5
            derivedColumn: N
            type: link
            heading {
                heading: Visualizar / Editar Preços
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: center
            }
            link {
                target: {
                    page: 145
                    items: {
                        P145_IDITEMKITVENDA: #IDITEMKITVENDA#
                        P145_IDKITVENDA: #IDKITVENDA#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
        )

        column QUANTIDADE (
            reportColumnQueryId: 4
            derivedColumn: N
            type: textField
            heading {
                heading: Quantidade
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
            appearance {
                width: 10
            }
        )

    )

    region kits-vendas (
        name: Kits Vendas
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P66_AVISODOISZERADOS (
        type: displayOnly
        label {
            label: Avisodoiszerados
            alignment: left
        }
        layout {
            sequence: 220
            region: @kits-vendas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select 'Existem dois ou mais produtos com valor de venda zero na edição - '||e.nome aviso
                from favorita.edicoesrevistas e
                   , ( select COUNT(1)
                           , pik.idedicaorevista
                      from precositenskitsvendas pik
                         , itenskitsvendas ik
                      where pik.iditemkitvenda = ik.iditemkitvenda
                        and ik.idkitvenda = :P66_IDKITVENDA
                        and pik.valorvenda = 0
                        having count(1) > 1
                      group by pik.idedicaorevista
                             , pik.valorvenda) ee
                where e.idedicaorevista = ee.idedicaorevista
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select e.nome
                from favorita.edicoesrevistas e
                   , ( select COUNT(1)
                           , pik.idedicaorevista
                      from precositenskitsvendas pik
                         , itenskitsvendas ik
                      where pik.iditemkitvenda = ik.iditemkitvenda
                        and ik.idkitvenda = 215
                        and pik.valorvenda = 0
                        having count(1) > 1
                      group by pik.idedicaorevista
                             , pik.valorvenda) ee
                where e.idedicaorevista = ee.idedicaorevista
                ```
        }
        security {
            encryptSessionState: false
        }
    )

