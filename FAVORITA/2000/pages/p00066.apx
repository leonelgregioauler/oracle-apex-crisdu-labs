    pageItem P66_PRECOKIT (
        type: checkboxGroup
        label {
            label: Valor de Revista do Kit
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'R$ '|| sum(pik.valorvenda * ik.quantidade) ||' - '||
                       pck_util_fav.fnc_edicaorevista(idedicaorevista) as d
                     , idedicaorevista as r
                from precositenskitsvendas pik
                   , itenskitsvendas ik
                where pik.iditemkitvenda = ik.iditemkitvenda
                and ik.idkitvenda = :P66_IDKITVENDA
                group by pik.idedicaorevista
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 190
            region: @kits-vendas
            slot: regionBody
            alignment: left
            startNewRow: false
            columnCssClasses: check-box
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P66_PRECOKIT_1 (
        type: checkboxGroup
        label {
            label: "Valor de Revista Original "
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'R$ '|| sum(pik.valorvendaoriginal * ik.quantidade) ||' - '||
                       pck_util_fav.fnc_edicaorevista(idedicaorevista) as d
                     , idedicaorevista as r
                from precositenskitsvendas pik
                   , itenskitsvendas ik
                where pik.iditemkitvenda = ik.iditemkitvenda
                and ik.idkitvenda = :P66_IDKITVENDA
                group by pik.idedicaorevista
                ```
