        }
    )

    pageItem P66_PRECOKIT_1_DESCONTO (
        type: checkboxGroup
        label {
            label: Valor a Pagar para Consultora
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'R$ '|| round(sum(((pik.valorvenda -(pik.valorvenda * pik.perccomissaoconsultora/100)) * ik.quantidade)),2) ||' - '||
                       pck_util_fav.fnc_edicaorevista(pik.idedicaorevista) as d
                     , pik.idedicaorevista as r
                from precositenskitsvendas pik
                   , itenskitsvendas ik
                where pik.iditemkitvenda = ik.iditemkitvenda
                and ik.idkitvenda = :P66_IDKITVENDA
                group by pik.idedicaorevista;
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 200
            region: @kits-vendas
            slot: regionBody
            alignment: left
            columnCssClasses: check-box
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P66_PRECOKIT_1_DESCONTO_2 (
        type: checkboxGroup
        label {
            label: Valor a Pagar para Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'R$ '|| round(sum( ((pik.valorvenda - (pik.valorvenda * pik.perccomissaoconsultora/100)) - ((pik.valorvenda - (pik.valorvenda * pik.perccomissaoconsultora/100)) * pik.perccomissaodistribuidor/100))* ik.quantidade),2) ||' - '||
                       pck_util_fav.fnc_edicaorevista(pik.idedicaorevista) as d
                     , pik.idedicaorevista as r
                from precositenskitsvendas pik
                   , itenskitsvendas ik
                where pik.iditemkitvenda = ik.iditemkitvenda
                and ik.idkitvenda = :P66_IDKITVENDA
                group by pik.idedicaorevista;
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 210
            region: @kits-vendas
            slot: regionBody
            alignment: left
            startNewRow: false
            columnCssClasses: check-box
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

