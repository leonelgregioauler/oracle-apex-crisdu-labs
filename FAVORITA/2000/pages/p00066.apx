    process atualiza-preco-novo (
        name: Atualiza Preco Novo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vvalortotal       number;
                  vidkitvenda       number := :P66_IDKITVENDA;
                  valordescontonovo number := :P66_PRECO_NOVO;
                  vvalordescontado  number;
                  --
                begin
                  --
                  for rrev in ( select distinct p.idedicaorevista
                                from favorita.precositenskitsvendas p
                                   , favorita.itenskitsvendas i 
                                where i.iditemkitvenda = p.iditemkitvenda
                                  and i.idkitvenda =  vidkitvenda)
                  loop
                    --
                    select round(sum((valorvendaoriginal - (pk.valorvendaoriginal * (nvl(pk.perccomissaoconsultora,1)/100)))),2) valor_pagar_consultora
                    into vvalortotal
                    from favorita.itenskitsvendas k
                       , favorita.precositenskitsvendas pk
                    where k.iditemkitvenda = pk.iditemkitvenda
                      and k.idkitvenda = vidkitvenda
                      and pk.idedicaorevista = rrev.idedicaorevista;
                    --
                    for rprec in ( select pk.idprecoitemkitvenda
                                        , round((((valorvendaoriginal - (valorvendaoriginal * (pk.perccomissaoconsultora/100)))/vvalortotal)/k.quantidade),2) perc_part_pagar
                                   from favorita.itenskitsvendas k
                                      , favorita.precositenskitsvendas pk
                                   where k.iditemkitvenda = pk.iditemkitvenda
                                     and k.idkitvenda = vidkitvenda
                                     and pk.idedicaorevista = rrev.idedicaorevista)
                    loop
                      --
                      dbms_output.put_line('valor desconto inicio calculo - '||valordescontonovo);
                      dbms_output.put_line('% desconto inicio calculo - '||rprec.perc_part_pagar);
                      --
                      vvalordescontado := valordescontonovo * rprec.perc_part_pagar;
                      --
                      dbms_output.put_line('valor a ser descontado - '||vvalordescontado);
                      --
                      update favorita.precositenskitsvendas pk
                        set pk.valorvenda = round(vvalordescontado,2)
                      where pk.idprecoitemkitvenda = rprec.idprecoitemkitvenda;
                      --
                    end loop;
                    --
                  end loop;
                  --
                end;
                ```
        }
        execution {
            sequence: 110
        }
        advanced {
            executionMappingIdentifier: 113384693303208736
        }
        serverSideCondition {
            type: request=Value
            value: ATUALIZAR_DESCONTO_NOVO
        }
    )

    process consulta-kits-vendas (
