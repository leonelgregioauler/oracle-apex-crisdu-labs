    dynamicAction marcaimprimir (
        name: MarcaImprimir
        execution {
            sequence: 80
        }
        when {
            selectionType: items
            items: P479_IDPEDIDO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      
                      vidpedidobipado varchar2(10) := substr(:P479_IDPEDIDO,9,7);
                      vtemsubremessa number :=0;
                      
                    begin
                      --
                      -- busca o id atraves do pedido para então atualizar a collection
                      for c1 in ( 
                        select seq_id, 
                               C001 ,
                               C002 ,
                               C003 , 
                               C004 ,
                               C005 ,
                               C006 ,
                               C007 ,
                               C008 ,
                               C009 ,
                               C010 ,
                               C011
                          from apex_collections c
                         where c.collection_name = 'COL_PAG479_2000_'||v('APP_USER') 
                           and C001 = vidpedidobipado )
                      loop
                        --
                        -- so marca o checkbox imprimir se o pedido tiver subremessa
                        select count(1)
                          into vtemsubremessa
                          from favorita.pedidos p
                         where p.idpedido = vidpedidobipado
                           and p.idsubremessa is not null;
                        
                        -- só marca o pedido se tiver subremessa
                        if vtemsubremessa > 0 then
                          APEX_COLLECTION.UPDATE_MEMBER (
                              p_collection_name => 'COL_PAG479_2000_'||v('APP_USER'),
                              p_seq  => c1.seq_id,
                              p_C001 => c1.C001,
                              p_C002 => c1.C002,
                              p_C003 => c1.C003,
                              p_C004 => c1.C004,
                              p_C005 => c1.C005,
                              p_C006 => c1.C006,
                              p_c007 => 'S',
                              p_C008 => c1.C008,
                              p_C009 => c1.C009,
                              p_C010 => c1.C010,
                              p_C011 => c1.C011);
                        end if;
                        
                      end loop;
                    end;
                    ```
                itemsToSubmit: P479_IDPEDIDO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                     apex.region("LISTAPEDIDOS").refresh();
                     document.getElementById("P479_IDPEDIDO").value = '';
                     document.getElementById("P479_IDPEDIDO").focus();
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

