    dynamicAction buscasr (
        name: BuscaSR
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P479_IDSUBREMESSA
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    
                    --raise_application_error(-20001,'xxxx'||:P479_IDSUBREMESSA);
                    
                    SELECT IDREMESSA,
                           DESCRICAO,
                           IDFILIALFAVORITA,
                           TIPOSUBREMESSA
                      INTO :P479_IDREMESSA,
                           :P479_NOMESR,
                           :P479_IDFILIALFAVORITA,
                           :P479_TIPOSR
                      FROM subremessas
                     WHERE idsubremessa = :P479_IDSUBREMESSA;
                    
                     exception
                       when no_data_found then 
                        :P479_IDREMESSA        := null ;
                        :P479_NOMESR           := null ;
                        :P479_IDFILIALFAVORITA := 2 ;
                        :P479_TIPOSR           := 'I' ;
                        
                    end;
                    ```
                itemsToSubmit: P479_IDSUBREMESSA
                itemsToReturn: [
                    P479_IDREMESSA
                    P479_NOMESR
                    P479_IDFILIALFAVORITA
                    P479_TIPOSR
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

