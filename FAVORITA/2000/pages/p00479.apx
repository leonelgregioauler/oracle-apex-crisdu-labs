    process entregarpedido (
        name: EntregarPedido
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                
                  vid_pedido     number := :P479_ID_PEDIDO_ENTREGAR;
                  vid_usuario    number := pck_util_fav.fnc_retornaidusuario(:APP_USER);
                  vexiste        number;
                  vqtd           number;
                  vid_subrem     number;
                  vdata          timestamp := sysdate;
                  vtemsubremessa number :=0;
                  
                begin
                  --
                  if APEX_APPLICATION.G_F01.COUNT > 0 then
                    --
                    FOR I in 1..APEX_APPLICATION.G_F01.COUNT LOOP
                      vid_pedido := to_number(APEX_APPLICATION.G_F01(i));
                      
                      -- Verifica se o pedido já tem subremessa
                      select count(1)
                        into vtemsubremessa
                        from favorita.pedidos p
                       where p.idpedido = vid_pedido
                         and p.idsubremessa is not null;
                      
                      -- só entrega pedidos que já tem subremessa
                      if vtemsubremessa > 0 then
                        pck_movimentarpedidos_fav.prc_confirmaentregapedido(pidpedido  => vid_pedido,
                                                                            pidusuario => vid_usuario);
                        commit;
                      end if;
                      
                    END LOOP;
                    --
                    -- valida se todos os pedidos da subremessa foram entregues, então pode fechar a subremessa
                    begin
                      select idsubremessa
                        into vid_subrem  
                        from pedidos p
                       where p.idpedido = vid_pedido;
                      --
                      if vid_subrem is not null then
                        begin
                        select max(1)
                          into vexiste
                          from pedidos p
                         where idsubremessa = vid_subrem
                           and p.idsituacaoentrega in (30000, 55000) ;
                        exception
                          when no_data_found then
                            vexiste := 0;
                        end;
                      end if;
                      --
                      if nvl(vexiste,0) > 0 then  -- enquanto o select acima retornar registros, sinal que ainda não foram todos recebidos.
                        null;
                      else
                        --
                        UPDATE subremessas
                           SET datafechamento      = vdata
                             , idusuariofechamento = vid_usuario
                         WHERE idsubremessa        = vid_subrem;
                        --
                      end if;
                    end; 
                
                  --
                  else
                    apex_error.add_error ( p_message => 'Selecione ao menos um pedido para efetuar a entrega!',
                                           p_display_location => apex_error.c_inline_in_notification );  
                  end if;
                  
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Ação Processada!
        }
        advanced {
            executionMappingIdentifier: 85015681605168646
        }
        serverSideCondition {
            type: request=Value
            value: ENTREGAR
        }
    )

    process gerarsubremessa (
        name: GerarSubRemessa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                l_query         varchar2(4000);
                vidusuarioabert number;
                vdtabertura     timestamp ;
                vdtfechamento   timestamp;
                vidusuariofecha number;
                vmd5            varchar2(1000);
                
                begin
                
                  --
                  if APEX_APPLICATION.G_F02.COUNT > 0 then
                    --
                    if v('REQUEST') = 'INCLUIRSR' and 
                       :P479_IDSUBREMESSA is null then
                      --
                      vidusuarioabert := :P0_IDUSUARIO;
                      vdtabertura     := sysdate;
                      pck_cadastros_fav.prc_subremessas 
                                       ( :P479_IDSUBREMESSA
                                       , :P479_IDREMESSA
                                       , :P479_NOMESR
                                       , vidusuarioabert
                                       , vdtabertura
                                       , vdtfechamento
                                       , :P479_IDFILIALFAVORITA
                                       , :P479_TIPOSR
                                       , vidusuariofecha
                                       , vmd5
                                       , 'I' ) ;
                    end if;
                  else
                    apex_error.add_error ( p_message => 'Para gerar uma sub-remessa, tem que selecionar ao menos um item na coluna "Gerar SR"',
                                           p_display_location => apex_error.c_inline_in_notification );  
                  end if;
                  --
                  FOR I in 1..APEX_APPLICATION.G_F02.COUNT LOOP
                    --
                    update pedidos
                       set idsubremessa = :P479_IDSUBREMESSA
                     where idpedido = to_number(APEX_APPLICATION.G_F02(i));
                    --
                  END LOOP;
                
                end;
                
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 566169527097807441
        }
        serverSideCondition {
            whenButtonPressed: @incluirsr
        }
    )

    process imprimirpedidos (
        name: ImprimirPedidos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vid_pedido   number := :P479_ID_PEDIDO_ENTREGAR;
                  vid_idioma   number := 1;
                  vid_usuario  number := pck_util_fav.fnc_retornaidusuario(:APP_USER);
                  vboleto      number := 1;
                  vpromissoria number := 1;
                  vbool        boolean;
                  --
                  vchar varchar2(100);
                  --
                begin
                  --
                  if not apex_collection.collection_exists('COL_PEDEXPRESSIMPRIME_'||v('APP_USER')) then 
                      apex_collection.create_collection('COL_PEDEXPRESSIMPRIME_'||v('APP_USER'));
                  else
                      apex_collection.truncate_collection('COL_PEDEXPRESSIMPRIME_'||v('APP_USER'));
                  end if;
                  --
                  if APEX_APPLICATION.G_F03.COUNT > 0 then
                    --
                    vid_pedido := 0;
                    FOR I in 1..APEX_APPLICATION.G_F03.COUNT LOOP
                      --
                      vid_pedido := to_number(APEX_APPLICATION.G_F03(i));
                      apex_collection.add_member(
                                      p_collection_name => 'COL_PEDEXPRESSIMPRIME_'||v('APP_USER'),
                                      p_c001 => vid_pedido );
                      --
                    END LOOP;
                  else
                    raise_application_error(-20002,'Selecione ao menos um pedido para impressão!');
                --    apex_error.add_error ( p_message => 'Selecione ao menos um pedido para impressão!',
                --                           p_display_location => apex_error.c_inline_in_notification );  
                  end if;  
                
                commit;
                end;
                
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 566291653321732731
        }
        serverSideCondition {
            type: request=Value
            value: IMPRIMIRPEDIDOS
        }
    )

    process populacollection (
        name: PopulaCollection
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                 l_query varchar2(32000);
                    
                    
                BEGIN
                
                  l_query := '  select p.idpedido,
                                       pck_util_fav.fnc_nomevendedora(p.idvendedora) as "Vendedora",
                                       pck_util_fav.fnc_nomerepresentante(p.idrepresentante) as "Distribuidor",
                                       to_char(p.dataemissao,''dd/mm/rrrr hh24:mi:ss'') as "Dt Emissão",
                                       se.descricaosistema as "Sit Entrega",
                                       sf.descricaosistema as "Sit Financeiro",
                                       case
                                         when p.idsituacaoentrega = 55000 and p.idsubremessa is not null then
                                           APEX_ITEM.CHECKBOX2(1, p.idpedido , NULL ) 
                                         else
                                           null
                                       end as "Entregar",
                                       case
                                         when p.idsubremessa is null then 
                                           APEX_ITEM.CHECKBOX2(2, p.idpedido , NULL ) 
                                         else
                                           null
                                         end IncluirSR,
                                       case
                                         when p.idsituacaoentrega in (30000) then
                                           APEX_ITEM.CHECKBOX2(3, p.idpedido , NULL )
                                         else
                                           null
                                       end as "Imprimir",
                                       p.idsubremessa,
                                       case
                                         when p.idsubremessa is not null then
                                           (select descricao
                                              from subremessas
                                             where idsubremessa = p.idsubremessa)
                                       end as "Sub-Remessa",
                                       p.idsituacaoentrega
                                  from pedidos p,
                                       situacoesentrega se,
                                       situacoesfinanceiro sf
                                 where p.idsituacaoentrega = se.idsituacaoentrega
                                   and p.idsituacaofinanceiro = sf.idsituacaofinanceiro
                                   and p.datacancelamento is null
                                   and p.idsituacaoentrega in (30000,55000) 
                                   and exists (select 1
                                                 from classificacoespedidos c
                                                where c.idcaracteristicapedido = 13
                                                  and c.idvalorcaracteristica = 6
                                                  and c.idpedido = p.idpedido)';
                
                
                  if apex_collection.collection_exists('COL_PAG479_2000_'||v('APP_USER') ) then
                    APEX_COLLECTION.DELETE_COLLECTION ( p_collection_name => 'COL_PAG479_2000_'||v('APP_USER'));
                  end if;
                
                  APEX_COLLECTION.CREATE_COLLECTION_FROM_QUERY (
                        p_collection_name => 'COL_PAG479_2000_'||v('APP_USER'), 
                        p_query => l_query,
                        p_generate_md5 => 'NO');
                
                END;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 3493349713522194046
        }
    )

