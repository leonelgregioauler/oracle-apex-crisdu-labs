    region lista-de-pedidos-favorita-express (
        name: Lista de Pedidos Favorita Express
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select seq_id
                     , C001 idpedido
                     , C002 "Vendedora"
                     , C003 "Distribuidor"
                     , C004 "Dt Emissão"
                     , C005 "Sit Entrega"
                     , C006 "Sit Financeiro"
                     , case 
                         when C007 = 'S' then
                           APEX_ITEM.CHECKBOX2(1, C001 , 'CHECKED' )
                         else
                           decode(C012,55000,decode(C010,null,null,APEX_ITEM.CHECKBOX2(1, C001 , NULL )),null)
                       end "Entregar"
                     , C008 "IncluirSR"
                     , C009 "Imprimir"
                     , C010 "idsubremessa"
                     , C011 "Sub-Remessa"
                     , C012 "idsituacaoentrega"
                  from apex_collections c
                 where c.collection_name = 'COL_PAG479_2000_'||v('APP_USER');
                 
                 
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: LISTAPEDIDOS
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 85014338423168633
        }

