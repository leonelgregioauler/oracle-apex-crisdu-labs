page 425 (
    name: Controle de Restrições de Empresas
    title: Controle de Restrições de Empresas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region controle-de-empresas (
        name: Controle de Empresas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idfilial
                     , p.nome
                     , p.valor
                from roman.parametros p
                where p.nome in ( 'SPC_QUANTIDADETOTAL' , 'SPC_VALORTOTAL' )
                  and exists ( select 1
                               from roman.notasvendas nv
                               where nv.idfilial = p.idfilial )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 5757780178529826
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDFILIAL
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @NOME
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @VALOR
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @ROWID
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column IDFILIAL (
            type: selectList
            heading {
                heading: Empresa
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nome
                         , idfilial
                    from roman.vw_filiais f
                    where f.ativo = 'S'
                      and f.tipofilial = 'D'
                    ```
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDFILIAL
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column NOME (
            type: textField
            heading {
                heading: Parametro
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
                maxLength: 50
            }
            source {
                databaseColumn: NOME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ROWID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ROWID
                dataType: rowid
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column VALOR (
            type: textarea
            heading {
                heading: Valor
                alignment: center
            }
            layout {
                sequence: 60
            }
            validation {
                valueRequired: true
                maxLength: 100
            }
            source {
                databaseColumn: VALOR
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

    )

    process controle-de-empresas-save-interactive-grid-data (
        name: Controle de Empresas - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @controle-de-empresas
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo executado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 5758456288529833
        }
    )

)

