    region lista-de-clientes (
        name: Lista de Clientes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH
                vendedoras_filtradas AS (
                    SELECT /*+ MATERIALIZE */ DISTINCT v.idvendedora
                    FROM catal.vendedoras v
                    JOIN roman.notasvendas nv ON nv.idvendedora = v.idvendedora
                    WHERE v.ativo                = 'S'
                      AND nv.idsituacaonotavenda = 3
                      AND :P552_FILTRAR          = 'S'
                      AND (
                              (:P552_DISTRIBUIDOR != -1 AND nv.idrepresentante = :P552_DISTRIBUIDOR)
                           OR (:P552_DISTRIBUIDOR  = -1 AND EXISTS (
                                    SELECT 1 FROM representantes r
                                    WHERE r.idgerente       = :P552_FRANQUIA_REP
                                      AND r.idrepresentante = nv.idrepresentante
                                      AND (   :P552_SITUACAO_DISTRIBUIDOR = 'A'
                                           OR r.ativo = :P552_SITUACAO_DISTRIBUIDOR)
                                ))
                          )
                      AND (:P552_SEMANA_DE IS NULL OR nv.idsemanacobranca BETWEEN :P552_SEMANA_DE AND :P552_SEMANA_ATE)
                ),
                debitos_calc AS (
                    SELECT /*+ MATERIALIZE */
                        vp.idvendedora,
                        SUM(CASE
                                WHEN vp.tipopedido       = 'P'
                                 AND vp.datacancelamento IS NULL
                                 AND vp.saldodevedor     > 0
                                 AND exc.idpedido        IS NULL
                                THEN vp.saldodevedor ELSE 0
                            END) AS debped,
                        SUM(CASE
                                WHEN vp.tipopedido   = 'T'
                                 AND vp.valorapagar  > 0
                                 AND vp.saldodevedor > 0
                                 AND exc.idpedido    IS NULL
                                THEN vp.saldodevedor ELSE 0
                            END) AS debtroc
                    FROM favorita.vw_pedidos_fav_new vp
                    LEFT JOIN favorita.classificacoespedidos exc
                           ON exc.idpedido = vp.idpedido
                          AND exc.idcaracteristicapedido IN (104, 59)
                    WHERE vp.idvendedora IN (SELECT idvendedora FROM vendedoras_filtradas)
                    GROUP BY vp.idvendedora
                ),
                debitos_old AS (
                    SELECT /*+ MATERIALIZE */
                           c.idvendedora,
                           SUM(c.valorapagar - c.valorpago) AS devpant
                    FROM   favorita.vw_pedidos_old c
                    WHERE  c.saldodevedor > 0.5
                      AND  c.idsituacao NOT IN ('Q', 'U', 'K')
                      AND  c.idvendedora IN (SELECT idvendedora FROM vendedoras_filtradas)
                    GROUP BY c.idvendedora
                ),
                categoria_max AS (
                    SELECT /*+ MATERIALIZE */
                           idvendedora,
                           MAX(idpontuacaoclube) AS idpontuacaoclube
                    FROM   roman.pontuacoesclubedesucesso
                    WHERE  idvendedora IN (SELECT idvendedora FROM vendedoras_filtradas)
                    GROUP BY idvendedora
                ),
                tablet_vend AS (
                    SELECT /*+ MATERIALIZE */ DISTINCT idvendedora
                    FROM   favorita.vw_pedidostablet_fav
                    WHERE  idvendedora IN (SELECT idvendedora FROM vendedoras_filtradas)
                ),
                vencimentos_calc AS (
                    SELECT /*+ MATERIALIZE */
                        idvendedora,
                        LISTAGG(data_formatada, ' - ')
                            WITHIN GROUP (ORDER BY datavencimento) AS datas_vencimento
                    FROM (
                        SELECT DISTINCT
                               ped.idvendedora,
                               TRUNC(vp.datavencimento)                 AS datavencimento,
                               TO_CHAR(vp.datavencimento, 'DD/MM/YYYY') AS data_formatada
                        FROM favorita.vencimentospedidos vp
                        JOIN favorita.pedidos ped ON ped.idpedido = vp.idpedido
                        WHERE vp.valorpago < vp.valorpagar
                          AND ped.idvendedora IN (SELECT idvendedora FROM vendedoras_filtradas)
                    )
                    GROUP BY idvendedora
                )
                SELECT
                    INITCAP(p.nomepessoa)                                                      AS nome,
                    p.cpf,
                    nv.numeronota,
                    cnv.idvalorcaracteristica                                                  AS sacola,
                    roman.pck_romance.fnc_retornatelefones(v.idvendedora)                      AS telefone,
                    INITCAP(p.enderecoprincipal) || ', ' || p.numero || ', ' || p.bairro       AS endereco,
                    roman.pck_romance.fnc_nomecidade(p.idcidade)                               AS nomecidade,
                    rv_vend.descricao                                                          AS "Regiao Vendedora",
                    rv_nota.descricao                                                          AS "Região Nota",
                    roman.pck_romance.fnc_nomerepresentante(nv.idrepresentante)                AS "Distribuidor",
                    p.observacao,
                    p.email,
                    CASE WHEN tv.idvendedora IS NOT NULL THEN 'Sim' ELSE 'Não' END             AS possuipedido,
                    nv.dataretorno,
                    NVL(ct.nomecategoria, 'Não participa de campanha.')                        AS categoria,
                    NVL(
                        NVL(dc.debped, 0)
                      + NVL(dc.debtroc, 0)
                      + NVL(dold.devpant, 0),
                        0
                    )                                                                          AS saldo,
                    NVL(v.pontos, 0)                                                           AS pontos,
                    favorita.pck_controle_fav.fnc_retornalimitedisponivel(v.idvendedora, 'D')  AS "Limite",
                    vc.datas_vencimento                                                        AS "Vencimento Boleto",
                    nv.semanacobranca                                                          AS "Semana Cobrança"
                FROM catal.pessoas p
                JOIN catal.vendedoras v
                     ON v.idpessoa = p.idpessoa
                JOIN roman.notasvendas nv
                     ON nv.idvendedora = v.idvendedora
                JOIN vendedoras_filtradas vf
                     ON vf.idvendedora = v.idvendedora
                LEFT JOIN roman.classificacoesnotasvendas cnv
                       ON cnv.idnotavenda = nv.idnotavenda
                      AND cnv.idcaracteristicanotavenda = 52
                LEFT JOIN roman.regioesvenda rv_vend
                       ON rv_vend.idregiaovenda = v.idregiaovenda
                LEFT JOIN roman.regioesvenda rv_nota
                       ON rv_nota.idregiaovenda = nv.idregiaovenda
                LEFT JOIN tablet_vend tv
                       ON tv.idvendedora = v.idvendedora
                LEFT JOIN categoria_max cm
                       ON cm.idvendedora = v.idvendedora
                LEFT JOIN roman.pontuacoesclubedesucesso pp
                       ON pp.idpontuacaoclube = cm.idpontuacaoclube
                LEFT JOIN roman.categoriasclubes ct
                       ON ct.idcategoriaclube = pp.idcategoriaclube
                LEFT JOIN debitos_calc dc
                       ON dc.idvendedora = v.idvendedora
                LEFT JOIN debitos_old dold
                       ON dold.idvendedora = v.idvendedora
                LEFT JOIN vencimentos_calc vc
                       ON vc.idvendedora = v.idvendedora
                WHERE v.ativo                = 'S'
                  AND nv.idsituacaonotavenda = 3
                  AND (
                          (:P552_DISTRIBUIDOR != -1 AND nv.idrepresentante = :P552_DISTRIBUIDOR)
                       OR (:P552_DISTRIBUIDOR  = -1 AND EXISTS (
                                SELECT 1 FROM representantes r
                                WHERE r.idgerente       = :P552_FRANQUIA_REP
                                  AND r.idrepresentante = nv.idrepresentante
                                  AND (   :P552_SITUACAO_DISTRIBUIDOR = 'A'
                                       OR r.ativo = :P552_SITUACAO_DISTRIBUIDOR)
                            ))
                      )
                  AND (:P552_SEMANA_DE IS NULL OR nv.idsemanacobranca BETWEEN :P552_SEMANA_DE AND :P552_SEMANA_ATE)
                ORDER BY 1
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
