                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: A
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: FILTRAR
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process filtra (
        name: FILTRA
        type: executeCode
        source {
            plsqlCode: :P552_FILTRAR := 'S'
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 26096014859727907
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 552
                items: {
                    P552_FRANQUIA_REP: &P552_FRANQUIA_REP.
                    P552_DISTRIBUIDOR: &P552_DISTRIBUIDOR.
                    P552_REGIAO: &P552_REGIAO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

