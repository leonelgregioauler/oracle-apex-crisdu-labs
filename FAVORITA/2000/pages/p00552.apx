    pageItem P552_DISTRIBUIDOR (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap (p.nomepessoa) display_value
                     , r.idrepresentante return_value
                from pessoas p
                   , representantes r
                where r.idpessoa = p.idpessoa 
                  --and r.ativo = 'S'
                  and r.idgerente = :P552_FRANQUIA_REP
                  and (:P552_SITUACAO_DISTRIBUIDOR = 'A' or r.ativo = :P552_SITUACAO_DISTRIBUIDOR)
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: --- Todos ---
            nullReturnValue: -1
        }
        cascadingLov {
            parentItems: [
                P552_FRANQUIA_REP
                P552_SITUACAO_DISTRIBUIDOR
            ]
            itemsToSubmit: P552_DISTRIBUIDOR
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        default {
            type: static
            staticValue: -1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P552_FILTRAR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
        }
        default {
            type: static
            staticValue: N
        }
    )

    pageItem P552_FRANQUIA_REP (
        type: selectList
        label {
            label: "Franquia "
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idgerente
                from roman.vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                  --and f.ididioma = 1
                  and f.idgrupo is not null
                ```
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P552_REGIAO (
        type: selectMany
        label {
            label: Região Nota
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomeregiaovenda (r.idregiaovenda) || r.semana display_value
                     , r.idregiaovenda return_value 
                from roman.regioesrepresentantes r
                where (:P552_DISTRIBUIDOR = -1 or r.idrepresentante = :P552_DISTRIBUIDOR)
                order by idsemana
                ```
        }
        cascadingLov {
            parentItems: P552_DISTRIBUIDOR
            itemsToSubmit: P552_REGIAO
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P552_SEMANA_ATE (
        type: popupLov
        label {
            label: até
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select sd.semanacompleta
                     , sd.idsemana
                  from roman.semana_dias sd
                order by 2 desc
                ```
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            width: 30
        }
    )

    pageItem P552_SEMANA_DE (
