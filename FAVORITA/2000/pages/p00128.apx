page 128 (
    name: Impressão de Pedidos de Remessa
    title: Impressão de Pedidos de Remessa
    appearance {
        pageTemplate: @minimal-pedido
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region impressão (
        name: Impressão
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_comprastransf_fav.prc_imprimepedidosremessa(pidcompratransferencia => :P128_IDCOMPRATRANSFERENCIA,
                                                                  piddistribuidor        => :P128_IDDISTRIBUIDOR,
                                                                  pquantidade            => :P128_QUANTIDADE,
                                                                  ppromissoria           => :P128_PROMISSORIA,
                                                                  pboleto                => :P128_BOLETO,
                                                                  pidusuario             => :P128_IDUSUARIO,
                                                                  pididioma              => :P0_IDIDIOMA,
                                                                  pordenacao             => :P128_ORDENACAO,
                                                                  ptipo                  => :P128_TIPO);
                  --
                  pck_comprastransf_fav.prc_limpareimpressoespedidos(pidusuario => :P128_IDUSUARIO);
                  --
                end;
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P128_BOLETO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @impressão
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P128_IDCOMPRATRANSFERENCIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @impressão
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P128_IDDISTRIBUIDOR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @impressão
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P128_IDUSUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @impressão
            slot: regionBody
        }
        source {
            type: item
            item: P0_IDUSUARIO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P128_ORDENACAO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @impressão
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P128_PROMISSORIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @impressão
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P128_QUANTIDADE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @impressão
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P128_TIPO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @impressão
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

