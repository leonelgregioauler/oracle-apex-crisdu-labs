    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 100
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 348
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 348
                items: {
                    P348_IDFILIAL: &P348_IDFILIAL.
                    P348_USUARIO: &P348_USUARIO.
                    P348_DOCUMENTO: &P348_DOCUMENTO.
                    P348_LIBERADO: &P348_LIBERADO.
                    P348_TIPO: &P348_TIPO.
                    P348_UTILIZADO: &P348_UTILIZADO.
                    P348_DATAINICIO: &P348_DATAINICIO.
                    P348_DATAFIM: &P348_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

