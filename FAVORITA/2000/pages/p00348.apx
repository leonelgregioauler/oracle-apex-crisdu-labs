    pageItem P348_USUARIO (
        type: selectList
        label {
            label: Usuário
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select u.usuario d
                     , u.usuario r
                from catal.usuarios u
                where exists ( select 1
                               from roman.historicosconsultasdoc h
                               where h.usuario = u.usuario )
                  and exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.idgrupoatendimento = 22
                                 and ug.usuario = u.usuario )
                ```
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
