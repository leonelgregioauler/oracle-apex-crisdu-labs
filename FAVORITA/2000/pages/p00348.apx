page 348 (
    name: Históricos de Consultas
    title: Históricos de Consultas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region históricos-de-consultas (
        name: Históricos de Consultas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idhistoricoconsultadoc
                     , dataconsulta
                     , documento
                     , nroconsultaspc
                     , nomerepresentante
                     , descliberado
                     , usuario 
                     , codigoliberacao
                     , datacadastro 
                     , observacao
                     , telefones
                     , empresa
                     , Decode (nvl(RESTRITIVO_CRISDU,'N'),'N','Não','Sim') RESTRITIVO_CRISDU 
                from (
                select w.idhistoricoconsultadoc
                     , w.dataconsulta
                     , w.documento
                     , w.nroconsultaspc
                     , w.nomerepresentante
                     , w.descliberado
                     , w.usuario 
                     , w.codigoliberacao
                     , ( select n.datanota
                         from pessoas p
                            , vendedoras v
                            , roman.notasvendas n
                         where p.idpessoa = v.idpessoa 
                           and v.idvendedora = n.idvendedora
                           and n.idrepresentante = w.idrepresentante
                           and p.cpf = replace(replace(w.documento,'.',''),'-','')
                           and n.idsituacaonotavenda = 3
                           and rownum = 1) datacadastro 
                     , w.observacao
                     , telefones
                     , roman.pck_romance.fnc_nomefilial(w.idfilial) empresa
                	 , ( select v.spc
                         from pessoas p
                            , vendedoras v
                            , roman.notasvendas n
                         where p.idpessoa = v.idpessoa 
                           and v.idvendedora = n.idvendedora
                           and n.idrepresentante = w.idrepresentante
                           and p.cpf = replace(replace(w.documento,'.',''),'-','')
                           and n.idsituacaonotavenda = 3
                           and rownum = 1) RESTRITIVO_CRISDU
                from roman.vw_historicosconsultasdoc w
                where trunc(w.dataconsulta) between to_date(:P348_DATAINICIO,'DD/MM/RRRR') and to_date(:P348_DATAFIM,'DD/MM/RRRR')
                  and ( :P348_LIBERADO = 'A' or w.liberado = :P348_LIBERADO )
                  and ( :P348_DOCUMENTO is null or w.documento = replace(replace(:P348_DOCUMENTO,'.',''),'-','') )
                  and ( :P348_IDFILIAL is null or w.idfilial = :P348_IDFILIAL )
                  and ( :P348_USUARIO is null or w.usuario = :P348_USUARIO )
                  and ( :P348_UTILIZADO = 'A' 
                       or ( :P348_UTILIZADO = 'S' and exists ( select 1
                                                               from pessoas p
                                                                  , vendedoras v
                                                                  , roman.notasvendas n
                                                               where p.idpessoa = v.idpessoa 
                                                                 and v.idvendedora = n.idvendedora
                                                                 and n.idrepresentante = w.idrepresentante
                                                                 and p.cpf = replace(replace(w.documento,'.',''),'-','')
                                                                 and n.idsituacaonotavenda = 3 ) ) 
                       or ( :P348_UTILIZADO = 'N' and not exists ( select 1
                                                                   from pessoas p
                                                                      , vendedoras v
                                                                      , roman.notasvendas n
                                                                   where p.idpessoa = v.idpessoa 
                                                                     and v.idvendedora = n.idvendedora
                                                                     and n.idrepresentante = w.idrepresentante
                                                                     and p.cpf = replace(replace(w.documento,'.',''),'-','')
                                                                     and n.idsituacaonotavenda = 3 ) ) ) 
                  and ( :P348_TIPO is null 
                       or ( :P348_TIPO = 'W' and exists ( select 1
                                                          from roman.usuariosgruposatendimento ug
                                                          where ug.usuario = w.usuario
                                                            and ug.idgrupoatendimento = 22 ) )
                       or ( :P348_TIPO = 'S' and exists ( select 1
                                                          from roman.usuariosgruposatendimento ug
                                                          where ug.usuario = w.usuario
                                                            and ug.idgrupoatendimento != 22 ) ) ))
                order by 1
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Nenhum consulta encontrada. Verifique os filtros!
        }
        advanced {
            savedReportMappingIdentifier: 1473335347398168903
        }

