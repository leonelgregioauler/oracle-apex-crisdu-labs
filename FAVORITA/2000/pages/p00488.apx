page 488 (
    name: Integração Virtual Age
    title: Integração Virtual Age
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region integração-virtual-age (
        name: Integração Virtual Age
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select descricao as card_title,
                       'f?p=&APP_ID.:'||PAGINA||':&SESSION.::NO:::' as card_link,
                       imagem as card_icon,
                       null as card_text,
                       null as card_subtext
                  from ( select a.idaplicacao
                              , a.descricao
                              , a.hierarquia
                              , a.pagina
                              , a.imagem
                              , a.paginascorrentes
                              , a.ordem
                         from roman.aplicacoes a 
                         where a.idsistema  = 2000
                           and a.hierarquia = 75009
                           and a.aparecer   = 'S'
                           and exists ( select 1 
                                        from roman.acessos b 
                                        where b.idaplicacao = a.idaplicacao 
                                          and b.usuario = v('APP_USER') ))
                order by ordem
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/cards
            templateOptions: [
                #DEFAULT#
                t-Cards--featured force-fa-lg
                t-Cards--displayIcons
                t-Cards--3cols
                t-Cards--hideBody
                u-colors
                t-Cards--animColorFill
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column CARD_ICON (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Card icon
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column CARD_LINK (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Card link
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

        column CARD_SUBTEXT (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Card subtext
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
        )

        column CARD_TEXT (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Card text
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

        column CARD_TITLE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Card title
                alignment: center
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

    )

)

