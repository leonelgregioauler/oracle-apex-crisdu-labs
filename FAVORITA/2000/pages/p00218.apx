                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P218_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROMAN.pck_romance.fnc_nomerepresentante(idrepresentante) DISPLAY_VALUE
                     , idrepresentante RETURN_VALUE
                from representantes
                where (:P218_IDFILIALROMANCE is null or
                    ( :P218_IDFILIALROMANCE is not null and idgerente in ( select idgerente from gerentes where idfilial = :P218_IDFILIALROMANCE) ))
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P218_IDFILIALROMANCE
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P218_IDUSUARIONEGOCIACAO (
        type: selectList
        label {
            label: Atend. Negociação
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomeusuario(usuario) display_value
                     , idusuario return_value
                from usuarios 
                where idgerente = 80
                  and ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P218_IDVENDEDORA (
        type: popupLov
        label {
            label: Consultora
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' ('||nvl(p.cpf,p.documentoestrangeiro)||')' display_value
                     , v.idvendedora
                from vendedoras v
                   , pessoas p
                where p.idpessoa = v.idpessoa
                  and (:P218_IDREPRESENTANTE is null or v.idrepresentante = :P218_IDREPRESENTANTE) 
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P218_IDREPRESENTANTE
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P218_TIPODATA (
        type: radioGroup
        label {
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Baixa;B,Vencimento;V
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    button buscar (
        buttonName: BUSCAR
        label: Buscar
        layout {
            sequence: 100
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 218
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 218
                items: {
                    P218_TIPODATA: &P218_TIPODATA.
                    P218_DATAINICIO: &P218_DATAINICIO.
                    P218_DATAFIM: &P218_DATAFIM.
                    P218_IDFILIALROMANCE: &P218_IDFILIALROMANCE.
                    P218_IDREPRESENTANTE: &P218_IDREPRESENTANTE.
                    P218_IDVENDEDORA: &P218_IDVENDEDORA.
                    P218_IDUSUARIONEGOCIACAO: &P218_IDUSUARIONEGOCIACAO.
                    P218_IDPEDIDO: &P218_IDPEDIDO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

)

