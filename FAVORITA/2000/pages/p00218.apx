page 218 (
    name: Negociações Cobrança
    title: Negociações Cobrança
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region negociações-realizadas (
        name: Negociações Realizadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.IDVENCIMENTOPEDIDO
                     , v.idpedido
                     , v.datavencimento
                     , p.vendedora
                     , v.valorpagar
                     , v.valorpago
                     , v.saldo
                     , v.verificarnaconta
                     , v.idtarefa
                     , pck_pedidos_fav.fnc_situacaopagamentoped(p.idpedido) situacaopagamento
                     , v.codsituacaovencimento
                     , idvencimentopedido verpagamentos
                     , ( select distinct(pg.usuarionegociacao)
                         from vw_pagamentospedidos_fav pg
                         where pg.idvencimentopedido = v.idvencimentopedido
                           and pg.idusuarionegociacao is not null
                           and rownum = 1 ) usuarionegociacao
                from vw_vencimentospedidos_fav v
                   , vw_pedidos_fav            p
                where p.idpedido = v.idpedido
                  and p.ididioma = :P0_IDIDIOMA
                  and ( :P218_TIPODATA is null or ( :P218_TIPODATA = 'V' and v.datavencimento between to_date(:P218_DATAINICIO,'DD/MM/RRRR') and to_date(:P218_DATAFIM,'DD/MM/RRRR') )
                                               or ( :P218_TIPODATA = 'B' and exists ( select 1
                                                                                      from pagamentospedidos pg
                                                                                      where pg.idvencimentopedido = v.idvencimentopedido
                                                                                        and trunc(pg.datapagamento) between to_date(:P218_DATAINICIO,'DD/MM/RRRR') and to_date(:P218_DATAFIM,'DD/MM/RRRR') ) ) )
                  and ( :P218_IDFILIALROMANCE is null or p.idfilialromance = :P218_IDFILIALROMANCE )
                  and ( :P218_IDREPRESENTANTE is null or p.idrepresentante = :P218_IDREPRESENTANTE )
                  and ( :P218_IDVENDEDORA is null or p.idvendedora = :P218_IDVENDEDORA )
                  and ( :P218_IDPEDIDO is null or v.idpedido = :P218_IDPEDIDO )
                  and exists ( select 1
                               from pagamentospedidos pg
                               where pg.idvencimentopedido = v.idvencimentopedido
                                 and pg.idusuarionegociacao is not null )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 338813227981757150
        }

