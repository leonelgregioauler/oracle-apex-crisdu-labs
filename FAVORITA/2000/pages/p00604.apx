page 604 (
    name: Detalhes Situacao OC
    title: Compras/Transferencias Geradas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 75%
        height: 60%
        resizable: false
    }
    css {
        inline:
            ```css
            .no-parent-padding {
                padding: 8px;
                margin: -12px -12px;
            }
            
            .yellow-background {
                background-clip: content-box;
                box-shadow: inset 0 0 0 12px yellow;
                background-color: yellow;
            }
            
            .lime-background {
                background-clip: content-box;
                box-shadow: inset 0 0 0 12px lime;
                background-color: lime;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region c-t-r (
        name: C / T / R
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct * from (
                select ct.idordemcompra "OC"
                     , sum(nvl(io.qtdcomprar,0) + nvl(io.qtdtransferir,0) ) over (partition by it.idprodutodetalhado)  "Qtde Comprada"
                     , listagg(ct.idcompratransferencia||'('||decode(ct.idtipocomptransrem,0,'C','T')||')' ,';') WITHIN GROUP (ORDER BY ct.idcompratransferencia) "C/T/R"
                     , pck_util_fav.fnc_nomeprodutodetalhado(it.idprodutodetalhado,1) "Produto Detalhado"
                     --
                     , case when sum(nvl(it.quantidaderecebida,0)) < sum(nvl(io.qtdcomprar,0)+nvl(io.qtdtransferir,0)) over (partition by it.idprodutodetalhado)
                            then '<div class="yellow-background no-parent-padding">'|| sum(nvl(it.quantidaderecebida,0)) ||'</div>' 
                            --else '<div class="lime-background no-parent-padding">' || sum(nvl(io.qtdcomprar,0)+nvl(io.qtdtransferir,0)) over (partition by it.idprodutodetalhado) ||'</div>' 
                            else '<div class="lime-background no-parent-padding">' || sum(nvl(it.quantidaderecebida,0)) ||'</div>' 
                       end as  "Qtde Recebida"
                     --
                     , listagg(distinct pck_util_fav.fnc_retornatipocomptransrem(ct.idtipocomptransrem,:P0_IDIDIOMA),';')  "Tipo"
                  from comprastransferencias      ct
                     , itenscomprastransferencias it
                     , tmp_ordenscomprasprop      io
                 where ct.idordemcompra = :P604_IDORDEMCOMPRA
                   and ct.idcompratransferencia = it.idcompratransferencia
                   and ct.idordemcompra = io.idordemcompra(+)
                   and it.idprodutodetalhado = io.idprodutodetalhado(+)
                  -- and ct.idsituacao            in (20,30,40)
                  group by ct.idordemcompra, io.qtdcomprar, io.qtdtransferir, it.idprodutodetalhado )
                
                
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            formats: [
                html
                csv
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 802094422536655448
        }

        column "C/T/R" (
            type: plainText
            heading {
                heading: C / T / R
            }
            layout {
                sequence: 160
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: R
            }
        )

        column OC (
            type: plainText
            heading {
                heading: Oc
                alignment: center
            }
            layout {
                sequence: 130
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: O
            }
        )

        column "Produto Detalhado" (
            type: plainText
            heading {
                heading: Produto Detalhado
            }
            layout {
                sequence: 70
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        column "Qtde Comprada" (
            type: plainText
            heading {
                heading: Qtde Comp + Transf
                alignment: end
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: K
            }
        )

        column "Qtde Recebida" (
            type: plainText
            heading {
                heading: Qtde Recebida
                alignment: end
            }
            layout {
                sequence: 150
                columnAlignment: end
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: Q
            }
            security {
                escapeSpecialChars: false
            }
        )

        column Tipo (
            type: plainText
            heading {
                heading: Tipo
            }
            layout {
                sequence: 140
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: P
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 11088848 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn "C/T/R" (
                sequence: 4
            )

            displayColumn "Produto Detalhado" (
                sequence: 1
            )

            displayColumn "Qtde Comprada" (
                sequence: 2
            )

            displayColumn "Qtde Recebida" (
                sequence: 3
            )

            sort (
                column: "Produto Detalhado"
                sort {
                    sequence: 1
                }
            )

            sort (
                column: C/T/R
                sort {
                    sequence: 2
                }
            )

        )

    )

    pageItem P604_IDORDEMCOMPRA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @c-t-r
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

