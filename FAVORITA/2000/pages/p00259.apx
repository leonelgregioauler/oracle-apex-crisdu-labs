    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region fechamento-semanal (
        name: Fechamento Semanal
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idfechamento
                     , semana
                     , roman.pck_romance.fnc_nomefilial(f.idfilial) Filial
                     , saldoanteriorgaveta
                     , totalcobranca
                     , f.totalentradasdiversas
                     , totalvendasdiretas
                     , totalchqsemfundorecebidos
                     , totalboletosfavorita
                     , totaldespesas
                     , totalcomissoesrepresentantes
                     , totalcomissaogerente
                     , totaldepositosespecie
                     , totaldepsitoscheques
                     , totalcomissoesfavoritarepres
                     , totalcomissoesfavoritagerente
                     , saldofinalespecie
                     , saldofinalcheque
                     , subtotalgaveta
                     , totalsaidasdiversas
                     , totalgaveta
                     , decode(concluido,'S','Sim','Não') concluido
                     , to_number(substr(f.semana,4,4)) "Ano"
                     , f.observacao
                     , f.totaldepositosfavorita
                     , nvl(f.totalgaveta*ff.fatorconversao,0) valorpagoconversao 
                from roman.fechamentossemanais f
                   , roman.vw_filiais ff
                where f.idfilial = ff.idfilial
                  and f.idfilialfavorita = :P0_IDFILIALCAIXA
                order by 3, 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 272
                items: {
                    P272_IDFECHAMENTO: #IDFECHAMENTO#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#menu/pencil16x16.gif"  border="0">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhum fechamento feito.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
