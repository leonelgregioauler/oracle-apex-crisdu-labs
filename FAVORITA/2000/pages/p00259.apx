    process atualiza-fechamentos (
        name: Atualiza Fechamentos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  for i in (select idfechamento
                             from fechamentossemanais 
                             where idfilialfavorita = :P0_IDFILIALCAIXA       
                               and idsemana >= 830
                             ORDER BY 1)
                  LOOP
                    --
                    pck_fechamentos_fav.prc_atualizafechamento_v2(pidfechamento => i.idfechamento);
                    --
                  END LOOP;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 4854683732204624411
        }
    )

)

