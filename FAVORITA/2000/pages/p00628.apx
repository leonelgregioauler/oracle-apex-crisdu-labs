page 628 (
    name: Pedidos Atendente
    title: Pedidos Atendente
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region pedidos-atendente (
        name: Pedidos Atendente
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpedido
                     , favorita.pck_util_fav.fnc_nomevendedora(p.idvendedora) vendedora
                     , p.dataemissao
                     , p.dataentrega
                     , p.valortotal
                  from favorita.vw_pedidos_fav_new p
                     , favorita.perfis             pf
                     , favorita.perfisvendas       pv
                     , favorita.perfisatendimentos pa
                 where p.idperfilatendimento = pa.idperfilatendimento(+)
                   and pa.idperfilvenda      = pv.idperfilvenda(+)
                   and pv.idperfil           = pf.idperfil(+)
                   and p.dataemissao between to_date(nvl(:p628_dataini,trunc(sysdate)) || ' 000001','dd/mm/rrrr hh24miss') and 
                                             to_date(nvl(:p628_datafim,trunc(sysdate)) || ' 235959','dd/mm/rrrr hh24miss')
                   and p.tipopedido in ('P','R')
                   and p.idsituacaoentrega >= 20000
                   and p.datacancelamento is null 
                   and p.valorapagar > 0 
                   and favorita.pck_util_fav.fnc_verificagrupoatendimento(4, p.idusuario) = 'S'
                   and p.idfilialromance = :P628_IDFILIALROMANCE
                   and p.idusuario = :P628_IDUSUARIO_ATENDENTE
                   and pf.idperfil = :P628_IDPERFIL
                   and pv.idperfilvenda = :P628_IDPERFILVENDA
                   -- Maicon Aimi - 8955213 - 12/08/2024 - Adicionado filtro Distribuidor Emitiu.
                   and (   ( :P628_DIST_EMITIU = 'T' )
                        or ( :P628_DIST_EMITIU = 'S' and exists ( select 1
                                                                    from classificacoespedidos c
                                                                   where c.idpedido = p.idpedido
                                                                     and c.idcaracteristicapedido = 2 ) ) 
                        or ( :P628_DIST_EMITIU = 'N' and not exists ( select 1
                                                                        from classificacoespedidos c
                                                                       where c.idpedido = p.idpedido
                                                                         and c.idcaracteristicapedido = 2 ) ) )
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 2432227068507407737
        }

        column DATAEMISSAO (
            type: plainText
            heading {
                heading: Data Emissão
            }
            layout {
                sequence: 3
            }
            appearance {
                formatMask: dd/mm/yyyy
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column DATAENTREGA (
            type: plainText
            heading {
                heading: Data Entrega
            }
            layout {
                sequence: 4
            }
            appearance {
                formatMask: dd/mm/yyyy
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column IDPEDIDO (
            type: link
            heading {
                heading: Id Pedido
                alignment: end
            }
            layout {
                sequence: 1
                columnAlignment: end
            }
            link {
                target: {
                    page: 537
                    items: {
                        P537_NRPEDIDO: #IDPEDIDO#
                        P537_PAGINA: 628
                    }
                    action: resetPagination
                }
                linkText: #IDPEDIDO#
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column VALORTOTAL (
            type: plainText
            heading {
                heading: Valor Total
                alignment: end
            }
            layout {
                sequence: 5
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column VENDEDORA (
            type: plainText
            heading {
                heading: Vendedora
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        savedReport 24322386 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAEMISSAO (
                sequence: 3
            )

            displayColumn DATAENTREGA (
                sequence: 4
            )

            displayColumn IDPEDIDO (
                sequence: 1
            )

            displayColumn VALORTOTAL (
                sequence: 5
            )

            displayColumn VENDEDORA (
                sequence: 2
            )

        )

    )

    pageItem P628_DATAFIM (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P628_DATAINI (
        type: hidden
        layout {
            sequence: 10
            slot: contentBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P628_DIST_EMITIU (
        type: hidden
        layout {
            sequence: 80
            slot: contentBody
        }
        default {
            type: static
            staticValue: T
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P628_IDFILIALROMANCE (
        type: hidden
        layout {
            sequence: 40
            slot: contentBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P628_IDPAIS (
        type: hidden
        layout {
            sequence: 50
            slot: contentBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P628_IDPERFIL (
        type: hidden
        layout {
            sequence: 30
            slot: contentBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P628_IDPERFILVENDA (
        type: hidden
        layout {
            sequence: 60
            slot: contentBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P628_IDUSUARIO_ATENDENTE (
        type: hidden
        layout {
            sequence: 70
            slot: contentBody
        }
        security {
            encryptSessionState: false
        }
    )

)

