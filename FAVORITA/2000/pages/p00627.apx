page 627 (
    name: Relatório Controle SAC
    title: Relatório Controle SAC
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 30
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuarios u
                where exists ( select 1
                               from favorita.filiaisfavorita ff
                               where ff.idfilialfavorita = u.idfilialfavorita
                                 and ff.tipofilial       = 'L' )
                  and u.usuario = v('APP_USER')
                ```
        }
    )

    region controle-sac-para-loja (
        name: Controle SAC para Loja
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct(c.idcontrolecontatossite)
                     , decode(c.tipoprotocolo,'S','SAC','C','Crédito',' ') "Tp.Protocolo"
                     , c.nomecompleto
                     , c.cpf
                     , c.datanascimento
                     , c.rua
                     , c.nr
                     , c.complemento
                     , c.bairro
                     , c.idcidade
                     , c.cidade
                     , c.cep
                     , c.fone
                     , c.fone2
                     , c.email
                     , c.mensagem
                     , c.observacao
                     , c.situacao
                     , c.descricaosituacao
                     , c.datacadastro
                     , c.idfilial
                     , c.filialromance
                     , c.idrepresentante
                     , c.nomerepresentante
                     , c.dataliberadofilial
                     , c.datapassadorepres
                     , c.observacaofilial
                     , c.origemdesc origem
                     , c.tipo
                     , c.tiposolicitacaosac
                     , c.idfilialorig
                     , c.filialromanceorigem
                     , c.idrepresentanteorig
                     , c.nomerepresentanteorigem
                     , c.idvendedoraorig
                     , c.nomevendedoraorigem
                     , c.cadastrado
                     , c.tiposolicitacaomanual
                     , c.cidademanual
                     , c.inadimplente
                     , c.nroconsultaspc
                     , c.usuariocadastrou
                     , c.cadastrosistema
                     , c.situacaocliente
                     , c.numeroprocesso
                from vw_controlecontatossite_fav c
                where nvl(c.idpais,1) = 1
                  and c.origem = 'LF'
                  and c.idfilialfavorita = :P0_IDFILIALFAVORITA
                  and :P627_FILTRAR = 'S'
                  and (:P627_NUMEROPROCESSO is null or c.numeroprocesso = :P627_NUMEROPROCESSO)
                order by 1 desc
                  
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuarios u
                where exists ( select 1
                               from favorita.filiaisfavorita ff
                               where ff.idfilialfavorita = u.idfilialfavorita
                                 and ff.tipofilial       = 'L' )
                  and u.usuario = v('APP_USER')
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado obtido. Verifique os filtros!
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 2449847460125502323
        }

