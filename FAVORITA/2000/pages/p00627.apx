    pageItem P627_DISTRIBUIDOR (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select '- Todos -' display_value
                     , case when :P627_POSTOAVANCADO IS NULL THEN -1 else -2 end return_value
                from dual
                union
                select roman.pck_romance.fnc_nomepessoa(r.idpessoa) display_value
                     , r.idrepresentante
                from catal.representantes r
                where r.ativo = 'S'
                  and ( :P627_POSTOAVANCADO is null or r.idpostoavancado = :P627_POSTOAVANCADO)
                order by 1
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P627_POSTOAVANCADO
            itemsToSubmit: P627_DISTRIBUIDOR
        }
        layout {
            sequence: 190
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        default {
            type: expression
            plsqlExpression: null
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from catal.usuarios u
                where u.usuario = v('APP_USER')
                  and exists( select 1
                              from roman.usuariosgruposatendimento g 
                              where u.usuario = g.usuario
                                and g.idgrupoatendimento in (48,0))
                ```
        }
        security {
            encryptSessionState: false
        }
    )

