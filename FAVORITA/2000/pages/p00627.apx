    region relatório-de-controle-sac-2 (
        name: Relatório de Controle SAC
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct(c.idcontrolecontatossite)
                     , decode(c.tipoprotocolo,'S','SAC','C','Crédito',' ') "Tp.Protocolo"
                     , c.nomecompleto
                     , c.cpf
                     , c.datanascimento
                     , c.rua
                     , c.nr
                     , c.complemento
                     , c.bairro
                     , c.idcidade
                     , c.cidade
                     , c.cep
                     , c.fone
                     , c.fone2
                     , c.email
                     , c.mensagem
                     , c.observacao
                     , c.situacao
                     , c.descricaosituacao
                     , c.datacadastro
                     , c.idfilial
                     , c.filialromance
                     , c.idrepresentante
                     , c.nomerepresentante
                     , c.dataliberadofilial
                     , c.datapassadorepres
                     , c.observacaofilial
                     , c.origemdesc origem
                     , c.tipo
                     , c.tiposolicitacaosac
                     , c.idfilialorig
                     , c.filialromanceorigem
                     , c.idrepresentanteorig
                     , c.nomerepresentanteorigem
                     , c.idvendedoraorig
                     , c.nomevendedoraorigem
                     , c.cadastrado
                     , c.tiposolicitacaomanual
                     , c.cidademanual
                     , c.inadimplente
                     , c.nroconsultaspc
                     , c.usuariocadastrou
                     , c.cadastrosistema
                     , c.situacaocliente
                     , cc.spc_quantidade
                     , cc.spc_valortotal
                     , cc.idade
                     , cc.idconsultaspc
                     , cc.ccf
                     , nvl((select 'Sim'
                            from dual
                            where exists ( select 1
                                           from roman.classificacoessac cc
                                           where cc.idcontrolecontatossite = c.idcontrolecontatossite 
                                             and cc.idcaracteristicasac in (21,22,23) )),'Não') possuitarefa
                     , (select s.setor
                         from roman.setoreschamados s
                        where s.idsetorchamado = c.idsetor) setor
                     , c.subtiposol
                    -- , c.idsetor
                     , c.numeroprocesso 
                from vw_controlecontatossite_fav c
                   , roman.consultaspc cc
                where replace(replace(c.cpf,'.',''),'-','') = cc.cpf(+)
                  --and sysdate - cc.dataconsulta <= 30
                  --and nvl(c.idpais,1) = 1
                  and c.situacao = 'M'
                  and ( :P627_NRPROTOCOLO is null or c.idcontrolecontatossite = :P627_NRPROTOCOLO )
                  and ( :P627_SITUACAO = 'XX' or c.situacao = :P627_SITUACAO )
                  and ( pck_util_fav.fnc_verificaacesso(52107,:P0_IDUSUARIO) = 'S' or c.idfilialfavorita = :P0_IDFILIALFAVORITA )
                  and ( :P627_CPF is null or replace(replace(c.cpf,'.',''),'-','') = replace(replace(:P627_CPF,'.',''),'-','') )
                  and ( :P627_NOME is null or lower(c.nomecompleto) like '%'||lower(:P627_NOME)||'%' )
                  and ( :P627_EMAIL is null or lower(c.email) like '%'||lower(:P627_EMAIL)||'%' )
                  and ( :P627_ORIGEM is null or c.origem = :P627_ORIGEM )
                  and ( :P627_IDCIDADE is null or c.idcidade = :P627_IDCIDADE )
                  and ( :P627_DATANASCIMENTO is null or c.datanascimento = to_date(:P627_DATANASCIMENTO,'DD/MM/RRRR') )
                  and ( :P627_DATACADASTRO_INI is null or trunc(c.datacadastro) between to_date(:P627_DATACADASTRO_INI,'DD/MM/RRRR') and to_date(:P627_DATACADASTRO_FIM,'DD/MM/RRRR') )
                  and ( :P627_COMTAREFA is null or exists ( select 1
                                                            from roman.classificacoessac cc
                                                            where cc.idcontrolecontatossite = c.idcontrolecontatossite 
                                                              and cc.idcaracteristicasac in (21,22,23) ) ) 
                  and ( :P627_COMCONSULTA is null or exists ( select 1
                                                              from roman.consultaspc spc
                                                              where replace(replace(c.cpf,'.',''),'-','') = spc.cpf ) )
                  and ( :P627_SITUACAO_CLIENTE is null or exists ( select 1
                                                                   from vendedoras v
                                                                      , pessoas p
                                                                   where v.idpessoa = p.idpessoa
                                                                     and v.ativo    = :P627_SITUACAO_CLIENTE
                                                                     and p.cpf      = replace(replace(c.cpf,'.',''),'-','') ) )
                  and ( :P627_VALORRESTRICAO is null or cc.spc_valortotal <= :P627_VALORRESTRICAO )
                  and ( :P627_QTDRESTRICAO is null or cc.spc_quantidade <= :P627_QTDRESTRICAO )
                  and ( :P627_IDADE is null or cc.idade >= :P627_IDADE )
                  and ( :P627_ESTADO is null or exists ( select 1
                                                           from roman.cidades cc
                                                           where cc.idcidade = c.idcidade 
                                                             and cc.idestado = :P627_ESTADO ) )
                  and (:P627_SOLICITACAO is null or c.tipo = :P627_SOLICITACAO)
                  and (:P627_IDFILIALFAVORITA is not null and c.idfilialfavorita in (select regexp_substr(:P189_IDFILIALFAVORITA, '[^:]+', 1, level) 
                                                                                       from dual
                                                                            connect by level <= regexp_count(:P189_IDFILIALFAVORITA, ':') + 1) )
                  and (:P627_IDSETOR is null or c.idsetor = :P627_IDSETOR )
                  and (:P627_DOC_ESTRANGEIRO is null or replace(replace(c.documentoestrangeiro,'.',''),'-','') = replace(replace(:P627_DOC_ESTRANGEIRO,'.',''),'-','') )
                  and :P627_FILTRAR = 'S'
                  and (:P627_NUMEROPROCESSO is null or c.numeroprocesso = :P627_NUMEROPROCESSO)
                  --< 9497081
                  and (cc.idconsultaspc is null or cc.idconsultaspc = (select max(t.idconsultaspc)
                                                                              from roman.consultaspc t
                                                                             where t.cpf = replace(replace(c.cpf,'.',''),'-','')))
                  -- 9497081 />
                  -- 9497081 />
                order by 1 desc
                  
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.usuariosgruposatendimento ug
                where ug.idgrupoatendimento = 48
                  and ug.usuario = v('APP_USER')
                  and :P627_IDPAIS = 1
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
