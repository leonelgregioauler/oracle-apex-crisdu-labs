    dynamicAction mostra-subtipo (
        name: Mostra_subtipo
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P627_SOLICITACAO
        }
        clientSideCondition {
            type: itemIsInList
            item: P627_SOLICITACAO
            list: [
                3
                4
                5
                7
            ]
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P627_IDFILIALFAVORITA
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P627_IDFILIALFAVORITA
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P627_DISTRIBUIDOR
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    
                     IF :P627_DISTRIBUIDOR = -2  THEN  
                        :P627_NEW := 1;
                     ELSE  
                        :P627_NEW := 0 ;
                     END IF;
                    
                    END;
                    ```
                itemsToSubmit: P627_DISTRIBUIDOR
                itemsToReturn: P627_NEW
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process filtrar (
        name: FILTRAR
        type: executeCode
        source {
            plsqlCode: :P627_FILTRAR := 'S';
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 3405060110064031504
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

    branch (
        name: Go To Page 627
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 627
                items: {
                    P627_NRPROTOCOLO: &P627_NRPROTOCOLO.
                    P627_SITUACAO: &P627_SITUACAO.
                    P627_CPF: &P627_CPF.
                    P627_NOME: &P627_NOME.
                    P627_ORIGEM: &P627_ORIGEM.
                    P627_DATANASCIMENTO: &P627_DATANASCIMENTO.
                    P627_EMAIL: &P627_EMAIL.
                    P627_ESTADO: &P627_ESTADO.
                    P627_DATACADASTRO_FIM: &P627_DATACADASTRO_FIM.
                    P627_DATACADASTRO_INI: &P627_DATACADASTRO_INI.
                    P627_SITUACAO_CLIENTE: &P627_SITUACAO_CLIENTE.
                    P627_VALORRESTRICAO: &P627_VALORRESTRICAO.
                    P627_QTDRESTRICAO: &P627_QTDRESTRICAO.
                    P627_IDADE: &P627_IDADE.
                    P627_COMCONSULTA: &P627_COMCONSULTA.
                    P627_COMTAREFA: &P627_COMTAREFA.
                    P627_IDCIDADE: &P627_IDCIDADE.
                    P627_IDPAIS: &P627_IDPAIS.
                    P627_DOC_ESTRANGEIRO: &P627_DOC_ESTRANGEIRO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

)

