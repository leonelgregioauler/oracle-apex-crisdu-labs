page 452 (
    name: Metas Filiais
    title: Metas Filiais
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG_23"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--large
                t-Form--stretchInputs
                t-Form--labelsAbove
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region meta (
        name: Meta
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDMETAFILIALFAVORITA,
                       IDFILIALFAVORITA,
                       NUMEROMES,
                       ANO,
                       VALORMETA
                  from METASFILIAISFAVORITA m
                WHERE ano = :P452_ANO
                  and (:P452_IDFILIALFAVORITA IS NULL OR IDFILIALFAVORITA = :P452_IDFILIALFAVORITA )
                  and (:P452_MES              is null or numeromes = :P452_MES)
                  and exists ( select 1
                               from filiaisfavorita ff
                               where ff.idfilialfavorita = m.idfilialfavorita
                                 and ff.tipofilial       = :P452_TIPO )
                
                ```
            pageItemsToSubmit: [
                P452_IDFILIALFAVORITA
                P452_ANO
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: META
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
            sendAsEmail: false
        }
        advanced {
            savedReportMappingIdentifier: 4554875503030258903
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDMETAFILIALFAVORITA
                layout {
                    show: false
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDFILIALFAVORITA
                layout {
                    width: 200
                    sequence: 5
                }
            )

            displayColumn (
                column: @NUMEROMES
                layout {
                    width: 100
                    sequence: 3
                }
            )

            displayColumn (
                column: @ANO
                layout {
                    width: 60
                    sequence: 3
                }
            )

            displayColumn (
                column: @VALORMETA
                layout {
                    width: 656
                    sequence: 5
                }
            )

            displayColumn (
                column: @ROWID
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column ANO (
            type: numberField
            heading {
                heading: Ano
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                databaseColumn: ANO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column IDFILIALFAVORITA (
            type: selectList
            heading {
                heading: Filial
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select F.nomefilialfavorita
                         , f.idfilialfavorita
                    from vw_filiaisfavorita f
                    order by 1
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: IDFILIALFAVORITA
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
            readOnly {
                type: always
            }
        )

        column IDMETAFILIALFAVORITA (
            type: numberField
            heading {
                heading: Idmetafilialfavorita
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDMETAFILIALFAVORITA
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column NUMEROMES (
            type: selectList
            heading {
                heading: Mês
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(mes) display_value
                         , to_number(numero) return_value
                    from roman.meses
                    
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: NUMEROMES
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column ROWID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ROWID
                dataType: rowid
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column VALORMETA (
            type: numberField
            heading {
                heading: Meta
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
            source {
                databaseColumn: VALORMETA
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

    )

    pageItem P452_ANO (
        type: selectList
        label {
            label: Ano
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:2020;2020,2021;2021,2022;2022
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: expression
            plsqlExpression: to_char(sysdate,'RRRR')
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P452_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Filial
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select F.nomefilialfavorita
                     , f.idfilialfavorita
                from vw_filiaisfavorita f
                where f.codtipofilial = :P452_TIPO
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Todas -
        }
        cascadingLov {
            parentItems: P452_TIPO
        }
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P452_MES (
        type: selectList
        label {
            label: Mês
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(mes) display_value
                     , to_number(numero) return_value
                from roman.meses
                order by 2
                ```
            displayExtraValues: false
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P452_TIPO (
        type: selectList
        label {
            label: Tipo
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct f.tipofilial display_value
                    , f.codtipofilial  return_value
                from vw_filiaisfavorita f
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 50
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction filtrar (
        name: FILTRAR
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process meta-save-interactive-grid-data (
        name: Meta - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @meta
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 4554876844689258916
        }
    )

)

