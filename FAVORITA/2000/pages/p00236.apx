    region relatório-de-integração-de-pedidos-ao-virtual-age (
        name: Relatório de Integração de Pedidos ao Virtual Age
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||p.idpedido ,'SESSION')||''',''_blank''); void(0)">'||p.idpedido||'</a>' numeropedido
                     , p.idedicaorevista
                     , p.edicaorevista
                     , p.idfilialfavorita
                     , p.filialfavorita
                     , p.idfilialromance
                     , p.filialromance
                     , p.idgerente
                     , p.gerente
                     , p.idrepresentante
                     , p.representante
                     , p.idvendedora
                     , p.vendedora
                     , p.cpf
                     , p.idusuario
                     , p.nomeusuario
                     , p.dataemissao
                     , p.dataentrega
                     , p.datadespacho
                     , p.valortotalcusto
                     , p.valortotal
                     , p.valorpontoutilizado
                     , p.valordesconto
                     , p.valortotalcomdesconto
                     , p.valorapagar
                     , p.situacaoentregainterno
                     , p.situacaocobrancainterno
                     , p.situacaofinanceirointerno
                     , p.idpedidovirtualage
                     , case
                         when p.datacancelamento is null then
                           'Não'
                         when p.datacancelamento is not null then
                           'Sim'
                         end "Cancelado"
                     , 1
                  from vw_pedidos_fav p
                  where ididioma = :P0_IDIDIOMA
                  and idpedidovirtualage is not null
                  and ( :P236_TIPODATA = 'N' or ( :P236_TIPODATA = 'EM' and to_char(trunc(p.dataemissao), 'DD/MM/RRRR') between to_date(:P236_DATAINICIO,'DD/MM/RRRR') and to_date(:P236_DATAFIM,'DD/MM/RRRR') )
                                             or ( :P236_TIPODATA = 'EN' and to_char(trunc(p.dataentrega), 'DD/MM/RRRR') between to_date(:P236_DATAINICIO,'DD/MM/RRRR') and to_date(:P236_DATAFIM,'DD/MM/RRRR') ) )
                  and ( :P236_IDPEDIDO is null or p.idpedido = :P236_IDPEDIDO )
                  and ( :P236_IDFILIALFAVORITA is null or p.idfilialfavorita = :P236_IDFILIALFAVORITA )
                  and ( :P236_IDFILIALROMANCE is null or p.idfilialromance = :P236_IDFILIALROMANCE )
                  and ( :P236_DISTRIBUIDOR is null or p.idrepresentante = :P236_DISTRIBUIDOR )
                  and ( :P236_CONSULTORA is null or p.idvendedora = :P236_CONSULTORA )
                  and ( :P236_IDUSUARIO is null or p.idusuario = :P236_IDUSUARIO )                             
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1397105267994595006
        }

