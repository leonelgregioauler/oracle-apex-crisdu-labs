    )

    dynamicAction confirmar-devolução (
        name: Confirmar Devolução
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @confirmardevolucao
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: javascript:apex.submit('CONFIRMARDEVOLUCAO');
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

