    pageItem P263_IDPRODUTODETALHADO (
        type: plugin/select
        label {
            label: Produto
            alignment: left
        }
        settings {
            selectOnBlur: attributeValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDITEMPEDIDO||'-'|| nomeprodutodetalhado||' - Qtd:'||( i.quantidade- nvl( ( select sum(id.quantidade)
                                                                               from itensdevolucaopedidos id
                                                                               where id.iditempedido = i.iditempedido),0)) ||' - R$ '||
                        TRIM(to_char( i.quantidade * i.valorvenda,'999G999G999G990D00')) display_item
                     , i.iditempedido as r
                from vw_itenspedidos_fav i
                   , produtosdetalhados p
                where i.idprodutodetalhado = p.idprodutodetalhado
                and i.ididioma = 1
                and ( i.iditempedido = :P263_IDPRODUTODETALHADO or i.idpedido = :P263_IDPEDIDO  )
                and not exists (select id.iditempedido
                                  from itensdevolucaopedidos id
                                  where id.iditempedido = i.iditempedido)
                  and i.quantidade > 0
                order by 1                
                
                
                ```
            nullDisplayValue: - Selecione o Produto -
        }
        layout {
            sequence: 30
            region: @quantidades-de-devolução-defeito-ou-avaria
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeprodutodetalhado(id.idprodutodetalhado,:P0_IDIDIOMA) ||' <br> Quantidade: '||id.quantidade nomeprodutodetalhado
                from itensdevolucaopedidos id
                where id.iditemdevolucaopedido = :P263_IDITEMDEVOLUCAOPEDIDO
                ```
        }
        security {
            encryptSessionState: false
            escapeSpecialChars: false
        }
    )

