    button confirmardevolucao (
        buttonName: CONFIRMARDEVOLUCAO
        label: Confirmar Devolução
        layout {
            sequence: 10
            region: @quantidades-de-devolução-defeito-ou-avaria
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
