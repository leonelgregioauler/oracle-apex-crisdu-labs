    validation informar-defeito (
        name: Informar defeito
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P263_IDDEFEITO
        }
        error {
            errorMessage: Informe o defeito!
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P263_QUANTIDADEDEFEITO
        }
    )

    validation valida-quantidades (
        name: Valida quantidades
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from itensdevolucaopedidos
                where iditemdevolucaopedido = :P263_IDITEMDEVOLUCAOPEDIDO
                 and quantidade = (to_number(:P263_QUANTIDADEDEVOLVIDA,'0')
                                  +to_number(:P263_QUANTIDADEDEFEITO,'0')
                                  +to_number(:P263_QUANTIDADEAVARIA,'0')
                                  +to_number(:P263_QUANTIDADETROCADA, '0')
                                  +to_number(:P263_QUANTIDADENAORECEBIDA,'0'))
                ```
        }
        error {
            errorMessage: A soma das quantidades deve ser igual a quantidade da devolução.
        }
        serverSideCondition {
            type: never
        }
    )

    process consulta-de-item (
        name: Consulta de Item
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vquantidade        number := null;
                begin
                  pck_protocolosatendimentos_fav.prc_incluiitemdevolucaopedido(piditemdevolucaopedido => :P263_IDITEMDEVOLUCAOPEDIDO,
                                                                                 pidprotocoloatendimento => :P263_IDPROTOCOLOATENDIMENTO,
                                                                                 pidpedido => :P263_IDPEDIDO,
                                                                                 piditempedido => :P263_IDITEMPEDIDO,
                                                                                 pidproduto => :P263_IDPRODUTO,
                                                                                 pidprodutodetalhado => :P263_IDPRODUTODETALHADO,
                                                                                 pquantidade => vquantidade,
                                                                                 pquantidadedevolucao => :P263_QUANTIDADEDEVOLVIDA,
