page 263 (
    name: Informar Devolução de Produtos
    title: Informar Devolução de Produtos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG_25"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region itens-já-adicionados-para-devolução (
        name: Itens Já Adicionados para Devolução
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select if.iditemdevolucaopedido
                     , if.idpedido
                     , if.idprotocoloatendimento
                     , if.idprodutodetalhado
                     , if.nomeprodutodetalhado
                     , if.quantidade
                     , if.quantidadedevolvido
                     , if.quantidadedefeito
                     , if.quantidadeavaria
                     , if.quantidadetrocado
                     , if.quantidadenaorecebida
                     , if.dataconfirmacaoestoque
                     , if.usuarioestoque
                     , if.confirmacaoestoque
                from vw_itensdevolucaopedidos_fav if
                where if.ididioma = 1
                  and if.idprotocoloatendimento = :P263_IDPROTOCOLOATENDIMENTO
                  and if.idpedido = :P263_IDPEDIDO
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from vw_itensdevolucaopedidos_fav if
                where if.ididioma = 1
                  and if.idprotocoloatendimento = :P263_IDPROTOCOLOATENDIMENTO
                  and if.idpedido = :P263_IDPEDIDO
                ```
        }
        link {
            linkColumn: customTarget
            target: {
                page: 263
                items: {
                    P263_IDITEMDEVOLUCAOPEDIDO: #IDITEMDEVOLUCAOPEDIDO#
                    P263_IDPROTOCOLOATENDIMENTO: #IDPROTOCOLOATENDIMENTO#
                }
                action: resetPagination
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum item encontrado ou adicionado
        }
        advanced {
            savedReportMappingIdentifier: 1376232605064714401
        }

