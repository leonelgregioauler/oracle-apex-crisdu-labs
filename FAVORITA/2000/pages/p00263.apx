                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P263_IDITEMDEVOLUCAOPEDIDO is null
        }
    )

