    region relatório-de-inadimplência-detalhado (
        name: Relatório de Inadimplência Detalhado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(vp.datavencimento,'MM/RRRR') mesvencimento
                     , favorita.pck_util_fav.fnc_nomefilialfavorita(p.idfilialfavorita) filialfavorita
                     , favorita.pck_util_fav.fnc_nomefilialromance(p.idfilialromance) filialromance
                     , favorita.pck_util_fav.fnc_nomerepresentante(p.idrepresentante) representante
                     , pp.nomepessoa consultora
                     , pp.cpf 
                     , pp.datanascimento 
                     , p.idpedido
                     , vp.valorpagar * p.fatorconversao valorpagar
                     , vp.valorpago * p.fatorconversao valorpago
                     , nvl(( select sum(pag.valorpago) * p.fatorconversao
                             from favorita.pagamentospedidos pag
                             where vp.idvencimentopedido = pag.idvencimentopedido
                               and vp.idpedido = p.idpedido
                               and pag.idsituacao = 20
                               and ( select nvl(trunc(pagi.datapagamento),trunc(vp.datavencimento))
                                     from favorita.pagamentospedidos pagi
                                     where pagi.idvencimentopedido = vp.idvencimentopedido
                                       and pagi.idpagamentopedido = pag.idpagamentopedido) <= fnc_datavencimentoutil(vp.datavencimento)),0) valorpagoemdia
                     , ( select listagg(trunc(pag.datapagamento),'-') within group (order by 1 desc)
                         from favorita.pagamentospedidos pag
                         where vp.idvencimentopedido = pag.idvencimentopedido
                           and vp.idpedido = p.idpedido
                           and pag.idsituacao = 20 ) datapago
                     , trunc(p.dataemissao) dataemissao
                     , p.dataentrega
                     , vp.datavencimento
                from favorita.vencimentospedidos vp
                   , favorita.pedidos p
                   , vendedoras v
                   , pessoas pp
                where p.idpedido = vp.idpedido
                  and v.idvendedora = p.idvendedora
                  and pp.idpessoa = v.idpessoa
                  and vp.situacaovencimento = 'V'
                  and p.datacancelamento is null
                  and ( :P389_DISTRIBUIDOR_FEZ = 'A' 
                     or ( :P389_DISTRIBUIDOR_FEZ = 'S' and exists ( select 1
                                                                    from classificacoespedidos cp
                                                                    where cp.idpedido = p.idpedido
                                                                      and cp.idcaracteristicapedido = 2 ) )
                     or ( :P389_DISTRIBUIDOR_FEZ = 'N' and not exists ( select 1
                                                                        from classificacoespedidos cp
                                                                        where cp.idpedido = p.idpedido
                                                                          and cp.idcaracteristicapedido = 2 ) ) )
                  and :P389_TIPORELATORIO = 1
                  and trunc(vp.datavencimento) between to_date(:P389_DATAEMISSAO_INICIAL,'dd/mm/rrrr') and to_date(:P389_DATAEMISSAO_FINAL,'dd/mm/rrrr')
                  and (:P389_IDFILIALROMANCE is null 
                       or( p.idfilialromance = :P389_IDFILIALROMANCE))
                  and (:P389_IDFILIALFAVORITA is null 
                       or (p.idfilialfavorita = :P389_IDFILIALFAVORITA))
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P389_TIPORELATORIO
            value: 1
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1544436415521845048
        }

