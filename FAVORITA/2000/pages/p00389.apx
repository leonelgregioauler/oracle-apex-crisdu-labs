    region relatório-de-inadimplência-resumido (
        name: Relatório de Inadimplência Resumido
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(vp.datavencimento,'MM/RRRR') mesvencimento
                     , favorita.pck_util_fav.fnc_nomefilialromance(p.idfilialromance) filialromance
                     , favorita.pck_util_fav.fnc_nomerepresentante(p.idrepresentante) representante
                     , sum(vp.valorpagar*p.fatorconversao) valorpagar
                     , sum(vp.valorpago*p.fatorconversao) valorpago
                     , sum(nvl(( select sum(pag.valorpago)
                                 from favorita.pagamentospedidos pag
                                 where vp.idvencimentopedido = pag.idvencimentopedido
                                   and vp.idpedido = p.idpedido
                                   and pag.idsituacao = 20
                                   and ( select nvl(trunc(pagi.datapagamento),trunc(vp.datavencimento))
                                         from favorita.pagamentospedidos pagi
                                         where pagi.idvencimentopedido = vp.idvencimentopedido
                                           and pagi.idpagamentopedido = pag.idpagamentopedido) <= fnc_datavencimentoutil(vp.datavencimento)),0) * p.fatorconversao) valorpagoemdia
                      , sum(nvl((select sum(v.valorpagar - v.valorpago) * p.fatorconversao
                                 from vencimentospedidos v
                                 where v.idpedido         = p.idpedido
                                 and v.idvencimentopedido = vp.idvencimentopedido
                                 and v.valorpagar > 0
                                 and v.situacaovencimento = 'V'
                                 and trunc(v.datavencimento) between trunc(sysdate) - 15 and trunc(sysdate)), 0)) valorvencido0e15dias 
                     , sum(nvl(( select sum(v.valorpagar - v.valorpago) * p.fatorconversao
                                 from vencimentospedidos v
                                 where v.idpedido         = p.idpedido
                                 and v.idvencimentopedido = vp.idvencimentopedido
                                 and v.valorpagar > 0
                                 and v.situacaovencimento = 'V'
                                 and trunc(v.datavencimento) between trunc(sysdate) - 30 and trunc(sysdate) - 16), 0)) valorvencido16e30dias 
                     , sum(nvl(( select sum(v.valorpagar - v.valorpago) * p.fatorconversao
                                 from vencimentospedidos v
                                 where v.idpedido         = p.idpedido
                                 and v.idvencimentopedido = vp.idvencimentopedido
                                 and v.valorpagar > 0
                                 and v.situacaovencimento = 'V'
                                 and trunc(v.datavencimento) between trunc(sysdate) - 60 and trunc(sysdate) - 31), 0)) valorvencido31e60dias 
                     , sum(nvl(( select sum(v.valorpagar - v.valorpago) * p.fatorconversao
                                 from vencimentospedidos v
                                 where v.idpedido         = p.idpedido
                                 and v.idvencimentopedido = vp.idvencimentopedido
                                 and v.valorpagar > 0
                                 and v.situacaovencimento = 'V'
                                 and trunc(v.datavencimento) < trunc(sysdate) - 61), 0)) valorvencidomaior60dias                                                    
                from favorita.vencimentospedidos vp
                   , favorita.pedidos p
                where p.idpedido = vp.idpedido
                  and vp.situacaovencimento = 'V'
                  and p.datacancelamento is null
                  and :P389_TIPORELATORIO = 2
                  and ( :P389_DISTRIBUIDOR_FEZ = 'A' 
                     or ( :P389_DISTRIBUIDOR_FEZ = 'S' and exists ( select 1
                                                                    from classificacoespedidos cp
                                                                    where cp.idpedido = p.idpedido
                                                                      and cp.idcaracteristicapedido = 2 ) )
                     or ( :P389_DISTRIBUIDOR_FEZ = 'N' and not exists ( select 1
                                                                        from classificacoespedidos cp
                                                                        where cp.idpedido = p.idpedido
                                                                          and cp.idcaracteristicapedido = 2 ) ) )
                  and trunc(vp.datavencimento) between to_date(:P389_DATAEMISSAO_INICIAL,'dd/mm/rrrr') and to_date(:P389_DATAEMISSAO_FINAL,'dd/mm/rrrr')
                  and (:P389_IDFILIALROMANCE is null 
                       or( p.idfilialromance = :P389_IDFILIALROMANCE))
                  and (:P389_IDFILIALFAVORITA is null 
                       or (p.idfilialfavorita = :P389_IDFILIALFAVORITA))
                group by to_char(vp.datavencimento,'MM/RRRR'), p.idfilialromance, p.idrepresentante
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P389_TIPORELATORIO
            value: 2
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1548040178956855502
        }

