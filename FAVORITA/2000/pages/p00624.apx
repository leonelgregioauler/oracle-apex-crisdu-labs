page 624 (
    name: Ajuste Taxa Delivery Pedido
    title: Ajuste Taxa Delivery Pedido
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 400
        height: 500
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ajuste-taxa-delivery-pedido (
        name: Ajuste Taxa Delivery Pedido
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region buttons (
        name: BUTTONS
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P624_IDPEDIDO (
        type: displayOnly
        label {
            label: Pedido
            alignment: left
        }
        layout {
            sequence: 10
            region: @ajuste-taxa-delivery-pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P624_NOVA_TAXA_DELIVERY (
        type: selectList
        label {
            label: Nova Taxa Delivery (Nova)
            alignment: left
        }
        settings {
            pageActionOnSelection: submitPage
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'R$' || to_char(t.valor, 'FM999,999,990.00') || ' - '|| t.nome  as display_value,
                       t.idtabelaprecosdelivery                                        as return_value
                from favorita.tabelaprecosdelivery t
                where t.ativo = 'S'
                  and t.idfilialfavorita = (select p.idfilialfavorita
                                              from favorita.pedidos p
                                             where p.idpedido = :P624_IDPEDIDO);
                ```
            nullDisplayValue: Selecione a taxa desejada
        }
        layout {
            sequence: 40
            region: @ajuste-taxa-delivery-pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P624_PAGINA_CHAMOU (
        type: hidden
        layout {
            sequence: 50
            region: @ajuste-taxa-delivery-pedido
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P624_TABELA_DELIVERY (
        type: displayOnly
        label {
            label: Tabela Delivery (Atual)
            alignment: left
        }
        layout {
            sequence: 20
            region: @ajuste-taxa-delivery-pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P624_TAXA_DELIVERY (
        type: displayOnly
        label {
            label: R$Taxa Delivery (Atual)
            alignment: left
        }
        layout {
            sequence: 30
            region: @ajuste-taxa-delivery-pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: FML999G999G999G999G990D00
        }
        security {
            encryptSessionState: false
        }
    )

    button alterar (
        buttonName: ALTERAR
        label: Alterar
        layout {
            sequence: 20
            region: @buttons
            slot: aboveBox
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-pencil-square-o
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: item=value
            item: P624_PAGINA_CHAMOU
            value: 68
        }
    )

    button alterar-2 (
        buttonName: ALTERAR_415
        label: Alterar
        layout {
            sequence: 10
            region: @buttons
            slot: aboveBox
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-pencil-square-o
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: item=value
            item: P624_PAGINA_CHAMOU
            value: 415
        }
    )

    dynamicAction altera-taxa-delivery (
        name: ALTERA_TAXA_DELIVERY
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @alterar
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P624_NOVA_TAXA_DELIVERY
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        
                        vTaxaDeliveri     number := null;
                        vIDTabelaDelivery number := null;
                        
                    begin
                    
                        select t.idtabelaprecosdelivery, t.valor
                          into vIDTabelaDelivery, vTaxaDeliveri
                          from favorita.tabelaprecosdelivery t
                         where t.idtabelaprecosdelivery = :P624_NOVA_TAXA_DELIVERY;
                    
                    
                        if vIDTabelaDelivery is not null then
                        
                            update favorita.pedidos p
                               set p.idtabeladelivery = vIDTabelaDelivery,
                                   p.taxadelivery = vTaxaDeliveri
                             where p.idpedido = :P624_IDPEDIDO;
                             
                             commit;
                            
                        end if;
                        
                    exception 
                        when others then
                            raise_application_error(-20001,'Erro ao tentar atualizar a taxa delivery do pedido!');
                    end;
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: ALTERAR
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction altera-taxa-delivery-2 (
        name: ALTERA_TAXA_DELIVERY_415
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @alterar-2
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        
                        vTaxaDeliveri     number := null;
                        vIDTabelaDelivery number := null;
                        
                    begin
                    
                        select t.idtabelaprecosdelivery, t.valor
                          into vIDTabelaDelivery, vTaxaDeliveri
                          from favorita.tabelaprecosdelivery t
                         where t.idtabelaprecosdelivery = :P624_NOVA_TAXA_DELIVERY;
                    
                    
                        if vIDTabelaDelivery is not null then
                        
                            update favorita.pedidos p
                               set p.idtabeladelivery = vIDTabelaDelivery,
                                   p.taxadelivery = vTaxaDeliveri
                             where p.idpedido = :P624_IDPEDIDO;
                             
                             commit;
                            
                        end if;
                        
                    exception 
                        when others then
                            raise_application_error(-20001,'Erro ao tentar atualizar a taxa delivery do pedido!');
                    end;
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: ALTERAR_415
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process carrega-taxa-delivery (
        name: CARREGA_TAXA_DELIVERY
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    select to_char(p.taxadelivery,'FM999G999G999D90'), t.nome
                      into :P624_TAXA_DELIVERY, :P624_TABELA_DELIVERY
                      from pedidos p,
                           tabelaprecosdelivery t
                     where t.idtabelaprecosdelivery = p.idtabeladelivery
                       and p.idpedido = :P624_IDPEDIDO;
                exception
                    when others then
                        null;
                end;
                   
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 2119753507049472537
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 68
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @alterar
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 415
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @alterar-2
        }
    )

)

