    process consulta-promoções-divulgações (
        name: Consulta Promoções Divulgações
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vvalorvenda  number;
                  vvalororiginal number;
                  vvalorcomissaoatendente number;
                  vidproduto number;
                begin
                  --
                  PCK_COMERCIAL_FAV.PRC_PROMOCOESDIVULGACOES ( PIDPROMOCAODIVULGACAO     => :P51_IDPROMOCAODIVULGACAO
                                                             , PIDPRODUTODETALHADO       => :P51_IDPRODUTODETALHADO
                                                             , PNOME                     => :P51_NOME
                                                             , PDATAINICIAL              => :P51_DATAINICIAL
                                                             , PDATAFINAL                => :P51_DATAFINAL
                                                             , PIDFILIALROMANCE          => :P51_IDFILIALROMANCE
                                                             , PVALORVENDA               => vvalorvenda
                                                             , PPERCCOMISSAOGERENTE      => :P51_PERCCOMISSAOGERENTE
                                                             , PPERCCOMISSAODISTRIBUIDOR => :P51_PERCCOMISSAODISTRIBUIDOR
                                                             , PPERCCOMISSAOCONSULTORA   => :P51_PERCCOMISSAOCONSULTORA
                                                             , PVALORCOMISSAOATENDENTE   => vvalorcomissaoatendente
                                                             , PMD5                      => :P51_MD5
                                                             , POPERACAO_DML             => 'S'
                                                             , pvalororiginal            => vvalororiginal
                                                             , pidfilialfavorita         => :P51_IDFILIALFAVORITA);
                  --
                  :P51_IDFILIALROMANCE_ATUALIZAR  := :P51_IDFILIALROMANCE;
                  :P51_IDFILIALFAVORITA_ATUALIZAR := :P51_IDFILIALFAVORITA;
                  :P51_VALORORIGINAL              := to_char(vvalororiginal,          '999G999G999G999G999G990D00');
                  :P51_VALORVENDA                 := to_char(vvalorvenda,             '999G999G999G999G999G990D00');
                  :P51_VALORCOMISSAOATENDENTE     := to_char(vvalorcomissaoatendente, '999G999G999G999G999G990D00');
                  --
                  if :P51_IDPROMOCAODIVULGACAO is not null then
                    --
                    select idproduto
                    into vidproduto
                    from produtosdetalhados
                    where idprodutodetalhado = :P51_IDPRODUTODETALHADO;
                    --
                    :P51_IDPRODUTO := vidproduto;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 3159284232449210
        }
        serverSideCondition {
            type: item=value
            item: P51_ORIGEM
            value: 50
        }
    )

