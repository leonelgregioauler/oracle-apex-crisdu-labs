page 51 (
    name: Cadastro de Promoções Divulgações
    title: Promoções Divulgações
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 80%
        height: 80%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            
            var htmldb_delete_message_todos='Deseja excluir toda esta promoção ?';
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region promoções-divulgações (
        name: Promoções Divulgações
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P51_DATAFINAL (
        type: datePickerJquery
        label {
            label: Data Final
            alignment: left
        }
        layout {
            sequence: 30
            region: @promoções-divulgações
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P51_DATAINICIAL (
        type: datePickerJquery
        label {
            label: Data Inicial
            alignment: left
        }
        layout {
            sequence: 20
            region: @promoções-divulgações
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P51_IDESTOQUE (
        type: radioGroup
        label {
            label: Estoque
            alignment: left
        }
        settings {
            noOfCols: 6
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) display_value
                     , idfilialfavorita   return_value
                from filiaisfavorita f
                where f.tipofilial = 'E'
                and f.idpais = :P51_IDPAIS
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P51_IDPAIS
            itemsToSubmit: P51_IDPAIS
        }
        layout {
            sequence: 50
            region: @promoções-divulgações
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P51_IDFILIALFAVORITA (
        type: shuttle
        label {
            label: Filial Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) as d,
                       idfilialfavorita as r
                  from filiaisfavorita
                where tipofilial in ('L')
                 order by 1
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 70
            region: @promoções-divulgações
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 3
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P51_IDFILIALFAVORITA_ATUALIZAR (
        type: hidden
        layout {
            sequence: 90
            region: @promoções-divulgações
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P51_IDFILIALROMANCE (
        type: shuttle
        label {
            label: Filial Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome as d,
                       idfilial as r
                  from roman.vw_filiais f
                 where tipofilial in ('C', 'D', 'P')
                   and ativo = 'S'
                   and ( idfilial in (1041, 1096) and :P51_IDPAIS = 2
                      or idfilial in (1094) and :P51_IDPAIS = 3
                      or idfilial in (1095, 1081, 1111) and :P51_IDPAIS = 4
                      or idfilial in (1108) and :P51_IDPAIS = 6
                      or idfilial not in (1041, 1096, 1095, 1081, 1085, 1111) and :P51_IDPAIS = 1 )
                      and exists ( select 1
                                   from atendimentosfiliaisrmc a
                                   where a.idfilialfavoritaorigem = nvl(:P51_IDESTOQUE, a.idfilialfavoritaorigem)
                                   and a.idfilialdestino = f.idfilial )
                 order by 1
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: [
                P51_IDPAIS
                P51_IDESTOQUE
            ]
            itemsToSubmit: [
                P51_IDPAIS
                P51_IDESTOQUE
            ]
        }
        layout {
            sequence: 60
            region: @promoções-divulgações
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 5
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P51_IDFILIALROMANCE_ATUALIZAR (
        type: hidden
        layout {
            sequence: 80
            region: @promoções-divulgações
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

