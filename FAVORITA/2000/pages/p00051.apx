    validation valida-promoções (
        name: Valida Promoções
        execution {
            sequence: 170
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  -- Verifica se existem promoções para a produto, filial e período informados
                  cursor c2 (pidfilialromance in number) is
                    select pd.idprodutodetalhado
                    from produtosdetalhados pd
                    where pd.idproduto        = :P51_IDPRODUTO
                    and pd.idprodutodetalhado = nvl(:P51_IDPRODUTODETALHADO, pd.idprodutodetalhado)
                    and exists ( select 1 
                                   from promocoesdivulgacoes d
                                   where d.idprodutodetalhado = pd.idprodutodetalhado
                                   and d.idfilialromance = pidfilialromance
                                   and (
                                         ( trunc(d.datainicial) between :P51_DATAINICIAL and :P51_DATAFINAL )
                                   or    ( trunc(d.datafinal)   between :P51_DATAINICIAL and :P51_DATAFINAL )
                                   or    ( :P51_DATAINICIAL     between trunc(datainicial) and trunc(datafinal) )
                                   or    ( :P51_DATAFINAL       between trunc(datainicial) and trunc(datafinal) )
                                        ) );
                  --
                  r2 c2%rowtype;
                  --
                  cursor c3 (pidfilialfavorita in number) is
                    select pd.idprodutodetalhado
                    from produtosdetalhados pd
                    where pd.idproduto        = :P51_IDPRODUTO
                    and pd.idprodutodetalhado = nvl(:P51_IDPRODUTODETALHADO, pd.idprodutodetalhado)
                    and exists ( select 1 
                                   from promocoesdivulgacoes d
                                   where d.idprodutodetalhado = pd.idprodutodetalhado
                                   and d.idfilialfavorita = pidfilialfavorita
                                   and (
                                         ( trunc(d.datainicial) between :P51_DATAINICIAL and :P51_DATAFINAL )
                                   or    ( trunc(d.datafinal)   between :P51_DATAINICIAL and :P51_DATAFINAL )
                                   or    ( :P51_DATAINICIAL     between trunc(datainicial) and trunc(datafinal) )
                                   or    ( :P51_DATAFINAL       between trunc(datainicial) and trunc(datafinal) )
                                        ) );
                  --
                  r3 c3%rowtype;
                  --
                  vfiliais APEX_APPLICATION_GLOBAL.VC_ARR2;
                  vfiliaisfav APEX_APPLICATION_GLOBAL.VC_ARR2;
                  --
                begin
                  --
                  --transforma o string do shutle em tabela
                  --
                  vfiliais    := APEX_UTIL.STRING_TO_TABLE(:P51_IDFILIALROMANCE);
                  vfiliaisfav := APEX_UTIL.STRING_TO_TABLE(:P51_IDFILIALFAVORITA);  
                  --
                  for rfil in 1.. vfiliais.count 
                  loop
                    open c2 (vfiliais(rfil));
                    loop
                      fetch c2 into r2;
                      exit when c2%notfound;
                      --
                      if r2.idprodutodetalhado is not null and v('REQUEST') = 'INSERIR' then
                        return 'Já existe uma promoção para o produto '||pck_util_fav.fnc_nomeprodutodetalhado(r2.idprodutodetalhado, :P0_IDIDIOMA)||
                                                          ' na filial '||pck_util_fav.fnc_nomefilialromance(vfiliais(rfil))||' neste período informado. '||:P51_DATAINICIAL||' a '||:P51_DATAFINAL;
                      end if;
                      --
                    end loop;
                    close c2;
                    --
                  end loop;
                  --
                  for rfilfav in 1.. vfiliaisfav.count
                  loop
                    open c3 (vfiliaisfav(rfilfav));
                    loop
                      fetch c3 into r3;
                      exit when c3%notfound;
                      --
                      if r3.idprodutodetalhado is not null and v('REQUEST') = 'INSERIR' then
                        return 'Já existe uma promoção para o produto '||pck_util_fav.fnc_nomeprodutodetalhado(r3.idprodutodetalhado, :P0_IDIDIOMA)||
                                                          ' na filial '||pck_util_fav.fnc_nomefilialfavorita(vfiliaisfav(rfilfav))||' neste período informado. '||:P51_DATAINICIAL||' a '||:P51_DATAFINAL;
                      end if;
                      --
                    end loop;
                    close c3;
                    --
                  end loop;
                  --
                end;
                ```
        }
    )

    validation valida-se-pode-excluir-compre-e-ganhe-já-usado (
        name: Valida se pode excluir (compre e ganhe já usado)
        execution {
            sequence: 180
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  --
                  if v('REQUEST') = 'EXCLUIRTODAS' then
                    --
                    for i in ( select pd.*
                               from itenspedidos ip
                                  , promocoesdivulgacoes pd
                               where ip.idpromocaodivulgacao = pd.idpromocaodivulgacao
                              and pd.nome = :P51_NOME ) 
                    --
                    loop
                      --
                      return 'Promoção já foi utilizada em pedidos. Não pode ser excluída.';
                      --
                    end loop;
                    --
                  elsif v('REQUEST') = 'EXCLUIR' then
                    --
                    for i in ( select pd.*
                               from itenspedidos ip
                                  , promocoesdivulgacoes pd
                               where ip.idpromocaodivulgacao = pd.idpromocaodivulgacao
                              and pd.idpromocaodivulgacao = :P51_IDPROMOCAODIVULGACAO ) 
                    --
                    loop
                      --
                      return 'Promoção já foi utilizada em pedidos. Não pode ser excluída.';
                      --
                    end loop;
                    --
                  end if;
                  --
                end;
                ```
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('EXCLUIRTODAS', 'EXCLUIR')
        }
    )

