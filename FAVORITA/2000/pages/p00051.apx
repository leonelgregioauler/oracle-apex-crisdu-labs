    process operação-dml-em-promoções-divulgações (
        name: Operação DML em Promoções Divulgações
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidpromocaodivulgacao number;
                  voperacao_dml varchar2(1);
                  --
                  vvalorvenda  number;
                  vvalororiginal number;
                  vvalorcomissaoatendente number;
                  --
                  -- Verifica os produtos selecionados em tela
                  cursor c1 is 
                    select pd.idprodutodetalhado
                    from produtosdetalhados pd
                    where pd.idproduto = :P51_IDPRODUTO
                    and pd.idprodutodetalhado = nvl(:P51_IDPRODUTODETALHADO, pd.idprodutodetalhado);
                  --
                  r1 c1%rowtype;
                  --
                  vfiliais APEX_APPLICATION_GLOBAL.VC_ARR2;
                  vfiliaisfav APEX_APPLICATION_GLOBAL.VC_ARR2;
                  --
                begin
                  --
                  --transforma o string do shutle em tabela
                  --
                  vfiliais    := APEX_UTIL.STRING_TO_TABLE(:P51_IDFILIALROMANCE);
                  vfiliaisfav := APEX_UTIL.STRING_TO_TABLE(:P51_IDFILIALFAVORITA);  
                  --
                  --
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') in ('ATUALIZAR', 'ATUALIZARTODAS') then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') in ('EXCLUIR', 'EXCLUIRTODAS') then
                    voperacao_dml := 'D';
                  end if;
                  --
                  vvalorvenda                := to_number(:P51_VALORVENDA                ,'999G999G999G999G999G990D00'); 
                  vvalororiginal             := to_number(:P51_VALORORIGINAL             ,'999G999G999G999G999G990D00');
                  vvalorcomissaoatendente    := to_number(:P51_VALORCOMISSAOATENDENTE    ,'999G999G999G999G999G990D00'); 
                  --
                  open c1;
                  loop
                    fetch c1 into r1;
                    exit when c1%notfound;
                    --
                    if v('REQUEST') in ('INSERIR', 'ATUALIZARTODAS') then
                      --
                      for rfil in 1.. vfiliais.count 
                      loop
                        #OWNER#.PCK_COMERCIAL_FAV.PRC_PROMOCOESDIVULGACOES (
                          PIDPROMOCAODIVULGACAO => vidpromocaodivulgacao,
                          PIDPRODUTODETALHADO => r1.idprodutodetalhado,
                          PNOME => :P51_NOME,
                          PDATAINICIAL => :P51_DATAINICIAL,
                          PDATAFINAL => :P51_DATAFINAL,
                          PIDFILIALROMANCE => vfiliais(rfil),
                          PVALORVENDA => vvalorvenda,
                          PPERCCOMISSAOGERENTE => :P51_PERCCOMISSAOGERENTE,
                          PPERCCOMISSAODISTRIBUIDOR => :P51_PERCCOMISSAODISTRIBUIDOR,
                          PPERCCOMISSAOCONSULTORA => :P51_PERCCOMISSAOCONSULTORA,
                          PVALORCOMISSAOATENDENTE => vvalorcomissaoatendente,
                          PMD5 => :P51_MD5,
                          POPERACAO_DML => voperacao_dml,
                          PVALORORIGINAL => vvalororiginal,
                          PIDFILIALFAVORITA => :P51_IDFILIALFAVORITA );
                        --
                      end loop;
                      --
                      for rfilfav in 1.. vfiliaisfav.count
                      loop
                        #OWNER#.PCK_COMERCIAL_FAV.PRC_PROMOCOESDIVULGACOES (
                          PIDPROMOCAODIVULGACAO => vidpromocaodivulgacao,
                          PIDPRODUTODETALHADO => r1.idprodutodetalhado,
                          PNOME => :P51_NOME,
                          PDATAINICIAL => :P51_DATAINICIAL,
                          PDATAFINAL => :P51_DATAFINAL,
                          PIDFILIALROMANCE => :P51_IDFILIALROMANCE,
                          PVALORVENDA => vvalorvenda,
                          PPERCCOMISSAOGERENTE => :P51_PERCCOMISSAOGERENTE,
                          PPERCCOMISSAODISTRIBUIDOR => :P51_PERCCOMISSAODISTRIBUIDOR,
                          PPERCCOMISSAOCONSULTORA => :P51_PERCCOMISSAOCONSULTORA,
                          PVALORCOMISSAOATENDENTE => vvalorcomissaoatendente,
                          PMD5 => :P51_MD5,
                          POPERACAO_DML => voperacao_dml,
                          PVALORORIGINAL => vvalororiginal,
                          PIDFILIALFAVORITA => vfiliaisfav(rfilfav) );
                        --
                      end loop;
                      --
                    elsif v('REQUEST') in ('EXCLUIR', 'EXCLUIRTODAS', 'ATUALIZAR') then
                    --
                      vfiliais    := APEX_UTIL.STRING_TO_TABLE(:P51_IDFILIALROMANCE_ATUALIZAR);
                      vfiliaisfav := APEX_UTIL.STRING_TO_TABLE(:P51_IDFILIALFAVORITA_ATUALIZAR);
                      --
                      for rfil in 1.. vfiliais.count 
                      loop
                        #OWNER#.PCK_COMERCIAL_FAV.PRC_PROMOCOESDIVULGACOES (
                          PIDPROMOCAODIVULGACAO => :P51_IDPROMOCAODIVULGACAO,
                          PIDPRODUTODETALHADO => r1.idprodutodetalhado,
                          PNOME => :P51_NOME,
                          PDATAINICIAL => :P51_DATAINICIAL,
                          PDATAFINAL => :P51_DATAFINAL,
                          PIDFILIALROMANCE => vfiliais(rfil),
                          PVALORVENDA => vvalorvenda,
                          PPERCCOMISSAOGERENTE => :P51_PERCCOMISSAOGERENTE,
                          PPERCCOMISSAODISTRIBUIDOR => :P51_PERCCOMISSAODISTRIBUIDOR,
                          PPERCCOMISSAOCONSULTORA => :P51_PERCCOMISSAOCONSULTORA,
                          PVALORCOMISSAOATENDENTE => vvalorcomissaoatendente,
                          PMD5 => :P51_MD5,
                          POPERACAO_DML => voperacao_dml,
                          PVALORORIGINAL => vvalororiginal,
                          PIDFILIALFAVORITA => :P51_IDFILIALFAVORITA );
                        --
                      end loop;
                      --
                      for rfilfav in 1.. vfiliaisfav.count
                      loop
                        #OWNER#.PCK_COMERCIAL_FAV.PRC_PROMOCOESDIVULGACOES (
                          PIDPROMOCAODIVULGACAO => :P51_IDPROMOCAODIVULGACAO,
                          PIDPRODUTODETALHADO => r1.idprodutodetalhado,
                          PNOME => :P51_NOME,
                          PDATAINICIAL => :P51_DATAINICIAL,
                          PDATAFINAL => :P51_DATAFINAL,
                          PIDFILIALROMANCE => :P51_IDFILIALROMANCE,
                          PVALORVENDA => vvalorvenda,
                          PPERCCOMISSAOGERENTE => :P51_PERCCOMISSAOGERENTE,
                          PPERCCOMISSAODISTRIBUIDOR => :P51_PERCCOMISSAODISTRIBUIDOR,
                          PPERCCOMISSAOCONSULTORA => :P51_PERCCOMISSAOCONSULTORA,
                          PVALORCOMISSAOATENDENTE => vvalorcomissaoatendente,
                          PMD5 => :P51_MD5,
                          POPERACAO_DML => voperacao_dml,
                          PVALORORIGINAL => vvalororiginal,
                          PIDFILIALFAVORITA => vfiliaisfav(rfilfav) );
                        --
                      end loop;
                    --
                    end if;
                    --
                  end loop;
                  close c1;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 3172420236895992
        }
    )

