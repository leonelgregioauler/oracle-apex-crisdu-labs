    dynamicAction calcula-valor-comissão-atendente (
        name: Calcula valor Comissão Atendente
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P51_PERCCOMISSAOATENDENTE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    :P51_VALORCOMISSAOATENDENTE := to_char( ( to_number(:P51_VALORVENDA,            '999G999G999G990D00') *
                                                            ( to_number(:P51_PERCCOMISSAOATENDENTE, '999G999G999G990D00') / 100) ) , '999G999G999G990D00' );
                    ```
                itemsToSubmit: [
                    P51_PERCCOMISSAOATENDENTE
                    P51_VALORVENDA
                ]
                itemsToReturn: P51_VALORCOMISSAOATENDENTE
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction desabilita-filial-romance-e-favorita (
        name: Desabilita Filial Romance e Favorita
        execution {
            sequence: 20
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: item=value
            item: P51_ORIGEM
            value: 50
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: items
                items: P51_IDFILIALROMANCE
            }
            execution {
                sequence: 10
            }
        )

        action native-disable-2 (
            action: disable
            affectedElements {
                selectionType: items
                items: [
                    P51_IDFILIALROMANCE
                    P51_IDFILIALFAVORITA
                ]
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction habilita-filial-favorita-desabilita-filial-romance (
        name: Habilita Filial Favorita / Desabilita Filial Romance
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: items
            items: P51_IDFILIALFAVORITA
        }
        clientSideCondition {
            type: item=value
            item: P51_ORIGEM
            value: 0
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: items
                items: P51_IDFILIALROMANCE
            }
            execution {
                sequence: 10
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: items
                items: P51_IDFILIALFAVORITA
            }
            execution {
                sequence: 20
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: :P51_IDFILIALROMANCE := null;
                itemsToSubmit: P51_IDFILIALROMANCE
                itemsToReturn: P51_IDFILIALROMANCE
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction habilita-filial-romance-desabilita-filial-favorita (
        name: Habilita Filial Romance / Desabilita Filial Favorita
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: items
            items: P51_IDFILIALROMANCE
        }
        clientSideCondition {
            type: item=value
            item: P51_ORIGEM
            value: 0
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: items
                items: P51_IDFILIALFAVORITA
            }
            execution {
                sequence: 10
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: items
                items: P51_IDFILIALROMANCE
            }
            execution {
                sequence: 20
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: :P51_IDFILIALFAVORITA := null;
                itemsToSubmit: P51_IDFILIALFAVORITA
                itemsToReturn: P51_IDFILIALFAVORITA
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    validation data-final-obrigatório (
        name: DATA FINAL obrigatório
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P51_DATAFINAL
        }
        error {
            errorMessage: Data final deve ter uma data válida.
            associatedItem: @P51_DATAFINAL
        }
    )

    validation data-final-válida (
        name: DATA FINAL válida
        execution {
            sequence: 50
        }
        validation {
            type: itemIsAValidDate
            item: P51_DATAFINAL
        }
        error {
            errorMessage: Data final deve ter uma data válida.
            associatedItem: @P51_DATAFINAL
        }
    )

    validation data-inicial-obrigatório (
        name: DATA INICIAL obrigatório
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P51_DATAINICIAL
        }
        error {
            errorMessage: Data inicial deve ter uma data válida.
            associatedItem: @P51_DATAINICIAL
        }
    )

    validation data-inicial-válida (
        name: DATA INICIAL válida
        execution {
            sequence: 40
        }
        validation {
            type: itemIsAValidDate
            item: P51_DATAINICIAL
        }
        error {
            errorMessage: Data inicial deve ter uma data válida.
            associatedItem: @P51_DATAINICIAL
        }
    )

    validation idfilialromance-ou-idfilialfavorita-obrigatório (
        name: IDFILIALROMANCE ou IDFILIALFAVORITA obrigatório
        execution {
            sequence: 150
        }
        validation {
            language: sql
            sqlExpression: :P51_IDFILIALROMANCE is not null or :P51_IDFILIALFAVORITA is not null
        }
        error {
            errorMessage: Filial Romance ou Filial Favorita deve ser informada.
            associatedItem: @P51_IDFILIALROMANCE
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('INSERIR','ATUALIZARTODAS');
                ```
        }
    )

    validation nome-obrigatório (
        name: NOME obrigatório
        execution {
            sequence: 70
        }
        validation {
            type: itemIsNotNull
            item: P51_NOME
