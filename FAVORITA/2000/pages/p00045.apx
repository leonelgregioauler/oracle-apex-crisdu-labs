page 45 (
    name: Cadastro Produtos Prateleiras Estoque
    title: Produtos Prateleiras Estoque - (45)
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region produtos-prateleiras-estoque (
        name: Produtos Prateleiras Estoque
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P45_IDCORREDORESTOQUE (
        type: selectList
        label {
            label: Corredor Estoque
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-corredoresestoquesfilial
            nullDisplayValue: " - Selecione o Corredor Estoque - "
        }
        layout {
            sequence: 10
            region: @produtos-prateleiras-estoque
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P45_IDPRATELEIRAESTOQUE (
        type: selectList
        label {
            label: Prateleira Estoque
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select descricao as d,
                       idprateleiraestoque as r
                  from prateleirasestoques
                where idcorredorestoque = :P45_IDCORREDORESTOQUE
                ```
            nullDisplayValue: " - Selecione a Prateleira - "
        }
        cascadingLov {
            parentItems: P45_IDCORREDORESTOQUE
        }
        layout {
            sequence: 30
            region: @produtos-prateleiras-estoque
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P45_IDPRODUTODETALHADO (
        type: plugin/select
        label {
            label: Produto Detalhado
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-produtosdetalhados
            nullDisplayValue: " - Selecione o Produto Detalhado - "
        }
        layout {
            sequence: 40
            region: @produtos-prateleiras-estoque
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P45_IDPRODUTOPRATELEIRA (
        type: hidden
        layout {
            sequence: 20
            region: @produtos-prateleiras-estoque
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P45_MD5 (
        type: hidden
        layout {
            sequence: 50
            region: @produtos-prateleiras-estoque
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P45_OPERACAO_DML (
        type: hidden
        layout {
            sequence: 60
            region: @produtos-prateleiras-estoque
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar por Produto
        layout {
            sequence: 70
            region: @produtos-prateleiras-estoque
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P45_IDPRODUTOPRATELEIRA
        }
    )

    button atualizar-referencia (
        buttonName: ATUALIZAR_REFERENCIA
        label: Atualizar por Referência
        layout {
            sequence: 80
            region: @produtos-prateleiras-estoque
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P45_IDPRODUTOPRATELEIRA
        }
        comments {
            comments:
                ```
                Maicon Aimi - 23/04/2024
                
                Botão criado para atender o ticket 8659633
                ```
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 60
            region: @produtos-prateleiras-estoque
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P45_IDPRODUTOPRATELEIRA
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 50
            region: @produtos-prateleiras-estoque
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 44
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 30
            region: @produtos-prateleiras-estoque
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P45_IDPRODUTOPRATELEIRA
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 20
            region: @produtos-prateleiras-estoque
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P45_IDPRODUTOPRATELEIRA
        }
    )

    dynamicAction confirmar-alteração-por-referencia (
        name: Confirmar Alteração por Referencia
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @atualizar-referencia
        }

        action native-confirm (
            action: confirm
            settings {
                message: Confirmar a alteração de todas as referências vinculadas ao produto selecionado.
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: ATUALIZAR_REFERENCIA
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    validation corredorestoque-obrigatório (
        name: CORREDORESTOQUE obrigatório
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P45_IDCORREDORESTOQUE
        }
        error {
            errorMessage: Corredor Estoque deve ter um valor.
            associatedItem: @P45_IDCORREDORESTOQUE
        }
    )

    validation prateleiraestoque-obrigatório (
        name: PRATELEIRAESTOQUE obrigatório
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P45_IDPRATELEIRAESTOQUE
        }
        error {
            errorMessage: Prateleira Estoque deve ser informado.
            associatedItem: @P45_IDPRATELEIRAESTOQUE
        }
    )

    validation produtodetalhado-obrigatório (
        name: PRODUTODETALHADO obrigatório
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P45_IDPRODUTODETALHADO
        }
        error {
            errorMessage: Produto Detalhado deve ser informado.
            associatedItem: @P45_IDPRODUTODETALHADO
        }
    )

    process atualizar-por-referencia (
        name: Atualizar Por Referencia
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                /*
                
                    Maicon Aimi - 23/04/2024
                    Criado para atender o ticket 8659633
                
                */
                
                declare
                    
                    -- declaração das variáveis da rotina
                    vIDProduto number;
                    
                begin
                    
                    -- pega o id PRODUTO DETALHADO e busca o id do PRODUTO
                    begin 
                        select idproduto
                          into vIDProduto
                          from favorita.produtosdetalhados
                         where idprodutodetalhado = :P45_IDPRODUTODETALHADO;
                    exception
                        when others then
                            vIDProduto := null;
                    end;
                
                    -- aqui atualiza todos os registros da tabela PRODUTOSPRATELEIRASEST
                    -- com base na referencia que o usuário selecionaou em tela, usuário enxerga referencia exp:'99.140.0188',  mas pra nós importa o IDPRODUTODETALHADO.
                    for i in (  select pp.idprodutodetalhado, idprodutoprateleira
                                  from produtosprateleirasest pp
                                 where pp.idprodutodetalhado in (select pd.idprodutodetalhado
                                                                   from favorita.produtosdetalhados pd
                                                                  where pd.idproduto = vIDProduto)) loop
                        
                        -- atualiza a prateleira da tabela prateleira estoque
                        update produtosprateleirasest
                           set idprateleiraestoque = :P45_IDPRATELEIRAESTOQUE
                        where idprodutoprateleira = i.idprodutoprateleira;
                       
                    end loop;
                    
                    -- efetiva a alteração
                    commit;
                    
                end;
                
                
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 3073155114775451633
        }
        serverSideCondition {
            whenButtonPressed: @atualizar-referencia
        }
    )

    process consulta-produtos-prateleiras-estoque (
        name: Consulta Produtos Prateleiras Estoque
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                #OWNER#.PCK_CADASTROS_FAV.PRC_PRODUTOSPRATELEIRASEST (
                  PIDPRODUTOPRATELEIRA => :P45_IDPRODUTOPRATELEIRA,
                  PIDPRATELEIRAESTOQUE => :P45_IDPRATELEIRAESTOQUE,
                  PIDPRODUTODETALHADO => :P45_IDPRODUTODETALHADO,
                  PMD5 => :P45_MD5,
                  POPERACAO_DML => 'S');
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 331531098685734138
        }
    )

    process limpar-campos-ao-sair (
        name: Limpar Campos ao Sair
        type: clearSessionState
        execution {
            sequence: 10
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 331531966560734147
        }
    )

    process limpar-campos-para-adicionar (
        name: Limpar Campos para Adicionar
        type: clearSessionState
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 331532003049734148
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    process operação-dml-em-produtos-prateleiras-estoque (
        name: Operação DML em Produtos Prateleiras Estoque
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  #OWNER#.PCK_CADASTROS_FAV.PRC_PRODUTOSPRATELEIRASEST (
                    PIDPRODUTOPRATELEIRA => :P45_IDPRODUTOPRATELEIRA,
                    PIDPRATELEIRAESTOQUE => :P45_IDPRATELEIRAESTOQUE,
                    PIDPRODUTODETALHADO => :P45_IDPRODUTODETALHADO,
                    PMD5 => :P45_MD5,
                    POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 3065491821957384
        }
    )

    branch (
        name: Go To Page 45
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 45
                items: {
                    P45_IDPRODUTOPRATELEIRA:
                    P45_IDCORREDORESTOQUE: &P45_IDCORREDORESTOQUE.
                }
            }
        }
    )

)

