page 186 (
    name: Pagamentos/Depósitos Confirmados
    title: Pagamentos/Depósitos Confirmados
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pagamentos-depósitos-confirmados (
        name: Pagamentos/Depósitos Confirmados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select vw.numeropedido "Nr Pedido"
                     , vw.vendedora "Cliente"
                     , vw.representante "Distribuidor"
                     , vw.filialromance "Filial"
                     , vw.nrcomprovante "Comprovante"
                     , vw.datacomprovante "Data Comprovante"
                     , vw.horario "Horário"
                     , vw.nrenvelope "Nr Envelope"
                     , vw.agenciaacolhida "Agência Acolhida"
                     , vw.agencia "Agência"
                     , vw.conta "Conta"
                     , vw.valor "Valor Depositado"
                     , vw.local "Estabelecimento"
                     , vw.observacao "Observação"
                from vw_pagamentosfavorita_fav vw
                where ( :P186_DATAINI is null or vw.datacomprovante between to_date(:P186_DATAINICIO,'DD/MM/RRRR') and to_date(:P186_DATAFIM,'DD/MM/RRRR') )
                  and ( :P186_NRCOMPROVANTE is null or vw.nrcomprovante = :P186_NRCOMPROVANTE )
                  and ( :P186_NRENVELOPE is null or vw.nrenvelope = :P186_NRENVELOPE )
                  and ( :P186_VALOR is null or vw.valor like '%'||:P186_VALOR||'%' )
                  and ( :P186_CONTA is null or vw.conta like '%'||:P186_CONTA||'%' )
                  and ( :P186_IDFILIAL is null or vw.idfilialromance = :P186_IDFILIAL )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum Pagamento/Depósito confirmado!
        }
        advanced {
            savedReportMappingIdentifier: 201971943635022142
        }

