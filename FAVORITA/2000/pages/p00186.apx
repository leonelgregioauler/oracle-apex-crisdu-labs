    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 186
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 186
                items: {
                    P186_DATAINICIO: &P186_DATAINICIO.
                    P186_DATAFIM: &P186_DATAFIM.
                    P186_NRCOMPROVANTE: &P186_NRCOMPROVANTE.
                    P186_IDFILIAL: &P186_IDFILIAL.
                    P186_NRENVELOPE: &P186_NRENVELOPE.
                    P186_CONTA: &P186_CONTA.
                    P186_VALOR: &P186_VALOR.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

