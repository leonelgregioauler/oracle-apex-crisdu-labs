    dynamicAction verifica-grupo-de-atendimento-do-usuário (
        name: Verifica Grupo de Atendimento do Usuário
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      --
                      cursor c1 is
                        select distinct g.idgrupoatendimento
                        from roman.gruposatendimento g
                        where exists ( select 1 
                                       from perfispagamentos p
                                       where p.idgrupoatendimento = g.idgrupoatendimento );
                      --
                      r1 c1%rowtype;
                      --
                    begin
                      --
                      open c1;
                      loop
                        fetch c1 into r1;
                        exit when c1%notfound;
                        --
                        if pck_util_fav.fnc_verificagrupoatendimento (r1.idgrupoatendimento, :P0_IDUSUARIO) = 'S' then
                         :P322_IDGRUPOATENDIMENTO := r1.idgrupoatendimento;
                        end if;
                        --
                      end loop;
                      close c1;
                      --
                    end;
                      
                    ```
                itemsToSubmit: P322_IDGRUPOATENDIMENTO
                itemsToReturn: P322_IDGRUPOATENDIMENTO
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

