    dynamicAction consulta-origem-forma-pagamento-e-situação (
        name: Consulta Origem, Forma Pagamento e Situação
        execution {
            sequence: 150
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      vorigempagamento  varchar2(1);
                      vidformapagamento number;
                      vidsituacao       number;
                    begin
                      --Retorna a origem, forma de pagamento e situação do pagamento que está sendo consultado / editado (junto com a funtion no default value de cada campo )
                      select pp.origempagamento
                           , pp.idformapagamento
                           , pp.idsituacao
                      into vorigempagamento
                         , vidformapagamento
                         , vidsituacao
                      from pagamentospedidos pp
                      where pp.idpagamentopedido = :P322_IDPAGAMENTOPEDIDO;
                      --
                      :P322_ORIGEMPAGAMENTO  := vorigempagamento;
                      :P322_IDFORMAPAGAMENTO := vidformapagamento;
                      :P322_IDSITUACAO       := vidsituacao;
                      --
                    end;
                       
                      
                    ```
                itemsToSubmit: P322_IDPAGAMENTOPEDIDO
                itemsToReturn: [
                    P322_ORIGEMPAGAMENTO
                    P322_IDFORMAPAGAMENTO
                    P322_IDSITUACAO
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

