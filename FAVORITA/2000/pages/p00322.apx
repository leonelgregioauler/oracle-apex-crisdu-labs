    pageItem P322_ORIGEMPAGAMENTO (
        type: radioGroup
        label {
            label: Origem Pagamento
            alignment: left
        }
        settings {
            noOfCols: 5
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct 
                       pp.origempagamentodescricao as d
                     , pp.origempagamento as r
                from pagamentospedidos p
                   , vw_perfispagamentos_fav pp
                where p.origempagamento  = pp.origempagamento
                  and p.idformapagamento = pp.idformapagamento
                  and p.idsituacao       = pp.idsituacaopagamentoped
                  and pck_util_fav.fnc_verificaacesso(28610,:P0_IDUSUARIO) = 'S'
                union
                select distinct 
                       pp.origempagamentodescricao as d
                     , pp.origempagamento as r
                from pagamentospedidos p
                   , vw_perfispagamentos_fav pp
                where p.origempagamento  = pp.origempagamento
                  and p.idformapagamento = pp.idformapagamento
                  and p.idsituacao       = pp.idsituacaopagamentoped
                  and pp.idgrupoatendimento  = :P322_IDGRUPOATENDIMENTO
                union
                select distinct 
                       pp.origempagamentodescricao as d
                     , pp.origempagamento as r
                from pagamentospedidos p
                   , vw_perfispagamentos_fav pp
                where p.origempagamento  = pp.origempagamento
                  and p.idformapagamento = pp.idformapagamento
                  and p.idsituacao       = pp.idsituacaopagamentoped
                  and p.idpagamentopedido    = :P322_IDPAGAMENTOPEDIDO 
                union
                select distinct 
                       case
                	     when p.origempagamento = 'B' then 'Banco'
                	     when p.origempagamento = 'L' then 'Loja'
                	     when p.origempagamento = 'M' then 'Em Mãos'
                	     when p.origempagamento = 'C' then 'Cobranca'
                	     when p.origempagamento = 'V' then 'Call Center Vendas' 
                         when p.origempagamento = 'S' then 'Site'
                         when p.origempagamento = 'G' then 'Giro de Pago'
                         when p.origempagamento = 'P' then 'Preventiva'
                         when p.origempagamento = 'D' then 'Debitos Romance'
                       end origempagamentodescricao 
                     , p.origempagamento as r
                from  pagamentospedidos p
                where p.idpagamentopedido = :P322_IDPAGAMENTOPEDIDO
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P322_IDGRUPOATENDIMENTO
            itemsToSubmit: P322_IDGRUPOATENDIMENTO
        }
        layout {
            sequence: 50
            region: @informar-pagamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vorigempagamento varchar2(2);
                begin
                  --Retorna a origem do pagamento que está sendo consultado / editado (junto com a ação dinâmica no page load )
                  if :P322_IDPAGAMENTOPEDIDO is not null then
                    select origempagamento
                    into vorigempagamento
                    from pagamentospedidos
                    where idpagamentopedido = :P322_IDPAGAMENTOPEDIDO;
                  end if;
                  --
                  return vorigempagamento;
                  --
                end;
                ```
        }
        readOnly {
            type: itemIsNotNull
            item: P322_IDPAGAMENTOPEDIDO
        }
        security {
            encryptSessionState: false
        }
    )

