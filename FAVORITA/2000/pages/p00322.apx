    process consulta-em-pagamentos-pedidos (
        name: Consulta em Pagamentos Pedidos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vvalorpago              number(15,2);
                  vjuros                  number(15,2);
                  vacrescimo              number(15,2);
                  vdesconto               number(15,2);
                  vvalorliquido           number(15,2);
                  vidusuarionegociacao    number := null;
                  --
                  vidpedido               number;
                  --
                  vsaldo                  number(15,2);
                  --
                begin
                  --
                  if (:P322_PAGINAORIGEM in (187, 541, 320, 325) and :P322_IDPAGAMENTOPEDIDO is not null ) then
                    --
                    pck_pedidos_fav.prc_pagamentospedidos( pidpagamentopedido           => :P322_IDPAGAMENTOPEDIDO
                                                         , pidvencimentopedido          => :P322_IDVENCIMENTOPEDIDO
                                                         , pidformapagamento            => :P322_IDFORMAPAGAMENTO
                                                         , pdatapagamento               => :P322_DATAPAGAMENTO
                                                         , pvalorpago                   => vvalorpago
                                                         , porigempagamento             => :P322_ORIGEMPAGAMENTO
                                                         , pnumeroboleto                => :P322_NUMEROBOLETO
                                                         , pidsituacao                  => :P322_IDSITUACAO
                                                         , ptaxa                        => :P322_TAXA
                                                         , pjuros                       => vjuros
                                                         , pacrescimo                   => vacrescimo
                                                         , pdesconto                    => vdesconto
                									     , pvalorliquido                => vvalorliquido
                                                         , pnumerocomprovante           => :P322_NUMEROCOMPROVANTE
                                                         , pidcontabancaria             => :P322_IDCONTABANCARIA
                                                         , pobservacao                  => :P322_OBSERVACAO
                                                         , pidusuariopagamento          => :P322_IDUSUARIOPAGAMENTO
                                                         , pidusuarionegociacao         => vidusuarionegociacao
                                                         , penviooperadora              => :P322_ENVIOOPERADORA
                                                         , pretornooperadora            => :P322_RETORNOOPERADORA
                                                         , poperacao_dml                => 'S'
                                                         , pmd5                         => :P322_MD5 );
                    --
                    :P322_VALORPAGO      := to_char(vvalorpago    ,'999G999G999G990D00');
                    :P322_JUROS          := to_char(vjuros        ,'999G999G999G990D00');
                    :P322_ACRESCIMO      := to_char(vacrescimo    ,'999G999G999G990D00');
                    :P322_DESCONTO       := to_char(vdesconto     ,'999G999G999G990D00');
                    :P322_VALORLIQUIDO   := to_char(vvalorliquido ,'999G999G999G990D00');
                    --
                    select idpedido
                    into vidpedido
                    from vencimentospedidos
                    where idvencimentopedido = :P322_IDVENCIMENTOPEDIDO;
                    --
                    :P322_IDPEDIDO := vidpedido;
                    --
                  end if;
                  --
                  -- ao editar um pagamento após incluir ou após incluir anexo e retornar para a página 
                  if (:P322_PAGINAORIGEM in (187,541) and :P322_IDPAGAMENTOPEDIDO is not null) then
                    --
                    select p.valorpago
                    into vvalorpago
                    from pagamentospedidos p
                       , vencimentospedidos v
                    where p.idvencimentopedido = v.idvencimentopedido
                    and p.idpagamentopedido = :P322_IDPAGAMENTOPEDIDO;
                    --
                    :P322_VALORPAGO := to_char(vvalorpago, '999G999G999G990D00');
                    --
                  end if;
                  --
                  select justificativadescontoacrescimo
                  into :P322_JUSTIFICATIVADESCACRESC
                  from pagamentospedidos
                  where idpagamentopedido = :P322_IDPAGAMENTOPEDIDO;
                  --
                end;                                        
                
                										
                										                                        
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 1411597259700853747
        }
    )

