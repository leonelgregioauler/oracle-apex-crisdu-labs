page 322 (
    name: Editar Pagamento
    title: Editar Pagamento
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 90%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region informar-pagamento (
        name: Informar Pagamento
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P322_ACRESCIMO (
        type: textField
        label {
            label: Acrescimo
            alignment: left
        }
        layout {
            sequence: 200
            region: @informar-pagamento
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            cssClasses: alterarvalor
            width: 15
        }
        advanced {
            customAttributes: onkeyup="formataMoeda(this);" style="text-align:right"
        }
        default {
            type: static
            staticValue: 0,00
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P322_DATAPAGAMENTO (
        type: datePicker
        label {
            label: Datapagamento
            alignment: left
        }
        layout {
            sequence: 100
            region: @informar-pagamento
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr
            width: 10
        }
        readOnly {
            type: expression
            language: sql
            sqlExpression: pck_util_fav.fnc_verificaacesso(28610,:P0_IDUSUARIO) = 'N'
        }
    )

    pageItem P322_DATAPAGAMENTO2 (
        type: datePickerJquery
        label {
            label: Data Pagamento
            alignment: left
        }
        layout {
            sequence: 90
            region: @informar-pagamento
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr
            width: 10
        }
        serverSideCondition {
            type: never
        }
        readOnly {
            type: expression
            language: sql
            sqlExpression: pck_util_fav.fnc_verificaacesso(28610,:P0_IDUSUARIO) = 'N'
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P322_DATAVENCIMENTO (
        type: datePickerJquery
        label {
            label: Data Vencimento
            alignment: left
        }
        layout {
            sequence: 80
            region: @informar-pagamento
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr
            width: 10
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select datavencimento
                from vencimentospedidos
                where idvencimentopedido = :P322_IDVENCIMENTOPEDIDO
                ```
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

