    dynamicAction calcula-juros (
        name: Calcula Juros
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P322_DATAPAGAMENTO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      vdatavencimento date;
                      vdatapagamento  date;
                      vvalorpagar     number(15,2); 
                      vvalorpago      number(15,2);
                      vsaldo          number(15,2);
                      --
                    begin
                      --
                      select vp.datavencimento
                           , vp.valorpagar
                           , vp.valorpago
                      into vdatavencimento
                         , vvalorpagar
                         , vvalorpago
                      from vencimentospedidos vp
                      where vp.idvencimentopedido = :P322_IDVENCIMENTOPEDIDO
                      and vp.situacaovencimento = 'V';
                      --
                      vdatapagamento := :P322_DATAPAGAMENTO;
                      --
                      --if vdatavencimento < nvl(:P322_DATAPAGAMENTO, trunc(sysdate)) then (corrigir problema juros negativo)
                      if vdatavencimento < :P322_DATAPAGAMENTO then
                        --
                        if (vvalorpagar - vvalorpago) > 0 then 
                          vsaldo := vvalorpagar - vvalorpago;
                        elsif :P322_IDPAGAMENTOPEDIDO is not null and (vvalorpagar - vvalorpago = 0) then
                          vsaldo := vvalorpagar;
                        end if;
                        --
                        :P322_VALORLIQUIDO := to_char(pck_util_fav.fnc_calculajuros( pidpedido           => :P322_IDPEDIDO,
                                                                                     pvalororiginal      => vsaldo,
                                                                                     pdatavencimentoorig => vdatavencimento,
                                                                                     pdatavencimentonovo => vdatapagamento,
                                                                                     ppercmulta          => 2,
                                                                                     ppercjuros          => 1), '999G999G999G990D00');                                                              
                        --
                        -- Incluir pagamento
                        if :P322_IDPAGAMENTOPEDIDO is null then          
                          :P322_JUROS := to_char(to_number(nvl(:P322_VALORLIQUIDO, 0), '999G999G999G990D00') - to_number(nvl(:P322_SALDODEVEDOR, 0), '999G999G999G990D00'), '999G999G999G990D00');
                        -- Editar pagamento
                        elsif :P322_IDPAGAMENTOPEDIDO is not null then
                          :P322_JUROS := to_char(to_number(nvl(:P322_VALORLIQUIDO, 0), '999G999G999G990D00') - to_number(nvl(vsaldo, 0), '999G999G999G990D00'), '999G999G999G990D00');
                        end if;
                        --
                        :P322_VALORLIQUIDO := to_char(to_number(nvl(:P322_VALORPAGO, 0), '999G999G999G990D00') + to_number(nvl(:P322_JUROS, 0), '999G999G999G990D00'), '999G999G999G990D00');
                        --
                      else
                        -- Incluir pagamento
                        if :P322_IDPAGAMENTOPEDIDO is null then
                          :P322_VALORLIQUIDO := :P322_SALDODEVEDOR;
                        -- Editar pagamento
                        elsif :P322_IDPAGAMENTOPEDIDO is not null then
                          :P322_VALORLIQUIDO := :P322_VALORPAGO;
                        end if;
                        --
                        :P322_JUROS    := to_char(0, '999G999G999G990D00');
                        --
                      end if;
                      --
                    end;
                            
                    ```
                itemsToSubmit: [
                    P322_IDVENCIMENTOPEDIDO
                    P322_DATAPAGAMENTO2
                    P322_IDPEDIDO
                    P322_IDPAGAMENTOPEDIDO
                    P322_SALDODEVEDOR
                    P322_VALORPAGO
                    P322_JUROS
                    P322_VALORLIQUIDO
                ]
                itemsToReturn: [
                    P322_VALORLIQUIDO
                    P322_JUROS
                ]
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction calcular-valor-lí-quido-acréscimo (
        name: Calcular Valor Lí­quido (Acréscimo)
        execution {
