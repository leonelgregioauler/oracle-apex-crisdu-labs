    validation valida-se-já-existe-negociação-da-cobrança (
        name: Valida se já existe Negociação da Cobrança
        execution {
            sequence: 100
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where ( exists ( select 1
                                 from parcelamentospedidos p
                                 where p.idpedido = ( select idpedido
                                                      from vencimentospedidos v
                                                      where v.idvencimentopedido = :P322_IDVENCIMENTOPEDIDO ) )
                     or exists ( select 1
                                 from pedidos ped
                                 where ped.idpedido = :P322_IDPEDIDO
                                   and ped.idnegociadoraresponsavel is not null )
                     or exists ( select 1
                                 from classificacoespedidos c
                                 where c.idcaracteristicapedido = 44
                                   and c.idpedido = ( select idpedido
                                                      from vencimentospedidos v
                                                      where v.idvencimentopedido = :P322_IDVENCIMENTOPEDIDO ) ) )
                   and (exists ( select 1
                                 from roman.usuariosgruposatendimento u
                                 where u.usuario = ( select usuario
                                                     from usuarios uu
                                                     where uu.idusuario = :P0_IDUSUARIO ) 
                                   and u.idgrupoatendimento != 3 ) 
                      or not exists ( select 1
                                      from roman.usuariosgruposatendimento u
                                      where u.usuario = ( select usuario
                                                          from usuarios uu
                                                          where uu.idusuario = :P0_IDUSUARIO ) ) )
                ```
        }
        error {
            errorMessage: Não é possível incluir um pagamento, pois já existe uma negociação com o setor de cobrança. Favor entrar em contato com o setor de Cobrança.
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where v('REQUEST') in ('INSERIR')
                ```
        }
    )

    validation valida-valor-pago-ao-inserir-atualizar (
        name: Valida valor pago ao inserir / atualizar
        execution {
            sequence: 120
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vsaldo              number(15,2);
                  vjuros              number(15,2);
                  vdatavencimento     date;
                  vvalorpagar         number(15,2);
                  vidpedido           number;
                  --
                  vvalorpago          number(15,2);
                  vvalorpagob         number(15,2);
                  --
                begin
                  --
                  -- Se estiver inserindo ou atualizando
                  if v('REQUEST') in ('INSERIR') or (:P322_IDFORMAPAGAMENTO in (1,2) ) then
                    --
                    --INSERIR
                    select saldo
                         , datavencimento 
                         , valorpagar
                         , idpedido
                    into vsaldo
                       , vdatavencimento
                       , vvalorpagar
                       , vidpedido
                    from vw_vencimentospedidos_fav
                    where idvencimentopedido = :P322_IDVENCIMENTOPEDIDO;
                    --
                    select p.valorpago
                    into vvalorpagob
                    from favorita.pagamentospedidos p
                    where p.idpagamentopedido = :P322_IDPAGAMENTOPEDIDO;
                    --
                    if vdatavencimento < trunc(sysdate) and  :P322_IDSITUACAO != 20 then
                      --
                      vjuros := ( pck_util_fav.fnc_calculajuros(pidpedido => vidpedido,
                                                                pvalororiginal => vvalorpagar,
                                                                pdatavencimentoorig => vdatavencimento,
                                                                pdatavencimentonovo => sysdate,
                                                                ppercmulta => 2,
                                                                ppercjuros => 1) - vvalorpagar );
                      --
                    else
                      vjuros := 0;
                    end if;
                    --
                    if (replace(:P322_VALORPAGO, '.', '')) != vvalorpagob then 
                        --
                        if (replace(:P322_VALORPAGO, '.', '')) > vsaldo+vjuros then
                          return 'O saldo de pagamento é R$ '||to_char(vsaldo+vjuros, '999G999G999G990D00')||'. Informe um valor menor.';
                        end if;
                        --
                    end if;
                    --
                  -- Se estiver atualizando a partir de um pagamento já incluído (PÁGINA DE PAGAMENTOS)
                  elsif v('REQUEST') in ('ATUALIZAR') then
                    --
                    -- ATUALIZAR
                    select valorpago
                    into vvalorpago
                    from pagamentospedidos
                    where idpagamentopedido = :P322_IDPAGAMENTOPEDIDO;
                    --
                    if (replace(:P322_VALORPAGO, '.', '')) > vvalorpago then
                      return 'Valor pago maior que devido. O valor devido é R$ '||to_char(vvalorpago, '999G999G999G990D00')||'. Informe um valor menor ou igual.';
                    end if;
                    --
                  end if;
                  --
                end;
                ```
        }
    )

