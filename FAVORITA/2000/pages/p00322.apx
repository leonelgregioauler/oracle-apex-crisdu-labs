                ```sql
                select 1
                from dual
                where v('REQUEST') in ('ATUALIZAR','INSERIR')
                  and exists ( select 1
                               from pagamentospedidos p
                               where p.idpagamentopedido = :P322_IDPAGAMENTOPEDIDO
                                 and p.idsituacao = 20 )
                  and exists ( select 1
                               from usuarios u
                               where u.usuario = v('APP_USER')
                                 and u.idgerente = 80 )
                ```
        }
    )

)

