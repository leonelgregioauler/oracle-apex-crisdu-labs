    process operação-dml-em-pagamentos-pedidos (
        name: Operação DML em Pagamentos Pedidos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vvalorpago              number(15,2);
                  vjuros                  number(15,2);
                  vacrescimo              number(15,2);
                  vdesconto               number(15,2);
                  vvalorliquido           number(15,2);
                  vidusuarionegociacao    number := null;
                  vattach_data            varchar2(1) := 0; 
                  --
                  voperacao_dml           varchar2(1);
                  v_baixaboleto           varchar2(1);
                  v_dt_log                date := '01/10/2025'; -- Maicon Aimi
                  --
                begin
                -- Maicon log
                if v('APP_USER') = 'MAICONAIMI' and v_dt_log = trunc(sysdate) then
                    roman.prc_grava_log_debug_desenvolvedores('hahgsfdyqtwre','INICIO');
                end if;
                -- Maicon log
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                -- Maicon log
                if v('APP_USER') = 'MAICONAIMI' and v_dt_log = trunc(sysdate) then
                    roman.prc_grava_log_debug_desenvolvedores('hahgsfdyqtwre','1');
                end if;
                -- Maicon log
                  if :P322_SEMANEXO = 'S' then
                    -- 
                    update pagamentospedidos
                    set attach_data = vattach_data
                    where idpagamentopedido = :P322_IDPAGAMENTOPEDIDO;
                    --
                    commit;
                    --
                  end if;
                  --
                -- Maicon log
                if v('APP_USER') = 'MAICONAIMI' and v_dt_log = trunc(sysdate) then
                    roman.prc_grava_log_debug_desenvolvedores('hahgsfdyqtwre','2');
                end if;
                -- Maicon log
                  if voperacao_dml = 'U' then
                    --
                    begin
                        select 'S'
                          into v_baixaboleto
                          from vencimentospedidos v
                             , pagamentospedidos  p
                         where v.idvencimentopedido = :P322_IDVENCIMENTOPEDIDO
                           and v.idvencimentopedido = p.idvencimentopedido
                           and p.idsituacao <> -1
                           and v.datavencimento >= :P322_DATAPAGAMENTO
                           and p.idformapagamento in (select idformapagamento
                                                        from formaspagamentos
                                                       where boleto = 'S' )
                           and rownum = 1;
                    exception
                        when others then
                            v_baixaboleto := 'N';
                    end;
                    --
                  
                  end if;
                  --
                -- Maicon log
                if v('APP_USER') = 'MAICONAIMI' and v_dt_log = trunc(sysdate) then
                    roman.prc_grava_log_debug_desenvolvedores('hahgsfdyqtwre','3');
                end if;
                -- Maicon log
                  vvalorpago         := to_number(:P322_VALORPAGO          ,'999G999G999G990D00');
                  vjuros             := to_number(:P322_JUROS              ,'999G999G999G990D00');
                  vacrescimo         := to_number(:P322_ACRESCIMO          ,'999G999G999G990D00');
                  vdesconto          := to_number(:P322_DESCONTO           ,'999G999G999G990D00');
                  vvalorliquido      := to_number(:P322_VALORLIQUIDO       ,'999G999G999G990D00');
                
                  pck_pedidos_fav.prc_pagamentospedidos( pidpagamentopedido           => :P322_IDPAGAMENTOPEDIDO
                                                       , pidvencimentopedido          => :P322_IDVENCIMENTOPEDIDO
                                                       , pidformapagamento            => :P322_IDFORMAPAGAMENTO
                                                       , pdatapagamento               => :P322_DATAPAGAMENTO
                                                       , pvalorpago                   => vvalorpago
                                                       , porigempagamento             => :P322_ORIGEMPAGAMENTO
                                                       , pnumeroboleto                => :P322_NUMEROBOLETO
                                                       , pidsituacao                  => :P322_IDSITUACAO
                                                       , ptaxa                        => :P322_TAXA
                                                       , pjuros                       => vjuros
                                                       , pacrescimo                   => vacrescimo
                                                       , pdesconto                    => vdesconto
                									   , pvalorliquido                => vvalorliquido
                                                       , pnumerocomprovante           => :P322_NUMEROCOMPROVANTE
                                                       , pidcontabancaria             => :P322_IDCONTABANCARIA
                                                       , pobservacao                  => :P322_OBSERVACAO
                                                       , pidusuariopagamento          => :P322_IDUSUARIOPAGAMENTO
                                                       , pidusuarionegociacao         => vidusuarionegociacao
                									   , penviooperadora              => :P322_ENVIOOPERADORA
                									   , pretornooperadora            => :P322_RETORNOOPERADORA
                                                       , pjustificativadescacresc     => :P322_JUSTIFICATIVADESCACRESC
                									   , poperacao_dml                => voperacao_dml
                									   , pmd5                         => :P322_MD5 
                                                       , pbaixaboleto                 => v_baixaboleto); 
                  --
                -- Maicon log
                if v('APP_USER') = 'MAICONAIMI' and v_dt_log = trunc(sysdate) then
                    roman.prc_grava_log_debug_desenvolvedores('hahgsfdyqtwre','Fim');
                end if;
                -- Maicon log
                end;                                       
                										
                										
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1411598013155853747
        }
    )

