    pageItem P322_IDCONTABANCARIA (
        type: selectList
        label {
            label: Conta Bancária
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.beneficiario||' ('||b.nomebanco||' - Ag: '||c.agencia||'- CC: '||c.conta||')' d
                     , c.idcontabanc r
                from roman.contasbancarias c
                   , roman.bancos b
                where b.idbanco = c.idbanco
                  and c.ativo = 'S'
                  and c.usosetorcobranca = 'S'
                order by 1;
                ```
            nullDisplayValue: - Selecione a conta bancária -
        }
        layout {
            sequence: 110
            region: @informar-pagamento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidcontabancaria number;
                begin
                  if :P322_IDPAGAMENTOPEDIDO is not null then
                    select idcontabancaria
                    into vidcontabancaria
                    from pagamentospedidos
                    where idpagamentopedido = :P322_IDPAGAMENTOPEDIDO;
                  end if;
                  --
                  return vidcontabancaria;
                  --
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P322_IDFORMAPAGAMENTO (
        type: selectList
        label {
            label: Forma de Pagamento
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct 
                       pp.formapagamento as d
                     , pp.idformapagamento as r
                from pagamentospedidos p 
                   , vw_perfispagamentos_fav pp
                where p.origempagamento(+)  = pp.origempagamento 
                   and p.idformapagamento(+) = pp.idformapagamento
                   and p.idsituacao(+)       = pp.idsituacaopagamentoped
                   and pck_util_fav.fnc_verificaacesso(28610,:P0_IDUSUARIO) = 'S'
                union
                select distinct 
                       pp.formapagamento as d
                     , pp.idformapagamento as r
                from pagamentospedidos p 
                   , vw_perfispagamentos_fav pp
                where p.origempagamento(+)  = pp.origempagamento 
                   and p.idformapagamento(+) = pp.idformapagamento
                   and p.idsituacao(+)       = pp.idsituacaopagamentoped
                   and pp.idgrupoatendimento = :P322_IDGRUPOATENDIMENTO
                   and pp.idacesso is null
                union
                select distinct 
                       pp.formapagamento as d
                     , pp.idformapagamento as r
                from pagamentospedidos p 
                   , vw_perfispagamentos_fav pp
                where p.origempagamento(+)   = pp.origempagamento 
                   and p.idformapagamento(+) = pp.idformapagamento
                   and p.idsituacao(+)       = pp.idsituacaopagamentoped
                   and p.idpagamentopedido   = :P322_IDPAGAMENTOPEDIDO
                union
                select distinct 
                       fp.descricao as d
                     , p.idformapagamento as r
                from  formaspagamentos fp
                    , pagamentospedidos p
                where fp.idformapagamento = p.idformapagamento 
                 and p.idpagamentopedido   =  :P322_IDPAGAMENTOPEDIDO
                union
                select distinct 
                       pp.formapagamento as d
                     , pp.idformapagamento as r
                from pagamentospedidos p
                   , vw_perfispagamentos_fav pp
                where p.origempagamento(+)  = pp.origempagamento
                  and p.idformapagamento(+) = pp.idformapagamento
                  and p.idsituacao(+)       = pp.idsituacaopagamentoped
                  and pck_util_fav.fnc_verificaacesso(pp.idacesso,:P0_IDUSUARIO) = 'S';
                  
                
                ```
            nullDisplayValue: - Selecione a forma de pagamento
        }
        cascadingLov {
            parentItems: P322_IDGRUPOATENDIMENTO
            itemsToSubmit: P322_IDGRUPOATENDIMENTO
        }
        layout {
            sequence: 70
            region: @informar-pagamento
            slot: regionBody
            alignment: left
            columnSpan: 7
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidformapagamento number;
                begin
                  --Retorna a forma de pagamento que está sendo consultado / editado (junto com a ação dinâmica no page load )
                  if :P322_IDPAGAMENTOPEDIDO is not null then
                    select idformapagamento
                    into vidformapagamento
                    from pagamentospedidos
                    where idpagamentopedido = :P322_IDPAGAMENTOPEDIDO;
                  end if;
                  --
                  return vidformapagamento;
                  --
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

