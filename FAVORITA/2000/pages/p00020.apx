page 20 (
    name: Cadastro de Características Produtos
    title: Características Produtos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region características-dos-produtos (
        name: Características dos Produtos
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P20_DESCRICAO (
        type: textField
        label {
            label: Característica Produto
            alignment: left
        }
        layout {
            sequence: 20
            region: @características-dos-produtos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P20_IDBANHO (
        type: hidden
        layout {
            sequence: 40
            region: @características-dos-produtos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P20_IDCARACTERISTICAPRODUTO (
        type: hidden
        layout {
            sequence: 10
            region: @características-dos-produtos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P20_IDCHEIRO (
        type: hidden
        layout {
            sequence: 60
            region: @características-dos-produtos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P20_IDSABOR (
        type: hidden
        layout {
            sequence: 50
            region: @características-dos-produtos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P20_IDTEXTO (
        type: hidden
        layout {
            sequence: 70
            region: @características-dos-produtos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P20_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @características-dos-produtos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P20_OPERACAO_DML (
        type: hidden
        layout {
            sequence: 90
            region: @características-dos-produtos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 50
            region: @características-dos-produtos
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P20_IDCARACTERISTICAPRODUTO
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 40
            region: @características-dos-produtos
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P20_IDCARACTERISTICAPRODUTO
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 30
            region: @características-dos-produtos
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 19
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 20
            region: @características-dos-produtos
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P20_IDCARACTERISTICAPRODUTO
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @características-dos-produtos
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P20_IDCARACTERISTICAPRODUTO
        }
    )

    validation descrição-obrigatória (
        name: DESCRIÇÃO obrigatória
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P20_DESCRICAO
        }
        error {
            errorMessage: Descrição deve ter um valor.
            associatedItem: @P20_DESCRICAO
        }
    )

    process consulta-características-produtos (
        name: Consulta Características Produtos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                #OWNER#.PCK_CADASTROS_FAV.PRC_CARACTERISTICAPRODUTOS (
                  PIDCARACTERISTICAPRODUTO => :P20_IDCARACTERISTICAPRODUTO,
                  PDESCRICAO => :P20_DESCRICAO,
                  PIDBANHO => :P20_IDBANHO,
                  PIDSABOR => :P20_IDSABOR,
                  PIDCHEIRO => :P20_IDCHEIRO,
                  PMD5 => :P20_MD5,
                  POPERACAO_DML => 'S');
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 3225534928318529
        }
    )

    process limpar-campos-ao-sair (
        name: Limpar Campos ao Sair
        type: clearSessionState
        execution {
            sequence: 10
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 3226659106318540
        }
    )

    process limpar-campos-para-adicionar (
        name: Limpar Campos para Adicionar
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 3226799690318541
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    process operação-dml-em-características-produtos (
        name: Operação DML em Características Produtos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  #OWNER#.PCK_CADASTROS_FAV.PRC_CARACTERISTICAPRODUTOS (
                    PIDCARACTERISTICAPRODUTO => :P20_IDCARACTERISTICAPRODUTO,
                    PDESCRICAO => :P20_DESCRICAO,
                    PIDBANHO => :P20_IDBANHO,
                    PIDSABOR => :P20_IDSABOR,
                    PIDCHEIRO => :P20_IDCHEIRO,
                    PMD5 => :P20_MD5,
                    POPERACAO_DML => voperacao_dml);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 3286075013433776
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 20
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

)

