    region pedidos-venda-ativa (
        name: Pedidos Venda Ativa
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpedido
                     , p.vendedora
                     , p.representante
                     , p.filialromance
                     , p.dataemissao
                     , p.datavencimento
                     , p.dataentrega
                     , p.valortotal
                     , p.valorapagar
                     , p.situacaoentregainterno
                     , p.situacaofinanceirointerno
                     , p.situacaopagamento                       
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||p.idpedido,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' "Ver Pedido"
                from vw_pedidos_fav p
                where p.ididioma = 1
                  and :P250_TIPORELATORIO = 'V'
                  and exists ( select 1
                               from tarefas t
                               where t.idpedido = p.idpedido 
                                 and t.idtipotarefa = 11 )
                  and not exists ( select 1
                                   from classificacoespedidos c
                                   where c.idpedido = p.idpedido
                                     and c.idcaracteristicapedido = 25)
                order by 1 desc	
                ```
        }
