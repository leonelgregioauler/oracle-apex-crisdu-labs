page 250 (
    name: Pedidos Pós Prospecção
    title: Pedidos Pós Prospecção
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region pedidos-pós-prospecção (
        name: Pedidos Pós Prospecção
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpedido
                     , p.vendedora
                     , p.representante
                     , p.filialromance
                     , p.dataemissao
                     , p.datavencimento
                     , p.dataentrega
                     , p.valortotal
                     , p.valorapagar
                     , p.situacaoentregainterno
                     , p.situacaofinanceirointerno
                     , p.situacaopagamento                       
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||p.idpedido,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' "Ver Pedido"
                from vw_pedidos_fav p
                where p.ididioma = 1
                  and :P250_TIPORELATORIO = 'P'
                  and exists ( select 1
                               from itenspedidos i
                               where i.idpedido = p.idpedido
                                 and i.idkitvenda = 72 )
                  and not exists ( select 1
                                   from classificacoespedidos c
                                   where c.idpedido = p.idpedido
                                     and c.idcaracteristicapedido = 25)
                order by 1 desc	
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P250_TIPORELATORIO
            value: P
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum pedido encontrado!
        }
        advanced {
            savedReportMappingIdentifier: 580428345932463245
        }

