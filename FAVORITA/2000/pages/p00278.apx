    button anexar-despesa (
        buttonName: ANEXAR_DESPESA
        label: Anexar Arquivo
        layout {
            sequence: 20
            region: @inserir-nova-despesa
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 282
                items: {
                    P282_IDDESPESA: &P278_IDDESPESA.
                    P282_IDANEXODESPESA:
                    P282_IDANEXODELETAR:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P278_IDDESPESA
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Fechar e Atualizar
        layout {
            sequence: 30
            region: @inserir-nova-despesa
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 245
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 60
            region: @inserir-nova-despesa
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P278_IDDESPESA
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 40
            region: @inserir-nova-despesa
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P278_IDDESPESA is not null
                and :P278_IDREPRESENTANTE is null
                and :P278_IDENTRADADIVERSA is null
                and exists ( select 1 
                             from fechamentossemanais f
                             where idfechamento = :P278_IDFECHAMENTO
                               and concluido = 'N')
                ```
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 50
            region: @inserir-nova-despesa
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P278_IDDESPESA is not null
                and :P278_IDREPRESENTANTE is null
                and exists ( select 1 
                             from fechamentossemanais f
                             where idfechamento = :P278_IDFECHAMENTO
                               and concluido = 'N')
                ```
        }
    )

    dynamicAction refresh-campo (
        name: Refresh Campo
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P278_IDMATRIZCLASSIFICACAO
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P278_IDCONTACONTABIL
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation p278-idsubcontacontabil (
        name: P278_IDSUBCONTACONTABIL
        execution {
            sequence: 120
        }
        validation {
            type: itemIsNotNull
            item: P278_IDSUBCONTACONTABIL
        }
        error {
            errorMessage: #LABEL# deve ser informada!
            associatedItem: @P278_IDSUBCONTACONTABIL
        }
        serverSideCondition {
            type: never
        }
    )

    validation saldo (
        name: Saldo
        execution {
            sequence: 130
        }
        validation {
            type: itemIsNotNullOrZero
            item: P278_VALOR
        }
        error {
            errorMessage: Informe o valor corretamente!
        }
    )

    validation valida-matriz-de-classificação (
        name: Valida Matriz de Classificação
        execution {
            sequence: 150
        }
        validation {
            type: itemIsNotNull
            item: P278_IDMATRIZCLASSIFICACAO
        }
        error {
            errorMessage: Por favor, utilize a classificação da Despesa!
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('SAVE','CREATE')
        }
    )

    validation valida-semana-fechada (
        name: valida semana fechada
        execution {
            sequence: 140
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.fechamentossemanais
                where idfechamento = :P278_IDFECHAMENTO
                  AND CONCLUIDO = 'N'
                ```
        }
        error {
            errorMessage: A semana que está incluindo esta despesa já está fechada, feche esta tela, selecione uma semana em aberto, e clique em nova despesa.
        }
    )

    process atualiza-fechamentos (
        name: atualiza fechamentos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  pck_fechamentos_fav.prc_atualiza_gavetas ( :P278_IDFECHAMENTO );
                exception 
                  when others then 
                    null;
                end;
                ```
        }
        execution {
            sequence: 50
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 779322388762131703
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P278_IDFECHAMENTO
        }
    )

    process deleta-anexo (
        name: Deleta Anexo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure   .
                  roman.pck_anexos.prc_apagaanexo(pidanexodespesa => :P278_IDANEXODELETAR);
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 2178024003523327421
        }
        serverSideCondition {
            type: request=Value
            value: DELETARANEXO
        }
    )

    process fetch-row-from-despesas (
        name: Fetch Row from DESPESAS
        type: autoRowFetch
        source {
            tableOwner: ROMAN
            tableName: DESPESAS
            pkColumn: IDDESPESA
            pkItem: P278_IDDESPESA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Unable to fetch row.
