    pageItem P278_IDMATRIZCLASSIFICACAO (
        type: selectList
        label {
            label: Classificação
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.classificacaodespesa
                     , m.idmatrizclassificacao
                from roman.matrizclassificacoesdespesas m
                where m.idfilial = ( select idfilialromance
                                     from filiaisfavorita f
                                     where f.idfilialfavorita = :P278_IDFILIALFAVORITA )
                  and m.ativo = 'S'
                order by 1;
                ```
        }
        layout {
            sequence: 20
            region: @inserir-nova-despesa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDMATRIZCLASSIFICACAO
            used: always
        }
        readOnly {
            type: itemIsNotNull
            item: P278_IDDESPESA
        }
        security {
            encryptSessionState: false
        }
    )

