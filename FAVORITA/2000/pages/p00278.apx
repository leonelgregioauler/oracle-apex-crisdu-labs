    pageItem P278_IDCONTACONTABIL (
        type: selectList
        label {
            label: Conta Contábil
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(c.nomeconta) display_value
                     , c.idcontafinan  return_value
                from roman.contasfinanceiras c
                where exists ( select 1
                               from roman.matrizclassificacoesdespesas m
                               where m.idmatrizclassificacao = :P278_IDMATRIZCLASSIFICACAO
                                 and m.idcontafinan          = c.idcontafinan )
                ```
            nullDisplayValue: - Selecione a Conta Contábil -
        }
        cascadingLov {
            parentItems: P278_IDMATRIZCLASSIFICACAO
        }
        layout {
            sequence: 80
            region: @inserir-nova-despesa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDCONTACONTABIL
            used: always
        }
        readOnly {
            type: itemIsNotNull
            item: P278_IDDESPESA
        }
        security {
            encryptSessionState: false
