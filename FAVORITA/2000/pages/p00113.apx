page 113 (
    name: Relatório Permissões Comp/Transf/Remessas
    title: Relatório Permissões Comp/Transf/Remessas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region permissões-comp-transf-remessas (
        name: Permissões Comp/Transf/Remessas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpermissaotipoctrp 
                     , p.idusuario
                     , pck_util_fav.fnc_nomeusuario(p.idusuario) nomeusuario
                     , p.idtipocomptransrem
                     , p.desctipo
                     , decode(p.visualizar,'S','Sim','Não') visualizar
                     , decode(p.criar,'S','Sim','Não') criar
                from vw_permissoestiposctrp_fav p
                where p.ididioma = :P0_IDIDIOMA
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhuma Permissão informada!
        }
        advanced {
            savedReportMappingIdentifier: 14800556384484510
        }

        column CRIAR (
            type: plainText
            heading {
                heading: Cadastrar
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column DESCTIPO (
            type: plainText
            heading {
                heading: Tipo
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column IDPERMISSAOTIPOCTRP (
            type: link
            heading {
                heading: Ver/Editar
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 114
                    items: {
                        P114_IDPERMISSAOTIPOCTRP: #IDPERMISSAOTIPOCTRP#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column IDTIPOCOMPTRANSREM (
            type: hidden
            heading {
                heading: Idtipocomptransrem
            }
            layout {
                sequence: 40
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDUSUARIO (
            type: hidden
            heading {
                heading: Idusuario
            }
            layout {
                sequence: 20
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOMEUSUARIO (
            type: plainText
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column VISUALIZAR (
            type: plainText
            heading {
                heading: Visualizar
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 148566 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CRIAR (
                sequence: 7
            )

            displayColumn DESCTIPO (
                sequence: 5
            )

            displayColumn IDPERMISSAOTIPOCTRP (
                sequence: 1
            )

            displayColumn IDTIPOCOMPTRANSREM (
                sequence: 4
            )

            displayColumn IDUSUARIO (
                sequence: 2
            )

            displayColumn NOMEUSUARIO (
                sequence: 3
            )

            displayColumn VISUALIZAR (
                sequence: 6
            )

            controlBreak (
                column: NOMEUSUARIO
                layout {
                    sequence: 1
                }
            )

        )

    )

    button novo (
        buttonName: NOVO
        label: Nova Permissão
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 114
                items: {
                    P114_IDPERMISSAOTIPOCTRP:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

