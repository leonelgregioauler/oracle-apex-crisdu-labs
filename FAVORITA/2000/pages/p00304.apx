page 304 (
    name: Categorias Clube
    title: Categorias Clube
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region categorias-clube-minha-favorita (
        name: Categorias Clube Minha Favorita
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idcategoriaclube
                     , c.nomecategoria
                     , c.pontuacaominima
                     , c.pontuacaomaxima
                from vw_categoriasclube_fav c
                order by 2
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 305
                items: {
                    P305_IDCATEGORIACLUBE: #IDCATEGORIACLUBE#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 1402167760840481114
        }

        column IDCATEGORIACLUBE (
            type: plainText
            heading {
                heading: Cod. Categoria
                alignment: center
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column NOMECATEGORIA (
            type: plainText
            heading {
                heading: Nome Categoria
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column PONTUACAOMAXIMA (
            type: plainText
            heading {
                heading: Pontuação Máxima
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column PONTUACAOMINIMA (
            type: plainText
            heading {
                heading: Pontuação Mínima
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 14021923 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn IDCATEGORIACLUBE (
                sequence: 1
            )

            displayColumn NOMECATEGORIA (
                sequence: 2
            )

            displayColumn PONTUACAOMAXIMA (
                sequence: 4
            )

            displayColumn PONTUACAOMINIMA (
                sequence: 3
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Nova Categoria
        layout {
            sequence: 10
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 305
                clearCache: 305
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction create-button-dialog-closed (
        name: Create Button - Dialog Closed
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @categorias-clube-minha-favorita
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @categorias-clube-minha-favorita
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @categorias-clube-minha-favorita
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

