    region por-ano (
        name: Por Ano
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select null link
                     , to_number(to_char(c.datacadastrorepresentante,'MM')) mes
                     , count(1) "2020"
                from roman.controlecontatossite c
                where extract( year from c.datacadastrorepresentante) = 2020
                  and c.situacao = 'U'
                  and c.idrepresentante is not null
                  and exists ( select 1
                               from roman.parametros pr
                               where pr.idfilial = c.idfilial 
                                 and pr.nome     = 'ENVIOINDICACAOAUTOMATICA' 
                                 and pr.valor    = 'S' )
                group by to_number(to_char(datacadastrorepresentante,'RRRR')) 
                       , to_number(to_char(datacadastrorepresentante,'MM'))
                order by to_number(to_char(datacadastrorepresentante,'RRRR')) 
                       , to_number(to_char(datacadastrorepresentante,'MM'))
                ```
        }
        layout {
            sequence: 30
            parentRegion: @relatórios-por-empresa
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        security {
            escapeSpecialChars: false
        }
        chart {
            type: line
        }
        title {
            title: Por Ano
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        animation {
            onDataChange: none
        }
        tooltip {
            showSeriesName: false
        }
        legend {
            position: top
            hideAndShowBehavior: none
