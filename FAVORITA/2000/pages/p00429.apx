    region cadastradas-pelos-distribuidores (
        name: Cadastradas pelos Distribuidores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(r.idrepresentante) distribuidor
                     , roman.pck_romance.fnc_nomefilial(g.idfilial) empresa
                     , d.data
                     , nvl(( select count(c.idcontrolecontatossite) qtd
                             from roman.controlecontatossite c
                             where trunc(c.datapassadorepres) = d.data 
                               and c.idrepresentante          = r.idrepresentante ),0) encaminhado
                     , nvl(( select count(c.idcontrolecontatossite) qtd
                             from roman.controlecontatossite c
                             where c.situacao                  = 'U'
                               and trunc(c.datacadastrorepresentante) = d.data 
                               and c.idrepresentante                  = r.idrepresentante ),0) cadastrado
                from roman.dias d
                   , representantes r
                   , catal.gerentes g
                where r.idgerente = g.idgerente
                  and r.ativo     = 'S'
                  and d.data between to_date(:P429_DATAINICIO) and to_date(:P429_DATAFIM)
                  and ( :P429_IDFILIALROMANCE is null or g.idfilial = :P429_IDFILIALROMANCE )
                  and exists ( select 1
                               from roman.parametros pr
                               where pr.idfilial = g.idfilial 
                                 and pr.nome     = 'ENVIOINDICACAOAUTOMATICA' 
                                 and pr.valor    = 'S' )
                  and exists ( select 1
                               from roman.controlecontatossite c
                               where trunc(c.datapassadorepres) = d.data 
                                 and c.idrepresentante          = r.idrepresentante )
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P429_TIPO_RELATORIO
            value: D
        }
        componentAppearance {
