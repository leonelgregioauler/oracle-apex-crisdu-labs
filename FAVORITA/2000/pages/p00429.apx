    region acompanhamento-ano-passado (
        name: Acompanhamento Ano Passado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome empresa
                     , t.data
                     , t.qtd
                from roman.vw_filiais f
                   , ( select trunc(c.dataultimaatualizacao) data
                            , c.idfilial
                            , count(c.idcontrolecontatossite) qtd
                       from roman.controlecontatossite c
                       where c.situacao              = 'U'
                         and c.dataultimaatualizacao between to_date(:P429_DATAINICIO||' 00:00:00','DD/MM/RRRR hh24:MI:SS')-365 and to_date(:P429_DATAfim||' 23:59:59','DD/MM/RRRR hh24:MI:SS')-365
                         and c.idrepresentante       is not null
                         and ( :P429_IDFILIALROMANCE is null or c.idfilial = :P429_IDFILIALROMANCE )
                         and exists ( select 1
                                      from roman.parametros pr
                                      where pr.idfilial = c.idfilial 
                                        and pr.nome     = 'ENVIOINDICACAOAUTOMATICA' 
                                        and pr.valor    = 'S' )
                         and :P429_DATAINICIO is not null
                       group by trunc(c.dataultimaatualizacao) 
                              , c.idfilial ) t
                where f.idfilial = t.idfilial(+) 
                  and ( :P429_IDFILIALROMANCE is null or f.idfilial = :P429_IDFILIALROMANCE )
                  and exists ( select 1
                               from roman.parametros pr
                               where pr.idfilial = f.idfilial 
                                 and pr.nome     = 'ENVIOINDICACAOAUTOMATICA' 
                                 and pr.valor    = 'S' )
                ```
        }
        layout {
            sequence: 10
            parentRegion: @relatórios-por-empresa
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 5991747964724503
        }

        column DATA (
            type: plainText
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: A
            }
        )

