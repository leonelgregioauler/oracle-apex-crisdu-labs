page 399 (
    name: Mapeamento de Dados
    title: Mapeamento de Dados
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    css {
        inline: ".rc-content-main {height: 400px; overflow: auto !important;}"
    }
    security {
        pageAccessProtection: unrestricted
    }

    region mapeamento-de-dados (
        name: Mapeamento de Dados
        type: dataUploadColMapping
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            customAttributes: style="width:100%;max-width:none;"
        }
        settings {
            dataLoadDefinition: @importa-arquivo-atzestoques
        }
    )

    region progresso (
        name: Progresso
        type: list
        source {
            list: @data-load-wizard-progress-importa-arquivo-atzestoques
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            excludeTitleFromTranslation: true
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 30
            region: @mapeamento-de-dados
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 398
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button next (
        buttonName: NEXT
        label: Proximo OPTIMUS
        layout {
            sequence: 40
            region: @mapeamento-de-dados
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button previous (
        buttonName: PREVIOUS
        label: Anterior
        layout {
            sequence: 20
            region: @mapeamento-de-dados
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 398
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button proximo-virtual (
        buttonName: PROXIMO_VIRTUAL
        label: Proximo virtual
        layout {
            sequence: 10
            region: @mapeamento-de-dados
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process prepare-uploaded-data-optimus (
        name: Prepare Uploaded Data optimus
        type: prepareUploadedData
        dataLoading {
            dataLoadDefinition: @importa-arquivo-atzestoques
        }
        processingResult {
            insertCountItem: P401_INSERT_COUNT
            updateCountItem: P401_UPDATE_COUNT
            errorCountItem: P401_ERROR_COUNT
            reviewCountItem: P401_REVIEW_COUNT
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1550463576843018292
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

    process prepare-uploaded-data-virtual (
        name: Prepare Uploaded Data virtual
        type: prepareUploadedData
        dataLoading {
            dataLoadDefinition: @preatualizaestoque-virtual
        }
        processingResult {
            insertCountItem: P401_INSERT_COUNT
            updateCountItem: P401_UPDATE_COUNT
            errorCountItem: P401_ERROR_COUNT
            reviewCountItem: P401_REVIEW_COUNT
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 113383191820208721
        }
        serverSideCondition {
            whenButtonPressed: @proximo-virtual
        }
    )

    branch (
        name: Go To Page 401
        execution {
            sequence: 40
        }
        behavior {
            target: {
                page: 401
            }
        }
        serverSideCondition {
            whenButtonPressed: @proximo-virtual
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                                   begin
                                            for c1 in (select skip_validation
                                                      from apex_appl_load_tables
                                                      where name = 'preatualizaestoque_virtual' and application_id = apex_application.g_flow_id )
                                            loop
                                                if c1.skip_validation = 'Y' then return true;
                                                else return false;
                                                end if;
                                            end loop;
                                        end;
                ```
        }
    )

    branch (
        name: Go To Page 400
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 400
            }
        }
        serverSideCondition {
            whenButtonPressed: @proximo-virtual
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                                   begin
                                            for c1 in (select skip_validation
                                                      from apex_appl_load_tables
                                                      where name = 'preatualizaestoque_virtual' and application_id = apex_application.g_flow_id )
                                            loop
                                                if c1.skip_validation = 'N' then return true;
                                                else return false;
                                                end if;
                                            end loop;
                                        end;
                ```
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 400
            }
        }
        serverSideCondition {
            whenButtonPressed: @next
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                                   begin
                                            for c1 in (select skip_validation
                                                      from apex_appl_load_tables
                                                      where name = 'Importa Arquivo AtzEstoques' and application_id = apex_application.g_flow_id )
                                            loop
                                                if c1.skip_validation = 'N' then return true;
                                                else return false;
                                                end if;
                                            end loop;
                                        end;
                ```
        }
    )

    branch (
        name: Go To Page 401
        execution {
            sequence: 30
        }
        behavior {
            target: {
                page: 401
            }
        }
        serverSideCondition {
            whenButtonPressed: @next
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                                   begin
                                            for c1 in (select skip_validation
                                                      from apex_appl_load_tables
                                                      where name = 'Importa Arquivo AtzEstoques' and application_id = apex_application.g_flow_id )
                                            loop
                                                if c1.skip_validation = 'Y' then return true;
                                                else return false;
                                                end if;
                                            end loop;
                                        end;
                ```
        }
    )

)

