page 292 (
    name: Tarefas da Cliente
    title: Tarefas da Cliente
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region tarefas-da-cliente (
        name: Tarefas da Cliente
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idtarefa
                     , t.tipotarefa
                     , t.prioridade
                     , t.situacao
                     , t.telefone
                     , t.datainclusao
                     , t.datainicio
                     , t.dataconclusao
                     , t.nomeusuario 
                from vw_tarefas_fav t
                where t.ididioma = 1
                  and t.idpessoa = :P292_IDPESSOA
                order by 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1228308654703519212
        }

        column DATACONCLUSAO (
            type: plainText
            heading {
                heading: Dataconclusao
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: H
            }
        )

        column DATAINCLUSAO (
            type: plainText
            heading {
                heading: Datainclusao
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: F
            }
        )

        column DATAINICIO (
            type: plainText
            heading {
                heading: Datainicio
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: G
            }
        )

        column IDTAREFA (
            type: plainText
            heading {
                heading: Idtarefa
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column NOMEUSUARIO (
            type: plainText
            heading {
                heading: Nomeusuario
                alignment: center
            }
            layout {
                sequence: 90
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        column PRIORIDADE (
            type: plainText
            heading {
                heading: Prioridade
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        column SITUACAO (
            type: plainText
            heading {
                heading: Situacao
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column TELEFONE (
            type: plainText
            heading {
                heading: Telefone
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column TIPOTAREFA (
            type: plainText
            heading {
                heading: Tipotarefa
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 14303162 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATACONCLUSAO (
                sequence: 8
            )

            displayColumn DATAINCLUSAO (
                sequence: 6
            )

            displayColumn DATAINICIO (
                sequence: 7
            )

            displayColumn IDTAREFA (
                sequence: 1
            )

            displayColumn NOMEUSUARIO (
                sequence: 9
            )

            displayColumn PRIORIDADE (
                sequence: 3
            )

            displayColumn SITUACAO (
                sequence: 4
            )

            displayColumn TELEFONE (
                sequence: 5
            )

            displayColumn TIPOTAREFA (
                sequence: 2
            )

        )

    )

    pageItem P292_IDPESSOA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @tarefas-da-cliente
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

)

