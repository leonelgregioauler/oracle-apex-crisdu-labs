    pageItem P415_VENCIMENTOS (
        type: textField
        label {
            label: Vencimentos
            alignment: left
        }
        layout {
            sequence: 300
            region: @pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vvencimentos varchar2(2000);
                begin
                  --
                  select listagg(to_char(v.datavencimento,'DD/MM/RRRR'),' - ') within group (order by 1)
                  into vvencimentos
                  from vencimentospedidos v
                  where v.idpedido = :P415_IDPEDIDO
                    and v.situacaovencimento = 'V';
                  --
                  if vvencimentos = '' then
                    --
                    vvencimentos := 'Não há Vencimentos!';
                    --
                  end if;
                  --
                  return vvencimentos;
                  --
                end;
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

