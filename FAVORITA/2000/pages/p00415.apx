    pageItem P415_VALORATUALIZADOPARAHOJE (
        type: textField
        label {
            label: Valor Atualizado P/ Hoje
            alignment: left
        }
        layout {
            sequence: 500
            region: @pedido
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                /*select to_char(sum(pck_util_fav.fnc_calculajuros(pvalororiginal      => v.valorpagar- v.valorpago,
                                                             pdatavencimentoorig => v.datavencimento,
                                                             pdatavencimentonovo => trunc(sysdate),
                                                             ppercmulta          => 2,
                                                             ppercjuros          => 1)),'999G999G9999G999G990D00') valor
                from vencimentospedidos v
                where idpedido = :P415_IDPEDIDO
                  and v.situacaovencimento = 'V'
                  and exists ( SELECT 1
                               FROM DUAL
                               WHERE :P415_IDSITUACAOENTREGA >= 20000
                                 AND NOT EXISTS ( SELECT 1
                                                  FROM CLASSIFICACOESPEDIDOS C
                                                  WHERE C.IDPEDIDO = :P415_IDPEDIDO
                                                    AND C.IDCARACTERISTICAPEDIDO = 25 ) )
                select to_char(pck_util.fnc_calculajuros(pvalororiginal      => p.saldodevedor,
                                                 pdatavencimentoorig => p.datavencimentomenor,
                                                 pdatavencimentonovo => sysdate,
                                                 ppercmulta          => 2,
                                                 ppercjuros          => 1),'999G999G9999G999G990D00') valoratualizado
                from favorita.vw_pedidos_fav p 
                where p.idpedido = :P415_IDPEDIDO
                  and p.ididioma = :P0_IDIDIOMA */
                  --Osiel - 28/06/2024 - Ticket 8918171
                select to_char(favorita.pck_util_fav.fnc_calculajurosporvencimento( pidpedido   => p.idpedido,
                                                                                    ppercmulta  => 2,
                                                                                    ppercjuros  => 1),'999G999G9999G999G990D00') valoratualizado
                from favorita.vw_pedidos_fav p 
                where p.idpedido = :P415_IDPEDIDO
                  and p.ididioma = :P0_IDIDIOMA
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from pedidos p
                where exists ( select 1
                               from vencimentospedidos v
                               where v.idpedido = p.idpedido
                                 and v.situacaovencimento = 'V'
                                 and v.valorpagar > 0
                                 and v.datavencimento < trunc(sysdate)
                                 and v.valorpago < v.valorpagar )
                  and p.idpedido = :P415_IDPEDIDO
                ```
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

