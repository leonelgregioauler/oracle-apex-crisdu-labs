    pageItem P415_AVISO_ITENSINDISPONIVEIS (
        type: displayOnly
        label {
            label: Atenção:
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 90
            region: @aviso
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: staticValue
            staticValue: <font color="red"> Itens em observação já disponíveis para inclusão! </font>
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from itensindisponiveispedidos i
                where i.idpedido = :P415_IDPEDIDO
                  and i.iditemkitvenda is null
                  and i.idkitvenda is null
                  and pck_estoque_fav.fnc_estoquedisponivel(i.idestoque) > 0;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P415_AVISO_KITSINDISPONIVEIS (
        type: displayOnly
        label {
            label: Atenção:
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 100
            region: @aviso
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: staticValue
            staticValue: <font color="red"> Itens de Kit em observação já disponíveis para inclusão! </font>
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select count(1)
                from itensindisponiveispedidos i
                where i.idpedido = :P415_IDPEDIDO
                  and(  i.iditemkitvenda is not null
                      or i.idkitvenda is not null)
                  and exists ( select distinct 1
                               from favorita.itenskitsvendas ik
                               where ik.idprodutodetalhado = i.idprodutodetalhado
                                 and pck_estoque_fav.fnc_estoquedisponivel(i.idestoque) >= (ik.quantidade * i.quantidade))
                  having count(1) = ( select count(1)
                                      from itensindisponiveispedidos i
                                      where i.idpedido = :P415_IDPEDIDO
                                      having count(1) > 0)
                
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P415_AVISO_LIMITEMINIMO (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 80
            region: @aviso
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<font color="green"><h3>O valor mínimo deste pedido é '||trim(to_char( (p.valor) * nvl((round( 1 / f.fatorconversao, 2) ), 1),'999G999G999G999G990D00'))||'.</h3></font>' aviso
                from roman.vw_filiais f
                   , parametros p
                where f.idfilial(+) = p.idfilialromance
                  and p.idfilialromance = :P415_IDFILIALROMANCE
                  and p.nome = 'VALORMINIMOPEDIDO';
                ```
            used: always
        }
        serverSideCondition {
            type: item!=value
            item: P415_EDICAOBLOQUEADA
            value: S
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P415_AVISO_TAREFA_ANALISE (
        type: displayOnly
        label {
            alignment: left
        }
        layout {
            sequence: 10
            region: @pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            preText: <font color="GREEN"><b>Este pedido possui uma tarefa de Análise de Crédito!</b></font>
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P415_IDSITUACAOENTREGA = 20000
                  and exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.usuario = v('APP_USER')
                                 and ug.idgrupoatendimento = 9 )
                  and exists ( select 1
                               from tarefas t
                                  , vendedoras v
                               where t.idpessoa = v.idpessoa
                                 and t.idtipotarefa = 29
                                 and t.idsituacao = 0
                                 and v.idvendedora = :P415_IDVENDEDORA )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

