                           , cep
                           , idcidade
                      into :P415_NOMEPESSOA
                         , :P415_ENDERECOENTREGACORREIO
                         , :P415_NUMEROENTREGACORREIO
                         , :P415_BAIRROENTREGACORREIO
                         , :P415_CEPENTREGACORREIO
                         , :P415_CIDADEENTREGACORREIO
                      from pessoas
                      where idpessoa = :P415_IDPESSOA;
                    end;
                    ```
                itemsToSubmit: P415_IDPESSOA
                itemsToReturn: [
                    P415_NOMEPESSOA
                    P415_ENDERECOENTREGACORREIO
                    P415_NUMEROENTREGACORREIO
                    P415_BAIRROENTREGACORREIO
                    P415_CEPENTREGACORREIO
