    process imprimir-etiqueta-correio (
        name: Imprimir Etiqueta Correio
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidpedido          number        := :P415_IDPEDIDO;
                  vnomepessoa        varchar2(100) := :P415_NOMEPESSOA;
                  venderecoentrega   varchar2(100) := :P415_ENDERECOENTREGACORREIO;
                  vnumeroentrega     varchar2(100) := :P415_NUMEROENTREGACORREIO;
                  vbairroentrega     varchar2(100) := :P415_BAIRROENTREGACORREIO;
                  vcepentrega        varchar2(100) := :P415_CEPENTREGACORREIO;
                  vidcidadeentrega   number        := :P415_CIDADEENTREGACORREIO;
                  --
                  videnderecoentrega number;
                  vidpessoa          number := :P415_IDPESSOA;
                  --
                  vmd5   varchar2(4000);
                  vdml   varchar2(2):= 'I';
                  --
                  vvchar varchar2(4000);
                  --
                begin
                  --
                  favorita.pck_cadastros_fav.prc_enderecosentrega(pidenderecoentrega => videnderecoentrega,
                                                                  pidpessoa          => vidpessoa,
                                                                  prua               => :P415_ENDERECOENTREGACORREIO,
                                                                  pnumero            => :P415_NUMEROENTREGACORREIO,
                                                                  pcomplemento       => vvchar,
                                                                  pbairro            => :P415_BAIRROENTREGACORREIO,
                                                                  pcep               => :P415_CEPENTREGACORREIO,
                                                                  pidcidade          => :P415_CIDADEENTREGACORREIO,
                                                                  pobservacao        => vvchar,
                                                                  preferencia        => vvchar,
                                                                  pzona              => vvchar,
                                                                  pmd5               => vmd5,
                                                                  poperacao_dml      => vdml);
                  --
                  update favorita.classificacoespedidos cp
                   set cp.idvalorcaracteristica = videnderecoentrega
                  where cp.idpedido = :P415_IDPEDIDO
                    and cp.idcaracteristicapedido = 7;
                  --
                  pck_etiquetas.prc_gera_etiqueta_correio( pidpedido           => vidpedido
                                                         , pnomepessoa         => vnomepessoa
                                                         , penderecoentrega    => venderecoentrega
                                                         , pnumeroentrega      => vnumeroentrega
                                                         , pbairroentrega      => vbairroentrega
                                                         , pcepentrega         => vcepentrega
                                                         , pidcidadeentrega    => vidcidadeentrega
                                                         , pautomatico         => 'N' );
                   --
                end;
                ```
        }
        execution {
            sequence: 80
        }
        advanced {
            executionMappingIdentifier: 1603080905166752984
        }
        serverSideCondition {
            type: request=Value
            value: IMPRIMIRENDERECOCORREIO
        }
    )

    process informa-responsável-cobrança (
        name: Informa Responsável Cobrança
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  if v('REQUEST') = 'DISTRIBUIDOR_RECEB_RESP' then
                    --
                    update pedidos p
                    set p.idusuarioresponsavelcobranca = :P0_IDUSUARIO
                    where p.idpedido                   = :P415_IDPEDIDO;
                    --
                    commit;
                    --
                  elsif v('REQUEST') = 'DESFAZER_DISTRIBUIDOR_RECEB_RESP' then
                    --
                    update pedidos p
                    set p.idusuarioresponsavelcobranca = null
                    where p.idpedido                   = :P415_IDPEDIDO;
                    --
                    :P415_IDUSUARIORESPONSAVELCOB := null;
                    --
                    commit;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 190
        }
        advanced {
            executionMappingIdentifier: 1603084573659752986
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('DISTRIBUIDOR_RECEB_RESP', 'DESFAZER_DISTRIBUIDOR_RECEB_RESP');
        }
    )

