    process entrega-pedido-catalogo (
        name: Entrega Pedido Catalogo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vnumbernull           number;
                  vidpedido             number := :P415_IDPEDIDO;
                  vidusuario            number := :P0_IDUSUARIO;
                  vidsituacaoentrega    number := 60000;
                  vidsituacaofinanceiro number := 35000;
                  vidsituacaocobranca   number := 50;
                  videstoque            number;
                  vidprodutodetalhado   number;
                  viditempedido         number;
                  vquantidade           number;
                  --
                  vmotivo varchar2(100):= 'Entrega de catalogo';
                  --
                begin
                  --
                  select i.idestoque, i.idprodutodetalhado, i.iditempedido, i.quantidade
                  into   videstoque,vidprodutodetalhado,viditempedido,vquantidade
                  from favorita.itenspedidos i
                  where i.idpedido = vidpedido;
                  --
                  vquantidade := vquantidade*-1;
                  --
                  favorita.pck_movimentarpedidos_fav.prc_atualizacoespedidos ( pidpedido             => vidpedido
                                                                             , pidusuario            => vidusuario
                                                                             , pidsituacaoentrega    => vidsituacaoentrega
                                                                             , pidsituacaofinanceiro => vidsituacaofinanceiro
                                                                             , pidsituacaocobranca   => vidsituacaocobranca);
                  --
                  favorita.pck_estoque_fav.prc_movimentosestoques ( pidestoque            => videstoque
                                                                  , pidfilialfavorita     => :P415_IDFILIALFAVORITA
                                                                  , pidusuario            => vidusuario
                                                                  , pidprodutodetalhado   => vidprodutodetalhado
                                                                  , piditempedido         => viditempedido
                                                                  , piditemcompratransf   => vnumbernull
                                                                  , pquantidade           => vquantidade
                                                                  , pmotivo               => vmotivo);
                  --
                end;
                ```
        }
        execution {
            sequence: 360
        }
        advanced {
            executionMappingIdentifier: 1603085743690752988
        }
        serverSideCondition {
            type: never
        }
    )

