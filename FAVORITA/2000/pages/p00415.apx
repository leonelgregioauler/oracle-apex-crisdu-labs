    process atualiza-situação-cobrança (
        name: Atualiza situação cobrança
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidsituacaocobranca number;
                  vidcaracteristica number;
                  vidvalor number;
                  vidclassificacao number;
                  vdata date := sysdate;
                  vobservacao varchar2(1000);
                  vmd5 varchar2(1000);
                begin
                  --
                  if v('REQUEST') = 'ENVIAR_SPC' then
                    vidsituacaocobranca := 400;
                    vidcaracteristica := 44;
                  elsif  v('REQUEST') = 'ENVIAR_DOCUMENTACAO' then
                    vidsituacaocobranca := 500;
                    vidcaracteristica := 45;
                  elsif  v('REQUEST') = 'INCOBRAVEL' then
                    vidsituacaocobranca := 600;
                    vidcaracteristica := 46;
                  end if;
                  --
                  if vidsituacaocobranca = 400 then
                    --
                    update vendedoras v
                    set spc = 'S'
                    where v.idvendedora = :P415_IDVENDEDORA;
                    --
                  end if;
                  -- Call the procedure
                  pck_movimentarpedidos_fav.prc_atualizasituacaocobranca(pidpedido => :P415_IDPEDIDO,
                                                                         pidsituacao => vidsituacaocobranca,
                                                                         pidusuario => :P0_IDUSUARIO);
                  --
                  pck_pedidos_fav.prc_classificacoespedidos(pidclassificacaopedido => vidclassificacao,
                                                            pidpedido => :P415_IDPEDIDO,
                                                            pdataclassificado => vdata,
                                                            pidusuario => :P0_IDUSUARIO,
                                                            pidcaracteristicapedido => vidcaracteristica,
                                                            pidvalorcaracteristica => vidvalor,
                                                            pobservacao => vobservacao,
                                                            poperacao_dml => 'I',
                                                            pmd5 => vmd5);
                  --
                end;
                
                ```
        }
        execution {
            sequence: 220
        }
        successMessage {
            successMessage: Situação Cobrança atualizada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1603079310737752983
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('ENVIAR_SPC','ENVIAR_DOCUMENTACAO','INCOBRAVEL') 
                ```
        }
    )

    process atualizar-pedido (
        name: Atualizar Pedido
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vdataemissao            date;
                  vdataentrega            date;
                  vdatadespacho           date;
                  vdatacancelamento       date;
                  vvalortotal             number;
                  vvalorpontoutilizado    number;
                  vvalordesconto          number;
                  vvalortotalcomdesconto  number;
                  vvalorfrete             number;
                  vvalorapagar            number :=0 ;
                  vqtditens               number;
                  vtipopedido             varchar2(1) := 'P';
                  --
                  vidformapagamento   number;
                  vidformaentrega     number;
                  --  
                  vidpedido   number := :P415_IDPEDIDO;
                  vidusuario  number := :P0_IDUSUARIO;
                  --
                  vidclassificacaopedido  number := 0;
                  vdataclassificado       date := sysdate;
                  vidcaracteristicapedido number := 56;
                  vidvalorcaracteristica  number;
                  vobservacao             varchar2(1000);
                  --
                begin
                  --
                  vdataemissao      := to_date(:P415_DATAEMISSAO     ,'DD/MM/RRRR HH24:MI:SS');
                  vdataentrega      := to_date(:P415_DATAENTREGA     ,'DD/MM/RRRR');
                  vdatadespacho     := to_date(:P415_DATADESPACHO    ,'DD/MM/RRRR HH24:MI:SS');
                  vdatacancelamento := to_date(:P415_DATACANCELAMENTO,'DD/MM/RRRR HH24:MI:SS');
                  --
                  vvalortotal             := to_number(:P415_VALORTOTAL            ,'999G999G999G990D00');   
                  vvalorpontoutilizado    := to_number(:P415_VALORPONTOUTILIZADO   ,'999G999G999G990D00');
                  vvalordesconto          := to_number(:P415_VALORDESCONTO         ,'999G999G999G990D00');
                  --
                  vvalortotalcomdesconto  := to_number(:P415_VALORTOTALCOMDESCONTO ,'999G999G999G990D00');
                  --
                  -- ZERAR FRETE
                  --
                  --if v('REQUEST') = 'ZERARFRETE' then
                  --  vvalorfrete := 0;
                  --else
                    vvalorfrete             := to_number(:P415_VALORFRETE            ,'999G999G999G990D00');
                  --end if;
                  --
                  --EMESPERA
                  --
                  if v('REQUEST') = 'EMESPERA' then
                    :P415_EMESPERA := 'S';
                  elsif v('REQUEST') = 'EMATENDIMENTO' then
                    :P415_EMESPERA := 'N';
                  end if;
                  --
                  --vvalorapagar            := 0;--to_number(:P415_VALORAPAGAR           ,'999G999G999G990D00');
                  --
                  if v('REQUEST') = 'ZERARFRETE' then
                    pck_pedidos_fav.prc_classificacoespedidos(pidclassificacaopedido => vidclassificacaopedido,
                                                              pidpedido => :P415_IDPEDIDO,
                                                              pdataclassificado => vdataclassificado,
                                                              pidusuario => :P0_IDUSUARIO,
                                                              pidcaracteristicapedido => vidcaracteristicapedido,
                                                              pidvalorcaracteristica => vidvalorcaracteristica,
                                                              pobservacao => vobservacao,
                                                              poperacao_dml => 'I',
                                                              pmd5 => :P415_MD5);
                  end if;
                  --
                  pck_pedidos_fav.prc_pedidos( pidpedido                 => :P415_IDPEDIDO
                                             , pidedicaorevista          => :P415_IDEDICAOREVISTA
                                             , pidsituacaoentrega        => :P415_IDSITUACAOENTREGA
                                             , pidsituacaofinanceiro     => :P415_IDSITUACAOFINANCEIRO
                                             , pidsituacaocobranca       => :P415_IDSITUACAOCOBRANCA
                                             , pidfilialromance          => :P415_IDFILIALROMANCE
                                             , pidfilialfavorita         => :P415_IDFILIALFAVORITA
                                             , pidgerente                => :P415_IDGERENTE
                                             , pidrepresentante          => :P415_IDREPRESENTANTE
                                             , pidvendedora              => :P415_IDVENDEDORA
                                             , pidusuario                => :P415_IDUSUARIO
                                             , pnumeropedido             => :P415_NUMEROPEDIDO
                                             , pdataemissao              => vdataemissao     --:P415_DATAEMISSAO
                                             , pdataentrega              => vdataentrega     --:P415_DATAENTREGA
                                             , pdatadespacho             => vdatadespacho    --:P415_DATADESPACHO
                                             , pdatacancelamento         => vdatacancelamento--:P415_DATACANCELAMENTO
                                             , pnumeroposicaoatendimento => :P415_NUMEROPOSICAOATENDIMENTO
                                             , pidpedidooriginal         => :P415_IDPEDIDOORIGINAL
                                             , prastreiotransporte       => :P415_VASTREIOTRANSPORTE
                                             , pvalortotal               => vvalortotal            --:P415_VALORTOTAL
                                             , pvalorpontoutilizado      => vvalorpontoutilizado   --:P415_VALORPONTOUTILIZADO
                                             , pvalordesconto            => vvalordesconto         --:P415_VALORDESCONTO
                                             , pvalortotalcomdesconto    => vvalortotalcomdesconto --:P415_VALORTOTALCOMDESCONTO
                                             , pvalorfrete               => vvalorfrete            --:P415_VALORFRETE
                                             , pvalorapagar              => vvalorapagar           --:P415_VALORAPAGAR
                                             , pemespera                 => :P415_EMESPERA
                                             , pedicaobloqueada          => :P415_EDICAOBLOQUEADA
                                             , ptipopedido               => vtipopedido 
                                             , pidnegociadoraresponsavel => :P415_IDNEGOCIADORARESPONSAVEL
                                             , pmd5                      => :P415_MD5
                                             , poperacao_dml             => 'U');
                  --
                  pck_pedidos_fav.prc_calculapedido( pidpedido      => vidpedido
                                                   , pvalortotal    => vvalortotal
                                                   , pvalorpontos   => vvalorpontoutilizado
                                                   , pvalorfrete    => vvalorfrete
                                                   , pvalordesconto => vvalordesconto
                                                   , pvalorapagar   => vvalorapagar
                                                   , pqtditens      => vqtditens);
                  --
                  select idvalorcaracteristica
                  into vidformaentrega
                  from classificacoespedidos
                  where idpedido               = vidpedido
                    and idcaracteristicapedido = 13;-- entrega
                  --
                  select idvalorcaracteristica
                  into vidformapagamento
                  from classificacoespedidos
                  where idpedido               = vidpedido
                    and idcaracteristicapedido = 8;
                  --
                  pck_pedidos_fav.prc_gerafinanceiropedido( pidpedido         => vidpedido
                                                          , pidusuario        => vidusuario
                                                          , pidformapagamento => vidformapagamento
                                                          , pidformaentrega   => vidformaentrega
                                                          , pvalorapagar      => vvalorapagar
                                                          , pqtdparcelas      => null
                                                          , penviooperadora   => null
                                                          , pretornooperadora => null
                                                          , pdatavencimento   => null);
                  --
                end;
                ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Atualizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1603074191224752978
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SALVARPEDIDO,ZERARFRETE,EMESPERA,EMATENDIMENTO
        }
    )

    process caracterisiticas-cobrança (
