                        and pp.idpedido = :P415_IDPEDIDO)  = 1
                ```
        }
    )

    button integracao-homologacao (
        buttonName: INTEGRACAO_HOMOLOGACAO
        label: Integrar Pedido HML
        layout {
            sequence: 130
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--success
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-exchange
        }
        behavior {
            action: redirectUrl
            targetUrl: "javascript: AtivarIntegracaoVirtualAgeHML(function(x){console.log(x)})"
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vhostname   varchar2(100);
                  vacessoliberado varchar2(1);
                  vintegrado varchar2(1);
                begin
                  --
                  select sys_context('USERENV','SERVER_HOST') 
                  into vhostname
                  from dual;
                  --
                  select pck_util_fav.fnc_verificaacesso (28333, :P0_IDUSUARIO) acessoliberado
                  into vacessoliberado
                  from dual;
                  --
                  begin
                    --
                    select 'S'
                    into vintegrado
                    from classificacoespedidos c
                    where c.idpedido = :P415_IDPEDIDO
                      and c.idcaracteristicapedido = 43;
                    --
                  exception
                    when others then
                      vintegrado := 'N';
                  end;
                  --
                  -- HOMOLOGAÇÃO
                  if vhostname = 'srvbd02' and vacessoliberado = 'S' and vintegrado = 'N' then
                    return true;
                  -- PRODUÇÃO
                  elsif vhostname = 'srvbd01' then
                    return false;
                  end if;
                  --
                end;
                ```
        }
    )

    button integracao-producao (
        buttonName: INTEGRACAO_PRODUCAO
        label: Integrar Pedido
        layout {
            sequence: 170
