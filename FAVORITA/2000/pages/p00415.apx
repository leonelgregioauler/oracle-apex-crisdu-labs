    process fetch-row (
        name: Fetch Row
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidpedidoadapto         number;
                  vdataemissao            date;
                  vdataentrega            date;
                  vdatadespacho           date;
                  vdatacancelamento       date;
                  vvalortotal             number;
                  vvalorpontoutilizado    number;
                  vvalordesconto          number;
                  vvalortotalcomdesconto  number;
                  vvalorfrete             number;
                  vvalorapagar            number;
                  vfeitopelodistribuidor  varchar2(1);
                  --
                  vdocumento         varchar2(100);
                  vemail             varchar2(100);
                  vsenha             varchar2(100);
                  vretorno           varchar2(100);
                  vidpessoa          number;
                  vidvendedora       number;
                  vidrepresentante   number;
                  vidfilial          number;
                  vedicoesrevista    varchar2(100);
                  vqtddebitos        number(15,2);
                  vvlrlimiteped      number(15,2);
                  vvlrlimiteminimo   number(15,2);
                  vpontosdisp        number(15,2);
                  vvlrmaximoped      number(15,2);
                  vatendenteloja     varchar2(100);
                  vidfilialfavorita  number;
                  vidusuario         number;
                  vtipospagamentos   varchar2(100);
                  vtiposentregas     varchar2(100);
                  vmensagem          varchar2(100);
                  vidpedido          number;
                  vidpais            number;
                  vliberafazerpedido varchar2(100);
                  vdescontoextra     number;
                  vvalorpendente     number;
                  vparticipacampanha varchar2(1) := 'N';
                  --
                  vexiste            number;
                  vparcelas          number;
                  vidformapagto      number;
                  vtotaldescontoADL  number;
                  vADLaplicado       varchar2(1);
                  vpedidorepres      varchar2(1); -- Pedido de representante: Sim | Não
                  vpedidoEcomm       varchar2(1); -- Pedido eCommerce         Sim | Não
                  --
                begin
                  --
                  vvalortotalcomdesconto := 0 ;
                  vvalorapagar           := 0 ;
                  vvalorpendente         := 0 ;
                  PCK_INTEGRACAO_ECOMMERCE_V2.prc_pedidos( pidpedido                 => :P415_IDPEDIDO
                                                         , pidpedidoadapto           => vidpedidoadapto
                                                         , pidedicaorevista          => :P415_IDEDICAOREVISTA
                                                         , pidsituacaoentrega        => :P415_IDSITUACAOENTREGA
                                                         , pidsituacaofinanceiro     => :P415_IDSITUACAOFINANCEIRO
                                                         , pidsituacaocobranca       => :P415_IDSITUACAOCOBRANCA
                                                         , pidfilialromance          => :P415_IDFILIALROMANCE
                                                         , pidfilialfavorita         => :P415_IDFILIALFAVORITA
                                                         , pidgerente                => :P415_IDGERENTE
                                                         , pidrepresentante          => :P415_IDREPRESENTANTE
                                                         , pidvendedora              => :P415_IDVENDEDORA
                                                         , pidusuario                => :P415_IDUSUARIO
                                                         , pnumeropedido             => :P415_NUMEROPEDIDO
                                                         , pdataemissao              => vdataemissao     --:P415_DATAEMISSAO
                                                         , pdataentrega              => vdataentrega     --:P415_DATAENTREGA
                                                         , pdatadespacho             => vdatadespacho    --:P415_DATADESPACHO
                                                         , pdatacancelamento         => vdatacancelamento--:P415_DATACANCELAMENTO
                                                         , pnumeroposicaoatendimento => :P415_NUMEROPOSICAOATENDIMENTO
                                                         , pidpedidooriginal         => :P415_IDPEDIDOORIGINAL
                                                         , prastreiotransporte       => :P415_RASTREIOTRANSPORTE
                                                         , pvalortotal               => vvalortotal            --:P415_VALORTOTAL
                                                         , pvalorpontoutilizado      => vvalorpontoutilizado   --:P415_VALORPONTOUTILIZADO
                                                         , pvalordesconto            => vvalordesconto         --:P415_VALORDESCONTO
                                                         , pvalortotalcomdesconto    => vvalortotalcomdesconto --:P415_VALORTOTALCOMDESCONTO
                                                         , pvalorfrete               => vvalorfrete            --:P415_VALORFRETE
                                                         , pvalorapagar              => vvalorapagar           --:P415_VALORAPAGAR
                                                         , pemespera                 => :P415_EMESPERA
                                                         , pedicaobloqueada          => :P415_EDICAOBLOQUEADA
                                                         , ptipopedido               => :P415_TIPOPEDIDO
                                                         , pidnegociadoraresponsavel => :P415_IDNEGOCIADORARESPONSAVEL
                                                        -- , pfeitopelodistribuidor    => vfeitopelodistribuidor
                                                         , pmd5                      => :P415_MD5
                                                         , poperacao_dml             => 'S');
                  --
                  -- busca valor pendente (este campo era calculado no source do item. foi colocado aqui para melhor organizacao da tela.)
                  begin
                    select sum(v.valorpagar - v.valorpago)
                      into vvalorpendente
                      from vencimentospedidos v
                     where idpedido = :P415_IDPEDIDO
                       and v.situacaovencimento in ('V')
                       and exists ( select 1
                                      from pedidos p
                                     where p.idpedido = v.idpedido 
                                       and ( p.tipopedido = 'P' or
                                             p.tipopedido = 'T' or
                                             p.tipopedido = 'F' or
                                             p.tipopedido = 'V' and
                                             p.valorapagar > 0 ) )  ;
                  exception 
                    when others then vvalorpendente := 0;
                  end;
                  --
                  --
                  --------------------------------- incluso em 24/07
                  vADLaplicado := 'N';
                  begin
                    select 'S'
                      into vADLaplicado
                      from itenspedidos
                     where idpedido = :P415_IDPEDIDO
                       and perccomissaoconsultora = 30;
                  exception
                    when others then null;
                  end;
                  --
                  vdescontoextra := 0;
                  begin
                    select idvalorcaracteristica
                      into vdescontoextra 
                      from classificacoespedidos
                       where idpedido = :P415_IDPEDIDO
                         and idcaracteristicapedido = 106;
                  exception
                   when others then vdescontoextra := 0;
                  end;
                  vtotaldescontoADL := vdescontoextra;
                  --
                  vpedidoEcomm := 'N';
                  begin
                    select 'S'
                      into vpedidoEcomm 
                      from classificacoespedidos
                       where idpedido = :P415_IDPEDIDO
                         and idcaracteristicapedido = 79;
                  exception
                   when others then vpedidoEcomm := 'N';
                  end;
                  --
                  --
                  -- busca quantidade de parcelas
                  begin
                    select count(*)
                      into vparcelas
                      from vencimentospedidos
                     where idpedido = :P415_IDPEDIDO
                       and situacaovencimento = 'V';
                  exception
                    when others then null;
                  end;
                  --
                  begin
                    select idvalorcaracteristica
                      into vidformapagto
                      from classificacoespedidos
                     where idpedido = :P415_IDPEDIDO
                       and idcaracteristicapedido = 8;
                  exception
                      when others then null;
                  end;
                  --
                  --
                  if vADLaplicado = 'S' and vpedidoEcomm = 'N' then
                    vvalortotalcomdesconto := vvalortotalcomdesconto + vdescontoextra;
                  end if;
                  --
                  if nvl(vexiste,0) = 1 then
                    vdescontoextra := 0;
                  end if;
                  --
                  if vidformapagto in (1,26,27,34,36,37,43) and vADLaplicado = 'N' then -- boletos
                    begin
                      --
                      select count(1) * (vdescontoextra / vparcelas),
                             1
                        into vdescontoextra,
                             vexiste
                        from favorita.vencimentospedidos v
                       where v.idpedido = :P415_IDPEDIDO
                         and v.valorpago = 0 
                         and v.situacaovencimento = 'V';
                         --and vADLaplicado = 'N';
                    exception
                      when others then null;
                    end;
                  end if;
                  --
                  vvalorapagar           := vvalorapagar           - nvl(vdescontoextra,0);
                  if vvalorapagar < 0 then
                    vvalorapagar := 0;
                  end if;
                  --
                  if vvalorpendente > 0 then
                    vvalorpendente         := vvalorpendente         - nvl(vdescontoextra,0); 
                  elsif vvalorpendente < 0 then
                    vvalorpendente := 0;
                  end if;
                  --------------------------------- 
                  --
                  :P415_DATAEMISSAO      := to_char(vdataemissao     ,'DD/MM/RRRR HH24:MI:SS');
                  :P415_DATAENTREGA      := to_char(vdataentrega     ,'DD/MM/RRRR');
                  :P415_DATADESPACHO     := to_char(vdatadespacho    ,'DD/MM/RRRR HH24:MI:SS');
                  :P415_DATACANCELAMENTO := to_char(vdatacancelamento,'DD/MM/RRRR HH24:MI:SS');
                  --
                  :P415_VALORTOTAL             := to_char(vvalortotal            ,'999G999G999G990D00');   
                  :P415_VALORPONTOUTILIZADO    := to_char(vvalorpontoutilizado   ,'999G999G999G990D00');
                  :P415_VALORDESCONTO          := to_char(vvalordesconto         ,'999G999G999G990D00');
                  :P415_VALORTOTALCOMDESCONTO  := to_char(vvalortotalcomdesconto ,'999G999G999G990D00');
                  :P415_VALORFRETE             := to_char(vvalorfrete            ,'999G999G999G990D00');
                  :P415_VALORAPAGAR            := to_char(vvalorapagar           ,'999G999G999G990D00');
                  :P415_VALORDESCONTOEXTRA     := to_char(vdescontoextra         ,'999G999G999G990D00');
                  :P415_VALORPENDENTE          := to_char(vvalorpendente         ,'999G999G999G990D00');
                  --
                  select nvl(cpf, documentoestrangeiro)
                       , p.senhasite 
                       , p.idpessoa
                  into vdocumento            
                     , vsenha      
                     , :P415_IDPESSOA
                  from pessoas p
                     , vendedoras v
                  where v.idpessoa     = p.idpessoa
                    and v.idvendedora  = :P415_IDVENDEDORA;
                  --
                  pck_controle_fav.prc_login( pdocumento         => vdocumento
                                            , pemail             => vemail
                                            , psenha             => vsenha
                                            , pretorno           => vretorno
                                            , pidpessoa          => vidpessoa
                                            , pidvendedora       => vidvendedora
                                            , pidrepresentante   => vidrepresentante
                                            , pidfilial          => vidfilial
                                            , pedicoesrevista    => vedicoesrevista
                                            , pqtddebitos        => vqtddebitos
                                            , pvlrlimiteped      => vvlrlimiteped
                                            , pvlrlimiteminimo   => vvlrlimiteminimo
                                            , ppontosdisp        => vpontosdisp
                                            , pvlrmaximoped      => vvlrmaximoped
                                            , patendenteloja     => vatendenteloja
                                            , pidfilialfavorita  => vidfilialfavorita
                                            , pidusuario         => vidusuario
                                            , ptipospagamentos   => vtipospagamentos
                                            , ptiposentregas     => vtiposentregas
                                            , pmensagem          => vmensagem
                                            , pidpedido          => vidpedido
                                            , pidpais            => vidpais
                                            , pliberafazerpedido => vliberafazerpedido );
                  --
                  begin
                    --
                    select nvl(sum(itp.valorvenda * itp.quantidade),0)
                    into :P415_VALORTOTALINDISPONIVEL
                    from favorita.itensindisponiveispedidos itp
                    where itp.idpedido = :P415_IDPEDIDO;
                    --
                  exception
                    when others then 
                      :P415_VALORTOTALINDISPONIVEL := 0;
                  end;
                  --
                  begin
                    select 'S'
                    into :P415_CANCELADO
                    from classificacoespedidos c
                    where c.idcaracteristicapedido = 25
                      and c.idpedido = :P415_IDPEDIDO;
                    --
                    :P415_EDICAOBLOQUEADA := 'S';
                    --
                  exception
                    when others then
                      :P415_CANCELADO := 'N';
                  end;
                  --
                  null;
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 1603077346954752981
        }
    )

