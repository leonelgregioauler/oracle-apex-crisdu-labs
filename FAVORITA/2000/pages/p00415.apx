    pageItem P415_SESSION_INTEGRAR (
        type: hidden
        layout {
            sequence: 450
            region: @pedido
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_url varchar2(2000);
                    l_app number := 2000;
                    l_session number := v('APP_SESSION');
                BEGIN
                    l_url := APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p=' || l_app || ':202:'||l_session||'::NO::P202_IDPEDIDO:'||:P415_IDPEDIDO,
                        p_checksum_type => 'SESSION');
                    
                    return l_url;
                END;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P415_SESSION_RECIBO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 430
            region: @pedido
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_url varchar2(2000);
                    l_app number := 2000;
                    l_session number := v('APP_SESSION');
                BEGIN
                    l_url := APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p=' || l_app || ':221:'||l_session||'::NO::P221_IDPEDIDO:'||:P415_IDPEDIDO,
                        p_checksum_type => 'SESSION');
                    
                    return l_url;
                END;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

