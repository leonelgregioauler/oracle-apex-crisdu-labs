                t-Button--stretch
            ]
            icon: fa-exchange
        }
        behavior {
            action: redirectUrl
            targetUrl: "javascript: AtivarIntegracaoVirtualAgePRD(function(x){console.log(x)})"
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vhostname       varchar2(100);
                  vacessoliberado varchar2(1);
                  vintegrado      varchar2(1);
                begin
                  --
                  select sys_context('USERENV','SERVER_HOST') 
                  into vhostname
                  from dual;
                  --
                  select pck_util_fav.fnc_verificaacesso (28333, :P0_IDUSUARIO) acessoliberado
                  into vacessoliberado
                  from dual;
                  --
                  begin
                    --
                    select 'S'
                    into vintegrado
                    from classificacoespedidos c
                    where c.idpedido = :P415_IDPEDIDO
                      and c.idcaracteristicapedido = 43;
                    --
                  exception
                    when others then
                      vintegrado := 'N';
                  end;
                  --
                  -- HOMOLOGAÇÃO
                  if vhostname = 'srvbd02' then
                    return false;
                  -- PRODUÇÃO
                  elsif vacessoliberado = 'S' and vintegrado = 'N' then
                    return true;
                  end if;
                  --
                end;
                ```
        }
    )

