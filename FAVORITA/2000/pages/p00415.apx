            plsqlCode:
                ```plsql
                declare
                  vtipoetiqueta    varchar2(10);
                begin
                  --
                  delete classificacoespedidos c
                  where c.idpedido = :P415_IDPEDIDO
                    and c.idcaracteristicapedido = 10;
                  --
                  delete etiquetasfavorita e
                  where e.idpedido = :P415_IDPEDIDO;
                  --
                  if :P415_TIPOETIQUETATODAS = 'T' then
                    vtipoetiqueta := 'T';
                  elsif :P415_TIPOETIQUETA != 'T' then
                    vtipoetiqueta := :P415_TIPOETIQUETA;
                  end if;
                  --
                  pck_etiquetas.prc_imprimeetiquetaspedido(pidpedido     => :P415_IDPEDIDO,
                                                           pididioma     => :P0_IDIDIOMA,
                                                           pidusuario    => :P0_IDUSUARIO,
                                                           ptipoetiqueta => vtipoetiqueta,
                                                           pquantidade   => :P415_QUANTIDADE,
                                                           pdestino      => :P415_DESTINO );
                  --
                end;
                ```
