    process desfaz-envio-para-cobrança-terceirizada (
        name: Desfaz envio para Cobrança Terceirizada
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidclassificacaopedido  number;
                  vidpedido               number := :P415_IDPEDIDO;
                  vdataclassificado       date := sysdate;
                  vidusuario              number := :P0_IDUSUARIO;
                  vidcaracteristicapedido number := 88;
                  vidvalorcaracteristica  number := :P415_IDMOTIVOLIBERACAO;
                  vobservacao             varchar2(1000);
                  vmd5                    varchar2(1000);
                  --
                begin
                  --
                  insert into historicospedidos ( idhistoricopedido
                                                , idpedido
                                                , datahistorico
                                                , idusuario
                                                , descricao
                                                , imprimirnopedido
                                                , liberaedicao
                                                , liberamontagem )
                  select seq_idhistoricopedido.nextval
                       , :P68_IDPEDIDO
                       , cc.dataclassificado
                       , cc.idusuario
                       , 'Pedido enviado para cobrança terceirizada'
                       , 'N'
                       , 'N'
                       , 'N'
                  from classificacoespedidos cc
                  where cc.idpedido = :P68_IDPEDIDO
                    and cc.idcaracteristicapedido = 77;
                  --
                  commit;
                  --
                  delete classificacoespedidos cp
                  where cp.idcaracteristicapedido = 77
                    and cp.idpedido = :P415_IDPEDIDO;
                  --
                  pck_pedidos_fav.prc_classificacoespedidos( pidclassificacaopedido  => vidclassificacaopedido,
                                                             pidpedido               => vidpedido,
                                                             pdataclassificado       => vdataclassificado,
                                                             pidusuario              => vidusuario,
                                                             pidcaracteristicapedido => vidcaracteristicapedido,
                                                             pidvalorcaracteristica  => vidvalorcaracteristica,
                                                             pobservacao             => vobservacao,
                                                             poperacao_dml           => 'I',
                                                             pmd5                    => vmd5);
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 380
        }
        successMessage {
            successMessage: Envio desfeito com sucesso!
        }
        advanced {
            executionMappingIdentifier: 5852826039791644432
