    pageItem P415_CODIGO_LIBERACAO (
        type: textField
        label {
            label: Cod. Liberação
            alignment: left
        }
        layout {
            sequence: 60
            region: @pedido
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vcodigo number;
                begin
                  --
                  vcodigo := pck_pedidos_fav.fnc_retornacodigoliberacao(:P415_IDPEDIDO);
                  --
                  return vcodigo;
                  --
                end;
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from vencimentospedidos v
                where v.idpedido = :P415_IDPEDIDO
                  and ( exists ( select 1
                                 from pagamentospedidos pg
                                 where pg.idvencimentopedido = v.idvencimentopedido
                                   and pg.idsituacao != -1
                                   and pg.valorpago > 0 )
                     or exists ( select 1
                                 from pagamentospedidos pg
                                 where pg.idvencimentopedido = v.idvencimentopedido
                                   and pg.idsituacao != -1
                                   and pg.origempagamento = 'C') )
                  and exists ( SELECT 1
                               FROM DUAL
                               WHERE :P415_IDSITUACAOENTREGA >= 20000
                                 AND NOT EXISTS ( SELECT 1
                                                  FROM CLASSIFICACOESPEDIDOS C
                                                  WHERE C.IDPEDIDO = :P415_IDPEDIDO
                                                    AND C.IDCARACTERISTICAPEDIDO = 25 ) )
                ```
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

