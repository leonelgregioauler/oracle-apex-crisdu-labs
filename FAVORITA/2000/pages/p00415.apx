        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                pck_util_fav.fnc_verificaacesso(pidaplicacao => 75012, pidusuario => :P0_IDUSUARIO) = 'S'
                and ( select 1
                      from vendedoras v
                         , pessoas p
                         , pedidos pp
                      where p.idpessoa = v.idpessoa
                        and v.idvendedora = pp.idvendedora
