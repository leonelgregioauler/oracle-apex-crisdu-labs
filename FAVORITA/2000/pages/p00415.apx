    process aprovar-pedido (
        name: Aprovar Pedido - .300
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidclassificacaopedido number;
                  vidpedido number := :P415_IDPEDIDO;             
                  vdataclassificado date := sysdate;   
                  vidusuario number := :P0_IDUSUARIO;            
                  vidcaracteristicapedido number := 86;
                  vidvalorcaracteristica number;
                  vobservacao varchar2(1000);            
                  vmd5 varchar2(1000);         
                begin
                  --
                  pck_virtualage_fav.prc_operacao_fiscal(id_pedido => :P415_IDPEDIDO);
                  --
                  -- atualiza situações entrega e financeiro
                  pck_movimentarpedidos_fav.prc_atz_entrega_financ_auto( pidpedido  => :P415_IDPEDIDO
                                                                       , pidusuario => :P0_IDUSUARIO);
                  --
                  pck_pedidos_fav.prc_classificacoespedidos(pidclassificacaopedido  => vidclassificacaopedido,
                                                            pidpedido               => vidpedido,
                                                            pdataclassificado       => vdataclassificado,
                                                            pidusuario              => vidusuario,
                                                            pidcaracteristicapedido => vidcaracteristicapedido,
                                                            pidvalorcaracteristica  => vidvalorcaracteristica,
                                                            pobservacao             => vobservacao,
                                                            poperacao_dml           => 'I',
                                                            pmd5                    => vmd5);
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Pedido aprovado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1603072925466752977
        }
        serverSideCondition {
            type: request=Value
            value: APROVARPEDIDO
        }
    )

    process aprovar-pedido-informando-remessa (
        name: Aprovar Pedido informando Remessa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidtipo number;
                begin
                  --
                  pck_virtualage_fav.prc_operacao_fiscal(id_pedido => :P415_IDPEDIDO);
                  --
                  select idvalorcaracteristica
                  into vidtipo
                  from classificacoespedidos
                  where idpedido = :P415_IDPEDIDO
                    and idcaracteristicapedido = 19;
                  --
                  if vidtipo = 3 then
                    --
                    pck_movimentarpedidos_fav.prc_aprovaranalisepedido(pidpedido => :P415_IDPEDIDO,
                                                                       pidusuario => :P0_IDUSUARIO);
                    --
                    pck_comprastransf_fav.prc_processomanualpedidos( pidcompratransferencia => :P415_IDCOMPRATRANSFERENCIA,
                                                                     ptipoprocesso          => 'A',
                                                                     pnumeropedido          => :P415_NUMEROPEDIDO,
                                                                     pidusuario             => :P0_IDUSUARIO );
                    --
                  elsif vidtipo = 2 then
                    --
                    pck_comprastransf_fav.prc_buscaitensremessa(pidcompratransferencia => :P415_IDCOMPRATRANSFERENCIA,
                                                                pidpedido  => :P415_IDPEDIDO,
                                                                pidusuario => :P0_IDUSUARIO);
                    --
                    -- atualiza situações entrega e financeiro
                    pck_movimentarpedidos_fav.prc_atz_entrega_financ_auto( pidpedido  => :P415_IDPEDIDO
                                                                         , pidusuario => :P0_IDUSUARIO );
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 60
        }
        successMessage {
            successMessage: Pedido Aprovado!
        }
        advanced {
            executionMappingIdentifier: 1603074968458752979
        }
        serverSideCondition {
            type: never
        }
    )

