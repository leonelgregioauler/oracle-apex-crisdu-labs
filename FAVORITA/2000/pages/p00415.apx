    process remover-cêdencia (
        name: Remover Cêdencia
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                
                 vidusuario number;
                
                begin
                  --
                  begin
                    --
                    select u.idusuario
                    into vidusuario
                    from catal.usuarios u
                    where u.usuario = v('APP_USER');
                    --
                    exception 
                     when no_data_found then 
                     vidusuario := null;
                    --
                  end;
                  --
                    delete favorita.classificacoespedidos cp
                    where cp.idpedido = :P415_IDPEDIDO
                      and cp.idcaracteristicapedido = 104;
                    --
                    insert into favorita.historicospedidos (idhistoricopedido,
                                                            idpedido,
                                                            datahistorico,
                                                            idusuario,
                                                            descricao,
                                                            imprimirnopedido,
                                                            liberaedicao,
                                                            liberamontagem)
                    values ( favorita.seq_idhistoricopedido.nextval
                           , :P415_IDPEDIDO
                           , sysdate
                           , vidusuario
                           , 'Cêdencia de Débito removido por: '|| v('APP_USER')
                           , 'N'
                           , null
                           , null);
                  --
                end;
                ```
        }
        execution {
            sequence: 430
        }
        advanced {
            executionMappingIdentifier: 1501175155745591008
        }
        serverSideCondition {
            whenButtonPressed: @remover-cedencia
        }
    )

