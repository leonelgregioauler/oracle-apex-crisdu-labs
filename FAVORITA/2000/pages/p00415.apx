            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuarios
                where usuario = v('APP_USER')
                  and idgerente in (80,180)
                  and :P415_IDPEDIDO is not null
                  and :P415_CANCELADO = 'N'
                ```
        }
    )

    pageItem P415_ALTURA (
        type: numberField
        label {
            label: Altura
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 40
            region: @reenviar-pedido-por-correio
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P415_APOIO_ANALISECREDITO (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 110
            region: @aviso
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<font color="blue"><b><h3>Esta consultora possui o total de '||( select c.idvalorcaracteristica
                                                                                         from classificacoespedidos c
                                                                                         where c.idpedido = :P415_IDPEDIDO 
                                                                                           and c.idcaracteristicapedido = 11 )
                       ||' pedidos e o valor de débitos no total de '||( select nvl(( select sum(v.saldodevedor)
                                                                                      from vw_pedidos_fav v
                                                                                      where idvendedora    = :P415_IDVENDEDORA
                                                                                        and ididioma       = :P0_IDIDIOMA
                                                                                        and v.idpedido     != :P415_IDPEDIDO
                                                                                        and v.tipopedido   = 'P'
                                                                                        and v.saldodevedor > 0)  ,0)
                                                                              + nvl(( select sum(c.saldodevedor)
                                                                                      from vw_pedidos_old c
                                                                                      where idvendedora    = :P415_IDVENDEDORA
                                                                                        and c.saldodevedor > 0.5 
                                                                                        and c.idsituacao != 'Q' ) ,0)
                                                                              + nvl(( select sum(t.saldodevedor)
                                                                                      from vw_pedidos_fav t
                                                                                      where idvendedora    = :P415_IDVENDEDORA
                                                                                        and ididioma       = :P0_IDIDIOMA
                                                                                        and t.idpedido     != :P415_IDPEDIDO
                                                                                        and t.tipopedido   = 'T'
                                                                                        and t.valorapagar  > 0
                                                                                        and t.saldodevedor > 0) ,0)
                                                                  from dual )||'</font></b></h3>' aviso
                from dual
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM DUAL
                WHERE :P415_IDSITUACAOENTREGA = 20000
                  AND NOT EXISTS ( SELECT 1
                                   FROM CLASSIFICACOESPEDIDOS C
                                   WHERE C.IDPEDIDO = :P415_IDPEDIDO
                                     AND C.IDCARACTERISTICAPEDIDO = 25 )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P415_AVISOCANCELADO (
        type: displayOnly
        label {
            label: ->
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 50
            region: @aviso
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: staticValue
            staticValue: <font color="red" size="6">Pedido cancelado!</font>
        }
        serverSideCondition {
            type: item=value
            item: P415_CANCELADO
            value: S
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P415_AVISO_EDITANDO (
        type: displayOnly
        label {
            label: Atenção:
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 70
            region: @aviso
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: staticValue
            staticValue: <font color="red"> Este pedido está sendo editado! </font>
