    process remove-situação-cobrança (
        name: Remove situação cobrança
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidsituacaocobranca number;
                  vidcaracteristica number;
                  vidvalor number;
                  vidclassificacao number;
                  vdata date := sysdate;
                  vobservacao varchar2(1000);
                  vmd5 varchar2(1000);
                begin
                  --
                  if v('REQUEST') = 'DESFAZER_ENVIAR_SPC' then
                    vidcaracteristica := 44;
                  elsif  v('REQUEST') = 'DESFAZER_ENVIAR_DOCUMENTACAO' then
                    vidcaracteristica := 45;
                  elsif  v('REQUEST') = 'DESFAZER_INCOBRAVEL' then
                    vidcaracteristica := 46;
                  end if;
                  --
                  vidsituacaocobranca := 50;
                  --
                  --
                  if v('REQUEST') = 'DESFAZER_ENVIAR_SPC' then
                    --
                    update vendedoras v
                    set spc = 'N'
                    where v.idvendedora = :P415_IDVENDEDORA;
                    --
                  end if;
                  --
                  -- Call the procedure
                  pck_movimentarpedidos_fav.prc_atualizasituacaocobranca(pidpedido => :P415_IDPEDIDO,
                                                                         pidsituacao => vidsituacaocobranca,
                                                                         pidusuario => :P0_IDUSUARIO);
                  --
                  select idclassificacaopedido
                  into vidclassificacao
                  from classificacoespedidos c
                  where c.idpedido = :P415_IDPEDIDO
                    and c.idcaracteristicapedido = vidcaracteristica;
                  --
                  pck_pedidos_fav.prc_classificacoespedidos(pidclassificacaopedido => vidclassificacao,
                                                            pidpedido => :P415_IDPEDIDO,
                                                            pdataclassificado => vdata,
                                                            pidusuario => :P0_IDUSUARIO,
                                                            pidcaracteristicapedido => vidcaracteristica,
                                                            pidvalorcaracteristica => vidvalor,
                                                            pobservacao => vobservacao,
                                                            poperacao_dml => 'D',
                                                            pmd5 => vmd5);
                  --
                end;
                
                ```
        }
        execution {
            sequence: 230
        }
        successMessage {
            successMessage: Situação Cobrança desfeita com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1603079735725752983
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('DESFAZER_ENVIAR_SPC','DESFAZER_ENVIAR_DOCUMENTACAO','DESFAZER_INCOBRAVEL') 
                ```
        }
    )

    process remove-tarefa-análise-de-crédito (
        name: Remove Tarefa Análise de Crédito
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidtarefa number;
                begin
                  --
                  select idtarefa 
                  into vidtarefa
                  from tarefas t
                     , vendedoras v
                  where t.idpessoa = v.idpessoa
                    and t.idtipotarefa = 29
                    and t.idsituacao = 0
                    and v.idvendedora = :P415_IDVENDEDORA;
                  --
                  delete historicostarefas h
                  where h.idtarefa = vidtarefa;
                  --
                  delete tarefas t
                  where t.idtarefa = vidtarefa;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 350
        }
        successMessage {
            successMessage: Tarefa removida com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1603085311667752986
        }
        serverSideCondition {
            type: request=Value
            value: REMOVER_TAREFA
        }
    )

