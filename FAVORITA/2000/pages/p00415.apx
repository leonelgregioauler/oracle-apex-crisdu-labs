                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction consulta-dados-da-entrega-correio (
        name: Consulta Dados da Entrega Correio
        execution {
            sequence: 120
        }
        when {
            event: focusout
            selectionType: items
            items: P415_CEPDESTINO
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    //var request = new XMLHttpRequest();
                    //request.open("GET", "http://ws.correios.com.br/calculador/CalcPrecoPrazo.aspx?sCepOrigem=70002900&sCepDestino=04547000&nVlPeso=1&nVlComprimento=20&nVlAltura=20&nVlLargura=20&nCdServico=04510&nVlDiametro=0&StrRetorno=xml", false);
                    //request.send();
                    //var xml = request.responseXML;
                    //var codigo = xml.getElementsByTagName("Codigo");
                    
                    vcepdestino    = $("#P415_CEPDESTINO")[0].value;
                    vpeso          = $("#P415_PESO")[0].value;
                    vprofundidade  = $("#P415_PROFUNDIDADE")[0].value;
                    vlargura       = $("#P415_LARGURA")[0].value;
                    valtura        = $("#P415_ALTURA")[0].value;
                    
                    vpeso          = parseFloat(vpeso);
                    vprofundidade  = parseFloat(vprofundidade);
                    vlargura       = parseFloat(vlargura);
                    valtura        = parseFloat(valtura);
                    
                    var dadosfrete = 'https://ws.catalogofavorita.com.br/executar/correios/calcular_frete?str={"CEP_ORIGEM":"95650000", "CEP_DESTINO":" '+vcepdestino+' ", "PESO_KG":'+vpeso+', "COMPRIMENTO_CM":'+vprofundidade+', "LARGURA_CM":'+vlargura+', "ALTURA_CM":'+valtura+'}'
                    var endereco   = 'https://viacep.com.br/ws/'+vcepdestino+'/json';
                    
                    function consultaFrete (data) {
                        
                       $("#P415_VALOR").val(data.valor);
                    
                      }
                      
                      $.getJSON(dadosfrete).done(consultaFrete);
                    
                    function consultaEndereco (data) {
                        
                       $("#P415_ENDERECO").val(data.logradouro + ', ' + data.bairro + ' - ' + data.localidade);
                    
                      }
                    
                      $.getJSON(endereco).done(consultaEndereco);
                    
                    
                    
                    
                    
                    
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

