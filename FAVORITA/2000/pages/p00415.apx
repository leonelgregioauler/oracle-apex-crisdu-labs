    pageItem P415_MENSAGEMRETORNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @características
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vempresavirtualage       varchar2(50);
                  vtipooperacao            varchar2(20);
                  vpresencial              varchar2(20);
                  vestado                  varchar2(20);
                begin
                  --
                  select nvl(initcap(ep.nome), 'Pedido não associado à empresa') as "Empresa",
                           case 
                             when p.valorapagar > 0 then
                               (select tp.nome
                               from tiposoperacoesfiscais tp
                               where tp.idtipooperacaofiscal = 1)
                             else
                               (select tp.nome
                               from tiposoperacoesfiscais tp
                               where tp.idtipooperacaofiscal = 2)
                           end as tipooperacao,
                           case 
                             when f.tipofilial = 'L' then
                               'Presencial'
                             else
                               'Não presencial'
                           end as presencial,  
                           pck_util_fav.fnc_retornanomeestado(pck_util_fav.fnc_retorna_idestado(v.idpessoa)) as idestado
                    into vempresavirtualage,
                         vtipooperacao,
                         vpresencial,
                         vestado
                    from pedidos p,
                         vendedoras v,
                         filiaisfavorita f,
                         empresasvirtualage ep
                    where p.idvendedora = v.idvendedora
                    and p.idfilialfavorita = f.idfilialfavorita
                    and p.idempresavirtualage = ep.idempresavirtualage(+)
                    and p.idpedido = :P415_IDPEDIDO; 
                  --
                  return 'Não encontrado operação fiscal para os seguintes parâmetros: Empresa: '||vempresavirtualage||', operação de '||vtipooperacao||' '||vpresencial||' para o estado:'||vestado||'. Contate o setor fiscal';
                  --
                exception
                  when others then
                    null;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

