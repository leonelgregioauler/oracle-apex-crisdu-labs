    region características (
        name: Características
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.idclassificacaopedido
                     , w.dataclassificado as "Data"
                     , w.usuario as "Usuário"
                     , w.caracteristica as "Caracteristica"
                     , w.descricao as "Decrição"
                     , w.observacao as "Observação"
                from vw_classificacoespedidos_fav w
                where idpedido = :P415_IDPEDIDO
                and ididioma = :P0_IDIDIOMA
                order by w.idclassificacaopedido
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM DUAL
                WHERE :P415_IDSITUACAOENTREGA >= 20000
                ```
        }
        reportLayout {
            numberOfRows: 1000
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--horizontalBorders
            ]
            showNullValuesAs: -
        }
        pagination {
            type: showAll
        }

