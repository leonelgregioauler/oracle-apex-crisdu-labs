    process confirmar-cod-rastreio (
        name: Confirmar Cod Rastreio
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidcaracteristica number := 52;
                  vidvalor number;
                  vidclassificacao number;
                  vdata date := sysdate;
                  vobservacao varchar2(1000) := :P415_CODIGO_RASTREIO;
                  vmd5 varchar2(1000);
                  vexiste varchar2(1);
                begin
                  --
                  begin
                    select 'S' 
                         , c.idclassificacaopedido
                    into vexiste
                       , vidclassificacao
                    from classificacoespedidos c
                    where c.idpedido = :P415_IDPEDIDO
                      and c.idcaracteristicapedido = 52;
                  exception
                    when others then
                      vexiste := 'N';
                  end;
                  --
                  if vexiste = 'S' then
                    --
                    pck_pedidos_fav.prc_classificacoespedidos(pidclassificacaopedido => vidclassificacao,
                                                              pidpedido => :P415_IDPEDIDO,
                                                              pdataclassificado => vdata,
                                                              pidusuario => :P0_IDUSUARIO,
                                                              pidcaracteristicapedido => vidcaracteristica,
                                                              pidvalorcaracteristica => vidvalor,
                                                              pobservacao => vobservacao,
                                                              poperacao_dml => 'D',
                                                              pmd5 => vmd5);
                    --
                    vidclassificacao := null;
                    --
                    pck_pedidos_fav.prc_classificacoespedidos(pidclassificacaopedido => vidclassificacao,
                                                              pidpedido => :P415_IDPEDIDO,
                                                              pdataclassificado => vdata,
                                                              pidusuario => :P0_IDUSUARIO,
                                                              pidcaracteristicapedido => vidcaracteristica,
                                                              pidvalorcaracteristica => vidvalor,
                                                              pobservacao => vobservacao,
                                                              poperacao_dml => 'I',
                                                              pmd5 => vmd5);
                    --
                  else
                    --
                    pck_pedidos_fav.prc_classificacoespedidos(pidclassificacaopedido => vidclassificacao,
                                                              pidpedido => :P415_IDPEDIDO,
                                                              pdataclassificado => vdata,
                                                              pidusuario => :P0_IDUSUARIO,
                                                              pidcaracteristicapedido => vidcaracteristica,
                                                              pidvalorcaracteristica => vidvalor,
                                                              pobservacao => vobservacao,
                                                              poperacao_dml => 'I',
                                                              pmd5 => vmd5);
                    --
                  end if;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 270
        }
        successMessage {
            successMessage: Código de Rastreio informado com Sucesso!
        }
        advanced {
            executionMappingIdentifier: 1603081341356752984
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMAR_RASTREIO
        }
    )

