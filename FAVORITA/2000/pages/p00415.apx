    process identifica-como-incobrável-pelo-call (
        name: Identifica como incobrável pelo Call
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  vidcaracteristica number := 59;
                  vidclassificacao  number;
                  vidvalor          number;
                  vobservacao       varchar2(1000);
                  vmd5              varchar2(1000);
                  vidpedido         number := :P415_IDPEDIDO;
