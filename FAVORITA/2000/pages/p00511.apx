page 511 (
    name: Cadastro de Tipo de Item SPED
    title: Cadastro de Tipo de Item SPED
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-de-tipo-de-item-sped (
        name: Cadastro de Tipo de Item SPED
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ee.idtipodeitemsped
                     , ee.descricao
                from favorita.TIPODEITEMSPED ee
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 116928630005469304
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDTIPODEITEMSPED
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @DESCRICAO
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column DESCRICAO (
            type: textarea
            heading {
                heading: Descrição
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: DESCRICAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column IDTIPODEITEMSPED (
            type: numberField
            heading {
                heading: Código Tipo de Item SPED
                alignment: center
            }
            settings {
                numberAlignment: center
                virtualKeyboard: text
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDTIPODEITEMSPED
                dataType: number
                primaryKey: true
            }
            columnFilter {
                lovType: none
            }
        )

    )

    region mensagem-retorno (
        name: Mensagem Retorno
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P511_RESPOSTA
        }
    )

    pageItem P511_RESPOSTA (
        type: textField
        label {
            label: Resposta
            alignment: left
        }
        layout {
            sequence: 10
            region: @mensagem-retorno
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    process cadastro-de-tipo-de-item-sped-save-interactive-grid-data (
        name: Cadastro de Tipo de Item SPED - Save Interactive Grid Data
        type: executeCode
        editableRegion: @cadastro-de-tipo-de-item-sped
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vmd5   varchar(4000);
                  vdml   varchar(2);
                  vmensagemerro varchar(4000);
                  --
                begin  
                     --
                     :P511_RESPOSTA := '';
                     --
                     case :APEX$ROW_STATUS  
                     when 'C' then
                       --
                       PCK_CADASTROS_FAV.prc_tipodeitemsped ( pidtipodeitemsped => :IDTIPODEITEMSPED
                                                            , pdescricao        => :DESCRICAO
                                                            , pmd5              => vmd5
                                                            , poperacao_dml     => 'I'
                                                            , pmensagemerro     => vmensagemerro);
                       --
                     when 'U' then  
                       --
                       PCK_CADASTROS_FAV.prc_tipodeitemsped ( pidtipodeitemsped => :IDTIPODEITEMSPED
                                                            , pdescricao        => :DESCRICAO
                                                            , pmd5              => vmd5
                                                            , poperacao_dml     => 'U'
                                                            , pmensagemerro     => vmensagemerro);
                       --
                     when 'D' then  
                       --
                       PCK_CADASTROS_FAV.prc_tipodeitemsped ( pidtipodeitemsped => :IDTIPODEITEMSPED
                                                            , pdescricao        => :DESCRICAO
                                                            , pmd5              => vmd5
                                                            , poperacao_dml     => 'D'
                                                            , pmensagemerro     => vmensagemerro);
                       --
                     end case;  
                     --
                     :P511_RESPOSTA := vmensagemerro;
                     --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 116929257660469310
        }
    )

)

