page 529 (
    name: Relatorio RemTransf
    title: Relatorio RemTransf
    appearance {
        pageTemplate: @minimal-pedido
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region impressão (
        name: Impressão
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidusuario number;
                  --
                begin
                  --
                  SELECT pck_util_fav.fnc_idusuario(v('APP_USER'))
                  into vidusuario
                  FROM DUAL;
                  --
                  pck_imprime_fav.prc_identificaVolRemTransf ( :P529_IDCOMPRATRANSFERENCIA , vidusuario );
                  --
                end;
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P529_IDCOMPRATRANSFERENCIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @impressão
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

