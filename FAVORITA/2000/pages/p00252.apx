page 252 (
    name: Notas Fiscais de Compras/Transferências
    title: Notas Fiscais de Compras/Transferências
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region notas-fiscais-de-compras-transferências (
        name: Notas Fiscais de Compras/Transferências
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.numero
                     , c.notafiscal
                     , case 
                        when c.idtipocomptransrem = 0 then
                          c.nomefornecedor
                        when c.idtipocomptransrem = 1 then
                          c.filialfavoritaorigem
                       end origem
                     , c.filialfavoritadestino
                     , c.situacao
                     , c.valortotalcompra
                     , c.dataemissao
                     , c.datarecebimento
                     , ATTACH_DATA
                     , ATTACH_MIMETYPE
                     , ATTACH_FILENAME
                     , ATTACH_LAST_UPDATE
                     , ATTACH_CHARSET
                     , round(sys.dbms_lob.getlength(ATTACH_DATA)/1024,2)||' kb' file_length
                     , sys.dbms_lob.getlength(ATTACH_DATA) download
                     , a.idanexocompratransferencia
                     , c.desctipo
                from anexoscomprastransferencias a
                   , vw_comprastransferencias_fav c
                where a.idcompratransferencia  = c.idcompratransferencia
                  and c.ididioma               = 1
                  and ( :P252_NOTAFISCAL is null or c.notafiscal like '%'||:P252_NOTAFISCAL||'%' )
                  and ( :P252_SITUACAO is null or c.idsituacao = :P252_SITUACAO )
                  and ( :P252_TIPO is null and c.idtipocomptransrem in (0,1) or c.idtipocomptransrem = :P252_TIPO )
                  and ( c.idfilialfavoritaorigem = :P0_IDFILIALFAVORITA
                    or c.idfilialfavoritadestino = :P0_IDFILIALFAVORITA )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado, verifique os filtros informados!
        }
        advanced {
            savedReportMappingIdentifier: 1739271313036160249
        }

        column ATTACH_CHARSET (
            type: hidden
            heading {
                heading: Attach charset
            }
            layout {
                sequence: 120
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: L
