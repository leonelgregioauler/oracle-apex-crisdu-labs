    region confirmar-devoluções-de-produtos (
        name: Confirmar Devoluções de Produtos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select if.iditemdevolucaopedido
                     , if.iditempedido
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||if.idpedido ,'SESSION')||''',''_blank''); void(0)">'||if.idpedido||'</a>' idpedido
                     , if.idproduto
                     , if.idprodutodetalhado
                     , if.nomeprodutodetalhado
                     , if.quantidade quantidade
                     , nvl(if.quantidadedevolvido,if.quantidade) quantidadedevolvido2
                     , if.quantidadedevolvido
                     , if.quantidadedefeito
                     , if.quantidadeavaria
                     , if.quantidadenaorecebida
                     , if.quantidadetrocado
                     , if.idprotocoloatendimento
                     , if.confirmacaoestoque
                     , if.dataconfirmacaoestoque
                     , if.usuarioestoque
                     , if.motivoprotocolo
                     , if.justificativa
                     , IF.defeito
                     --, '<a href="javascript: fnc_devolucaoavaria ('|| iditemdevolucaopedido ||');"><img src="#APP_IMAGES#ok.png"  border="0"></a>' confirmarrecebimento
                     , null confirmarrecebimento
                     , if.iddefeito
                     , if.codconfirmacaoestoque
                from vw_itensdevolucaopedidos_fav if
                where if.ididioma = :P0_IDIDIOMA
                  and situacaoprotocolo = 'C'
                  and idtipoprotocolo in (1)
                  and ( :P265_DEVOLUCAORECEBIDA is null or if.codconfirmacaoestoque = :P265_DEVOLUCAORECEBIDA )
                  and ( :P265_FILTRARDATA = 'N' or ( :P265_FILTRARDATA = 'S' and trunc(if.dataconfirmacaoestoque) between :P265_DATAINICIAL and :P265_DATAFINAL ) )
                  and exists ( select 1
                               from favorita.classificacoespedidos cp
                               where cp.idpedido = if.idpedido
                                 and cp.idcaracteristicapedido = 25)
                  and exists ( select 1
                               from atendimentosfiliaisrmc a
                               where a.idfilialdestino = ( select p.idfilialromance
                                                           from pedidos p
                                                           where p.idpedido = if.idpedido ) 
                                 and a.idfilialfavoritaorigem = pck_util_fav.fnc_retornaidfilialfavusuario(:P0_IDUSUARIO) ) 
                  and ( :P265_TIPOPESQUISA = 'PD' and if.idpedido = :P265_IDPEDIDO 
                     or :P265_TIPOPESQUISA = 'PP' and exists ( select 1
                                                               from protocolosatendimentos p
                                                               where p.idpedido = if.idpedido
                                                                 and p.idprotocoloatendimento = :P265_IDPROTOCOLOATENDIMENTO ) )
                order by idpedido desc , pck_util_fav.fnc_nomeproduto(if.idproduto,1,'N')
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
