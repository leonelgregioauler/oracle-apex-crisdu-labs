    process confirmar-todos-devolução (
        name: Confirmar Todos (Devolução)
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                   viditemdevolucaopedido   number;
                   vquantidadedevolucao     number;
                   vquantidadedefeito       number;
                   vquantidadeavaria        number;
                   vquantidadenaorecebida   number;
                   vidfilialromance         number;
                begin
                  --
                  for i in ( select *
                             from vw_itensdevolucaopedidos_fav if
                             where if.ididioma = 1
                             and if.codconfirmacaoestoque = 'N'
                             and ( if.idprotocoloatendimento = :P265_IDPROTOCOLOATENDIMENTO or if.idpedido = :P265_IDPEDIDO ) )
                  loop
                    pck_protocolosatendimentos_fav.prc_confirmarecebimentoproduto( piditemdevolucao           => i.iditemdevolucaopedido   
                                                                                 , pquantidadedevolvida       => i.quantidadedevolvido     
                                                                                 , pquantidadedefeito         => i.quantidadedefeito    
                                                                                 , piddefeito                 => i.iddefeito
                                                                                 , pquantidadeavaria          => i.quantidadeavaria 
                                                                                 , pquantidadetrocada         => i.quantidadetrocado
                                                                                 , pidprodutodetalhadotrocado => i.idprodutodetalhadotrocado
                                                                                 , pquantidadenaorecebida     => i.quantidadenaorecebida 
                                                                                 , pidusuario                 => :P0_IDUSUARIO);
                  end loop;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1384268998631195909
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'DEVOLVERTODOS'
        }
    )

    process confirmar-todos-exclusão (
        name: Confirmar Todos (Exclusão)
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                   viditemdevolucaopedido   number;
                   vquantidadedevolucao     number;
                   vquantidadedefeito       number;
                   vquantidadeavaria        number;
                   vquantidadenaorecebida   number;
                   vidfilialromance         number;
                begin
                  --
                  for i in ( select *
                             from vw_itensexcluidospedidos_fav if
                             where if.ididioma = 1
                             and if.codconfirmacaoestoque = 'N'
                             and ( if.idprotocoloatendimento = :P265_IDPROTOCOLOATENDIMENTO or if.idpedido = :P265_IDPEDIDO ) )
                  loop
                    --
                    pck_protocolosatendimentos_fav.prc_confirmarecebimentoaltera ( piditemexcluido            => i.iditemexcluido   
                                                                                 , pquantidadedevolvida       => i.quantidadedevolvida    
                                                                                 , pquantidadedefeito         => i.quantidadedefeito    
                                                                                 , piddefeito                 => i.iddefeito
                                                                                 , pquantidadeavaria          => i.quantidadeavaria 
                                                                                 , pquantidadetrocada         => i.quantidaderecebidatrocada
                                                                                 , pidprodutodetalhadotrocado => i.idprodutodetalhadotrocado
                                                                                 , pquantidadenaorecebida     => i.quantidadenaorecebida 
                                                                                 , pidusuario                 => :P0_IDUSUARIO);
                  end loop;
                  
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 1384269297438195912
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'EXCLUIRTODOS'
        }
    )

    process confirmar-todos-troca (
        name: Confirmar Todos (Troca)
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                   viditemdevolucaopedido   number;
                   vquantidadedevolucao     number;
                   vquantidadedefeito       number;
                   vquantidadeavaria        number;
                   vquantidadenaorecebida   number;
                   vidfilialromance         number;
                begin
                  -- Distinct adicionado no ticket 15931685
                  for i in ( select distinct if.iditempedidotrocado
                                 , if.quantidadetrocada
                                 , if.quantidadedefeito 
                                 , if.iddefeito
                                 , if.quantidadeavaria 
                                 , if.quantidaderecebidatrocada
                                 , if.idprodutodetalhadotrocado
                                 , if.quantidadenaorecebida 
                             from favorita.vw_itenstrocapedidos_fav if
                             where if.ididioma = 1
                               and if.codconfirmacaoestoque = 'N'
                             and ( if.idprotocoloatendimento = :P265_IDPROTOCOLOATENDIMENTO or if.idpedido = :P265_IDPEDIDO ) )
                  loop
                    pck_protocolosatendimentos_fav.prc_confirmarecebimentotroca  ( piditempedidotroca         => i.iditempedidotrocado   
                                                                                 , pquantidadedevolvida       => i.quantidadetrocada     
                                                                                 , pquantidadedefeito         => i.quantidadedefeito    
                                                                                 , piddefeito                 => i.iddefeito
                                                                                 , pquantidadeavaria          => i.quantidadeavaria 
                                                                                 , pquantidadetrocada         => i.quantidaderecebidatrocada
                                                                                 , pidprodutodetalhadotrocado => i.idprodutodetalhadotrocado
                                                                                 , pquantidadenaorecebida     => i.quantidadenaorecebida 
                                                                                 , pidusuario                 => :P0_IDUSUARIO );
                  end loop;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 1384269128352195911
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'TROCARTODOS'
        }
    )

    branch (
        name: Go To Page 265
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 265
                items: {
                    P265_IDPEDIDO: &P265_IDPEDIDO.
                    P265_IDPROTOCOLOATENDIMENTO: &P265_IDPROTOCOLOATENDIMENTO.
                    P265_TIPOPESQUISA: &P265_TIPOPESQUISA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

)

