    region confirmar-recebimento-de-trocas (
        name: Confirmar Recebimento de Trocas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct -- distinct adicionado no t15931685
                       t.iditempedidotrocado
                     , t.idpedido
                     , t.idpedidogerado
                     , t.representante
                     , t.vendedora
                     , t.idprotocoloatendimento
                     , t.motivoprotocolo
                     , t.justificativa
                     , t.nomeprodutotrocado
                     , t.quantidade
                     , t.quantidadetrocada2
                     , t.quantidadetrocada
                     , t.quantidadeavaria
                     , t.quantidadedefeito
                     , t.quantidadenaorecebida
                     , t.quantidaderecebidatrocada
                     , t.iddefeito
                     , t.idusuarioestoque
                     , t.usuarioestoque
                     , t.confirmarrecebimento
                     , t.confirmacaoestoque
                     , t.codconfirmacaoestoque
                     , t.dataconfirmacaoestoque
                  from (
                select it.iditempedidotrocado
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||it.idpedido ,'SESSION')||''',''_blank''); void(0)">'||it.idpedido||'</a>' idpedido
                     , it.idpedidogerado
                     , p.representante
                     , p.vendedora
                     , it.idprotocoloatendimento
                     , it.motivoprotocolo
                     , it.justificativa
                     , it.nomeprodutodetalhado nomeprodutotrocado
                     , it.quantidade
                     , nvl(it.quantidadetrocada,it.quantidade) quantidadetrocada2
                     , it.quantidadetrocada
                     , it.quantidadeavaria
                     , it.quantidadedefeito
                     , it.quantidadenaorecebida
                     , it.quantidaderecebidatrocada
                     , it.iddefeito
                     , it.idusuarioestoque
                     , it.usuarioestoque
                     , case 
                         when ( select ped.idsituacaoentrega
                                from pedidos ped
                                where ped.idpedido = it.idpedidogerado ) >= 32000 and codconfirmacaoestoque != 'S' then
                            '<a href="'||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':286:'||v('APP_SESSION')||'::NO::P286_IDITEMPEDIDOTROCADO,'||
                                                                                                                  'P286_IDPROTOCOLOATENDIMENTO,'||
                                                                                                                  'P286_IDDEFEITO,'||
                                                                                                                  'P286_QUANTIDADEAVARIA,'||
                                                                                                                  'P286_QUANTIDADEDEFEITO,'||
                                                                                                                  'P286_QUANTIDADEDEVOLVIDA,'||
                                                                                                                  'P286_QUANTIDADENAORECEBIDA,'||
                                                                                                                  'P286_QUANTIDADETROCADA,'||
                                                                                                                  'P286_CONFIRMADO,'||
                                                                                                                  'P286_TIPO:'
                                                                                                                   ||it.iditempedidotrocado||
                                                                                                                ','||it.idprotocoloatendimento||
                                                                                                                ','||it.iddefeito||
                                                                                                                ','||it.quantidadeavaria||
                                                                                                                ','||it.quantidadedefeito||
                                                                                                                ','||nvl(it.quantidadetrocada,it.quantidade) ||
                                                                                                                ','||it.quantidadenaorecebida||
                                                                                                                ','||it.quantidaderecebidatrocada||
                                                                                                                ','||it.codconfirmacaoestoque||
                                                                                                                ',T', 'SESSION')||' "><img src="#APP_IMAGES#ok.png"  border="0"></a>'
                      
                        when  ( select ped.idsituacaoentrega
                                from pedidos ped
                                where ped.idpedido = it.idpedidogerado ) < 32000 then 
                           'Aguardando a Montagem da Troca'
                        when codconfirmacaoestoque = 'S' then
                           'Recebido'
                        end confirmarrecebimento
                     , it.confirmacaoestoque
                     , it.codconfirmacaoestoque
                     , it.dataconfirmacaoestoque
                from vw_itenstrocapedidos_fav it
                   , vw_pedidos_fav p
                where it.ididioma = nvl(:P0_IDIDIOMA, 1)
                  and p.ididioma  = nvl(:P0_IDIDIOMA, 1)
                  and situacaoprotocolo = 'C'
                  and idtipoprotocolo in (6)
                 -- and (it.idprotocoloatendimento is null or it.idprotocoloatendimento = :P265_IDPROTOCOLOATENDIMENTO)
                  and ( :P265_DEVOLUCAORECEBIDA is null or it.codconfirmacaoestoque = :P265_DEVOLUCAORECEBIDA )
                  and ( :P265_FILTRARDATA = 'N' or ( :P265_FILTRARDATA = 'S' and trunc(it.dataconfirmacaoestoque) between :P265_DATAINICIAL and :P265_DATAFINAL ) )
                  and p.idpedido  = it.idpedidogerado
                  and exists ( select 1
                                from favorita.atendimentosfiliaisrmc a
                                 where (a.idfilialdestino = ( select case when p.idfilialromance = 1220 then ( select p.idfilialromance
                                                                                              from favorita.filiaisfavorita f 
                                                                                              where f.idfilialfavorita = p.idfilialfavorita )
                                             else 
                                                p.idfilialromance
                                                
                                             end tt
                                             from favorita.pedidos p
                                             where p.idpedido = it.idpedido )
                                               and a.idfilialfavoritaorigem = FAVORITA.pck_util_fav.fnc_retornaidfilialfavusuario(:P0_IDUSUARIO)))
                  and ( :P265_TIPOPESQUISA = 'PD' and ( it.idpedido = :P265_IDPEDIDO or it.idpedidogerado = :P265_IDPEDIDO )
                     or :P265_TIPOPESQUISA = 'PP' and exists ( select 1
                                                               from protocolosatendimentos p
                                                               where p.idpedido = it.idpedido
                                                                 and p.idprotocoloatendimento = :P265_IDPROTOCOLOATENDIMENTO ) )
                order by it.idpedido desc , pck_util_fav.fnc_nomeproduto(it.idproduto,1,'N')
                  ) t
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
