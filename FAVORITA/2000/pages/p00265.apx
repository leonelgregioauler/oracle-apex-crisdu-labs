            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region relatorio-de-itens-excluidos (
        name: Relatorio de itens Excluidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ie.iditemexcluido
                     , ie.iditempedido
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||ie.idpedido ,'SESSION')||''',''_blank''); void(0)">'||ie.idpedido||'</a>' idpedido
                     , ie.idproduto
                     , ie.idprodutodetalhado
                     , ie.nomeprodutodetalhado
                     , ie.quantidade
                     , nvl(ie.quantidadedevolvida, ie.quantidade) quantidadedevolvido2
                     , ie.quantidadedevolvida
                     , ie.quantidadedefeito
                     , ie.quantidadeavaria
                     , ie.quantidadenaorecebida
                     , ie.quantidaderecebidatrocada
                     , ie.idprotocoloatendimento
                     , ie.confirmacaoestoque
                     , ie.dataconfirmacaoestoque
                     , ie.usuarioestoque
                     , ie.motivoprotocolo
                     , ie.justificativa
                     , ie.iddefeito
                     , ie.defeito
                     , null confirmarrecebimento
                     , ie.codconfirmacaoestoque
                from vw_itensexcluidospedidos_fav ie
                where ie.ididioma = :P0_IDIDIOMA
                  and situacaoprotocolo = 'C'
                  and idtipoprotocolo in (4)
                  and ( :P265_DEVOLUCAORECEBIDA is null or ie.codconfirmacaoestoque = :P265_DEVOLUCAORECEBIDA )
                  and ( :P265_FILTRARDATA = 'N' or ( :P265_FILTRARDATA = 'S' and trunc(ie.dataconfirmacaoestoque) between :P265_DATAINICIAL and :P265_DATAFINAL ) )
                  and exists ( select 1
                               from atendimentosfiliaisrmc a
                               where a.idfilialdestino = ( select p.idfilialromance
                                                           from pedidos p
                                                           where p.idpedido = ie.idpedido ) 
                                 and a.idfilialfavoritaorigem = pck_util_fav.fnc_retornaidfilialfavusuario(:P0_IDUSUARIO) ) 
                  and ( quantidadenaorecebida > 0 and exists ( select 1
                                                               from atendimentosfiliaisrmc a
                                                                  , filiaisfavorita f
                                                               where a.idfilialfavoritaorigem = f.idfilialfavorita
                                                               and a.idfilialdestino          = ie.idfilialromance
                                                               and a.idfilialfavoritaorigem   = pck_util_fav.fnc_retornaidfilialfavusuario(:P0_IDUSUARIO)
                                                               and f.tipofilial               = 'E' ) or quantidadenaorecebida = 0 )
                                                              
                                                              
                  and ( :P265_IDPEDIDO is null    and exists ( select 1
                                                               from itensexcluidos iex
                                                               where iex.quantidadenaorecebida > 0 
                                                               and iex.iditemexcluido = ie.iditemexcluido ) 
                     or :P265_TIPOPESQUISA = 'PD' and ie.idpedido = :P265_IDPEDIDO
                     or :P265_TIPOPESQUISA = 'PP' and exists ( select 1
                                                               from protocolosatendimentos p
                                                               where p.idpedido = ie.idpedido
                                                                 and ( p.idprotocoloatendimento = :P265_IDPROTOCOLOATENDIMENTO or :P265_IDPROTOCOLOATENDIMENTO is null ) ) )
                order by idpedido desc , pck_util_fav.fnc_nomeproduto(ie.idproduto,1,'N')
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 4149594553372425543
        }

