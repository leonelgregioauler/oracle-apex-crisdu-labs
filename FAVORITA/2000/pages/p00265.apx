        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: javascript:apex.confirm('Esta operação é irreversível! Confirma o recebimento de todos os itens?', 'DEVOLVERTODOS');
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

