page 701 (
    name: Menu Bônus Adimplência
    title: Bônus Adimplência
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @valida-acesso-a-página
    }

    region bônus-adimplência (
        name: Bônus Adimplência
        type: list
        source {
            list: @bônus-adimplência
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: bonus-adimplencia-menu
            regionDisplaySelector: true
        }
        componentAppearance {
            listTemplate: @/cards
            templateOptions: [
                u-colors
                t-Cards--featured force-fa-lg
                t-Cards--displayIcons
                t-Cards--5cols
                t-Cards--animColorFill
            ]
        }
    )

)

