    region itens-pendentes-estoque-cd (
        name: Itens Pendentes - Estoque CD
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select bc.idbrindeclube
                      ,bc.descricao brinde
                      ,(select cl.nomeclassif from roman.conquistoulevouclassificacoes cl where cl.idclassificacao = icc.idclassificacao) classificacao
                     -- ,icc.idclassificacao
                      , (select cl.nomecaracteristica from roman.conquistoulevoucaracteristicas cl where cl.idclassificacao = icc.idclassificacao and cl.idcaracteristica = icc.idcaracteristica) caracteristica
                      --,icc.idcaracteristica
                      , icc.qtditem
                  from roman.itensconqlevcupons icc
                     , roman.brindesclub bc
                     , roman.classificacoesbrindesclub cb
                 where icc.idbrindeclube = bc.idbrindeclube
                   and bc.idbrindeclube = cb.idbrindeclube
                   and nvl(icc.idclassificacao,0)  = nvl(cb.idclassificacao,0)
                   and nvl(icc.idcaracteristica,0) = nvl(cb.idcaracteristica,0)
                   and icc.pend_remessa = 'S'
                   and bc.tipoproduto   = 'E'
                   and icc.idconquistoulevoucupom IN ( SELECT idconquistoulevoucupom
                                                         FROM roman.guiasentregascupons
                                                        WHERE idguiaentregabrinde = :P669_GUIAENVIO )
                ```
            pageItemsToSubmit: P669_GUIAENVIO
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from roman.itensconqlevcupons icc
                     , roman.brindesclub bc
                     , roman.classificacoesbrindesclub cb
                 where icc.idbrindeclube = bc.idbrindeclube
                   and bc.idbrindeclube = cb.idbrindeclube
                   and nvl(icc.idclassificacao,0)  = nvl(cb.idclassificacao,0)
                   and nvl(icc.idcaracteristica,0) = nvl(cb.idcaracteristica,0)
                   and icc.pend_remessa = 'S'
                   and bc.tipoproduto   = 'E'
                   and icc.idconquistoulevoucupom IN ( SELECT idconquistoulevoucupom
                                                         FROM roman.guiasentregascupons
                                                        WHERE idguiaentregabrinde = :P669_GUIAENVIO )
                ```
        }
        toolbar {
            show: false
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
            sendAsEmail: false
        }
