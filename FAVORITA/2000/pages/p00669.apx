    region itens-faltantes-externo (
        name: Itens Faltantes  - Externo
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select cb.idbrindeclube 
                     , cb.idclassifbrindeclub
                     , it.qtdfaltante
                     , it.datarecebimento
                     , it.iditemfaltante
                     , nvl(it.qtdrecebida,0) qtdrecebida
                     , (it.qtdfaltante - nvl(it.qtdrecebida,0) ) saldoreceber
                     , 0 qtdreceber
                from roman.itensfaltantes it 
                   , roman.classificacoesbrindesclub cb
                   , roman.brindesclub bc
                where cb.idclassifbrindeclub = it.idclassifbrindeclub
                  and cb.idbrindeclube       = bc.idbrindeclube
                  and it.idguiaentregabrinde = :P669_GUIAENVIO
                  and bc.tipoproduto = 'C'
                ```
            pageItemsToSubmit: P669_GUIAENVIO
        }
        layout {
            sequence: 30
            slot: body
        }
