    process dml-itens-faltantes (
        name: DML Itens faltantes
        type: executeCode
        editableRegion: @itens-faltantes-externo
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  --
                  vseqgrid        number;
                  vexcluifaltante number;
                  vidbrinde       number;
                  vverifica       number;
                  --
                BEGIN
                  -- Linha NOVA (Create)
                  IF :APEX$ROW_STATUS = 'C' THEN
                    --
                    select count(*)
                      into vverifica
                      from roman.itensfaltantes it 
                         , roman.classificacoesbrindesclub cb
                         , roman.brindesclub bc
                     where cb.idclassifbrindeclub = it.idclassifbrindeclub
                       and cb.idbrindeclube       = bc.idbrindeclube
                       and it.idguiaentregabrinde = :P669_GUIAENVIO
                       and cb.IDCLASSIFBRINDECLUB = :IDCLASSIFBRINDECLUB
                       and bc.tipoproduto = 'C';
                    --
                    if vverifica > 0 then
                      --
                      raise_application_error(-20001,'Este brinde já esta vinculado os itens faltantes da guia');
                      --
                    end if;
                    --
                    select clb.idbrindeclube
                      into vidbrinde
                      from roman.classificacoesbrindesclub clb
                     where clb.idclassifbrindeclub = :IDCLASSIFBRINDECLUB;
                    --
                    --raise_application_error(-20001,'xxxxxxxxx');
                    select roman.seq_iditemfaltante.nextval
                      into vseqgrid
                      from dual;
                    --
                    insert into roman.itensfaltantes(iditemfaltante,
                                                     idguiaentregabrinde,
                                                     idclassifbrindeclub,
                                                     qtdfaltante,
                                                     datarecebimento,
                                                     idbrindeclube,
                                                     qtdrecebida)
                    values(vseqgrid,
                           :P669_GUIAENVIO,
                           :IDCLASSIFBRINDECLUB,
                           :QTDFALTANTE,
                           null,
                           vidbrinde,
                           null)
                
                    RETURNING iditemfaltante INTO :IDITEMFALTANTE;
                    --
                    update roman.guiasentregasbrindes g
                    set g.itensfaltantes = 'S'
                    where g.idguiaentregabrinde = :P669_GUIAENVIO;
                    --
                  -- Linha ALTERADA (Update)
                  ELSIF :APEX$ROW_STATUS = 'U' THEN
                    --
                    -- se ja recebeu alguma quantidade do item, nao pode mais alterar
                    --
                    if nvl(:QTDRECEBIDA,0) > 0 then
                      --
                      raise_application_error(-20001,'Nao pode ser alterado, pois existe recebimento.');
                      --
                    end if;
                    --
                    /*if nvl(:QTDRECEBIDA,0) <= 0 then
                      --
                      raise_application_error(-20001,'Quantidade recebida não pode ser menor ou igual a zero');
                      --
                    end if;
                    --
                    if nvl(:QTDRECEBIDA,0) > nvl(:QTDFALTANTE,0) then
                      --
                      raise_application_error(-20002,'Quantidade recebida não pode ser maior que a quantidade do item');
                      --
                    end if;*/
                    --
                    update roman.itensfaltantes it 
                    set it.datarecebimento = to_date((:DATARECEBIMENTO),'DD/MM/YYYY HH24:MI:SS'), it.qtdrecebida = :QTDRECEBIDA
                    where it.idclassifbrindeclub = :IDCLASSIFBRINDECLUB;
                
                  -- Linha EXCLUÍDA (Delete)
                   ELSIF :APEX$ROW_STATUS = 'D' THEN
                    --
                    begin
                      --
                      select 1
                        into vexcluifaltante
                      from roman.conquistoulevoucupons clc
                         , roman.guiasentregascupons gec 
                         , roman.guiasentregasbrindes ge
                      where clc.idconquistoulevoucupom = gec.idconquistoulevoucupom
                        and gec.idguiaentregabrinde = ge.idguiaentregabrinde
                        and ge.idguiaentregabrinde = :P669_GUIAENVIO
                        and clc.datarecebfilial is null;
                    exception
                        when others then
                          vexcluifaltante := 0;   
                    end;
                    --
                    if vexcluifaltante = 1 then
                    --
                    delete  roman.itensfaltantes it 
                    where it.iditemfaltante = :IDITEMFALTANTE;
                    --
                    update roman.guiasentregasbrindes g
                    set g.itensfaltantes = null
                    where g.idguiaentregabrinde = :P669_GUIAENVIO;
                    --
                    else 
                      --
                      raise_application_error(-20003,'Existe cupons recebidos para esta guia, não permitido exluir o item faltante informado'); 
                      --
                    end if;
                  END IF;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1804095913336169413
        }
        serverSideCondition {
            whenButtonPressed: @salvar
        }
    )

    process recebe-itens-faltantes-da-guia (
        name: "Recebe itens faltantes da guia "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vvalidafalta    number;
                  vidusuario      number;
                  vidguia         number := :P669_GUIAENVIO;
                  vidcupom        number;
                  vqtdrecebida    number;
                  vqtdfaltante    number;
                  vqtdbaixada     number;
                  vtempendencia   number;
                begin
                  -- valida guia
                  if vidguia is null then
                    raise_application_error(-20001, 'Guia de envio não informada.');
                  end if;
                
                  -- busca usuário logado
                  begin
                    select u.idusuario
                      into vidusuario
                    from catal.usuarios u
                    where u.usuario = v('APP_USER');
                  exception
                    when no_data_found then
                      raise_application_error(-20002, 'Usuário logado não encontrado na tabela catal.usuarios.');
                    when too_many_rows then
                      raise_application_error(-20003, 'Existe mais de um usuário cadastrado com o login atual.');
                  end;
                
                  -- processa somente itens com quantidade recebida informada
                  for f in (
                      select it.iditemfaltante
                           , it.idclassifbrindeclub
                           , nvl(it.qtdfaltante, 0) qtdfaltante
                           , nvl(it.qtdrecebida, 0) qtdrecebida
                           , clb.idbrindeclube
                           , clb.idcaracteristica
                           , clb.idclassificacao
                      from roman.itensfaltantes it
                         , roman.classificacoesbrindesclub clb
                      where clb.idclassifbrindeclub = it.idclassifbrindeclub
                        and it.idguiaentregabrinde = vidguia
                        and nvl(it.qtdrecebida, 0) > 0
                  )
                  loop
                    if nvl(f.qtdfaltante, 0) = 0 then
                      raise_application_error(
                        -20004,
                        'O item faltante de id ' || f.iditemfaltante || ' já está com quantidade zerada.'
                      );
                    end if;
                
                    if nvl(f.qtdrecebida, 0) < 0 then
                      raise_application_error( -20005, 'A quantidade recebida do item faltante de id ' || f.iditemfaltante || ' não pode ser negativa.'
                      );
                    end if;
                
                    if nvl(f.qtdrecebida, 0) > nvl(f.qtdfaltante, 0) then
                      raise_application_error(-20006,'A quantidade recebida é maior que a quantidade faltante' );
                    end if;
                
                    vqtdrecebida := f.qtdrecebida;
                    vqtdfaltante := f.qtdfaltante;
                    vqtdbaixada  := 0;
                
                    -- baixa uma unidade por vez
                    while vqtdrecebida > 0
                      and vqtdfaltante > 0
                    loop
                      /*
                        escolhe o cupom da unidade recebida:
                        dentre os cupons ainda abertos para esse item,
                        os pendentes são os últimos vqtdfaltante;
                        entre eles, baixa no mais antigo.
                      */
                      begin
                        select z.idconquistoulevoucupom
                          into vidcupom
                        from (
                              select x.idconquistoulevoucupom
                                   , row_number() over (order by x.idconquistoulevoucupom) rn_asc
                                   , count(*) over () cnt
                              from (
                                    select distinct ic.idconquistoulevoucupom
                                    from roman.itensconqlevcupons ic
                                       , roman.guiasentregascupons gc
                                    where ic.idconquistoulevoucupom = gc.idconquistoulevoucupom
                                      and ic.idbrindeclube = f.idbrindeclube
                                      and ic.idclassificacao = f.idclassificacao
                                      and ic.idcaracteristica = f.idcaracteristica
                                      and gc.idguiaentregabrinde = vidguia
                                      and gc.itensfaltantes = 'S'
                                   ) x
                             ) z
                        where z.rn_asc = (z.cnt - vqtdfaltante + 1);
                
                        if vidcupom is null then
                          raise_application_error(
                            -20007,
                            'Não foi encontrado cupom pendente para baixa do item faltante de id ' || f.iditemfaltante || '.'
                          );
                        end if;
                      exception
                        when no_data_found then
                          raise_application_error(
                            -20008,
                            'Não foi encontrado cupom pendente para baixa do item faltante de id ' || f.iditemfaltante || '.'
                          );
                      end;
                
                      -- consome uma unidade
                      vqtdrecebida := vqtdrecebida - 1;
                      vqtdfaltante := vqtdfaltante - 1;
                      vqtdbaixada  := vqtdbaixada + 1;
                
                      -- atualiza imediatamente o item faltante global
                      update roman.itensfaltantes it
                      set it.qtdfaltante     = case
                                                 when vqtdfaltante < 0 then 0
                                                 else vqtdfaltante
                                               end
                        , it.idusuario       = vidusuario
                        , it.datarecebimento = sysdate
                      where it.iditemfaltante = f.iditemfaltante;
                
                      /*
                        verifica se o cupom ainda está pendente em algum item:
                        para cada item do cupom, o cupom continua pendente
                        somente se estiver dentro dos últimos qtdfaltante cupons abertos daquele item
                      */
                      select count(*)
                        into vtempendencia
                      from (
                            select distinct
                                   clb.idbrindeclube
                                 , clb.idclassificacao
                                 , clb.idcaracteristica
                                 , nvl(it.qtdfaltante, 0) qtdfaltante
                            from roman.itensconqlevcupons ic
                               , roman.classificacoesbrindesclub clb
                               , roman.itensfaltantes it
                            where ic.idconquistoulevoucupom = vidcupom
                              and clb.idbrindeclube = ic.idbrindeclube
                              and clb.idclassificacao = ic.idclassificacao
                              and clb.idcaracteristica = ic.idcaracteristica
                              and it.idclassifbrindeclub = clb.idclassifbrindeclub
                              and it.idguiaentregabrinde = vidguia
                           ) a
                      where a.qtdfaltante > 0
                        and exists (
                              select 1
                              from (
                                    select x2.idconquistoulevoucupom
                                         , row_number() over (order by x2.idconquistoulevoucupom) rn_asc
                                         , count(*) over () cnt
                                    from (
                                          select distinct ic2.idconquistoulevoucupom
                                          from roman.itensconqlevcupons ic2
                                             , roman.guiasentregascupons gc2
                                          where ic2.idconquistoulevoucupom = gc2.idconquistoulevoucupom
                                            and ic2.idbrindeclube = a.idbrindeclube
                                            and ic2.idclassificacao = a.idclassificacao
                                            and ic2.idcaracteristica = a.idcaracteristica
                                            and gc2.idguiaentregabrinde = vidguia
                                            and gc2.itensfaltantes = 'S'
                                         ) x2
                                   ) p
                              where p.idconquistoulevoucupom = vidcupom
                                and p.rn_asc > (p.cnt - a.qtdfaltante)
                           );
                
                      -- se não restou pendência para esse cupom, finaliza já
                      if vtempendencia = 0 then
                        update roman.conquistoulevoucupons cl
                        set cl.datarecebfilial = sysdate
                        where cl.idconquistoulevoucupom = vidcupom
                          and cl.datarecebfilial is null;
                
                        update roman.guiasentregascupons gc
                        set gc.itensfaltantes = null
                        where gc.idconquistoulevoucupom = vidcupom
                          and gc.idguiaentregabrinde = vidguia
                          and gc.itensfaltantes = 'S';
                      end if;
                    end loop;
                
                    -- ao final do item, zera a quantidade recebida informada
                    update roman.itensfaltantes it
                    set it.qtdfaltante     = case
                                               when vqtdfaltante < 0 then 0
                                               else vqtdfaltante
                                             end
                      , it.qtdrecebida     = 0
                      , it.idusuario       = vidusuario
                      , it.datarecebimento = case
                                               when vqtdbaixada > 0 then sysdate
                                               else it.datarecebimento
                                             end
                    where it.iditemfaltante = f.iditemfaltante;
                  end loop;
                
                  /*
                    saneamento final:
                    percorre todos os cupons ainda abertos da guia e fecha
                    qualquer um que já esteja sem item faltante.
                    isso evita sobrar cupom aberto "sem pendência".
                  */
                  for c in (
                      select gc.idconquistoulevoucupom
                      from roman.guiasentregascupons gc
                      where gc.idguiaentregabrinde = vidguia
                        and gc.itensfaltantes = 'S'
                  )
                  loop
                    select count(*)
                      into vtempendencia
                    from (
                          select distinct
                                 clb.idbrindeclube
                               , clb.idclassificacao
                               , clb.idcaracteristica
                               , nvl(it.qtdfaltante, 0) qtdfaltante
                          from roman.itensconqlevcupons ic
                             , roman.classificacoesbrindesclub clb
                             , roman.itensfaltantes it
                          where ic.idconquistoulevoucupom = c.idconquistoulevoucupom
                            and clb.idbrindeclube = ic.idbrindeclube
                            and clb.idclassificacao = ic.idclassificacao
                            and clb.idcaracteristica = ic.idcaracteristica
                            and it.idclassifbrindeclub = clb.idclassifbrindeclub
                            and it.idguiaentregabrinde = vidguia
                         ) a
                    where a.qtdfaltante > 0
                      and exists (
                            select 1
                            from (
                                  select x2.idconquistoulevoucupom
                                       , row_number() over (order by x2.idconquistoulevoucupom) rn_asc
                                       , count(*) over () cnt
                                  from (
                                        select distinct ic2.idconquistoulevoucupom
                                        from roman.itensconqlevcupons ic2
                                           , roman.guiasentregascupons gc2
                                        where ic2.idconquistoulevoucupom = gc2.idconquistoulevoucupom
                                          and ic2.idbrindeclube = a.idbrindeclube
                                          and ic2.idclassificacao = a.idclassificacao
                                          and ic2.idcaracteristica = a.idcaracteristica
                                          and gc2.idguiaentregabrinde = vidguia
                                          and gc2.itensfaltantes = 'S'
                                       ) x2
                                 ) p
                            where p.idconquistoulevoucupom = c.idconquistoulevoucupom
                              and p.rn_asc > (p.cnt - a.qtdfaltante)
                         );
                
                    if vtempendencia = 0 then
                      update roman.conquistoulevoucupons cl
                      set cl.datarecebfilial = sysdate
                      where cl.idconquistoulevoucupom = c.idconquistoulevoucupom
                        and cl.datarecebfilial is null;
                
                      update roman.guiasentregascupons gc
                      set gc.itensfaltantes = null
                      where gc.idconquistoulevoucupom = c.idconquistoulevoucupom
                        and gc.idguiaentregabrinde = vidguia
                        and gc.itensfaltantes = 'S';
                    end if;
                  end loop;
                
                  -- valida se ainda restam pendências na guia
                  select count(*)
                    into vvalidafalta
                  from roman.guiasentregascupons guc
                  where guc.idguiaentregabrinde = vidguia
                    and guc.itensfaltantes = 'S';
                
                  -- finaliza a guia somente se não houver mais pendências
                  if vvalidafalta = 0 then
                    update roman.guiasentregasbrindes gb
                    set gb.datarecebimento = sysdate
                      , gb.itensfaltantes = null
                    where gb.idguiaentregabrinde = vidguia;
                  end if;
                
                  commit;
                
                exception
                  when others then
                    rollback;
                    raise;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 1804379086246253403
        }
        serverSideCondition {
            type: never
        }
    )

    process recebe-itens-faltantes-da-guia-v (
        name: Recebe itens faltantes da guia v2
        type: executeCode
        editableRegion: @itens-faltantes-externo
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidusuario number;
                 -- vguiaentrega number := :P667_GUIAENVIO;
                  --
                begin
                  --
                  
                  if :QTDRECEBER > 0 then
                    --
                      if :QTDRECEBER > :SALDORECEBER then
                        --
                        raise_application_error(-20001,'A quantidade a receber não pode ser maior que o saldo a receber');
                        --
                      end if;
                      --
                      select u.IDUSUARIO
                        into vidusuario
                        from catal.usuarios u 
                       where u.usuario =  v('APP_USER') ;
                      --
                      /*for c in (select it.iditemfaltante
                                     , it.qtdfaltante
                                     , it.qtdrecebida
