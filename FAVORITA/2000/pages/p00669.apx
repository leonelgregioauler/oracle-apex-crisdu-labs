    region itens-faltantes-estoque-cd (
        name: Itens Faltantes  - Estoque CD
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select cb.idbrindeclube 
                     , cb.idclassifbrindeclub
                     , it.qtdfaltante
                     , it.datarecebimento
                     , it.iditemfaltante
                     , it.qtdrecebida
                from roman.itensfaltantes it 
                   , roman.classificacoesbrindesclub cb
                   , roman.brindesclub bc
                where cb.idclassifbrindeclub = it.idclassifbrindeclub
                  and cb.idbrindeclube       = bc.idbrindeclube
                  and it.idguiaentregabrinde = :P669_GUIAENVIO
                  and bc.tipoproduto = 'E'
                ```
            pageItemsToSubmit: P669_GUIAENVIO
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.itensfaltantes it 
                   , roman.classificacoesbrindesclub cb
                   , roman.brindesclub bc
                where cb.idclassifbrindeclub = it.idclassifbrindeclub
                  and cb.idbrindeclube       = bc.idbrindeclube
                  and it.idguiaentregabrinde = :P669_GUIAENVIO
                  and bc.tipoproduto = 'E'
                ```
        }
        toolbar {
            show: false
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
            sendAsEmail: false
        }
        advanced {
            savedReportMappingIdentifier: 46775004311822816
        }

