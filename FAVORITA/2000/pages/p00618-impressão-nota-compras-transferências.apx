page 618 (
    name: Impressão Nota Compras Transferências
    alias: IMPRESSÃO-NOTA-COMPRAS-TRANSFERÊNCIAS
    title: Impressão Nota Compras Transferências
    appearance {
        pageTemplate: @minimal-pedido
        templateOptions: #DEFAULT#
    }
    security {
        authentication: public
        pageAccessProtection: unrestricted
    }

    region lista-notas-para-impressão (
        name: lista notas para impressão
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                  -- CSS
                  htp.p('<style type="text/css">');
                  htp.p('.folha {
                           font-size: 12px;
                           font-family: Roboto, sans-serif;
                           background-color: white;
                           page-break-after: always;
                           line-height: 1.5;
                         }');
                --  htp.p('@page {
                --           size: auto;
                --           margin: 5mm 4mm 6mm 4mm;
                --         }');
                  htp.p('.danfe {
                           overflow: visible;
                           height: 1050px;
                           width: 750px;
                           position: inherit;
                           top: -10px;
                           left: -80px;
                           z-index: 0;
                           float: left;
                         }');
                  htp.p('</style>');
                
                  -- Exibição dos PDFs da DANFE
                  for ped in (  select ps.idpedido
                                  from favorita.pedidos_selecionados_p584 ps
                                 where ps.usuario = v('APP_USER'))
                  loop
                    htp.p('<div class="folha">');
                    htp.p('  <table width="100%" bgcolor="white">');
                    htp.p('    <tr>');
                    htp.p('      <td colspan="3">');
                    htp.p('        <iframe class="danfe" ');
                    htp.p('               src="https://docs.google.com/viewer?embedded=true&url=https://sistema.catalogofavorita.com.br/apex/favorita/2000/danfe/' || ped.idpedido || '"');
                    
                    --htp.p('               src="https://drive.google.com/viewerng/viewer?embedded=true&print=true&url=https://sistema.catalogofavorita.com.br/apex/favorita/2000/danfe/' || ped.idpedido || '"');
                    htp.p('               type="application/pdf">');
                    htp.p('        </iframe>');
                    htp.p('      </td>');
                    htp.p('    </tr>');
                    htp.p('  </table>');
                    htp.p('</div>');
                  end loop;
                
                end;
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

)

