    region protocolos-de-atendimento (
        name: Protocolos de Atendimento
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*select p.idprotocoloatendimento
                     , p.idfilial
                     , roman.pck_romance.fnc_nomefilial(p.idfilial) nomefilial
                     , p.idusuariosolicitou
                     , pck_util_fav.fnc_nomeusuario(p.idusuariosolicitou) usuariosolicitou
                     , p.dataprotocolo
                     , p.idpedido
                     , p.numeropedido
                     , p.situacao
                     , decode(p.situacao,'P','Pendente','C','Concluído','R','Rejeitado') descsituacao
                     , p.justificativa
                     , p.dataatendimento
                     , p.observacaointerna
                     , p.idmotivoprotocolo
                     , pck_util_fav.fnc_retornamotivoprotocolo(p.idmotivoprotocolo,:P0_IDIDIOMA) motivoprotocolo
                     , p.cpf
                     , p.idtipoprotocolo
                     , pck_util_fav.fnc_retornatipoprotocolo(p.idtipoprotocolo,:P0_IDIDIOMA) tipoprotocolo
                     , p.idusuarioatendeu
                     , pck_util_fav.fnc_nomeusuario(p.idusuarioatendeu) usuarioatendeu
                     , p.numerocomprovante
                     , p.valordepositado
                     , p.dataprorrogacao
                     , p.datapagamento
                     , p.contapagamento
                     , p.idprotocoloatendimento "ver/editar"
                     , p.vendedora
                     , p.representante
                     , p.situacaovencimento
                     , p.situacaopagamento
                     , p.liberadoatendimento
                     , p.valorapagar
                     , case 
                         when exists ( select 1
                                       from classificacoespedidos c
                                       where c.idcaracteristicapedido = 8
                                         and c.idpedido               = p.idpedido
                                         and c.idvalorcaracteristica  = 1 ) then
                           ( select LISTAGG(b.numero,' , ')
                                    WITHIN GROUP (ORDER BY b.idpedido)
                             from vw_boletos_fav b
                             where b.idpedido = p.idpedido )
                         else
                           'Sem Fatura'
                       end nrfatura
                from VW_PROTOCOLOSATENDIMENTOS_fav p
                where (:P129_IDPEDIDO is null or p.idpedido = :P129_IDPEDIDO)
                  and (:P129_PROTOCOLO is null or p.idprotocoloatendimento = :P129_PROTOCOLO)
                  and (:P129_IDFILIALROMANCE is null or p.idfilial = :P129_IDFILIALROMANCE) 
                  and (:P129_SITUACAO is null or p.situacao = :P129_SITUACAO)
                  and (:P129_TIPO is null or p.idtipoprotocolo = :P129_TIPO)
                  and (:P129_NUMEROCOMPROVANTE is null or p.numerocomprovante = :P129_NUMEROCOMPROVANTE )
                  and ( :P129_TIPODATA = 'T'
                         or (:P129_TIPODATA = 'C' and trunc(dataprotocolo) between to_date(:P129_DATAINI,'DD/MM/RRRR') and to_date(:P129_DATAFIM,'DD/MM/RRRR'))
                         or (:P129_TIPODATA = 'A' and trunc(dataatendimento) between to_date(:P129_DATAINI,'DD/MM/RRRR') and to_date(:P129_DATAFIM,'DD/MM/RRRR')))
                  and ( pck_util_fav.fnc_verificaacesso(28706,:P0_IDUSUARIO) = 'S' 
                     or p.idfilial = roman.pck_romance.fnc_filialusuario(v('APP_USER')) )
                  and ( (pck_util_fav.fnc_verificaacesso(28707,:P0_IDUSUARIO) = 'N')
                     or (:P129_TIPOPROTOCOLO = 'R' and exists ( select 1
                                                               from roman.vw_filiais f
                                                               where f.idfilial = p.idfilial
                                                                 and f.tipofilial = 'D' )
                                                                 and exists ( select 1
                                                                              from usuarios u
                                                                              where u.idusuario = p.idusuariosolicitou
                                                                              and ( not exists ( select 1
                                                                                                 from roman.usuariosgruposatendimento ug
                                                                                                 where ug.usuario = u.usuario ) )
                                                                               or ( exists ( select 1
                                                                                             from usuarios u
                                                                                             where u.idusuario = p.idusuariosolicitou
                                                                                              and u.idfilialfavorita not in ( 1, 2 ) ) ) ) )
                                                                               
                     or (:P129_TIPOPROTOCOLO = 'F' and exists ( select 1
                                                               from usuarios u
                                                               where u.idusuario = p.idusuariosolicitou
                                                                 and ( exists ( select 1
                                                                                from roman.usuariosgruposatendimento ug
                                                                                where ug.usuario = u.usuario
                                                                                and pck_util_fav.fnc_verificagrupoatendimento(ug.idgrupoatendimento,:P0_IDUSUARIO) = 'S' ) ) 
                                                                  and u.idfilialfavorita in ( 1, 2 ) ) )
                                                              
                     or (:P129_TIPOPROTOCOLO = 'T' ) )
                     and( pck_util_fav.fnc_verificaacesso(28707,:P0_IDUSUARIO) = 'S'
                      or (nvl(pck_util_fav.fnc_verificaacesso(28707,:P0_IDUSUARIO),'N') = 'N'
                          and exists ( select 1
                                       from favorita.atendimentosfiliaisrmc ate
                                       where p.idfilial = ate.idfilialdestino
                                         and ate.idfilialfavoritaorigem = favorita.pck_util_fav.fnc_retornaidfilialfavusuario(:P0_IDUSUARIO))))
                  and exists ( select 1
                               from permissoestiposprotocolos pp
                               where pp.idtipoprotocolo = p.idtipoprotocolo
                                 and pp.idusuario = :P0_IDUSUARIO
                                 and pp.criar = 'S' )
                   and ( :P129_INTEGRADO is null or exists ( select 1
                                                             from pedidos pp
                                                             where pp.idpedido = p.idpedido ) )
                   and ( :P129_NRDOCUMENTO is null or exists ( select 1
                                                               from vw_boletos_fav b
                                                               where b.numero = :P129_NRDOCUMENTO
                                                                 and b.idpedido = p.idpedido ) )
                   and ( :P129_IDPEDIDOGERDO is null or exists ( select distinct 1
                                                                 from favorita.itenspedidostrocados itr
                											     where itr.idpedidogerado = :P129_IDPEDIDOGERDO
                                                                   and itr.idpedido = p.idpedido))
                   and 1 = 2
                order by 1 desc*/
                select 1 
                from dual
                where 1 = 2
                ```
            pageItemsToSubmit: P129_TIPOPROTOCOLO
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado!
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 15493934309425240
        }

