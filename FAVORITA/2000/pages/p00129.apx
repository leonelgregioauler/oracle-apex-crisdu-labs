    pageItem P129_TIPO (
        type: radioGroup
        label {
            label: Tipo
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_retornatipoprotocolo(t.idtipoprotocolo,:P0_IDIDIOMA) display_value
                 , t.idtipoprotocolo return_value
                from tiposprotocolosatendimentos t
                where exists ( select 1
                               from permissoestiposprotocolos p
                               where p.idtipoprotocolo = t.idtipoprotocolo
                                 and p.idusuario = :P0_IDUSUARIO 
                                 and p.criar     = 'S' )
                order by idtipoprotocolo
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

