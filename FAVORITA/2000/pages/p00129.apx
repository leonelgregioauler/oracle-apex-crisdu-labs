        behavior {
            action: redirectThisApp
            target: {
                page: 131
                items: {
                    P131_IDPROTOCOLOATENDIMENTO:
                    P131_IDTIPOPROTOCOLO:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction esconde-campos (
        name: Esconde Campos
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P129_TIPODATA
        }
        clientSideCondition {
            type: item=value
            item: P129_TIPODATA
            value: -1
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P129_DATAINI
                    P129_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P129_DATAINI
                    P129_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    dynamicAction refreh (
        name: Refreh
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P129_TIPOPROTOCOLO
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @protocolos-de-atendimento
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process iniciaprotocolo (
        name: INICIAPROTOCOLO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidprotocoloatendimento number;
                  VIDFILIAL number;
                  VIDUSUARIOSOLICITOU number := :P0_IDUSUARIO;
                  VDATAPROTOCOLO date := sysdate;
                  VIDPEDIDO number;
                  VSITUACAO varchar2(1);
                  VJUSTIFICATIVA varchar2(2000);
                  VDATAATENDIMENTO date;
                  VOBSERVACAOINTERNA varchar2(2000);
                  VIDMOTIVOPROTOCOLO number;
                  VCPF varchar2(11);
                  VIDTIPOPROTOCOLO number;
                  VIDUSUARIOATENDEU number;
                  VNUMEROCOMPROVANTE varchar2(30);
                  VVALORDEPOSITADO number;
                  VDATAPRORROGACAO date;
                  VDATAPAGAMENTO date;
                  VCONTAPAGAMENTO varchar2(30);
                  VMD5 varchar2(2000);
                  --
                begin
                  --
                  #OWNER#.PCK_PROTOCOLOSATENDIMENTOS_FAV.PRC_PROTOCOLOSATENDIMENTOS( PIDPROTOCOLOATENDIMENTO => vidprotocoloatendimento,
                                                                                     PIDFILIAL => VIDFILIAL,
                                                                                     PIDUSUARIOSOLICITOU => VIDUSUARIOSOLICITOU,
                                                                                     PDATAPROTOCOLO => VDATAPROTOCOLO,
                                                                                     PIDPEDIDO => VIDPEDIDO,
                                                                                     PSITUACAO => VSITUACAO,
                                                                                     PJUSTIFICATIVA => VJUSTIFICATIVA,
                                                                                     PDATAATENDIMENTO => VDATAATENDIMENTO,
                                                                                     POBSERVACAOINTERNA => VOBSERVACAOINTERNA,
                                                                                     PIDMOTIVOPROTOCOLO => VIDMOTIVOPROTOCOLO,
                                                                                     PCPF => VCPF,
                                                                                     PIDTIPOPROTOCOLO => VIDTIPOPROTOCOLO,
                                                                                     PIDUSUARIOATENDEU => VIDUSUARIOATENDEU,
                                                                                     PNUMEROCOMPROVANTE => VNUMEROCOMPROVANTE,
                                                                                     PVALORDEPOSITADO => VVALORDEPOSITADO,
                                                                                     PDATAPRORROGACAO => VDATAPRORROGACAO,
                                                                                     PDATAPAGAMENTO => VDATAPAGAMENTO,
                                                                                     PCONTAPAGAMENTO => VCONTAPAGAMENTO,
                                                                                     PMD5 => VMD5,
                                                                                     POPERACAO_DML => 'I');
                  --
                  :P129_IDPROTOCOLOATENDIMENTO := vidprotocoloatendimento;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 16236407665628117
        }
        serverSideCondition {
            whenButtonPressed: @novo
            type: never
        }
    )

    branch (
        name: proximo passo
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 131
                items: {
                    P131_IDPROTOCOLOATENDIMENTO: &P129_IDPROTOCOLOATENDIMENTO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: PROXIMOPASSO
        }
    )

    branch (
        name: go to page 129
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 129
                items: {
                    P129_TIPO: &P129_TIPO.
                    P129_IDPEDIDO: &P129_IDPEDIDO.
                    P129_PROTOCOLO: &P129_PROTOCOLO.
                    P129_SITUACAO: &P129_SITUACAO.
                    P129_TIPOPROTOCOLO: &P129_TIPOPROTOCOLO.
                    P129_TIPODATA: &P129_TIPODATA.
                    P129_DATAINI: &P129_DATAINI.
                    P129_DATAFIM: &P129_DATAFIM.
                    P129_INTEGRADO: &P129_INTEGRADO.
                    P129_NRDOCUMENTO: &P129_NRDOCUMENTO.
                    P129_FILTRAR: S
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

