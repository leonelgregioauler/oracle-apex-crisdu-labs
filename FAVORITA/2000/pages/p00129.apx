    region protocolos-de-atendimento-2 (
        name: Protocolos de Atendimento
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select * from table(pck_relatorios_fav.fnc_listaprotocolos(pidpedido          => :P129_IDPEDIDO,
                                                                           pidprotocolo       => :P129_PROTOCOLO,
                                                                           pidfilialromance   => :P129_IDFILIALROMANCE,
                                                                           psituacao          => :P129_SITUACAO,
                                                                           ptipo              => :P129_TIPO,
                                                                           pnumerocomprovante => :P129_NUMEROCOMPROVANTE,
                                                                           ptipodata          => :P129_TIPODATA,
                                                                           pdatainicial       => :P129_DATAINI,
                                                                           pdatafinal         => :P129_DATAFIM,
                                                                           pidusuario         => :P0_IDUSUARIO,
                                                                           ptipoprotocolo     => :P129_TIPOPROTOCOLO,
                                                                           pintegrado         => :P129_INTEGRADO,
                                                                           pnumerodocumento   => :P129_NRDOCUMENTO,
                                                                           pidpedidogerado    => :P129_IDPEDIDOGERADO,
                                                                           pidfilialfavorita  => :P129_IDFILIALFAVORITA,
                                                                           pididioma          => :P0_IDIDIOMA ))
                                                                           
                 where :P129_FILTRAR = 'S';
                ```
            pageItemsToSubmit: P129_TIPOPROTOCOLO
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 4000
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 57217561798852436
        }

