    region boletos-pagos-de-vencimentos-cancelados (
        name: Boletos Pagos de Vencimentos Cancelados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select vp.idpedido
                     , vp.idvencimentopedido 
                     , vp.datavencimento
                     , pg.numeroboleto
                     , pb.valorpago
                     , pb.acrescimo
                     , pb.desconto
                     , pb.taxa
                     , pb.valorliquido
                from vw_pagamentospedidos_fav pg
                   , vw_vencimentospedidos_fav vp
                   , pagamentosbancos pb
                where vp.idvencimentopedido    = pg.idvencimentopedido
                  and pg.ididioma              = 1
                  and pb.idpagamentopedido     = pg.idpagamentopedido
                  and pb.vencimentocancelado   = 'S'
                  and vp.codsituacaovencimento = 'C'
                  and trunc(pb.dataprocessado) = trunc(sysdate)
                order by 1
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Não encontrado pagamentos de vencimentos cancelados!
        }
        advanced {
            savedReportMappingIdentifier: 1405624903317436420
        }

