    region ultimas-importações (
        name: Ultimas Importações
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select data
                from ( select distinct trunc(dataprocessado) data
                       from pagamentosbancos t
                       order by 1 desc )
                where rownum <= 10
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
            columnSpan: 2
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
