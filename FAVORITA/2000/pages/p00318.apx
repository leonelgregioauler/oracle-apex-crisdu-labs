    region relatório-de-comissões-por-produtos-vendidos-de-divulgação-resumido (
        name: Relatório de Comissões por produtos Vendidos de Divulgação Resumido
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select sum(i.valorcomissaoatendente * i.quantidade) valorcomissaoatendente
                     , sum(i.valorvenda * i.quantidade) valorvenda
                     , count( distinct pp.idpedido)
                     , pp.idusuario
                     , pck_util_fav.fnc_nomeusuario(pp.idusuario) nomeusuario
                from favorita.itenspedidos i
                   , favorita.pedidos pp
                where pp.idpedido = i.idpedido
                  and pp.idusuario is not null
                  and i.idpromocaodivulgacao is not null
                  and :P318_TIPO = 1
                  and not exists ( select 1
                                   from favorita.classificacoespedidos cp
                                   where cp.idpedido = pp.idpedido
                                     and cp.idcaracteristicapedido = 25)
                  and ( trunc(pp.dataemissao) between :P318_DATAINI and :P318_DATAFIM)
                  and i.valorcomissaoatendente > 0
                  and (:P318_IDFILIALFAVORITAORIGEM is null or  pp.idfilialfavorita = :P318_IDFILIALFAVORITAORIGEM)
                  and ( (:P318_FILTRARPRODUTOS = '1' and exists ( select 1
                                                                  from filtrosprodutos fp
                                                                  where fp.idusuario = :P0_IDUSUARIO
                                                                    and fp.idprodutodetalhado = i.idprodutodetalhado 
                                                                    and fp.pagina    = 318))
                       or (:P318_FILTRARPRODUTOS = '0' and (:P318_IDPRODUTODETALHADO is null or i.idprodutodetalhado = :P318_IDPRODUTODETALHADO)) )
                group by pp.idusuario
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
