        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--iconRight
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 172
                items: {
                    P172_PAGINA: 318
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction mostrar-produto (
        name: Mostrar Produto
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P318_FILTRARPRODUTOS
        }
        clientSideCondition {
            type: item=value
            item: P318_FILTRARPRODUTOS
            value: 1
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P318_IDPRODUTODETALHADO
            }
            execution {
                sequence: 20
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: button
                button: @filtrarprodutos
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: button
                button: @filtrarprodutos
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P318_IDPRODUTODETALHADO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

