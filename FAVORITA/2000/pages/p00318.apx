    region relatório-de-comissões-por-produtos-vendidos-de-divulgação-detalhado (
        name: Relatório de Comissões por produtos Vendidos de Divulgação Detalhado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.idprodutodetalhado
                     , pck_util_fav.fnc_nomeprodutodetalhado(i.idprodutodetalhado,1) nomeproduto
                     , sum(i.valorcomissaoatendente * i.quantidade) valorcomissaoatendente
                     , sum(i.valorvenda * i.quantidade) valorvenda
                     , sum(i.quantidade)
                     , pp.idusuario
                     , pck_util_fav.fnc_nomeusuario(pp.idusuario) nomeusuario
                     , LISTAGG(pp.idpedido, '; ')
                         WITHIN GROUP (ORDER BY 1) Pedidos
                     , ( select pd.referencia
                         from favorita.produtos pd
                         where exists ( select 1
                                        from favorita.produtosdetalhados ppd
                                        where ppd.idproduto = pd.idproduto
                                          and ppd.idprodutodetalhado = i.idprodutodetalhado)) referencia
                     ,  ( select pd.nomeproduto
                         from favorita.produtos pd
                         where exists ( select 1
                                        from favorita.produtosdetalhados ppd
                                        where ppd.idproduto = pd.idproduto
                                          and ppd.idprodutodetalhado = i.idprodutodetalhado)) nomeprodutosref
                from favorita.itenspedidos i
                   , favorita.pedidos pp
                where pp.idpedido = i.idpedido
                  and pp.idusuario is not null
                  and i.idpromocaodivulgacao is not null
                  and :P318_TIPO = 0
                  and not exists ( select 1
                                   from favorita.classificacoespedidos cp
                                   where cp.idpedido = pp.idpedido
                                     and cp.idcaracteristicapedido = 25)
                  and ( trunc(pp.dataemissao) between :P318_DATAINI and :P318_DATAFIM)
                  and i.valorcomissaoatendente > 0
                  and (:P318_IDFILIALFAVORITAORIGEM is null or  pp.idfilialfavorita = :P318_IDFILIALFAVORITAORIGEM)
                  and ( (:P318_FILTRARPRODUTOS = '1' and exists ( select 1
                                                                  from filtrosprodutos fp
                                                                  where fp.idusuario = :P0_IDUSUARIO
                                                                    and fp.idprodutodetalhado = i.idprodutodetalhado 
                                                                    and fp.pagina    = 318))
                       or (:P318_FILTRARPRODUTOS = '0' and (:P318_IDPRODUTODETALHADO is null or i.idprodutodetalhado = :P318_IDPRODUTODETALHADO)) )
                group by pp.idusuario,i.idprodutodetalhado
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P318_TIPO = 0
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1476959332841840603
        }

