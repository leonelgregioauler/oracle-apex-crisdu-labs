page 561 (
    name: Cadastro de Perfis de Venda
    title: Cadastro de Perfis de Venda
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG_25"';
    }

    region cadastro-de-perfis-de-venda (
        name: Cadastro de Perfis de Venda
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P561_DESCRICAO (
        type: selectList
        label {
            label: Descrição
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Ativa;Ativa,Passiva;Passiva,Prospecção;Prospecção
        }
        layout {
            sequence: 30
            region: @cadastro-de-perfis-de-venda
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: DESCRICAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P561_IDPERFIL (
        type: selectList
        label {
            label: Perfil
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select descricao display_value
                     , idperfil return_value
                  from perfis
                  order by 1
                ```
        }
        layout {
            sequence: 20
            region: @cadastro-de-perfis-de-venda
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDPERFIL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P561_IDPERFILVENDA (
        type: hidden
        layout {
            sequence: 10
            region: @cadastro-de-perfis-de-venda
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDPERFILVENDA
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P561_PERCCOMISSAO (
        type: numberField
        label {
            label: % Comissão
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 40
            region: @cadastro-de-perfis-de-venda
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 99D00
            width: 5
        }
        source {
            type: databaseColumn
            databaseColumn: PERCCOMISSAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @cadastro-de-perfis-de-venda
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 560
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Incluir
        layout {
            sequence: 40
            region: @cadastro-de-perfis-de-venda
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P561_IDPERFILVENDA
        }
    )

    button delete (
        buttonName: DELETE
        label: Excluir
        layout {
            sequence: 20
            region: @cadastro-de-perfis-de-venda
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P561_IDPERFILVENDA
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @cadastro-de-perfis-de-venda
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P561_IDPERFILVENDA
        }
    )

    process fetch-row-from-perfisvendas (
        name: Fetch Row from PERFISVENDAS
        type: autoRowFetch
        source {
            tableName: PERFISVENDAS
            pkColumn: IDPERFILVENDA
            pkItem: P561_IDPERFILVENDA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 99866798464774977
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P561_IDPERFILVENDA is null then
                        select "#OWNER#"."SEQ_IDPERFILVENDA".nextval
                          into :P561_IDPERFILVENDA
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 99867174857774977
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-perfisvendas (
        name: Process Row of PERFISVENDAS
        type: autoRowProcessing
        target {
            tableName: PERFISVENDAS
            pkColumn: IDPERFILVENDA
            pkItem: P561_IDPERFILVENDA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 99867522066774977
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 99867955754774977
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 560
            }
        }
    )

)

