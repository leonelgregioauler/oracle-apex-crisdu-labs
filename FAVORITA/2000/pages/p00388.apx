                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region itens-pedidos-pedagios (
        name: Itens Pedidos Pedagios
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.iditempedagiorevista
                     , p.idpedagiorevista
                     , p.idprodutodetalhado
                     , favorita.pck_util_fav.fnc_nomeprodutodetalhado(p.idprodutodetalhado,:P0_IDIDIOMA) Nome
                     , p.quantidadevendida
                     , p.quantidadeestoque
                     , p.custo
                     , ROUND(p.venda,2)
                     , ROUND(p.pergestor*100,2)
                     , ROUND(p.perdistribuidor*100,2)
                     , ROUND(p.percliente*100,2)
                     , ROUND(p.margem,2)
                     , ROUND(p.custocliente,2)
                     , ROUND(p.custodistribuidor,2)
                     , ROUND(p.custoinadimplencia,2)
                     , ROUND(p.custoimpostos,2)
                     , ROUND(p.custooperacao,2)
                     , ROUND(p.mcu,2)
                     , ROUND(p.perlucro*100,2)
                     , ROUND(p.mct,2)
                     , ROUND(p.vlrinvestidoestoque,2)
                     , ROUND(p.lucroliqestoque,2)
                     , p.idultimaedicaoativo
                     , p.ultimaedicaoativo
                     , p.pagrevista
                  from favorita.itenspedagiosrevistas p
                 where p.idpedagiorevista = :P388_IDPEDAGIOREVISTA
                ```
        }
        layout {
            sequence: 60
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item!=value
            item: P388_RELATORIONOVO
            value: S
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Não foram encontrados dados nesta versão do relatório
        }
        advanced {
            savedReportMappingIdentifier: 1765972271882834301
        }

