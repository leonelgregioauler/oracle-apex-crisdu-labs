    region lista-de-produtos (
        name: Lista de Produtos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomeprodutodetalhado(pd.idprodutodetalhado,:P0_IDIDIOMA) "Produto Detalhado"
                     , pro.referencia || ' - ' || pck_util_fav.fnc_nomeproduto ( pro.idproduto,:P0_IDIDIOMA,'N') "Ref + Prod"
                     , pck_util_fav.fnc_siglagrade(pd.idgrade,:P0_IDIDIOMA) "Grade"
                     , pck_util_fav.fnc_nomecor (pd.idcor,:P0_IDIDIOMA) "Cor"
                     , pck_util_fav.fnc_nomecaracteristica (pd.idcaracteristica,:P0_IDIDIOMA) "Característica"
                     , t.qtdbonificado "Qtd Bonificado Total"
                     , t.qtdvenda "Qtd Venda Total"
                     --, t.qtddisponivel 
                     , t.qtdestoquefil6
                     + t.qtdestoquefil3
                     + t.qtdestoquefil2
                     + t.qtdestoquefil4
                     + t.qtdestoqueloja  "Qtd Estoques Total"
                     , t.vlrcusto "Custo"
                     , t.vlrvenda "Venda"
                     , t.pctgestor "%Gestor"
                     , t.pctdistribuidor "%Dist."
                     , t.pctconsultor "%Cons."
                     , round(t.vlrvenda - (t.vlrvenda*(pctconsultor/100)),2) "Custo Cli."
                     , round((t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) - ((t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) * ((t.pctgestor + t.pctdistribuidor) / 100 )),2) "Custo Distr"
                     , round((t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) - ((t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) * ((t.pctgestor + t.pctdistribuidor) / 100 ))
                      - ((t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) * pr.perinadimplencia),2) "Custo Inad."
                     , round((t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) - ((t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) * ((t.pctgestor + t.pctdistribuidor) / 100 )) - ((t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) * pr.perinadimplencia)
                      - ((t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) * pr.perimpostos),2)  "Custo Impostos"
                     , round((t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) - ((t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) * ((t.pctgestor + t.pctdistribuidor) / 100 )) - ((t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) * pr.perinadimplencia)- ((t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) * pr.perimpostos) 
                      - ((t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) * pr.peroperacao),2) "Custo Operação"
                     , round((t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) - ((t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) * ((t.pctgestor + t.pctdistribuidor) / 100 )) - ((t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) * pr.perinadimplencia)- ((t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) * pr.perimpostos) - ((t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) * pr.peroperacao)
                        - t.vlrcusto,2) "MCU"
                     , round(t.qtdvenda * ((t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) - ((t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) * ((t.pctgestor + t.pctdistribuidor) / 100 )) - ((t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) * pr.perinadimplencia)- ((t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) * pr.perimpostos) - ((t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) * pr.peroperacao) 
                        - t.vlrcusto),2) "MCT"
                     , round(t.vlrvenda / t.vlrcusto,2) "Markup"
                     , case
                         when (t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) <> 0 then
                           round(((t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) - ((t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) * ((t.pctgestor + t.pctdistribuidor) / 100 )) - ((t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) * pr.perinadimplencia)- ((t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) * pr.perimpostos) - ((t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) * pr.peroperacao) - t.vlrcusto)
                            / (t.vlrvenda - (t.vlrvenda*(pctconsultor/100))) * 100,2) 
                      else 0
                     end "Lucro %"
                     , ctgss.nomecategoria "Categoria"
                     , pck_util_fav.fnc_nomecategoria (pro.idcategoria ,:P0_IDIDIOMA) "Subcategoria"
                     , pck_util_fav.fnc_nomesubcategoria (pro.idsubcategoria ,:P0_IDIDIOMA) "Sub-subcategoria"
                     , t.nrpagina "Página"
                     , null  "Novidade"
                     , t.qtdvendafil6 "Qtd Venda CD Belém" 
                     , t.qtdvendafil3 "Qtd Venda CD CG"
                     , t.qtdvendafil2 "Qtd Venda CD Igrejinha"
                     , t.qtdvendafil4 "Qtd Venda CD Manaus"
                     , t.qtdvendaloja "Qtd Venda Lojas"
                     , t.qtdbonificadofil6 "Qtd Bonificado CD Belém" 
                     , t.qtdbonificadofil3 "Qtd Bonificado CD CG"
                     , t.qtdbonificadofil2 "Qtd Bonificado CD Igrejinha"
                     , t.qtdbonificadofil4 "Qtd Bonificado CD Manaus"
                     , t.qtdbonificadoloja "Qtd Bonificado CD Lojas"
                     , t.qtdestoquefil6 "Qtd Estoque CD Belém"
                     , t.qtdestoquefil3 "Qtd Estoque CD CG"
                     , t.qtdestoquefil2 "Qtd Estoque CD Igrejinha"
                     , t.qtdestoquefil4 "Qtd Estoque CD Manaus"
                     , t.qtdestoqueloja "Qtd Estoque CD Lojas"
                  from produtosdetalhados pd, 
                       produtos pro, 
                       categorias ctgs, 
                       categoriassite ctgss,
                       pedagiosrevistas pr, 
                       itenspedagiosrevistas2 t
                 where t.idprodutodetalhado = pd.idprodutodetalhado
                   and t.idpedagiorevista = pr.idpedagiorevista
                   and pd.idproduto = pro.idproduto  
                   and pro.idcategoria = ctgs.idcategoria
                   and ctgs.idcategoriasite = ctgss.idcategoriasite
                   and pr.idpedagiorevista = :P388_IDPEDAGIOREVISTA
                order by pro.nomeproduto, pd.idgrade, pd.idcor
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P388_RELATORIONOVO
            value: S
        }
