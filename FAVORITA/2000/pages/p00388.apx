    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 20
            region: @dados-do-pedágio
            slot: help
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Voltar
        layout {
            sequence: 10
            region: @dados-do-pedágio
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-reply
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 386
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process excluir (
        name: Excluir
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                  vnumber           number;
                  vdata             date;
                  vvarchar          varchar(50);
                begin
                  if v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                      pck_pedagiosrevistas_fav.prc_pedagiosrevistas ( pidpedagiorevista   => :P388_IDPEDAGIOREVISTA
                                                                    , pnomepedagiorevista => vvarchar
                                                                    , pidpais             => vnumber
                                                                    , pdatainicial        => vdata
                                                                    , pdatafinal          => vdata
                                                                    , pidedicaorevista    => vnumber
                                                                    , pidusaurio          => vnumber
                                                                    , pdatacriado         => vdata
                                                                    , pperinadimplencia   => vnumber
                                                                    , pperimpostos        => vnumber
                                                                    , pperoperacao        => vnumber
                                                                    , pmd5                => vvarchar
                                                                    , poperacao_dml       => voperacao_dml  );
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1544243104319967641
        }
        serverSideCondition {
            whenButtonPressed: @excluir
        }
    )

    process selectiona-pedagio-revista (
        name: Selectiona Pedagio Revista
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vdata             date;
                  vvarchar          varchar2(1000);
                  vdml              varchar2(1):='S';
                  vdataini          date := :P388_DATAINICIAL;
                  vdatafim          date := :P388_DATAFINAL;
                  --
                Begin
                  --
                  pck_pedagiosrevistas_fav.prc_pedagiosrevistas ( pidpedagiorevista   => :P388_IDPEDAGIOREVISTA
                                                                , pnomepedagiorevista => :P388_NOMEPEDAGIOREVISTA
                                                                , pidpais             => :P388_IDPAIS
                                                                , pdatainicial        => vdataini
                                                                , pdatafinal          => vdatafim
                                                                , pidedicaorevista    => :P388_IDEDICAOREVISTA
                                                                , pidusaurio          => :P0_IDUSUARIO
                                                                , pdatacriado         => :P388_DATACRIADO
                                                                , pperinadimplencia   => :P388_PERINADIMPLENCIA
                                                                , pperimpostos        => :P388_PERIMPOSTOS
                                                                , pperoperacao        => :P388_PEROPERACAO
                                                                , pmd5                => vvarchar
                                                                , poperacao_dml       => vdml  );
                  --
                  :P388_PERINADIMPLENCIA := 100 * :P388_PERINADIMPLENCIA;
                  :P388_PERIMPOSTOS := 100 * :P388_PERIMPOSTOS;
                  :P388_PEROPERACAO := 100 * :P388_PEROPERACAO;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1544242745304967637
        }
    )

)

