page 361 (
    name: Valores Por Categoria
    title: Valores Por Categoria
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region itens-vendidos-por-categoria (
        name: Itens vendidos Por Categoria
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ip.iditempedido
                     , ip.idpedido
                     , ip.idprodutodetalhado
                     , favorita.pck_util_fav.fnc_nomeprodutodetalhado( ip.idprodutodetalhado , :P0_IDIDIOMA) nomeproduto
                     , pr.idcategoria
                     , ( select cts.nomecategoria
                         from favorita.categoriassite cts
                         where cts.idcategoriasite = cas.idcategoriasite) categoria
                     , cas.idcategoriasite
                     , cas.nome subcategoria
                     , ip.valorvenda
                     , ip.quantidade
                     , ip.valorapagar
                from favorita.itenspedidos ip
                   , favorita.produtos pr
                   , favorita.categorias cas
                where ip.idproduto = pr.idproduto
                  and pr.idcategoria = cas.idcategoria
                  and ip.idpedido = :P361_IDPEDIDO
                order by 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Não encontrado o pedido ou nenhum pedido filtrado.
        }
        advanced {
            savedReportMappingIdentifier: 1473489394350801005
        }

        column CATEGORIA (
            type: plainText
            heading {
                heading: Categoria
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

