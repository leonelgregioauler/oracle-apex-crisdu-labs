    dynamicAction altera-pontos (
        name: Altera pontos
        execution {
            sequence: 20
        }
        when {
            event: keyup
            selectionType: columns
            interactiveGrid: @parâmetros-de-comportamento-adl
            columns: PERCADLDE
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT to_number(:PERCADLDE) * to_number((select c.valorparametro
                                                              from roman.parametroscredscore c
                                                              where c.nomeparametro = 'ADLPONTOS'))
                    FROM DUAL
                    ```
                itemsToSubmit: PERCADLDE
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: PONTOSADL
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction mostra-franquia (
        name: Mostra Franquia
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P656_TIPORELATORIO
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P656_FRANQUIAS
            }
            execution {
                sequence: 40
            }
            clientSideCondition {
                type: itemIsNotInList
                item: P656_TIPORELATORIO
                list: [
                    2
                    3
                ]
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P656_DISTRIBUIDOR
            }
            execution {
                sequence: 50
            }
            clientSideCondition {
                type: item!=value
                item: P656_TIPORELATORIO
                value: 3
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P656_FRANQUIAS
            }
            execution {
                sequence: 10
            }
            clientSideCondition {
                type: item=value
                item: P656_TIPORELATORIO
                value: 2
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P656_FRANQUIAS
            }
            execution {
                sequence: 20
            }
            clientSideCondition {
                type: item=value
                item: P656_TIPORELATORIO
                value: 3
            }
        )

        action native-show-3 (
            action: show
            affectedElements {
                selectionType: items
                items: P656_DISTRIBUIDOR
            }
            execution {
                sequence: 30
            }
            clientSideCondition {
                type: item=value
                item: P656_TIPORELATORIO
                value: 3
            }
        )

    )

