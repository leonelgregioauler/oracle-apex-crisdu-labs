        column IDFILIAL (
            type: selectList
            heading {
                heading: Franquia
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(nvl(p.apelido, p.nomepessoa)) display_value
                         , f.idfilial
                    from catal.pessoas p
                       , catal.filiais f
                    where p.idpessoa = f.idpessoa
                      and f.tipofilial = 'D' /*distribuidora*/
                      and f.ativo = 'S'
                    order by 1
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
