    region parâmetros-de-crédito-e-score-por-distribuidor (
        name: Parâmetros de Crédito e Score por Distribuidor
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDPARAMCREDSCOREDIST,
                       IDREPRESENTANTE,
                       NOMEPARAMETRO,
                       VALORPARAMETRO,
                       OBSERVACAOPARAMETRO
                from ROMAN.PARAMCREDSCOREDIST pr
                where (pr.idrepresentante  = :P656_DISTRIBUIDOR or :P656_DISTRIBUIDOR is null and exists ( select 1
                                                                                                           from catal.gerentes g
                                                                                                              , catal.representantes r
                                                                                                           where g.idgerente = r.idgerente
                                                                                                             and r.idrepresentante = pr.idrepresentante
                                                                                                             and ( :P656_FRANQUIAS is null or  g.idfilial = :P656_FRANQUIAS )))
                
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P656_TIPORELATORIO
            value: 3
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 375669968039152017
        }

