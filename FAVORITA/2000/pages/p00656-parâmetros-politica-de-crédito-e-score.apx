    pageItem P656_DISTRIBUIDOR (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(pidrepresentante => r.idrepresentante) display_value
                     , r.idrepresentante
                from catal.representantes r
                where r.ativo = 'S'
                  and (:P656_FRANQUIAS is null or exists (select 1
                                                          from catal.gerentes g
                                                          where g.idgerente  = r.idgerente 
                                                            and g.idfilial = :P656_FRANQUIAS))
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P656_FRANQUIAS
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
    )

    pageItem P656_FRANQUIAS (
        type: selectList
        label {
            label: Franquias:
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(p.apelido, p.nomepessoa)) display_value
                     , f.idfilial
                from catal.pessoas p
                   , catal.filiais f
                where p.idpessoa = f.idpessoa
                  and f.tipofilial = 'D' /*distribuidora*/
                  and f.ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
    )

    pageItem P656_TIPORELATORIO (
        type: radioGroup
        label {
            label: Tipo de Relatório:
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Parâmetros de Crédito e Score;1,Parâmetros de Crédito e Score por Filial;2,Parâmetros de Crédito e Score por Distribuidor;3,Parâmetros de Comportamento ADL;4,Parâmetros de Comportamento Score;5,Parâmetros de Score Histórico Pontos;6,Parâmetros de Score  Comportamentos Pontos;7,Parâmetros para liberar a Consulta Score  (Filial);8
            displayExtraValues: false
            displayNullValue: false
        }
