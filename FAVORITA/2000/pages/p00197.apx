    pageItem P197_ATENDENTE (
        type: selectList
        label {
            label: Atendente
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeusuario(u.idusuario) display_value
                     , u.idusuario return_value
                from usuarios u
                where exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.usuario = u.usuario 
                                 and ug.idgrupoatendimento in ( select ga.idgrupoatendimento
                                                                from roman.usuariosgruposatendimento ga
                                                                where ga.usuario = ( select usuario
                                                                                     from usuarios
                                                                                     where idusuario = :P0_IDUSUARIO ) ) )
                  and exists ( select 1
                               from pagamentospedidos p
                               where p.idusuariopagamento = u.idusuario )
                order by 1
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P197_CONSULTORA (
        type: popupLov
        label {
            label: Consultora
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' ('||nvl(p.cpf,p.documentoestrangeiro)||')' display_value
                     , v.idvendedora
                from vendedoras v
                   , pessoas p
                where p.idpessoa = v.idpessoa
                  and (:P197_DISTRIBUIDOR is null or v.idrepresentante = :P197_DISTRIBUIDOR)
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P197_DISTRIBUIDOR
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util_fav.fnc_verificaacesso(58005,:P0_IDUSUARIO) = 'S'
                ```
        }
        security {
            encryptSessionState: false
        }
    )

