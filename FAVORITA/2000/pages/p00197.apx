    branch (
        name: Go To Page 197
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 197
                items: {
                    P197_DATAINICIO: &P197_DATAINICIO.
                    P197_DATAFIM: &P197_DATAFIM.
                    P197_IDFORMAPAGAMENTO: &P197_IDFORMAPAGAMENTO.
                    P197_TIPORELATORIO: &P197_TIPORELATORIO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

