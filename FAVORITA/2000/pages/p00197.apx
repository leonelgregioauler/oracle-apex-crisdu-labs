    region pagamentos-detalhados-sistema-novo (
        name: Pagamentos Detalhados Sistema Novo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select vp.idpedido
                     , favorita.pck_util_fav.fnc_nomerepresentante(p.idrepresentante) Distribuidor
                     , favorita.pck_util_fav.fnc_nomevendedora(p.idvendedora) Vendedora
                     , trunc(vp.datavencimento) datavencimento
                     , trunc(pp.datapagamento) datapagamento
                     , pck_util_fav.fnc_formapagamento(pp.idformapagamento) formapagamento
                     , pp.valorpago
                     , pp.valorrecebido
                     , pp.situacaopagamento
                     , pp.nomeusuario 
                     , pp.descorigempagamento
                     , pp.numeroboleto
                     , pp.numerocomprovante
                from pedidos p
                   , vw_vencimentospedidos_fav vp
                   , vw_pagamentospedidos_fav pp
                where vp.idvencimentopedido = pp.idvencimentopedido
                  and p.idpedido = vp.idpedido
                  and p.datacancelamento is null
                  and pp.idsituacao in (20, 30, 40)
                  and ( ( :P197_IDFILIALROMANCE is null or p.idfilialromance = :P197_IDFILIALROMANCE )
                     or p.idfilialromance = roman.pck_romance.fnc_filialusuario(v('APP_USER')) )  
                  and ( :P197_TIPODATA = 'N' or ( :P197_TIPODATA = 'B' and trunc(pp.datapagamento)  between to_date(:P197_DATAINICIO,'dd/mm/rrrr') and to_date(:P197_DATAFIM,'dd/mm/rrrr') )
                                             or ( :P197_TIPODATA = 'V' and trunc(vp.datavencimento) between to_date(:P197_DATAINICIO,'dd/mm/rrrr') and to_date(:P197_DATAFIM,'dd/mm/rrrr') ) )
                  and pp.ididioma = :P0_IDIDIOMA
                  and ( :P197_IDPEDIDO is null or p.idpedido = :P197_IDPEDIDO )
                  and ( :P197_NUMEROBOLETO is null or pp.numeroboleto like '%'||:P197_NUMEROBOLETO||'%' )
                  and ( :P197_IDFORMAPAGAMENTO is null or pp.idformapagamento = :P197_IDFORMAPAGAMENTO )
                  and ( :P197_DISTRIBUIDOR is null or p.idrepresentante = :P197_DISTRIBUIDOR )
                  and ( :P197_CONSULTORA is null or p.idvendedora = :P197_CONSULTORA )
                  and ( :P197_ATENDENTE is null or pp.idusuariopagamento = :P197_ATENDENTE )
                  and ( :P197_NRCOMPROVANTE is null or pp.numerocomprovante like '%'||:P197_NRCOMPROVANTE||'%' )
                  and ( :P197_ORIGEM = 'N' or pp.origempagamento = :P197_ORIGEM )
                  and ( :P197_IDCONTABANCARIA is null or pp.idcontabancaria = :P197_IDCONTABANCARIA)
                  and exists ( select 1
                               from vencimentospedidos v
                               where v.idvencimentopedido = pp.idvencimentopedido )
                  -- Maicon Aimi - 11216382 - 09/10/2025 - add nvl com p.idfilialfavorita
                  -- and ( pck_util_fav.fnc_verificaacesso(58005,:P0_IDUSUARIO) = 'S' and ( :P197_IDFILIALFAVORITAORIGEM is null or pp.idfilialorigem = :P197_IDFILIALFAVORITAORIGEM ) 
                  --  or ( pck_util_fav.fnc_retornaidfilialfavusuario(:P0_IDUSUARIO) = :P197_IDFILIALFAVORITAORIGEM and pp.idfilialorigem = :P197_IDFILIALFAVORITAORIGEM )  )
                  and (    ( pck_util_fav.fnc_verificaacesso(58005,:P0_IDUSUARIO) = 'S' and ( :P197_IDFILIALFAVORITAORIGEM is null or nvl(pp.idfilialorigem,p.idfilialfavorita) = :P197_IDFILIALFAVORITAORIGEM ))
                        or ( pck_util_fav.fnc_retornaidfilialfavusuario(:P0_IDUSUARIO) = :P197_IDFILIALFAVORITAORIGEM and nvl(pp.idfilialorigem,p.idfilialfavorita) = :P197_IDFILIALFAVORITAORIGEM ))
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P197_TIPORELATORIO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum pagamento encontrado!
        }
        advanced {
            savedReportMappingIdentifier: 478246647285508250
        }

