    region pagamentos-detalhados-sistema-antigo (
        name: Pagamentos Detalhados Sistema Antigo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select b.idpedido
                     , favorita.pck_util_fav.fnc_nomerepresentante(b.idrepresentante) Distribuidor
                     , favorita.pck_util_fav.fnc_nomevendedora(b.idvendedora) Vendedora
                     , trunc(b.datavencimento) datavencimento
                     , trunc(b.databaixa) datapagamento
                     , decode(b.tipoquitacao,'D','Depósito','M','Em Mãos','C','Cartão de Crédito','B','Boleto') formapagamento
                     , b.valorcobrado valorpago
                     , s.descricao situacaopagamento
                     , b.numero numeroboleto
                from catal.situacoes s
                   , catal.boletos b
                where s.idsituacao = b.situacao 
                 and b.situacao in ('O', 'Q', 'H') 
                 and ( ( :P197_IDFILIALROMANCE is null or b.idfilial = :P197_IDFILIALROMANCE )
                     or b.idfilial = roman.pck_romance.fnc_filialusuario(v('APP_USER')) )   
                 and ( :P197_TIPODATA = 'N' or ( :P197_TIPODATA = 'B' and trunc(b.databaixa)  between to_date(:P197_DATAINICIO,'dd/mm/rrrr') and to_date(:P197_DATAFIM,'dd/mm/rrrr') )
                                            or ( :P197_TIPODATA = 'V' and trunc(b.datavencimento) between to_date(:P197_DATAINICIO,'dd/mm/rrrr') and to_date(:P197_DATAFIM,'dd/mm/rrrr') ) )
                  and ( :P197_IDPEDIDO is null or b.idpedido = :P197_IDPEDIDO )
                 and ( :P197_NUMEROBOLETO is null or b.numero like '%'||:P197_NUMEROBOLETO||'%' )
                 and ( :P197_DISTRIBUIDOR is null or b.idrepresentante = :P197_DISTRIBUIDOR )
                 and ( :P197_CONSULTORA is null or b.idvendedora = :P197_CONSULTORA )
                 and ( :P197_NRCOMPROVANTE is null or b.numerocomprovante like '%'||:P197_NRCOMPROVANTE||'%' )
                 and ( :P197_IDCONTABANCARIA is null or b.idcontabancaria = :P197_IDCONTABANCARIA)  
                 and ( :P197_IDFILIALFAVORITAORIGEM is null )
                 and ( :P197_ORIGEM = 'N' )
                 and ( :P197_IDFORMAPAGAMENTO is null
                 or  ( case when b.tipoquitacao = 'D' then 4
                            when b.tipoquitacao = 'C' then 3
                            when b.tipoquitacao = 'M' then 2
                            when b.tipoquitacao = 'B' then 1 
                        end  ) = :P197_IDFORMAPAGAMENTO )
                 and exists ( select 1
                               from catal.pedidos p
                               where p.idpedido = b.idpedido )
                 order by b.idpedido                            
                                 
                                 
                
                               
                  
                 
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P197_TIPORELATORIO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum pagamento encontrado!
        }
        advanced {
            savedReportMappingIdentifier: 545305178822930505
        }

