    pageItem P197_IDCONTABANCARIA (
        type: selectList
        label {
            label: Conta Bancaria
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.beneficiario||' ('||b.nomebanco||' - Ag: '||c.agencia||'- CC: '||c.conta||')' d
                     , c.idcontabanc r
                from roman.contasbancarias c
                   , roman.bancos b
                where b.idbanco = c.idbanco
                  and c.ativo = 'S'
                  and c.usosetorcobranca = 'S'
                order by 1;
                ```
        }
        layout {
            sequence: 140
