    pageItem P197_DISTRIBUIDOR (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROMAN.pck_romance.fnc_nomerepresentante(idrepresentante) DISPLAY_VALUE
                     , idrepresentante RETURN_VALUE
                from representantes
                where (:P197_IDFILIALROMANCE is null or
                    ( :P197_IDFILIALROMANCE is not null and idgerente in ( select idgerente from gerentes where idfilial = :P197_IDFILIALROMANCE) ))
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P197_IDFILIALROMANCE
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
