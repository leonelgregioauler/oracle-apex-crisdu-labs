page 101 (
    name: Login Page
    alias: LOGIN_DESKTOP
    title: Login Page
    appearance {
        pageTemplate: @/login
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            .t-PageBody--login .t-Body {
            background: url('#APP_IMAGES#Call-Center_compact.jpg' );
            background-size: 100% auto;
            }
            
            span.t-Login-logo {
              background-image: url('#APP_IMAGES#favorita_2.png');
              background-size: cover;
              width: 150px;
              height: 150px;
            }
            
            .t-Login-logo {
                background-color: transparent;
            }
            ```
    }
    security {
        authentication: public
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region background-image (
        name: Background Image
        type: staticContent
        layout {
            sequence: 20
            slot: backgroundImage
        }
        appearance {
            template: @/image
            templateOptions: [
                #DEFAULT#
                t-ImageRegion--auto
                t-ImageRegion--cover
                t-ImageRegion--square
                t-ImageRegion--noFilter
            ]
        }
        image {
            fileUrl: #APP_FILES#Call-Center.jpg
        }
    )

    region optimus-favorita (
        name: Optimus Favorita
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/login
            templateOptions: #DEFAULT#
        }
        headerAndFooter {
            footerText:
                ```html
                <a href="#WORKSPACE_IMAGES#TeamViewer_Setup.exe"> Acesso Remoto (Team Viewer)</a>
                &nbsp;&nbsp;&nbsp;&nbsp;
                ```
        }
        settings {
            outputAs: text
        }
    )

    pageItem P101_PASSWORD (
        type: password
        label {
            label: Senha
            alignment: left
        }
        layout {
            sequence: 20
            region: @optimus-favorita
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
            cssClasses: icon-login-password
            width: 20
            valuePlaceholder: Informe sua senha!
        }
        validation {
            maxLength: 100
        }
        sessionState {
            storage: request
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P101_USERNAME (
        type: textField
        label {
            label: Usuário
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 10
            region: @optimus-favorita
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
            width: 20
            valuePlaceholder: Informe o usuário
        }
        validation {
            maxLength: 100
        }
        security {
            encryptSessionState: false
        }
    )

    button login (
        buttonName: LOGIN
        label: Log In
        layout {
            sequence: 30
            region: @optimus-favorita
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--pillStart
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button primeiroacesso (
        buttonName: PRIMEIROACESSO
        label: Meu Primeiro Acesso
        layout {
            sequence: 40
            region: @optimus-favorita
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--pill
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 271
                items: {
                    P271_IDUSUARIO:
                    P271_NOVASENHA:
                    P271_USUARIO:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation valida-acesso-ao-sistema (
        name: Valida acesso ao sistema
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuariossistemas
                where usuario = upper(:P101_USERNAME)
                  and idsistema = 2000
                ```
        }
        error {
            errorMessage: Você não tem premissão de acesso a este sistema.
            associatedItem: @P101_USERNAME
        }
    )

    validation valida-horários-de-acesso (
        name: Valida Horários de Acesso
        execution {
            sequence: 20
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vidusuario number;
                  vidsistema number := 2000;
                begin
                  select idusuario
                  into vidusuario
                  from usuarios
                  where upper(usuario) = upper(:P101_USERNAME);
                  --
                  if not pck_util_fav.fnc_validahorariosacesso ( vidusuario, vidsistema) then
                    return('Você não tem permissão de acesso neste horário');
                  end if;
                end;
                ```
        }
        error {
            associatedItem: @P101_USERNAME
        }
    )

    process clear-page-s-cache (
        name: Clear Page(s) Cache
        type: clearSessionState
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 786864773498030626
        }
    )

    process get-username-cookie (
        name: Get Username Cookie
        type: executeCode
        source {
            plsqlCode: :P101_USERNAME := apex_authentication.get_login_username_cookie;
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 786864304854030626
        }
    )

    process login (
        name: Login
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                apex_authentication.login(
                    p_username => :P101_USERNAME,
                    p_password => :P101_PASSWORD );
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 786863565941030626
        }
    )

    process set-username-cookie (
        name: Set Username Cookie
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                apex_authentication.send_login_username_cookie (
                    p_username => lower(:P101_USERNAME) );
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 786863966583030626
        }
    )

)

