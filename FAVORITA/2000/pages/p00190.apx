page 190 (
    name: Relatório de Itens Indisponíveis
    title: Relatório de Itens Indisponíveis
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        authentication: public
        pageAccessProtection: unrestricted
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util_fav.fnc_verificaacesso(40815,:P0_IDUSUARIO) = 'S'
                ```
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region venda-perdida (
        name: Venda Perdida
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeprodutodetalhado(i.idprodutodetalhado,1) nome 
                     , sum(i.quantidade) quantidade
                     , sum(i.quantidade * i.valorvenda) valor
                     , ( select e.quantidade
                         from estoques e
                         where e.idfilialfavorita = ( select a.idfilialfavoritaorigem
                                                      from atendimentosestoques a
                                                      where a.idfilialfavoritadestino = :P0_IDFILIALFAVORITA )
                           and e.idprodutodetalhado = i.idprodutodetalhado ) qtdestoquemanaus
                     , ( select e.quantidade
                         from estoques e
                         where e.idfilialfavorita = :P0_IDFILIALFAVORITA
                           and e.idprodutodetalhado = i.idprodutodetalhado ) qtdestoqueloja
                     , ( select sum(ic.quantidadecomprada)
                         from itenscomprastransferencias ic
                         where ic.idprodutodetalhado = i.idprodutodetalhado
                           and exists ( select 1
                                        from comprastransferencias c
                                        where c.idcompratransferencia = ic.idcompratransferencia
                                          and c.idfilialfavoritadestino = :P0_IDFILIALFAVORITA
                                          and c.idtipocomptransrem = 1
                                          and c.idsituacao in (0,3,5) )
                         group by ic.idprodutodetalhado ) qtdjasolicitada     
                from vw_itensindisppedidos_fav i
                where i.ididioma = :P0_IDIDIOMA
                  and (i.idfilialfavorita = :P190_IDFILIALFAVORITA or :P190_IDFILIALFAVORITA is null)
                  and ( :P190_DATAINICIO is null 
                   or exists ( select 1
                               from pedidos p
                               where p.idpedido = i.idpedido
                                 and p.idfilialfavorita = :P0_IDFILIALFAVORITA
                                 and trunc(p.dataemissao) between to_date(:P190_DATAINICIO,'DD/MM/RRRR') and to_date(:P190_DATAFIM,'DD/MM/RRRR') 
                                 and pck_util_fav.fnc_retornapedidocancelado(p.idpedido) = 'N' ) )
                  and not exists ( select 1
                                   from classificacoespedidos c
                                   where c.idpedido = i.idpedido
                                     and c.idcaracteristicapedido = 25 )
                group by i.idprodutodetalhado
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Verifique os Filtros Informados!
        }
        advanced {
            savedReportMappingIdentifier: 447206171630777567
        }

        column NOME (
            type: plainText
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column QTDESTOQUELOJA (
            type: plainText
            heading {
                heading: Qtd Estoque Loja
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column QTDESTOQUEMANAUS (
            type: plainText
            heading {
                heading: Qtd Estoque Favorita
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column QTDJASOLICITADA (
            type: plainText
            heading {
                heading: Qtd já Solicitada
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1
                    from dual
                    where pck_util_fav.fnc_verificaacesso(40815,:P0_IDUSUARIO) = 'S'
                    ```
            }
        )

        column QUANTIDADE (
            type: plainText
            heading {
                heading: Quantidade não Vendida
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column VALOR (
            type: plainText
            heading {
                heading: Valor Total
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            appearance {
                formatMask: FML999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 2414031 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn NOME (
                sequence: 1
            )

            displayColumn QTDESTOQUELOJA (
                sequence: 5
            )

            displayColumn QTDESTOQUEMANAUS (
                sequence: 4
            )

            displayColumn QTDJASOLICITADA (
                sequence: 6
            )

            displayColumn QUANTIDADE (
                sequence: 2
            )

            displayColumn VALOR (
                sequence: 3
            )

            sort (
                column: QUANTIDADE
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            aggregate (
                column: QUANTIDADE
            )

            aggregate (
                column: VALOR
            )

        )

    )

    pageItem P190_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            formatMask: DD/MM/RRRR
            width: 30
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P190_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            formatMask: DD/MM/RRRR
            width: 30
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P190_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Filial Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct favorita.pck_util_fav.fnc_nomefilialfavorita(u.idfilialfavorita) showvalue
                     , u.idfilialfavorita returnvalue
                from favorita.usuariosfiliaisfavorita u
                where ( u.idfilialfavorita = :P0_idfilialfavorita 
                      or :P0_idusuario = u.idusuario)
                  and exists ( select 1
                               from favorita.filiaisfavorita f
                               where f.idfilialfavorita = u.idfilialfavorita
                                 and f.tipofilial = 'L')
                order by 1;
                ```
            displayExtraValues: false
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button solicitar-transferencia (
        buttonName: SOLICITAR_TRANSFERENCIA
        label: Solicitar Transferência
        layout {
            sequence: 10
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process inicia-a-transferencia (
        name: Inicia a transferencia
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_comprastransf_fav.prc_transferenciaindisploja(pidusuario => :P0_IDUSUARIO,
                                                                    pdatainicio => :P190_DATAINICIO,
                                                                    pdatafim => :P190_DATAFIM,
                                                                    patendente => :P190_ATENDENTE);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Transferência solicitada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 241406072900554361
        }
        serverSideCondition {
            whenButtonPressed: @solicitar-transferencia
        }
    )

    branch (
        name: Go To Page 190
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 190
                items: {
                    P190_DATAINICIO: &P190_DATAINICIO.
                    P190_DATAFIM: &P190_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

