page 134 (
    name: Cadastro de Tipos de Protocolos de Atendimento
    title: Cadastro de Tipos de Protocolos de Atendimento
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro (
        name: Cadastro
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P134_DESCRICAO (
        type: textField
        label {
            label: Descrição
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @cadastro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P134_IDTIPOPROTOCOLO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @cadastro
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P134_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @cadastro
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P134_OPERACAO_DML (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @cadastro
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 20
            region: @cadastro
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P134_IDTIPOPROTOCOLO
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 10
            region: @cadastro
            slot: help
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P134_IDTIPOPROTOCOLO
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 50
            region: @cadastro
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 102
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 40
            region: @cadastro
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P134_IDTIPOPROTOCOLO
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 30
            region: @cadastro
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process consulta-tipo-protocolo (
        name: Consulta Tipo Protocolo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  #OWNER#.PCK_PROTOCOLOSATENDIMENTOS_FAV.PRC_TIPOSPROTOCOLOSATEND( PIDTIPOPROTOCOLO => :P134_IDTIPOPROTOCOLO,
                                                                                   PDESCRICAO => :P134_DESCRICAO,
                                                                                   PMD5 => :P134_MD5,
                                                                                   POPERACAO_DML => 'S');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 16466768821881725
        }
    )

    process limpar-campos (
        name: Limpar Campos
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 16467091528881728
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    process processo-dml-em-tipos-de-protocolos (
        name: Processo DML em Tipos de Protocolos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  voperacao_dml varchar2(1);
                  --
                begin
                  --
                  if v('REQUEST') = 'EXCLUIR' then
                    --
                    voperacao_dml := 'D';
                    --
                  elsif v('REQUEST') = 'INSERIR' then
                    --
                    voperacao_dml := 'I';
                    --
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    --
                    voperacao_dml := 'U';
                    --
                  end if;
                  --
                  #OWNER#.PCK_PROTOCOLOSATENDIMENTOS_FAV.PRC_TIPOSPROTOCOLOSATEND( PIDTIPOPROTOCOLO => :P134_IDTIPOPROTOCOLO,
                                                                                   PDESCRICAO => :P134_DESCRICAO,
                                                                                   PMD5 => :P134_MD5,
                                                                                   POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro Atualizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 28281335513165449
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                Select 1
                from dual
                where v('REQUEST') in ( 'ATUALIZAR', 'INSERIR', 'EXCLUIR' )
                ```
        }
    )

)

