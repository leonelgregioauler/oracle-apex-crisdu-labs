page 424 (
    name: Associados SPC
    title: Associados SPC
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG_23"';
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @franquias-associadas
            slot: subRegions
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region form-on-associadosspc (
        name: Form on ASSOCIADOSSPC
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region franquias-associadas (
        name: Franquias Associadas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select *
                from roman.filiaisassociadosspc
                where idassociadosspc = :P424_IDASSOCIADOSPC
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 371154763570861804
        }

        savedReport 3711609 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDFILIALASSOCIADOSPC
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDASSOCIADOSSPC
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDFILIAL
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @LIBERACADASTRO
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column IDASSOCIADOSSPC (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDASSOCIADOSSPC
                dataType: number
            }
            default {
                type: expression
                language: sql
                sqlExpression: :P424_IDASSOCIADOSPC
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDFILIAL (
            type: selectList
            heading {
                heading: Franquia
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select fl.nome display_value
                         , fl.idfilial return_value
                    from roman.vw_filiais fl
                    where fl.tipofilial = 'D'
                       and fl.ativo = 'S'
                       and fl.ididioma in (1,6)
                       and fl.grupo is not null;
                    ```
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDFILIAL
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDFILIALASSOCIADOSPC (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDFILIALASSOCIADOSPC
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: roman.seq_idfilialassociadosspc
            }
        )

        column LIBERACADASTRO (
            type: selectList
            heading {
                heading: Libera p/ Cadastro?
                alignment: center
            }
            lov {
                type: staticValues
                staticValues: STATIC:Sim;S,Não;N
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: LIBERACADASTRO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        page {
            size: a4
            units: millimeters
            width: 297
            height: 210
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    pageItem P424_IDASSOCIADOSPC (
        type: hidden
        layout {
            sequence: 10
            region: @form-on-associadosspc
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P424_LIBERACADASTRO (
        type: selectList
        label {
            label: Libera Cadastro?
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @form-on-associadosspc
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: LIBERACADASTRO
            used: always
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P424_NOMEASSOCIADO (
        type: textField
        label {
            label: <b>Nome do Associado</b>
            alignment: left
        }
        layout {
            sequence: 20
            region: @form-on-associadosspc
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 70
        }
        validation {
            maxLength: 500
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select a.nomeassociado
                from roman.associadosspc a
                where a.idassociadospc = :P424_IDASSOCIADOSPC
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P424_NOMEASSOCIADO
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: never
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P424_NOMEASSOCIADO
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process fetch-row-from-associadosspc (
        name: Fetch Row from ASSOCIADOSSPC
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  if :P424_IDASSOCIADOSPC is null then 
                    --
                    :P424_IDASSOCIADOSPC := roman.seq_idassociadospc.nextval;
                    --
                  else
                    --
                    :P424_IDASSOCIADOSPC := :P424_IDASSOCIADOSPC;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 5823830901469278
        }
    )

    process franquias-associadas-save-interactive-grid-data (
        name: Franquias Associadas - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @franquias-associadas
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 371155494127861811
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('CREATE','SAVE')
                ```
        }
    )

    process process-row-of-associadosspc (
        name: Process Row of ASSOCIADOSSPC
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                 --
                 if v('REQUEST') = 'CREATE' then
                 --
                 insert into roman.associadosspc (idassociadospc,
                                                 nomeassociado)
                 values ( :P424_IDASSOCIADOSPC
                        , :P424_NOMEASSOCIADO);
                 --
                 elsif v('REQUEST') = 'SAVE' then
                 --
                 update roman.associadosspc sp
                 set sp.nomeassociado = :P424_NOMEASSOCIADO
                 where sp.idassociadospc = :P424_IDASSOCIADOSPC;
                 --
                 end if;
                 --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Processado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 5824242266469278
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('CREATE','SAVE')
                ```
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 423
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @cancel
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 424
                items: {
                    P424_IDASSOCIADOSPC: &P424_IDASSOCIADOSPC.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('CREATE','SAVE')
                ```
        }
    )

)

