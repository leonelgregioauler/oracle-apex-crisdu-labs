page 243 (
    name: Pedidos com Trocas
    title: Pedidos com Trocas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pedidos-com-trocas (
        name: Pedidos com Trocas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.idpedido
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||v.idpedido ,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>'  urlpedido
                     , v.idvalorcaracteristica
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||v.idvalorcaracteristica ,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>'  urltroca
                     , v.filialromance
                     , v.observacaoprotocolo
                     , pck_util_fav.fnc_nomeusuario(v.idusuariomontou) usuariomontou
                     , v.justificativaprotocolo
                     , v.motivo
                     , v.descricaohistoricopedidotroca
                     , usuariosolicitou
                     , favorita.pck_util_fav.fnc_nomeusuario(v.idusuario) Usuario_Solicitacao
                from vw_analise_de_trocas_fav v
                where ( :P243_DATAINICIO is null or trunc(v.dataclassificado) between to_date(:P243_DATAINICIO,'DD/MM/RRRR') and to_date(:P243_DATAFIM,'DD/MM/RRRR') )
                  and ( :P243_IDUSUARIO is null or v.idusuariomontou = :P243_IDUSUARIO )
                  and ( :P243_IDFILIALFAVORITA is null or exists ( select 1
                                                                   from atendimentosfiliaisrmc a
                                                                   where a.idfilialfavoritaorigem = :P243_IDFILIALFAVORITA
                                                                     and a.idfilialdestino        = v.idfilialromance ) )
                  and ( :P243_VERTODASTROCAS = 'S' 
                   or exists ( select 1
                               from usuarios u
                               where exists ( select 1
                                              from roman.usuariosgruposatendimento ug
                                              where ug.usuario = u.usuario 
                                                and ug.idgrupoatendimento in ( select uu.idgrupoatendimento
                                                                               from roman.usuariosgruposatendimento uu
                                                                               where uu.usuario = v('APP_USER') ) ) ) )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 341143509922519648
        }

