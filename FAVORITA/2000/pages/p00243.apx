                layout {
                    sequence: 1
                }
            )

        )

    )

    pageItem P243_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            formatMask: DD/MM/RRRR
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P243_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            formatMask: DD/MM/RRRR
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P243_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Estoque
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nomefilialfavorita display_value
                     , f.idfilialfavorita return_value
                from vw_filiaisfavorita f
                where f.tipofilial in ('Estoque','Loja')
                  and exists ( select 1
                               from usuariosfiliaisfavorita uf
                               where uf.idfilialfavorita = f.idfilialfavorita
                                 and uf.consultar = 'S' 
                                 and uf.idusuario = :P0_IDUSUARIO )
                order by 2
                ```
            nullDisplayValue: - Selecione o Estoque -
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P243_IDUSUARIO (
        type: selectList
        label {
            label: Usuário
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeusuario(u.idusuario) display_value
                     , u.idusuario return_value
                from usuarios u
                where ( pck_util_fav.fnc_verificaacesso(40526,:P0_IDUSUARIO) = 'S'  
                   or exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.usuario = u.usuario 
                                 and ug.idgrupoatendimento in ( select uu.idgrupoatendimento
                                                                from roman.usuariosgruposatendimento uu
                                                                where uu.usuario = v('APP_USER') ) ) )
                  and ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P243_VERTODASTROCAS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_verificaacesso(40526,:P0_IDUSUARIO) acesso
                from dual
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 243
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 243
                items: {
                    P243_DATAINICIO: &P243_DATAINICIO.
                    P243_DATAFIM: &P243_DATAFIM.
                    P243_IDUSUARIO: &P243_IDUSUARIO.
                    P243_IDFILIALFAVORITA: &P243_IDFILIALFAVORITA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

