        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 4779417 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100000
            }

            displayColumn DESCRICAOHISTORICOPEDIDOTROCA (
                sequence: 10
            )

            displayColumn FILIALROMANCE (
                sequence: 6
            )

