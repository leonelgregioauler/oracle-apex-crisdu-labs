    validation new (
        name: New
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.conquistoulevoucupons clc
                where clc.dataretirada is not null
                  and clc.idconquistoulevoucupom = :P672_CUPOM
                  and :P672_RETIRADOPOR != 'A'
                ```
        }
        error {
            errorMessage: Atenção, campo retirado por, precisa ser informado.
        }
        serverSideCondition {
            type: never
        }
    )

    process busca-dados (
        name: "Busca Dados "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                --
                vvendedora     varchar2(100);
                vdocumento     varchar2(15);
                vdistribuidor  varchar2(100);
                vretiradopor   varchar2(100);
                vquemretira    varchar2(100);
                --
                begin
                  --
                  select roman.pck_romance.fnc_nomevendedora(clc.idvendedora) vendedora
                       ,(select nvl(p.cpf,p.documentoestrangeiro)
                         from catal.vendedoras v
                            , catal.pessoas p 
                         where p.idpessoa = v.idpessoa
                            and v.idvendedora = clc.idvendedora) documento      
                       ,(select roman.pck_romance.fnc_nomerepresentante(vv.idrepresentante)
                         from catal.vendedoras vv 
                         where vv.idvendedora = clc.idvendedora) distribuidor      
                       , clc.retiradopor retirado
                       , clc.quemretira --(select descricao from table(catal.pck_util.fnc_siglasistema('TIPO_QUEMRETIROUBRINDECUPOM_MCONQLEVOU',clc.quemretira)) ) quemretira
                   into vvendedora, vdocumento, vdistribuidor , vretiradopor, vquemretira
                from roman.conquistoulevoucupons clc
                where clc.idconquistoulevoucupom = :P672_CUPOM;
                  --
                  :P672_VENDEDORA    := vvendedora;
                  :P672_DOCUMENTO    := vdocumento;
                  :P672_DISTRIBUIDOR := vdistribuidor;
                  :P672_RETIRADOPOR  := vretiradopor;
                  :P672_QUEMRETIRA   := vquemretira;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1805294864496885303
        }
    )

    process processo-entregar-brinde (
        name: Processo Entregar Brinde
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidusuario              number;
                  vidcupom                number := :P672_CUPOM;
                  vidfilial               number;
                  vdataretirada_anterior  date;
                  videstoque              number;
                  vmotivo                 varchar2(200);
                  vidpais                 number;
                
                  cursor c_itens is
                    select distinct
                           it.iditemconqlevcupom
                         , it.qtditem
                         , cb.idproddetal_fav
                      from roman.itensconqlevcupons        it
                         , roman.classificacoesbrindesclub cb
                     where it.idconquistoulevoucupom = vidcupom
                       and cb.idbrindeclube          = it.idbrindeclube
                       and (it.idclassificacao       = cb.idclassificacao
                            or (it.idclassificacao is null and cb.idclassificacao is null))
                       and (it.idcaracteristica      = cb.idcaracteristica
                            or (it.idcaracteristica is null and cb.idcaracteristica is null))
                       and cb.idproddetal_fav        is not null;
                begin
                  select u.idusuario into vidusuario from catal.usuarios u where u.usuario = v('APP_USER');
                
                  select clc.dataretirada into vdataretirada_anterior
                    from roman.conquistoulevoucupons clc
                   where clc.idconquistoulevoucupom = vidcupom;
                
                  update roman.conquistoulevoucupons clc
                     set clc.retiradopor      = decode(:P672_QUEMRETIRA,'C','E','D')
                       , clc.dataretirada     = sysdate
                       , clc.idusuarioentrega = vidusuario
                   where clc.idconquistoulevoucupom = vidcupom;
                
                  if vdataretirada_anterior is null then
                    select g.idfilial
                         , f.idpais
                      into vidfilial
                         , vidpais
                      from roman.guiasentregasbrindes g
                         , roman.guiasentregascupons gc
                         , favorita.filiaisfavorita f
                     where gc.idconquistoulevoucupom = vidcupom
                       and gc.idguiaentregabrinde    = g.idguiaentregabrinde
                       and g.idfilial                = f.idfilialfavorita
                       and rownum = 1;
                    --
                    if vidpais = 1 then -- Apenas Brasil movimenta estoque
                      --
                        vmotivo := 'Entrega de Brinde Conquistou Levou - Cupom '||vidcupom;
                
                        for r_item in c_itens loop
                          videstoque := null;
                          favorita.pck_estoque_fav.prc_movimentosestoques( pidestoque          => videstoque
                                                                         , pidfilialfavorita   => vidfilial
                                                                         , pidusuario          => vidusuario
                                                                         , pidprodutodetalhado => r_item.idproddetal_fav
                                                                         , piditempedido       => null, piditemcompratransf => null
                                                                         , pquantidade         => -r_item.qtditem
                                                                         , pmotivo             => vmotivo);
                        end loop;
                    end if;
                  end if;
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1804845348006075201
        }
        serverSideCondition {
            whenButtonPressed: @entregabrinde
        }
    )

    branch (
        name: Go To Page 671
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 671
                request: 671
            }
        }
        serverSideCondition {
            whenButtonPressed: @voltar
        }
    )

)

