    region brindes-cupom (
        name: Brindes Cupom
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select b.nomebrinde 
                     , b.idbrindeclube
                     , (select cc.nomeclassif
                        from roman.conquistoulevouclassificacoes cc
                        where cc.idclassificacao = it.idclassificacao) classificação
                     , (select cr.nomecaracteristica
                        from roman.conquistoulevoucaracteristicas cr
                        where cr.idcaracteristica = it.idcaracteristica ) característica
                from roman.brindesclub b
                   , roman.itensconqlevcupons it 
                where it.idbrindeclube = b.idbrindeclube
                  and it.idconquistoulevoucupom = :P672_CUPOM
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1804738152907363141
        }

        column CARACTERÍSTICA (
            type: plainText
            heading {
                heading: Característica
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

