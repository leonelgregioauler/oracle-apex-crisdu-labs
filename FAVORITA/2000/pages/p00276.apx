    process confirma-análise-do-pagamento (
        name: Confirma análise do pagamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_movimentarpedidos_fav.prc_confirmaanalisepgtocartao(pidpagamentocartaocredito => :P276_IDEDITAR,
                                                                          pidusuario => :P0_IDUSUARIO);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Analisado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 774924433238524235
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMAR
        }
    )

    branch (
        name: Go To Page 276
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 276
                items: {
                    P276_IDPEDIDO: &P276_IDPEDIDO.
                    P276_ANALISADO: &P276_ANALISADO.
                    P276_DATAINICIO: &P276_DATAINICIO.
                    P276_DATAFIM: &P276_DATAFIM.
                    P276_CONFIRMADO: &P276_CONFIRMADO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

