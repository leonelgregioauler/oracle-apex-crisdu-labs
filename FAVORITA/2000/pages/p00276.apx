page 276 (
    name: Pagamentos via Cartão de Crédito
    title: Pagamentos via Cartão de Crédito
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_confirmar(pid)
            {
              document.getElementById("P276_IDEDITAR").value = pid;
              apex.submit('CONFIRMAR');
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pagamentos-via-cartão-de-crédito (
        name: Pagamentos Via Cartão de Crédito
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pc.idpagamentocartaocredito
                     , pc.idpedido
                     , p.vendedora
                     , p.representante
                     , p.dataemissao
                     , p.valorapagar
                     , pc.datapagamento
                     , pc.xmlenvio as xmlenvio
                     , pc.xmlretorno as xmlretorno
                     , pc.descconfirmado
                     , pc.descanalisado
                     , case 
                         when pc.analisado = 'S' then
                           to_char(pc.dataanalisado,'DD/MM/RRRR HH24:MI:SS')||' por '||pc.usuarioanalisado
                       else
                         'Aguardando Análise'
                       end analisado
                     , case 
                         when pc.analisado = 'N' then
                           '<a href="javascript:fnc_confirmar('|| idpagamentocartaocredito ||')" ><img src="#APP_IMAGES#ok.png"  border="0"></a>'
                       else
                         ' - '
                       end confirmar
                     , p.filialfavorita  
                from vw_pagamentoscartaocredito_fav pc
                   , vw_pedidos_fav p
                where pc.idpedido = p.idpedido
                  and p.ididioma = 1
                  and ( :P276_DATAINICIO is null or trunc(pc.datapagamento) between to_date(:P276_DATAINICIO,'DD/MM/RRRR') and to_date(:P276_DATAFIM,'DD/MM/RRRR') )
                  and ( :P276_IDPEDIDO is null or pc.idpedido = :P276_IDPEDIDO )
                  and ( :P276_ANALISADO = 'T' or pc.analisado = :P276_ANALISADO )
                  and ( :P276_CONFIRMADO = 'T' or pc.confirmado = :P276_CONFIRMADO )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 774922786318524218
        }

