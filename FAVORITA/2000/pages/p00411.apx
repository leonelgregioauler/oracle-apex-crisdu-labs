    region itens-indisponíveis-por-estoque-resumido (
        name: Itens Indisponíveis por Estoque - Resumido
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomefilialfavorita(filial) estoque
                     , data
                     , count(1) qtd
                from(
                select distinct min(li.dataalteracao)
                     , li.idpedido
                     , to_char(li.dataalteracao,'mm/rrrr') data
                     , max(( select e.idfilialfavorita
                            from favorita.estoques e
                            where e.idestoque = i.idestoque)) filial
                from favorita.itensindisponiveispedidos i
                    ,logfavorita.log_itenspedidos li
                where i.idpedido  = li.idpedido
                  and i.idestoque = li.idestoque
                  and li.tipoalteracao = 'DELETE'
                  and trunc(li.dataalteracao) between to_date(:P411_DATAINICIAL, 'mm/rrrr') and to_date(:P411_DATAFINAL, 'mm/rrrr')
                  and (:P411_IDFILIALFAVORITA is null or i.idestoque in ( select e.idestoque 
                                                                          from estoques e
                                                                          where e.idestoque      = i.idestoque 
                                                                          and e.idfilialfavorita = :P411_IDFILIALFAVORITA )  )
                group by li.idpedido
                       , to_char(li.dataalteracao,'mm/rrrr')
                       , idfilialfavorita  )
                group by filial
                       , data
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
