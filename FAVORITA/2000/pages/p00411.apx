page 411 (
    name: Itens Indisponíveis por Estoque
    title: Itens Indisponíveis por Estoque
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region itens-indisponíveis-por-estoque-detalhado (
        name: Itens Indisponíveis por Estoque - Detalhado
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomefilialfavorita(filial) estoque
                     , idpedido
                     , pck_util_fav.fnc_nomeprodutodetalhado(idprodutodetalhado, 1) produtodetalhado
                     , data
                     , dataalteracao
                from(
                select distinct min(li.dataalteracao) dataalteracao
                     , li.idpedido
                     , li.idprodutodetalhado
                     , to_char(li.dataalteracao,'mm/rrrr') data
                     , max(( select e.idfilialfavorita
                            from favorita.estoques e
                            where e.idestoque = i.idestoque)) filial
                from favorita.itensindisponiveispedidos i
                    ,logfavorita.log_itenspedidos li
                where i.idpedido  = li.idpedido
                  and i.idestoque = li.idestoque
                  and li.tipoalteracao = 'DELETE'
                  and trunc(li.dataalteracao) between to_date(:P411_DATAINICIAL, 'mm/rrrr') and to_date(:P411_DATAFINAL, 'mm/rrrr')
                  and (:P411_IDFILIALFAVORITA is null or i.idestoque in ( select e.idestoque 
                                                                          from estoques e
                                                                          where e.idestoque      = i.idestoque 
                                                                          and e.idfilialfavorita = :P411_IDFILIALFAVORITA )  )
                  and (:P411_IDPEDIDO is null or i.idpedido = :P411_IDPEDIDO)
                  and (:P411_IDPRODUTODETALHADO is null or i.idprodutodetalhado = :P411_IDPRODUTODETALHADO)
                group by li.idpedido
                       , li.idprodutodetalhado
                       , to_char(li.dataalteracao,'mm/rrrr')
                       , idfilialfavorita  )
                group by filial
                       , idpedido
                       , idprodutodetalhado
                       , data
                       , dataalteracao
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P411_TIPO = 'D'
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 1588539177698378903
        }

