page 562 (
    name: Relatorio de Perfis de Atendimento
    title: Relatorio de Perfis de Atendimento
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region report (
        name: Report 1
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.IDPERFILATENDIMENTO, A.IDPERFIL, A.IDPERFILVENDA, A.IDIDIOMA
                     , P.DESCRICAO Perfil, V.DESCRICAO "Perfil Venda", I.IDPAIS
                     , A.idgrupoatendimento "Grupo Atendimento"
                  from PERFISATENDIMENTOS A
                     , PERFIS             P
                     , PERFISVENDAS       V
                     , IDIOMAS            I
                 where A.IDPERFILVENDA = V.IDPERFILVENDA
                   and V.IDPERFIL      = P.IDPERFIL
                   and A.IDIDIOMA      = I.IDIDIOMA
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 563
                items: {
                    P563_IDPERFILATENDIMENTO: #IDPERFILATENDIMENTO#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 99878416815784281
        }

        column "Grupo Atendimento" (
            type: plainTextBasedOnLov
            heading {
                heading: Grupo Atendimento
            }
            lov {
                lov: @lov-gruposatendimentos
            }
            layout {
                sequence: 44
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column IDIDIOMA (
            type: plainText
            heading {
                heading: Idioma
            }
            layout {
                sequence: 4
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column IDPAIS (
            type: plainText
            heading {
                heading: País
            }
            layout {
                sequence: 34
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column IDPERFIL (
            type: hidden
            heading {
                heading: Idperfil
            }
            layout {
                sequence: 2
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDPERFILATENDIMENTO (
            type: hidden
            heading {
                heading: Idperfilatendimento
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDPERFILVENDA (
            type: hidden
            heading {
                heading: Idperfilvenda
            }
            layout {
                sequence: 3
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
            security {
                escapeSpecialChars: false
            }
        )

        column PERFIL (
            type: plainText
            heading {
                heading: Perfil
            }
            layout {
                sequence: 14
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column "Perfil Venda" (
            type: plainText
            heading {
                heading: Perfil Venda
            }
            layout {
                sequence: 24
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 998995 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn "Grupo Atendimento" (
                sequence: 8
            )

            displayColumn IDIDIOMA (
                sequence: 4
            )

            displayColumn IDPAIS (
                sequence: 7
            )

            displayColumn IDPERFIL (
                sequence: 2
            )

            displayColumn IDPERFILATENDIMENTO (
                sequence: 1
            )

            displayColumn IDPERFILVENDA (
                sequence: 3
            )

            displayColumn PERFIL (
                sequence: 5
            )

            displayColumn "Perfil Venda" (
                sequence: 6
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Novo Perfil Atendimento
        layout {
            sequence: 30
            region: @report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 563
                clearCache: 563
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

