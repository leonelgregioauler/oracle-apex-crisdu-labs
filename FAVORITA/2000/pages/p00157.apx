    process envia-email (
        name: envia email
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  catal.pck_util.prc_enviaemail(ppara => :P157_EMAIL,
                                                passunto => '[Informativo] Evento '||:P157_IDCHAMADO ||' respondido.',
                                                ptexto => 'Olá!'||chr(10)||chr(10)||
                                                          'O evento nrº '||:P157_IDCHAMADO||' foi respondido!'||chr(10)||chr(10)||
                                                          'Atenciosamente,'||chr(10)||        
                                                          'TI - Romance Moda' );
                
                  for i in ( select ( select email 
                             from pessoas
                             where idpessoa = ( select idpessoa
                                                from usuarios
                                                where usuario = u.usuario ) ) email
                             from roman.usuarioschamados u
                             where u.idchamado= :P157_IDCHAMADO )
                  loop
                    catal.pck_util.prc_enviaemail(ppara => i.EMAIL,
                                                  passunto => '[Informativo] Chamado '||:P157_IDCHAMADO ||' respondido.',
                                                  ptexto => 'Olá!'||chr(10)||chr(10)||
                                                            'O evento nrº '||:P157_IDCHAMADO||' foi respondido!'||chr(10)||chr(10)||
                                                            'Você está recebendo este email por estar vinculado a este evento.'||chr(10)||chr(10)||
                                                            'Atenciosamente,'||chr(10)||        
                                                            'TI - Romance Moda' );
                
                  end loop;
                end;
                ```
        }
        execution {
            sequence: 80
        }
        successMessage {
            successMessage: Email enviado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 30148649894404614
        }
        serverSideCondition {
            type: never
        }
    )

