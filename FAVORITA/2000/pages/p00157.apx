    region pessoas-envolvidas (
        name: Pessoas Envolvidas
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select u.idusuarioSCHAMADO
                     , u.IDCHAMADO
                     , roman.pck_romance.fnc_nomeusuario(u.usuario) usuario
                     , ( select email 
                         from pessoas
                         where idpessoa = ( select idpessoa
                                            from usuarios
                                            where usuario = u.usuario ) ) email
                from roman.usuarioschamados u
                where u.idchamado = :P157_IDCHAMADO 
                order by usuario
                ```
        }
        layout {
            sequence: 25
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P157_IDCHAMADO
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: -
        }
        componentAdvanced {
            stripHtml: true
        }

        column EMAIL (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Email
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

        column IDCHAMADO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column IDUSUARIOSCHAMADO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: Retirar
            }
            layout {
                sequence: 1
            }
            link {
                target: {
                    type: url
                    url: "javascript:apex.submit({request:'DELETARUSUARIO',set:{'P74_IDUSUARIOSCHAMADO':'#IDUSUARIOSCHAMADO#'}});"
                }
                linkText: <img src="#IMAGE_PREFIX#e2.gif" alt="">
            }
            sorting {
                sortable: false
            }
        )

        column USUARIO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

    )

