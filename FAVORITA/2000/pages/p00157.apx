    button anexararquivo (
        buttonName: anexararquivo
        label: Anexar Arquivo
        layout {
            sequence: 10
            region: @anexos
            slot: copy
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 160
                items: {
                    P160_IDCHAMADO: &P157_IDCHAMADO.
                    P160_IDANEXOEVENTO:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P157_IDCHAMADO is not null
                  and :P157_SITUACAO != 2
                ```
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 20
            region: @eventos
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 43
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button encerrar (
        buttonName: ENCERRAR
        label: Encerrar
        layout {
            sequence: 90
            region: @eventos
            slot: top
