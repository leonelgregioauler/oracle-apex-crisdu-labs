page 157 (
    name: Cadastro de Eventos/Solicitações
    title: Cadastro de Eventos/Solicitações
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='Deseja encerrar o evento ?';
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function  fnc_encerrachamado()
            { 
            
              vchamado = document.getElementById('P73_IDCHAMADO').value; 
              window.open('f?p=&APP_ID.:78:&SESSION.::NO::P78_IDCHAMADO:'+vchamado ,'finaliza','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=700,height=600,left=350,top=300','_blank'); 
              void(0);
             
            	
            }
            
            function incluiusuario()
            {
              vchamado = document.getElementById('P73_IDCHAMADO').value; 
              window.open('f?p=&APP_ID.:76:&SESSION.::NO::P76_IDUSUARIOSCHAMADO,P76_IDCHAMADO:,'+vchamado ,'page','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=400,height=300,left=5,top=5','_blank'); void(0);
             
            }
            
            function imprimir()
            {
            vid = document.getElementById('P73_IDCHAMADO').value;
            var njanela = window.open('f?p=&APP_ID.:71:&SESSION.::NO::P71_IDEVENTO:'+vid,'IMPRIME', 'toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=800,height=600,left=250,top=100','_blank'); void(0);
            njanela.focus();
            }
            
            
            function abremanutencao()
            {
              vchamado = document.getElementById('P73_IDCHAMADO').value; 
              window.open('f?p=&APP_ID.:73:&SESSION.::NO::P73_IDCHAMADO:'+vchamado ,'manutencao','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=800,height=500,left=100,top=100','_blank'); void(0);
             
            }
            
            function doLoad()
            {
            setTimeout( "refresh()", 120*1000 );
            }
            ```
        executeWhenPageLoads: doLoad();
    }
    readOnly {
        type: always
    }
    security {
        formAutoComplete: true
    }
    advanced {
        enableDuplicatePageSubmissions: false
        reloadOnSubmit: always
        duplicateSubmissionUrl: Clique apenas uma vez para salvar o chamado.
    }
    help {
        helpText: Não há ajuda disponível para esta página.
    }

    region anexos (
        name: Anexos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDANEXOEVENTO,
                       IDCHAMADO,
                       sys.dbms_lob.getlength(ATTACH_DATA) download,
                       ATTACH_MIMETYPE,
                       ATTACH_FILENAME,
                       ATTACH_LAST_UPDATE,
                       ATTACH_CHARSET
                from roman.ANEXOSEVENTOS
                where idchamado = :P157_IDCHAMADO
                  and publico = 'S'
                ```
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P157_IDCHAMADO
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: -
        }
        componentAdvanced {
            stripHtml: true
        }

        column ATTACH_CHARSET (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                alignment: center
            }
            layout {
                sequence: 6
            }
        )

        column ATTACH_FILENAME (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Aquivo anexado
                alignment: center
            }
            layout {
                sequence: 4
            }
        )

        column ATTACH_LAST_UPDATE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 5
            }
        )

        column ATTACH_MIMETYPE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Tipo do arquivo
                alignment: center
            }
            layout {
                sequence: 3
            }
        )

        column DOWNLOAD (
            reportColumnQueryId: 3
            derivedColumn: N
            type: downloadBlob
            heading {
                heading: Download
                alignment: center
            }
            layout {
                sequence: 7
            }
            blobAttributes {
                tableOwner: ROMAN
                tableName: ANEXOSEVENTOS
                blobColumn: ATTACH_DATA
                primaryKeyColumn1: IDANEXOEVENTO
                mimeTypeColumn: ATTACH_MIMETYPE
                filenameColumn: ATTACH_FILENAME
                lastUpdatedColumn: ATTACH_LAST_UPDATE
                charSetColumn: ATTACH_CHARSET
            }
        )

        column IDANEXOEVENTO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column IDCHAMADO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

    )

    region eventos (
        name: Eventos
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
    )

    region históricos (
        name: Históricos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idhistoricochamado
                     , idchamado
                     , datahistorico
                     , descricao
                     , usuario
                     , roman.pck_romance.fnc_emailusuario(pusuario => trim(upper(:P157_USUARIO))) email
                     , DATAFIM 
                from roman.historicochamados
                where idchamado = :P157_idchamado
                  and publico = 'S'
                order by idhistoricochamado
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P157_IDCHAMADO
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: " - "
        }
        messages {
            whenNoDataFound: Nenhum histórico incluído.
        }
        componentAdvanced {
            stripHtml: true
        }

        column DATAFIM (
            reportColumnQueryId: 7
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column DATAHISTORICO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

        column DESCRICAO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Observação
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

        column EMAIL (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 7
            }
        )

        column IDCHAMADO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column IDHISTORICOCHAMADO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column USUARIO (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Analista
                alignment: center
            }
            layout {
                sequence: 6
            }
            sorting {
                sortable: false
            }
        )

