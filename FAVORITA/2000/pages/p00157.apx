    process reabrir-evento (
        name: Reabrir Evento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  update roman.chamados c
                  set c.idsituacao = 0
                    , DATAATENDIDO = null
                    , PERCCONCLUIDO = 0
                    , idsituacaokanban = 600
                  where c.idchamado = :P157_IDCHAMADO;
                  --
                  insert into roman.historicochamados (idhistoricochamado, idchamado, datahistorico, descricao, email, usuario, datafim,situacao)
                  values ( roman.seq_idhistoricochamado.nextval, :P157_IDCHAMADO, sysdate, 'Ticket reaberto.','N',v('APP_USER'),sysdate,'R');
                  --
                end;
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 30149409032404615
        }
        serverSideCondition {
            whenButtonPressed: @reabrir
        }
    )

