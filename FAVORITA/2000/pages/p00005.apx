    pageItem P5_DESCONTINUADO (
        type: radioGroup
        label {
            label: Descontinuado
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Sim;S,Não;N
            displayExtraValues: false
            nullDisplayValue: Todos
            nullReturnValue: T
        }
        layout {
            sequence: 40
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        default {
            type: static
            staticValue: T
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P5_IDFORNECEDOR (
        type: selectList
        label {
            label: Fornecedor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefornecedor(f.idfornecedor)||' - '|| p.CNPJ display_value
                      , f.idfornecedor  return_value
                  from catal.fornecedores f
                     , catal.pessoas p
                where p.idpessoa = f.idpessoa
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 30
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P5_IDPRODUTODETALHADO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @produtos-detalhados
            slot: regionBody
