    dynamicAction selecionar-pedidos-para-transferir-de-remessa (
        name: Selecionar Pedidos Para Transferir de Remessa
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .descontinuado
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    update produtosdetalhados
                    set descontinuado = 'S' 
                    where idprodutodetalhado = :P5_IDPRODUTODETALHADO;
                    
                    commit;
                    ```
                itemsToSubmit: P5_IDPRODUTODETALHADO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    /*$(".descontinuado").each(function(idx) {
                        
                      var selecionado = $(".descontinuado").eq(idx).is(":checked"); 
                      
                      if ( selecionado ) {
                          
                        var idprodutodetalhado   = $(".idprodutodetalhado").eq(idx).text();
                        $("#P5_IDPRODUTODETALHADO").val(idprodutodetalhado);
                          
                        console.log('Idproduto: ' + idprodutodetalhado + ' ---- ' + $("#P5_IDPRODUTODETALHADO").val(idprodutodetalhado));
                         
                        apex.submit( { request:"DESCONTINUAR" } )  
                      } 
                       
                    });*/
                    
                    var elemento= this.triggeringElement.parentElement.parentElement
                    
                    var idprodutodetalhado = elemento.getElementsByClassName('idprodutodetalhado')[0].innerHTML;
                    
                    $("#P5_IDPRODUTODETALHADO").val(idprodutodetalhado);
                    
                    apex.submit( { request:"DESCONTINUAR" } ) 
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

