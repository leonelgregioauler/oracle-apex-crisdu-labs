    region produtos-detalhados (
        name: Produtos Detalhados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select vv.idprodutodetalhado
                     , '<a class="idprodutodetalhado">'||vv.idprodutodetalhado||'</a>' produtodetalhado
                     , vv.produto
                     , case 
                         when nvl(vv.descontinuado, 'N') = 'N' then 
                           '<input type="checkbox" name="selecionar" class="descontinuado">' 
                         else
                           '<input type="checkbox" checked="checked" name="selecionar" class="descontinuado">'
                       end selecionar
                     , vv.idcaracteristica
                     , vv.caracteristica
                     , vv.idcor
                     , vv.cor
                     , vv.idgrade
                     , vv.grade
                     , vv.idcodigobarra
                     , vv.codbarra
                     , vv.ativo
                     , fp.idfornecedorproduto
                     , vv.idncm
                     , vv.idespecie
                     , vv.idcstorigem
                     , vv.idcest
                     , vv.idtipodeitemsped
                from vw_produtosdetalhados_fav vv
                   , fornecedoresprodutos fp
                where vv.idproduto = fp.idproduto
                  and vv.ididioma = :P0_IDIDIOMA
                  and (:P5_MORTEPROGRAMADA is null 
                        or exists (select 1 
                                     from produtosdescontinuadospais 
                                    where idprodutodetalhado = vv.idprodutodetalhado 
                                      and idedicaorevista = :P5_MORTEPROGRAMADA)
                      )
                  and (:P5_IDFORNECEDOR is null or :P5_IDFORNECEDOR = fp.idfornecedor)
                  and (:P5_DESCONTINUADO = 'T' or (:P5_DESCONTINUADO = 'S' and   vv.descontinuado = 'S' ) 
                                               or (:P5_DESCONTINUADO = 'N' and nvl(vv.descontinuado, 'N') = 'N') );
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1565060679266778344
        }

