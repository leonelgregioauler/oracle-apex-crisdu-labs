    )

    pageItem P5_MORTEPROGRAMADA (
        type: selectList
        label {
            label: Morte Programada
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome, idedicaorevista
                  from edicoesrevistas
                 where tipovenda = 'R'
                 order by 2 desc
                ```
            nullDisplayValue: Desconsiderar
        }
        layout {
            sequence: 50
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

