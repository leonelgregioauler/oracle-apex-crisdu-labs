page 538 (
    name: Itens de Grupos
    title: Itens de Grupos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 40%
        height: 40%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"Confirma exclusão do registro?"';
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region itens-de-grupos (
        name: Itens de Grupos
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P538_DATAALT (
        type: hidden
        layout {
            sequence: 50
            region: @itens-de-grupos
            slot: regionBody
        }
        appearance {
            formatMask: dd/mm/rrrr hh24:mi:ss
        }
        source {
            type: databaseColumn
            databaseColumn: DATAALT
            used: always
        }
        default {
            type: expression
            plsqlExpression: TO_DATE(TO_CHAR(SYSDATE,'DD/MM/RRRR HH24:MI:SS'),'DD/MM/RRRR HH24:MI:SS')
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P538_IDGRUPOSPRETRANSF (
        type: hidden
        layout {
            sequence: 20
            region: @itens-de-grupos
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDGRUPOSPRETRANSF
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P538_IDITENSGRUPOSPRETRANSF (
        type: hidden
        layout {
            sequence: 10
            region: @itens-de-grupos
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDITENSGRUPOSPRETRANSF
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P538_IDPRODUTODETALHADO (
        type: popupLov
        label {
            label: Produto
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sharedComponent
            lov: @lov-produtosdetalhados
        }
        layout {
            sequence: 30
            region: @itens-de-grupos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: IDPRODUTODETALHADO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P538_IDUSUARIOALT (
        type: hidden
        layout {
            sequence: 40
            region: @itens-de-grupos
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDUSUARIOALT
            used: always
        }
        default {
            type: expression
            plsqlExpression: :P0_IDUSUARIO
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P538_MENSAGEM (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @itens-de-grupos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Incluir
        layout {
            sequence: 50
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P538_IDITENSGRUPOSPRETRANSF
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 30
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P538_IDITENSGRUPOSPRETRANSF
        }
    )

    button fechaatualiza (
        buttonName: FECHAATUALIZA
        label: Fechar e Atualizar
        layout {
            sequence: 20
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 536
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: never
        }
    )

    process fechar (
        name: Fechar
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 23440033485909510
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DELETE
        }
    )

    process fetch-row-from-itensgrupospretransferencia (
        name: Fetch Row from ITENSGRUPOSPRETRANSFERENCIA
        type: autoRowFetch
        source {
            tableName: ITENSGRUPOSPRETRANSFERENCIA
            pkColumn: IDITENSGRUPOSPRETRANSF
            pkItem: P538_IDITENSGRUPOSPRETRANSF
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 23419040001529031
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P538_IDITENSGRUPOSPRETRANSF is null then
                        select "#OWNER#"."SEQ_IDITENSGRUPOSPRETRANSF".nextval
                          into :P538_IDITENSGRUPOSPRETRANSF
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 23419416415529032
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-itensgrupospretransferencia (
        name: Process Row of ITENSGRUPOSPRETRANSFERENCIA
        type: autoRowProcessing
        target {
            tableName: ITENSGRUPOSPRETRANSFERENCIA
            pkColumn: IDITENSGRUPOSPRETRANSF
            pkItem: P538_IDITENSGRUPOSPRETRANSF
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada!
        }
        advanced {
            executionMappingIdentifier: 23419851514529032
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,DELETE
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 23420232387529032
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: never
        }
    )

    process valida (
        name: Valida
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  v_grupo varchar2(200);
                  v_error exception;
                BEGIN
                
                  begin
                    SELECT descricaogrupo
                      INTO v_grupo
                      FROM gruposPreTransferencia
                     WHERE idgrupospretransf = (select IDGRUPOSPRETRANSF
                                                  from itensgrupospretransferencia
                                                 where idProdutoDetalhado = :P538_IDPRODUTODETALHADO) ;
                  exception
                    when others then null;
                  end;
                  
                  if v_grupo is not null then
                    apex_util.set_session_state('P538_MENSAGEM', 'Produto já cadastrado no grupo "'||v_grupo||'"');
                    raise v_error;
                  end if;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: &P538_MENSAGEM.
        }
        advanced {
            executionMappingIdentifier: 23087273943306850
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    branch (
        name: VoltaPara
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 538
                items: {
                    P538_IDITENSGRUPOSPRETRANSF:
                    P538_IDPRODUTODETALHADO:
                    P538_IDGRUPOSPRETRANSF: &P538_IDGRUPOSPRETRANSF.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE
        }
    )

)

