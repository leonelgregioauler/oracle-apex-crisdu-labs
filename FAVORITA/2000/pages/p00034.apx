page 34 (
    name: Cadastro Vendas Limitadas
    title: Vendas Limitadas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 60%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region vendas-limitadas (
        name: Vendas Limitadas
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P34_ATIVO (
        type: radioGroup
        label {
            label: Situação
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-situacao
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @vendas-limitadas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: staticValue
            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P34_IDPRODUTODETALHADO (
        type: popupLov
        label {
            label: Produto Detalhado
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sharedComponent
            lov: @lov-produtosdetalhados
        }
        layout {
            sequence: 20
            region: @vendas-limitadas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 70
            valuePlaceholder: " - Selecione o produto Detalhado - "
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P34_IDVENDALIMITADA (
        type: hidden
        layout {
            sequence: 10
            region: @vendas-limitadas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P34_MD5 (
        type: hidden
        layout {
            sequence: 50
            region: @vendas-limitadas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P34_OPERACAO_DML (
        type: hidden
        layout {
            sequence: 60
            region: @vendas-limitadas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P34_QUANTIDADEMAXIMA (
        type: numberField
        label {
            label: Quantidade Máxima
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 30
            region: @vendas-limitadas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 50
            region: @vendas-limitadas
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P34_IDVENDALIMITADA
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 40
            region: @vendas-limitadas
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P34_IDVENDALIMITADA
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 30
            region: @vendas-limitadas
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 33
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 20
            region: @vendas-limitadas
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P34_IDVENDALIMITADA
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @vendas-limitadas
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P34_IDVENDALIMITADA
        }
    )

    validation idprodutodetalhado-obrigatório (
        name: IDPRODUTODETALHADO obrigatório
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P34_IDPRODUTODETALHADO
        }
        error {
            errorMessage: Produto detalhado deve ter um valor.
            associatedItem: @P34_IDPRODUTODETALHADO
        }
    )

    validation quantidademaxima-inteiro (
        name: QUANTIDADEMAXIMA inteiro
        execution {
            sequence: 30
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  verro varchar2(1000);
                begin
                  if instr(:P34_QUANTIDADEMAXIMA, ',') > 0 or
                     instr(:P34_QUANTIDADEMAXIMA,'.') > 0 then
                    --
                    return 'Quantidade deve ser um número inteiro';
                    --
                  else
                    null;
                  end if;
                end;
                ```
        }
        error {
            associatedItem: @P34_QUANTIDADEMAXIMA
        }
    )

    validation quantidademaxima-maior-que (
        name: QUANTIDADEMAXIMA maior que 0
        execution {
            sequence: 40
        }
        validation {
            plsqlExpression: :P34_QUANTIDADEMAXIMA > 0
        }
        error {
            errorMessage: "Quantidade deve ser maior que zero (0) "
            associatedItem: @P34_QUANTIDADEMAXIMA
        }
        serverSideCondition {
            type: expression
            plsqlExpression: instr(:P34_QUANTIDADEMAXIMA, '.') = 0
        }
    )

    validation quantidademaxima-obrigatório (
        name: QUANTIDADEMAXIMA obrigatório
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P34_QUANTIDADEMAXIMA
        }
        error {
            errorMessage: Quantidade máxima deve ter um valor.
            associatedItem: @P34_QUANTIDADEMAXIMA
        }
    )

    process consulta-vendas-limitadas (
        name: Consulta Vendas Limitadas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                #OWNER#.PCK_COMERCIAL_FAV.PRC_VENDASLIMITADAS(
                  PIDVENDALIMITADA => :P34_IDVENDALIMITADA,
                  PIDPRODUTODETALHADO => :P34_IDPRODUTODETALHADO,
                  PQUANTIDADEMAXIMA => :P34_QUANTIDADEMAXIMA,
                  PATIVO => :P34_ATIVO,
                  PMD5 => :P34_MD5,
                  POPERACAO_DML => 'S');
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 3010812088146404
        }
    )

    process limpar-campos-ao-sair (
        name: Limpar Campos ao Sair
        type: clearSessionState
        execution {
            sequence: 10
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 3011801051146414
        }
    )

    process limpar-campos-para-adicionar (
        name: Limpar Campos para Adicionar
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 3011967514146415
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    process operação-dml-em-vendas-limitadas (
        name: Operação DML em Vendas Limitadas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  #OWNER#.PCK_COMERCIAL_FAV.PRC_VENDASLIMITADAS(
                    PIDVENDALIMITADA => :P34_IDVENDALIMITADA,
                    PIDPRODUTODETALHADO => :P34_IDPRODUTODETALHADO,
                    PQUANTIDADEMAXIMA => :P34_QUANTIDADEMAXIMA,
                    PATIVO => :P34_ATIVO,
                    PMD5 => :P34_MD5,
                    POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 3024707304330411
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 34
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

)

