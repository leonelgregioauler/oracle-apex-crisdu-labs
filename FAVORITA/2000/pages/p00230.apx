page 230 (
    name: Funcionários
    title: Funcionários
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 30%
        height: 60%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region funcionários (
        name: Funcionários
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P230_AFASTAMENTO (
        type: radioGroup
        label {
            label: <b>Afastamento</b>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-simnao
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 100
            region: @funcionários
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select nvl(f.afastamento,'N')
                from catal.funcionarios f
                where f.idfuncionario = :P230_IDFUNCIONARIO
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P230_ATIVO (
        type: radioGroup
        label {
            label: <b>Ativo</b>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-simnao
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @funcionários
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P230_IDCARGO (
        type: plugin/select
        label {
            label: <b>Cargo</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nome    display_value
                     , c.idcargo return_value
                from roman.cargos c
                order by 1
                ```
        }
        layout {
            sequence: 40
            region: @funcionários
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P230_IDFUNCIONARIO (
        type: hidden
        layout {
            sequence: 20
            region: @funcionários
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P230_IDGERENTE (
        type: plugin/select
        label {
            label: <b>Gerente</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.gerente||' - '||f.nome display_value
                     , f.idgerente return_value
                from roman.vw_filiais f
                where f.ativo = 'S'
                  and f.idgerente is not null
                order by 1
                ```
            nullDisplayValue: - Selecione o gerente -
        }
        layout {
            sequence: 10
            region: @funcionários
            slot: regionBody
            alignment: left
            column: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P230_IDPESSOA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @funcionários
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P230_IDUSUARIO (
        type: hidden
        layout {
            sequence: 70
            region: @funcionários
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P230_MD5 (
        type: hidden
        layout {
            sequence: 80
            region: @funcionários
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P230_OPERACAO_DML (
        type: hidden
        layout {
            sequence: 90
            region: @funcionários
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 40
            region: @funcionários
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P230_IDFUNCIONARIO
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 10
            region: @funcionários
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P230_IDFUNCIONARIO
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 30
            region: @funcionários
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 85
                items: {
                    P85_IDPESSOA: &P230_IDPESSOA.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 20
            region: @funcionários
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P230_IDFUNCIONARIO
        }
    )

    process atualiza-afastamento (
        name: Atualiza afastamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update catal.funcionarios f
                     set f.afastamento = :P230_AFASTAMENTO
                   where f.idfuncionario = :P230_IDFUNCIONARIO;
                
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 802036618836046502
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

    process consulta-funcionários (
        name: Consulta Funcionários
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P230_IDFUNCIONARIO is not null then
                  --
                  #OWNER#.PCK_CADASTROS_FAV.PRC_FUNCIONARIOS (
                    PIDFUNCIONARIO => :P230_IDFUNCIONARIO,
                    PIDPESSOA => :P230_IDPESSOA,
                    PIDCARGO => :P230_IDCARGO,
                    PATIVO => :P230_ATIVO,
                    PIDUSUARIO => :P230_IDUSUARIO,
                    PIDGERENTE => :P230_IDGERENTE,
                    PMD5 => :P230_MD5,
                    POPERACAO_DML => 'S');
                    --
                end if;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 339499084688960506
        }
    )

    process limpar-campos-ao-sair (
        name: Limpar Campos ao Sair
        type: clearSessionState
        execution {
            sequence: 10
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 339499159325960507
        }
    )

    process operação-dml-em-funcionários (
        name: Operação DML em Funcionários
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                  vidpessoa number := :P230_IDPESSOA;
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  #OWNER#.PCK_CADASTROS_FAV.PRC_FUNCIONARIOS (
                    PIDFUNCIONARIO => :P230_IDFUNCIONARIO,
                    PIDPESSOA => vidpessoa,
                    PIDCARGO => :P230_IDCARGO,
                    PATIVO => :P230_ATIVO,
                    PIDUSUARIO => :P230_IDUSUARIO,
                    PIDGERENTE => :P230_IDGERENTE,
                    PMD5 => :P230_MD5,
                    POPERACAO_DML => voperacao_dml );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 339497275144943044
        }
    )

    branch (
        name: Go To Page 230
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 230
                items: {
                    P230_IDPESSOA: &P230_IDPESSOA.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

    branch (
        name: Go To Page 85
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 85
                items: {
                    P85_IDPESSOA: &P230_IDPESSOA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: EXCLUIR
        }
    )

    branch (
        execution {
            sequence: 30
        }
        behavior {
            target: {
                page: 85
                items: {
                    P85_IDPESSOA: &P230_IDPESSOA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: FECHAR
        }
    )

)

