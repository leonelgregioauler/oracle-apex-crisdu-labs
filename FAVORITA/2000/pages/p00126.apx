        }
    )

    process ativar-desativar-produtos (
        name: Ativar / Desativar Produtos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vativarinativar varchar2(1);
                begin
                  if v('REQUEST') = 'ATIVAR' then 
                    vativarinativar := 'S';
                  elsif v('REQUEST') = 'INATIVAR' then
                    vativarinativar := 'N';
                  end if;
                  --
                  for i in 1..APEX_APPLICATION.G_F01.count
                  loop
                    --
                    update produtosdetalhados
                    set ativo = vativarinativar
                    where idproduto = APEX_APPLICATION.G_F01(I);
                    --
                    commit;
                    --
                  end loop;
                  --
                end;    
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro(s) ativado(s) / inativado(s) com sucesso.
        }
        advanced {
            executionMappingIdentifier: 28802410922113706
        }
    )

)

