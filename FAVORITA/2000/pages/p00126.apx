    region ativar-inativar-produtos (
        name: Ativar / Inativar Produtos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT APEX_ITEM.CHECKBOX2( 1, p.idproduto) "PRODUTO"
                      , p.referencia
                      , p.nomeproduto
                      , pd.ativo
                FROM produtosdetalhados pd
                   , produtos p
                WHERE pd.idproduto = p.idproduto
                ORDER BY 1
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Não encontrou informações.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            includeActionsMenu: false
        }
        advanced {
            savedReportMappingIdentifier: 28845392406915131
        }

