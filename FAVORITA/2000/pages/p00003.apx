page 3 (
    name: Cadastro de Corredores Estoques
    title: Corredores Estoques
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        browserCache: false
    }
    advanced {
        reloadOnSubmit: always
    }
    serverCache {
        caching: true
    }
    help {
        helpText: No help is available for this page.
    }

    region corredores-estoques (
        name: Corredores Estoques
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P3_DESCRICAO (
        type: textField
        label {
            label: Descrição
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @corredores-estoques
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P3_IDCORREDORESTOQUE (
        type: hidden
        layout {
            sequence: 10
            region: @corredores-estoques
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P3_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Filial Favorita
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-filiaisfavorita
        }
        layout {
            sequence: 20
            region: @corredores-estoques
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P3_MD5 (
        type: hidden
        layout {
            sequence: 50
            region: @corredores-estoques
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P3_OPERACAO_DML (
        type: hidden
        layout {
            sequence: 60
            region: @corredores-estoques
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P3_ORDEM (
        type: numberField
        label {
            label: Ordem
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 40
            region: @corredores-estoques
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 50
            region: @corredores-estoques
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_IDCORREDORESTOQUE
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 40
            region: @corredores-estoques
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_IDCORREDORESTOQUE
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 30
            region: @corredores-estoques
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 2
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 20
            region: @corredores-estoques
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P3_IDCORREDORESTOQUE
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @corredores-estoques
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_IDCORREDORESTOQUE
        }
    )

    validation descricao-obrigatório (
        name: DESCRICAO obrigatório
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P3_DESCRICAO
        }
        error {
            errorMessage: Descrição deve ter um valor.
            associatedItem: @P3_DESCRICAO
        }
    )

    validation idfilialfavorita-obrigatório (
        name: IDFILIALFAVORITA obrigatório
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P3_IDFILIALFAVORITA
        }
        error {
            errorMessage: Filial Favorita deve ter um valor.
            associatedItem: @P3_IDFILIALFAVORITA
        }
    )

    validation ordem-obrigatório (
        name: ORDEM obrigatório
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P3_ORDEM
        }
        error {
            errorMessage: Ordem deve ter um valor.
            associatedItem: @P3_ORDEM
        }
    )

    process consulta-corredores-estoques (
        name: Consulta Corredores Estoques
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                #OWNER#.PCK_CADASTROS_FAV.PRC_CORREDORESESTOQUES(
                  PIDCORREDORESTOQUE => :P3_IDCORREDORESTOQUE,
                  PIDFILIALFAVORITA => :P3_IDFILIALFAVORITA,
                  PORDEM => :P3_ORDEM,
                  PDESCRICAO => :P3_DESCRICAO,
                  PMD5 => :P3_MD5,
                  POPERACAO_DML => 'S');
                ```
        }
        execution {
            sequence: 20
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 331358088587994633
        }
    )

    process limpar-campos-ao-sair (
        name: Limpar Campos ao Sair
        type: clearSessionState
        execution {
            sequence: 10
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 15308771899789101
        }
    )

    process limpar-campos-para-adicionar (
        name: Limpar Campos para Adicionar
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 331358590826994638
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    process operação-dml-em-corredores-estoques (
        name: Operação DML em Corredores Estoques
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --                     --
                  #OWNER#.PCK_CADASTROS_FAV.PRC_CORREDORESESTOQUES(
                    PIDCORREDORESTOQUE => :P3_IDCORREDORESTOQUE,
                    PIDFILIALFAVORITA => :P3_IDFILIALFAVORITA,
                    PORDEM => :P3_ORDEM,
                    PDESCRICAO => :P3_DESCRICAO,
                    PMD5 => :P3_D5,
                    POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 344316575033732468
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 3
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

)

