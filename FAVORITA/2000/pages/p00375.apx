page 375 (
    name: Cadastro de Meta
    title: Cadastro de Meta
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-de-meta (
        name: Cadastro de Meta
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P375_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 50
            region: @cadastro-de-meta
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 12
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P375_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 40
            region: @cadastro-de-meta
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 12
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P375_IDGRUPO (
        type: selectList
        label {
            label: Grupo
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select g.descricao
                     , g.idgrupoatendimento
                from roman.gruposatendimento g
                where g.idgrupoatendimento in (3,4,33,34,54,55)
                order by 2
                ```
            nullDisplayValue: - Selecione o Grupo -
        }
        layout {
            sequence: 10
            region: @cadastro-de-meta
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P375_IDMETACOBRANCA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @cadastro-de-meta
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P375_IDUSUARIO (
        type: selectList
        label {
            label: Usuário
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeusuario(u.idusuario) display_value
                     , u.idusuario return_value
                from usuarios u
                where u.ativo = 'S'
                  and exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.idgrupoatendimento = :P375_IDGRUPO
                                 and ug.usuario            = u.usuario )
                order by 1
                ```
            nullDisplayValue: - Selecione o Usuário -
        }
        cascadingLov {
            parentItems: P375_IDGRUPO
        }
        layout {
            sequence: 30
            region: @cadastro-de-meta
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P375_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @cadastro-de-meta
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P375_VALORMETA (
        type: numberField
        label {
            label: Valor da Meta
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 60
            region: @cadastro-de-meta
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 10
        }
        advanced {
            customAttributes: onkeyup="formataMoeda(this);"
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 50
            region: @cadastro-de-meta
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 374
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button deletar (
        buttonName: DELETAR
        label: Deletar
        layout {
            sequence: 40
            region: @cadastro-de-meta
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P375_IDMETACOBRANCA
        }
    )

    button nova (
        buttonName: NOVA
        label: Nova
        layout {
            sequence: 30
            region: @cadastro-de-meta
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P375_IDMETACOBRANCA
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 20
            region: @cadastro-de-meta
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P375_IDMETACOBRANCA
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Criar
        layout {
            sequence: 10
            region: @cadastro-de-meta
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P375_IDMETACOBRANCA
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process consulta-de-meta (
        name: Consulta de Meta
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vvalormeta number;
                  --
                begin
                  --
                  PCK_CADASTROS_FAV.PRC_METASCOBRANCAS( PIDMETACOBRANCA => :P375_IDMETACOBRANCA,
                                                        PVALORMETA => vvalormeta,
                                                        PIDUSUARIO => :P375_IDUSUARIO,
                                                        PDATAINICIO => :P375_DATAINICIO,
                                                        PDATAFIM => :P375_DATAFIM,
                                                        PIDGRUPO => :P375_IDGRUPO,
                                                        PMD5 => :P375_MD5,
                                                        POPERACAO_DML => 'S' );
                  --
                  :P375_VALORMETA := to_char(vvalormeta,'999G999G999G999G990D00');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 1522882195122937326
        }
    )

    process limpa-campos (
        name: Limpa Campos
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 1522882529074937330
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('NOVA','DELETAR')
                ```
        }
    )

    process processo-dml-em-metas-cobranças (
        name: Processo DML em Metas Cobranças
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  voperacao_dml varchar2(1);
                  vvalormeta    number;
                  --
                begin
                  --
                  if v('REQUEST') = 'SUBMIT' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'SAVE' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'DELETAR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  vvalormeta := to_number(:P375_VALORMETA,'999G999G999G999G990D00');
                  --
                  PCK_CADASTROS_FAV.PRC_METASCOBRANCAS( PIDMETACOBRANCA => :P375_IDMETACOBRANCA,
                                                        PVALORMETA => vvalormeta,
                                                        PIDUSUARIO => :P375_IDUSUARIO,
                                                        PDATAINICIO => :P375_DATAINICIO,
                                                        PDATAFIM => :P375_DATAFIM,
                                                        PIDGRUPO => :P375_IDGRUPO,
                                                        PMD5 => :P375_MD5,
                                                        POPERACAO_DML => voperacao_dml );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo executado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 1522933178772134229
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('DELETAR','SAVE','SUBMIT')
                ```
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 375
                items: {
                    P375_IDMETACOBRANCA: &P375_IDMETACOBRANCA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('SAVE','SUBMIT')
                ```
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 375
                items: {
                    P375_IDMETACOBRANCA:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

)

