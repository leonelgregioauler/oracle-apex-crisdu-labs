page 108 (
    name: Impressão Comp/Trans/Rem
    title: Impressão Comp/Trans/Rem
    appearance {
        pageTemplate: @minimal-pedido
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region impressão (
        name: Impressão
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidusuario number;
                  --
                begin
                
                  if v('APP_USER') = 'MAICONAIMI' then
                    insert into teste(coluna1,coluna2) values ('123456789', '1');
                    commit;
                  end if;
                  SELECT pck_util_fav.fnc_idusuario(v('APP_USER'))
                  into vidusuario
                  FROM DUAL;
                
                  if :P108_ORDENA = 'P' then
                  if v('APP_USER') = 'MAICONAIMI' then
                    insert into teste(coluna1,coluna2) values ('123456789', '2');
                    commit;
                  end if;
                     pck_imprime_fav.prc_comprastransferencias ( :P108_IDCOMPRATRANSFERENCIA , vidusuario );
                  else
                  if v('APP_USER') = 'MAICONAIMI' then
                    insert into teste(coluna1,coluna2) values ('123456789', '3');
                    commit;
                  end if;
                     pck_imprime_fav.prc_comprastransferencias_tamanho ( :P108_IDCOMPRATRANSFERENCIA , vidusuario );
                  end if;
                
                end;
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P108_IDCOMPRATRANSFERENCIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @impressão
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P108_ORDENA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @impressão
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
        comments {
            comments:
                ```
                Parâmetro para ordenação do Relatório
                Se P108_ORDENA = 1 - chama prc_comprastransferencias - Ordenado por Patrateleira
                Se P108_ORDENA = 2 - chama prc_comprastransferencias_tamanho - Ordenado por Tamanho
                
                ```
        }
    )

)

