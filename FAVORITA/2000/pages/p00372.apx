    pageItem P372_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nomefilialfavorita
                     , f.idfilialfavorita
                from favorita.filiaisfavorita f
                where f.tipofilial = 'L'
                  and (:P372_IDPAIS is null or f.idpais = :P372_IDPAIS)
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P372_IDPAIS
            itemsToSubmit: P372_IDPAIS
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P372_IDFILIALROMANCE (
        type: selectList
        label {
            label: Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome as d,
                       idfilial as r
                  from roman.vw_filiais
                 where tipofilial in ('C', 'D','A','F','L')
                   and ativo = 'S'
                   and (:P372_IDPAIS is null or ididioma = :P372_IDPAIS)
                 union all
                
                 select nome 
                      , idfilial 
                 from roman.vw_filiais f
                 where f.idfilial = 200
                   and (:P372_IDPAIS is null or ididioma = :P372_IDPAIS)
                 union all
                 
                  select nome 
                      , idfilial 
                 from roman.vw_filiais f
                 where f.idfilial = 1220
                   and (:P372_IDPAIS is null or ididioma = :P372_IDPAIS)
                 order by 1
                ```
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P372_IDPAIS (
        type: selectList
        label {
            label: País
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome d
                     , idpais r
                 from roman.paises
                 where idpais in (1,2,4,6,13)
                order by 2
                ```
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P372_LOJA (
        type: radioGroup
        label {
            label: Vendeu Loja
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N,Nenhum Canal;Z,Sem venda no Ciclo;C
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P372_QTDDIASEMISSAO (
        type: numberField
        label {
            label: Qtd Dias Ultimo Pedido
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P372_SELECAO (
        type: radioGroup
        label {
            label: Tipo Seleção
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Não Higienizados;N,Já Higienizados;S,Todos;T
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction tipo-de-relatorio (
        name: Tipo de Relatorio
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P372_TIPORELATORIO
        }
        clientSideCondition {
            type: item=value
            item: P372_TIPORELATORIO
            value: V
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P372_QTDDIASEMISSAO
                    P372_TAREFA
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P372_MEDIAINI
                    P372_MEDIAFIM
                    P372_QTDNOTAS
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P372_QTDDIASEMISSAO
                    P372_TAREFA
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P372_MEDIAINI
                    P372_MEDIAFIM
                    P372_QTDNOTAS
                ]
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

    )

    dynamicAction verifica-venda-loja (
        name: Verifica Venda Loja
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P372_LOJA
        }
        clientSideCondition {
            type: item=value
            item: P372_LOJA
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P372_IDFILIALFAVORITA
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P372_IDFILIALROMANCE
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P372_IDFILIALFAVORITA
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P372_IDFILIALROMANCE
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

    )

    validation p372-idfilialfavorita (
        name: P372_IDFILIALFAVORITA
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                  from dual 
                 where :P372_LOJA = 'S'
                   and :P372_IDFILIALFAVORITA is null;
                ```
        }
        error {
            errorMessage: Campo Favorita deve ser informado.
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

    validation p372-idfilialromance (
        name: P372_IDFILIALROMANCE
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                  from dual 
                 where :P372_LOJA != 'S'
                   and :P372_IDFILIALROMANCE is null;
                ```
        }
        error {
            errorMessage: Campo Romance deve ser informado.
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

