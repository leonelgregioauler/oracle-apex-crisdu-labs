    region clientes-para-venda-ativa (
        name: Clientes para Venda Ativa
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  -- Variáveis de controle da rotina
                  v_select clob;
                  --
                begin
                    -- Monta a cláusula SELECT
                    v_select := ' select initcap(p.nomepessoa) nome_cliente
                                 , p.cpf cpf
                                 , c.nomecategoria categoria_estrelas
                                 , case when ( select 1
                                                 from catal.telefonespessoas
                                                where idpessoa = v.idpessoa 
                                                  and score > 0
                                                  and rownum = 1) = 1
                                        then roman.pck_romance.fnc_retornatelefones_hig(v.idvendedora)
                                        else roman.pck_romance.fnc_retornatelefones(v.idvendedora) 
                                   end telefone
                                   --
                                 , replace(TO_CHAR((select nvl(sum(pf.saldodevedor),0)
                                            from favorita.vw_pedidos_fav pf
                                           where pf.ididioma    = 1
                                             and pf.idvendedora = v.idvendedora
                                          ),''999G999G999G999G990D00''),'' '','''') saldo_devedor
                                 , v.idvendedora id_site
                                 , v.pontos pontos_romance
                                 , (select count(1)
                                      from favorita.pedidos p
                                     where p.idvendedora = v.idvendedora
                                       and p.datacancelamento is null) qtd_pedidos
                                 , initcap(cid.nomecidade) || ''-'' || e.sigla cidade
                                 , roman.pck_romance.fnc_nomerepresentante(v.idrepresentante) distribuidor
                                 , roman.pck_romance.fnc_nomeregiaovenda(v.idregiaovenda) regiaovenda
                                 , initcap(p.bairro) bairro
                                 , null link_fones
                                 , v.idpessoa
                              from catal.vendedoras v
                                 , catal.pessoas p
                                 , roman.pontuacoesclubedesucesso pc
                                 , roman.categoriasclubes c
                                 , catal.cidades cid
                                 , roman.estados e 
                             where p.idpessoa = v.idpessoa
                                   and pc.idvendedora = v.idvendedora
                                   and c.idcategoriaclube = pc.idcategoriaclube
                                   and cid.idcidade = p.idcidade
                                   and v.ativo = ''S''
                                   and e.idestado = cid.idestado
                                   and :P372_LOJA is not null ';
                
                    -- Trara o Filtro de tela :P372_LOJA(Vendeu Loja)
                    if :P372_LOJA = 'Z' then
                        --roman.prc_grava_log_debug_desenvolvedores('#auidfhgiuahfgiuh','aa');
                        v_select := v_select || ' and  v.idfilial = :P372_IDFILIALROMANCE
                                                  and  not exists (
                                                               select 1
                                                                 from   pedidos pf
                                                                where  pf.idvendedora      = v.idvendedora
                                                                  and    pf.datacancelamento is null
                                                       )
                                                  and  exists (
                                                           select 1
                                                             from   roman.notasvendas nv
                                                            where  nv.idvendedora          = v.idvendedora
                                                              and    extract(year from nv.datanota) >= extract(year from sysdate)-1)';
                    elsif :P372_LOJA = 'C' then
                        v_select := v_select || ' and    v.idfilial = :P372_IDFILIALROMANCE
                                                and    exists (
                                                           select 1
                                                           from   pedidos pf
                                                           where  pf.idvendedora = v.idvendedora
                                                           and    pf.datacancelamento is null
                                                           and    trunc(pf.dataemissao) <= trunc(sysdate) - 42
                                                       )
                                                and    exists (
                                                           select 1
                                                           from   roman.notasvendas nv
                                                           where  nv.idvendedora = v.idvendedora
                                                           and    extract(year from nv.datanota) >= extract(year from sysdate)-1
                                                       )';
                    elsif :P372_LOJA = 'S' then
                        v_select := v_select || ' and exists ( select 1
                                                                 from pedidos pf
                                                                    , filiaisfavorita ff
                                                                where pf.idvendedora      = v.idvendedora
                                                                  and pf.idfilialfavorita = ff.idfilialfavorita
                                                                  and pf.idfilialfavorita = :P372_IDFILIALFAVORITA
                                                                  and ff.tipofilial       = ''L''
                                                                  and pf.datacancelamento is null )';
                    elsif :P372_LOJA = 'N' then
                        v_select := v_select || '   and v.idfilial = :P372_IDFILIALROMANCE
                                                  and not exists ( select 1
                                                                     from pedidos pf
                                                                        , filiaisfavorita ff
                                                                    where pf.idvendedora      = v.idvendedora
                                                                      and pf.idfilialfavorita = ff.idfilialfavorita
                                                                      and ff.tipofilial       = ''L''
                                                                      and pf.datacancelamento is null )';
                    end if;
                    --
                    -- Trara o Filtro de tela :P372_QTDDIASEMISSAO(Qtd Dias Ultimo Pedido)
                    if :P372_QTDDIASEMISSAO is not null then
                        v_select := v_select || ' and trunc(sysdate) - ( select max(trunc(dataemissao))
                                                                       from vw_pedidos_fav pp
                                                                      where pp.idvendedora = v.idvendedora
                                                                        and pp.ididioma    = 1
                                                                        and pp.codpedidocancelado = ''N''
                                                                   ) >= :P372_QTDDIASEMISSAO';
                    end if;
                    --
                    if :P372_CATEGORIA is not null and :P372_CATEGORIA != '-1' then
                      v_select := v_select || ' and exists ( select 1
                                                  from roman.pontuacoesclubedesucesso pcs
                                                 where pcs.idvendedora = v.idvendedora
                                                   and pcs.idcategoriaclube = :P372_CATEGORIA) ';
                    end if;
                    --
                    if :P372_SELECAO = 'S' then 
                      v_select := v_select || ' and p.datahigienizacao is not null ';
                    end if;
                    --
                    if :P372_SELECAO = 'N' then 
                      v_select := v_select || ' and p.datahigienizacao is null ';
                    end if;
                    --
                    if :P372_IDPAIS           is not null and 
                       :P372_IDFILIALFAVORITA is null and 
                       :P372_IDFILIALROMANCE  is null then
                       --
                      v_select  := v_select || ' and v.idfilial in ( select ff.idfilialromance
                                                                      from favorita.filiaisfavorita ff
                                                                         , filiais fr
                                                                     where ff.tipofilial = ''L''
                                                                       and ff.idfilialromance = fr.idfilial
                                                                       and ff.ativo = ''S''
                                                                       and ff.idpais = :P372_IDPAIS )';
                    end if;
                    --
                    -- Retorna a Consulta completa
                    return v_select ;
                    --
                end;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
