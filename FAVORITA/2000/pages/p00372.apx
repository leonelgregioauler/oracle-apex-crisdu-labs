    region acompanhamento-de-distribuidores (
        name: Acompanhamento de Distribuidores
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                    -- Variáveis de controle
                    v_select   varchar2(4000);
                    v_from     varchar2(4000);
                
                begin
                    -- Monta o select
                    v_select := ' select aux.distribuidor
                     -- total de consultoras vinculas ao repres
                     , aux.consultoras
                     -- total de vendedoras sem pedido
                     , aux.sempedidos
                     , round((aux.sempedidos*100)/aux.consultoras,2) percsempedidos
                     -- total de vendedoras que fizeram pedido
                     , (aux.consultoras - aux.sempedidos) fizerampedidos
                     , round(((aux.consultoras - aux.sempedidos)*100)/aux.consultoras,2) percfizerampedidos
                     -- total de vendedoras que fezeram pedidos fora da loja
                     , aux.foraloja
                     , round((aux.foraloja*100)/aux.consultoras,2) percforaloja
                     -- total de vendedoras que fizeram pedido na loja
                     , aux.emloja
                     , round((aux.emloja*100)/aux.consultoras,2) percemloja';
                
                    -- Monta o from
                    v_from := '  from (select initcap(p.nomepessoa)         as distribuidor
                             , count(distinct v.idvendedora) as consultoras
                             , count(distinct case
                                                when exists ( select 1
                                                                from favorita.pedidos pd
                                                               where pd.idvendedora = v.idvendedora
                                                                 and pd.datacancelamento is null)
                                                then 
                                                   null
                                                else 
                                                   v.idvendedora
                                              end)           as sempedidos
                             , count(distinct case
                                                when exists ( select 1
                                                                from favorita.pedidos pd
                                                                   , favorita.filiaisfavorita ff
                                                               where ff.idfilialfavorita = pd.idfilialfavorita
                                                                 and pd.idvendedora = v.idvendedora
                                                                 and pd.datacancelamento is null
                                                                 and ff.tipofilial != ''L'')
                                                then 
                                                   null
                                                else 
                                                   v.idvendedora
                                              end)           as foraloja
                             , count(distinct case
                                                when exists ( select 1
                                                                from favorita.pedidos pd
                                                                   , favorita.filiaisfavorita ff
                                                               where ff.idfilialfavorita = pd.idfilialfavorita
                                                                 and pd.idvendedora = v.idvendedora
                                                                 and pd.datacancelamento is null
                                                                 and ff.tipofilial = ''L'')
                                                then 
                                                   null
                                                else 
                                                   v.idvendedora
                                              end)           as emloja
                          from catal.representantes r
                             , catal.pessoas p
                             , catal.gerentes g
                             , catal.vendedoras v
                         where p.idpessoa = r.idpessoa
                           and g.idgerente = r.idgerente
                           and g.idfilial = :P372_IDFILIALROMANCE
                           and v.idrepresentante = r.idrepresentante
                           and v.ativo = ''S''
                           and r.ativo = ''S''
                         group by p.nomepessoa
                         order by 1) aux';
                
                    -- retorno da rotina
                    return v_select || v_from;
                    
                end;
                
                
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P372_IDFILIALROMANCE
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        advanced {
            savedReportMappingIdentifier: 3045401958767297702
        }

