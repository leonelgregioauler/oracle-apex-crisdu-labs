page 396 (
    name: Notas Fiscais
    title: Notas Fiscais
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region notas-fiscais (
        name: Notas Fiscais
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nfs.idnotafiscal,
                       nfs.datainclusao,
                       nfs.dataultimaalteracao,
                       nfs.datavalidacao,
                       nfs.datarecebimento,
                       nfs.codigovalidador,
                       nfs.naturezaoperacao,
                       nfs.idformapagamento,
                       nfs.modelodocumento,
                       nfs.serie,
                       nfs.numero,
                       nfs.idformaemissao,
                       nfs.digitoverificador,
                       nfs.idambiente,
                       nfs.finalidadenfe,
                       nfs.versaoprocesso,
                       nfs.dataemissao,
                       nfs.dataentradasaida,
                       nfs.tipodocumento,
                       nfs.idmunicipiofg,
                       nfs.chavedeacesso,
                       nfs.idrazaosocialemitente,
                       ( select initcap(r.razaosocial) 
                         from crisdu.razoessociais r
                         where r.idrazaosocial = nfs.idrazaosocialemitente ) remetente,
                       nfs.idrazaosocialdestinatario,
                       ( select initcap(r.razaosocial) 
                         from crisdu.razoessociais r
                         where r.idrazaosocial = nfs.idrazaosocialemitente ) destinatario,
                       nfs.idrazaosocialtransportadora,
                       nfs.transportadora,
                       nfs.conhecimentotransporte,
                       nfs.idusuario,
                       nfs.idsituacao,
                       nfs.situacao,
                       nfs.idnaturezaoperacao,
                       nfs.protocolodeautorizacao,
                       nfs.basecalculoicms,
                       nfs.valoricms,
                       nfs.valoricmsdesonerado,
                       nfs.valortotalfcp,
                       nfs.valoricmsfcp_ufdest,
                       nfs.valoricmsufdest,
                       nfs.valoricmsufremet,
                       nfs.basecalculoicmsst,
                       nfs.valoricmsst,
                       nfs.valortotalfcpst,
                       nfs.valortotalfcpstretido,
                       nfs.valortotalprodutos,
                       nfs.valorfrete,
                       nfs.valorseguro,
                       nfs.valordesconto,
                       nfs.valorimpostoimportacao,
                       nfs.valoripi,
                       nfs.valoripidevolvido,
                       nfs.valorpis,
                       nfs.valorcofins,
                       nfs.valordespesasacessorias,
                       nfs.valortotalnota,
                       nfs.valortotaltributos,
                       nfs.idmodalidadefrete,
                       nfs.codigoantt,
                       nfs.placaveiculo,
                       nfs.ufveiculo,
                       nfs.volumes,
                       nfs.observacao,
                       nfs.emitentecrisdu,
                       nfs.destinatariocrisdu,
                       nfs.transportadoracrisdu,
                       nfs.idpedidofavorita,
                       nfs.ufemitente,
                       nfs.ufdestinatario,
                       nfs.idoperacao,
                       nfs.INTERESTADUAL,
                       nfs.suframa,
                       nfs.consumidorfinal,
                       nfs.nomearquivoxml
                from crisdu.vw_notasfiscais_crd nfs
                where nfs.idrazaosocialdestinatario in (0, 1, 6, 12, 13, 1316)
                and nfs.naturezaoperacao like 'TRANSFERENCIA DE%';
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 1560503994544175244
        }

