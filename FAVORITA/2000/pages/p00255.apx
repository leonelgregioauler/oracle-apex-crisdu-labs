        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 5807971 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CPF (
                sequence: 5
            )

            displayColumn DATAEMISSAO (
                sequence: 9
            )

            displayColumn DATAENTREGA (
                sequence: 10
            )

            displayColumn DATAPAGAMENTO (
                sequence: 15
            )

            displayColumn DATAVENCIMENTO (
                sequence: 11
            )

            displayColumn EDICAOREVISTA (
                sequence: 2
            )

            displayColumn IDPEDIDO (
                sequence: 1
            )

            displayColumn NOMEUSUARIO (
                sequence: 6
            )

            displayColumn REPRESENTANTE (
                sequence: 3
            )

            displayColumn SITUACAOENTREGAINTERNO (
                sequence: 7
            )

            displayColumn SITUACAOFINANCEIROINTERNO (
                sequence: 8
            )

            displayColumn SITUACAOPAGAMENTO (
                sequence: 14
            )

            displayColumn VALORAPAGAR (
                sequence: 13
            )

            displayColumn VALORTOTAL (
                sequence: 12
            )

            displayColumn VENDEDORA (
                sequence: 4
            )

            sort (
                column: VENDEDORA
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: VALORTOTAL
            )

            aggregate (
                column: VALORAPAGAR
            )

            aggregate (
                function: count
                column: IDPEDIDO
            )

            controlBreak (
                column: REPRESENTANTE
                layout {
                    sequence: 1
                }
            )

        )

    )

    pageItem P255_DATA (
        type: radioGroup
        label {
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Emissão;E,Entrega;T,Vencimento;V,Baixa;B,Não FIltrar;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P255_DATAFIM (
        type: datePickerJquery
        label {
            label: até
            alignment: left
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: DD/MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P255_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: DD/MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P255_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(idrepresentante) d
                     , idrepresentante r
                from representantes r
                where r.idgerente = ( select idgerente from usuarios where usuario = v('APP_USER'))
                order by 1
                ```
            nullDisplayValue: - Selecione -
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P255_IDVENDEDORA (
        type: popupLov
        label {
            label: Consultora
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' ('||nvl(p.cpf,p.documentoestrangeiro)||')' display_value
                     , v.idvendedora
                from vendedoras v
                   , pessoas p
                where p.idpessoa = v.idpessoa
                  and (:P255_IDREPRESENTANTE is null or v.idrepresentante = :P255_IDREPRESENTANTE)
                  and exists ( select 1
                               from representantes r
                               where r.idrepresentante = v.idrepresentante
                                 and r.idgerente       = ( select idgerente 
                                                           from usuarios 
                                                           where usuario = v('APP_USER'))) 
                order by 1
                ```
            nullDisplayValue: - Selecione -
        }
        cascadingLov {
            parentItems: P255_IDREPRESENTANTE
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction mostra-datas (
        name: Mostra Datas
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P255_DATA
        }
        clientSideCondition {
            type: item=value
            item: P255_DATA
            value: N
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P255_DATAINICIO
                    P255_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P255_DATAINICIO
                    P255_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    branch (
        name: Go To Page 255
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 255
                items: {
                    P255_DATA: &P255_DATA.
                    P255_IDREPRESENTANTE: &P255_IDREPRESENTANTE.
                    P255_IDVENDEDORA: &P255_IDVENDEDORA.
                    P255_DATAINICIO: &P255_DATAINICIO.
                    P255_DATAFIM: &P255_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

