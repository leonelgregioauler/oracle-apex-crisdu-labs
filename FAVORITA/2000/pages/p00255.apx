page 255 (
    name: Relatório de Venda Direta
    title: Relatório de Venda Direta
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region venda-direta-detalhada (
        name: Venda Direta Detalhada
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpedido  
                     , p.edicaorevista
                     , p.representante
                     , p.vendedora
                     , p.cpf
                     , p.nomeusuario
                     , p.situacaoentregainterno
                     , p.situacaofinanceirointerno
                     , p.dataemissao
                     , p.dataentrega
                     , p.datavencimento
                     , nvl(p.valortotal,0) valortotal
                     , nvl(p.valorapagar,0) valorapagar
                     , p.situacaopagamento
                     , ( select listagg(pg.datapagamento,' ') within group (order by 1)
                         from pagamentospedidos pg
                         where pg.datapagamento is not null
                           and exists ( select 1
                                        from vencimentospedidos v
                                        where v.idvencimentopedido = pg.idvencimentopedido
                                          and v.situacaovencimento = 'V'
                                          and v.idpedido           = p.idpedido ) ) datapagamento
                from vw_pedidos_fav p
                where p.tipopedido        = 'V'
                  and p.ididioma          = 1
                  and not exists ( select 1
                                   from classificacoespedidos c
                                   where c.idcaracteristicapedido = 25
                                     and c.idpedido               = p.idpedido )
                  and ( p.idfilialromance = roman.pck_romance.fnc_filialusuario(v('APP_USER')) )
                  and ( :P255_IDREPRESENTANTE is null or p.idrepresentante = :P255_IDREPRESENTANTE )
                  and ( :P255_IDVENDEDORA is null or p.idvendedora = :P255_IDVENDEDORA )
                  and ( :P255_DATA = 'N' or ( :P255_DATA = 'E' and trunc(p.dataemissao) between to_date(:P255_DATAINICIO,'dd/mm/rrrr') and to_date(:P255_DATAFIM,'dd/mm/rrrr') )
                                         or ( :P255_DATA = 'T' and trunc(p.dataentrega) between to_date(:P255_DATAINICIO,'dd/mm/rrrr') and to_date(:P255_DATAFIM,'dd/mm/rrrr') )
                                         or ( :P255_DATA = 'B' and exists ( select 1
                                                                            from pagamentospedidos pg
                                                                            where exists ( select 1
                                                                                           from vencimentospedidos v
                                                                                           where v.idvencimentopedido = pg.idvencimentopedido
                                                                                             and v.idpedido           = p.idpedido )
                                                                              and trunc(pg.datapagamento) between to_date(:P255_DATAINICIO,'dd/mm/rrrr') and to_date(:P255_DATAFIM,'dd/mm/rrrr') ) )
                                         or ( :P255_DATA = 'V' and exists ( select 1
                                                                            from vencimentospedidos vp
                                                                            where vp.idpedido = p.idpedido
                                                                              and vp.situacaovencimento = 'V'
                                                                              and vp.datavencimento between to_date(:P255_DATAINICIO,'dd/mm/rrrr') and to_date(:P255_DATAFIM,'dd/mm/rrrr') ) ) )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhum pedido encontrado, verifique os filtros!
        }
        advanced {
            savedReportMappingIdentifier: 580549023228535433
        }

        column CPF (
            type: plainText
            heading {
                heading: Cpf
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

