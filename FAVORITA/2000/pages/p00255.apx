            layout {
                sequence: 90
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: I
            }
        )

        column DATAENTREGA (
