    pageItem P703_IDFILIAL (
        type: selectList
        label {
            label: Franquia
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select fl.nome
                     , fl.idfilial
                from roman.vw_filiais fl
                where fl.ativo = 'S'
                  and fl.tipofilial = 'D'
                  and ( :P703_IDPARAMETRO is not null
                     or not exists ( select 1
                                     from roman.comger_parametros p
                                     where p.idfilialromance = fl.idfilial
                                       and p.ativo = 'S'
                                       and nvl(p.dtfimvigencia, date '9999-12-31') >= trunc(sysdate) ) )
                order by 1
                ```
            displayExtraValues: false
