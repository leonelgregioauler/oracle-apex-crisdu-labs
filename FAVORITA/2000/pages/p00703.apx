    process carrega-franquia (
        name: Carrega franquia
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  select p.idfilialromance
                       , to_char(p.dtiniciovigencia,'DD/MM/YYYY')
                       , to_char(p.dtfimvigencia,'DD/MM/YYYY')
                       , p.ativo
                       , p.meses_janela
                       , p.dias_vencido
                  into :P703_IDFILIAL
                     , :P703_DTINICIO
                     , :P703_DTFIM
                     , :P703_ATIVO
                     , :P703_MESES_JANELA
                     , :P703_DIAS_VENCIDO
                  from roman.comger_parametros p
                  where p.idparametro = :P703_IDPARAMETRO;
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 9820226930000501
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P703_IDPARAMETRO
        }
    )

    process encerrar-faixa (
        name: Encerrar faixa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P703_E_IDFAIXA is null then
                    raise_application_error(-20121, 'Faixa não informada.');
                  end if;
                  -- só encerra faixa da própria franquia em edição
                  for f in ( select x.idfaixa
                             from roman.comger_faixas x
                             where x.idfaixa         = to_number(:P703_E_IDFAIXA)
                               and x.idfilialromance = :P703_IDFILIAL ) loop
                    roman.pck_comger_cadastro.prc_encerra_faixa( pidfaixa => f.idfaixa, pdtfim => trunc(sysdate) );
                  end loop;
                  :P703_E_IDFAIXA := null;
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Faixa encerrada.
        }
        advanced {
            executionMappingIdentifier: 9820226930000504
        }
        serverSideCondition {
            type: request=Value
            value: ENCERRARFAIXA
        }
    )

    process incluir-faixa (
        name: Incluir faixa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P703_F_NIVEL is null or :P703_F_DESCRICAO is null or :P703_F_INAD_DE is null
                     or :P703_F_PERC is null or :P703_F_DTINICIO is null then
                    raise_application_error(-20120, 'Informe nível, descrição, inadimplência de, bônus (%) e início.');
                  end if;
                  roman.pck_comger_cadastro.prc_inclui_faixa
                    ( pidfilial   => :P703_IDFILIAL
                    , pnivel      => :P703_F_NIVEL
                    , pdescricao  => :P703_F_DESCRICAO
                    , pinad_de    => :P703_F_INAD_DE
                    , pinad_ate   => :P703_F_INAD_ATE
                    , pperc_bonus => :P703_F_PERC
                    , pdtinicio   => to_date(:P703_F_DTINICIO,'DD/MM/YYYY') );
                  :P703_F_NIVEL     := null;
                  :P703_F_DESCRICAO := null;
                  :P703_F_INAD_DE   := null;
                  :P703_F_INAD_ATE  := null;
                  :P703_F_PERC      := null;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Faixa incluída.
        }
        advanced {
            executionMappingIdentifier: 9820226930000503
        }
        serverSideCondition {
            whenButtonPressed: @incluirfaixa
        }
    )

    process salvar-franquia (
        name: Salvar franquia
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vid number := :P703_IDPARAMETRO;
                begin
                  roman.pck_comger_cadastro.prc_salva_parametro
                    ( pidparametro  => vid
                    , pidfilial     => :P703_IDFILIAL
                    , pdtinicio     => to_date(:P703_DTINICIO,'DD/MM/YYYY')
                    , pdtfim        => to_date(:P703_DTFIM,'DD/MM/YYYY')
                    , pmeses_janela => :P703_MESES_JANELA
                    , pdias_vencido => :P703_DIAS_VENCIDO
                    , pativo        => :P703_ATIVO );
                  :P703_IDPARAMETRO := vid;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Franquia salva. Agora inclua as faixas de bônus.
        }
        advanced {
            executionMappingIdentifier: 9820226930000502
        }
        serverSideCondition {
            whenButtonPressed: @salvar
        }
    )

    branch (
        name: Volta para 703
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 703
                items: {
                    P703_IDPARAMETRO: &P703_IDPARAMETRO.
                }
            }
        }
    )

)

