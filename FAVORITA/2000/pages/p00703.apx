    region passo-2-faixas-de-bônus (
        name: Passo 2 · Faixas de bônus
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select x.*
                     , lower(x.situacao) situacao_css
                     , case when x.situacao in ('Vigente','Futura') and x.dtfimvigencia is null then
                         '<button type="button" class="t-Button t-Button--small t-Button--danger t-Button--simple t-Button--iconLeft bonus-encerrar" data-faixa="'||x.idfaixa||'">'
                         ||'<span class="t-Icon t-Icon--left fa fa-times" aria-hidden="true"></span>Encerrar</button>'
                       end acao
                from (
                select f.idfaixa
                     , f.nivel
                     , f.descricao
                     , to_char(f.inad_de,'FM990D00')||'% a '||nvl2(f.inad_ate, to_char(f.inad_ate,'FM990D00')||'%', 'mais') faixa
                     , f.perc_bonus
                     , to_char(f.dtiniciovigencia,'DD/MM/YYYY')||' -> '||nvl(to_char(f.dtfimvigencia,'DD/MM/YYYY'),'sem fim') vigencia
                     , f.dtfimvigencia
                     , f.inad_de
                     , case
                         when f.ativo = 'N' then 'Desativada'
                         when f.dtiniciovigencia > trunc(sysdate) then 'Futura'
                         when nvl(f.dtfimvigencia, date '9999-12-31') < trunc(sysdate) then 'Encerrada'
                         else 'Vigente'
                       end situacao
                     , f.usuario
                from roman.comger_faixas f
                where f.idfilialromance = :P703_IDFILIAL
                ) x
                ```
            pageItemsToSubmit: P703_IDFILIAL
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
            cssClasses: bonus-card
        }
        advanced {
            htmlDomId: faixas-703
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P703_IDPARAMETRO
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 9820226930000303
        }

