page 44 (
    name: Relatório Produtos Prateleiras Estoque
    title: Produtos Prateleiras Estoque
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filial-favorita (
        name: Filial Favorita
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @opções
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: pck_util_fav.fnc_verificaacesso(28401,:P0_IDUSUARIO) = 'S'
        }
    )

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region produtos-prateleiras-estoque (
        name: Produtos Prateleiras Estoque
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idprodutoprateleira
                     , idprateleiraestoque
                     , idprodutodetalhado
                     , produtodetalhado
                     , idfilialfavorita
                     , nomefilialfavorita
                     , ordemcorredor
                     , descricaocorredor 
                     , idcorredorestoque
                     , ordemprateleira
                     , descricaoprateleira
                from vw_produtosprateleirasest_fav
                where ididioma = :P0_IDIDIOMA
                and ( (pck_util_fav.fnc_verificaacesso(28401,:P0_IDUSUARIO) = 'S' and (:P44_IDFILIALFAVORITA is null or idfilialfavorita = :P44_IDFILIALFAVORITA) )
                    or pck_util_fav.fnc_verificaacesso(28401,:P0_IDUSUARIO) = 'N' and idfilialfavorita = :P0_IDFILIALFAVORITA);
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 12881382770605627
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDPRODUTOPRATELEIRA
                layout {
                    width: 107
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDPRATELEIRAESTOQUE
                layout {
                    show: false
                    sequence: 1
                }
            )

            displayColumn (
                column: @PRODUTODETALHADO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @IDPRODUTODETALHADO
                layout {
                    show: false
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDCORREDORESTOQUE
                layout {
                    show: false
                    sequence: 6
                }
            )

            displayColumn (
                column: @ORDEMPRATELEIRA
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @DESCRICAOPRATELEIRA
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @IDFILIALFAVORITA
                layout {
                    show: false
                    sequence: 4
                }
            )

            displayColumn (
                column: @NOMEFILIALFAVORITA
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @ORDEMCORREDOR
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @DESCRICAOCORREDOR
                layout {
                    sequence: 7
                }
            )

        )

        column DESCRICAOCORREDOR (
            type: textarea
            heading {
                heading: Descrição Corredor
                alignment: center
            }
            layout {
                sequence: 80
            }
            validation {
                maxLength: 200
            }
            source {
                databaseColumn: DESCRICAOCORREDOR
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column DESCRICAOPRATELEIRA (
            type: textarea
            heading {
                heading: Descrição Prateleira
                alignment: center
            }
            layout {
                sequence: 110
            }
            validation {
                maxLength: 1000
            }
            source {
                databaseColumn: DESCRICAOPRATELEIRA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column IDCORREDORESTOQUE (
            type: numberField
            heading {
                heading: Idcorredorestoque
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 90
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDCORREDORESTOQUE
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDFILIALFAVORITA (
            type: numberField
            heading {
                heading: Idfilialfavorita
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDFILIALFAVORITA
                dataType: number
            }
        )

        column IDPRATELEIRAESTOQUE (
            type: numberField
            heading {
                heading: Idprateleiraestoque
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 20
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDPRATELEIRAESTOQUE
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDPRODUTODETALHADO (
            type: numberField
            heading {
                heading: Idprodutodetalhado
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 30
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDPRODUTODETALHADO
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDPRODUTOPRATELEIRA (
            type: link
            heading {
                heading: Editar
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 45
                    items: {
                        P45_IDPRODUTOPRATELEIRA: &IDPRODUTOPRATELEIRA.
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                databaseColumn: IDPRODUTOPRATELEIRA
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column NOMEFILIALFAVORITA (
            type: textarea
            heading {
                heading: Filial Favorita
                alignment: center
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: NOMEFILIALFAVORITA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ORDEMCORREDOR (
            type: numberField
            heading {
                heading: Ordem Corredor
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ORDEMCORREDOR
                dataType: number
            }
        )

        column ORDEMPRATELEIRA (
            type: numberField
            heading {
                heading: Ordem Prateleira
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ORDEMPRATELEIRA
                dataType: number
            }
        )

        column PRODUTODETALHADO (
            type: textarea
            heading {
                heading: Produto Detalhado
                alignment: center
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: PRODUTODETALHADO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

    )

    pageItem P44_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Filial Favorita
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-filiaisfavorita
            displayExtraValues: false
            nullDisplayValue: - Selecione -
        }
        layout {
            sequence: 10
            region: @filial-favorita
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 20
            region: @filial-favorita
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-filter
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo Prod.
        layout {
            sequence: 10
            region: @opções
            slot: top
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 45
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button novo-2 (
        buttonName: Novo
        label: Novo
        layout {
            sequence: 10
            region: @produtos-prateleiras-estoque
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 45
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button novo-3 (
        buttonName: NOVO2
        label: Novo Ref.
        layout {
            sequence: 30
            region: @opções
            slot: top
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 195
                items: {
                    P195_IDCORREDORESTOQUE:
                    P195_IDPRATELEIRAESTOQUE:
                    P195_REFERENCIA:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

