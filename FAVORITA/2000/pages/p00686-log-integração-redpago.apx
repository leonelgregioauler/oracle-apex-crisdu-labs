    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            document.querySelectorAll('.bb-donut').forEach(function(donut){
            
                const reg = parseInt(donut.dataset.reg) || 0;
                const err = parseInt(donut.dataset.err) || 0;
            
                const total = reg + err;
            
                const percent = total > 0 ? Math.round((reg / total) * 100) : 0;
            
                if(total === 0){
            
                    donut.style.background =
                        "conic-gradient(#e5e7eb 100%, #e5e7eb 0)";
            
                    donut.classList.add("bb-donut-empty");
            
                }else{
            
                    donut.style.background =
                        `conic-gradient(
                            #22c55e 0%,
                            #34d399 ${percent}%,
                            #ef4444 ${percent}%,
                            #ef4444 100%
                        )`;
            
                    donut.classList.remove("bb-donut-empty");
                }
            
                const value = donut.querySelector('.bb-donut-value');
                if(value){
                    value.innerText = percent + "%";
                }
            
            });
            ```
    }
