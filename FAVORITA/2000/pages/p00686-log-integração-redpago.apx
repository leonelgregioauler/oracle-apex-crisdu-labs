    process busca-totais (
        name: Busca Totais
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                    v_consulta_ok    NUMBER := 0;
                    v_consulta_erro  NUMBER := 0;
                
                    v_pago_ok        NUMBER := 0;
                    v_pago_erro      NUMBER := 0;
                
                BEGIN
                
                    FOR r IN (
                        SELECT
                            operacao,
                            status_processamento,
                            COUNT(*) qtd
                        FROM TB_REDPAGO_LOG_REQUISICAO
                        WHERE (dt_requisicao >= :P686_DATA_INICIAL OR :P686_DATA_INICIAL IS NULL)
                        and ID_LOG > 59
                        GROUP BY operacao, status_processamento
                    )
                    LOOP
                
                        IF r.operacao = 'CONSULTA_DEUDAS' THEN
                
                            IF r.status_processamento = 'ERRO' THEN
                                v_consulta_erro := r.qtd;
                            ELSE
                                v_consulta_ok := r.qtd;
                            END IF;
                
                        ELSIF r.operacao = 'CONFIRMAR_PAGO' THEN
                
                            IF r.status_processamento = 'ERRO' THEN
                                v_pago_erro := r.qtd;
                            ELSE
                                v_pago_ok := r.qtd;
                            END IF;
                
                        END IF;
                
                    END LOOP;
                
                    :P686_CONSULTA_OK   := v_consulta_ok;
                    :P686_CONSULTA_ERRO := v_consulta_erro;
                
                    :P686_PAGO_OK   := v_pago_ok;
                    :P686_PAGO_ERRO := v_pago_erro;
                
                    :P686_TOTAL_OK :=
                        v_consulta_ok + v_pago_ok;
                
                    :P686_TOTAL_ERRO :=
                        v_consulta_erro + v_pago_erro;
                
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 2524709430934599321
        }
    )

)

