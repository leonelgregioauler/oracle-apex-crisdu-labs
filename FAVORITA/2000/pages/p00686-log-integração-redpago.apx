    region log-redpago (
        name: Log - Redpago
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    CASE 
                        WHEN l.STATUS_PROCESSAMENTO <> 'PROCESSADO' THEN 
                            '<span class="fa fa-times-circle status-erro"></span>'
                        ELSE
                            '<span class="fa fa-check-circle status-ok"></span>'
                    END AS status_icon,
                    l.*
                FROM FAVORITA.tb_redpago_log_requisicao l
                WHERE (:P686_DOCUMENTO IS NULL OR l.DOCUMENTO = :P686_DOCUMENTO)
                  AND (:P686_DATA_INICIAL IS NULL OR TRUNC(L.DT_REQUISICAO) BETWEEN :P686_DATA_INICIAL AND :P686_DATA_FINAL)
                  AND (:P686_OPERACAO IS NULL OR L.OPERACAO = :P686_OPERACAO )
                ORDER BY l.ID_LOG DESC
                ```
        }
        layout {
            sequence: 110
            slot: body
            rowCssClasses: #RESP_STATUS#
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
