    region div-style-color-white-delivery-pedido-div (
        name: <Div style="color: white;">Delivery Pedido</div>
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Editar' as editar,
                       p.numeropedido, 
                       p.valorapagar,
                       favorita.pck_util_fav.fnc_nomevendedora(v.idvendedora) Vendedora,
                       cid.nomecidade cidade,
                       initcap(lower(pess.bairro)) bairro,
                       tpd.nome RegiaoDelivery,
                       nvl(p.taxadelivery,0.00) TaxaDelivery
                  from favorita.pedidos p,
                       catal.vendedoras v,
                       catal.pessoas pess,
                       catal.cidades cid,
                       favorita.tabelaprecosdelivery tpd
                 where v.idvendedora = p.idvendedora
                   and pess.idpessoa = v.idpessoa
                   and cid.idcidade = pess.idcidade
                   and tpd.idtabelaprecosdelivery(+) = p.idtabeladelivery
                   and p.valorapagar >= (select valor
                                           from favorita.parametros pp
                                          where pp.nome = 'TAXADELIVERYLOJAFAVORITA'
                                            and pp.idfilialfavorita = :P0_IDFILIALFAVORITA)
                   and exists( select 1
                                 from favorita.classificacoespedidos cc
                                where cc.idcaracteristicapedido  in (110, 13)
                                  and nvl(cc.idvalorcaracteristica,0) != 3
                                  and cc.idpedido = p.idpedido)
                   and p.idempresavirtualage = :P502_IDEMPRESAVIRTUALAGE
                   and p.idtransacaovirtualage is not null
                   and p.dataemissao between to_date(:P502_DATA||' 00:00:00','dd/mm/rrrr hh24:mi:ss') 
                                        and  to_date(:P502_DATA||' 23:59:59','dd/mm/rrrr hh24:mi:ss') 
                   and p.idtabeladelivery is null
                ```
        }
        layout {
            sequence: 35
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from favorita.pedidos p
                 where p.idempresavirtualage = :P502_IDEMPRESAVIRTUALAGE
                   and p.idtransacaovirtualage is not null
                   and p.dataemissao between to_date(:P502_DATA||' 00:00:00','dd/mm/rrrr hh24:mi:ss') 
                                         and to_date(:P502_DATA||' 23:59:59','dd/mm/rrrr hh24:mi:ss')
                   and p.valorapagar >= (select nvl(valor,0)
                                           from favorita.parametros pp
                                          where pp.nome = 'TAXADELIVERYLOJAFAVORITA'
                                            and pp.idfilialfavorita = :P0_IDFILIALFAVORITA)
                   and p.idtabeladelivery is null
                   and exists( select 1
                                 from favorita.classificacoespedidos cc
                                where cc.idcaracteristicapedido in (110, 13)
                                  and nvl(cc.idvalorcaracteristica,0) != 3
                                  and cc.idpedido = p.idpedido);
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
