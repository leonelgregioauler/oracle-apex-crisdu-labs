    pageItem P502_IDEMPRESAVIRTUALAGE (
        type: selectList
        label {
            label: Empresa Virtual Age
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.nome showvalue
                     , e.idempresavirtualage returnvalue
                from favorita.empresasvirtualage e
                where e.idempresavirtualage in ( select idempresavirtualage 
                                                 from usuarios         u 
                                                    , filiaisfavorita  f
                                                 where u.idfilialfavorita    = f.idfilialfavorita
                                                   and u.usuario = v('APP_USER') )
                  OR  v('APP_USER') IN  ('EVERTON','JEANH','LEONARDOAS','TAMIRESBAUER','JENNIFERSOUSA','GUILHERME','CESARH','PETERSONSOARES','BRUNOB','JESSICAMATTOS','IANNERES','OSIELF',
                                        'PABLOFORTI','PAULINENAUMANN','GUILHERME','MAICONAIMI','DIEGOPIECHO','MAICONBOTELHO','EDUARDAZOTTI','LAURAFETTER','LEONELG')                                   
                order by e.nome;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @imprimir-pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select f.idempresavirtualage
                from usuarios u
                   , favorita.filiaisfavorita f
                where u.idfilialfavorita = f.idfilialfavorita
                  and u.usuario = v('APP_USER')
                ```
        }
        security {
            encryptSessionState: false
        }
    )

