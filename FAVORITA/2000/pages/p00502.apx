    pageItem P502_IDUSUARIO (
        type: popupLov
        label {
            label: Atendente do Call Center
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) d
                     , u.idusuario r
                from pessoas p
                   , usuarios u
                where u.idpessoa = p.idpessoa
                  and u.ativo = 'S'
                  and u.idgerente = 29
                  and exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.usuario = u.usuario
                                 and ug.idgrupoatendimento = 4 )
                order by 1
                ```
            nullDisplayValue: - Escolha a Atendente -
        }
        layout {
            sequence: 120
            region: @imprimir-pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from parametros p
                where p.idfilialfavorita = :P502_IDFILIALFAVORITA
                  and p.nome = 'LIBERAVENDAPELOCALL'
                  and p.valor = 'S'
                ```
        }
        security {
            encryptSessionState: false
        }
    )

