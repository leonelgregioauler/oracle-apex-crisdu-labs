    region pedidos-integrados-hoje (
        name: Pedidos integrados Hoje
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpedido NumeroPedido
                     , roman.pck_romance.fnc_nomevendedora(idvendedora) consultora
                     , p.valortotal
                     , p.valorapagar
                     , p.dataemissao       
                     , p.idtransacaovirtualage
                     , p.idempresavirtualage
                     , ( select cp.idvalorcaracteristica
                         from favorita.classificacoespedidos cp
                         where cp.idpedido = p.idpedido
                           and cp.idcaracteristicapedido = 91) notafiscal
                     , p.idpedido as pedido 
                     , case
                         when p.datacancelamento is null then
                           '<font color="green"> Válido </font>'
                         else
                           '<font color="red"> Cancelado </font>'   
                         end  situacao
                    , ( select pck_util_fav.fnc_formapagamento(c.idvalorcaracteristica)
                        from classificacoespedidos c
                        where c.idpedido = p.idpedido
                          and c.idcaracteristicapedido = 8 ) formapagamento
                    , ( select sum(valorpago)
                        from vw_vencimentospedidos_fav v
                        where v.codsituacaovencimento = 'V' -- <-- valido
                	        and v.idpedido              = p.idpedido ) valorpago
                   , p.idpedido 
                from favorita.pedidos p
                where p.idempresavirtualage = :P502_IDEMPRESAVIRTUALAGE
                  and p.idtransacaovirtualage is not null
                  and p.dataemissao between to_date(:P502_DATA||' 00:00:00','dd/mm/rrrr hh24:mi:ss') 
                                       and  to_date(:P502_DATA||' 23:59:59','dd/mm/rrrr hh24:mi:ss') 
                  -- Maicon Aimi - 18/01/2024 - ticket 7942903 -- Verifica se o pedido se classifica como taxa delivery pago pela loja, se sim, verifica se a taxa já foi informada
                  and ( p.valorapagar < (select valor
                                           from favorita.parametros pp
                                          where pp.nome = 'TAXADELIVERYLOJAFAVORITA'
                                            and pp.idfilialfavorita = :P0_IDFILIALFAVORITA) or 
                        not exists( select 1
                                      from favorita.classificacoespedidos cc
                                     where cc.idcaracteristicapedido = 110
                                       and cc.idpedido = p.idpedido) or
                        p.taxadelivery is not null)
                  -- Maicon Aimi - 18/01/2024 - ticket 7942903 -- Verifica se o pedido se classifica como taxa delivery pago pela loja se sim, verifica se a taxa já foi informada
                order by 1 desc;
                ```
        }
        layout {
            sequence: 45
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
