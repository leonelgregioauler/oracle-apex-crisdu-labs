    pageItem P502_INFORMACOES (
        type: displayOnly
        label {
            label: Informações
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 50
            region: @pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomevendedora(p.idvendedora) 
                    ||'<br><br> Pedido: '||p.idpedido||'<br>'  
                    ||'<br><br> Nota Fiscal: '||cp.idvalorcaracteristica||'<br>' 
                    --
                    || case
                         when  p.mensagemintegracao like '%Não localizado%' then
                           '<br><font color="red"> ATENÇÃO: '|| p.mensagemintegracao||'</font>' 
                           end  nome           
                    
                from favorita.classificacoespedidos cp
                   , favorita.pedidos p
                where p.idpedido                = cp.idpedido
                  and p.idpedido                = :P502_IDPEDIDO
                  and cp.idcaracteristicapedido = 91
                  and (cp.observacao             = 'nfe'
                       or cp.observacao             = 'nfce')
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

