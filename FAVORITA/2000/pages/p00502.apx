                ```plsql
                DECLARE
                    l_url varchar2(2000);
                    l_app number := 2000;
                    l_session number := v('APP_SESSION');
                BEGIN
                    l_url := APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p=' || l_app || ':86:'||l_session||'::NO::P86_IDPEDIDO:'||:P502_IDPEDIDO,
                        p_checksum_type => 'SESSION');
                    
                    return l_url;
                END;
                ```
            used: always
        }
