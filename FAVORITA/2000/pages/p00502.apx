page 502 (
    name: Impressão de pedido por nota fiscal
    title: Impressão de pedido por nota fiscal
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function abrirpedido() 
              {
                  vurl = document.getElementById("P502_SESSION_PEDIDO").value;
                  pjan = window.open(vurl,'_blank'); void(0);
                  pjan.focus();
              }
            
            function imprimirpedido() 
              {
                  vurl = document.getElementById("P502_SESSION_IMPRIMIR").value;
                  pjan = window.open(vurl,'page','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1280,height=1024,left=20,top=10','_blank'); void(0);
                  pjan.focus();
              }
            
            function imprimirboleto()
            {   
              vidpedido = document.getElementById("P502_IDPEDIDO").value;
              vidvendedora = document.getElementById("P502_IDVENDEDORA").value;
              /*vurl = 'https://boleto.romancemoda.com.br/boleto_bb_favorita_sem_iframe_com_pix_v2.php?cod1='+vidpedido+'&cod2='+vidvendedora;*/
              vurl = document.getElementById('P0_URLBOLETOBASE').value+'?cod1='+vidpedido+'&cod2='+vidvendedora;
              pjan = window.open(vurl,'boleto','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1024,height=1000,left=20,top=10','_blank'); 
              pjan.focus();
            }
            
            function confirma_apagar_pedido(vitem)
            {
              apex.item('P502_IDPEDIDOAPAGAR').setValue(vitem);
              var answer = confirm("Confirma que quer apagar o pedido?")
              if (answer)
              {
                apex.submit('APAGARPEDIDO');
              }
                
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region devoluções-integradas-hoje (
        name: Devoluções Integradas Hoje
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.usuariosolicitou
                     , p.dataprotocolo
                     , p.idpedido
                     , descsituacao
                     , Justificativa
                     , vendedora
                     , valortotal
                from vw_protocolosatendimentos_fav p
                where p.justificativa like 'NF de devolucao V.A.%'
                  and p.justificativa like '%Empresa: ' || :P502_IDEMPRESAVIRTUALAGE ||
                                           ' - Nota: ' || :P502_IDNOTAFISCAL || '%'
                  and p.dataprotocolo between to_date(:P502_DATA || ' 00:00:00', 'dd/mm/rrrr hh24:mi:ss') - 2
                                          and to_date(:P502_DATA || ' 23:59:59', 'dd/mm/rrrr hh24:mi:ss') + 2
                ```
            pageItemsToSubmit: [
                P502_DATA
                P502_IDEMPRESAVIRTUALAGE
            ]
        }
        layout {
            sequence: 55
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 5210124588952334316
        }

