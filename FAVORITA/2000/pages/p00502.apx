    validation verifica-devolução-ja-integrada (
        name: Verifica devolução ja integrada
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from favorita.protocolosatendimentos p
                where p.situacao = 'C'
                  and exists ( select 1
                               from favorita.pedidos pp
                               where pp.idpedido = p.idpedido
                                 and pp.idempresavirtualage = :P502_IDEMPRESAVIRTUALAGE ) 
                  and p.justificativa like '%V.A.%'
                  and p.justificativa like '% - Nota: '||:P502_IDNOTAFISCAL||'%';
                ```
        }
        error {
            errorMessage: Troca ja integrada
        }
        serverSideCondition {
            type: never
        }
        comments {
            comments:
                ```
                -- ticket 12645349 - 
                
                ```
        }
    )

    process apagar-o-pedido (
        name: Apagar o Pedido
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidpedido number := :P502_IDPEDIDOAPAGAR;
                  --
                  begin
                  --
                  favorita.pck_integracao_virtualagev2.prc_cancela_pedido( vidpedido
                                                                         , 'N');
                  --
                  update favorita.pedidos p
                  set p.idtransacaovirtualage = null
                  where p.idpedido = vidpedido;
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 30798321295604037
        }
        serverSideCondition {
            type: request=Value
            value: APAGARPEDIDO
        }
    )

    process busca-pedido (
        name: Busca Pedido
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vdata         date := :P502_DATA;
                  vmensagem     varchar2(4000);
                  vtipooperacoa number;
                  verro         boolean;
                  vtipopedido   varchar(1);
                  --
                begin
                  --
                  begin
                    --
                    select t.codoperacaofiscal
                      into vtipooperacoa 
                      from favorita.tipooperacaointvirtual t
                     where t.idtipooperacaointvirtual = :P502_TIPOOPERACAO;
                     --
                     
                     --
                     /*exception 
                       when no_data_found then
                         RAISE_APPLICATION_ERROR(-20001,'Não encontrado TIPO OPERACAO VIRTUAL para a operação '||:P502_TIPOOPERACAO);
                       when others then
                         RAISE_APPLICATION_ERROR(-20002,SQLERRM);*/
                  end;
                  --
                  :P502_IDPEDIDO    := null;
                  :P502_IDVENDEDORA := null;
                  :P502_MENSAGEM    := null;
                  --      
                  if :P502_ROMANCECASA = 'Y' then
                    vtipopedido := 'R';
                  else
                    vtipopedido := 'P';
                  end if;
                  -- 
                  -- BUSCA A NOTA DE SAIDA PRIMEIRO
                  pck_integracao_virtualagev2.prc_processa_pedidos( pdt_ini        => vdata
                                                                  , pdt_fim        => vdata
                                                                  , pid_empresa_va => :P502_IDEMPRESAVIRTUALAGE
                                                                  , pidnota        => :P502_IDNOTAFISCAL
                                                                  , pid_tipopercao => vtipooperacoa
                                                                  , ptp_nfe        => 'S'
                                                                  , pcpf           => :P502_CPF
                                                                  , pretornoOutput => false
                                                                  , perro          => verro
                                                                  , presposta      => vmensagem
                                                                  , pidusuario_call => :P502_IDUSUARIO
                                                                  , ptipopedido =>  vtipopedido );
                  -- 
                  --
                  -- SE ACHAR, JÁ REDIRECIONA
                  --if verro then
                    --:P502_MENSAGEM    := '<p style="color:red">' || vmensagem || '<p>' ;
                  --end if;
                  --
                  commit;
                  --
                  
                  if :P502_TIPOOPERACAO = 1 then
                    --
                    begin
                      --
                      select p.idpedido
                           , p.idvendedora
                        into :P502_IDPEDIDO
                           , :P502_IDVENDEDORA
                        from favorita.classificacoespedidos cp
                           , favorita.pedidos p
                       where p.idpedido                 = cp.idpedido
                         and cp.idvalorcaracteristica   = :P502_IDNOTAFISCAL
                         and cp.idcaracteristicapedido  = 91
                         and cp.observacao              in ('nfe')
                         and p.idempresavirtualage      = :P502_IDEMPRESAVIRTUALAGE
                         and p.datacancelamento         is null
                         --
                         and exists (select *
                                       from favorita.protocolosatendimentos pp
                                      where pp.idpedido = p.idpedido) ;
                         /*and (v('APP_USER') <> 'DIEGOPIECHO' or exists (select *
                                                                          from favorita.protocolosatendimentos pp
                                                                         where pp.idpedido = p.idpedido) )*/
                         --
                       --
                       --
                      -- exception 
                      --   when no_data_found then
                        --   RAISE_APPLICATION_ERROR(-20002,'Não encontrado CLASSIFICACAO PEDIDO "Numero da Nota no Virtual (nfe)" para a operação '||:P502_TIPOOPERACAO||' . Verifique as classificações do pedido.');
                        -- when others then
                           --RAISE_APPLICATION_ERROR(-20003,SQLERRM);
                     end;
                     --
                  elsif :P502_TIPOOPERACAO in (2,3) then
                    --
                    begin
                    --
                    select p.idpedido
                         , p.idvendedora
                    into :P502_IDPEDIDO
                       , :P502_IDVENDEDORA
                    from favorita.classificacoespedidos cp
                       , favorita.pedidos p
                    where p.idpedido                 = cp.idpedido
                      and cp.idvalorcaracteristica   = :P502_IDNOTAFISCAL
                      and cp.idcaracteristicapedido  = 91
                      and cp.observacao              in ('nfce')
                      and p.idempresavirtualage      = :P502_IDEMPRESAVIRTUALAGE
                      and p.datacancelamento         is null
                      and exists (select *
                                    from favorita.protocolosatendimentos pp
                                   where pp.idpedido = p.idpedido) ;
                     --
                     --exception 
                        -- when no_data_found then
                          -- RAISE_APPLICATION_ERROR(-20004,'Não encontrado CLASSIFICACAO PEDIDO "Numero da Nota no Virtual (nfce)" para a operação '||:P502_TIPOOPERACAO||' . Verifique as classificações do pedido.');
                         --when others then
                           --RAISE_APPLICATION_ERROR(-20005,SQLERRM);
                     end;
                     --
                  end if;
                  --:P502_MENSAGEM := '<p style="color:blue">Pedido encontrado com sucesso<p>';
                  --
                  -- Ticket <numero> - respeita o retorno de erro da integracao de SAIDA,
                  -- em vez de sobrescrever incondicionalmente com mensagem de sucesso
                  --
                  if verro then
                    :P502_MENSAGEM := '<p style="color:red">' || vmensagem || '</p>';
                  else
                    :P502_MENSAGEM := '<p style="color:blue">Pedido encontrado com sucesso</p>';
                  end if;
                  --
                exception
                  when no_data_found then
                    --
                    :P502_IDPEDIDO    := null;
                    :P502_IDVENDEDORA := null;
                    --:P502_MENSAGEM    := vmensagem;--'<p style="color:red">Problema ao encontrar a nota, favor abrir um evento<p>'||;
                    -- Ticket <numero> - limpa o erro da tentativa de SAIDA antes de tentar a ENTRADA.
                    -- A nota de devolucao (operacao 1604) e sempre rejeitada no caminho de SAIDA,
                    -- e a mensagem dessa rejeicao nao deve ser exibida quando a ENTRADA integra com sucesso.
                    --
                    :P502_MENSAGEM := null;
                    verro          := false;
                    vmensagem      := null;
                    --
                   /*if v('APP_USER') = 'DIEGOPIECHO' then
                      raise_application_error(-20001,'Idnotafiscal = '||:P502_IDNOTAFISCAL);
                    end if;*/
                    --
                    pck_integracao_virtualagev2.prc_processa_pedidos( pdt_ini        => vdata --1
                                                                    , pdt_fim        => vdata
                                                                    , pid_empresa_va => :P502_IDEMPRESAVIRTUALAGE
                                                                    , pidnota        => :P502_IDNOTAFISCAL
                                                                    , pid_tipopercao => vtipooperacoa 
                                                                    , ptp_nfe        => 'E'
                                                                    , pcpf           => :P502_CPF
                                                                    , pretornoOutput => false
                                                                    , perro          => verro
                                                                    , presposta      => vmensagem
                                                                    , pidusuario_call => :P502_IDUSUARIO
                                                                    , ptipopedido =>  vtipopedido );
                    --
                    -- Ticket <numero> - exibe o resultado real da integracao da ENTRADA
                    --
                    if verro then
                      :P502_MENSAGEM := '<p style="color:red">' || vmensagem || '</p>';
                    else
                      :P502_MENSAGEM := '<p style="color:blue">Devolução integrada com sucesso</p>';
                    end if;
                    --
                   when others then
                     RAISE_APPLICATION_ERROR(-20005,SQLERRM);
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 498913302253744226
        }
        serverSideCondition {
            type: request=Value
            value: BUSCARNOTA
        }
    )

    process busca-pedido-teste (
        name: Busca Pedido_TESTE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vdata         date := :P502_DATA;
                  vmensagem     varchar2(4000);
                  vtipooperacoa number;
                  verro         boolean;
                  vtipopedido   varchar(1);
                  --
                begin
                  --
                  begin
                    --
                    select t.codoperacaofiscal
                      into vtipooperacoa 
                      from favorita.tipooperacaointvirtual t
                     where t.idtipooperacaointvirtual = :P502_TIPOOPERACAO;
                     --
                     /*exception 
                       when no_data_found then
                         RAISE_APPLICATION_ERROR(-20001,'Não encontrado TIPO OPERACAO VIRTUAL para a operação '||:P502_TIPOOPERACAO);
                       when others then
                         RAISE_APPLICATION_ERROR(-20002,SQLERRM);*/
                  end;
                  --
                  :P502_IDPEDIDO    := null;
                  :P502_IDVENDEDORA := null;
                  :P502_MENSAGEM    := null;
                  --      
                  if :P502_ROMANCECASA = 'Y' then
                    vtipopedido := 'R';
                  else
                    vtipopedido := 'P';
                  end if;
                  -- 
                    :P502_IDPEDIDO    := null;
                    :P502_IDVENDEDORA := null;   
                    :P502_MENSAGEM    := vmensagem;--'<p style="color:red">Problema ao encontrar a nota, favor abrir um evento<p>'||;
                    --
                    if v('APP_USER') <> 'DIEGOPIECHO' THEN
                    pck_integracao_virtualagev2.prc_processa_pedidos( pdt_ini        => vdata --1
                                                                    , pdt_fim        => vdata
                                                                    , pid_empresa_va => :P502_IDEMPRESAVIRTUALAGE
                                                                    , pidnota        => :P502_IDNOTAFISCAL
                                                                    , pid_tipopercao => vtipooperacoa 
                                                                    , ptp_nfe        => 'E'
                                                                    , pcpf           => :P502_CPF
                                                                    , pretornoOutput => false
                                                                    , perro          => verro
                                                                    , presposta      => vmensagem
                                                                    , pidusuario_call => :P502_IDUSUARIO
                                                                    , ptipopedido =>  vtipopedido );
                    ELSE
                     pck_integracao_virtualagev2.prc_processa_pedidos( pdt_ini       => '01/04/2026' --1
                                                                    , pdt_fim        => '01/04/2026'
                                                                    , pid_empresa_va => 318
                                                                    , pidnota        => 550
                                                                    , pid_tipopercao => 55 
                                                                    , ptp_nfe        => 'E'
                                                                    , pcpf           => NULL
                                                                    , pretornoOutput => false
                                                                    , perro          => verro
                                                                    , presposta      => vmensagem
                                                                    , pidusuario_call => 6819
                                                                    , ptipopedido =>  vtipopedido );
                      --
                    END IF;
                    --
                    exception 
                       when no_data_found then
                         RAISE_APPLICATION_ERROR(-20001,'Não encontrado TIPO OPERACAO VIRTUAL para a operação '||:P502_TIPOOPERACAO);
                       when others then
                         RAISE_APPLICATION_ERROR(-20002,SQLERRM);
                end;
                
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 512255278030613305
        }
        serverSideCondition {
            whenButtonPressed: @buscar-2
        }
    )

    branch (
        name: Go To Page 502
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 502
                items: {
                    P502_IDEMPRESAVIRTUALAGE: &P502_IDEMPRESAVIRTUALAGE.
                    P502_TIPOOPERACAO: &P502_TIPOOPERACAO.
                    P502_IDNOTAFISCAL: &P502_IDNOTAFISCAL.
                    P502_IDPEDIDO: &P502_IDPEDIDO.
                }
                action: resetPagination
            }
        }
    )

)

