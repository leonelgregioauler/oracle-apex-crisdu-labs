page 343 (
    name: Cadastro MEI
    title: Cadastro MEI
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 80%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-mei (
        name: Cadastro MEI
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P343_ATIVO (
        type: radioGroup
        label {
            label: Ativo
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-simnao
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 100
            region: @cadastro-mei
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P343_BAIRRO (
        type: textField
        label {
            label: Bairro
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 60
            region: @cadastro-mei
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P343_CEP (
        type: textField
        label {
            label: CEP
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 70
            region: @cadastro-mei
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            customAttributes: "onkeyPress=\"javascript:{formatar_mascara(this, '##.###-###',event); }\"; onblur=\"javascript:{formataCEP(this); }\" ;"
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P343_CNPJ (
        type: textField
        label {
            label: Cnpj
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @cadastro-mei
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            customAttributes: "onkeyPress=\"javascript:{formatar_mascara(this, '##.###.###/####-##',event); }\" ;  onblur=\"javascript:{formataCNPJ(this); }\" ;"
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P343_CODIGOVIRTUALAGE (
        type: displayOnly
        label {
            label: Código no Virtual Age
            alignment: left
        }
        layout {
            sequence: 110
            region: @cadastro-mei
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P343_ENDERECO (
        type: textField
        label {
            label: Endereço
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 50
            region: @cadastro-mei
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P343_IDCIDADE (
        type: popupLov
        label {
            label: Cidade
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sharedComponent
            lov: @lov-cidades
        }
        layout {
            sequence: 80
            region: @cadastro-mei
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P343_IDFILIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 120
            region: @cadastro-mei
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P343_IDMEI (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @cadastro-mei
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P343_IDPESSOA (
        type: hidden
        layout {
            sequence: 20
            region: @cadastro-mei
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P343_IMPRESSORACOMPRADA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 130
            region: @cadastro-mei
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P343_INCRESTADUAL (
        type: textField
        label {
            label: Inscr. Estadual
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 90
            region: @cadastro-mei
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P343_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 140
            region: @cadastro-mei
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P343_OPERACAO_DML (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 150
            region: @cadastro-mei
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P343_RAZAOSOCIAL (
        type: textField
        label {
            label: Razão Social
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @cadastro-mei
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 70
            region: @cadastro-mei
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P343_IDMEI
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 60
            region: @cadastro-mei
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P343_IDMEI
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 50
            region: @cadastro-mei
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 85
                items: {
                    P85_IDPESSOA: &P343_IDPESSOA.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 40
            region: @cadastro-mei
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P343_IDMEI
        }
    )

    process consulta-mei (
        name: Consulta MEI
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                pck_cadastros_fav.prc_mei( pidmei 				=> :P343_IDMEI
                						 , pidpessoa 			=> :P343_IDPESSOA
                                         , prazaosocial 		=> :P343_RAZAOSOCIAL
                                         , pcnpj 				=> :P343_CNPJ
                                         , pendereco 			=> :P343_ENDERECO
                                         , pbairro 				=> :P343_BAIRRO
                                         , pcep 				=> :P343_CEP
                                         , pidcidade 			=> :P343_IDCIDADE
                                         , pincrestadual 		=> :P343_INCRESTADUAL
                                         , pativo 				=> :P343_ATIVO
                                         , pidfilial 			=> :P343_IDFILIAL
                                         , pimpressoracomprada 	=> :P343_IMPRESSORACOMPRADA
                                         , pcodigovirtualage    => :P343_CODIGOVIRTUALAGE
                                         , pmd5 				=> :P343_MD5
                                         , poperacao_dml 		=> 'S');
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1441714737274966138
        }
    )

    process limpar-campos-ao-sair (
        name: Limpar Campos ao Sair
        type: clearSessionState
        execution {
            sequence: 20
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 1444453481675536108
        }
    )

    process operação-dml-em-mei (
        name: Operação DML em MEI
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  pck_cadastros_fav.prc_mei( pidmei                 => :P343_IDMEI
                                           , pidpessoa              => :P343_IDPESSOA
                                           , prazaosocial           => :P343_RAZAOSOCIAL
                                           , pcnpj                  => :P343_CNPJ
                                           , pendereco              => :P343_ENDERECO
                                           , pbairro                => :P343_BAIRRO
                                           , pcep                   => :P343_CEP
                                           , pidcidade              => :P343_IDCIDADE
                                           , pincrestadual          => :P343_INCRESTADUAL
                                           , pativo                 => :P343_ATIVO
                                           , pidfilial              => :P343_IDFILIAL
                                           , pimpressoracomprada    => :P343_IMPRESSORACOMPRADA
                                           , pcodigovirtualage      => :P343_CODIGOVIRTUALAGE
                                           , pmd5                   => :P343_MD5
                                           , poperacao_dml          => voperacao_dml );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1444444952071445753
        }
    )

    branch (
        name: Go To Page 343
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 343
                items: {
                    P343_IDMEI: &P343_IDMEI.
                    P343_IDPESSOA: &P343_IDPESSOA.
                }
            }
        }
    )

)

