page 536 (
    name: Itens Grupos Pretransferencia
    title: Itens Grupos Pretransferencia
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG_24"';
    }

    region grupos-pre-transferencia (
        name: Grupos Pre-Transferencia
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region itens-do-grupo (
        name: Itens do Grupo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select iditensgrupospretransf, idprodutodetalhado, idusuarioalt, dataalt, idgrupospretransf
                  from itensgrupospretransferencia
                 where idgrupospretransf = :P536_IDGRUPOSPRETRANSF
                ```
            pageItemsToSubmit: P536_IDGRUPOSPRETRANSF
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum item de grupo cadastrado!
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 23439110379909501
        }

        column DATAALT (
            type: plainText
            heading {
                heading: Data Incl/Alt
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column IDGRUPOSPRETRANSF (
            type: hidden
            heading {
                heading: Idgrupospretransf
            }
            layout {
                sequence: 50
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDITENSGRUPOSPRETRANSF (
            type: link
            heading {
                heading: Editar
            }
            layout {
                sequence: 10
            }
            link {
                target: {
                    page: 538
                    items: {
                        P538_IDITENSGRUPOSPRETRANSF: #IDITENSGRUPOSPRETRANSF#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column IDPRODUTODETALHADO (
            type: plainTextBasedOnLov
            heading {
                heading: Produto
            }
            lov {
                lov: @lov-produtosdetalhados
            }
            layout {
                sequence: 20
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column IDUSUARIOALT (
            type: plainTextBasedOnLov
            heading {
                heading: Usuário Incl/Alt
            }
            lov {
                lov: @lov-usuarios
            }
            layout {
                sequence: 30
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        savedReport 234531 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAALT (
                sequence: 4
            )

            displayColumn IDGRUPOSPRETRANSF (
                sequence: 5
            )

            displayColumn IDITENSGRUPOSPRETRANSF (
                sequence: 1
            )

            displayColumn IDPRODUTODETALHADO (
                sequence: 2
            )

            displayColumn IDUSUARIOALT (
                sequence: 3
            )

        )

    )

    pageItem P536_DESCRICAOGRUPO (
        type: textField
        label {
            label: Descrição
            alignment: left
        }
        layout {
            sequence: 20
            region: @grupos-pre-transferencia
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 100
        }
        source {
            type: databaseColumn
            databaseColumn: DESCRICAOGRUPO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P536_IDGRUPOSPRETRANSF (
        type: hidden
        layout {
            sequence: 10
            region: @grupos-pre-transferencia
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDGRUPOSPRETRANSF
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P536_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        layout {
            sequence: 30
            region: @grupos-pre-transferencia
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
            height: 3
        }
        validation {
            maxLength: 1000
        }
        source {
            type: databaseColumn
            databaseColumn: OBSERVACAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @grupos-pre-transferencia
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 534
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Incluir
        layout {
            sequence: 40
            region: @grupos-pre-transferencia
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P536_IDGRUPOSPRETRANSF
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @grupos-pre-transferencia
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P536_IDGRUPOSPRETRANSF
        }
    )

    button itens (
        buttonName: ITENS
        label: Incluir Itens
        layout {
            sequence: 50
            region: @grupos-pre-transferencia
            slot: help
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 538
                items: {
                    P538_IDGRUPOSPRETRANSF: &P536_IDGRUPOSPRETRANSF.
                }
                clearCache: 538
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar Alterações
        layout {
            sequence: 30
            region: @grupos-pre-transferencia
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P536_IDGRUPOSPRETRANSF
        }
    )

    dynamicAction atualiza-itens (
        name: Atualiza_Itens
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @itens-do-grupo
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @itens-do-grupo
            }
            execution {
                sequence: 10
            }
        )

    )

    process fetch-row-from-grupospretransferencia (
        name: Fetch Row from GRUPOSPRETRANSFERENCIA
        type: autoRowFetch
        source {
            tableName: GRUPOSPRETRANSFERENCIA
            pkColumn: IDGRUPOSPRETRANSF
            pkItem: P536_IDGRUPOSPRETRANSF
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 23045016559251095
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P536_IDGRUPOSPRETRANSF is null then
                        select "#OWNER#"."SEQ_IDGRUPOSPRETRANSF".nextval
                          into :P536_IDGRUPOSPRETRANSF
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 23045409441251098
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-grupospretransferencia (
        name: Process Row of GRUPOSPRETRANSFERENCIA
        type: autoRowProcessing
        target {
            tableName: GRUPOSPRETRANSFERENCIA
            pkColumn: IDGRUPOSPRETRANSF
            pkItem: P536_IDGRUPOSPRETRANSF
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada
        }
        advanced {
            executionMappingIdentifier: 23045865008251099
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 534
            }
        }
    )

)

