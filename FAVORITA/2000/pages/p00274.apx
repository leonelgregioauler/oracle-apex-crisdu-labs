page 274 (
    name: Relatório de Defeitos
    title: Relatório de Defeitos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region relatório-de-defeitos (
        name: Relatório de Defeitos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.iddefeito
                     , d.descricao
                     , d.descorigem
                     , d.descaparecer aparecer
                from vw_defeitos_fav d
                order by 2
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 275
                items: {
                    P275_IDDEFEITO: #IDDEFEITO#
                }
                action: resetPagination
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado
        }
        advanced {
            savedReportMappingIdentifier: 766871555114274910
        }

        column APARECER (
            type: plainText
            heading {
                heading: Aparecer
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column DESCORIGEM (
            type: plainText
            heading {
                heading: Origem
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column DESCRICAO (
            type: plainText
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column IDDEFEITO (
            type: hidden
            heading {
                heading: Iddefeito
            }
            layout {
                sequence: 10
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 7668985 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn APARECER (
                sequence: 4
            )

            displayColumn DESCORIGEM (
                sequence: 3
            )

            displayColumn DESCRICAO (
                sequence: 2
            )

            displayColumn IDDEFEITO (
                sequence: 1
            )

        )

    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 275
                items: {
                    P275_IDDEFEITO:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

