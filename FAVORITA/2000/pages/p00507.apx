page 507 (
    name: Cadastro de NCM
    title: Cadastro de NCM
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-de-ncm (
        name: Cadastro de NCM
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select n.idncm
                     , n.descricao
                from favorita.ncm N;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 116829143398667828
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDNCM
                layout {
                    width: 294
                    sequence: 2
                }
            )

            displayColumn (
                column: @DESCRICAO
                layout {
                    width: 1249
                    sequence: 3
                }
            )

            sort (
                column: @IDNCM
                sort {
                    nulls: last
                    sequence: 1
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column DESCRICAO (
            type: textarea
            heading {
                heading: Descrição
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
                maxLength: 1000
            }
            source {
                databaseColumn: DESCRICAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column IDNCM (
            type: numberField
            heading {
                heading: Código NCM
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDNCM
                dataType: number
                primaryKey: true
            }
            columnFilter {
                lovType: none
            }
        )

    )

    region mensagem-retorno (
        name: Mensagem Retorno
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P507_RESPOSTA
        }
    )

    pageItem P507_RESPOSTA (
        type: textField
        label {
            label: Resposta
            alignment: left
        }
        layout {
            sequence: 10
            region: @mensagem-retorno
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    process operacao-dml (
        name: OPERACAO_DML
        type: executeCode
        editableRegion: @cadastro-de-ncm
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vmd5   varchar(4000);
                  vdml   varchar(2);
                  vmensagemerro varchar(4000);
                  --
                begin  
                     --
                     :P507_RESPOSTA := '';
                     --
                     case :APEX$ROW_STATUS  
                     when 'C' then
                       --
                       PCK_CADASTROS_FAV.prc_ncm ( pidncm        => :IDNCM
                                                 , pdescricao    => :DESCRICAO
                                                 , pmd5          => vmd5
                                                 , poperacao_dml => 'I' 
                                                 , pmensagemerro => vmensagemerro);
                       --
                     when 'U' then  
                       --
                       PCK_CADASTROS_FAV.prc_ncm ( pidncm        => :IDNCM
                                                 , pdescricao    => :DESCRICAO
                                                 , pmd5          => vmd5
                                                 , poperacao_dml => 'U' 
                                                 , pmensagemerro => vmensagemerro);
                       --
                     when 'D' then  
                       --
                       PCK_CADASTROS_FAV.prc_ncm ( pidncm        => :IDNCM
                                                 , pdescricao    => :DESCRICAO
                                                 , pmd5          => vmd5
                                                 , poperacao_dml => 'D' 
                                                 , pmensagemerro => vmensagemerro);
                       --
                     end case;  
                     --
                     :P507_RESPOSTA := vmensagemerro;
                     --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Cadastrado/Alterado com sucesso
        }
        error {
            errorMessage: Erro ao Cadastrar
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 116829878274667835
        }
    )

)

