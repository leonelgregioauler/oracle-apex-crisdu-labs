page 397 (
    name: Nota Fiscal
    title: Nota Fiscal
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region itens-da-nota (
        name: Itens da Nota
        type: tabform
        source {
            sqlQuery:
                ```sql
                select infs.iditemnotafiscal
                     , infs.idnotafiscal
                     , infs.nomeproduto
                     , infs.quantidadecomercial
                     , infs.idprodutodetalhado 
                from crisdu.itensnotasfiscais infs
                where idnotafiscal = :P397_IDNOTAFISCAL
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column IDITEMNOTAFISCAL (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 1
            }
        )

        column IDNOTAFISCAL (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
        )

        column IDPRODUTODETALHADO (
            reportColumnQueryId: 5
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Produto Detalhado
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_util_fav.fnc_nomeprodutodetalhado (idprodutodetalhado, :P0_IDIDIOMA) as d
                         , idprodutodetalhado pd
                    from produtosdetalhados pd
                    
                    ```
            }
            layout {
                sequence: 6
                columnAlignment: center
            }
            appearance {
                width: 100
            }
            advanced {
                cssClasses: idprodutodetalhado
            }
        )

        column NOMEPRODUTO (
            reportColumnQueryId: 3
            derivedColumn: N
            type: plainTextSavesState
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 4
            }
        )

        column QUANTIDADECOMERCIAL (
            reportColumnQueryId: 4
            derivedColumn: N
            type: plainTextSavesState
            heading {
                heading: Quantidade Itens Nota
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
        )

    )

    region nota-fiscal (
        name: Nota Fiscal
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

