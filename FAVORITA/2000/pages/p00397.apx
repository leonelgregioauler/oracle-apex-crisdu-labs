    process consulta-nota-fiscal (
        name: Consulta Nota Fiscal
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vnumerocompravinculada   varchar2(100);
                  vidcompragerada          number;
                begin
                  --
                  :P397_NUMEROCOMPRAGERADA := null;
                  --
                  crisdu.pck_notasfiscais_crd.prc_notasfiscais( pidnotafiscal 				=> :P397_IDNOTAFISCAL,
                                                                pdatainclusao 				=> :P397_DATAINCLUSAO,
                                                                pdataultimaalteracao 		=> :P397_DATAULTIMAALTERACAO,
                                                                pdatavalidacao 				=> :P397_DATAVALIDACAO,
                                                                pdatarecebimento 			=> :P397_DATARECEBIMENTO,
                                                                pcodigovalidador 			=> :P397_CODIGOVALIDADOR,
                                                                pnaturezaoperacao 			=> :P397_NATUREZAOPERACAO,
                                                                pidformapagamento 			=> :P397_IDFORMAPAGAMENTO,
                                                                pmodelodocumento 			=> :P397_MODELODOCUMENTO,
                                                                pserie 						=> :P397_SERIE,
                                                                pnumero 					=> :P397_NUMERO,
                                                                pidformaemissao 			=> :P397_IDFORMAEMISSAO,
                                                                pdigitoverificador			=> :P397_DIGITOVERIFICADOR,
                                                                pidambiente 				=> :P397_IDAMBIENTE,
                                                                pfinalidadenfe 				=> :P397_FINALIDADENFE,
                                                                pversaoprocesso 			=> :P397_VERSAOPROCESSO,
                                                                pdataemissao 				=> :P397_DATAEMISSAO,
                                                                pdataentradasaida			=> :P397_DATAENTRADASAIDA,
                                                                ptipodocumento 				=> :P397_TIPODOCUMENTO,
                                                                pidmunicipiofg 				=> :P397_IDMUNICIPIOFG,
                                                                pchavedeacesso 				=> :P397_CHAVEDEACESSO,
                                                                pidformatoimpressao 		=> :P397_IDFORMATOIMPRESSAO,
                                                                pidrazaosocialemitente 		=> :P397_IDRAZAOSOCIALEMITENTE,
                                                                pidrazaosocialdestinatario   => :P397_IDRAZAOSOCIALDESTINATARIO,
                                                                pidrazaosocialtransportadora => :P397_IDRAZAOSOCIALTRANSPORT,
                                                                pidcliente 					 => :P397_IDCLIENTE,
                                                                pconhecimentotransporte 	 => :P397_CONHECIMENTOTRANSPORTE,
                                                                pidusuario 					 => :P397_IDUSUARIO,
                                                                pidsituacao 				=> :P397_IDSITUACAO,
                                                                pidnaturezaoperacao 		=> :P397_IDNATUREZAOPERACAO,
                                                                pprotocolodeautorizacao 	=> :P397_PROTOCOLODEAUTORIZACAO,
                                                                pbasecalculoicms 			=> :P397_BASECALCULOICMS,
                                                                pvaloricms 					=> :P397_VALORICMS,
                                                                pvaloricmsdesonerado 		=> :P397_VALORICMSDESONERADO,
                                                                pvalortotalfcp 				=> :P397_VALORTOTALFCP,
                                                                pvaloricmsfcp_ufdest 		=> :P397_VALORICMSFCP_UFDEST,
                                                                pvaloricmsufdest 			=> :P397_VALORICMSUFDEST,
                                                                pvaloricmsufremet 			=> :P397_VALORICMSUFREMET,
                                                                pbasecalculoicmsst 			=> :P397_BASECALCULOICMSST,
                                                                pvaloricmsst 				=> :P397_VALORICMSST,
                                                                pvalortotalfcpst 			=> :P397_VALORTOTALFCPST,
                                                                pvalortotalfcpstretido 		=> :P397_VALORTOTALFCPSTRETIDO,
                                                                pvalortotalprodutos 		=> :P397_VALORTOTALPRODUTOS,
                                                                pvalorfrete 				=> :P397_VALORFRETE,
                                                                pvalorseguro 				=> :P397_VALORSEGURO,
                                                                pvalordesconto 				=> :P397_VALORDESCONTO,
                                                                pvalorimpostoimportacao 	=> :P397_VALORIMPOSTOIMPORTACAO,
                                                                pvaloripi 					=> :P397_VALORIPI,
                                                                pvaloripidevolvido 			=> :P397_VALORIPIDEVOLVIDO,
                                                                pvalorpis 					=> :P397_VALORPIS,
                                                                pvalorcofins 				=> :P397_VALORCOFINS,
                                                                pvalordespesasacessorias 	=> :P397_VALORDESPESASACESSORIAS,
                                                                pvalortotalnota 			=> :P397_VALORTOTALNOTA,
                                                                pvalortotaltributos 		=> :P397_VALORTOTALTRIBUTOS,
                                                                pidmodalidadefrete 			=> :P397_IDMODALIDADEFRETE,
                                                                pcodigoantt 				=> :P397_CODIGOANTT,
                                                                pplacaveiculo 				=> :P397_PLACAVEICULO,
                                                                pufveiculo 					=> :P397_UFVEICULO,
                                                                pvolumes 					=> :P397_VOLUMES,
                                                                pobservacao 				=> :P397_OBSERVACAO,
                                                                pnomearquivoxml 			=> :P397_NOMEARQUIVOXML,
                                                                poperacao_dml 				=> 'S',
                                                                pmd5 						=> :P397_MD5,
                                                                pidpessoadestinatario 		=> :P397_IDPESSOADESTINATARIO,
                                                                pidpedidofavorita 			=> :P397_IDPEDIDOFAVORITA,
                                                                pidoperacao 				=> :P397_IDOPERACAO);
                  --
                  begin
                    --
                    select idcompratransferenciaorigem
                    into vnumerocompravinculada
                    from comprastransferencias 
                    where idnotafiscal = :P397_IDNOTAFISCAL;
                    --
                    :P397_NUMEROCOMPRAVINCULADA := vnumerocompravinculada;
                    --
                  exception
                    when others then
                      if :P397_ORIGEM = 396 then
                        :P397_NUMEROCOMPRAVINCULADA := null;
                      else
                        null;
                      end if;
                      --
                  end;
                  --
                  begin
                    --
                    select idcompratransferencia 
                    into vidcompragerada
                    from comprastransferencias 
                    where idnotafiscal = :P397_IDNOTAFISCAL;
                    --
                    :P397_NUMEROCOMPRAGERADA := vidcompragerada;
                    --
                  exception
                    when others then
                      :P397_NUMEROCOMPRAGERADA := null;
                  end;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1553276913781417211
        }
    )

    process gerar-nova-compra (
        name: Gerar Nova Compra
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vnumnull             number;
                  vvarnull             varchar2(1);
                  vidcompravinculada   number := :P397_NUMEROCOMPRAVINCULADA;
                  vidcompragerada      number;
                  vidnotafiscal        number := :P397_IDNOTAFISCAL;
                  vnumeronota          number := :P397_NUMERO;
                  vsysdate             date   := sysdate;
                  vdata                date;
                  vdataemissao         date   := :P397_DATAEMISSAO;
                  vdataembarque        date   := :P397_DATAEMISSAO;
                  vpeso                number;
                  vvolumes             number;
                  vidusuario           number := :P0_IDUSUARIO;
                  vidordemcompra       number;
                begin
                  --
                  select peso
                       , numerovolumes
                  into vpeso
                     , vvolumes
                  from crisdu.volumesnotasfiscais
                  where idnotafiscal = vidnotafiscal;
                  --
                  for i in ( select * 
                             from comprastransferencias 
                             where idcompratransferencia = vidcompravinculada ) loop
                    -- 
                    -- Cria nova compra
                    pck_comprastransf_fav.prc_comprastransferencias (  pidcompratransferencia       => vidcompragerada,
                                                                       pidfornecedor                => i.idfornecedor,
                                                                       pidfilialfavoritaorigem      => i.idfilialfavoritaorigem,
                                                                       pidfilialfavoritadestino     => i.idfilialfavoritadestino,
                                                                       pidfilialromancedestino      => i.idfilialromancedestino,
                                                                       pidpostoavancadodestino      => i.idpostoavancadodestino,
                                                                       pnumero                      => vnumnull,
                                                                       pidsituacao                  => vnumnull,
                                                                       pnotafiscal                  => vnumeronota,
                                                                       pdataemissao                 => vdataemissao,
                                                                       pdatarecebimento             => vdata,
                                                                       pdataembarque                => vdataembarque,
                                                                       pdataprevisaoentrega         => vdata,
                                                                       pvalortotalcompra            => vnumnull,
                                                                       pcubagem                     => vnumnull,
                                                                       pvolume                      => vvolumes,
                                                                       ppeso                        => vpeso,
                                                                       pobservacao                  => vnumnull,
                                                                       pidtipo                      => i.idtipocomptransrem,
                                                                       poperacao_dml                => 'I',
                                                                       pmd5                         => vvarnull,
                                                                       pidusuario                   => vidusuario,
                                                                       pidsemanaentrega             => vnumnull,
                                                                       panaliseconcluida            => vvarnull,
                                                                       pidentificacaointerna        => i.identificacaointerna,
                                                                       pdataemissaoinicial          => vdata,
                                                                       pdataemissaofinal            => vdata,
                                                                       pidnotafiscal                => vidnotafiscal,
                                                                       pidcompratransferenciaorigem => i.idcompratransferencia,
                                                                       pidordemcompra               => vidordemcompra);
                    --
                  end loop;
                  --
                  :P397_NUMEROCOMPRAGERADA := vidcompragerada;
                  --
                  for a in ( select nvl(ic.valorcusto
                                  , pck_comprastransf_fav.fnc_retornavalorcustoitem( pidprodutodetalhado => ic.idprodutodetalhado,
                                                                                     pidfilialfavorita   => ct.idfilialfavoritadestino,
                                                                                     ptipovenda          => 'R' ) ) valorcusto
                                  , infs.*
                             from itenscomprastransferencias ic 
                                , comprastransferencias      ct
                                , crisdu.itensnotasfiscais   infs
                             where ic.idcompratransferencia = ct.idcompratransferencia 
                             and ic.idprodutodetalhado      = infs.idprodutodetalhado
                             and ic.idcompratransferencia   = vidcompravinculada 
                             and infs.idnotafiscal          = vidnotafiscal 
                             and infs.idprodutodetalhado    is not null ) 
                  loop
                    --
                    -- Inclui os itens da nota na nova compra
                    pck_comprastransf_fav.prc_itenscomprastransferencias (piditemcompratransferencia   => vnumnull,
                                                                          pidcompratransferencia       => vidcompragerada,
                                                                          pidprodutodetalhado          => a.idprodutodetalhado,
                                                                          pquantidadecomprada          => a.quantidadecomercial,
                                                                          pquantidaderecebida          => vnumnull,
                                                                          pquantidadeavariada          => vnumnull,
                                                                          pquantidaderecebidaadicional => vnumnull,
                                                                          pobservacao                  => vvarnull,
                                                                          pobservacaoavaria            => vvarnull,
                                                                          pmd5                         => vvarnull,
                                                                          poperacao_dml                => 'I',
                                                                          pidestoquefilorigem          => vnumnull,
                                                                          pidestoquefildestino         => vnumnull,
                                                                          pvalorcusto                  => a.valorcusto,
                                                                          pprocautoloja                => 'S' );
                    --
                    -- Atualiza a compra antiga, subtraindo as quantidades que foram incluídas na nova compra
                    update itenscomprastransferencias ic
                    set quantidadecomprada = ic.quantidadecomprada - a.quantidadecomercial
                    where ic.idprodutodetalhado = a.idprodutodetalhado
                    and ic.idcompratransferencia = vidcompravinculada;
                    --
                    commit;
                    --
                  end loop;
                  --
                  update comprastransferencias
                  set idsituacao = 20
                  where idcompratransferencia = vidcompragerada;
                  --
                  commit;
                  --
                end;
                   
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Compra &P397_NUMEROCOMPRAGERADA. Gerada com Sucesso.
        }
        error {
            errorMessage: Erro ao gerar nova compraa.
        }
        advanced {
            executionMappingIdentifier: 1560809002209066917
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'GERARCOMPRA'
        }
    )

    process inclui-nota-fiscal-na-compra-nova (
        name: Inclui Nota Fiscal na Compra Nova
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vblob           BLOB;
                  vbfile          BFILE;
                  vnomearquivo    varchar2(100);
                  vnomearquivopdf varchar2(100);
                  vnomearquivoxml varchar2(100);
                  vcompragerada   number := :P397_NUMEROCOMPRAGERADA;
                  vnumnull        number;
                  vvarnull        varchar2(10);
                  vdata           date   := sysdate;
                  vcontador       number := 1;
                begin
                  --
                  select replace(nomearquivoxml,'.xml','.pdf') nomearquivopdf
                       , nomearquivoxml                        nomearquivoxml
                  into vnomearquivopdf, vnomearquivoxml
                  from crisdu.notasfiscais
                  where idnotafiscal = :P397_IDNOTAFISCAL;
                  --
                  <<PDF>>
                  vnomearquivo := vnomearquivopdf;
                  --
                  <<INICIO>>
                  vbfile := bfilename('XMLNFE', vnomearquivo);
                  --
                  if (dbms_lob.fileexists(vbfile) = 1) then
                    --  
                    insert into anexoscomprastransferencias
                    values ( seq_idanexocompratransferencia.nextval
                           , vcompragerada
                           , empty_blob()
                           , vvarnull
                           , vnomearquivo
                           , vdata
                           , vvarnull )
                    return attach_data into vblob;                                                   
                    --
                    vbfile := bfilename('XMLNFE', vnomearquivo);
                    -- 
                    dbms_lob.fileopen( vbfile, dbms_lob.file_readonly );
                    dbms_lob.loadfromfile( vblob, vbfile, dbms_lob.getlength(vbfile) );
                    dbms_lob.fileclose( vbfile );
                    --
                    commit;
                  else 
                    dbms_output.put_line('Arquivo não existe');
                  end if;   
                  --
                  <<XML>>
                  vnomearquivo := vnomearquivoxml;
                  vcontador    := vcontador + 1;
                  --
                  if vcontador = 2 then
                    GOTO INICIO;
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 1560978970529660603
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'GERARCOMPRA'
        }
    )

