    pageItem P397_IDRAZAOSOCIALDESTINATARIO (
        type: selectList
        label {
            label: Razão Social Destinatário
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(r.Nomefantasia, r.razaosocial)) as d
                     , r.idrazaosocial as r
                from crisdu.razoessociais r
                where r.idrazaosocial = :P397_IDRAZAOSOCIALDESTINATARIO
                ```
        }
