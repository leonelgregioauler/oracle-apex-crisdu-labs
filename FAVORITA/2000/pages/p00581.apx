    pageItem P581_IDFILIALROMANCE (
        type: selectList
        label {
            label: Filial Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.nome display_value
                     , w.idfilial  return_value
                from roman.vw_filiais w
                where w.ativo = 'S'
                  --and w.tipofilial = 'D'
                  and exists (  select 1
                                from usuarios u
                                where u.usuario = v('APP_USER')
                                 and u.idgerente in (29,143) )
                                 
                union
                
                select '>> TODAS <<' display_value
                     , -1 return_value
                from roman.vw_filiais w
                where w.ativo = 'S'
                  --and w.tipofilial = 'D'
                  and exists (  select 1
                                from usuarios u
                                where u.usuario = v('APP_USER')
                                 and u.idgerente in (29,143) )
                
                union 
                
                select h.nome display_value
                     , h.idfilial return_value
                from roman.vw_filiais h
                where h.idgerente = ( select g.idgerente
                                      from gerentes g
                                      where g.idpessoa = ( select u.idpessoa
                                                           from usuarios u
                                                           where u.usuario = v('APP_USER') ) )
                order by 1 
                
                                 
                 
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button atualiza (
        buttonName: ATUALIZA
        label: Atualiza Desafio
        layout {
            sequence: 10
            region: @engajamento-franquias
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuarios u
                where u.usuario = v('APP_USER') 
                 and trunc(sysdate) < to_date(:P581_DATAREFERENCIA) + 5
                 and :P581_DATAREFERENCIA is not null
                UNION
                select 1
                from dual
                where v('APP_USER') in ('BRUNOB','OSIELF','LUCASSOUZA','CESARH','EDUARDAZOTTI', 'CAMILABARTH')
                ```
        }
    )

