        }
    )

    process engajamento-save-interactive-grid-data (
        name: Engajamento - Save Interactive Grid Data
        type: executeCode
        editableRegion: @engajamento-distribuidores
        source {
            plsqlCode:
                ```plsql
                declare 
                 verro varchar2(1);
                 v1 number;
                 v2 number;
                 v_error_message VARCHAR2(200);
                begin
                  --
                  update engajamentosrepresentantes e
                  set e.valordesafioajustado2 = to_number(:VALORDESAFIOAJUSTADO2,'999G999G999G990D00')
                    , e.ticketmedioinformado = :TICKETMEDIOINFORMADO
                  where e.idengajamentorepresentante = :IDENGAJAMENTOREPRESENTANTE;
                  --
                 v1 := 0;
                 v2 := 0;
                 --
                 select sum(e.valordesafioajustado) 
                      , sum(e.valordesafioajustado2)
                 into v1
                    , v2
                 from engajamentosrepresentantes e
                 where e.idfilial = :P581_IDFILIALROMANCE
                   and e.datareferencia = :P581_DATAREFERENCIA;
                 --
                 if v2 < v1 then 
                 --raise_application_error(-20001,UPPER('A soma dos desafios ajustados não pode ser menor que os desafios estabelecidos originalmente!'));
                      apex_error.add_error(
                         p_message => 'A soma dos desafios ajustados não pode ser menor que os desafios estabelecidos originalmente. Por favor, verifique os valores informados.'||' '||'>>DISTRIBUIDOR<<:'||' '|| :REPRESENTANTE,
                         p_display_location => apex_error.c_inline_in_notification
                      );
                      ROLLBACK;
                 end if;
                 --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 561416690852570817
        }
    )

)

