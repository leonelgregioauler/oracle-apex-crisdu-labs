    process atualiza-desafio-dist (
        name: Atualiza Desafio Dist
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    v_idfilial NUMBER;
                BEGIN
                   --
                    IF :P581_IDFILIALROMANCE = -1 THEN -- Se o valor for -1, traga todos os resultados para todas as franquias
                      --
                      FOR franquia IN ( SELECT e.idfilial 
                                        FROM engajamentosfranquias e
                                        WHERE e.datareferencia = :P581_DATAREFERENCIA )
                      --
                      LOOP
                       --
                       favorita.prc_atualiza_desafio_rep( pidfilial       => franquia.idfilial,
                                                          pdatareferencia => TO_DATE(:P581_DATAREFERENCIA, 'dd/mm/rrrr'));
                       --
                      END LOOP;
                      --
                    ELSE -- Se um valor específico de filial foi selecionado, traga apenas para essa filial
                      --
                      favorita.prc_atualiza_desafio_rep( pidfilial       => :P581_IDFILIALROMANCE,
                                                         pdatareferencia => TO_DATE(:P581_DATAREFERENCIA, 'dd/mm/rrrr'));
                      --
                    END IF;
                  --
                END;
                
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 3071627658657358204
        }
        serverSideCondition {
            whenButtonPressed: @atualiza
        }
    )

