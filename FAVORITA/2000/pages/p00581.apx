    region engajamento-franquias (
        name: Engajamento Franquias
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.idfilial as "ID Filial"
                     , e.idfilial
                     , e.valordesafio
                     , e.valordesafioajustado
                     , e.valorrealizado
                     , case
                         when e.valordesafioajustado is null then 
                              e.valordesafio - e.valorrealizado  
                         else
                              valordesafioajustado - e.valorrealizado  
                       end faltaatingir
                     , e.qtdnotasabertas
                     , e.percengajatual
                     , e.percengajant
                     , e.desafioconsfav
                     , e.ticketmediocalculado
                     , e.ticketmedioajustado
                     , e.idengajamentofranquia
                     , e.metadesafio
                     , e.percengajnovo
                     -- Maicon Aimi - 12/03/2025 - 9964300
                     -- Maicon Aimi - 05/08/2025 - 10779226 alterado o fator conversão de divisão por multiplicação
                     , (e.valorrealizado * f.fatorconversao) "Realizado Convertido" -- 13433892
                     -- Maicon Aimi - 12/03/2025 - 9964300
                     -- Maicon Aimi - 05/08/2025 - 10779226 alterado o fator conversão de divisão por multiplicação
                     , (e.valordesafioajustado * f.fatorconversao) "Desafio Ajustado Convertido" -- 13433892
                  from favorita.engajamentosfranquias e
                     , catal.filiais f
                     , catal.pessoas p 
                 where f.idfilial(+) = e.idfilial
                   and p.idpessoa = f.idpessoa
                   and e.datareferencia  = to_date(:P581_DATAREFERENCIA,'dd/mm/rrrr')
                   and (   :P581_IDFILIALROMANCE is null 
                        or e.idfilial = :P581_IDFILIALROMANCE 
                        or :P581_IDFILIALROMANCE = -1)
                /*
                Caso esteja aqui verificando o pq a tela não retornou registros. 
                
                Para resolver, basta executar a procedure que está no job JOB_GATILHOCRESCIMENTO, 
                observado a data correta que é sempre 2 dias antes de terminar o mês
                */
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuarios u
                where u.usuario = v('APP_USER')
                 and u.idgerente in (29,143)
                ```
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        enableUsersTo {
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 3071534254047840002
        }

