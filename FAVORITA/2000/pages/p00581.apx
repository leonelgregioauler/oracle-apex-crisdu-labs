    dynamicAction atualizadesafio (
        name: AtualizaDesafio
        execution {
            sequence: 20
            eventScope: dynamic
        }
        when {
            selectionType: columns
            interactiveGrid: @engajamento-distribuidores
            columns: TICKETMEDIOINFORMADO
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: SELECT NVL(ROUND(to_number(:TICKETMEDIOINFORMADO) * to_number(:DESAFIOCONSFAV) ), :VALORDESAFIOAJUSTADO) FROM DUAL
                itemsToSubmit: [
                    TICKETMEDIOINFORMADO
                    DESAFIOCONSFAV
                ]
            }
            affectedElements {
                selectionType: columns
                columns: VALORDESAFIOAJUSTADO2
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction atualizaengaj (
        name: AtualizaEngaj
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    /*begin
                    
                    MERGE INTO engajamentosrepresentantes e
                        USING ( select p.idfilialromance
                                     , p.idrepresentante
                                     , round(sum(nvl(p.valorapagarfavorita*fatorconversao, 0)),2) realizadomes
                                  from vw_rank_pedidos_dist p
                                 where trunc(p.dataemissao) between :P581_DATAINICIAL 
                                                                and :P581_DATAFINAL  
                             group by  p.idfilialromance, p.idrepresentante )     h
                        ON (e.idfilial        = nvl(h.idfilialromance,e.idfilial) and 
                            e.idrepresentante = nvl(h.idrepresentante,e.idrepresentante) and
                            e.datareferencia = to_date(:P581_DATAREFERENCIA,'dd/mm/rrrr')  )
                      WHEN MATCHED THEN
                        UPDATE SET e.valorrealizado = nvl(h.realizadomes,0);
                    
                    commit;
                    
                    end;*/
                    declare
                    
                    v_moeda varchar2(2) := '$';
                    
                    begin
                    
                    UPDATE engajamentosrepresentantes e
                        SET e.valorrealizado = nvl((SELECT round(sum(nvl(p.valorapagarfavorita, 0)), 2)--round(sum(nvl(p.valorapagarfavorita * fatorconversao, 0)), 2)
                                                FROM vw_rank_pedidos_dist p
                                                WHERE trunc(p.dataemissao) BETWEEN :P581_DATAINICIAL AND :P581_DATAFINAL
                                                  AND e.idfilial = nvl(p.idfilialromance, e.idfilial)
                                                  AND e.idrepresentante = p.idrepresentante
                                                GROUP BY p.idfilialromance, p.idrepresentante),0)
                        WHERE e.datareferencia = TO_DATE(:P581_DATAREFERENCIA, 'dd/mm/yyyy');
                        
                    commit;    
                      --
                    end;
                    ```
                itemsToSubmit: [
                    P581_DATAINICIAL
                    P581_DATAFINAL
                    P581_IDFILIALROMANCE
                    P581_DATAREFERENCIA
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    
                    UPDATE engajamentosfranquias e
                        SET e.valorrealizado = nvl((SELECT round(sum(nvl(p.valorapagarfavorita, 0)), 2)--round(sum(nvl(p.valorapagarfavorita * fatorconversao, 0)), 2)
                                                FROM vw_rank_pedidos_dist p
                                                WHERE trunc(p.dataemissao) BETWEEN :P581_DATAINICIAL AND :P581_DATAFINAL
                                                  AND e.idfilial = p.idfilialromance
                                                 -- AND e.idrepresentante = nvl(p.idrepresentante, e.idrepresentante)
                                                GROUP BY p.idfilialromance),0)
                        WHERE e.datareferencia = TO_DATE(:P581_DATAREFERENCIA, 'dd/mm/yyyy');
                        
                    commit;    
                        
                    end;
                    ```
                itemsToSubmit: [
                    P581_DATAINICIAL
                    P581_DATAFINAL
                    P581_IDFILIALROMANCE
                    P581_DATAREFERENCIA
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

