page 581 (
    name: Relatorio Gatilho de Crescimento
    title: Relatorio Gatilho de Crescimento
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region engajamento-distribuidores (
        name: Engajamento Distribuidores
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.idfilial as "ID Filial"
                     , e.idfilial
                     , e.idrepresentante as "ID Repres."
                     , favorita.pck_util_fav.fnc_nomerepresentante(e.idrepresentante) "Representante"
                     , e.valordesafio  valordesafioorig
                     , e.valorrealizado
                     , GREATEST(
                         CASE
                           WHEN e.valordesafioajustado2 IS NOT NULL THEN 
                             e.valordesafioajustado2 - e.valorrealizado
                           WHEN e.valordesafioajustado IS NOT NULL THEN 
                             e.valordesafioajustado - e.valorrealizado
                           WHEN e.valordesafio IS NOT NULL THEN 
                             e.valordesafio - e.valorrealizado
                         END, 
                         0) faltaatingir
                     , e.qtdnotasabertas
                     , e.percengajatual
                     , e.percengajant
                     , e.desafioconsfav
                     , e.ticketmediocalculado
                     , e.ticketmedioinformado
                     , e.idengajamentorepresentante
                     , e.metadesafio
                     , e.ticketmediodistribuidor
                     , e.percengajnovo
                     , e.valordesafioajustado
                     , e.valordesafioajustado2
                     , ( select eg.ticketmedioajustado
                         from engajamentosfranquias eg
                         where eg.idfilial = e.idfilial
                           and eg.Datareferencia = e.datareferencia ) ticketmedioajustadofranq
                     
                     -- Maicon Aimi - 12/03/2025 - 9964300
                     -- Maicon Aimi - 05/08/2025 - 10779226 alterado o fator conversão de divisão por multiplicação
                     , ( e.valorrealizado * f.fatorconversao) "Realizado Convertido" -- 13433892
                     -- Maicon Aimi - 12/03/2025 - 9964300
                     -- Maicon Aimi - 05/08/2025 - 10779226 alterado o fator conversão de divisão por multiplicação
                     , (e.valordesafioajustado2 *  f.fatorconversao) "Desafio Ajustado Convertido" -- 13433892
                  from favorita.engajamentosrepresentantes e
                     , catal.filiais f
                     , catal.pessoas p
                 where f.idfilial = e.idfilial
                   and p.idpessoa = f.idpessoa
                   and e.datareferencia  = to_date(:P581_DATAREFERENCIA,'dd/mm/rrrr')
                   and (    :P581_IDFILIALROMANCE is null 
                         or e.idfilial = :P581_IDFILIALROMANCE 
                         or :P581_IDFILIALROMANCE = -1)
                     
                /*
                Caso esteja aqui verificando o pq a tela não retornou registros. 
                
                Para resolver, basta executar a procedure que está no job JOB_GATILHOCRESCIMENTO, 
                observado a data correta que é sempre 2 dias antes de terminar o mês
                */
                     
                
                ```
            pageItemsToSubmit: [
                P581_DATAINICIAL
                P581_DATAFINAL
                P581_IDFILIALROMANCE
                P581_DATAREFERENCIA
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P581_DATAFINAL
        }
        comments {
            comments:
                ```
                Caso esteja aqui verificando o pq a tela não retornou registros. 
                
                Para resolver, basta executar a procedure que está no job JOB_GATILHOCRESCIMENTO, 
                observado a data correta que é sempre 2 dias antes de terminar o mês
                ```
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        enableUsersTo {
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 561415200932570803
        }

