page 629 (
    name: Corrigir Desconto
    title: Corrigir Desconto
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 50%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region corrigir-desconto (
        name: Corrigir Desconto
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idpagamentopedido
                     , idformapagamento
                     , datapagamento
                     , valorpago
                --     , idsituacao
                     , desconto
                     , valorliquido
                     , observacao
                 from pagamentospedidos
                where idvencimentopedido = :P629_IDVENCIMENTOPEDIDO
                  and datapagamento is not null;
                ```
            pageItemsToSubmit: P629_IDVENCIMENTOPEDIDO
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: region
            fixedReportHeight: 300
        }
        advanced {
            savedReportMappingIdentifier: 2418018164506441089
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDPAGAMENTOPEDIDO
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDFORMAPAGAMENTO
                layout {
                    width: 120.16667175292969
                    sequence: 3
                }
            )

            displayColumn (
                column: @DATAPAGAMENTO
                layout {
                    width: 93.16665649414062
                    sequence: 4
                }
            )

            displayColumn (
                column: @VALORPAGO
                layout {
                    width: 89.16667175292969
                    sequence: 5
                }
            )

            displayColumn (
                column: @DESCONTO
                layout {
                    width: 79.16667175292969
                    sequence: 6
                }
            )

            displayColumn (
                column: @VALORLIQUIDO
                layout {
                    width: 98.16665649414062
                    sequence: 7
                }
            )

            displayColumn (
                column: @OBSERVACAO
                layout {
                    sequence: 22
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
            serverSideCondition {
                type: never
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
            serverSideCondition {
                type: never
            }
        )

        column DATAPAGAMENTO (
            type: displayOnly
            heading {
                heading: Data Pagto
            }
            layout {
                sequence: 50
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            source {
                databaseColumn: DATAPAGAMENTO
                dataType: date
            }
        )

        column DESCONTO (
            type: numberField
            heading {
                heading: Desconto
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                databaseColumn: DESCONTO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column IDFORMAPAGAMENTO (
            type: displayOnly
            heading {
                heading: Forma Pagto
            }
            settings {
                basedOn: lov
            }
            lov {
                type: sharedComponent
                lov: @lov-formaspagamentos
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDFORMAPAGAMENTO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDPAGAMENTOPEDIDO (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDPAGAMENTOPEDIDO
                dataType: number
                queryOnly: true
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column OBSERVACAO (
            type: textField
            heading {
                heading: Observação
            }
            layout {
                sequence: 100
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: OBSERVACAO
                dataType: varchar2
            }
            default {
                type: static
                staticValue: Desconto aplicado para ajuste de erro no processo do ADL que não atualiza corretamente o valorpago quando o cliente paga o boleto na loja
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column VALORLIQUIDO (
            type: numberField
            heading {
                heading: Valor Líquido
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                databaseColumn: VALORLIQUIDO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column VALORPAGO (
            type: numberField
            heading {
                heading: Valor a Pagar
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: VALORPAGO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

    )

    pageItem P629_IDVENCIMENTOPEDIDO (
        type: hidden
        layout {
            sequence: 10
            region: @corrigir-desconto
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            selectionType: columns
            interactiveGrid: @corrigir-desconto
            columns: DESCONTO
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :VALORPAGO - :DESCONTO
                itemsToSubmit: [
                    VALORPAGO
                    DESCONTO
                ]
            }
            affectedElements {
                selectionType: columns
                columns: VALORLIQUIDO
            }
            execution {
                sequence: 10
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                value: Desconto aplicado para ajuste de erro no processo do ADL que não atualiza corretamente o valorpago quando o cliente paga o boleto na loja
            }
            affectedElements {
                selectionType: columns
                columns: OBSERVACAO
            }
            execution {
                sequence: 20
            }
        )

    )

    process corrigir-desconto-save-interactive-grid-data (
        name: Corrigir Desconto - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @corrigir-desconto
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 2417906654241509420
        }
    )

)

