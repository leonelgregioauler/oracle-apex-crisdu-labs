    pageItem P176_IDPROTOCOLOATENDIMENTO (
        type: hidden
        layout {
            sequence: 40
            region: @selecionar-produto
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select idprotocoloatendimento 
                from protocolosatendimentos
                where idpedido = :P176_IDPEDIDO 
                  and idtipoprotocolo = 6
                  and situacao = 'P' ;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P176_QUANTIDADE (
        type: numberField
        label {
            label: Quantidade para trocar
            alignment: left
        }
        settings {
            minValue: 1
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 30
            region: @selecionar-produto
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 5
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P176_QUANTIDADEPEDIDO (
        type: selectList
        label {
            label: Quantidade disponível para troca
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select sum(quantidade - nvl((  select sum(it.quantidadetrocada)
                   from favorita.itenspedidostrocados it
                      , favorita.protocolosatendimentos p
                  where it.idprotocoloatendimento = p.idprotocoloatendimento
                    and it.iditempedidoorigem = v.iditempedido
                    and p.situacao <> 'R' ) ,0) )  display_value
                     , sum(quantidade - nvl((  select sum(it.quantidadetrocada)
                   from favorita.itenspedidostrocados it
                      , favorita.protocolosatendimentos p
                  where it.idprotocoloatendimento = p.idprotocoloatendimento
                    and it.iditempedidoorigem = v.iditempedido
                    and p.situacao <> 'R' ) ,0) ) return_value
                from favorita.itenspedidos          v
                where iditempedido = :P176_IDITEMPEDIDO;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P176_IDITEMPEDIDO
        }
        layout {
            sequence: 20
            region: @selecionar-produto
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button incluir (
        buttonName: INCLUIR
        label: Incluir
        layout {
            sequence: 10
            region: @selecionar-produto
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button proximo-passo (
        buttonName: PROXIMO_PASSO
        label: Proximo passo
        layout {
            sequence: 20
            region: @new
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from vw_itenspedidos_fav v
                   , itenspedidostrocados i
                where i.idpedido = :P176_IDPEDIDO
                  and v.ididioma = :P0_IDIDIOMA
                  and i.iditempedidoorigem = v.iditempedido
                ```
        }
    )

    validation quantidade (
        name: Quantidade
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where to_number(:P176_QUANTIDADE) <= to_number(:P176_QUANTIDADEPEDIDO)
                ```
        }
        error {
            errorMessage: Quantidade para troca não pode ser maior que a disponível para troca.
        }
        serverSideCondition {
            whenButtonPressed: @incluir
        }
    )

    process excluir (
        name: Excluir
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  delete itenspedidostrocados
                  where iditempedidotrocado = :P176_IDITEMPEDIDOTROCADO;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 1384150689488252748
        }
        serverSideCondition {
            type: request=Value
            value: DELETE
        }
    )

    process incluir (
        name: Incluir
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                  declare
                  --
                  vnumbernull                      varchar2(1) := null;
                  --
                  viditempedidotrocao              number;
                  viditempedidoorigem              number := :P176_IDITEMPEDIDO;
                  vquantidadetrocada               number := :P176_QUANTIDADE;
                  vidpedido                        number := :P176_IDPEDIDO;
                  vidproduto                       number;
                  vidprodutodetalhado              number;
                  vquantidade                      number := :P176_QUANTIDADEPEDIDO;
                  vidprotocoloatendimento          number;
                  --
                  vmd5                             varchar2(50);
                  --
                begin
                  --
                  select idproduto
                  into vidproduto
                  from itenspedidos
                  where iditempedido = :P176_IDITEMPEDIDO;
                  --
                  select idprodutodetalhado
                  into vidprodutodetalhado
                  from itenspedidos
                  where iditempedido = :P176_IDITEMPEDIDO;
                  --
                  select idprotocoloatendimento
                  into vidprotocoloatendimento
                  from protocolosatendimentos
                  where idpedido = :P176_IDPEDIDO
                  and idtipoprotocolo = 6
                  and situacao = 'P';
                  --
                  pck_protocolosatendimentos_fav.prc_itenspedidostrocados ( piditempedidotrocado       => viditempedidotrocao,
                                                                            piditempedidoorigem        => viditempedidoorigem,
                                                                            pquantidadetrocada         => vquantidadetrocada,
                                                                            pidpedidogerado            => vnumbernull,
                                                                            pidpedido                  => vidpedido,
                                                                            pidproduto                 => vidproduto,
                                                                            pidprodutodetalhado        => vidprodutodetalhado,
                                                                            pquantidade                => vquantidade,
                                                                            pidprodutodetalhadotrocado => vnumbernull,
                                                                            pidprotocoloatendimento    => vidprotocoloatendimento,
                                                                            pconfirmacaoestoque        => vnumbernull,
                                                                            pdataconfirmacaoestoque    => vnumbernull,
                                                                            pidusuarioestoque          => vnumbernull,
                                                                            pconfirmacaofiscal         => vnumbernull,
                                                                            pdataconfirmacaofiscal     => vnumbernull,
                                                                            pidusuariofiscal           => vnumbernull,
                                                                            ppossuidefeito             => vnumbernull,
                                                                            piddefeito                 => vnumbernull,
                                                                            pidkitvenda                => vnumbernull,
                                                                            pidbrinde                  => vnumbernull,
                                                                            pidcompreeganhe            => vnumbernull,
                                                                            pconfirmaentradavirtualage => vnumbernull,
                                                                            pquantidadenaorecebida     => vnumbernull,
                                                                            pquantidaderecebidatrocada => vnumbernull,
                                                                            pquantidadeavaria          => vnumbernull,
                                                                            pquantidadedefeito         => vnumbernull,
                                                                            pquantidadedevolvido       => vnumbernull,
                                                                            pmd5                       => vmd5,
                                                                            poperacao_dml              => 'I');       
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 1384151481073252749
        }
        serverSideCondition {
            type: request=Value
            value: INCLUIR
        }
    )

    process iniciar (
        name: Iniciar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_pedidos_fav.prc_iniciapedidotroca( pidpedidoorigem         => :P176_IDPEDIDO
                                                       , pidfilialfavorita       => :P0_IDFILIALFAVORITA
                                                       , pidusuario              => :P0_IDUSUARIO
                                                       , pnumeropa               => :P0_NUMEROPOSTOAVANCADO
                                                       , pidpedidotroca          => :P176_IDPEDIDOTROCA
                                                       , pidprotocoloatendimento => :P176_IDPROTOCOLOATENDIMENTO);
                  --
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 1384151041922252748
        }
        serverSideCondition {
            type: request=Value
            value: PROXIMO_PASSO
        }
    )

    process movimenta-quantidades-trocadas (
        name: Movimenta Quantidades Trocadas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                   viditemdevolucaopedido   number;
                   vquantidadedevolucao     number;
                   vquantidadedefeito       number;
                   vquantidadeavaria        number;
                   vquantidadenaorecebida   number;
                   --
                   vidfilialromancepedido   number;
                   vidusuariosolicitou      number;
                begin
                  --
                  -- Consulta a filial do pedido para movimentar para esta se for venda direta
                  select idfilialromance 
                  into vidfilialromancepedido
                  from pedidos 
                  where idpedido = :P176_IDPEDIDO;
                  --
                  select idusuariosolicitou
                  into vidusuariosolicitou
                  from protocolosatendimentos
                  where idpedido = :P176_IDPEDIDO
                  and idtipoprotocolo = 6
                  and situacao = 'P';
                  --
                  if vidfilialromancepedido not in ( 200, 100, 121, 120, 140, 1041, 1095, 123 ) then
                    --
                    for i in ( select *
                               from vw_itenstrocapedidos_fav if
                               where if.ididioma = 1
                               and if.idpedido = :P176_IDPEDIDO 
                               and if.idprotocoloatendimento = :P176_IDPROTOCOLOATENDIMENTO) 
                    loop
                      pck_protocolosatendimentos_fav.prc_confirmarecebimentotroca  ( piditempedidotroca         => i.iditempedidotrocado   
                                                                                   , pquantidadedevolvida       => i.quantidadetrocada     
                                                                                   , pquantidadedefeito         => i.quantidadedefeito    
                                                                                   , piddefeito                 => i.iddefeito
                                                                                   , pquantidadeavaria          => i.quantidadeavaria 
                                                                                   , pquantidadetrocada         => i.quantidaderecebidatrocada
                                                                                   , pidprodutodetalhadotrocado => i.idprodutodetalhadotrocado
                                                                                   , pquantidadenaorecebida     => i.quantidadenaorecebida 
                                                                                   , pidusuario                 => vidusuariosolicitou );
                    end loop;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 1384268692847195906
        }
        serverSideCondition {
            type: never
        }
    )

    branch (
        name: Ir para Pedidos
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 68
                items: {
                    P68_IDPEDIDO: &P176_IDPEDIDOTROCA.
                }
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'PROXIMO_PASSO'
        }
    )

)

