    region selecionar-produto (
        name: Selecionar Produto
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P176_IDITEMPEDIDO (
        type: plugin/select
        label {
            label: Produto
            alignment: left
        }
        settings {
            selectOnBlur: attributeValue
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDITEMPEDIDO||'-'|| nomeprodutodetalhado||' - Qtd:'||( v.quantidade- nvl( ( select sum(quantidadetrocada)
                                                                               from itenspedidostrocados i
                                                                               where i.iditempedidoorigem = v.iditempedido
                                                                                 and i.idpedidogerado is null ),0)) ||' - R$ '||
                   TRIM(to_char( quantidade * valorvenda,'999G999G999G990D00')) display_item
                     , iditempedido return_value
                from vw_itenspedidos_fav v
                where idpedido = :P176_IDPEDIDO
                  and ididioma = :P0_IDIDIOMA
                  and v.quantidade > nvl(( select sum(i.quantidadetrocada  )
                                           from itenspedidostrocados i
                                           where iditempedidoorigem = v.iditempedido 
                                             and i.idpedidogerado   is null ) ,0)
                order by 1
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 10
            region: @selecionar-produto
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        security {
            encryptSessionState: false
        }
    )

