page 176 (
    name: Itens para efetuar troca
    title: Itens para efetuar troca
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 65%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        enableDuplicatePageSubmissions: false
        reloadOnSubmit: always
    }

    region new (
        name: New
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region selecionados-para-troca (
        name: Selecionados para troca
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select '<a href="javascript:apex.submit({  request:''DELETE'',  set:{''P176_IDITEMPEDIDOTROCADO'':'||i.iditempedidotrocado||'},  showWait:true})"><img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt=""></a>' excluir
                     , i.iditempedidotrocado
                     , v.iditempedido
                     , v.nomeprodutodetalhado
                     , i.quantidadetrocada
                     , v.valorvenda
                     , i.quantidadetrocada * v.valorvenda valortotal
                     , v.estoquefavorita
                from favorita.vw_itenspedidos_fav v
                   , favorita.itenspedidostrocados i
                   , favorita.protocolosatendimentos p
                where i.iditempedidoorigem = v.iditempedido
                  and i.idprotocoloatendimento = p.idprotocoloatendimento
                  and i.idpedido = :P176_IDPEDIDO
                  and v.ididioma = :P0_IDIDIOMA
                  and p.situacao <> 'R' 
                  and v.iditempedido in  ( select it.iditempedidoorigem
                                           from favorita.itenspedidostrocados it
                                              , favorita.protocolosatendimentos p
                                           where it.idprotocoloatendimento = p.idprotocoloatendimento 
                                           and p.idpedido = i.idpedido 
                                           and p.situacao = 'P'
                                           and p.idtipoprotocolo = 6 );
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 2970006593127988860
        }

