page 300 (
    name: Relatorios de Estoques de Avarias
    title: Relatorios de Estoques de Avarias
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region estoques-de-avarias (
        name: Estoques de Avarias
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.idestoquedefeito
                     , e.idfilialfavorita
                     , e.filialfavorita
                     , e.idprodutodetalhado
                     , e.descricao defeito
                     , e.produtodetalhado
                     , e.quantidade
                     , e.quantidadereservada
                     , e.quantidade  - e.quantidadereservada quantidadedisponivel
                     , decode(e.origemdefeito,'E','Estoque','D','Distribuidor','T','Transportadora','F','Fornecedor') origem
                  from favorita.vw_estoquesdefeitos_fav e
                       -- Filial
                 where ( :P300_IDFILIALFAVORITA  is null or e.idfilialfavorita = :P300_IDFILIALFAVORITA )
                        -- Produto
                   and (:P300_IDPRODUTO          is null or exists ( select 1
                                                                      from produtosdetalhados p
                                                                     where p.idprodutodetalhado = e.idprodutodetalhado
                                                                       and p.idproduto          = :P300_IDPRODUTO ))
                
                
                       -- Defeito
                   and ( :P300_IDDEFEITO         is null or e.iddefeito = :P300_IDDEFEITO)
                       -- Produto Detalhado
                   and (:P300_IDPRODUTODETALHADO is null or idprodutodetalhado      = :P300_IDPRODUTODETALHADO)
                
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhum Estoque de Defeito encontrado, verifique os filtros!
        }
        advanced {
            savedReportMappingIdentifier: 3565695342519748432
        }

        column DEFEITO (
            type: plainText
            heading {
                heading: Defeito
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column FILIALFAVORITA (
            type: plainText
            heading {
                heading: Filial
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column IDESTOQUEDEFEITO (
            type: hidden
            heading {
                heading: Idestoquedefeito
            }
            layout {
                sequence: 10
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDFILIALFAVORITA (
            type: hidden
            heading {
                heading: Idfilialfavorita
            }
            layout {
                sequence: 20
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDPRODUTODETALHADO (
            type: hidden
            heading {
                heading: Idprodutodetalhado
            }
            layout {
                sequence: 40
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
            security {
                escapeSpecialChars: false
            }
        )

        column ORIGEM (
            type: plainText
            heading {
                heading: Origem do Defeito
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column PRODUTODETALHADO (
            type: plainText
            heading {
                heading: Produto Detalhado
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column QUANTIDADE (
            type: plainText
            heading {
                heading: Estoque
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            appearance {
                formatMask: 999G999G999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column QUANTIDADEDISPONIVEL (
            type: plainText
            heading {
                heading: Disponível
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: K
            }
        )

        column QUANTIDADERESERVADA (
            type: plainText
            heading {
                heading: Reservada
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: I
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 13994285 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DEFEITO (
                sequence: 3
            )

            displayColumn FILIALFAVORITA (
                sequence: 1
            )

            displayColumn ORIGEM (
                sequence: 4
            )

            displayColumn PRODUTODETALHADO (
                sequence: 2
            )

            displayColumn QUANTIDADE (
                sequence: 5
            )

            displayColumn QUANTIDADEDISPONIVEL (
                sequence: 6
            )

            displayColumn QUANTIDADERESERVADA (
                sequence: 7
            )

        )

    )

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P300_IDDEFEITO (
        type: popupLov
        label {
            label: <b>Defeito:</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.descricao as display_value
                     , d.iddefeito as return_value
                  from favorita.defeitos d
                 order by 1;
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 50
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P300_IDFILIALFAVORITA (
        type: popupLov
        label {
            label: <b>Filial Favorita:</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) display_value
                     , idfilialfavorita   return_value
                from filiaisfavorita f
                where  exists ( select 1
                               from usuariosfiliaisfavorita u
                               where u.idfilialfavorita = f.idfilialfavorita
                                 and u.consultar = 'S'
                                 and u.idusuario = :P0_IDUSUARIO )
                order by 1
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P300_IDPRODUTO (
        type: popupLov
        label {
            label: <b>Produto:</b>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-produtos
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P300_IDPRODUTODETALHADO (
        type: popupLov
        label {
            label: <b>Produto Detalhado:</b>
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-produtosdetalhados
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 60
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--stretch
                t-Button--gapTop
            ]
            icon: fa-filter
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button movimentar-estoque (
        buttonName: MOVIMENTAR_ESTOQUE
        label: Movimentar Produto
        layout {
            sequence: 70
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--stretch
                t-Button--gapTop
            ]
            icon: fa-exchange
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 251
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation valida-para-informar-filial-ou-produto-detalhado (
        name: VALIDA PARA INFORMAR FILIAL OU PRODUTO DETALHADO
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                  from dual
                 where :P300_IDFILIALFAVORITA is null 
                   and :P300_IDPRODUTODETALHADO is null;
                ```
        }
        error {
            errorMessage: Atenção! Para gerar o relatório sem lentidão, é obrigatório selecionar a Filial ou Produto Detalhado ou Ambos!
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

