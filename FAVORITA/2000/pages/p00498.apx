    region ultimos-pedidos-montados (
        name: Ultimos Pedidos Montados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select numeropedido
                     , idvendedora
                     , filialromance
                     , dataclassificado
                from ( select p.numeropedido
                            , p.idvendedora
                            , p.filialromance
                            , c.dataclassificado
                       from vw_pedidos_fav p
                          , classificacoespedidos c
                       where c.idpedido  = p.idpedido
                         and p.ididioma  = :P0_IDIDIOMA
                         and c.idusuario = :P0_IDUSUARIO
                         and c.idcaracteristicapedido = 18
                         and c.dataclassificado >= trunc(sysdate)
                       order by c.dataclassificado desc )
                where rownum <= 5;
                ```
        }
        layout {
            sequence: 60
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 18206591612796833
        }

        column DATACLASSIFICADO (
            type: plainText
            heading {
                heading: Data Montado
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column FILIALROMANCE (
            type: plainText
            heading {
                heading: Filial Romance
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
