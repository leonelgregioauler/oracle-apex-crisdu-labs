page 498 (
    name: Montagem de Pedido Tablet
    title: Montagem de Pedido Tablet
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 80%
        height: 80%
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            .centralizado{
            	text-align: center;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region dados-do-pedido (
        name: Dados do Pedido
        type: staticContent
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P498_ID_PEDIDO
        }
    )

    region itens (
        name: Itens
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.iditempedido,
                       i.idpedido,
                       pck_util_fav.fnc_nomeprodutodetalhado(i.idprodutodetalhado,1) as "Produto",
                       i.quantidade as "Quantidade"
                from itenspedidos i
                where i.idpedido = :P498_ID_PEDIDO
                order by i.iditempedido
                ```
        }
        layout {
            sequence: 50
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P498_ID_PEDIDO
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 18205901554796827
        }

        column IDITEMPEDIDO (
            type: plainText
            heading {
                heading: Iditempedido
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
