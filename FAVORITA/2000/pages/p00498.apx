    validation valida-se-pedido-ja-esta-montado (
        name: Valida se pedido ja esta montado
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from favorita.pedidos p
                where p.idsituacaoentrega >= 32000
                  and p.idpedido = :P498_ID_PEDIDO;
                ```
        }
        error {
            errorMessage: Pedido já esta na situação Montado!
        }
        serverSideCondition {
            type: request!=Value
            value: LIMPAR_DADOS
        }
    )

    process busca-pedido (
        name: Busca pedido
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Created on 02/04/2021 by MAXBE 
                declare 
                  --
                  vid_pedido number;
                  --
                begin
                  --
                  select pe.idpedido
                  into vid_pedido
                  from pedidos pe
                  where pe.idpedido = substr(:P498_ETIQUETA_PEDIDO_BUSCAR,7,7);
                  --
                  apex_util.set_session_state(p_name => 'P498_ID_PEDIDO',p_value => vid_pedido);
                  apex_util.set_session_state(p_name => 'P498_ETIQUETA_PEDIDO_BUSCAR',p_value => null);
                  --
                exception
                  when no_data_found then
                    apex_util.set_session_state(p_name => 'P498_ID_PEDIDO',p_value => null);
                    apex_util.set_session_state(p_name => 'P498_ETIQUETA_PEDIDO_BUSCAR',p_value => null);
                    --
                    raise;
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Erro ao buscar pedido!
        }
        advanced {
            executionMappingIdentifier: 105364309493434717
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P498_ETIQUETA_PEDIDO_BUSCAR is not null
        }
    )

    process finaliza-a-montagem (
        name: Finaliza a montagem
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Created on 02/04/2021 by MAXBE 
                declare 
                  --
                  vnumeropedido     varchar2(100) := :P498_ETIQUETA_PEDIDO_CONFIRMAR;
                  vidpedidoetiqueta number;
                  vid_usuario       number := :P0_IDUSUARIO;
                  vcodean           number := :P498_EMBALAGEM;
                  vqtdsacola        number := :P498_QUANTIDADE_EMBALAGEM;
                  --
                begin
                  --
                  select substr(vnumeropedido,2,length(vnumeropedido)-5)
                  into vidpedidoetiqueta
                  from dual;
                  --
                  pck_movimentarpedidos_fav.prc_montapedidos( pidpedidofolha    => vidpedidoetiqueta
                                                            , pcodean           => vcodean
                                                            , pidpedidoetiqueta => vidpedidoetiqueta
                                                            , pidusuario        => vid_usuario
                                                            , pquantidadesacola => vqtdsacola); 
                  --
                  apex_util.set_session_state(p_name => 'P498_ETIQUETA_PEDIDO_BUSCAR',p_value => null);
                  apex_util.set_session_state(p_name => 'P498_ETIQUETA_PEDIDO_CONFIRMAR',p_value => null);
                  apex_util.set_session_state(p_name => 'P498_ID_PEDIDO',p_value => null);
                  apex_util.set_session_state(p_name => 'P498_EMBALAGEM',p_value => null);
                  apex_util.set_session_state(p_name => 'P498_QUANTIDADE_EMBALAGEM',p_value => 1);
                  apex_util.set_session_state(p_name => 'P498_MONTADO',p_value => 'S');
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Ação processada!
        }
        advanced {
            executionMappingIdentifier: 105364550065434719
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P498_ETIQUETA_PEDIDO_CONFIRMAR
        }
    )

