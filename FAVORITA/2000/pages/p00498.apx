            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column NUMEROPEDIDO (
            type: plainText
            heading {
                heading: Numero de Pedido
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        savedReport 220924 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATACLASSIFICADO (
                sequence: 3
            )

            displayColumn FILIALROMANCE (
