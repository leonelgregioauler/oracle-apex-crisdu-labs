    dynamicAction busca-o-pedido-com-o-enter-no-campo-de-embalagem (
        name: Busca o pedido com o enter no campo de embalagem
        execution {
            sequence: 10
        }
        when {
            event: keypress
            selectionType: items
            items: P498_ETIQUETA_PEDIDO_BUSCAR
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: event.keyCode == 13
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: TESTE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

