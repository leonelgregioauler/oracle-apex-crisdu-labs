    region pedido (
        name: Pedido1
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpedido,
                       pck_util_fav.fnc_nomefilialfavorita(p.idfilialfavorita) as "Filial Fav",
                       pck_util_fav.fnc_nomerepresentante(p.idrepresentante) as "Representante",
                       pck_util_fav.fnc_nomevendedora(p.idvendedora) as "Vendedora",
                       se.descricaosistema as "Situação Entrega",
                       sf.descricaosistema as "Situação Fin",
                       p.dataemissao as "Dt Emissão",
                       p.valortotal as "Vlr Total",
                       p.valorapagar as "Vlr Pagar"
                from pedidos p,
                     situacoesentrega se,
                     situacoesfinanceiro sf
                where p.idsituacaoentrega = se.idsituacaoentrega
                and p.idsituacaofinanceiro = sf.idsituacaofinanceiro
                and p.idpedido = :P498_ID_PEDIDO
                ```
        }
        layout {
            sequence: 20
            parentRegion: @dados-do-pedido
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P498_ID_PEDIDO
        }
        componentAppearance {
            template: @/value-attribute-pairs-column
            templateOptions: [
                #DEFAULT#
                t-AVPList--leftAligned
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column "Dt Emissão" (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Dt emissão
                alignment: center
            }
            layout {
                sequence: 7
            }
            serverSideCondition {
                type: never
            }
        )

        column "Filial Fav" (
            reportColumnQueryId: 2
