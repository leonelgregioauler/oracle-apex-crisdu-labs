    pageItem P340_IDFILIALROMANCE (
        type: selectList
        label {
            label: Empresa Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome
                     , idfilial
                from roman.vw_filiais f
                where f.tipofilial = 'D'
                  and f.ativo = 'S'
                order by 1
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
