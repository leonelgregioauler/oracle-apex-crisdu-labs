                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P340_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(idrepresentante) display_value
                     , idrepresentante return_value
                from representantes r
                where r.idgerente = ( select idgerente 
                                      from gerentes g 
                                      where g.idfilial = :P340_IDFILIALROMANCE )
                order by 1
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P340_IDFILIALROMANCE
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P340_TIPOCOMISSAO (
        type: radioGroup
        label {
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Paga;P,Pendente;D
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P340_TIPORELATORIO (
        type: radioGroup
        label {
            label: Relatório
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Detalhado;D,Resumido;R
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction tipo-comissão-paga (
        name: Tipo Comissão Paga
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P340_TIPOCOMISSAO
        }
        clientSideCondition {
            type: item=value
            item: P340_TIPOCOMISSAO
            value: P
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P340_DATAINICIO
                    P340_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P340_DATAINICIO
                    P340_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    validation valida-comissao-paga (
        name: Valida Comissao Paga
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P340_DATAINICIO
        }
        error {
            errorMessage: Para buscar comissões pagas, é necessário informar a data de início e fim!
        }
        serverSideCondition {
            type: item=value
            item: P340_TIPOCOMISSAO
            value: P
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 340
                items: {
                    P340_TIPOCOMISSAO: &P340_TIPOCOMISSAO.
                    P340_IDFILIALROMANCE: &P340_IDFILIALROMANCE.
                    P340_TIPORELATORIO: &P340_TIPORELATORIO.
                    P340_DATAINICIO: &P340_DATAINICIO.
                    P340_DATAFIM: &P340_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

