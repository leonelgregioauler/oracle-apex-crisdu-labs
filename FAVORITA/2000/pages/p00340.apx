    region comissões-pendentes (
        name: Comissões Pendentes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(vp.idrepresentante) distribuidor
                     , count(1)+( select count(1)
                                  from vw_comissoes_pagar_old cp
                                  where cp.idrepresentante = vp.idrepresentante
                                    and not exists ( select 1 
                                                     from catal.pagamentocomissoes pcp
                                                     where pcp.idpedido  = cp.idpedido
                                                       and pcp.idrepresentante is not null )) qtdpedidos
                     , sum(vp.comissaodistribuidor)+nvl(( select sum(cp.comissao)
                                                          from vw_comissoes_pagar_old cp
                                                          where cp.idrepresentante = vp.idrepresentante
                                                            and not exists ( select 1 
                                                                             from catal.pagamentocomissoes pcp
                                                                             where pcp.idpedido  = cp.idpedido
                                                                               and pcp.idrepresentante is not null )),0) valorcomissao
                from vw_comissoes_pagar_fav vp
                where not exists ( select 1
                                   from pagamentocomissoes pg
                                   where pg.idpedido = vp.idpedido 
                                     and pg.idrepresentante = vp.idrepresentante
                                     and pg.idrepresentante is not null )
                  and vp.idfilialromance = :P340_IDFILIALROMANCE
                  and :P340_TIPORELATORIO = 'R'
                group by vp.idrepresentante
                union
                select roman.pck_romance.fnc_nomegerente(vpp.idgerente)||' <b> - ( Comissão Gerente ) - </b>'
                     , (count(1)+( select count(1)
                                    from vw_comissoes_pagar_old cp
                                    where cp.idgerente = vpp.idgerente
                                      and not exists ( select 1 
                                                       from catal.pagamentocomissoes pcp
                                                       where pcp.idpedido  = cp.idpedido
                                                         and pcp.idgerente is not null ))) qtdpedidos
                     , (sum(vpp.comissaogerente)+nvl(( select sum(cp.comissaogerente)
                                                      from vw_comissoes_pagar_old cp
                                                      where cp.idgerente = vpp.idgerente
                                                        and not exists ( select 1 
                                                                         from catal.pagamentocomissoes pcp
                                                                         where pcp.idpedido  = cp.idpedido
                                                                           and pcp.idgerente is not null )),0)) valorcomissao
                from vw_comissoes_pagar_fav vpp
                where not exists ( select 1
                                   from pagamentocomissoes pgg
                                   where pgg.idpedido = vpp.idpedido 
                                     and pgg.idgerente = vpp.idgerente
                                     and pgg.idgerente is not null )
                  and vpp.idfilialromance = :P340_IDFILIALROMANCE
                  and :P340_TIPORELATORIO = 'R'
                group by vpp.idgerente
                order by 1;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P340_TIPORELATORIO = 'R'
                  and :P340_TIPOCOMISSAO = 'D'
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1425252326070326335
        }

