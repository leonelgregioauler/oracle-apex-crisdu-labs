    region comissões-pagas-detalhadas (
        name: Comissões Pagas Detalhadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select vp.numeropedido
                     , vp.representante
                     , vp.vendedora
                     , vp.dataemissao
                     , vp.datavencimentomenor
                     , vp.databaixa
                     , vp.valorapagar
                     , pg.datapagamento
                     , pg.valorpago
                from vw_comissoes_pagar_fav vp
                   , pagamentocomissoes pg
                where pg.idpedido         = vp.idpedido
                  and pg.idrepresentante  is not null
                  and vp.idfilialromance  = :P340_IDFILIALROMANCE
                  and ( :P340_IDREPRESENTANTE is null or vp.idrepresentante = :P340_IDREPRESENTANTE )
                  and pg.valorpago        > 0
                  and :P340_TIPORELATORIO = 'D'
                  and :P340_TIPOCOMISSAO  = 'P'
                  and trunc(pg.datapagamento) between to_date(:P340_DATAINICIO) and to_date(:P340_DATAFIM)
                order by 3
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P340_TIPORELATORIO = 'D'
                  and :P340_TIPOCOMISSAO = 'P'
                ```
        }
        componentAppearance {
            showNullValuesAs: -
