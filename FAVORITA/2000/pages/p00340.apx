    region comissões-pendentes-detalhadas (
        name: Comissões Pendentes Detalhadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select vp.numeropedido
                     , vp.representante representante
                     , vp.vendedora vendedora
                     , vp.dataemissao
                     , vp.datavencimentomenor
                     , vp.databaixa
                     , vp.valorapagar
                     , vp.comissaodistribuidor
                from vw_comissoes_pagar_fav vp
                where not exists ( select 1
                                   from pagamentocomissoes pg
                                   where pg.idpedido = vp.idpedido 
                                     and pg.idrepresentante = vp.idrepresentante
                                     and pg.idrepresentante is not null )
                  and vp.comissaodistribuidor is not null
                  and vp.idfilialromance = :P340_IDFILIALROMANCE
                  and ( :P340_IDREPRESENTANTE is null or vp.idrepresentante = :P340_IDREPRESENTANTE )
                  and :P340_TIPORELATORIO = 'D'
