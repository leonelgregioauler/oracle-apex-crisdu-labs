        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region comissões-pagas (
        name: Comissões Pagas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(vp.idrepresentante) distribuidor
                     , trunc(pg.datapagamento) datapagamento
                     , sum(pg.valorpago) valorpago
                from vw_comissoes_pagar_fav vp
                   , pagamentocomissoes pg
                where pg.idpedido         = vp.idpedido
                  and pg.idrepresentante  is not null
                  and vp.idfilialromance  = :P340_IDFILIALROMANCE
                  and pg.valorpago        > 0
                  and :P340_TIPORELATORIO = 'R'
                  and :P340_TIPOCOMISSAO  = 'P'
                  and trunc(pg.datapagamento) between to_date(:P340_DATAINICIO) and to_date(:P340_DATAFIM)
                group by vp.idrepresentante , trunc(pg.datapagamento)
                union
                select roman.pck_romance.fnc_nomegerente(vpp.idgerente)||' <b> - ( Comissão Gerente ) - </b>'
                     , trunc(pgf.datapagamento)
                     , sum(pgf.valorpago)
                from vw_comissoes_pagar_fav vpp
                   , pagamentocomissoes pgf
                where pgf.idpedido        = vpp.idpedido
                  and pgf.idgerente       is not null
                  and vpp.idfilialromance = :P340_IDFILIALROMANCE
                  and pgf.valorpago       > 0
                  and :P340_TIPORELATORIO = 'R'
                  and :P340_TIPOCOMISSAO  = 'P'
                  and trunc(pgf.datapagamento) between to_date(:P340_DATAINICIO) and to_date(:P340_DATAFIM)
                group by vpp.idgerente , trunc(pgf.datapagamento)
                order by 1;
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P340_TIPORELATORIO = 'R'
                  and :P340_TIPOCOMISSAO = 'P'
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1427632861570662702
        }

