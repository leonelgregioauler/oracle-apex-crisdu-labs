page 179 (
    name: Protocolos de Atendimento
    title: Protocolos de Atendimento
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region protocolos-de-atendimento (
        name: Protocolos de Atendimento
        type: list
        source {
            list: @protocolos-de-atendimento
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            listTemplate: @/cards
            templateOptions: [
                t-Cards--featured force-fa-lg
                t-Cards--displayIcons
                t-Cards--5cols
                u-colors
                t-Cards--animColorFill
            ]
        }
    )

)

