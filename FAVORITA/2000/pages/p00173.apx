    pageItem P173_IDFORNECEDOR (
        type: selectOne
        label {
            label: Fornecedor
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nomepessoa display_value
                     , f.idfornecedor return_value
                from pessoas p
                   , fornecedores f
                where p.idpessoa = f.idpessoa
                  and f.ativo    = 'S'
                  and exists ( select 1 
                               from fornecedoresprodutos fp
                               where fp.idfornecedor = f.idfornecedor  )
                order by 1 
                ```
        }
        layout {
            sequence: 140
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
