    pageItem P173_IDFILIALFAVORITA2 (
        type: plugin/select
        label {
            label: Filial Favorita
            alignment: left
        }
        settings {
            selectListType: multiValueSelectList
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) display_value
                     , idfilialfavorita   return_value
                  from favorita.filiaisfavorita f
                 where exists ( select 1
                                       from usuariosfiliaisfavorita u
                                      where u.idfilialfavorita = f.idfilialfavorita
                                        and u.consultar = 'S'
                                        and u.idusuario = :P0_IDUSUARIO )
                union
                -- para p time de T.I
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) display_value
                     , idfilialfavorita   return_value
                  from favorita.filiaisfavorita f
                 where exists ( select 1
                                  from roman.usuariosgruposatendimento u
                                 where u.usuario = v('APP_USER')
                                   and u.idgrupoatendimento = 0)
                 order by 1
                ```
        }
        layout {
            sequence: 60
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
    )

