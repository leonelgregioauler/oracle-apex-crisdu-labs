page 173 (
    name: Relatório de Estoques
    title: Relatório de Estoques
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function buscar_virtual(vitem)
            {
              apex.item('P173_IDESTOQUEAJUSTAR').setValue(vitem);
              var answer = confirm("Confirma que quer INTEGRAR o estoque do item com o valor que esta no Virtual Age?")
              if (answer)
              {
                apex.submit('BUSCAVIRTUAL');
              }
                
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util_fav.fnc_verificaacesso(34251,:P0_IDUSUARIO) = 'S'
                ```
        }
    )

    region estoques (
        name: Estoques
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select x.*
                     , x.QUANTIDADERESERVADA QUANTIDADERESERVADA_LINK 
                     , p.dataliberadovenda
                  from favorita.VWFA_APP2000_P173_REL001 x
                     , favorita.produtos p
                 where x.idproduto = p.idproduto(+)
                   and :P173_FILTRAR = 'S'
                   and (:P173_IDFILIALFAVORITA2 is null or 
                        /*x.filialfavorita in (
                            select pck_util_fav.fnc_nomefilialfavorita(to_number(j.column_value))
                              from json_table(:P173_IDFILIALFAVORITA2, '$[*]' 
                                     columns (column_value varchar2(100) path '$')) j
                        ))*/
                        x.idfilialfavorita in (select regexp_substr(:P173_IDFILIALFAVORITA2, '[^:]+', 1, level) 
                                         from dual connect by level <= regexp_count(:P173_IDFILIALFAVORITA2, ':') + 1)
                )
                        
                --old 
                /*select x.*
                     , x.QUANTIDADERESERVADA QUANTIDADERESERVADA_LINK 
                     , p.dataliberadovenda
                  from favorita.VWFA_APP2000_P173_REL001 x
                     , favorita.produtos p
                 where x.idproduto = p.idproduto(+)
                   and :P173_FILTRAR = 'S'
                   and (:P173_IDFILIALFAVORITA2   is not null or 
                        :P173_IDPRODUTODETALHADO is not null or 
                        :P173_IDFORNECEDOR  is not null or 
                        :P173_FILIAIS = 'S')
                    /*and (:P173_IDEDICAOREVISTA is null or exists (select 1
                                                                    from favorita.produtosdetedrevistas t
                                                                   where t.idedicaorevista = :P173_IDEDICAOREVISTA
                                                                     and t.idprodutodetalhado = x.idprodutodetalhado))*/
                 
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Utilize os Filtros!
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 1411805203753104249
        }

