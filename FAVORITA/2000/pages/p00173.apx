    process busca-virtual (
        name: BUSCA_VIRTUAL
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  --raise_application_error(-202,'teste');
                  --
                  --favorita.pck_estoque_fav.prc_igualestoquevirtual( pidestoque => :P173_IDESTOQUEAJUSTAR
                  --                                                , pidusuario => :P0_IDUSUARIO);
                  --
                  NULL;
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        successMessage {
            successMessage: Integrado com sucesso
        }
        error {
            errorMessage: Erro ao integrar
        }
        advanced {
            executionMappingIdentifier: 30796168822604015
        }
        serverSideCondition {
            type: request=Value
            value: BUSCAVIRTUAL
        }
    )

