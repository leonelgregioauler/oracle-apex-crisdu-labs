        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 387
                items: {
                    P387_DATAFINAL:
                    P387_DATAINICIAL:
                    P387_IDEDICAOREVISTA:
                    P387_IDPAIS:
                    P387_IDPEDAGIOREVISTA:
                    P387_NOMEPEDAGIOREVISTA:
                    P387_PERIMPOSTOS:
                    P387_PERINADIMPLENCIA:
                    P387_PEROPERACAO:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

