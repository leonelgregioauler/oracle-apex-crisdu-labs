page 386 (
    name: "Pedagios Revistas "
    title: "Pedagios Revistas "
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region pedagios-revistas (
        name: Pedagios Revistas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpedagiorevista
                     , p.nomepedagiorevista
                     , ( select pa.nome 
                         from catal.paises pa
                         where pa.idpais = p.idpais) pais
                     , p.datainicial
                     , p.datafinal
                     , (select e.numeroedicao ||' - '||e.nome showvalue
                        from favorita.edicoesrevistas e
                        where e.idedicaorevista = p.idedicaorevista) edicaorevista
                     , favorita.pck_util_fav.fnc_nomeusuario(p.idusaurio) usuario
                     , p.datacriado
                     , p.perinadimplencia * 100
                     , p.perimpostos * 100
                     , p.peroperacao * 100
                     , decode((select count(1) from itenspedagiosrevistas2 where idpedagiorevista = p.idpedagiorevista),0,'N','S') relatorionovo
                     , f.nome filial
                     --
                    /* , case p.idpais
                         when 2 then sum(i.qtdvendafil2) 
                         else 0 
                       end vendaUY
                     , case p.idpais
                         when 4 then sum(i.qtdvendafil4) 
                         else 0 
                       end vendaPY
                     --
                     , case p.idpais
                         when 2 then sum(i.qtdestoquefil2) 
                         else 0 
                       end estoqueUY
                     , case p.idpais
                         when 4 then sum(i.qtdestoquefil4) 
                         else 0 
                       end estoquePY*/
                     --
                  from favorita.pedagiosrevistas p, 
                       roman.vw_filiais f,
                       itenspedagiosrevistas2  i
                 where p.idfilialromancepreco = f.idfilial(+)
                   and i.idpedagiorevista = p.idpedagiorevista
                 group by p.idpedagiorevista
                     , p.nomepedagiorevista
                     , p.idpais
                     , p.datainicial
                     , p.datafinal
                     , p.idedicaorevista
                     , p.idusaurio
                     , p.datacriado
                     , p.perinadimplencia
                     , p.perimpostos
                     , p.peroperacao
                     , f.nome
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1536974943700109436
        }

        column DATACRIADO (
            type: plainText
            heading {
                heading: Criado em
                alignment: center
            }
            layout {
                sequence: 180
                columnAlignment: center
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: H
            }
        )

        column DATAFINAL (
            type: plainText
            heading {
