    region itens (
        name: Itens
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c001 ordem --rownum  ordem
                     , c005 idprodutodetalhado
                     , c002 idedicaorevista
                     , c004 idproduto
                     , c006 nome_ce
                     , c007 codigo_cd
                     , to_number(c008) qtdprojetada
                     , to_number(c009) qtdcomprar
                     , pck_integracao_virtualagev2.fnc_converte_char_to_number(c010)  valorcusto
                     , to_number(c012) qtdTransferir
                     , to_number(c013) necessidade
                    -- , c011 idordemcompra
                     , to_number(c019) cd_origem
                     , to_number(c015) Venda_considerada
                  from apex_collections
                 where collection_name = 'COL_ORDENSCOMPRASREP'
                   and to_number(c011) = :P579_IDORDEMCOMPRA
                   and to_number(c013) > 0;
                
                ```
            pageItemsToSubmit: P579_IDORDEMCOMPRA
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        performance {
            lazyLoading: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        enableUsersTo {
            savePublicReport: true
        }
        download {
            formats: csv
            filename: ItensPre_OC
        }
        advanced {
            savedReportMappingIdentifier: 603435640865248440
        }

