    process incluiritenstmp (
        name: IncluirItensTMP
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  viditemordemcompra  number;
                  vidprodutodetalhado number;
                  vmd5                varchar2(4000);
                  vinclui             varchar2(1);
                  vdata               ordenscompras.dataemissao%type;
                  vtipo               ordenscompras.tipooc%type;
                  vidfornec           ordenscompras.idfornecedor%type;
                  vidusuarioemis      ordenscompras.idusuarioemissao%type;
                  videdicaorevista    ordenscompras.idedicaorevista%type;
                  vNumNull            number;
                begin
                  
                  -- Limpa a tabela temporaria
                  begin
                    delete from tmp_ordenscomprasprop where idordemcompra = :P579_IDORDEMCOMPRA;
                  exception
                    when others then null;
                  end;
                  
                  -- Grava dados da OC na tabela temporaria
                  begin
                    insert into tmp_ordenscomprasprop (idtmpordenscomprasprop, 
                                                       idordemcompra, 
                                                       idfilialdestino, 
                                                       idedicaorevista, 
                                                       idproduto, 
                                                       idprodutodetalhado, 
                                                       qtdcomprar, 
                                                       qtdtransferir, 
                                                       valorcusto, 
                                                       tipooc, 
                                                       qtdsugerida,
                                                       idfilialorigem,
                                                       qtdciclossugerida,
                                                       qtdcicloscomprar,
                                                       qtdciclostransferir,
                                                       vendaconsiderada)
                         select seq_idtmpordenscomprasprop.nextval
                              , :P579_IDORDEMCOMPRA
                              , to_number(c007) --codigo_cd
                              , to_number(c002) --idedicaorevista
                              , to_number(c004) --idproduto
                              , to_number(c005) --idprodutodetalhado
                              , round (to_number(c009) * to_number(c015) )  --qtdcomprar * venda_considerada (esta multiplicando pelo fato da qtdcomprar estar em qtdciclos)
                              , round (to_number(c012) * to_number(c015) )  --qtdtransferir * venda_considerada (esta multiplicando pelo fato da qtdcomprar estar em qtdciclos)
                              , to_number(c010) --valorcusto
                              , 'R'
                              , round (to_number(c009) * to_number(c015) )  --qtdcomprar * venda_considerada (esta multiplicando pelo fato da qtdcomprar estar em qtdciclos)
                              , to_number(c019) -- CD origem da transf.
                              , to_number(c008) -- qtdsugerida(em ciclos)
                              , to_number(c009) -- qtdcomprar (em ciclos)
                              , to_number(c012) -- qtdtransferir (em ciclos)
                              , to_number(c015)
                         from apex_collections
                        where collection_name = 'COL_ORDENSCOMPRASREP'
                          and to_number(c011) = :P579_IDORDEMCOMPRA 
                          and ( ( to_number(c009) * to_number(c015) ) >= 1 or
                                ( to_number(c012) * to_number(c015) ) >= 1 )
                          and to_number(c013) > 0; 
                  
                  exception
                    when others then raise;
                  end;
                  
                  -- Ajusta a situação da OC
                  update ordenscompras
                     set idsituacaooc = 2
                   where idordemcompra = :P579_IDORDEMCOMPRA;
                  
                  -- Efetiva a transação no banco de dados
                  commit;
                  
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 501462756819580248
        }
        serverSideCondition {
            whenButtonPressed: @gerarordemcompra
        }
    )

    process new-save-interactive-grid-data (
        name: New - Save Interactive Grid Data
        type: executeCode
        editableRegion: @itens
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                  collection_name varchar2(255);
                
                BEGIN
                  collection_name := 'COL_ORDENSCOMPRASREP';
                
                  case v('APEX$ROW_STATUS')
                  when 'U' then
                    APEX_COLLECTION.UPDATE_MEMBER_ATTRIBUTE (
                        p_collection_name => collection_name,
                        p_seq             => :ORDEM,
                        p_attr_number     => 9,
                        p_attr_value      => :QTDCOMPRAR);
                    --
                    APEX_COLLECTION.UPDATE_MEMBER_ATTRIBUTE (
                        p_collection_name => collection_name,
                        p_seq             => :ORDEM,
                        p_attr_number     => 12,
                        p_attr_value      => :QTDTRANSFERIR);
                        
                  when 'D' then
                    APEX_COLLECTION.DELETE_MEMBER (
                        p_collection_name => collection_name,
                        p_seq             => :ORDEM);
                  end case;
                  --commit;
                END;
                
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Alterações Salvas!
        }
        advanced {
            executionMappingIdentifier: 501462304785580240
        }
    )

    process populagrade (
        name: PopulaGrade
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    vqtdTransferir            number;
                    vqtdComprar               number;
                    videdicaorevista          number := :P579_IDEDICAOREVISTA;
                    vnomecd                   varchar2(50);
                    vciclos                   number := TO_NUMBER(TRANSLATE(:P579_QTDCICLOS,'.',','));
                    vcdTransferir             number;
                    v_qtd_estoque             number;
                    v_qtd_estoque_exc_vizinho number;
                    v_necessidade_em_ciclos   number;
                begin  
                  
                  -- Inicializa a Collection
                  if not apex_collection.collection_exists('COL_ORDENSCOMPRASREP') then 
                    apex_collection.create_collection('COL_ORDENSCOMPRASREP');
                  else
                    apex_collection.truncate_collection('COL_ORDENSCOMPRASREP');
                  end if; 
                  
                  -- Loop para gravar os dados na Collection
                  for c1 in (
                            select rownum ordem
                                 , c.idprodutodetalhado
                                 , c.venda_considerada
                                 , c.qtd_disponivel
                                 , c.idfornecedor
                                 , c.idfilialfavorita
                                 , p.idproduto
                                 --, (vciclos - c.cobertura_ciclo_atual) necessidade
                                 , (select max(valorcusto)
                                      from precosprodutos 
                                     where idedicaorevista = videdicaorevista
                                       and idprodutodetalhado = c.idprodutodetalhado ) valorcusto
                                 /*, case 
                                      when (vciclos - c.cobertura_ciclo_atual) > 0 
                                      then (vciclos - c.cobertura_ciclo_atual) 
                                      else 0
                                   end NecessidadeAtual*/
                                 , case 
                                      when (c.cobertura_ciclo_t2 - vciclos) > 0 
                                      then (c.cobertura_ciclo_t2 - vciclos)
                                      else 0
                                   end sobra_t2
                                 , case 
                                      when (c.cobertura_ciclo_t3 - vciclos) > 0 
                                      then (c.cobertura_ciclo_t3 - vciclos)
                                      else 0
                                   end sobra_t3
                                 , case 
                                      when (c.cobertura_ciclo_t4 - vciclos) > 0 
                                      then (c.cobertura_ciclo_t4 - vciclos)
                                      else 0
                                   end sobra_t4
                                 , c.cobertura_ciclo_t2
                                 , c.cobertura_ciclo_t3
                                 , c.cobertura_ciclo_t4
                                 , c.idfilial_t2
                                 , c.idfilial_t3
                                 , c.idfilial_t4
                                 , (c.venda_considerada * vciclos) - c.comprado as necessidade
                              from tmp_rel_analise_compras_novo c
                                 , produtosdetalhados      p
                             where c.idprodutodetalhado = p.idprodutodetalhado
                               and usuario = :APP_USER
                               and (:P579_IDFORNECEDOR IS NULL OR c.idfornecedor = :P579_IDFORNECEDOR)
                               and (:P579_IDKITVENDA IS NULL OR c.idprodutodetalhado in (select idprodutodetalhado
                                                                                           from itenskitsvendas
                                                                                          where idkitvenda = :P579_IDKITVENDA) )
                               and c.ciclos_morte is null
                               and c.venda_considerada > 0  
                               and c.idfilialfavorita = :P579_IDFILIALFAVORITA)
                  loop
                  
                    vqtdComprar               := 0;
                    vqtdTransferir            := 0;
                    vcdTransferir             := 0;
                    v_qtd_estoque             := 0;
                    v_qtd_estoque_exc_vizinho := 0;
                    v_necessidade_em_ciclos   := 0;
                
                    -- Busca qtd em estoque
                    begin
                        select favorita.pck_estoque_fav.fnc_estoquedisponivel(e.idestoque)
                          into v_qtd_estoque
                          from favorita.estoques e
                         where e.idprodutodetalhado = c1.idprodutodetalhado
                           and e.idfilialfavorita   = c1.idfilialfavorita;
                    exception
                        when others then
                            v_qtd_estoque := 0;
                    end;
                    
                    -- Busca qtd excedente no estoque vizinho
                    if  c1.idfilialfavorita = 2 then -- (Estoque Igrejinha) vizinho é Estoque Campo Grande
                        vcdTransferir := 3;
                        begin
                            select (favorita.pck_estoque_fav.fnc_estoquedisponivel(e.idestoque) - c1.necessidade)
                              into v_qtd_estoque_exc_vizinho
                              from favorita.estoques e
                             where e.idprodutodetalhado = c1.idprodutodetalhado
                               and e.idfilialfavorita   = 3;
                        exception
                            when others then
                                v_qtd_estoque_exc_vizinho := 0;
                        end;
                        
                    elsif c1.idfilialfavorita = 3 then -- (Estoque Campo Grande) vizinho é Estoque Igrejinha
                        vcdTransferir := 2;
                        begin
                            select (favorita.pck_estoque_fav.fnc_estoquedisponivel(e.idestoque) - c1.necessidade)
                              into v_qtd_estoque_exc_vizinho
                              from favorita.estoques e
                             where e.idprodutodetalhado = c1.idprodutodetalhado
                               and e.idfilialfavorita   = 2;
                        exception
                            when others then
                                v_qtd_estoque_exc_vizinho := 0;
                        end;
                        
                    elsif c1.idfilialfavorita = 4 then -- (Estoque Manaus) vizinho é Estoque Belém
                        vcdTransferir := 6;
                        begin
                            select (favorita.pck_estoque_fav.fnc_estoquedisponivel(e.idestoque) - c1.necessidade)
                              into v_qtd_estoque_exc_vizinho
                              from favorita.estoques e
                             where e.idprodutodetalhado = c1.idprodutodetalhado
                               and e.idfilialfavorita   = 6;
                        exception
                            when others then
                                v_qtd_estoque_exc_vizinho := 0;
                        end;
                        
                    elsif c1.idfilialfavorita = 6 then -- (Estoque Belém) vizinho é Estoque Manaus
                        vcdTransferir := 4;
                        begin
                            select (favorita.pck_estoque_fav.fnc_estoquedisponivel(e.idestoque) - c1.necessidade)
                              into v_qtd_estoque_exc_vizinho
                              from favorita.estoques e
                             where e.idprodutodetalhado = c1.idprodutodetalhado
                               and e.idfilialfavorita   = 4;
                        exception
                            when others then
                                v_qtd_estoque_exc_vizinho := 0;
                        end;
                        
                    end if;
                    
                    -- Calcula a necessidade em ciclos
                    v_necessidade_em_ciclos := (c1.necessidade - v_qtd_estoque) / c1.venda_considerada;
                    
                    -- Se ficar negativo é por que não tem estoque sobrando
                    if v_qtd_estoque_exc_vizinho < 0 then
                        v_qtd_estoque_exc_vizinho := 0;
                    end if;
                
                    -- calcular a quantidade transferir em ciclos
                    if v_qtd_estoque_exc_vizinho > 0 then
                        -- Se o estoque excedente do estoque vizinho for maior que a necessidade, pega somente o valor exato da necessidade
                        if  v_qtd_estoque_exc_vizinho > (c1.necessidade - v_qtd_estoque) then
                            v_qtd_estoque_exc_vizinho := (c1.necessidade - v_qtd_estoque);
                        end if;
                        vqtdTransferir := v_qtd_estoque_exc_vizinho / c1.venda_considerada;
                    end if;
                
                    -- Verifica se a necessidade é maior que a quantidade excedente no estoque vizinho
                    if (c1.necessidade - v_qtd_estoque) > v_qtd_estoque_exc_vizinho  then
                        -- Calcula a quantidade comprar em ciclos
                        vqtdComprar := (c1.necessidade - (v_qtd_estoque_exc_vizinho + v_qtd_estoque)) / c1.venda_considerada;
                    else
                        -- se a quantidade excedente no estoque vizenho for maior ou igual a necessidade, então não precisa comprar
                        vqtdComprar := 0;
                    end if;
                
                
                
                    -- Tratamento para caso não encontre o nome do CD
                    begin
                      select nomefilialfavorita 
                        into vnomecd
                        from favorita.filiaisfavorita
                       where idfilialfavorita = c1.idfilialfavorita;
                    exception
                      when others then vnomecd := 'CD NÃO LOCALIZADO!';
                    end;
                
                
                      apex_collection.add_member(
                                  p_collection_name => 'COL_ORDENSCOMPRASREP',
                                  p_c001 => c1.ordem,
                                  p_c002 => videdicaorevista,
                                  p_c004 => c1.idproduto,
                                  p_c005 => c1.idprodutodetalhado,
                                  p_c006 => vnomecd,
                                  p_c007 => c1.idfilialfavorita,
                                  p_c008 => (vqtdComprar),
                                  p_c009 => round(vqtdComprar,2),
                                  p_c010 => c1.valorcusto,
                                  p_c011 => :P579_IDORDEMCOMPRA,
                                  p_c012 => round(vqtdTransferir,2),
                                  p_c013 => round(v_necessidade_em_ciclos,2), -- Necessidade em ciclos
                                  p_c014 => c1.qtd_disponivel,
                                  p_c015 => c1.venda_considerada,
                                  p_c016 => c1.idfilial_t2,
                                  P_C017 => c1.idfilial_t3,
                                  P_C018 => c1.idfilial_t4,
                                  P_C019 => vcdTransferir     );
                    --
                    -- 
                    --if v('APP_USER') = 'MAICONAIMI' then --log
                    --    insert into favorita.teste
                    --    values ('MAICON',:P579_IDORDEMCOMPRA,round(vqtdTransferir,2),round(v_necessidade_em_ciclos,2),c1.venda_considerada,round(vqtdComprar,2));
                    --end if;
                  end loop; 
                  
                  -- Efetiva a transação no banco de dados
                  commit;
                  
                end;
                
                
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 99999981728077827
        }
    )

    branch (
        name: Volta para 576
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 576
                items: {
                    P576_IDORDEMCOMPRA: &P579_IDORDEMCOMPRA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @gerarordemcompra
        }
    )

