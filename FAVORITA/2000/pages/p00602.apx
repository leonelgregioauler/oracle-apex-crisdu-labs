page 602 (
    name: Relatório de Taxas Delivery
    title: Relatório de Taxas Delivery
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region taxas (
        name: Taxas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idtaxadelivery
                     , favorita.pck_util_fav.fnc_nomefilialfavorita(t.idfilialfavorita) nomefilial
                     , t.datainicio
                     , t.datafim
                     , t.valorpedidominimo
                     , t.valortaxa
                  from favorita.taxasdelivery t
                order by 1 desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 890683323801598002
        }

        column DATAFIM (
            type: plainText
            heading {
                heading: Data Fim
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: F
            }
        )

        column DATAINICIO (
            type: plainText
            heading {
                heading: Data Inicio
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: E
            }
        )

        column IDTAXADELIVERY (
            type: link
            heading {
                heading: Editar Taxa
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 603
                    items: {
                        P603_IDTAXADELIVERY: #IDTAXADELIVERY#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column NOMEFILIAL (
            type: plainText
            heading {
                heading: Filial Favorita
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column VALORPEDIDOMINIMO (
            type: plainText
            heading {
                heading: Valor Minimo do Pedido
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            appearance {
                formatMask: FML999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        column VALORTAXA (
            type: plainText
            heading {
                heading: Valor da Taxa
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            appearance {
                formatMask: FML999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 8906909 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAFIM (
                sequence: 4
            )

            displayColumn DATAINICIO (
                sequence: 3
            )

            displayColumn IDTAXADELIVERY (
                sequence: 1
            )

            displayColumn NOMEFILIAL (
                sequence: 2
            )

            displayColumn VALORPEDIDOMINIMO (
                sequence: 5
            )

            displayColumn VALORTAXA (
                sequence: 6
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Nova Taxa Delivery
        layout {
            sequence: 10
            region: @taxas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 603
                clearCache: 603
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

