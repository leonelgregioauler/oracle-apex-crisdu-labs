page 14 (
    name: Cadastro de Grades
    title: Grades
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region grades (
        name: Grades
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P14_IDGRADE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @grades
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P14_IDTEXTO (
        type: hidden
        layout {
            sequence: 50
            region: @grades
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P14_IDTIPOGRADE (
        type: selectList
        label {
            label: Tipo da Grade
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-tiposgrades
            displayExtraValues: false
            nullDisplayValue: " - Selecione o Tipo Grade - "
        }
        layout {
            sequence: 40
            region: @grades
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P14_MD5 (
        type: hidden
        layout {
            sequence: 60
            region: @grades
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P14_OPERACAO_DML (
        type: hidden
        layout {
            sequence: 70
            region: @grades
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P14_ORDEM (
        type: numberField
        label {
            label: Ordem
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 30
            region: @grades
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P14_SIGLA (
        type: textField
        label {
            label: Sigla
            alignment: left
        }
        layout {
            sequence: 20
            region: @grades
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 50
            region: @grades
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P14_IDGRADE
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 40
            region: @grades
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P14_IDGRADE
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 30
            region: @grades
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 13
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 20
            region: @grades
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P14_IDGRADE
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @grades
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P14_IDGRADE
        }
    )

    validation sigla-obrigatório (
        name: SIGLA obrigatório
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P14_SIGLA
        }
        error {
            errorMessage: Sigla deve ter um valor.
            associatedItem: @P14_SIGLA
        }
    )

    process consulta-corredores-estoques (
        name: Consulta Corredores Estoques
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                #OWNER#.PCK_CADASTROS_FAV.PRC_GRADES(
                  PIDGRADE => :P14_IDGRADE,
                  PSIGLA => :P14_SIGLA,
                  PORDEM => :P14_ORDEM,
                  PIDTIPOGRADE => :P14_IDTIPOGRADE,
                  PMD5 => :P14_MD5,
                  POPERACAO_DML => 'S');
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 3369882141548506
        }
    )

    process limpar-campos-ao-sair (
        name: Limpar Campos ao Sair
        type: clearSessionState
        execution {
            sequence: 10
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 3370723706548515
        }
    )

    process limpar-campos-para-adicionar (
        name: Limpar Campos para Adicionar
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 3370857013548516
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    process operação-dml-em-corredores-estoques (
        name: Operação DML em Corredores Estoques
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  #OWNER#.PCK_CADASTROS_FAV.PRC_GRADES(
                    PIDGRADE => :P14_IDGRADE,
                    PSIGLA => :P14_SIGLA,
                    PORDEM => :P14_ORDEM,
                    PIDTIPOGRADE => :P14_IDTIPOGRADE,
                    PMD5 => :P14_MD5,
                    POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 3380924538702932
        }
    )

    branch (
        name: Go To Page 14
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 14
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

)

