page 497 (
    name: Erros de Montagem
    title: Erros de Montagem
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region lista-de-históricos (
        name: Lista de Históricos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ii.idpedido
                     , favorita.pck_util_fav.fnc_nomeprodutodetalhado(ii.idprodutodetalhado,1)   NomeProduto  
                     , i.descricao
                     , i.dataerro
                     , i.dataajuste
                from favorita.itensseparacao i
                   , favorita.tiposerrosseparacao t
                   , favorita.itenspedidos ii
                where i.idtipoerro = t.idtipoerro
                  and i.iditempedido = ii.iditempedido
                  and ii.idpedido = :P497_ID_PEDIDO
                union
                select ii.idpedido
                     , favorita.pck_util_fav.fnc_nomeprodutodetalhado(ii.idprodutodetalhado,1)   NomeProduto  
                     , i.descricao
                     , i.dataerro
                     , i.dataajuste
                from favorita.itensseparacao i
                   , favorita.tiposerrosseparacao t
                   , favorita.itensindisponiveispedidos ii
                where i.idtipoerro = t.idtipoerro
                  and i.iditempedidoajustado = ii.iditempedido
                  and ii.idpedido = :P497_ID_PEDIDO
                union
                select ii.idcompratransferencia
                     , favorita.pck_util_fav.fnc_nomeprodutodetalhado(ii.idprodutodetalhado,1)   NomeProduto  
                     , i.descricao
                     , i.dataerro
                     , i.dataajuste
                from favorita.itensseparacao i
                   , favorita.tiposerrosseparacao t
                   , favorita.itenscomprastransferencias ii
                where i.idtipoerro = t.idtipoerro
                  and i.iditemcompratransferencia = ii.iditemcompratransferencia
                  and ii.idcompratransferencia = :P497_IDCOMPRATRANSFERENCIA;
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: setPaginationSelectList
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }
        componentAdvanced {
            stripHtml: true
        }

        column DATAAJUSTE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Data Ajuste
                alignment: center
            }
            layout {
                sequence: 5
            }
        )

        column DATAERRO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Data Erro
                alignment: center
            }
            layout {
                sequence: 4
            }
        )

        column DESCRICAO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 3
            }
        )

        column IDPEDIDO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Pedido
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column NOMEPRODUTO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 2
            }
        )

    )

    region lista-de-históricos-ajustados (
        name: Lista de Históricos Ajustados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ii.idpedido
                     , favorita.pck_util_fav.fnc_nomeprodutodetalhado(ii.idprodutodetalhado,1)   NomeProduto  
                     , i.descricao
                     , i.mensagem
                     , i.dataerro
                     , i.dataajuste
                from favorita.itensseparacao i
                   , favorita.tiposerrosseparacao t
                   , favorita.itenspedidos ii
                where i.idtipoerro = t.idtipoerro
                  and i.iditempedidoajustado = ii.iditempedido
                  and i.dataajuste is not null
                  and ii.idpedido = :P497_ID_PEDIDO
                union
                select ii.idpedido
                     , favorita.pck_util_fav.fnc_nomeprodutodetalhado(ii.idprodutodetalhado,1)   NomeProduto  
                     , i.descricao
                     , i.mensagem
                     , i.dataerro
                     , i.dataajuste
                from favorita.itensseparacao i
                   , favorita.tiposerrosseparacao t
                   , favorita.itensindisponiveispedidos ii
                where i.idtipoerro = t.idtipoerro
                  and i.iditempedidoajustado = ii.iditempedido
                  and i.dataajuste is not null
                  and ii.idpedido = :P497_ID_PEDIDO
                union
                select ii.idcompratransferencia
                     , favorita.pck_util_fav.fnc_nomeprodutodetalhado(ii.idprodutodetalhado,1)   NomeProduto  
                     , i.descricao
                     , i.mensagem
                     , i.dataerro
                     , i.dataajuste
                from favorita.itensseparacao i
                   , favorita.tiposerrosseparacao t
                   , favorita.itenscomprastransferencias ii
                where i.idtipoerro = t.idtipoerro
                  and i.iditemcompratransfajustado = ii.iditemcompratransferencia
                  and i.dataajuste is not null
                  and ii.idcompratransferencia = :P497_IDCOMPRATRANSFERENCIA;
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: setPaginationSelectList
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No data found.
        }
        componentAdvanced {
            stripHtml: true
        }

        column DATAAJUSTE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Data Ajuste
                alignment: center
            }
            layout {
                sequence: 5
            }
        )

        column DATAERRO (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Data Erro
                alignment: center
            }
            layout {
                sequence: 4
            }
        )

        column DESCRICAO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 3
            }
        )

        column IDPEDIDO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Pedido
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column MENSAGEM (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Mensagem
                alignment: center
            }
            layout {
                sequence: 6
            }
        )

        column NOMEPRODUTO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 2
            }
        )

    )

    region region-buttons (
        name: Region buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P497_IDCOMPRATRANSFERENCIA (
        type: hidden
        layout {
            sequence: 10
            region: @lista-de-históricos
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P497_IDCOMPRATRANSFERENCIA_1 (
        type: hidden
        layout {
            sequence: 10
            region: @lista-de-históricos-ajustados
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P497_ID_PEDIDO (
        type: hidden
        layout {
            sequence: 20
            region: @lista-de-históricos
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P497_ID_PEDIDO_1 (
        type: hidden
        layout {
            sequence: 20
            region: @lista-de-históricos-ajustados
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @region-buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button corrigir-erros-pedidos (
        buttonName: CORRIGIR_ERROS_PEDIDOS
        label: Corrigir Erros
        layout {
            sequence: 20
            region: @region-buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Deseja marcar os erros como corrigidos?','CORRIGIR_ERROS_PEDIDOS');
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button corrigir-erros-remessas (
        buttonName: CORRIGIR_ERROS_REMESSAS
        label: Corrigir Erros Remessas
        layout {
            sequence: 30
            region: @region-buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Deseja marcar os erros como corrigidos?','CORRIGIR_ERROS_REMESSAS');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from favorita.itensseparacao i
                   , favorita.tiposerrosseparacao t
                   , favorita.itenscomprastransferencias ii
                where i.idtipoerro = t.idtipoerro
                  and i.iditemcompratransferencia = ii.iditemcompratransferencia
                  and i.dataajuste is null
                  and ii.idcompratransferencia = :P497_IDCOMPRATRANSFERENCIA;
                ```
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-modal (
        name: Close Modal
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 103099632926145019
        }
    )

    process corrigis-erros-pedidos (
        name: Corrigis erros Pedidos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_montagem_tablet.prc_correcao_pedido(pid_pedido => :P497_ID_PEDIDO,
                                                          pid_usuario => :P0_IDUSUARIO,
                                                          pcorrecao => 'Erros de montagem marcados como corrigido.');
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Ação Processada!
        }
        advanced {
            executionMappingIdentifier: 103099705797145020
        }
        serverSideCondition {
            type: request=Value
            value: CORRIGIR_ERROS_PEDIDOS
        }
    )

    process corrigis-erros-remessas (
        name: Corrigis erros Remessas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_montagem_tablet.prc_correcao_remessa( pidcompratransferencia => :P497_IDCOMPRATRANSFERENCIA
                                                          , pidusuario             => :P0_IDUSUARIO
                                                          , pcorrecao              => 'Erros de montagem marcados como corrigido.');
                end;
                
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 110370117926787948
        }
        serverSideCondition {
            type: request=Value
            value: CORRIGIR_ERROS_REMESSAS
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 497
                items: {
                    P497_IDCOMPRATRANSFERENCIA: &P497_IDCOMPRATRANSFERENCIA.
                    P497_ID_PEDIDO: &P497_ID_PEDIDO.
                }
                action: resetPagination
            }
        }
    )

)

