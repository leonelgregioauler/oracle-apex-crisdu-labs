page 138 (
    name: Formas de Entrega Filiais Favorita
    title: Formas de Entrega Filiais Favorita
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
    )

    region formas-de-entrega-filiais-favorita (
        name: Formas de Entrega Filiais Favorita
        type: tabform
        source {
            sqlQuery:
                ```sql
                select idfilialfavoritaformaentrega
                     , idfilialfavorita
                     , idformaentrega
                from filiaisfavformasentregas
                where idfilialfavorita = :P138_IDFILIALFAVORITA;
                
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Não encontrou informações.
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 4
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            advanced {
                cellWidth: 60
            }
        )

        column IDFILIALFAVORITA (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 3
            }
            default {
                type: item
                item: P138_IDFILIALFAVORITA
            }
        )

        column IDFILIALFAVORITAFORMAENTREGA (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDFILFAVFORMAENTREGA
            }
        )

        column IDFORMAENTREGA (
            reportColumnQueryId: 3
            derivedColumn: N
            type: selectList
            heading {
                heading: Forma de Entrega
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @lov-formasentregas
                nullDisplayValue: " - Selecione a Forma de Entrega - "
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
        )

    )

    pageItem P138_IDFILIALFAVORITA (
        type: numberField
        label {
            label: Idfilialfavorita
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button adicionarlinha (
        buttonName: ADICIONARLINHA
        label: Adiciona Linha
        layout {
            sequence: 10
            region: @formas-de-entrega-filiais-favorita
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.widget.tabular.addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button excluirlinha (
        buttonName: EXCLUIRLINHA
        label: Excluir
        layout {
            sequence: 30
            region: @formas-de-entrega-filiais-favorita
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIRLINHA');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from filiaisfavformasentregas
                where idfilialfavorita = :P138_IDFILIALFAVORITA
                ```
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 20
            region: @formas-de-entrega-filiais-favorita
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 15
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inseriratualizar (
        buttonName: INSERIRATUALIZAR
        label: Inserir / Atualizar
        layout {
            sequence: 40
            region: @formas-de-entrega-filiais-favorita
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation formaentregafilial-unique (
        name: FORMAENTREGAFILIAL unique
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @formas-de-entrega-filiais-favorita
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidformaentrega number;
                begin
                  select idformaentrega
                  into vidformaentrega
                  from filiaisfavformasentregas
                  where idfilialfavorita = :IDFILIALFAVORITA
                  and idformaentrega = :IDFORMAENTREGA;
                  --
                  if vidformaentrega is not null then
                    return 'Existe um cadastro no sistema com estas informações. Não são permitidas informações repetidas para este cadastro.';
                  end if;
                  --
                exception
                  when no_data_found then
                    return '';
                end;
                ```
        }
        error {
            associatedColumn: IDFORMAENTREGA
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @formas-de-entrega-filiais-favorita
        target {
            tableName: FILIAISFAVFORMASENTREGAS
            pkColumn: IDFILIALFAVORITAFORMAENTREGA
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: #MRD_COUNT# registro(s) excluído(s).
        }
        error {
            errorMessage: Restrição de integridade violada. Registro filho localizado.
        }
        advanced {
            executionMappingIdentifier: 16343378671416535
        }
        serverSideCondition {
            whenButtonPressed: @excluirlinha
            type: request=Value
            value: EXCLUIRLINHA
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @formas-de-entrega-filiais-favorita
        target {
            tableName: FILIAISFAVFORMASENTREGAS
            pkColumn: IDFILIALFAVORITAFORMAENTREGA
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# registro(s) atualizado(s), #MRI_COUNT# registro(s) inserido(s).
        }
        error {
            errorMessage: Informações incorretas.
        }
        advanced {
            executionMappingIdentifier: 16342923081416535
        }
        serverSideCondition {
            whenButtonPressed: @inseriratualizar
            type: request=Value
            value: INSERIRATUALIZAR
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 138
            }
        }
        serverSideCondition {
            whenButtonPressed: @inseriratualizar
        }
    )

)

