    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function imprimeboleto()
            {
              var idpedido = document.getElementById("P30_IDPEDIDO").value;
              var idvendedora = document.getElementById("P30_IDVENDEDORA").value;
                
              /*vurl = 'https://boleto.romancemoda.com.br/boleto_bb_favorita_sem_iframe_com_pix_v2.php?cod1='+idpedido+'&cod2='+idvendedora;*/
              vurl = document.getElementById('P0_URLBOLETOBASE').value+'?cod1='+idpedido+'&cod2='+idvendedora;
              pjan = window.open(vurl,'boleto','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1024,height=1000,left=20,top=10','_blank'); 
              pjan.focus();
            }
            
            
            function fnc_editapagamentopedido()
            {
            var params = [
                'height='+screen.height,
                'width='+screen.width,
                'fullscreen=yes' // only works in IE, but here for completeness
            ].join(',');
                IDREPRESENTANTE = document.getElementById('P30_FEITOPORREPRESENTANTE').value;
                IDPEDIDO        = document.getElementById('P30_IDPEDIDO').value;
                IDUSUARIO       = document.getElementById('P0_IDUSUARIO').value;
                venderecows     = document.getElementById('P0_ENDERECOWS').value;
                
                if( IDREPRESENTANTE != '') 
                  {
                    vendereco = venderecows+'"IDPEDIDO":'+IDPEDIDO+',"IDUSUARIO":'+IDUSUARIO+',"IDREPRESENTANTE":'+IDREPRESENTANTE+',"APENAS_ALTERAR_PAGAMENTO":true}'
                  }  
                else
                  {
                    vendereco = venderecows+'"IDPEDIDO":'+IDPEDIDO+',"IDUSUARIO":'+IDUSUARIO+',"APENAS_ALTERAR_PAGAMENTO":true}'
                  }  
                vjanela = window.open(vendereco , 'SITE', params);/* 'location=yes,height=100%,width=100%,scrollbars=yes,status=yes');*/
                vjanela.focus();
                vjanela.moveTo(0,0);
                addEventListener("message", function(msg){ if (msg.data == "reload") location.reload()}, false);
                
            }
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region vencimentos (
        name: Vencimentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idpagamentopedido
                     , t.idvencimentopedido
                     , t.idformapagamento
                     , t.formapagamento
                     , t.datapagamento
                     --, t.idsituacao
                     --, t.situacaopagamento
                     , t.descorigempagamento "Origem"
                     , t.numeroboleto
                     , v.datavencimento
                     , v.valorpagar
                     , v.valorpago   
                     , t.valorpago valorpagoforma
                     , v.situacaovencimento
                     , case 
                         when t.boleto = 'S' then
                           --'<a href="http://boletos.romancemoda.com.br:7777/boleto/boleto_bb_favorita_novo.php?cod1='||v.idpedido||'&cod2='||v.idvendedora||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' 
                           '<a href=javascript:imprimeboleto();><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' 
                         when t.idformapagamento = 17 then
                           '<a href="'||t.linkboleto||'"target="_blank"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>'
                         else
                          '-'
                       end url
                       , nvl(t.chavepix, t.emvqrcode) chavepix
                       , T.STATUS_REGISTRO_BB
                from vw_vencimentospedidos_fav v
                   , vw_pagamentospedidos_fav  t
                where v.idvencimentopedido = t.idvencimentopedido
                  and idpedido             = :P30_IDPEDIDO
                  and t.ididioma           = :P0_IDIDIOMA 
                ```
        }
