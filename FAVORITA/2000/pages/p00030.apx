    button reprocessarboletos (
        buttonName: ReprocessarBoletos
        label: Reprocessar Boletos com Erro
        layout {
            sequence: 10
            region: @vencimentos
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM VENCIMENTOSPEDIDOS
                JOIN PAGAMENTOSPEDIDOS USING (IDVENCIMENTOPEDIDO)
                WHERE STATUS_REGISTRO_BB = 'ERRO'
                  AND IDPEDIDO = :P30_IDPEDIDO
                  AND ROWNUM=1
                  AND 1= (select 1
                            from favorita.pedidos
                            where idpedido = :P30_IDPEDIDO
                              and idfilialfavorita in(select idfilial from BB_FILIAIS_MIGRACAO_BOLETO)) --loja igrejinha
                ```
        }
    )

    process popula-o-idtransacao (
        name: Popula o idtransacao
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  select p.idtransacaovirtualage
                    into :P30_IDTRANSACAOVIRTUAL
                  from favorita.pedidos p
                  where p.idpedido = :P30_IDPEDIDO;
                  --
                exception
                  when others then 
                    :P30_IDTRANSACAOVIRTUAL := null;
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 5885333334514271026
        }
    )

    process processaboletomanual (
        name: ProcessaBoletoManual
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                --para pedidos nao vindos do adapto (integracao automatica do va)
                declare
                  v_json clob;
                begin
                    MERGE INTO bkp_linhadigitavel b
                        USING (
                            SELECT p.idpagamentopedido,
                                   p.linhadigitavel
                              FROM pagamentospedidos p
                              JOIN vw_pagamentospedidos_fav t
                                ON t.idpagamentopedido = p.idpagamentopedido
                              JOIN vw_vencimentospedidos_fav v
                                ON v.idvencimentopedido = t.idvencimentopedido
                             WHERE v.idpedido           = :P30_IDPEDIDO
                               AND t.emvqrcode IS NULL
                               AND p.linhadigitavel IS NOT NULL
                        ) x
                        ON (b.idpagamentopedido = x.idpagamentopedido)
                        WHEN MATCHED THEN
                            UPDATE SET b.linha_digitavel = x.linhadigitavel
                        WHEN NOT MATCHED THEN
                            INSERT (idpagamentopedido, linha_digitavel)
                            VALUES (x.idpagamentopedido, x.linhadigitavel);
                
                        -- =========================================================================
                        -- 2) LIMPA A LINHA DIGITAVEL                 (identico ao processo original)
                        -- =========================================================================
                        UPDATE pagamentospedidos p
                           SET p.linhadigitavel = NULL
                         WHERE p.idpagamentopedido IN (
                                SELECT p2.idpagamentopedido
                                  FROM pagamentospedidos p2
                                  JOIN vw_pagamentospedidos_fav t
                                    ON t.idpagamentopedido = p2.idpagamentopedido
                                  JOIN vw_vencimentospedidos_fav v
                                    ON v.idvencimentopedido = t.idvencimentopedido
                                 WHERE v.idpedido           = :P30_IDPEDIDO
                                   AND t.emvqrcode IS NULL
                                   AND p2.linhadigitavel IS NOT NULL
                         );
                
                  pck_integracao_bb_v2.prc_registra_boletos_pedido(:P30_IDPEDIDO, v_json);
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Processado.
        }
        error {
            errorMessage: Erro ao processar.
        }
        advanced {
            executionMappingIdentifier: 1298369556126607329
        }
        serverSideCondition {
            whenButtonPressed: @boletomanual
        }
    )

    process reprocessaboletoerro (
        name: ReprocessaBoletoErro
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_json     CLOB;
                    l_mensagem VARCHAR2(32767);
                BEGIN
                    prc_reprocessa_boleto_seguro(
                        p_idpedido => :P30_IDPEDIDO,
                        p_ididioma => :P0_IDIDIOMA,
                        r_json     => l_json,
                        r_mensagem => l_mensagem
                    );
                
                    apex_application.g_print_success_message := l_mensagem;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 2524710193421599328
        }
        serverSideCondition {
            whenButtonPressed: @reprocessarboletos
        }
    )

)

