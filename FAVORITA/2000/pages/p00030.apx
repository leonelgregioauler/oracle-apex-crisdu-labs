    pageItem P30_FEITOPORREPRESENTANTE (
        type: hidden
        layout {
            sequence: 40
            region: @vencimentos
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select P.IDrepresentante
                from classificacoespedidos C
                   , pedidos p
                where c.idpedido             =  p.idpedido 
                  and c.idpedido             = :P68_IDPEDIDO
                  and idcaracteristicapedido = 2
                ```
        }
        security {
            encryptSessionState: false
        }
        comments {
            comments: Este campo retorna o idrepresentante caso ele que tenha feito pedido para a consultra. Nesse caso, o boleto deve ser liberado na hora.
        }
    )

