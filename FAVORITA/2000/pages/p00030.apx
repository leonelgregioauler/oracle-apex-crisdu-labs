    button boletomanual (
        buttonName: BoletoManual
        label: Boleto Manual
        layout {
            sequence: 20
            region: @vencimentos
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                --peiddos nao vindos pelo adapto, processamento manual
                SELECT 1
                FROM VENCIMENTOSPEDIDOS
                JOIN PAGAMENTOSPEDIDOS USING (IDVENCIMENTOPEDIDO)
                WHERE STATUS_REGISTRO_BB is null
                  AND IDPEDIDO = :P30_IDPEDIDO
                  AND ROWNUM=1
                  AND 1 = (select 1
                            from favorita.pedidos
                            where idpedido = :P30_IDPEDIDO
                              and idfilialfavorita in(select idfilial from BB_FILIAIS_MIGRACAO_BOLETO))
                  AND v('APP_USER') in ('GABRIELANDRIOLA','PAULINENAUMANN')
                ```
        }
    )

