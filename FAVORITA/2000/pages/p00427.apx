page 427 (
    name: Ajuste de Permissões de Distribuidores
    title: Ajuste de Permissões de Distribuidores
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region controle-de-distriubidores (
        name: Controle de Distriubidores
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: <font color="BLUE"> Ao alterar a quantidade de consultas, será dividido pela quantidade de regiões.</font>
        }
    )

    pageItem P427_DISTRIBUIDOR (
        type: displayOnly
        label {
            label: Distribuidor
            alignment: left
        }
        layout {
            sequence: 20
            region: @controle-de-distriubidores
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(r.idrepresentante) d
                from representantes r
                where r.idrepresentante = :P427_IDREPRESENTANTE
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P427_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @controle-de-distriubidores
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P427_QTDCONSULTAS (
        type: numberField
        label {
            label: Qtd de Consultas
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 30
            region: @controle-de-distriubidores
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vqtd number;
                begin
                  --
                  select sum(rg.limiteconsultaspc)
                  into vqtd
                  from roman.regioesrepresentantes rg
                  where rg.idrepresentante = :P427_IDREPRESENTANTE;
                  --
                  return vqtd;
                  --
                exception
                  when others then
                    return 0;
                end;
                ```
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vqtd number;
                begin
                  --
                  select sum(rg.limiteconsultaspc)
                  into vqtd
                  from roman.regioesrepresentantes rg
                  where rg.idrepresentante = :P427_IDREPRESENTANTE;
                  --
                  return vqtd;
                  --
                exception
                  when others then
                    return 0;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    button alterar-qtd (
        buttonName: ALTERAR_QTD
        label: Alterar Qtd Consultas
        layout {
            sequence: 30
            region: @controle-de-distriubidores
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button bloquear-consulta (
        buttonName: BLOQUEAR_CONSULTA
        label: Bloquear Consulta
        layout {
            sequence: 20
            region: @controle-de-distriubidores
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.parametrosrepresentantes pr
                where pr.idrepresentante = :P427_IDREPRESENTANTE
                  and pr.parametro       = 'SPC_ATIVACONSULTATABLET'
                  and pr.valor           = 'S'
                ```
        }
    )

    button liberar-consulta (
        buttonName: LIBERAR_CONSULTA
        label: Liberar Consulta
        layout {
            sequence: 10
            region: @controle-de-distriubidores
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.parametrosrepresentantes pr
                where pr.idrepresentante = :P427_IDREPRESENTANTE
                  and pr.parametro       = 'SPC_ATIVACONSULTATABLET'
                  and pr.valor           = 'N'
                ```
        }
    )

    process altear-quantidade-de-consulta (
        name: Altear Quantidade de Consulta
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vquantidade   number := :P427_QTDCONSULTAS;
                  vqtdregioes   number;
                  vqtdporregiao number;
                  --
                begin
                  --
                  select count(1)
                  into vqtdregioes
                  from roman.regioesrepresentantes rg
                  where rg.idrepresentante = :P427_IDREPRESENTANTE
                    and exists ( select 1
                                 from roman.notasvendas nv
                                 where nv.idrepresentante = rg.idrepresentante
                                   and nv.idregiaovenda   = rg.idregiaovenda
                                   and nv.idsituacaonotavenda = 3 );
                  --
                  if vquantidade > 0 then
                    vqtdporregiao := vquantidade / vqtdregioes;
                  else
                    vqtdregioes := 0;
                  end if;
                  --
                  update roman.regioesrepresentantes r
                  set r.limiteconsultaspc = vqtdporregiao
                  where r.idrepresentante = :P427_IDREPRESENTANTE;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Quantidades atualizadas com sucesso!
        }
        advanced {
            executionMappingIdentifier: 5859731951895805
        }
        serverSideCondition {
            type: request=Value
            value: ALTERAR_QTD
        }
    )

    process atualiza-parametro (
        name: Atualiza Parametro
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  vliberado varchar2(1);
                  --
                begin
                  --
                  if v('REQUEST') = 'LIBERAR_CONSULTA' then
                    vliberado := 'S';
                  elsif v('REQUEST') = 'BLOQUEAR_CONSULTA' then
                    vliberado := 'N';
                  end if;
                  --
                  update roman.parametrosrepresentantes pr
                  set pr.valor = vliberado
                  where pr.parametro = 'SPC_ATIVACONSULTATABLET'
                    and pr.idrepresentante = :P427_IDREPRESENTANTE;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo Atualizado Com sucesso!
        }
        advanced {
            executionMappingIdentifier: 5859678063895804
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('LIBERAR_CONSULTA','BLOQUEAR_CONSULTA')
                ```
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 427
                items: {
                    P427_IDREPRESENTANTE: &P427_IDREPRESENTANTE.
                }
                action: resetPagination
            }
        }
    )

)

