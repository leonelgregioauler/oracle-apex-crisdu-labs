page 54 (
    name: Cadastro de Parâmetros
    title: Parâmetros
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region parâmetros (
        name: Parâmetros
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idfilialromance filialromance
                     , idfilialfavorita filialfavorita
                     , nome
                     , valor
                from parametros p
                where nome not  like '%AMBIENTE%'
                  and (:P54_IDFILIALROMANCE is null 
                       or :P54_IDFILIALROMANCE = p.idfilialromance
                       or (:P54_IDFILIALROMANCE = 0 and p.idfilialromance is null ))
                  and (:P54_IDFILIALFAVORITA is null 
                       or :P54_IDFILIALFAVORITA = p.idfilialfavorita)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            showTotalCount: false
        }
        messages {
            whenNoDataFound: Não encontrou informações.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 3322312678170795
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @ROWID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @NOME
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @VALOR
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @FILIALROMANCE
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @FILIALFAVORITA
                layout {
                    sequence: 8
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column FILIALFAVORITA (
            type: selectList
            heading {
                heading: Filial Favorita
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @lov-filiaisfavorita
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: FILIALFAVORITA
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
            enableUsersTo {
                sort: false
            }
        )

        column FILIALROMANCE (
            type: selectList
            heading {
                heading: Filial Romance
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @lov-filiaisromance
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: FILIALROMANCE
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
            enableUsersTo {
                sort: false
            }
        )

        column NOME (
            type: textarea
            heading {
                heading: Parâmetro
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            validation {
                valueRequired: true
                maxLength: 100
            }
            source {
                databaseColumn: NOME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column ROWID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ROWID
                dataType: rowid
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column VALOR (
            type: textarea
            heading {
                heading: Valor do Parâmetro
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: VALOR
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

    )

    pageItem P54_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Filial Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) as d,
                       idfilialfavorita as r
                  from filiaisfavorita
                 order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: " - Todas -"
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P54_IDFILIALROMANCE (
        type: selectList
        label {
            label: Filial Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome as d,
                       idfilial as r
                  from roman.vw_filiais
                 where tipofilial in ('C', 'D', 'P')
                   and ativo = 'S'
                 union
                 select 'Geral' as d,
                       0 as r
                  from dual
                 order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: " - Todas -"
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
                t-Button--iconLeft
            ]
            icon: fa-filter
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation nome-obrigatório (
        name: NOME obrigatório
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @parâmetros
            type: columnIsNotNull
            column: NOME
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ter um valor.
            associatedColumn: NOME
        }
    )

    validation nome-unique (
        name: NOME unique
        execution {
            sequence: 20
        }
        validation {
            editableRegion: @parâmetros
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vnome varchar2(100);
                begin
                  select nome
                  into vnome
                  from parametros
                  where nome = :NOME
                    and (idfilialromance = :IDFILIALROMANCE
                         and idfilialfavorita = :IDFILIALFAVORITA) ;
                  --
                  if vnome is not null then
                    return 'Existe um cadastro no sistema com estas informações. Não são permitidas informações repetidas para este cadastro.';
                  end if;
                  --
                exception
                  when no_data_found then
                    return '';
                end;
                ```
        }
        error {
            associatedColumn: NOME
        }
    )

    process parâmetros-save-interactive-grid-data (
        name: Parâmetros - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @parâmetros
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        error {
            errorMessage: Informações incorretas.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 3389615543953806
        }
    )

)

