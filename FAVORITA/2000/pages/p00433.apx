page 433 (
    name: Compras por Item
    title: Compras por Item
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region compras-transferecias (
        name: Compras/Transferecias
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ic.idcompratransferencia 
                     , ic.idprodutodetalhado
                     , pck_util_fav.fnc_nomeprodutodetalhado(ic.idprodutodetalhado,1) Produto
                     , ic.quantidadecomprada
                     , ( select t.descricao
                         from favorita.tiposcomptransrem t
                         where t.idtipocomptransrem = ct.idtipocomptransrem ) Tipo
                from itenscomprastransferencias ic
                   , comprastransferencias ct
                where ic.idcompratransferencia = ct.idcompratransferencia 
                  and ct.idfilialfavoritadestino = :P433_IDFILIALFAVDESTINO
                  and ic.idprodutodetalhado      = :P433_IDPRODUTODETALHADO
                  and ( (:P433_TIPO = 'E' and ct.idsituacao in (10)) 
                        or (:P433_TIPO = 'R' and ct.idsituacao in ( 20, 30)))
                  and ic.quantidadecomprada > 0
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 18020450909238403
        }

        column IDCOMPRATRANSFERENCIA (
            type: link
            heading {
                heading: "\"Compra/Transf\""
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            link {
                target: {
                    page: 74
                    items: {
                        P74_IDCOMPRATRANSFERENCIA: #IDCOMPRATRANSFERENCIA#
                    }
                    action: resetPagination
                }
                linkText: #IDCOMPRATRANSFERENCIA#
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: I
            }
        )

        column IDPRODUTODETALHADO (
            type: plainText
            heading {
                heading: CodProduto
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column PRODUTO (
            type: plainText
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column QUANTIDADECOMPRADA (
            type: plainText
            heading {
                heading: Quantidade Comprada
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column TIPO (
            type: plainText
            heading {
                heading: Tipo
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        savedReport 180367 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn IDCOMPRATRANSFERENCIA (
                sequence: 1
            )

            displayColumn PRODUTO (
                sequence: 2
            )

            displayColumn QUANTIDADECOMPRADA (
                sequence: 3
            )

            displayColumn TIPO (
                sequence: 4
            )

        )

    )

    pageItem P433_IDFILIALFAVDESTINO (
        type: hidden
        layout {
            sequence: 10
            region: @compras-transferecias
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P433_IDPRODUTODETALHADO (
        type: hidden
        layout {
            sequence: 30
            region: @compras-transferecias
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P433_TIPO (
        type: hidden
        layout {
            sequence: 20
            region: @compras-transferecias
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

