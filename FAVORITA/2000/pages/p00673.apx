page 673 (
    name: Imprimi Termo Recebimento
    title: Imprimi Termo Recebimento
    appearance {
        pageTemplate: @/minimal-no-navigation
    }
    css {
        inline:
            ```css
            /* REMOVE HEADER VITA */
            .t-Header,
            #t_Header {
              display: none !important;
            }
            
            /* REMOVE NAVIGATION BAR */
            .t-Body-nav,
            #t_Body_nav {
              display: none !important;
            }
            
            /* REMOVE SIDE BAR */
            .t-Body-side,
            #t_Body_side {
              display: none !important;
            }
            
            /* REMOVE FOOTER */
            .t-Footer,
            #t_Footer {
              display: none !important;
            }
            
            /* REMOVE ESPAÇO SUPERIOR */
            .t-Body-main {
              margin-top: 0 !important;
              padding-top: 0 !important;
            }
            /* Remove toolbar flutuante do APEX */
            .a-DevToolbar,
            .t-Body-actions,
            .t-ButtonRegion,
            .apex-rds-container,
            .js-maximizeButtonContainer {
                display: none !important;
            }
            /* Numeração da Página */
            @media print {
            
                .folha {
                    position: relative;
                    page-break-after: always;
                }
            
                .folha:last-child {
                    page-break-after: auto;
                }
            
                .numero-pagina {
                    position: absolute;
                    bottom: 10mm;
                    right: 15mm;
                    font-size: 10pt;
                }
            }
            /* Remove botão voltar do Universal Theme */
            .t-Button--back,
            .t-Button.t-Button--iconLeft,
            a.t-Button--back,
            button.t-Button--back {
                display: none !important;
            }
            
            /* Remove breadcrumb se ainda existir */
            .t-Breadcrumb,
            .t-BreadcrumbRegion {
                display: none !important;
            }
            /* Remove qualquer botão no topo esquerdo */
            .t-Body-title .t-Button,
            .t-Region-header .t-Button {
                display: none !important;
            }
            ```
    }
    htmlHeader {
        htmlHeader: <meta charset="UTF-8">
    }
    security {
        pageAccessProtection: unrestricted
    }

    region impressão-termo (
        name: Impressão Termo
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidcupom      number := :P673_CUPOM;
                  vresponsavel  varchar2(50) := :P673_NOMEUSUARIO;
                  vretiradopor  varchar2(1);
                  vidvendedora  number;
                  vidioma       number;
                  v_total       number;
                  v_seq         number := 0;
                  --
                begin
                  --
                  -- ==============================
                  -- CSS GLOBAL (APENAS UMA VEZ)
                  -- ==============================
                 htp.p('<style>
                  @page {
                    size: A4;
                    margin: 12mm;
                  }
                
                  html, body {
                    margin: 0;
                    padding: 0;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 12pt;
                  }
                   .subtitulo{
                              font-size: 14pt;
                              font-weight: bold;
                              margin-top: 20px;
                              margin-bottom: 10px;
                            }
                
                  * {
                    box-sizing: border-box;
                  }
                
                  .folha {
                    width: 100%;
                    margin: 0;
                    padding: 0;
                    overflow: visible !important;
                    height: auto !important;
                    page-break-inside: auto;
                    break-inside: auto;
                  }
                
                  table {
                    width: 100%;
                    border-collapse: collapse;
                  }
                
                  .tabela-brinde th,
                  .tabela-brinde td {
                    border: 1px solid #000;
                    padding: 6px;
                  }
                
                  table, thead, tbody, tr, td, th {
                    page-break-inside: avoid;
                    break-inside: avoid;
                  }
                
                  .rodape-pagina {
                    text-align: right;
                    font-size: 10pt;
                    margin-top: 3mm;
                  }
                
                  @media print {
                    html, body {
                      width: auto !important;
                      height: auto !important;
                      overflow: visible !important;
                    }
                
                    body * {
                      visibility: hidden;
                    }
                
                    .folha, .folha * {
                      visibility: visible;
                    }
                
                    .folha {
                      position: static !important;
                      display: block !important;
                      width: auto !important;
                      height: auto !important;
                      overflow: visible !important;
                      margin: 0 !important;
                      padding: 0 !important;
                    }
                
                    .t-Region,
                    .t-Region-body,
                    .t-Region-bodyWrap,
                    .t-Body-content,
                    .t-Body-contentInner,
                    #wwvFlowForm {
                      overflow: visible !important;
                      height: auto !important;
                      max-height: none !important;
                    }
                  }
                </style>');
                 
                  --
                  -- ============================================================
                  -- CUPONS (CONSULTORAS)
                  -- ============================================================
                  --select count(*)
                  --  into v_total
                  --  from roman.conquistoulevoucupons c
                  -- where c.idconquistoulevoucupom = :P673_CUPOM;
                 
                  select c.retiradopor, c.idvendedora
                    into vretiradopor, vidvendedora
                    from roman.conquistoulevoucupons c
                   where c.idconquistoulevoucupom = :P673_CUPOM;
                 
                  select f.ididioma
                    into vidioma
                    from catal.vendedoras v
                       , catal.filiais f
                   where v.idfilial = f.idfilial
                     and v.idvendedora = vidvendedora;
                 
                  v_seq := v_seq + 1;
                 
                  -- abre folha
                  htp.p('<div class="folha">');
                 
                  if vretiradopor = 'E' and vidioma in (1, 11) then
                    -- Brasil e Portugal
                    favorita.pck_imprime_fav.prc_termo_conquistou_levou_emp(pidcupom     => vidcupom,
                                                                      presponsavel => vresponsavel);
                 
                  elsif vretiradopor = 'E' and vidioma in (2, 6, 12, 13) then
                    favorita.pck_imprime_fav.prc_termo_conquistou_emp_espanhol(pidcupom     => vidcupom,
                                                                               presponsavel => vresponsavel );
                
                  elsif vretiradopor = 'E' and vidioma = 4 then -- exemplo país novo
                    favorita.pck_imprime_fav.prc_termo_conquistou_emp_paraguai(pidcupom     => vidcupom,
                                                                               presponsavel => vresponsavel);
                
                  elsif vretiradopor = 'D' and vidioma in (1, 11) then
                    -- Brasil e Portugal
                    favorita.pck_imprime_fav.prc_termo_conquistou_levou_dist(pidcupom     => vidcupom,
                                                                       presponsavel => vresponsavel);
                 
                  elsif vretiradopor = 'D' and vidioma in (2, 6, 12, 13) then
                    favorita.pck_imprime_fav.prc_termo_conquistou_dist_espanhol(pidcupom     => vidcupom,
                                                                                presponsavel => vresponsavel);
                   elsif vretiradopor = 'D' and vidioma = 4 then -- exemplo país novo
                     favorita.pck_imprime_fav.prc_termo_conquistou_dist_paraguai(pidcupom     => vidcupom,
                                                                                 presponsavel => vresponsavel);
                  end if;
                 
                  -- numeracao no rodape
                  --htp.p('<div class="rodape-pagina">Pagina ' || v_seq || ' de ' || v_total || '</div>');
                 
                  -- fecha folha
                  htp.p('</div>');
                 
                  htp.p('<script>window.onload = function(){window.print();}</script>');
                end;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P673_CAMPANHA (
        type: hidden
        layout {
            sequence: 10
            region: @impressão-termo
            slot: regionBody
        }
    )

    pageItem P673_CUPOM (
        type: hidden
        layout {
            sequence: 20
            region: @impressão-termo
            slot: regionBody
        }
    )

    pageItem P673_DOCUMENTO (
        type: hidden
        layout {
            sequence: 30
            region: @impressão-termo
            slot: regionBody
        }
    )

    pageItem P673_NOMEUSUARIO (
        type: hidden
        layout {
            sequence: 40
            region: @impressão-termo
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select p.nomepessoa
                from catal.usuarios u 
                   , catal.pessoas p
                where p.idpessoa = u.idpessoa 
                  and u.usuario = v('APP_USER');
                ```
        }
        default {
            type: item
            item: P673_NOMEUSUARIO
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 50
            region: @impressão-termo
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    branch (
        name: Go To Page 672
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 672
                items: {
                    P672_CUPOM: &P673_CUPOM.
                    P672_DOCUMENTO: &P673_DOCUMENTO.
                }
                clearCache: 672
            }
        }
    )

)

