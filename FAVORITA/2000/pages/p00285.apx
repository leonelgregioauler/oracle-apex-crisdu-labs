page 285 (
    name: Endereços de Entrega
    title: Endereços de Entrega
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 90%
        height: 90%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region endereços-de-entrega (
        name: Endereços de Entrega
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idenderecoentrega
                     , idpessoa
                     , rua
                     , numero
                     , complemento
                     , bairro
                     , cep
                     , idcidade
                     , observacao
                  from enderecosentrega
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--hiddenOverflow
            ]
        }
        masterDetail {
            masterRegion: @pessoa
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 789604354529920860
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDENDERECOENTREGA
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDPESSOA
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @RUA
                layout {
                    width: 180
                    sequence: 3
                }
            )

            displayColumn (
                column: @NUMERO
                layout {
                    width: 80
                    sequence: 4
                }
            )

            displayColumn (
                column: @COMPLEMENTO
                layout {
                    width: 150
                    sequence: 5
                }
            )

            displayColumn (
                column: @BAIRRO
                layout {
                    width: 150
                    sequence: 6
                }
            )

            displayColumn (
                column: @CEP
                layout {
                    width: 120
                    sequence: 7
                }
            )

            displayColumn (
                column: @IDCIDADE
                layout {
                    width: 163
                    sequence: 9
                }
            )

            displayColumn (
                column: @OBSERVACAO
                layout {
                    width: 257.99308013916016
                    sequence: 10
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column BAIRRO (
            type: textarea
            heading {
                heading: Bairro
                alignment: center
            }
            layout {
                sequence: 80
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: BAIRRO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column CEP (
            type: textarea
            heading {
                heading: Cep
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            validation {
                maxLength: 1000
            }
            source {
                databaseColumn: CEP
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column COMPLEMENTO (
            type: textarea
            heading {
                heading: Complemento
                alignment: center
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 1000
            }
            source {
                databaseColumn: COMPLEMENTO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column IDCIDADE (
            type: popupLov
            heading {
                heading: Cidade
                alignment: center
            }
            settings {
                displayAs: modalDialog
            }
            lov {
                type: sharedComponent
                lov: @lov-cidades
            }
            layout {
                sequence: 100
            }
            source {
                databaseColumn: IDCIDADE
                dataType: number
            }
            columnFilter {
                lovType: useLov
            }
        )

        column IDENDERECOENTREGA (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDENDERECOENTREGA
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: seq_idenderecosentrega
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDPESSOA (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDPESSOA
                dataType: number
            }
            masterDetail {
                masterColumn: @IDPESSOA
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column NUMERO (
            type: textarea
            heading {
                heading: Número
                alignment: center
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: NUMERO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column OBSERVACAO (
            type: textarea
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 110
            }
            validation {
                maxLength: 1000
            }
            source {
                databaseColumn: OBSERVACAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column RUA (
            type: textarea
            heading {
                heading: Rua
                alignment: center
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 1000
            }
            source {
                databaseColumn: RUA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

    )

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
    )

    region pessoa (
        name: Pessoa
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                 select distinct 
                        idpessoa
                      , nomepessoa
                  from vw_pessoas_fav
                 where idpessoa = :P285_IDPESSOA
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            showTotalCount: false
        }
        toolbar {
            show: false
        }
        enableUsersTo {
            download: false
        }
        advanced {
            savedReportMappingIdentifier: 789600144675920851
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDPESSOA
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @NOMEPESSOA
                layout {
                    width: 500
                    sequence: 2
                }
            )

        )

        column IDPESSOA (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDPESSOA
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column NOMEPESSOA (
            type: textarea
            heading {
                heading: Pessoa
                alignment: center
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: NOMEPESSOA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
            readOnly {
                type: always
            }
        )

    )

    pageItem P285_IDPESSOA (
        type: numberField
        label {
            label: Idpessoa
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 20
            region: @endereços-de-entrega
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @endereços-de-entrega
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-reply
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 85
                items: {
                    P85_IDPESSOA: &P285_IDPESSOA.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process limpar-campos-para-voltar (
        name: Limpar Campos para Voltar
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 789592754717884007
        }
        serverSideCondition {
            type: request=Value
            value: VOLTAR
        }
    )

    process save-interactive-grid-data (
        name: " - Save Interactive Grid Data"
        type: interactiveGridAutoRowProcessing
        editableRegion: @endereços-de-entrega
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 789611576651920863
        }
    )

    branch (
        name: Go To Page 285
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 285
                items: {
                    P285_IDPESSOA: &P285_IDPESSOA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: SAVE
        }
    )

)

