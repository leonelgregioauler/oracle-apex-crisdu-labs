    region protocolos-de-atendimento (
        name: Protocolos de Atendimento
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                return q'~
                select pd.idprotocoloatendimento
                     , pd.usuariosolicitou
                     , pd.dataprotocolo
                     , pd.tipoprotocolo
                     , pd.descsituacao
                     , pd.numeropedido
                     , pd.dataatendimento
                     , pd.motivoprotocolo
                     , pd.observacaointerna
                     , pd.usuarioatendeu
                from vw_protocolosatendimentos_fav pd
                   , pessoas p
                where p.idpessoa = :P700_IDPESSOA
                  and pd.cpf     = p.cpf
                ~';
                ```
        }
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                               from vw_protocolosatendimentos_fav pd
                                  , pessoas p
                               where p.idpessoa = :P700_IDPESSOA
                                 and pd.cpf     = p.cpf )
                  and ( :P700_CPF is not null
                     or :P700_DOC is not null )
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 2733858984313201063
        }

