        )

    )

    process marca-desmarca-fraude (
        name: MARCA DESMARCA FRAUDE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    update catal.vendedoras v
                       set fraude = (case 
                                        when v.fraude = 'S' then null
                                        else 'S' 
                                     end)
                     where v.idpessoa = (select p.idpessoa
                                           from catal.pessoas p
                                          where ((    :P700_TIPO = 'D' and p.documentoestrangeiro = :P700_DOC)
                                                 or ( :P700_TIPO = 'C' and p.cpf = :P700_CPF)));
                    commit;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1321685882693100842
        }
        serverSideCondition {
            whenButtonPressed: @fraude
        }
    )

    branch (
        name: Go To Page 700
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 700
                items: {
                    P700_CPF: &P700_CPF.
                    P700_TIPO: &P700_TIPO.
                    P700_DOC: &P700_DOC.
                }
                clearCache: 700
                action: clearRegions
            }
        }
        serverSideCondition {
            whenButtonPressed: @consultar
        }
    )

)

