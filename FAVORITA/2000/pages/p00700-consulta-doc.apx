        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vexiste varchar2(20);
                begin
                  --
                  select 'Sim'
                  into vexiste
                  from dual
                  where exists ( select 1
                                 from roman.fotosdocumentos f
                                  where f.idpessoa = :P700_IDPESSOA
                                    and f.recebida = 'S' );
                  --
                  return vexiste;
                  --
                exception
                  when others then
                    return 'Não';
                end;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P700_SITUACAOCLIENTE (
