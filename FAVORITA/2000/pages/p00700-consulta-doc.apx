    region débitos-notas-em-papéis (
        name: Débitos Notas Em Papéis
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                return q'~
                select pr.nrpedido "Nr Nota"
                  , pr.valor "Valor"
                  , pr.semana "Semana"
                  , decode(pr.situacao,'N','Novo','P','Pago','C','Cobrança','D','Devolução Representante','S','SPC') "Situação"
                  , pr.semanapago "Semana Pago"
                  , pr.observacao "Observação"
                  , roman.pck_romance.fnc_nomerepresentante(pr.idrepresentante) "Representante"
                  , pr.dataenviocobranca "Data Envio Cob"
                  , (select valor - nvl(( select sum(valor)
                         from roman.pepinosrepresentantes
                                 where nrpedido = PR.NRPEDIDO
                                   and idrepresentante = PR.IDREPRESENTANTE
                                   and situacao = 'P' ),0)
                       from roman.pepinosrepresentantes P
                       where idpepinosrepresentante = pr.idpepinosrepresentante) "Saldo"
                  , nvl(cpf,'PAGAMENTO SEM VÍNCULO DE CPF') "Cpf"
                  , decode(pr.situacao,'P',roman.pck_romance.fnc_retornacodigoliberacao(pr.idpepinosrepresentante++10000000)) "Cód Liberação"
                from roman.pepinosrepresentantes pr
                where ( pr.cpf = replace(replace(:P700_CPF,'-',''),'.','')
                       or lower(pr.nomevendedora) = :P700_CLIENTE_NOME   )
                
                ~';
                ```
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: <br><font size="3" color="green"> Observar cuidadosamente o CPF que está informado no débito, caso seja diferente do CPF PESQUISADO, pertence a outra consultora com o MESMO nome, caso não possua CPF, há necessidade de verificar com o setor de COBRANÇA.</font></b>
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P700_CPF is not null
                   or :P700_DOC is not null
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum Débito de Papel encontrado
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 1661271305419759349
        }

