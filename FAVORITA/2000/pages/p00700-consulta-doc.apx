    region débitos-favorita (
        name: Débitos Favorita
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  v_sql varchar2(4000);
                  --
                begin
                  --
                  v_sql := 'select b.dataemissao "Dt Emissão"
                     , b.datavencimento "Dt Vencimento"
                     , b.numero "Numero"
                     , (select s.descricao
                        from catal.situacoes s
                        where s.idsituacao = b.situacao) "Situação"
                     , b.valororiginal "Valor"
                     , roman.pck_romance.fnc_nomerepresentante(b.idrepresentante) "Representante"
                     , roman.pck_romance.fnc_nomefilial(roman.pck_romance.fnc_filialrepresentante(b.IDREPRESENTANTE)) "Empresa Cliente R."
                     , ( select nrpedido from catal.pedidos where idpedido = b.idpedido ) "Nr Pedido"
                     , pck_util.fnc_calculajuros_v2( p_valor_debito  => b.valororiginal,
                                                      p_data_venc     => b.datavencimento,
                                                      p_data_calc     => sysdate,
                                                      p_idpais        => 1) valoratualizado
                     , null urlpedido
                     , null situacaopagamento
                from catal.boletos b
                where b.situacao in (''V'',''G'',''S'',''M'',''K'',''E'')
                  and b.idvendedora = (select idvendedora 
                                       from vendedoras 
                                       where idpessoa = :P700_IDPESSOA )
                union
                select p.dataemissao
                     , p.datavencimentomenor
                     , p.numeropedido
                     , p.situacaoentrega
                     , p.valorapagar - p.valorpago
                     , p.representante
                     , roman.pck_romance.fnc_nomefilial(roman.pck_romance.fnc_filialrepresentante(p.IDREPRESENTANTE))
                     , p.numeropedido
                     , favorita.pck_util_fav.fnc_calculajurosporvencimento( pidpedido => p.idpedido, ppercmulta  => 2, ppercjuros  => 1) valoratualizado, '||
                       '''<a href="javascript:window.open('|| '''''''||APEX_UTIL.PREPARE_URL('||''||''''||'f?p='||''''|| ' || 2000 || '||''''||':68:'||''''||'||' ||
                             'v(''APP_SESSION'')||''::NO::P68_IDPEDIDO:''||p.idpedido ,''SESSION'')||' || ''''''',' || ''''''||'_blank' || '''''); ' || 
                             'void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" class="apex-edit-pencil" alt=""></a>'' urlpedido  
                     , p.situacaopagamento
                from vw_pedidos_fav_venc p
                where p.idvendedora = (select idvendedora 
                                       from vendedoras 
                                       where idpessoa = :P700_IDPESSOA )
                  and exists ( select 1
                               from favorita.vencimentospedidos v
                               where v.idpedido = p.idpedido
                                 and v.datavencimento < sysdate
                                 and v.valorpago < v.valorpagar
                                 and v.situacaovencimento = ''V'')
                  and p.datacancelamento is null -- Cancelado
                  and not exists ( select 1 
                                   from classificacoespedidos c
                                   where c.idpedido = p.idpedido
                                     and c.idcaracteristicapedido = 46 ) 
                  and trunc(p.valorapagar - p.valorpago,2) > 0 ';
                 
                
                return v_sql;
                
                end;
                ```
            pageItemsToSubmit: [
                P700_CPF
                P700_DOC
                P700_IDPESSOA
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P700_CPF is not null
                   or :P700_DOC is not null
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum Débito da Favorita Encontrado
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 1661273554201759372
        }

