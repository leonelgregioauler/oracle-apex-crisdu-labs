    region informações-da-consulta-ao-spc (
        name: Informações da Consulta ao SPC
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                return q'~
                select c.dataconsulta
                     , c.protocolo
                     , c.regiaocpf
                     , c.situacaocpf
                     , c.nome
                     , c.nomemae
                     , c.spc_quantidade
                     , c.spc_valortotal
                     , decode(c.restricao,'S','Possui Restrição','Sem Restrição') restricao
                     , idconsultaspc
                     , datanascimento
                     , ccf
                from roman.consultaspc c
                where c.cpf = replace(replace(:P700_CPF,'.',''),'-','')
                order by 1
                ~';
