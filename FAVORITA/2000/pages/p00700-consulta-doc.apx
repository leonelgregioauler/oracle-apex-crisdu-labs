            templateOptions: #DEFAULT#
            width: 30
        }
        advanced {
            preText: <font color="red"><b><h1>Cliente foi enviada para o SPC!</h1></b></font>
        }
        source {
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from pessoas p
                   , vendedoras v
                where cpf = replace(replace(:P700_CPF,'-',''),'.','')
                  and p.idpessoa = v.idpessoa
                  and v.spc = 'S'
                ```
        }
