    )

    pageItem P700_CATEGORIA_CLUBE (
        type: displayOnly
        label {
            label: Categoria Clube
            alignment: left
        }
        layout {
            sequence: 90
            region: @cliente
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                    -- Variáveis de controle da rotina
                    v_nome_categoria varchar2(500);
                    v_pontos              number;
                    v_proximo_nivel       number;
                    v_idfilial            number;
                    v_proximo_nivel_texto varchar2(1500);
                    
                begin
                
                    -- busca a categoria clube das estrelas da vendedora
                    begin
                        select nomecategoria, pt.pontos, v.idfilial
                          into v_nome_categoria, v_pontos, v_idfilial
                          from roman.categoriasclubes ct
                             , roman.pontuacoesclubedesucesso pt
                             , catal.vendedoras v
                         where pt.idcategoriaclube = ct.idcategoriaclube
                           and pt.idvendedora = v.idvendedora
                           and v.idpessoa = (select p.idpessoa
                                              from catal.pessoas p
                                             where (   (:P700_TIPO = 'C' and p.cpf = :P700_CPF)
                                                    or (:P700_TIPO = 'D' and p.documentoestrangeiro = :P700_DOC)));
                    exception
                        when others then
                            return 'Não participa de campanha.';
                    end;
                
                    -- calcula quantos pontos faltam para o próximo nível e monta a msg.
                    begin
                        select pontuacaoinicial - v_pontos
                          into v_proximo_nivel
                          from roman.configuracoescategorias c
                         where ':' || c.franquias || ':' like '%:'||v_idfilial||':%'
                           and c.pontuacaoinicial > v_pontos
                         order by c.pontuacaoinicial
                         fetch first 1 rows only;
                        
                        v_proximo_nivel_texto := ' - (Faltam '|| v_proximo_nivel || ' Pontos Para o Próximo nível.)';
                    exception
                        when others then
                            v_proximo_nivel_texto := '.';
                    end;
                
                    -- retorno da rotina com o nome da categoria clube atual da vendedora, pontuação atual e pontos restantes para o próximo nível
                    return v_nome_categoria || '  -  Pontuação Atual: ' || v_pontos || v_proximo_nivel_texto;
                    
                -- Tratamento genérico para possiveis erros.
                exception
                    when others then
                        return 'Dados Não encontrados.';
                end;
                ```
            used: always
        }
    )

    pageItem P700_CLIENTE (
        type: textField
        label {
            label: Cliente
            alignment: left
        }
        layout {
            sequence: 40
            region: @cliente
            slot: regionBody
            alignment: left
        }
