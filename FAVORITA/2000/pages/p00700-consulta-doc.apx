        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                /*select decode(ativo,'S','Ativo','N','Inativo') ativo
                from vendedoras v
                where v.idpessoa = :P700_IDPESSOA*/
                
                select decode(ativo,'S','Ativo','N','Inativo') ativo
                  from catal.vendedoras v
                 where v.idpessoa = (select p.idpessoa
                                        from catal.pessoas p
                                       where ((    :P700_TIPO = 'D' and p.documentoestrangeiro = :P700_DOC)
                                              or ( :P700_TIPO = 'C' and p.cpf = replace(replace(:P700_CPF,'-',''),'.',''))))
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

