    region notas-romance (
        name: Notas Romance
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                return q'~
                select nv.numeronota "Numero"
                 , nv.semanacobranca "Sem. Cobrança"
                 , (select ss.descricao 
                    from roman.situacoesnotavenda ss 
                    where ss.idsituacaonotavenda = nv.idsituacaonotavenda) "Situação"
                 , nv.valortotalnota "Valor Total"
                 , nv.valortotalvenda "Valor da Venda"
                 , nv.saldo "Saldo"
                 , roman.pck_romance.fnc_nomerepresentante(nv.idrepresentante) "Representante"
                 , idnotavenda
                 , roman.pck_romance.fnc_nomefilial(roman.pck_romance.fnc_filialrepresentante(NV.IDREPRESENTANTE)) "Empresa Cliente R"
                 , dataretorno
                from roman.notasvendas nv
                where nv.idvendedora = ( select idvendedora 
                                         from vendedoras 
                                         where idpessoa = :P700_IDPESSOA)
                order by pck_util.fnc_idsemana(nv.semanacobranca) desc
                ~';
                ```
        }
        layout {
            sequence: 70
            slot: body
            startNewRow: false
            newColumn: false
