    region histórico-de-pontuação-programa-estrela (
        name: Histórico de Pontuação Programa Estrela
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                return q'~
                select t.pontos         as "Pontos"
                     , t.tipodocumento  as "Tipo Documento"
                     , t.documento      as "Documento"
                     , case
                         when t.idregistrologinminhasacola is not null then
                           ( select r.datalogin
                               from roman.registrosloginminhasacola r
                              where r.idregistrologinminhasacola = t.idregistrologinminhasacola )
                         when t.idpagamentonotavenda is not null then
                           (select datapagamento 
                              from roman.pagamentosnotasvendas 
                             where idpagtonotavenda = t.idpagamentonotavenda ) 
                         when t.idpedido is not null and exists ( select 1
                                                                    from roman.vw_filiais fl
                                                                   where fl.idfilial = t.idfilial
                                                                     and fl.ididioma = 1) then --brasil
                           (select datapagamento 
                              from favorita.pagamentospedidos
                             where idpagamentopedido = t.idpagamentopedido)
                         when t.idpedido is not null and exists ( select 1
                                                                    from roman.vw_filiais fl
                                                                   where fl.idfilial = t.idfilial
                                                                     and fl.ididioma != 1) then --exterior
                           (select databaixa 
                              from favorita.pagamentospedidos
                             where idpagamentopedido = t.idpagamentopedido)
                       end as "Data Pagamento"
                    , roman.pck_util.fnc_semanaid(t.idsemana)  as "Semana Cobrança Pagamento"
                    , dataexpiracao                            as "Data Expiração"
                  from roman.vw_detalhamento_pontos t
                 where t.idpessoa = :P700_IDPESSOA;
                ~';
                ```
        }
        layout {
            sequence: 100
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent12
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P700_CPF is not null
                   or :P700_DOC is not null
                ```
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 2642525030664014548
        }

