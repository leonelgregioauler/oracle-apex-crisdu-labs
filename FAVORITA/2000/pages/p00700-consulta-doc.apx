page 700 (
    name: Consulta DOC
    alias: CONSULTA-DOC
    title: Consulta DOC
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.usuariosgruposatendimento ug
                   , usuarios u
                where ug.usuario = u.usuario
                  and u.idusuario = :P0_IDUSUARIO
                  and ug.idgrupoatendimento in ( 0, 3 , 7 , 9 , 10 , 22 ,25 )
                  and :P700_CPF is not null
                ```
        }
    )

    region cliente (
        name: Cliente
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @cliente-2
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P700_CPF is not null
                   or :P700_DOC is not null
                ```
        }
    )

    region cliente-2 (
        name: Cliente
        type: staticContent
        source {
