        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select p.nomepessoa||' - '||roman.pck_romance.fnc_nomefilial(roman.pck_romance.fnc_filialvendedora(v.idvendedora)) nomepessoa 
                from pessoas p
                   , vendedoras v
                where p.idpessoa = v.idpessoa
                  and ( :P700_TIPO is null or ( :P700_TIPO = 'C' and cpf = replace(replace(:P700_CPF,'-',''),'.','') )
                                           or ( :P700_TIPO = 'D' and p.documentoestrangeiro = :P700_DOC ) )
                ```
            used: always
