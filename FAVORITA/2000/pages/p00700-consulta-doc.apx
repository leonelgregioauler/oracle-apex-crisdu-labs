    region pedidos-favorita (
        name: Pedidos Favorita
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                return q'~
                select p.numeropedido
                     , p.dataemissao
                     , p.dataentrega
                     , ( select listagg(to_char(v.datavencimento,'dd/mm/rrrr')||chr(10)) within group (order by 1)
                           from vencimentospedidos v
                          where v.situacaovencimento = 'V' -- <-- valido
                            and v.idpedido           = p.idpedido ) datavencimento
                     , case
                         when p.idsituacaoentrega not in (50) then
                           pck_util_fav.fnc_situacaoentrega( p.idsituacaoentrega
                                                           , 'I'
                                                           , 1 )
                         when ( select count(1)
                                from itenspedidos ip
                                   , classificacoespedidos cp
                                where ip.idpedido = cp.idpedido
                                and cp.idcaracteristicapedido in (8, 13)
                                and ip.idpedido = p.idpedido ) > 0 then pck_util_fav.fnc_situacaoentrega( p.idsituacaoentrega
                                                                                                          , 'I'
                                                                                                          , 1)||' não finalizado.'
                         when ( select count(1)
                                from itenspedidos ip
                                where ip.idpedido = p.idpedido ) > 0 then pck_util_fav.fnc_situacaoentrega( p.idsituacaoentrega
                                                                                                          , 'I'
                                                                                                          , 1)||' com itens.'
                         when ( select count(1)
                                from itenspedidos ip
                                where ip.idpedido = p.idpedido ) = 0 then pck_util_fav.fnc_situacaoentrega( p.idsituacaoentrega
                                                                                                          , 'I'
                                                                                                          , 1)||' sem itens.'
                       end  situacaoentregainterno
                     , pck_util_fav.fnc_situacaofinanceiro( p.idsituacaofinanceiro
                                                          , 'I'
                                                          , 1)            situacaofinanceirointerno
                     , p.valortotal
                     , p.valorapagar
                     , pck_util_fav.fnc_nomerepresentante( p.idrepresentante ) distribuidor
                     , pck_util_fav.fnc_nomefilialromance( p.idfilialromance ) filialromance
                     , case
                        when p.datacancelamento is null then
                          'Não'
                        else
                          'Sim'
                       end pedidocancelado
                     , pck_pedidos_fav.fnc_situacaopagamentoped(p.idpedido) situacaopagamento
                       /*, case 
                         when p.tipo = 'new' then
                           '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||p.idpedido ,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' 
                       end urlpedido */
                     , p.idpedido urlpedido
                from favorita.pedidos p
                 , vendedoras v
                where p.idvendedora = v.idvendedora
                  and p.idsituacaoentrega >= 20000
                  and v.idpessoa = :P700_IDPESSOA
                order by idpedido desc
                ~';
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P700_CPF is not null
                   or :P700_DOC is not null
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
