    region débitos-notas-romance (
        name: Débitos Notas Romance
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                return q'~
                select nv.numeronota
                  , nv.semanadistribuicao "Distribuição"
                  , nv.semanacobranca "Cobrança"
                  , roman.pck_romance.fnc_nomerepresentante(nv.idrepresentante) "Representante"
                  , nv.valortotalnota "Total da Nota"
                  , nv.perccomissao "Comissão"
                  , nv.valortotalvendalqd "Total Venda Liquida"
                  , nvl((select SUM(p.valor)
                          from roman.pepinosrepresentantes p
                          where p.idnotavenda = nv.idnotavenda
                            and p.situacao    = 'P'
                            and p.idfechamentoreprespago is null ),0) +
                          nvl((select sum(pnv.valorpago)
                               from roman.pagamentosnotasvendas pnv
                               where pnv.idnotavenda = nv.idnotavenda
                                 and trim(pnv.semanacobranca) is null
                                 and not exists ( select 1 
                                                  from roman.pepinosrepresentantes p
                                                  where p.idnotavenda = pnv.idnotavenda 
                                                    and p.valor       = pnv.valorpago
                                                    and p.idfechamentoreprespago is null
                                                    and p.situacao = 'P') ),0) SETORCOBRANCA
                  , nv.valorpago "Pago"
                  , nv.saldo "Saldo"
                  , roman.pck_romance.fnc_nomefilial(roman.pck_romance.fnc_filialrepresentante(NV.IDREPRESENTANTE)) "Empresa Cliente R"
                  , decode(nv.enviadocobranca,'S','Sim','Não') enviadocobranca
                  , decode(nv.enviadocobranca,'S',pck_util.fnc_calculajuros_v2( p_valor_debito => nv.saldo,
                                                                                   p_data_venc    => nv.dataretornoorig,
                                                                                   p_data_calc    => sysdate,
                                                                                   p_idpais       => catal.pck_util.fnc_paisvendedora(pidvendedora => nv.idvendedora)),null) "Saldo Atualizado"
                from roman.notasvendas nv
                where nv.saldo > 0
                  and nv.idsituacaonotavenda in (4,5)
                  and nv.idvendedora = ( select idvendedora 
                                         from vendedoras 
                                         where idpessoa = :P700_IDPESSOA )
                order by 3 desc
                
                ~';
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P700_CPF is not null
                   or :P700_DOC is not null
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum Débito Romance Encontrado
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 1660838850360454381
        }

