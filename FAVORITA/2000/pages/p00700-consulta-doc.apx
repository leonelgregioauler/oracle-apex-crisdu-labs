    pageItem P700_TEMPODEFAVORITA (
        type: textField
        label {
            label: Cliente Favorita
            alignment: left
        }
        layout {
            sequence: 20
            region: @histórico-cliente
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                 --
                 vidvendedora number;
                 vtexto       varchar2(1000);
                 vexiste      varchar2(1);
                 --
                begin
                  --
                  select idvendedora
                  into vidvendedora
                  from vendedoras v
                  where v.idpessoa = :P700_IDPESSOA;
                  --
                  begin
                    --
                    select 'S'
                    into vexiste
                    from dual
                    where exists ( select 1
                                   from catal.pedidos p
                                   where p.idvendedora = vidvendedora );
                    --
                  exception
                    when NO_DATA_FOUND then
                      vexiste := 'N';
                  end;
                  --
                  if vexiste = 'S' then
                    --
                    select 'desde '||trunc(p.dtemissao)||' ( '||(trunc(sysdate)-trunc(p.dtemissao))||' dias )' texto
                    into vtexto
                    from catal.pedidos p
                    where idpedido = ( select min(idpedido)
                                       from catal.pedidos pp
                                       where pp.idvendedora = vidvendedora
                                         and pp.situacao <> 'Z');
                    --
                  else
                    --
                    select 'desde '||trunc(p.dataemissao)||' ( '||(trunc(sysdate)-trunc(p.dataemissao))||' dias )' texto
                    into vtexto
                    from favorita.pedidos p
                    where idpedido = ( select min(idpedido)
                                       from favorita.pedidos pp
                                       where pp.idvendedora = vidvendedora
                                         and pp.datacancelamento is null
                                         and pp.idsituacaoentrega >= 20000 );
                    --
                  end if;
                  --
                  return vtexto;
                  --
                exception
                  when others then
                    --
                    return 'Ainda não é cliente Favorita.';
                    --
                end;
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P700_TEMPODEROMANCE (
        type: textField
        label {
            label: Cliente Romance
            alignment: left
        }
        layout {
            sequence: 10
            region: @histórico-cliente
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vtexto varchar2(100);
                  vexiste varchar2(1);
                begin
                  -- 
                  select 'desde '||trunc(n.datanota)||' ( '||(trunc(sysdate)-trunc(n.datanota))||' dias )' desde
                  into vtexto
                  from roman.notasvendas n
                  where n.idnotavenda = ( select min(idnotavenda)
                                          from roman.notasvendas nn
                                             , vendedoras v
                                          where v.idvendedora         = nn.idvendedora
                                            and v.idpessoa            = :P700_IDPESSOA
                                            and nn.idsituacaonotavenda in (3,4) );
                  --
                  return vtexto;
                  --
                exception
                  when others then
                    return 'Ainda não é Cliente Romance.';
                end;
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P700_TICKETMEDIO (
        type: textField
        label {
            label: Ticket Médio
            alignment: left
        }
        layout {
            sequence: 40
            region: @histórico-cliente
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select to_char(nvl((sum(n.valorpago) / count(n.idnotavenda)),0),'999G999G999G999G999G999G990D00') ticket
                from roman.notasvendas n
                   , vendedoras v
                where v.idvendedora         = n.idvendedora
                  and v.idpessoa            = :P700_IDPESSOA
                  and n.idsituacaonotavenda = 4
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

