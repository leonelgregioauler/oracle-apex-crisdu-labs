    pageItem P700_IDPESSOA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 130
            region: @cliente
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                 v_id number;
                begin
                  if :P700_TIPO = 'D' then
                    select idpessoa
                      into v_id
                      from pessoas p
                     where p.documentoestrangeiro = :P700_DOC ;
                  else
                    select idpessoa
                      into v_id
                      from pessoas p
                     where cpf = pck_util.fcn_retornasonumeros(:P700_CPF) ;
                  end if;
                  return v_id;
                end;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

