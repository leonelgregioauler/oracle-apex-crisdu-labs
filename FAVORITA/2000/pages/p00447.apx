page 447 (
    name: Cadastro Edições Revistas On-Line
    title: Cadastro Edições Revistas On-Line
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region edições-revistas-on-line (
        name: Edições Revistas On-Line
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P447_DATAFINAL (
        type: datePickerJquery
        label {
            label: Data Final
            alignment: left
        }
        layout {
            sequence: 80
            region: @edições-revistas-on-line
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P447_DATAINICIAL (
        type: datePickerJquery
        label {
            label: Data Inicial
            alignment: left
        }
        layout {
            sequence: 70
            region: @edições-revistas-on-line
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P447_IDEDICAOREVISTA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @edições-revistas-on-line
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P447_IDEDICAOREVISTAONLINE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @edições-revistas-on-line
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P447_IDPAIS (
        type: plugin/select
        label {
            label: País
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome display_value
                     , idpais return_value
                from roman.paises
                order by nome
                ```
            nullDisplayValue: " - Selecione o País - "
        }
        layout {
            sequence: 90
            region: @edições-revistas-on-line
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P447_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 110
            region: @edições-revistas-on-line
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P447_NOME (
        type: textField
        label {
            label: Nome
            alignment: left
        }
        layout {
            sequence: 30
            region: @edições-revistas-on-line
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P447_OPERACAO_DML (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 120
            region: @edições-revistas-on-line
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P447_URL (
        type: textField
        label {
            label: URL
            alignment: left
        }
        layout {
            sequence: 100
            region: @edições-revistas-on-line
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 80
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 60
            region: @edições-revistas-on-line
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P447_IDEDICAOREVISTAONLINE
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 50
            region: @edições-revistas-on-line
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P447_IDEDICAOREVISTAONLINE
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 30
            region: @edições-revistas-on-line
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P447_IDEDICAOREVISTAONLINE
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 40
            region: @edições-revistas-on-line
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-reply
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 22
                items: {
                    P22_IDEDICAOREVISTA: &P447_IDEDICAOREVISTA.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation datafinal-data-válida (
        name: DATAFINAL data válida
        execution {
            sequence: 50
        }
        validation {
            type: itemIsAValidDate
            item: P447_DATAFINAL
            alwaysExecute: true
        }
        error {
            errorMessage: Data final deve ter uma data válida.
        }
    )

    validation datafinal-obrigatória (
        name: DATAFINAL obrigatória
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P447_DATAFINAL
            alwaysExecute: true
        }
        error {
            errorMessage: Data final deve ter uma data válida.
        }
    )

    validation datainicial-data-válida (
        name: DATAINICIAL data válida
        execution {
            sequence: 40
        }
        validation {
            type: itemIsAValidDate
            item: P447_DATAINICIAL
            alwaysExecute: true
        }
        error {
            errorMessage: Data inicial deve ter uma data válida.
        }
    )

    validation datainicial-obrigatória (
        name: DATAINICIAL obrigatória
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P447_DATAINICIAL
            alwaysExecute: true
        }
        error {
            errorMessage: Data inicial deve ter uma data válida.
        }
    )

    validation nome-obrigatório (
        name: NOME obrigatório
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P447_NOME
            alwaysExecute: true
        }
        error {
            errorMessage: Nome deve ter um valor.
        }
    )

    process consulta-edições-de-revista-on-line (
        name: Consulta Edições de Revista On-Line
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                #OWNER#.PCK_CADASTROS_FAV.PRC_EDICOESREVISTASONLINE (
                    PIDEDICAOREVISTAONLINE => :P447_IDEDICAOREVISTAONLINE,
                    PIDEDICAOREVISTA       => :P447_IDEDICAOREVISTA,
                    PNOME                  => :P447_NOME,
                    PDATAINICIAL           => :P447_DATAINICIAL,
                    PDATAFINAL             => :P447_DATAFINAL,
                    PIDPAIS                => :P447_IDPAIS,
                    PURL                   => :P447_URL,
                    PMD5                   => :P447_MD5,
                    POPERACAO_DML          => 'S' );
                  
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 36081900819886747
        }
    )

    process limpar-campos-ao-sair (
        name: Limpar Campos ao Sair
        type: clearSessionState
        execution {
            sequence: 30
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 49625732976784066
        }
    )

    process operação-dml-em-edições-revistas-on-line (
        name: Operação DML em Edições Revistas On-Line
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                #OWNER#.PCK_CADASTROS_FAV.PRC_EDICOESREVISTASONLINE (
                    PIDEDICAOREVISTAONLINE => :P447_IDEDICAOREVISTAONLINE,
                    PIDEDICAOREVISTA       => :P447_IDEDICAOREVISTA,
                    PNOME                  => :P447_NOME,
                    PDATAINICIAL           => :P447_DATAINICIAL,
                    PDATAFINAL             => :P447_DATAFINAL,
                    PIDPAIS                => :P447_IDPAIS,
                    PURL                   => :P447_URL,
                    PMD5                   => :P447_MD5,
                    POPERACAO_DML          => voperacao_dml );
                    --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 49624840350779771
        }
    )

    branch (
        name: Go To Page 22
        execution {
            sequence: 21
        }
        behavior {
            target: {
                page: 22
                items: {
                    P22_IDEDICAOREVISTA: &P447_IDEDICAOREVISTA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @excluir
        }
    )

    branch (
        name: Go To Page 447
        execution {
            sequence: 11
        }
        behavior {
            target: {
                page: 447
                items: {
                    P447_IDEDICAOREVISTAONLINE: &P447_IDEDICAOREVISTAONLINE.
                    P447_IDEDICAOREVISTA: &P447_IDEDICAOREVISTA.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

)

