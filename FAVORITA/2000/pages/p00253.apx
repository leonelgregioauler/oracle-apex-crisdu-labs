page 253 (
    name: Itens Para Excluir
    title: Itens Para Excluir
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_excluir(pid)
            {
              document.getElementById("P253_IDEDITAR").value = pid;
              apex.submit('EXCLUIR');
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cabecario (
        name: Cabecario
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region selecionados-para-exclusão (
        name: Selecionados para Exclusão
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select '<a href="javascript:apex.confirm(''Confirmar a exclusão do item ? '', 
                             { request:''EXCLUIR'', set:{''P253_IDEDITAR'':'||i.iditempedido||' }  } )";><img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" border="0"></a>' excluir
                     , i.idpedido
                     , pck_util_fav.fnc_nomeprodutodetalhado( i.idprodutodetalhado , :P0_IDIDIOMA) nomeprodutodetalhado
                     , i.quantidadedevolvida
                     , i.quantidadedefeito
                     , i.quantidadeavaria
                     , i.quantidaderecebidatrocada
                     , i.quantidadenaorecebida
                     , i.idestoque 
                from favorita.itensexcluidos i
                   , itenspedidos v
                where v.iditempedido(+) = i.iditempedido 
                  and i.idpedido = :P253_IDPEDIDO
                  and i.idprotocolo = :P253_IDPROTOCOLOATENDIMENTO
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 3272475821485998625
        }

