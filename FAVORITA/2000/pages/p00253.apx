    validation iddefeito-is-not-null (
        name: IDDEFEITO is not null
        execution {
            sequence: 60
        }
        validation {
            type: itemIsNotNull
            item: P253_IDDEFEITO
        }
        error {
            errorMessage: Defeito deve ser informado
            associatedItem: @P253_IDDEFEITO
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P253_QUANTIDADEDEFEITO > 0
        }
    )

    validation idprodutodetalhadotrocado-obrigatório (
        name: IDPRODUTODETALHADOTROCADO obrigatório
        execution {
            sequence: 50
        }
        validation {
            type: itemIsNotNull
            item: P253_IDPRODUTODETALHADOTROCADO
            alwaysExecute: true
        }
        error {
            errorMessage: Produto detalhado recebido trocado deve ser informado.
            associatedItem: @P253_IDPRODUTODETALHADOTROCADO
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P253_QUANTIDADERECEBIDATROCADA > 0
        }
    )

    validation somente-quantidade-não-recebida (
        name: Somente quantidade não recebida
        execution {
            sequence: 40
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  --
                  if :P253_QUANTIDADENAORECEBIDA      is not null and
                    ( :P253_QUANTIDADEDEVOLVIDA       is not null or
                      :P253_QUANTIDADEDEFEITO         is not null or
                      :P253_QUANTIDADEAVARIA          is not null or
                      :P253_QUANTIDADERECEBIDATROCADA is not null ) then
                    --
                    return ('Quantidade não recebida deve ser informada separadamente');
                    --
                  end if;
                  --
                end;
                ```
        }
        error {
            displayLocation: inlineInNotification
            associatedItem: @P253_QUANTIDADENAORECEBIDA
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'INCLUIR'
                ```
        }
    )

    validation valida-inteiro (
        name: Valida Inteiro
        execution {
            sequence: 30
        }
        validation {
            type: plsqlError
            plsqlCodeRaisingError:
                ```plsql
                declare
                  --
                  vquantidadedevolvida   number := :P253_QUANTIDADEDEVOLVIDA; 
                  vquantidadedefeito     number := :P253_QUANTIDADEDEFEITO;
                  vquantidadeavaria      number := :P253_QUANTIDAAVARIA;
                  vquantidadetrocada     number := :P253_QUANTIDADERECEBIDATROCADA;
                  vquantidadenaorecebida number := :P253_QUANTIDADENAORECEBIDA;
                  --
                begin
                  --
                  vquantidadedevolvida   := vquantidadedevolvida+vquantidadedevolvida;
                  vquantidadedefeito     := vquantidadedefeito+vquantidadedefeito;
                  vquantidadeavaria      := vquantidadeavaria+vquantidadeavaria;
                  vquantidadetrocada     := vquantidadetrocada+vquantidadetrocada;
                  vquantidadenaorecebida := vquantidadenaorecebida+vquantidadenaorecebida;
                  --
                  vquantidadedevolvida   := MOD(vquantidadedevolvida,2);
                  vquantidadedefeito     := MOD(vquantidadedefeito,2);
                  vquantidadeavaria      := MOD(vquantidadeavaria,2);
                  vquantidadetrocada     := MOD(vquantidadetrocada,2);
                  vquantidadenaorecebida := MOD(vquantidadenaorecebida,2);
                  --
                  if vquantidadedevolvida > 0 or vquantidadedefeito > 0 or vquantidadeavaria > 0 or vquantidadetrocada > 0 or vquantidadenaorecebida > 0 then
                    --
                    raise_Application_Error (-20089, 'Numero deve ser inteiro');
                    --
                  end if;
                  --
                end;
                ```
        }
        error {
            errorMessage: Valor precisa ser inteiro
        }
        serverSideCondition {
            type: request=Value
            value: INCLUIR
        }
    )

    validation zero (
        name: Zero
        execution {
            sequence: 20
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where to_number(:P253_QUANTIDADEDEVOLVIDA)       > 0
                   or to_number(:P253_QUANTIDADEDEFEITO)         > 0
                   or to_number(:P253_QUANTIDADEAVARIA)          > 0
                   or to_number(:P253_QUANTIDADERECEBIDATROCADA) > 0
                   or to_number(:P253_QUANTIDADENAORECEBIDA)     > 0
                ```
        }
        error {
            errorMessage: Quantidade deve ser maior que zero.
        }
        serverSideCondition {
            type: request=Value
            value: INCLUIR
        }
    )

    process concluir-inclusão (
        name: Concluir Inclusão
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidpedido    NUMBER := :P253_IDPEDIDO;
                  vidprotocolo NUMBER := :P253_IDPROTOCOLOATENDIMENTO;
                  l_json       CLOB;
                  --
                begin
                  --
                  pck_protocolosatendimentos_fav.prc_incluiitemexcluido( pidpedido    => vidpedido 
                                                                       , pidprotocolo => vidprotocolo);
                  --
                  --registra novos boletos  
                    FOR r IN (
                        SELECT 
                            t.idpagamentopedido
                        FROM vw_vencimentospedidos_fav v
                        JOIN vw_pagamentospedidos_fav t
                          ON v.idvencimentopedido = t.idvencimentopedido
                        JOIN pedidos p on v.idpedido = p.idpedido
                        WHERE v.idpedido           = vidpedido
                          AND t.ididioma           = :P0_IDIDIOMA
                          AND p.idpais = 1
                          and t.IDFORMAPAGAMENTO in (1,5,12,17,18,20,26,27,34,36,37,43,44,46,47,48,66) --boleto
                          and v.CODSITUACAOVENCIMENTO = 'V'
                    )
                    LOOP
                
                        BEGIN
                
                            pck_integracao_bb_v2.prc_registra_boleto(
                                p_idpagamentopedido => r.idpagamentopedido,
                                r_json              => l_json
                            );
                
                        EXCEPTION
                            WHEN OTHERS THEN
                
                                DBMS_OUTPUT.PUT_LINE(
                                    'Erro ao reprocessar boleto ' ||
                                    r.idpagamentopedido || ' - ' || SQLERRM
                                );
                
                        END;
                
                    END LOOP;
                  --
                end;
                ```
        }
