    process incluir-item (
        name: Incluir Item
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  viditempedido              number := :P253_IDITEMPEDIDO;
                  vquantidadedevolvida       number := :P253_QUANTIDADEDEVOLVIDA; 
                  vquantidadedefeito         number := :P253_QUANTIDADEDEFEITO;
                  vquantidadeavaria          number := :P253_QUANTIDADEAVARIA;
                  vquantidaderecebidatrocada number := :P253_QUANTIDADERECEBIDATROCADA;
                  vquantidadenaorecebida     number := :P253_QUANTIDADENAORECEBIDA;
                  vquantidade                number := nvl(:P253_QUANTIDADEDEVOLVIDA, 0) + 
                                                       nvl(:P253_QUANTIDADEDEFEITO, 0) + 
                                                       nvl(:P253_QUANTIDADEAVARIA, 0) + 
                                                       nvl(:P253_QUANTIDADERECEBIDATROCADA, 0) + 
                                                       nvl(:P253_QUANTIDADENAORECEBIDA, 0);
                  --
                  viditemexcluido            NUMBER := null;
                  vidpedido                  NUMBER := :P253_IDPEDIDO;
                  vidprotocolo               NUMBER := :P253_IDPROTOCOLOATENDIMENTO;
                  vrecebidofilial            VARCHAR2(2):=null;
                  vidusuariorecebeu          NUMBER;
                  vdatarecebido              DATE := null;
                  vvalorvendaoriginal        NUMBER;
                  viddefeito                 NUMBER; 
                  vvalorpagar                NUMBER;
                  vnumber                    NUMBER;
                  vidfilial                  NUMBER;
                  vidfilialromance           NUMBER;
                  videdicaorevista           NUMBER;
                  --
                  vvarchar                   varchar2(2000);
                  vmd5                       varchar2(2000);
                  vmotivo                    varchar2(2000);
                  --
                  --
                  -- cursor para itens 
                  --
                  cursor citped is
                  select *
                  from favorita.itenspedidos p
                  where p.iditempedido = viditempedido;
                  --
                  ritped citped%rowtype;
                  --
                  -- fim cursor
                  --
                begin
                  --
                  open citped;
                  fetch citped into ritped;
                  close citped;
                  --
                  select pp.idedicaorevista
                  into videdicaorevista
                  from favorita.pedidos pp
                  where pp.idpedido = :P253_IDPEDIDO; 
                  --
                  PCK_PROTOCOLOSATENDIMENTOS_FAV.prc_ITENSEXCLUIDOS ( piditemexcluido            => viditemexcluido
                                                                    , piditempedido              => ritped.iditempedido
                                                                    , pidpedido                  => ritped.idpedido                  
                                                                    , pidproduto                 => ritped.idproduto                 
                                                                    , pidestoque                 => ritped.idestoque                 
                                                                    , pidprodutodetalhado        => ritped.idprodutodetalhado        
                                                                    , pquantidade                => vquantidade   -- ritped.quantidade             
                                                                    , pvalorvenda                => ritped.valorvenda                
                                                                    , pvalorcusto                => ritped.valorcusto                
                                                                    , pvalordesconto             => ritped.valordesconto             
                                                                    , pperccomissaogerente       => ritped.perccomissaogerente       
                                                                    , pvalorcomissaogerente      => ritped.valorcomissaogerente      
                                                                    , pperccomissaodistribuidor  => ritped.perccomissaodistribuidor  
                                                                    , pvalorcomissaodistribuidor => ritped.valorcomissaodistribuidor 
                                                                    , pperccomissaoconsultora    => ritped.perccomissaoconsultora    
                                                                    , pvalorcomissaoconsultora   => ritped.valorcomissaoconsultora   
                                                                    , pvalorcomissaoatendente    => ritped.valorcomissaoatendente    
                                                                    , pvalorapagar               => ritped.valorapagar               
                                                                    , pidcompreeganhe            => ritped.idcompreeganhe            
                                                                    , pidbrinde                  => ritped.idbrinde                  
                                                                    , pidpromocaodivulgacao      => ritped.idpromocaodivulgacao      
                                                                    , pidkitvenda                => ritped.idkitvenda                
                                                                    , piditemkitvenda            => ritped.iditemkitvenda            
                                                                    , piditempedidogeroubrinde   => ritped.iditempedidogeroubrinde   
                                                                    , pvalortributadovirtualage  => ritped.valortributadovirtualage  
                                                                    , pvalordescontovirtualage   => ritped.valordescontovirtualage   
                                                                    , pidvendalimitada           => ritped.idvendalimitada           
                                                                    , pidprotocolo               => vidprotocolo              
                                                                    , precebidofilial            => vrecebidofilial            
                                                                    , pidusuariorecebeu          => vidusuariorecebeu          
                                                                    , pdatarecebido              => vdatarecebido                                         
                                                                    , pidedicaorevista           => videdicaorevista         
                                                                    , pvalorvendaoriginal        => vvalorvendaoriginal       
                                                                    , pquantidadedevolvida       => vquantidadedevolvida 
                                                                    , pquantidadedefeito         => vquantidadedefeito
                                                                    , piddefeito                 => :P253_IDDEFEITO
                                                                    , pquantidadeavaria          => vquantidadeavaria
                                                                    , pquantidaderecebidatrocada => vquantidaderecebidatrocada
                                                                    , pidprodutodetalhadotrocado => :P253_IDPRODUTODETALHADOTROCADO
                                                                    , pquantidadenaorecebida     => vquantidadenaorecebida
                                                                    , pmd5                       => vmd5                       
                                                                    , poperacao_dml              => 'I'  );         
                  --
                  :P253_IDITEMPEDIDO:= null;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 777039300228469602
        }
        serverSideCondition {
            whenButtonPressed: @incluir
        }
    )

    branch (
        name: Redireciona pagina 130
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 130
                items: {
                    P130_IDPEDIDO: &P253_IDPEDIDO.
                    P130_IDPROTOCOLOATENDIMENTO: &P253_IDPROTOCOLOATENDIMENTO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @concluir
        }
    )

    branch (
        name: GoTo Página 253
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 253
                items: {
                    P253_QUANTIDADEDEVOLVIDA:
                    P253_QUANTIDADEDEFEITO:
                    P253_QUANTIDADEAVARIA:
                    P253_QUANTIDADERECEBIDATROCADA:
                    P253_QUANTIDADENAORECEBIDA:
                }
                action: resetPagination
            }
        }
    )

)

