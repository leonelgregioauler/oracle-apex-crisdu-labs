        layout {
            sequence: 70
            region: @cabecario
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util_fav.fnc_verificagrupoatendimento (4, :P0_IDUSUARIO ) = 'N'
                ```
