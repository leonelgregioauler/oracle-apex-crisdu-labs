    pageItem P253_IDITEMPEDIDO (
        type: plugin/select
        label {
            label: Produto Detalhado
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDITEMPEDIDO||'-'|| nomeprodutodetalhado||' - Qtd:'||( vp.quantidade- nvl( ( select sum(i.quantidade)
                                                                               from ITENSEXCLUIDOS i
                                                                               where i.iditempedido = vp.iditempedido),0)) ||' - R$ '||
                   TRIM(to_char( quantidade * valorvenda,'999G999G999G990D00')) display_item 
                     , iditempedido return_value
                from vw_itenspedidos_fav vp
                where idpedido = :P253_IDPEDIDO
                  and ididioma = :P0_IDIDIOMA
                  and not exists (select ie.iditempedido
                                  from favorita.itensexcluidos ie
                                  where ie.iditempedido = vp.iditempedido
                                    and ie.quantidade - vp.quantidade >=0 )
                  and vp.quantidade > 0
                ```
        }
        layout {
            sequence: 30
            region: @cabecario
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

