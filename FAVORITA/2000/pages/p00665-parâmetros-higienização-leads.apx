page 665 (
    name: Parâmetros Higienização Leads
    alias: PARÂMETROS-HIGIENIZAÇÃO-LEADS
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region parâmetros-higienização-leads (
        name: Parâmetros Higienização Leads
        type: interactiveGrid
        source {
            location: localDatabase
            tableOwner: ROMAN
            tableName: PARAMETROSHIGIENIZACAO
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        performance {
            lazyLoading: true
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 1795675667710381069
        }

        savedReport 17956761 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDPARAMETROHIGIENIZACAO
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDFILIAL
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @TEMPOMAXPAINEL
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 1
                }
            )

            displayColumn (
                column: @ATIVO
                layout {
                    sequence: 5
                }
            )

            sort (
                column: @IDFILIAL
                sort {
                    nulls: last
                    sequence: 1
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column ATIVO (
            type: selectList
            heading {
                heading: Ativo
            }
            lov {
                type: staticValues
                staticValues: STATIC:Sim;S,Não;N
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: ATIVO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDFILIAL (
            type: selectList
            heading {
                heading: Franquia
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select f.nome
                         , f.idfilial 
                      from roman.vw_filiais f
                     where f.ativo = 'S'
                    ```
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDFILIAL
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDPARAMETROHIGIENIZACAO (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDPARAMETROHIGIENIZACAO
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: ROMAN.SEQ_IDPARAMETROHIGIENIZACAO
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column TEMPOMAXPAINEL (
            type: numberField
            heading {
                heading: Tempo Max. Painel (Dias)
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: TEMPOMAXPAINEL
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

    )

    process parâmetros-higienização-leads-save-interactive-grid-data (
        name: Parâmetros Higienização Leads - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @parâmetros-higienização-leads
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1795651034620152104
        }
    )

)

