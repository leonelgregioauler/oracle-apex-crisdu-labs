page 311 (
    name: Inventário de Estoque Favorita
    title: Inventário de Estoque Favorita
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region inventário-de-estoque-favorita (
        name: Inventário de Estoque Favorita
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        headerAndFooter {
            headerText: <font color="red"><h3>Cuidado ao confirmar o Inventário! Lembrando que é um processo irreversível!</h3></font>
        }
        settings {
            outputAs: text
        }
    )

    pageItem P311_DATAINVENTARIO (
        type: hidden
        layout {
            sequence: 60
            region: @inventário-de-estoque-favorita
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P311_IDESTOQUE (
        type: popupLov
        label {
            label: Produto
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeprodutoidestoque(e.idestoque) display_value
                     , e.idestoque return_value
                from estoques e
                where e.idfilialfavorita = :P311_IDFILIALFAVORITA
                order by 1
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 40
            region: @inventário-de-estoque-favorita
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P311_IDFILIALFAVORITA (
        type: selectList
        label {
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nomefilialfavorita d
                     , f.idfilialfavorita r
                from vw_filiaisfavorita f
                where f.idfilialfavorita = :P311_IDFILIALFAVORITA
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @inventário-de-estoque-favorita
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P311_IDINVENTARIOESTOQUE (
        type: hidden
        layout {
            sequence: 20
            region: @inventário-de-estoque-favorita
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P311_IDUSUARIO (
        type: hidden
        layout {
            sequence: 50
            region: @inventário-de-estoque-favorita
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P311_MD5 (
        type: hidden
        layout {
            sequence: 100
            region: @inventário-de-estoque-favorita
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P311_QUANTIDADEDISPONIVEL (
        type: numberField
        label {
            label: Disponivel
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 80
            region: @inventário-de-estoque-favorita
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 5
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P311_IDINVENTARIOESTOQUE
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P311_QUANTIDADEFISICO (
        type: numberField
        label {
            label: Físico
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 70
            region: @inventário-de-estoque-favorita
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 5
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P311_IDINVENTARIOESTOQUE
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P311_QUANTIDADERESERVADO (
        type: numberField
        label {
            label: Reservado
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 90
            region: @inventário-de-estoque-favorita
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 5
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P311_IDINVENTARIOESTOQUE
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    button confirmar (
        buttonName: CONFIRMAR
        label: Confirmar Inventário
        layout {
            sequence: 10
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Confirma a realização do inventário deste produto?','CONFIRMAR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P311_IDINVENTARIOESTOQUE
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Cadastrar
        layout {
            sequence: 20
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P311_IDINVENTARIOESTOQUE
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 30
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 173
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation valida-produto (
        name: Valida Produto
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P311_IDESTOQUE
        }
        error {
            errorMessage: É necessário informar o produto para realizar o inventário.
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process confirma-inventário (
        name: Confirma Inventário
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_auditoria_fav.prc_ajustaestoque(pidestoque => :P311_IDESTOQUE);
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Inventário Confirmado!
        }
        advanced {
            executionMappingIdentifier: 1405435196180756604
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMAR
        }
    )

    process consulta (
        name: Consulta
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  PCK_ESTOQUE_FAV.PRC_INVENTARIOSESTOQUES( PIDINVENTARIOESTOQUE => :P311_IDINVENTARIOESTOQUE,
                                                           PIDESTOQUE => :P311_IDESTOQUE,
                                                           PIDUSUARIO => :P311_IDUSUARIO,
                                                           PDATAINVENTARIO => :P311_DATAINVENTARIO,
                                                           PQUANTIDADEFISICO => :P311_QUANTIDADEFISICO,
                                                           PQUANTIDADEDISPONIVEL => :P311_QUANTIDADEDISPONIVEL,
                                                           PQUANTIDADERESERVADO => :P311_QUANTIDADERESERVADO,
                                                           PMD5 => :P311_MD5,
                                                           POPERACAO_DML => 'S');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 1405434959612756602
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P311_IDINVENTARIOESTOQUE
        }
    )

    process operação-dml-em-inventários-de-estoque (
        name: Operação DML em Inventários de Estoque
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  PCK_ESTOQUE_FAV.PRC_INVENTARIOSESTOQUES( PIDINVENTARIOESTOQUE => :P311_IDINVENTARIOESTOQUE,
                                                           PIDESTOQUE => :P311_IDESTOQUE,
                                                           PIDUSUARIO => :P0_IDUSUARIO,
                                                           PDATAINVENTARIO => :P311_DATAINVENTARIO,
                                                           PQUANTIDADEFISICO => :P311_QUANTIDADEFISICO,
                                                           PQUANTIDADEDISPONIVEL => :P311_QUANTIDADEDISPONIVEL,
                                                           PQUANTIDADERESERVADO => :P311_QUANTIDADERESERVADO,
                                                           PMD5 => :P311_D5,
                                                           POPERACAO_DML => 'I');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Inventário realizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1405426496871690214
        }
        serverSideCondition {
            type: request=Value
            value: SUBMIT
        }
    )

    branch (
        name: Go To Page 311
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 311
                items: {
                    P311_IDINVENTARIOESTOQUE: &P311_IDINVENTARIOESTOQUE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 173
            }
        }
    )

)

