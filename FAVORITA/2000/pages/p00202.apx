page 202 (
    name: Integração de Pedidos Favorita / Virtual Age
    title: Integração de Pedidos Favorita / Virtual Age
    appearance {
        pageTemplate: @imprimir
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
    )

    region integração-de-pedidos-favorita-virtual-age (
        name: Integração de Pedidos Favorita / Virtual Age
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                  cursor c1 is
                    select mi.dataintegracao
                         , mi.mensagemintegracaousuario
                         , pck_util_fav.fnc_nomeusuario(mi.idusuario) nomeusuario
                         , mi.idpedido
                         , p.idempresavirtualage
                         , p.idpedidovirtualage
                    from pedidos p
                       , mensagensintegracaovirtualage mi
                    where p.idpedido = mi.idpedido 
                    and mi.idpedido = :P202_IDPEDIDO
                    order by mi.dataintegracao desc;
                  --
                  r1 c1%rowtype;
                  --
                begin
                  --
                  htp.p('<style>');  
                  htp.p('th, td {');
                  htp.p('    padding: 10px;');
                  htp.p('}');
                  --
                  htp.p('table tr:nth-child(even) {');
                  htp.p('    background-color: #eee;');
                  htp.p('}');
                  htp.p('table tr:nth-child(odd) {');
                  htp.p('   background-color:#fff;');
                  htp.p('}');
                  htp.p('table th {');
                  htp.p('    background-color: gray;');
                  htp.p('    color: white;');
                  htp.p('}');
                  htp.p('</style>');
                  --
                  open c1;
                  fetch c1 into r1;
                    --
                    if r1.idpedidovirtualage is not null then
                      htp.p('<table style="width:100%">');
                      htp.p('<tr  align="center">');
                      htp.p('  <th><h4>Informações</h4></th>');
                      htp.p('</tr>');
                       
                      htp.p('<tr>');
                      htp.p('  <td align="center"><h3><font color="green">Pedido '|| r1.idpedido ||' integrado com sucesso ao Virtual Age. 
                                                     <br>Empresa no Virtual Age: '|| r1.idempresavirtualage ||'
                                            <br>Código do pedido no Virtual Age: '|| r1.idpedidovirtualage ||'</font></h3></td>');
                      htp.p('</tr>');
                      --
                      htp.p('</table>');
                      --
                    end if;
                    --
                  close c1;
                  --
                  htp.p('<table style="width:100%">');
                  htp.p('<tr  align="center">');
                  htp.p('  <th><h4>Data da Integração</h4></th>');
                  htp.p('  <th colspan=7><h4>Mensagem Integração</h4></th>');
                  htp.p('  <th><h4>Usuário</h4></th>');
                  htp.p('<br>');
                  htp.p('</tr>');
                  --
                  open c1;
                  loop
                    fetch c1 into r1;
                    exit when c1%notfound;
                      --
                      htp.p('<tr>');
                      htp.p('  <td align="center">'|| to_char(r1.dataintegracao, 'dd/mm/yyyy hh24:mi:ss') ||'</td>');
                      htp.p('  <td colspan=7>'|| r1.mensagemintegracaousuario ||'</td>');
                      htp.p('  <td align="center">'|| r1.nomeusuario ||'</td>');
                      --
                    end loop;
                  close c1;
                  --
                  htp.p('</tr>');
                  htp.p('</table>');
                  --
                end;
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P202_IDPEDIDO (
        type: numberField
        label {
            label: Idpedido
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

)

