        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: SETAPLP
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    process realizar-a-pré-postagem (
        name: Realizar a Pré-Postagem
        type: executeCode
