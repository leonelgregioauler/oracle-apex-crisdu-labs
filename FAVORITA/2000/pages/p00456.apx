    pageItem P456_IDPRELISTAPOSTAGEM (
        type: plugin/select
        label {
            label: Selecione a PLP
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct plp.numeroplp||'-'||plp.dataplp as d
                     , plp.idprelistapostagem as return_value
                from etiquetaspostagem ep
                   , prelistapostagem plp
                where ep.idprelistapostagem = plp.idprelistapostagem
                and ep.idfilialfavorita     = :P0_IDFILIALFAVORITA;
                ```
        }
        layout {
            sequence: 70
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
