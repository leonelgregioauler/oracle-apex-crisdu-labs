page 456 (
    name: Impressão Etiqueta Postagem Correios
    title: Impressão Etiqueta Postagem Correios
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pedidos-para-despachar-pelos-correios (
        name: Pedidos para Despachar pelos Correios
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select case 
                         when favorita.pck_util_fav.fnc_retornapedidowidecommerce(p.idpedido) is null then
                           '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||p.idpedido ,'SESSION')||''',''_blank''); void(0)">'||p.idpedido||'</a>' 
                         when favorita.pck_util_fav.fnc_retornapedidowidecommerce(p.idpedido) is not null then
                           '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':415:'||v('APP_SESSION')||'::NO::P415_IDPEDIDO:'||p.idpedido ,'SESSION')||''',''_blank''); void(0)">'||p.idpedido||'</a>' 
                       end idpedido
                     , case 
                         when ( select 1
                                from etiquetaspostagem 
                                where idpedido = p.idpedido ) is null then 
                           '<a href="javascript:apex.confirm(''Confirma a solicitação de etiqueta para este pedido ? '', 
                                                           { request:''SOLICITARETIQUETA'', set:{''P456_IDPEDIDO'':'||p.idpedido||' }} )";><img src="#APP_IMAGES#ok.png"  border="0"></a>' 
                         else ( select numeroetiquetacomdigitverific
                                from etiquetaspostagem 
                                where idpedido = p.idpedido ) 
                       end solicitaretiqueta
                     , nvl(( select to_char(numeroplp) 
                             from prelistapostagem  plp
                                , etiquetaspostagem e
                             where plp.idprelistapostagem = e.idprelistapostagem
                             and e.idpedido = p.idpedido ), 'PLP não gerada para os pedidos a seguir') numeroplp
                     , p.edicaorevista
                     , p.filialfavorita
                     , p.filialromance
                     , p.representante
                     , p.vendedora
                     , p.cpf
                     , p.situacaoentrega
                     , p.dataemissao
                     , p.dataentrega
                     , p.valortotal 
                     , p.valorfrete
                     , p.valorapagar
                     , p.valorpago
                     , p.saldodevedor
                     , p.idpedido idpedidoetiqueta
                from vw_pedidos_fav p
                   , atendimentosfiliaisrmc afr
                where p.idfilialromance = afr.idfilialdestino 
                and afr.idfilialfavoritaorigem = :P0_IDFILIALFAVORITA 
                and ( :P456_IDPRELISTAPOSTAGEM is null or nvl(( select e.idprelistapostagem 
                                                                from etiquetaspostagem e
                                                                where e.idpedido = p.idpedido ), 99999999) = :P456_IDPRELISTAPOSTAGEM )
                and exists ( select 1
                             from classificacoespedidos cp
                             where cp.idpedido = p.idpedido
                             and cp.idcaracteristicapedido = 13
                             and cp.idvalorcaracteristica  = 2 )
                and not exists ( select 1
                                 from classificacoespedidos c
                                 where c.idcaracteristicapedido = 25
                                   and c.idpedido               = p.idpedido )             
                and exists ( select 1
                             from pedidosremessasct pr
                             where pr.idpedido = p.idpedido
                             and pr.idcompratransferencia = :P456_IDCOMPRATRANSFERENCIA )
                --and ( (:P456_DATAINICIAL is null and :P456_DATAFINAL is null) or (trunc(dataemissao) between to_date(:P456_DATAINICIAL, 'dd/mm/rrrr') and to_date(:P456_DATAFINAL, 'dd/mm/rrrr')) )
                and p.idsituacaofinanceiro > 35000;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
