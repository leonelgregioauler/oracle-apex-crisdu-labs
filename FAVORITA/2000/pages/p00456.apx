    dynamicAction plp-obrigatória (
        name: PLP Obrigatória - 1
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @imprimirplp-resumida
        }
        clientSideCondition {
            type: itemIsNull
            item: P456_IDPRELISTAPOSTAGEM
        }

        action native-cancel-event (
            action: cancelEvent
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.message.alert('PLP deve ser informada');
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction plp-obrigatória-2 (
        name: PLP Obrigatória - 2
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @imprimirplp-detalhada
        }
        clientSideCondition {
            type: itemIsNull
            item: P456_IDPRELISTAPOSTAGEM
        }

        action native-cancel-event (
