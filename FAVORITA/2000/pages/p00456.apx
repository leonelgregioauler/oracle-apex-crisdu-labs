    pageItem P456_IDCOMPRATRANSFERENCIA (
        type: popupLov
        label {
            label: Remessa
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select numero||' - '|| pck_util_fav.fnc_retornatipocomptransrem(c.idtipocomptransrem,:P0_IDIDIOMA)
                             ||'('  ||decode(identificacaointerna,'N','Normal','A','Antecipada')
                             ||') - '||decode(analiseconcluida,'S','Concluida','Em Analise')
                             ||' - '||pck_util_fav.fnc_nomefilialfavorita(c.idfilialfavoritaorigem) display_value
                     , idcompratransferencia return_value
                from comprastransferencias c
                where c.idtipocomptransrem = 7 
                and c.idfilialfavoritaorigem = :P0_IDFILIALFAVORITA
                order by c.idcompratransferencia desc
                ```
        }
        cascadingLov {
            parentItems: [
                P0_IDFILIALFAVORITA
                P0_IDIDIOMA
            ]
            itemsToSubmit: [
                P0_IDFILIALFAVORITA
                P0_IDIDIOMA
            ]
        }
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

