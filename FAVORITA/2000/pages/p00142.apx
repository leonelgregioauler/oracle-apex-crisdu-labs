page 142 (
    name: Impressão Financeiro
    title: Impressão Financeiro
    appearance {
        pageTemplate: @minimal-pedido
        templateOptions: #DEFAULT#
    }
    security {
        authentication: public
        pageAccessProtection: unrestricted
    }

    region impressão-de-pedido (
        name: Impressão de Pedido
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin 
                  --
                  pck_comprastransf_fav.prc_imprimepedidosfinanceiro(pidcompratransferencia => :P142_IDCOMPRATRANSFERENCIA,
                                                                     pvolume => :P142_VOLUME,
                                                                     pididioma => :P0_IDIDIOMA,
                                                                     pordenacao => :P142_ORDENACAO,
                                                                     pidusuario => :P0_IDUSUARIO);
                  --
                  pck_comprastransf_fav.prc_limpareimpressoespedidos(pidusuario => :P0_IDUSUARIO);
                  --
                end;
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P142_IDCOMPRATRANSFERENCIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @impressão-de-pedido
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P142_ORDENACAO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @impressão-de-pedido
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P142_VOLUME (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @impressão-de-pedido
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

