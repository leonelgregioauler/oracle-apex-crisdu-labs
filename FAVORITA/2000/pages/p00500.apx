    dynamicAction abre-filtro (
        name: Abre Filtro
        execution {
            sequence: 20
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P500_FILTROAPLICADO is null
                  and :P0_NUMEROPOSICAOATENDIMENTO is not null
                ```
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: javascript: openModal('FILTRO');
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction selecionar-data (
        name: Selecionar data
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P500_DATA
        }
        clientSideCondition {
            type: item!=value
            item: P500_DATA
            value: N
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P500_DATAINI
                    P500_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P500_DATAINI
            }
            execution {
                sequence: 20
            }
        )

        action native-set-value (
            action: setValue
            affectedElements {
                selectionType: items
                items: [
                    P500_DATAINI
                    P500_DATAFIM
                ]
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P500_DATAINI
                    P500_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: Filtrar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 500
                items: {
                    P500_DATA: &P500_DATA.
                    P500_DATAINI: &P500_DATAINI.
                    P500_DATAFIM: &P500_DATAFIM.
                    P500_IDFILIALROMANCE: &P500_IDFILIALROMANCE.
                    P500_IDPOSTOAVANCADO: &P500_IDPOSTOAVANCADO.
                    P500_IDREPRESENTANTE: &P500_IDREPRESENTANTE.
                    P500_IDVENDEDORA: &P500_IDVENDEDORA.
                    P500_NRPEDIDO: &P500_NRPEDIDO.
                    P500_NRPROTOCOLO: &P500_NRPROTOCOLO.
                    P500_REMESSA: &P500_REMESSA.
                    P500_IDTAREFA: &P500_IDTAREFA.
                    P500_VLRTOTAL: &P500_VLRTOTAL.
                    P500_FORMAENTREGA: &P500_FORMAENTREGA.
                    P500_IDFILIALFAVORITA: &P500_IDFILIALFAVORITA.
                    P500_FILTROAPLICADO: S
                    P500_TIPOPEDIDO: &P500_TIPOPEDIDO.
                    P500_PA: &P500_PA.
                    P500_FUNCIONARIO: &P500_FUNCIONARIO.
                    P500_PROMISSORIARECEBIDA: &P500_PROMISSORIARECEBIDA.
                    P500_IDSITUACAOPROMISSORIA: &P500_IDSITUACAOPROMISSORIA.
                    P500_IDGERENTE: &P500_IDGERENTE.
                    P500_ATENDENTE: &P500_ATENDENTE.
                    P500_NAOENTREGUE: &P500_NAOENTREGUE.
                    P500_PAGOAODISTRIBUIDOR: &P500_PAGOAODISTRIBUIDOR.
                    P500_DISTRECEBEURESP: &P500_DISTRECEBEURESP.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

