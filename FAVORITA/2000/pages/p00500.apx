page 500 (
    name: Relatório de pedidos V2
    title: Relatório de pedidos V2
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-size720x480
            ]
        }
        advanced {
            htmlDomId: FILTRO
            regionDisplaySelector: true
        }
    )

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pedidos-descontinuado (
        name: Pedidos - Descontinuado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select case 
                         when pck_util_fav.fnc_retornapedidowidecommerce(idpedido) is null then
                           '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||p.idpedido ,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt=""></a>'
                         when pck_util_fav.fnc_retornapedidowidecommerce(idpedido) is not null then
                           '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':415:'||v('APP_SESSION')||'::NO::P415_IDPEDIDO:'||p.idpedido ,'ESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt=""></a>'
                       end consultar
                     , idpedido
                     , idedicaorevista
                     , edicaorevista
                     , idfilialfavorita
                     , filialfavorita
                     , idfilialromance
                     , filialromance
                     , idgerente
                     , gerente
                     , idrepresentante
                     , representante
                     , idvendedora
                     , vendedora
                     , cpf
                     , idusuario
                     , nomeusuario
                     , idsituacaoentrega
                     , situacaoentrega
                     , idsituacaocobranca 
                     , situacaocobranca
                     , idsituacaofinanceiro
                     , situacaofinanceiro
                     , numeropedido
                     , dataemissao
                     , dataentrega
                     , datadespacho
                     , datacancelamento
                     , numeroposicaoatendimento
                     , idpedidooriginal
                     , rastreiotransporte
                     , valortotalcusto
                     , valortotal
                     , valorpontoutilizado
                     , valordesconto
                     , valortotalcomdesconto
                     , valorfrete
                     , valorapagar
                     , observacoessite
                     , idtarefa
                     , situacaoentregainterno
                     , situacaocobrancainterno
                     , situacaofinanceirointerno
                     , emespera
                     , datavencimento
                     , saldodevedor
                     , saldodevedorromance
                     , regiaocliente
                     , situacaocliente
                     , pedidocancelado
                     , decode(p.tipopedido,'P','Pedido'
                                          ,'T','Troca'
                                          ,'V','Venda Direta' ) tipopedido
                     , valorpago
                     , comissaodistribpaga
                     , comissaogerentepaga
                     , p.situacaopagamento
                     , nvl2( ( select 1
                              from favorita.classificacoespedidos c
                              where c.idpedido = p.idpedido
                                and c.idcaracteristicapedido = 2),'Sim','Não' ) PedidoDistribuidor
                     , pedidonaoentregue
                     , pagoaodistribuidor
                     , distribuidorrecebeuresp
                     , ( select datanascimento
                         from pessoas pp
                         where pp.idpessoa = p.idpessoa ) datanascimento
                     , ( select c.idvalorcaracteristica
                         from classificacoespedidos c
                         where c.idclassificacaopedido = ( select max(cc.idclassificacaopedido)
                                                           from classificacoespedidos cc
                                                           where cc.idpedido = p.idpedido
                                                             and cc.idcaracteristicapedido = 11 ) ) nrpedidos  
                     , nvl(( select 'Sim' 
                             from dual
                             where exists ( select 1 
                                           from roman.notasvendas n
                                           where n.idvendedora = p.idvendedora
                                             and n.idsituacaonotavenda = 4
                                             and n.saldo > 0 )),'Não') possuidebito
                     , nvl(( select 'Sim' 
                             from dual
                             where exists ( select 1 
                                           from roman.notasvendas n
                                           where n.idvendedora = p.idvendedora
                                             and n.idsituacaonotavenda = 4
                                             and n.enviadocobranca = 'S'
                                             and n.saldo > 0 )),'Não') enviadocobranca 
                     , p.formapagamento  
                     , ( select pp.documentoestrangeiro
                         from pessoas pp
                     where pp.idpessoa = p.idpessoa) documentoestrangeiro
                from vw_pedidos_fav_67 p
                where ididioma  = :P0_IDIDIOMA
                  --and p.idsituacaoentrega >= 20000
                  and :P500_OPCAO = 'P'
                  and ( :P500_DATA = 'N' or ( :P500_DATA = 'E' and p.dataemissao between to_date(:P500_DATAINI||' 00:00:00','dd/mm/rrrr hh24:mi:ss') and to_date(:P500_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss') )
                                        or ( :P500_DATA = 'T' and p.dataentrega between to_date(:P500_DATAINI||' 00:00:00','dd/mm/rrrr hh24:mi:ss') and to_date(:P500_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss') )
                                        or ( :P500_DATA = 'V' and exists ( select 1
                                                                          from vencimentospedidos vp
                                                                          where vp.idpedido = p.idpedido
                                                                            and vp.situacaovencimento = 'V'
                                                                            and vp.datavencimento between to_date(:P500_DATAINI||' 00:00:00','dd/mm/rrrr hh24:mi:ss') and to_date(:P500_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss') ) ) )
                  and ( :P500_IDFILIALROMANCE is null or p.idfilialromance = :P500_IDFILIALROMANCE )
                  and ( ( :P500_VISUALIZARTODOS = 'S' 
                           and :P500_IDFILIALROMANCE is null or p.idfilialromance = :P500_IDFILIALROMANCE )  
                        or ((( select nvl(u.atendenteloja,'N') 
                               from usuarios u   
                               where idusuario =  :P0_IDUSUARIO ) = 'S' and roman.pck_romance.fnc_filialusuario(v('APP_USER')) = p.idfilialromance)
                               or (( select nvl(u.atendenteloja,'N')
                                     from usuarios u   
                                     /*where idusuario = :P0_IDUSUARIO ) != 'S' and to_char(p.idfilialromance) in (( select case
                                                                                                                               when count(afr.idfilialdestino) > 1 then  
                                                                                                                                 '(' || listagg(afr.idfilialdestino,',') within group (order by 1 desc) ||')' 
                                                                                                                               when count(afr.idfilialdestino) < = 1 then  
                                                                                                                                 listagg(afr.idfilialdestino,'') within group (order by 1 desc)
                                                                                                                                end idfilialdestino */
                                     where idusuario = :P0_IDUSUARIO ) != 'S' and p.idfilialromance in (( select afr.idfilialdestino
                                                                                                                   from atendimentosfiliaisrmc afr
                                                                                                                   where afr.idfilialfavoritaorigem = pck_util_fav.fnc_retornaidfilialfavusuario(pck_util_fav.fnc_idusuario(v('APP_USER')) ) )) )))  
                  and (:P500_IDFILIALFAVORITA is null or p.idfilialfavorita = :P500_IDFILIALFAVORITA )
                  and (:P500_IDREPRESENTANTE is null or p.idrepresentante = :P500_IDREPRESENTANTE )
                  and (:P500_IDVENDEDORA is null or p.idvendedora = :P500_IDVENDEDORA ) 
                  and (:P500_NRPEDIDO is null or p.numeropedido like '%'||trim(:P500_NRPEDIDO)||'%' )
                  and (:P500_NRPEDIDOWIDECOMMERCE is null or p.idpedidowidecommerce like '%'||trim(:P500_NRPEDIDOWIDECOMMERCE)||'%')
                  and (:P500_ENVIARCORREIO is null or p.valorfrete > 0 )
                  and (:P500_FILTROAPLICADO is not null)
                  and (:P500_REMESSA is null or exists ( select 1
                                                        from pedidosremessasct pr
                                                        where pr.idpedido = p.idpedido
                                                          and pr.idcompratransferencia = :P500_REMESSA ))
                  and (:P500_IDPOSTOAVANCADO is null or ( exists ( select 1 from representantes r where r.idrepresentante = p.idrepresentante and r.idpostoavancado = :P500_IDPOSTOAVANCADO) ) )
                  and (:P500_IDTAREFA is null or p.idtarefa = :P500_IDTAREFA)
                  and (:P500_VLRTOTAL is null or p.valorapagar between :P500_VLRTOTAL - 10 and :P500_VLRTOTAL + 10)
                  and (:P500_TIPOPEDIDO is null or p.tipopedido = :P500_TIPOPEDIDO )
                  and (:P500_PA is null or p.numeroposicaoatendimento = :P500_PA )
                  and (:P500_EMESPERA is null or p.emespera = 'Sim')
                  and (:P500_PROSPECCAO = 0 or  (:P500_PROSPECCAO = 1 and exists ( select 1
                                                                                 from classificacoespedidos c
                                                                                 where c.idpedido = p.idpedido
                                                                                   and c.idcaracteristicapedido = 74))
                                             or  (:P500_PROSPECCAO = 2 and not exists ( select 1
                                                                                       from classificacoespedidos c
                                                                                       where c.idpedido = p.idpedido
                                                                                         and c.idcaracteristicapedido = 74)))
                  and (:P500_PEDIDOCANCELADO is null or p.pedidocancelado = 'Sim')
                  and (:P500_FUNCIONARIO is null or p.pedidofuncionario = 'Sim')
                  and (:P500_NAOENTREGUE is null or p.pedidonaoentregue = 'Sim')
                  and (:P500_PAGOAODISTRIBUIDOR is null or p.pagoaodistribuidor = 'Sim')
                  and (:P500_DISRECEBEURESP is null or p.distribuidorrecebeuresp = 'Sim')
                  and (:P500_ATENDENTE is null or p.idusuario = :P500_ATENDENTE )
                  and (:P500_IDGERENTE is null or exists ( select 1
                                                          from vendedoras v
                                                          where v.idvendedora = p.idvendedora
                                                            and v.idpessoa    = ( select idpessoa 
                                                                                  from catal.funcionarios f
                                                                                  where f.idgerente = :P500_IDGERENTE
                                                                                    and f.idpessoa  = v.idpessoa ) ) )
                  and (:P500_PROMISSORIARECEBIDA is null or exists ( select 1
                                                                    from classificacoespedidos c
                                                                    where c.idpedido = p.idpedido
                                                                      and c.idcaracteristicapedido = 15 ))
                  and (:P500_IDSITUACAOPROMISSORIA is null or exists ( select 1
                                                                      from classificacoespedidos c
                                                                      where c.idpedido = p.idpedido
                                                                        and c.idcaracteristicapedido = 16
                                                                        and c.idvalorcaracteristica = :P500_IDSITUACAOPROMISSORIA ))
                
                  
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P500_OPCAO
            value: P
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 6607563238292538965
        }

