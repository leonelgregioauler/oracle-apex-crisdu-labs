    region vencimentos-de-pedidos (
        name: Vencimentos de Pedidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.IDVENCIMENTOPEDIDO
                     , v.idpedido
                     , v.datavencimento
                     , p.vendedora
                     , v.valorpagar
                     , v.valorpago
                     , v.saldo
                     , v.idtarefa
                     , v.situacaovencimento
                     , v.codsituacaovencimento
                     , null efetuarpagamento
                from vw_vencimentospedidos_fav v
                   , vw_pedidos_fav            p
                where p.idpedido = v.idpedido
                  and p.ididioma = :P0_IDIDIOMA
                  and :P500_OPCAO = 'V'
                  and ( :P500_DTINI is null  or ( :P500_DATA = 'E' and trunc(p.dataemissao) between to_date(:P500_DATAINI,'dd/mm/rrrr') and to_date(:P500_DATAFIM,'dd/mm/rrrr') )
                                            or ( :P500_DATA = 'T' and trunc(p.dataentrega) between to_date(:P500_DATAINI,'dd/mm/rrrr') and to_date(:P500_DATAFIM,'dd/mm/rrrr') )
                                            or ( :P500_DATA = 'V' and exists ( select 1
                                                                              from vencimentospedidos vp
                                                                              where vp.idpedido = p.idpedido
                                                                                and vp.situacaovencimento = 'V'
                                                                                and vp.datavencimento between to_date(:P500_DATAINI,'dd/mm/rrrr') and to_date(:P500_DATAFIM,'dd/mm/rrrr') ) ) )
                  and (:P500_IDFILIALROMANCE is null or p.idfilialromance = :P500_IDFILIALROMANCE )
                  and (:P500_IDFILIALFAVORITA is null or p.idfilialfavorita = :P500_IDFILIALFAVORITA )
                  and (:P500_IDREPRESENTANTE is null or p.idrepresentante = :P500_IDREPRESENTANTE )
                  and (:P500_IDVENDEDORA is null or p.idvendedora = :P500_IDVENDEDORA ) 
                  and (:P500_NRPEDIDO is null or p.numeropedido like '%'||trim(:P500_NRPEDIDO)||'%' )
                  and (:P500_FORMAENTREGA is null or ( select cp.idvalorcaracteristica
                                                      from favorita.classificacoespedidos cp
                                                      where cp.idpedido = p.idpedido 
                                                        and cp.idcaracteristicapedido = 13) = :P500_FORMAENTREGA )
                  and (:P500_FILTROAPLICADO is not null)
                 -- and (:P500_REMESSA is null or p.remessa = :P500_REMESSA)
                 -- and (:P500_VOLUME is null or p.volume = :P500_VOLUME)
                  and (:P500_IDPOSTOAVANCADO is null or ( exists ( select 1 from representantes r where r.idrepresentante = p.idrepresentante and r.idpostoavancado = :P500_IDPOSTOAVANCADO) ) )
                  and (:P500_IDTAREFA is null or p.idtarefa = :P500_IDTAREFA)
                  and (:P500_VLRTOTAL is null or p.valorapagar between :P500_VLRTOTAL - 10 and :P500_VLRTOTAL + 10)
                  and (:P500_TIPOPEDIDO is null or p.tipopedido = :P500_TIPOPEDIDO )
                  /*AND ( :P500_DATAINI is not null
                      or :P500_IDFILIALROMANCE is not null 
                      or :P500_IDREPRESENTANTE is not null 
                      or :P500_IDVENDEDORA is not null
                      or :P500_NRPEDIDO is not null
                      or :P500_NRPROTOCOLO is not null 
                      or :P500_IDTAREFA is not null 
                      or :P500_IDPOSTOAVANCADO is not null
                    --  or :P500_REMESSA is not null
                    --  or :P500_VOLUME is not null
                      or :P500_ORIGEM is not null
                      or :P500_VLRTOTAL is not null)*/
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P500_OPCAO
            value: V
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 6638348830487600827
        }

