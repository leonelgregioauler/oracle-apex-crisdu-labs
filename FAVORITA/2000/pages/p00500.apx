                rowsPerPage: 50
            }

            displayColumn DATAVENCIMENTO (
                sequence: 4
            )

            displayColumn EFETUARPAGAMENTO (
                sequence: 8
            )

            displayColumn IDPEDIDO (
                sequence: 2
            )

            displayColumn IDTAREFA (
                sequence: 9
            )

            displayColumn IDVENCIMENTOPEDIDO (
                sequence: 1
            )

            displayColumn SALDO (
                sequence: 7
            )

            displayColumn SITUACAOVENCIMENTO (
                sequence: 10
            )

            displayColumn VALORPAGAR (
                sequence: 5
            )

            displayColumn VALORPAGO (
                sequence: 6
            )

            displayColumn VENDEDORA (
                sequence: 3
            )

            filter ir-condition (
                column: SITUACAOVENCIMENTO
                value: Válido
            )

        )

    )

    pageItem P500_ATENDENTE (
        type: selectList
        label {
            label: Atendente
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeusuario(u.idusuario) display_value
                     , u.idusuario return_value
                from usuarios u
                where exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.usuario = u.usuario 
                                 and ug.idgrupoatendimento in ( select ga.idgrupoatendimento
                                                                from roman.usuariosgruposatendimento ga
                                                                where ga.usuario = ( select usuario
                                                                                     from usuarios
                                                                                     where idusuario = :P0_IDUSUARIO ) ) )
                order by 1
                ```
            nullDisplayValue: - Selecione a Atendente -
        }
        layout {
            sequence: 180
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

