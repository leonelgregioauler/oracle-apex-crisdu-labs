    region pedidos-novo (
        name: Pedidos Novo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select * from table(pck_relatorios_fav2.fnc_listapedidos (  popcao                   => :P500_OPCAO,
                                                                           pidpedido                => :P500_NRPEDIDO,
                                                                           pidfilialfavorita        => :P500_IDFILIALFAVORITA,
                                                                           pidfilialromance         => :P500_IDFILIALROMANCE,
                                                                           pidrepresentante         => :P500_IDREPRESENTANTE,
                                                                           pidvendedora             => :P500_IDVENDEDORA,
                                                                           pidpedidowidecomm        => :P500_NRPEDIDOWIDECOMMERCE, 
                                                                           pdata                    => :P500_DATA,
                                                                           pdatainicial             => :P500_DATAINI,
                                                                           pdatafinal               => :P500_DATAFIM,
                                                                           pformaentrega            => :P500_FORMAENTREGA,
                                                                           pfiltroaplicado          => :P500_FILTROAPLICADO,
                                                                           premessa                 => :P500_REMESSA,
                                                                           pidpostoavancado         => :P500_IDPOSTOAVANCADO,
                                                                           pidtarefa                => :P500_IDTAREFA,
                                                                           pvalortotal              => :P500_VLRTOTAL,
                                                                           ptipopedido              => :P500_TIPOPEDIDO,
                                                                           ppa                      => :P500_PA,
                                                                           pemespera                => :P500_EMESPERA,
                                                                           pprospeccao              => :P500_PROSPECCAO,
                                                                           ppedidocancelado         => :P500_PEDIDOCANCELADO,
                                                                           pfuncionario             => :P500_FUNCIONARIO,
                                                                           pnaoentregue             => :P500_NAOENTREGUE,
                                                                           ppagoaodistribuidor      => :P500_PAGOAODISTRIBUIDOR,
                                                                           pdistribuidorrecebeuresp => :P500_DISRECEBEURESP,
                                                                           patendente               => :P500_ATENDENTE,
                                                                           pidgerente               => :P500_IDGERENTE,
                                                                           ppromissoriarecebida     => :P500_PROMISSORIARECEBIDA,
                                                                           pidsituacaopromissoria   => :P500_IDSITUACAOPROMISSORIA,
                                                                           pidusuario               => :P0_IDUSUARIO ));
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P500_OPCAO
            value: PP
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 5096313550447392804
        }

