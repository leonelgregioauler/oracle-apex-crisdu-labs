    button novopedido (
        buttonName: NOVOPEDIDO
        label: Novo Pedido
        layout {
            sequence: 20
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 80
                items: {
                    P80_IDVENDEDORA:
                    P80_IDPEDIDO:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P0_NUMEROPOSICAOATENDIMENTO
        }
    )

