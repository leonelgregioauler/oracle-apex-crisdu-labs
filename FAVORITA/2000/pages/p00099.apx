    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 40
            region: @new
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P99_IDHISTORICOPEDIDO is not null
                  and :P99_PAGINA in (68, 415)
                ```
        }
    )

    button cancelar (
        buttonName: CANCELAR
        label: Cancelar
        layout {
            sequence: 30
            region: @new
            slot: previous
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Deseja realmente cancelar o pedido?','CANCELAR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    button deletar (
        buttonName: DELETAR
        label: Excluir Histórico
        layout {
            sequence: 20
            region: @new
            slot: previous
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETAR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util_fav.fnc_verificaacesso(28316,:P0_IDUSUARIO) = 'S'
                  and :P99_IDHISTORICOPEDIDO is not null
                  
                /*declare
                  videdicaorevista number;
                begin
                  select idedicaorevista
                  into videdicaorevista
                  from pedidos
                  where idpedido = :P99_IDPEDIDO;
                  --
                  if videdicaorevista is null then
                    return true;
                  elsif videdicaorevista is not null then
                    return false;
                  end if;
                  --
                end;*/
                ```
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 50
            region: @new
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P99_IDHISTORICOPEDIDO is null
                  and :P99_PAGINA in (68,415,130)
                ```
        }
    )

    button proximo (
        buttonName: PROXIMO
        label: Próximo Passo
        layout {
            sequence: 70
            region: @new
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
            ]
        }
        behavior {
            action: definedByDynamicAction
            executeValidations: false
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P99_PAGINA not in (68,415,130)
                ```
        }
    )

    button proximopedidopontos (
        buttonName: PROXIMOPEDIDOPONTOS
        label: Pedido de Pontos
        layout {
            sequence: 60
            region: @new
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
            executeValidations: false
        }
        serverSideCondition {
            type: never
        }
    )

    dynamicAction confirma-cancelamento (
        name: Confirma cancelamento
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P99_CANCELARPEDIDO
        }
        clientSideCondition {
            type: item=value
            item: P99_CANCELARPEDIDO
            value: S
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: javascript:apex.confirm('Deseja cancelar o pedido?','');
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction processa-e-chama-site (
        name: Processa e chama site
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @proximo
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: PROXIMO
                showProcessing: false
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction processa-e-chama-site-pedido-pontos (
        name: Processa e chama site Pedido Pontos
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @proximopedidopontos
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: PROXIMOPEDIDOPONTOS
                showProcessing: false
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction tela-de-aguarde-para-incluir-histórico (
        name: Tela de aguarde para Incluir Histórico
        execution {
            sequence: 50
        }
        when {
            event: click
            selectionType: button
            button: @inserir
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: javascript: ExibeAguarde();
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: INSERIR
                showProcessing: false
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction valida-se-pode-editar-pedido (
        name: Valida se pode editar pedido.
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @inserir
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: pck_movimentarpedidos_fav.fnc_podeeditarpedido(pidpedido => :P99_IDPEDIDO) = 'N' and :P99_LIBERAEDICAO = 'S'
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.message.alert('Este pedido não pode mais ser alterado.');
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation valida-cancelamento (
        name: Valida cancelamento
        execution {
            sequence: 30
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select v.*
                from vencimentospedidos v
                where v.idpedido           = :P99_IDPEDIDO
                 and v.situacaovencimento = 'V' 
                 and v.valorpago          > 0
                ```
        }
        error {
            errorMessage: Pedido não pode ser cancelado pois já está pago!
        }
        serverSideCondition {
            whenButtonPressed: @cancelar
            type: never
        }
    )

    validation valida-descrição (
        name: Valida descrição
        execution {
            sequence: 20
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where length(:P99_DESCRICAO_INTERNA) > 20
                ```
        }
        error {
            errorMessage: Informe uma descrição sucinta para poder editar o pedido.
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P99_LIBERAEDICAO = 'S'
                  or v('REQUEST') ='CANCELAR'
                ```
        }
    )

    validation valida-liberação-de-pedido-quitado (
        name: "Valida Liberação de Pedido Quitado "
        execution {
            sequence: 40
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from pedidos p
                   , vencimentospedidos v
                   , pagamentospedidos pg
                where v.idpedido = p.idpedido 
                  and pg.idvencimentopedido = v.idvencimentopedido
                  and pg.idsituacao         = 20
                  and v.situacaovencimento  = 'V'
                  and p.idpedido            = :P99_IDPEDIDO
                  and v.valorpagar          = v.valorpago
                  and v.valorpagar          > 0
                ```
        }
        error {
            errorMessage: Não é possível editar um pedido que esteja quitado!
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P99_LIBERAEDICAO = 'S' and v('REQUEST') in ('INSERIR','ATUALIZAR')
        }
    )

