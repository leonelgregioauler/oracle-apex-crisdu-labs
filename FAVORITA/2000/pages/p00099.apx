page 99 (
    name: Histórico Pedido
    title: Histórico Pedido
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        authentication: public
        pageAccessProtection: unrestricted
    }

    region históricos (
        name: Históricos
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            footerText:
                ```html
                <script language="javascript">
                function iniciapedido (IDPEDIDO,IDUSUARIO,IDREPRESENTANTE)
                {
                    if( IDREPRESENTANTE != '') 
                      {
                        window.open('http://webservices.romancemoda.com.br:93/executar/callcenter/iniciar?str={"IDPEDIDO":'+IDPEDIDO+',"IDUSUARIO":'+IDUSUARIO+',"IDREPRESENTANTE":'+IDREPRESENTANTE+'}');
                      }  
                    else
                      {
                        window.open('http://webservices.romancemoda.com.br:93/executar/callcenter/iniciar?str={"IDPEDIDO":'+IDPEDIDO+',"IDUSUARIO":'+IDUSUARIO+'}');
                      }  
                }
                </script>
                ```
        }
        settings {
            outputAs: text
        }
    )

    region históricos-incluídos (
        name: Históricos Incluídos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.IDHISTORICOPEDIDO
                     , v.IDPEDIDO
                     , v.DATAHISTORICO
                     , v.IDUSUARIO
                     , pck_util_fav.fnc_nomeusuario(v.IDUSUARIO) nomeusuario
                     , v.DESCRICAO
                     , decode(v.IMPRIMIRNOPEDIDO,'S','Sim','N','Não') imprimir
                from vw_historicospedidos_fav v
                where v.IDPEDIDO = :P99_IDPEDIDO
                order by 1 desc
                ```
            pageItemsToSubmit: P99_IDPEDIDO
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from historicospedidos 
                where idpedido = :P99_IDPEDIDO
                  and :P99_PAGINA in (68, 415, 130)
                ```
        }
        link {
            linkColumn: customTarget
            target: {
                page: 99
                items: {
                    P99_IDHISTORICOPEDIDO: #IDHISTORICOPEDIDO#
                    P99_IDPEDIDO: #IDPEDIDO#
                }
                action: resetPagination
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            conditionType: rowsReturned
            sqlQuery:
                ```sql
                select * 
                from dual 
                where pck_util_fav.fnc_verificaacesso(28317,:P0_IDUSUARIO) = 'S'
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum Histórico Encontrado!
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 14054644009641937
        }

        column DATAHISTORICO (
            type: plainText
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column DESCRICAO (
            type: plainText
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column IDHISTORICOPEDIDO (
            type: hidden
            heading {
                heading: Idhistoricopedido
            }
            layout {
                sequence: 10
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDPEDIDO (
            type: hidden
            heading {
                heading: Idpedido
            }
            layout {
                sequence: 20
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDUSUARIO (
            type: hidden
            heading {
                heading: Idusuario
            }
            layout {
                sequence: 40
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IMPRIMIR (
            type: plainText
            heading {
                heading: Imprimir
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column NOMEUSUARIO (
            type: plainText
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        savedReport 141470 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAHISTORICO (
                sequence: 3
            )

            displayColumn DESCRICAO (
                sequence: 6
            )

            displayColumn IDHISTORICOPEDIDO (
                sequence: 1
            )

            displayColumn IDPEDIDO (
                sequence: 2
            )

            displayColumn IDUSUARIO (
                sequence: 4
            )

            displayColumn IMPRIMIR (
                sequence: 7
            )

            displayColumn NOMEUSUARIO (
                sequence: 5
            )

        )

    )

    region new (
