    pageItem P99_DESCRICAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        settings {
            charCounter: true
        }
        layout {
            sequence: 60
            region: @históricos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
            height: 5
        }
        validation {
            maxLength: 1000
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P99_IDHISTORICOPEDIDO
        }
        readOnly {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from historicospedidos h
                where ( h.idhistoricopedido = :P99_IDHISTORICOPEDIDO
                    and pck_util_fav.fnc_verificaacesso(28317,:P0_IDUSUARIO) = 'N' 
                     or h.idusuario         = :P0_IDUSUARIO )
                   or ( select idedicaorevista
                        from pedidos 
                        where idpedido = :P99_IDPEDIDO  ) is null
                   
                ```
        }
        security {
            encryptSessionState: false
        }
    )

