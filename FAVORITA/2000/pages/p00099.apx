    pageItem P99_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 150
            region: @históricos
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select p.idrepresentante
                from pedidos p
                where p.idpedido = :P99_IDPEDIDO
                  and exists ( select 1
                               from classificacoespedidos c
                               where c.idpedido = p.idpedido
                                 and c.idcaracteristicapedido = 2 )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

