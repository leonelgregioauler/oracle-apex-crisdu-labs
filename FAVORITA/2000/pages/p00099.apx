    process dml (
        name: DML
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidiniciaprepedido              number := :P99_IDPEDIDO;
                  vidpedido                       number := null;
                  --
                  voperacao_dml varchar2(1);
                  --
                  vmd5 varchar2(1000);
                  --
                begin
                  --
                  if (:P99_PAGINA = 68) or (:P99_PAGINA = 130) or (:P99_PAGINA = 415) then
                    vidpedido := :P99_IDPEDIDO;
                  end if;
                  --
                  if  ( v('REQUEST') = 'INSERIR' 
                    or v('REQUEST') = 'PROXIMO' 
                    or v('REQUEST') = 'PROXIMOPEDIDOPONTOS'
                    or v('REQUEST') = 'CANCELAR' )  then
                    --
                    voperacao_dml := 'I';
                    --
                    if :P99_DESCRICAO_INTERNA is not null then
                      :P99_IMPRIMIRNOPEDIDO := 'N';
                    end if;
                    --
                    pck_pedidos_fav.prc_iniciaprehistoricos ( vidiniciaprepedido
                                                            , vidpedido
                                                            , :P0_IDUSUARIO
                                                            , :P99_IDHISTORICOPEDIDO
                                                            , :P99_DATAHISTORICO
                                                            , :P99_DESCRICAO_INTERNA
                                                            , :P99_IMPRIMIRNOPEDIDO
                                                            , :P99_LIBERAEDICAO
                                                            , voperacao_dml ); 
                    --
                    if :P99_DESCRICAO_IMPRESSAO is not null then
                       :P99_IMPRIMIRNOPEDIDO := 'S';
                    end if;
                    --
                    pck_pedidos_fav.prc_iniciaprehistoricos ( vidiniciaprepedido
                                                            , vidpedido
                                                            , :P0_IDUSUARIO
                                                            , :P99_IDHISTORICOPEDIDO
                                                            , :P99_DATAHISTORICO
                                                            , :P99_DESCRICAO_IMPRESSAO
                                                            , :P99_IMPRIMIRNOPEDIDO
                                                            , :P99_LIBERAEDICAO
                                                            , voperacao_dml ); 
                    --
                    if :P99_PAGINA = 98 then
                      --
                      if :P0_AMBIENTEWIDECOMMERCE = 'N' or v('REQUEST') = 'PROXIMOPEDIDOPONTOS' then
                        pck_pedidos_fav.prc_iniciapedido ( :P99_IDPEDIDO
                                                          , voperacao_dml  );
                      elsif :P0_AMBIENTEWIDECOMMERCE = 'S' and v('REQUEST') != 'PROXIMOPEDIDOPONTOS' then
                        pck_integracao_fav_widecomm.prc_iniciapedido ( :P99_IDPEDIDO
                                                                      , voperacao_dml );
                      end if;
                      --
                    end if;
                  
                  end if;
                  --
                  if v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                    if :P99_DESCRICAO is not null then
                       --
                       /*pck_pedidos_fav.prc_iniciaprehistoricos (  vidiniciaprepedido
                                                                , vidpedido
                                                                , :P0_IDUSUARIO
                                                                , :P99_IDHISTORICOPEDIDO
                                                                , :P99_DATAHISTORICO
                                                                , :P99_DESCRICAO
                                                                , :P99_IMPRIMIRNOPEDIDO
                                                                , :P99_LIBERAEDICAO
                                                                , voperacao_dml ); */
                       --
                       pck_pedidos_fav.prc_historicospedidos(pidhistoricopedido => :P99_IDHISTORICOPEDIDO,
                                                        pidpedido => :vidpedido,
                                                        pdatahistorico => :P99_DATAHISTORICO,
                                                        pidusuario => :P0_IDUSUARIO,
                                                        pdescricao => :P99_DESCRICAO,
                                                        pimprimirnopedido => :P99_IMPRIMIRNOPEDIDO,
                                                        pliberaedicao => :P99_LIBERAEDICAO,
                                                        pmd5 => vmd5,
                                                        poperacao_dml => voperacao_dml);
                       --
                    end if;
                  --
                  end if;
                  --
                  if v('REQUEST') = 'DELETAR' then
                    --
                    voperacao_dml := 'D';
                    --
                    pck_pedidos_fav.prc_iniciaprehistoricos ( vidiniciaprepedido
                                                            , vidpedido
                                                            , :P0_IDUSUARIO
                                                            , :P99_IDHISTORICOPEDIDO
                                                            , :P99_DATAHISTORICO
                                                            , :P99_DESCRICAO
                                                            , :P99_IMPRIMIRNOPEDIDO
                                                            , :P99_LIBERAEDICAO
                                                            , voperacao_dml ); 
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 13873130746620910
        }
    )

    process inseri-caracteristica (
        name: inseri caracteristica
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  vid_usuario_pedido number;
                  vid_usuario_sessao number  := :P0_IDUSUARIO;
                  vtipo_filial char(1);
                  --
                begin
                  --
                  select pe.idusuario
                  into vid_usuario_pedido
                  from pedidos pe
                  where pe.idpedido = :P99_IDPEDIDO;
                  --
                  select f.tipofilial
                  into vtipo_filial
                  from filiaisfavorita f
                  where f.idfilialfavorita = :P0_IDFILIALFAVORITA;
                  --
                  if vid_usuario_pedido != vid_usuario_sessao and vtipo_filial = 'L' then
                    --
                    insert into classificacoespedidos(idclassificacaopedido,
                                                      idpedido,
                                                      dataclassificado,
                                                      idusuario,
                                                      idcaracteristicapedido,
                                                      idvalorcaracteristica,
                                                      observacao)
                    values(seq_idclassificacaopedido.nextval,
                                                       :P99_IDPEDIDO,
                                                       sysdate,
                                                       vid_usuario_sessao,
                                                       81,
                                                       vid_usuario_sessao,
                                                       'Usuário que digitou o pedido no sistema.');
                    --
                  end if;
                  --
                exception
                  when others then
                    null;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 52116526303424739
        }
        serverSideCondition {
            type: request=Value
            value: PROXIMO
        }
    )

    process inseri-caracteristica-pontos (
