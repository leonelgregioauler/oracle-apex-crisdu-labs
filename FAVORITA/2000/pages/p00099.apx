                                                   , idusuario
                                                   , idcaracteristicapedido
                                                   , idvalorcaracteristica
                                                   , observacao)
                  values( seq_idclassificacaopedido.nextval
                        , :P99_IDPEDIDO
                        , sysdate
                        , vid_usuario_pedido
                        , 5
                        , vidvalorcaracteristica
                        , 'Pedido de Pontos');
                  --
                end;
