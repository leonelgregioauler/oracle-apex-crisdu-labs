page 603 (
    name: Cadastro/Edição de Taxa Delivery
    title: Cadastro/Edição  de Taxa Delivery
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"CONFIRMA EXCLUSÃO DA TAXA?"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region taxa-delivery (
        name: Taxa Delivery
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P603_DATAFIM (
        type: datePickerJquery
        label {
            label: Data Fim:
            alignment: left
        }
        layout {
            sequence: 40
            region: @taxa-delivery
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: DATAFIM
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P603_DATAINICIO (
        type: datePickerJquery
        label {
            label: Data Inicio:
            alignment: left
        }
        layout {
            sequence: 30
            region: @taxa-delivery
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: DATAINICIO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P603_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Filiais Favorita:
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomefilialfavorita(f.idfilialfavorita) as d
                     , f.idfilialfavorita as r
                  from favorita.filiaisfavorita f
                 where f.tipofilial = 'L'
                   and f.ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 20
            region: @taxa-delivery
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIALFAVORITA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P603_IDTAXADELIVERY (
        type: hidden
        layout {
            sequence: 10
            region: @taxa-delivery
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDTAXADELIVERY
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P603_MSG (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @taxa-delivery
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P603_VALORPEDIDOMINIMO (
        type: numberField
        label {
            label: Valor Minimo do Pedido:
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 60
            region: @taxa-delivery
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: VALORPEDIDOMINIMO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P603_VALORTAXA (
        type: numberField
        label {
            label: Valor da Taxa:
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 50
            region: @taxa-delivery
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            formatMask: 999G999G999G999G990D00
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: VALORTAXA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Incluir
        layout {
            sequence: 10
            region: @taxa-delivery
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P603_IDTAXADELIVERY
        }
    )

    button delete (
        buttonName: DELETE
        label: Excluir
        layout {
            sequence: 20
            region: @taxa-delivery
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from favorita.taxasdelivery t
                 where t.datainicio > trunc(sysdate) 
                   and t.idtaxadelivery = :P603_IDTAXADELIVERY
                ```
        }
    )

    button salvar (
        buttonName: SALVAR
        label: Salvar
        layout {
            sequence: 30
            region: @taxa-delivery
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from favorita.taxasdelivery t
                 where t.datainicio > trunc(sysdate) 
                   and t.idtaxadelivery = :P603_IDTAXADELIVERY
                ```
        }
    )

    process fetch-row-from-taxasdelivery (
        name: Fetch Row from TAXASDELIVERY
        type: autoRowFetch
        source {
            tableName: TAXASDELIVERY
            pkColumn: IDTAXADELIVERY
            pkItem: P603_IDTAXADELIVERY
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 890684179321598010
        }
    )

    process get-pk (
        name: GET PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P603_IDTAXADELIVERY is null then
                        select favorita.seq_idtaxadelivery.nextval
                          into :P603_IDTAXADELIVERY
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 890684987974598018
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-taxasdelivery (
        name: Process Row of TAXASDELIVERY
        type: autoRowProcessing
        target {
            tableName: TAXASDELIVERY
            pkColumn: IDTAXADELIVERY
            pkItem: P603_IDTAXADELIVERY
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Processo Realizado com Sucesso!
        }
        advanced {
            executionMappingIdentifier: 890685065999598019
        }
    )

    process valida-taxa (
        name: Valida taxa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                 vexist number;
                 e_error exception;
                begin
                  begin
                     select max(t.valortaxa) 
                       into vexist 
                       from favorita.taxasdelivery t
                      where t.idfilialfavorita = :P603_IDFILIALFAVORITA
                        and (t.datainicio between :P603_DATAINICIO and :P603_DATAFIM or 
                             t.datafim between :P603_DATAINICIO and :P603_DATAFIM);
                   exception 
                     when no_data_found then 
                     vexist := 0;
                   end;
                   if nvl(vexist,0) > 0 then 
                   apex_util.set_session_state('P603_MSG', 'Já existe Taxa cadastrada para esse periodo!');
                   raise e_error;
                   else
                   :P603_MSG := '';
                   end if;
                end;
                
                
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: &P603_MSG.
        }
        advanced {
            executionMappingIdentifier: 1108682724912946612
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    branch (
        name: Go To Page 603
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 602
            }
        }
    )

)

