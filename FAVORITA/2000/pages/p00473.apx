page 473 (
    name: Morte Programada
    title: Morte Programada
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"Tem certeza que quer excluir?"';
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region morte-programada (
        name: Morte Programada
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region revistas (
        name: Revistas
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idprodutosdescontinuadospais,
                       p.idprodutodetalhado,
                       p.idpais,
                       ( select nome
                         from edicoesrevistas er
                         where er.idedicaorevista = p.idedicaorevista ) idedicaorevista
                from produtosdescontinuadospais p
                where p.idprodutodetalhado = :P473_IDPRODUTODETALHADO
                order by p.idprodutosdescontinuadospais
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P473_IDPRODUTOSDESCONTINUADOSP is null
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--horizontalBorders
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column IDEDICAOREVISTA (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Revista
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

        column IDPAIS (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column IDPRODUTODETALHADO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column IDPRODUTOSDESCONTINUADOSPAIS (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                alignment: center
            }
            layout {
                sequence: 1
            }
            link {
                target: {
                    page: 473
                    items: {
                        P473_IDPRODUTOSDESCONTINUADOSP: #IDPRODUTOSDESCONTINUADOSPAIS#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P473_IDEDICAOREVISTA (
        type: selectList
        label {
            label: Revista
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome, idedicaorevista
                  from edicoesrevistas er
                 where er.idpais = :P473_IDPAIS
                   and er.tipovenda = 'R'
                   --and datainicial > trunc(sysdate)
                 order by 2 desc
                ```
        }
        cascadingLov {
            parentItems: P473_IDPAIS
        }
        layout {
            sequence: 40
            region: @morte-programada
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDEDICAOREVISTA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P473_IDPAIS (
        type: selectList
        label {
            label: País
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome, idpais
                  from catal.paises p
                 where exists (
                                select 1
                                  from edicoesrevistas er
                                 where er.idpais = p.idpais
                                   and er.tipovenda = 'R'
                --                   and datainicial > trunc(sysdate)
                              )
                 order by 1
                ```
        }
        layout {
            sequence: 30
            region: @morte-programada
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDPAIS
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P473_IDPRODUTODETALHADO (
        type: selectList
        label {
            label: Produto
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-produtosdetalhados
        }
        layout {
            sequence: 20
            region: @morte-programada
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDPRODUTODETALHADO
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P473_IDPRODUTOSDESCONTINUADOSP (
        type: hidden
        layout {
            sequence: 10
            region: @morte-programada
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDPRODUTOSDESCONTINUADOSPAIS
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Incluir
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P473_IDPRODUTOSDESCONTINUADOSP
        }
    )

    button delete (
        buttonName: DELETE
        label: Excluir
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P473_IDPRODUTOSDESCONTINUADOSP
        }
    )

    button save (
        buttonName: SAVE
        label: Gravar
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: never
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process fetch-row-from-produtosdescontinuadospais (
        name: Fetch Row from PRODUTOSDESCONTINUADOSPAIS
        type: autoRowFetch
        source {
            tableName: PRODUTOSDESCONTINUADOSPAIS
            pkColumn: IDPRODUTOSDESCONTINUADOSPAIS
            pkItem: P473_IDPRODUTOSDESCONTINUADOSP
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 91049357984650235
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P473_IDPRODUTOSDESCONTINUADOSP is null then
                        select "#OWNER#"."SEQ_PRODUTOSDESCONTINUADOSPAIS".nextval
                          into :P473_IDPRODUTOSDESCONTINUADOSP
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 91049763873650235
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-produtosdescontinuadospais (
        name: Process Row of PRODUTOSDESCONTINUADOSPAIS
        type: autoRowProcessing
        target {
            tableName: PRODUTOSDESCONTINUADOSPAIS
            pkColumn: IDPRODUTOSDESCONTINUADOSPAIS
            pkItem: P473_IDPRODUTOSDESCONTINUADOSP
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 91050146970650235
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 91050560172650235
        }
    )

    branch (
        name: Go To Page 473
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 473
                items: {
                    P473_IDPRODUTODETALHADO: &P473_IDPRODUTODETALHADO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

)

