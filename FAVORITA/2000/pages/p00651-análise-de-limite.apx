    button alavancagem (
        buttonName: ALAVANCAGEM
        label: Alavancagem
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 653
                items: {
                    P653_IDVENDEDORA: &P651_IDVENDEDORA.
                    P653_DOCUMENTO: &P651_DOCUMENTO.
                    P653_LIMITE_ATUAL: &P651_LIMITEFAVORITA.
                }
                clearCache: 653
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

