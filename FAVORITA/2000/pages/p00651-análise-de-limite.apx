    pageItem P651_ADLFAVORITA (
        type: textField
        label {
            label: ADL Favorita:
            alignment: left
        }
        layout {
            sequence: 50
            region: @performance-favorita
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--xlarge
            ]
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                SELECT NVL(hp.adlfavorita, NULL) || '%'
                FROM roman.scorehistoricosperformance hp
                WHERE hp.idscorehistperformance = ( SELECT MAX(hh.idscorehistperformance)
                                                    FROM roman.scorehistoricosperformance hh
                                                    WHERE ( hh.idvendedora = :P651_IDVENDEDORA or hh.cpf = :P651_DOCUMENTO ))
                ```
            used: always
        }
        default {
            type: static
            staticValue: 0
        }
        readOnly {
            type: always
        }
    )

