            type: always
        }
    )

    pageItem P651_PEDIDOSAVENCER (
        type: textField
        label {
            label: Pedidos  À Vencer:
            alignment: left
        }
        layout {
            sequence: 110
            region: @informações-pessoais
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--xlarge
            ]
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select count(p.idpedido)
                from favorita.vw_pedidos_fav_new p
                where p.idsituacaoentrega >= 20000
                  and p.datacancelamento is null
                  --and p.idrepresentante = :idrep
                  and p.idvendedora = :P651_IDVENDEDORA
                  and exists ( select 1
                			   from favorita.vencimentospedidos vp
                			   where vp.situacaovencimento    = 'V'
                				 and vp.idpedido              = p.idpedido
                				 and nvl(vp.valorpago,0)      < vp.valorpagar 
                				 /*and vp.datavencimento between to_date(trunc(sysdate-30)||' 00:00:00','DD/MM/YYYY HH24:MI:SS') 
                									       and to_date(trunc(sysdate)||' 23:59:59','DD/MM/YYYY HH24:MI:SS'));*/
                                 and trunc(vp.datavencimento) > trunc(sysdate));
                ```
            used: always
        }
        default {
            type: static
            staticValue: 0
        }
        readOnly {
            type: always
        }
    )

