    dynamicAction realiza-consulta (
        name: Realiza Consulta
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @consultar-spc
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    /*javascript: ConsultarSPC_DEV(document.getElementById('P651_DOCUMENTO').value
                    ,document.getElementById('P651_DOCUMENTOMD5').value
                    ,document.getElementById('P651_IDFILIAL').value
                    ,document.getElementById('P0_USUARIO').value);*/
                    //,function(dados){window.location.reload()});
                    
                    // Mostra uma mensagem de carregamento (pode personalizar)
                    apex.message.showPageSuccess("Consultando, por favor aguarde...");
                    
                    // Desabilita o botão para evitar cliques múltiplos
                    apex.item(this.triggeringElement.id).disable();
                    
                    ConsultarSPC(
                      $v('P651_DOCUMENTO'),
                      $v('P651_DOCUMENTOMD5'),
                      $v('P651_IDFILIAL'),
                      $v('P0_USUARIO'),
                      function(dados) {
                        apex.submit();
                      }
                    );
                    
                    
                    
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process busca-as-informações (
        name: Busca as informações
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    -- Inicializando variáveis com valores padrão
                    :P651_NOMEPESSOA := NULL;
                    :P651_IDPESSOA := NULL;
                    :P651_IDREPRESENTANTE := NULL;
                    :P651_IDVENDEDORA := NULL;
                    :P651_DOCUMENTOPESSOA := NULL;
                    :P651_IDADE := 0;
                    :P651_DATAATIVACAO := NULL;
                    :P651_DATAREATIVACAO := NULL;
                
                    -- Consulta principal para pessoas
                    BEGIN
                        SELECT NVL(p.nomepessoa, 'N/A') nomepessoa
                             , p.idpessoa
                             , (SELECT v.idrepresentante FROM vendedoras v WHERE v.idpessoa = p.idpessoa)
                             , (SELECT v.idvendedora FROM vendedoras v WHERE v.idpessoa = p.idpessoa)
                             , NVL(p.cpf, p.documentoestrangeiro)
                             , NVL(TRUNC(MONTHS_BETWEEN(SYSDATE, p.datanascimento) / 12), 0)
                             , NVL((SELECT TO_CHAR(TRUNC(v.datainclusao), 'DD/MM/RRRR') FROM vendedoras v WHERE v.idpessoa = p.idpessoa), NULL)
                             , NVL((SELECT TRUNC(v.datareativacaovendedora) || ' (' || NVL((TRUNC(SYSDATE) - TRUNC(v.datareativacaovendedora)), 0) || ' dias )' 
                                    FROM vendedoras v 
                                    WHERE v.idpessoa = p.idpessoa), 'N/A')
                             , TO_CHAR( TO_NUMBER(REPLACE(REPLACE(p.limitecredito, '.', ''), ',', '.'), '999999999.99') + TO_NUMBER(REPLACE(REPLACE(p.limitecreditormc, '.', ''), ',', '.'), '999999999.99'), '999G999G999D00' ) AS limitetotal
                             , TO_CHAR(TO_NUMBER(REPLACE(REPLACE(p.limitecredito, '.', ''), ',', '.'), '999999999.99' ),'999G999G999D00') limitefavorita
                             , TO_CHAR(TO_NUMBER(REPLACE(REPLACE(p.limitecreditormc, '.', ''), ',', '.'), '999999999.99' ),'999G999G999D00') limiteromancecasa
                             , to_char(
                           to_number(
                               replace(
                                   replace(
                                       nvl((
                                            select p.limitecredito
                                              from pessoas p
                                             where p.idpessoa = :P651_IDPESSOA
                                       ), 0)
                                     - nvl((
                                            select sum(pp.valortotal)
                                              from favorita.vw_pedidos_fav_new pp
                                             where pp.datacancelamento is null
                                               and pp.idvendedora = :P651_IDVENDEDORA
                                               and pp.tipopedido = 'P'
                                               and exists ( select 1
                                                             from favorita.vencimentospedidos vp
                                                            where vp.situacaovencimento = 'V'
                                                              and vp.idpedido = pp.idpedido
                                                              and trunc(vp.datavencimento) < trunc(sysdate)
                                                              and nvl(vp.valorpago, 0) < vp.valorpagar
                                       )), 0), '.', ''), ',', '.'
                                   )
                               )
                           , 'FM999G999G999D00'
                       ) totaldisponivelfavorita
                      , to_char(to_number(replace(replace(
                    nvl(( select p.limitecreditormc
                          from pessoas p
                         where p.idpessoa = :P651_IDPESSOA ), 0) 
                  - nvl(( select sum(pp.valortotal)
                           from favorita.vw_pedidos_fav_new pp
                           where pp.datacancelamento is null
                             and pp.idvendedora = :P651_IDVENDEDORA
                             and pp.tipopedido = 'R'
                             and exists ( select 1
                                          from favorita.vencimentospedidos vp
                                          where vp.situacaovencimento = 'V'
                                            and vp.idpedido = pp.idpedido
                                            and trunc(vp.datavencimento) < trunc(sysdate)
                                            and nvl(vp.valorpago, 0) < vp.valorpagar )), 0) 
                  + nvl(( select sum(p.saldodevedor)
                            from favorita.vw_pedidos_fav_new p
                            where p.idsituacaoentrega >= 20000
                              and p.datacancelamento is null
                              and p.idrepresentante = :idrep
                              and p.tipopedido = 'R'
                              and exists ( select 1
                                           from favorita.vencimentospedidos vp
                                           where vp.situacaovencimento = 'V'
                                             and vp.idpedido = p.idpedido
                                             and nvl(vp.valorpago, 0) < vp.valorpagar
                                             and vp.datavencimento between trunc(sysdate - 30) AND trunc(sysdate))), 0) , '.', ''), ',', '.'), '999999999.99' ),'999G999G999D00') totaldisponivelrmccasa
                        INTO :P651_NOMEPESSOA
                           , :P651_IDPESSOA
                           , :P651_IDREPRESENTANTE
                           , :P651_IDVENDEDORA
                           , :P651_DOCUMENTOPESSOA
                           , :P651_IDADE
                           , :P651_DATAATIVACAO
                           , :P651_DATAREATIVACAO
                           , :P651_LIMITETOTAL
                           , :P651_LIMITEFAVORITA
                           , :P651_LIMITERMCCASA
                           , :P651_DISPONIVELFAVORITA
                           , :P651_DISPONIVELRMCCASA
                        FROM pessoas p
                        WHERE /*(REPLACE(REPLACE(REPLACE(p.cpf, '.', ''), '-', ''), ' ', '') = 
                                 REPLACE(REPLACE(REPLACE(:P651_DOCUMENTO, '.', ''), '-', ''), ' ', ''))
                                OR p.documentoestrangeiro = :P651_DOCUMENTO;*/
                             p.cpf = :P651_DOCUMENTO;
                
                
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            -- Já inicializado com valores padrão
                            NULL;
                    END;
                
                    -- Inicializando variáveis para a segunda consulta
                    :P651_QTDPEDFAVORITA := 0;
                    :P651_MAIORPEDQUITADO := '0,00';
                    :P651_TMFAVMEDPEDIDOS := '0,00';
                    :P651_TMFAVMEDGERAL := '0,00';
                    :P651_ADLFAVORITA := NULL;
                    :P651_MEDDIASPAGAMENTO := 0;
                    :P651_QTDACERTOSRMC := 0;
                    :P651_VLRPAGOULTIMOACERTO := '0,00';
                    :P651_TMRMCMEDACERTOS := '0,00';
                    :P651_TMRMCMEDGERAL := '0,00';
                    :P651_PERCVENDRMC := 0;
                    :P651_SALDORMCABERTO := '0,00';
                    :P651_CATEGORIZACAO := NULL;
                    :P651_SCORE := 0;
                    :P651_PONTUACAO := 0;
                    :P651_QTDRESTRITIVO := 0;
                    :P651_VLRRESTRITIVO := '0,00';
                    :P651_CHEQUESSEMFUNDO := 0;
                    :P651_SITUACAODOCUMENTO := NULL;
                    :P651_SCOREFINAL := NULL;
                
                    -- Consulta para scorehistoricosperformance
                    BEGIN
                        SELECT NVL(hp.qtdpedidofavorita, 0),
                               NVL(hp.maiorpedidoquitado, '0,00'),
                               NVL(hp.ticketfavmediaped, '0,00'),
                               NVL(hp.ticketfavgeral, '0,00'),
                               NVL(hp.adlfavorita, NULL),
                               NVL(hp.mediadiaspagamento, 0),
                               NVL(hp.qtdacertosromance, 0),
                               NVL(hp.vlpagultimoacerto, '0,00'),
                               NVL(hp.ticketrmcacertos, '0,00'),
                               NVL(hp.ticketrmcgeral, '0,00'),
                               NVL(hp.percvendasrmc, 0),
                               NVL(hp.saldormcaberto, '0,00'),
                               NVL(hp.categorizacao, NULL),
                               NVL(hp.scoremercado, 0),
                               NVL(hp.scoremercpont, 0),
                               NVL(hp.qtdrestritivo, 0),
                               NVL(hp.valorrestritivo, '0,00'),
                               NVL(hp.chequessemfundo, 0),
                               NVL(hp.situacaocpf, NULL),
                               NVL('<span style="font-size:35px; font-weight:bold;">' || hp.scorefavorita || '</span>', 'N/A')
                        INTO :P651_QTDPEDFAVORITA, :P651_MAIORPEDQUITADO, :P651_TMFAVMEDPEDIDOS, :P651_TMFAVMEDGERAL,
                             :P651_ADLFAVORITA, :P651_MEDDIASPAGAMENTO, :P651_QTDACERTOSRMC, :P651_VLRPAGOULTIMOACERTO,
                             :P651_TMRMCMEDACERTOS, :P651_TMRMCMEDGERAL, :P651_PERCVENDRMC, :P651_SALDORMCABERTO,
                             :P651_CATEGORIZACAO, :P651_SCORE, :P651_PONTUACAO, :P651_QTDRESTRITIVO, :P651_VLRRESTRITIVO,
                             :P651_CHEQUESSEMFUNDO, :P651_SITUACAODOCUMENTO, :P651_SCOREFINAL
                        FROM roman.scorehistoricosperformance hp
                        WHERE hp.idscorehistperformance = ( SELECT MAX(hh.idscorehistperformance)
                                                            FROM roman.scorehistoricosperformance hh
                                                            WHERE hh.idvendedora = :P651_IDVENDEDORA );
                
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            -- Já inicializado com valores padrão
                            NULL;
                    END;
                END;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 373408743457079503
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CONSULTAR_SPC,BUSCAR
        }
    )

    process recalcula-o-limite (
        name: Recalcula o limite
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vdocumento varchar2(20) := :P651_DOCUMENTO;
                  vorigem varchar(1) := 'C';
                  vidfilial number := :P651_IDFILIAL;
                  --
                begin
                  --
                  favorita.pck_analise_credito_score.prc_insere_scorehistperformance(pdocumento => vdocumento,
                                                                                     porigem => vorigem,
                                                                                     pidfilial => vidfilial);
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 2582008025756688102
        }
        serverSideCondition {
            whenButtonPressed: @recalcular
        }
    )

)

