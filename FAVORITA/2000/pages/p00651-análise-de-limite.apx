    pageItem P651_IDFILIAL (
        type: selectList
        label {
            label: Franquia
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nvl(p.apelido, p.nomepessoa)) display_value
                     , f.idfilial return_value
                from catal.pessoas p
                   , catal.filiais f
                where p.idpessoa = f.idpessoa
                  and f.tipofilial = 'D' /*distribuidora*/
                  and f.ativo = 'S'
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @consultar-o-documento
            slot: regionBody
