    pageItem P651_DOCUMENTOMD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  v_input VARCHAR2(2000) := :P651_DOCUMENTO;--replace(replace(:P651_DOCUMENTO,'.',''),'-','');
                  hexkey VARCHAR2(32) := NULL;
                  vmd5 varchar2(300);
                BEGIN
                  --
                  hexkey := roman.md5(v_input);
                  --
                  select lower(hexkey) md5
                  into vmd5
                  from dual;
                  --
                  return vmd5;
                  --
                exception
                  when others then
                    return null;
                END;
                ```
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  v_input VARCHAR2(2000) := :P651_DOCUMENTO;--replace(replace(:P651_DOCUMENTO,'.',''),'-','');
                  hexkey VARCHAR2(32) := NULL;
                  vmd5 varchar2(300);
                BEGIN
                  --
                  hexkey := roman.md5(v_input);
                  --
                  select lower(hexkey) md5
                  into vmd5
                  from dual;
                  --
                  return vmd5;
                  --
                exception
                  when others then
                    return null;
                END;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

