    pageItem P651_MSGULTIMACONSULTA (
        type: displayOnly
        label {
            label: Msgultimaconsulta
            alignment: left
        }
        settings {
            format: html
        }
        layout {
            sequence: 130
            region: @informações-pessoais
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--xlarge
            ]
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select case 
                        when round((sysdate - max(cp.dataconsulta))) = 0 then 
                             '<span style="font-size:30px; color:red;">A última consulta foi realizada hoje!</span>'
                        when round((sysdate - max(cp.dataconsulta))) > 0 then 
                             '<span style="font-size:30px; color:red;">Última consulta realizada há ' || round((sysdate - max(cp.dataconsulta))) || ' dia(s)</span>' 
                        else
                           '<span style="font-size:30px; color:red;">Possui nenhuma consulta SPC!</span>'
                       end dias
                from roman.consultaspc cp
                where cp.cpf = :P651_DOCUMENTOPESSOA;
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.scorehistoricosperformance h
                where ( h.idvendedora = :P651_IDVENDEDORA or h.cpf = :P651_DOCUMENTO);
                ```
        }
    )

