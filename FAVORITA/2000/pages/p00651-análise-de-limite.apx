    region histórico-de-alavancagem (
        name: Histórico de alavancagem
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.dataalavancagem
                     , a.limiteatual
                     , a.limitesolicitado
                     , a.limiteatribuido
                     , nvl(round(a.percalavancagem),0)||'%' percalavancagem
                     , a.usuarioalavancagem
                     --, a.solicitadopor
                     , case
                         when a.solicitadopor = 'F' then 'Favorita'
                         when a.solicitadopor = 'C' then 'Call Center'
                         when a.solicitadopor = 'L' then 'Loja'
                       end solicitadopor
                     --, a.tipo
                     , case 
                         when a.tipo = 'F' then 'Favorita'
                         when a.tipo = 'C' then 'Romance Casa'
                       end tipo
                     --, a.identificacao
                     , case 
                         when a.identificacao = '1' then 'Atualizado'
                         when a.identificacao = '2' then 'Atribuído'
                         when a.identificacao = '3' then 'Parcial'
                         when a.identificacao = '4' then 'Negado'
                         when a.identificacao = '5' then 'Acerto'
                         when a.identificacao = '6' then 'Pagamento Pedido'
                       end identificacao
                from roman.SCOREHISTORICOSALAVANCAGEM a
                where ( a.idvendedora = :P651_IDVENDEDORA or a.cpf = :P651_DOCUMENTO )
                order by a.idscorehistalavancagem desc
                ```
        }
        layout {
            sequence: 100
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 373413115807079547
        }

