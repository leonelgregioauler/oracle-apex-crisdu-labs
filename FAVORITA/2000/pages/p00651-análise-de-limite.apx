    pageItem P651_CREDITORMCCASA (
        type: textField
        label {
            label: Crédito RMC Casa:
            alignment: left
        }
        layout {
            sequence: 40
            region: @limites-de-crédito-score-da-consultora
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--xlarge
            ]
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select case 
                         when p.limitecreditormc is null or p.limitecreditormc = 0 then '0'
                         else
                           to_char(nvl(p.limitecreditormc, 0) - nvl(( select sum(pp.valortotal)
                                                                   from favorita.vw_pedidos_fav_new pp
                                                                   where pp.datacancelamento is null
                                                                     and pp.idvendedora = v.idvendedora
                                                                     and pp.tipopedido = 'R'
                                                                     and exists (select 1
                                                                                 from favorita.vencimentospedidos vp
                                                                                 where vp.situacaovencimento = 'V'
                                                                                   and vp.idpedido = pp.idpedido
                                                                                   and trunc(vp.datavencimento) < trunc(sysdate)
                                                                                   and nvl(vp.valorpago, 0) < vp.valorpagar)), 0) , '999G999G999G999G990D00')
                       end total
                from catal.pessoas p
                   , catal.vendedoras v
                where p.idpessoa = v.idpessoa
                  and v.idvendedora = :P651_IDVENDEDORA
                ```
            used: always
        }
        default {
            type: static
            staticValue: 0
        }
        readOnly {
            type: always
        }
    )

