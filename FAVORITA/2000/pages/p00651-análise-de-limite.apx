    region histórico-performance (
        name: Histórico Performance
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select hp.dataconsulta
                     , hp.qtdpedidofavorita
                     , hp.maiorpedidoquitado
                     , hp.ticketfavmediaped
                     , hp.ticketfavgeral
                     , hp.adlfavorita
                     , hp.mediadiaspagamento
                     , hp.qtdacertosromance
                     , hp.vlpagultimoacerto
                     , hp.ticketrmcacertos
                     , hp.ticketrmcgeral
                     , hp.percvendasrmc
                     , hp.saldormcaberto
                     , hp.categorizacao
                     , hp.scoremercado
                     , hp.scoremercpont
                     , hp.qtdrestritivo
                     , hp.valorrestritivo
                     , hp.chequessemfundo
                     , hp.situacaocpf
                     , hp.scorefavorita
                from roman.scorehistoricosperformance hp
                where ( hp.idvendedora = :P651_IDVENDEDORA or hp.cpf = :P651_DOCUMENTO)
                order by hp.idscorehistperformance desc
                ```
        }
