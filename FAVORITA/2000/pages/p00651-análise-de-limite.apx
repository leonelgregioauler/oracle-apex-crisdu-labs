    pageItem P651_LIMITEAPROVADO (
        type: textField
        label {
            label: Limite Aprovado:
            alignment: left
        }
        layout {
            sequence: 20
            region: @limites-de-crédito-score-da-consultora
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--xlarge
            ]
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                SELECT 
                    CASE 
                        WHEN 
                            NVL(TO_NUMBER(REPLACE(REPLACE(p.limitecredito, '.', ''), ',', '.'), '999999999.99'), 0) +
                            NVL(TO_NUMBER(REPLACE(REPLACE(p.limitecredromance, '.', ''), ',', '.'), '999999999.99'), 0) +
                            NVL(TO_NUMBER(REPLACE(REPLACE(p.limitecreditormc, '.', ''), ',', '.'), '999999999.99'), 0) = 0 
                        THEN 
                            '0' 
                        ELSE 
                            TO_CHAR(
                                NVL(TO_NUMBER(REPLACE(REPLACE(p.limitecredito, '.', ''), ',', '.'), '999999999.99'), 0) +
                                NVL(TO_NUMBER(REPLACE(REPLACE(p.limitecredromance, '.', ''), ',', '.'), '999999999.99'), 0) +
                                NVL(TO_NUMBER(REPLACE(REPLACE(p.limitecreditormc, '.', ''), ',', '.'), '999999999.99'), 0)
                                ,'999G999G999D00') 
                    END AS limitetotal
                FROM pessoas p
                WHERE p.idpessoa = :P651_IDPESSOA;
                ```
            used: always
        }
        default {
            type: static
            staticValue: 0
        }
        readOnly {
            type: always
        }
    )

