                #DEFAULT#
                t-Form-fieldContainer--xlarge
            ]
            formatMask: 999G999G999G999G990D00
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select nvl((select sum(pp.saldodevedor)
                        from favorita.vw_pedidos_fav_new pp
                        where pp.datacancelamento is null
                          and pp.idvendedora = :P651_IDVENDEDORA
                         --and trunc(pp.dataemissao)  > sysdate - 400
                          and exists ( select 1
                                       from favorita.vencimentospedidos vp
                                       where vp.situacaovencimento    = 'V'
                                         and vp.idpedido              = pp.idpedido
                                         and trunc(vp.datavencimento) < trunc(sysdate)
                                         and nvl(vp.valorpago,0)      < vp.valorpagar )),0) total
                from dual
                ```
            used: always
        }
        default {
            type: static
            staticValue: 0
        }
        readOnly {
            type: always
        }
    )

