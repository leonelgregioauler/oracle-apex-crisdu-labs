page 149 (
    name: Históricos de Pontos
    title: Históricos de Pontos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region históricos-de-pontos (
        name: Históricos de Pontos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select data
                     , ( select n.numeronota
                         from roman.notasvendas n
                         where n.idnotavenda = m.idnotavenda ) numeronota
                     , nvl(( select sum(n.valorpago) from roman.pagamentosnotasvendas n where n.idnotavenda = m.idnotavenda ),0) valorpago
                     , ( select 'P'||p.numeropedido numeropedido
                         from pedidos p
                         where p.idpedido = m.idpedidofavorita
                         union 
                         select pp.nrpedido
                         from catal.pedidos pp
                         where pp.idpedido = m.idpedidofavorita ) numeropedido
                     , pontos
                     , observacao
                     , sum(pontos) over (order by data) saldo_do_dia
                from roman.movimentospontosvendedoras m
                where idvendedora = :P149_IDVENDEDORA
                order by m.data;
                
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhuma movimentação encontrada!
        }
        searchBar {
            rowsPerPageSelector: true
        }
        advanced {
            savedReportMappingIdentifier: 31278809810716209
        }

        column DATA (
            type: plainText
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: A
            }
        )

        column NUMERONOTA (
            type: plainText
            heading {
                heading: Nr Nota
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column NUMEROPEDIDO (
            type: plainText
            heading {
                heading: Nr Pedido
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column OBSERVACAO (
            type: plainText
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column PONTOS (
            type: plainText
            heading {
                heading: Pontos
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column SALDO_DO_DIA (
            type: plainText
            heading {
                heading: Saldo do dia
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column VALORPAGO (
            type: plainText
            heading {
                heading: Valor Pago
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            appearance {
                formatMask: FML999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 313892 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATA (
                sequence: 1
            )

            displayColumn NUMERONOTA (
                sequence: 2
            )

            displayColumn NUMEROPEDIDO (
                sequence: 4
            )

            displayColumn OBSERVACAO (
                sequence: 6
            )

            displayColumn PONTOS (
                sequence: 5
            )

            displayColumn SALDO_DO_DIA (
                sequence: 7
            )

            displayColumn VALORPAGO (
                sequence: 3
            )

            aggregate (
                column: PONTOS
            )

        )

    )

    pageItem P149_IDVENDEDORA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @históricos-de-pontos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

