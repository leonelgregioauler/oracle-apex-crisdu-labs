page 106 (
    name: Cadastro de Situações Promissórias
    title: Cadastro de Situações Promissórias
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-de-situações-promissórias (
        name: Cadastro de Situações Promissórias
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P106_DESCRICAO (
        type: textField
        label {
            label: Descrição
            alignment: left
        }
        layout {
            sequence: 20
            region: @cadastro-de-situações-promissórias
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P106_IDSITUACAOPROMIS (
        type: hidden
        layout {
            sequence: 10
            region: @cadastro-de-situações-promissórias
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P106_MD5 (
        type: hidden
        layout {
            sequence: 30
            region: @cadastro-de-situações-promissórias
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P106_OPERACAO_DML (
        type: hidden
        layout {
            sequence: 40
            region: @cadastro-de-situações-promissórias
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 50
            region: @cadastro-de-situações-promissórias
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P106_IDSITUACAOPROMIS
        }
    )

    button excuir (
        buttonName: EXCUIR
        label: Excuir
        layout {
            sequence: 40
            region: @cadastro-de-situações-promissórias
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P106_IDSITUACAOPROMIS
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 30
            region: @cadastro-de-situações-promissórias
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 105
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 20
            region: @cadastro-de-situações-promissórias
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P106_IDSITUACAOPROMIS
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @cadastro-de-situações-promissórias
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P106_IDSITUACAOPROMIS
        }
    )

    validation descricao-obrigatório (
        name: DESCRICAO obrigatório
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P106_DESCRICAO
        }
        error {
            errorMessage: Descrição deve ter um valor.
            associatedItem: @P106_DESCRICAO
        }
    )

    process consulta-situações-promissórias (
        name: Consulta Situações Promissórias
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                #OWNER#.PCK_CADASTROSSITUACOES_FAV.PRC_SITUACOESPROMISSORIAS (
                  PIDSITUACAOPROMIS => :P106_IDSITUACAOPROMIS,
                  PDESCRICAO => :P106_DESCRICAO,
                  PMD5 => :P106_MD5,
                  POPERACAO_DML => 'S' );
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 14120132801015347
        }
    )

    process limpar-campos-ao-sair (
        name: Limpar Campos ao Sair
        type: clearSessionState
        execution {
            sequence: 10
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 14120215431015348
        }
    )

    process limpar-campos-para-adicionar (
        name: Limpar Campos para Adicionar
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 14672591829675506
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    process operação-dml-em-situações-promissórias (
        name: Operação DML em Situações Promissórias
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  #OWNER#.PCK_CADASTROSSITUACOES_FAV.PRC_SITUACOESPROMISSORIAS (
                    PIDSITUACAOPROMIS => :P106_IDSITUACAOPROMIS,
                    PDESCRICAO => :P106_DESCRICAO,
                    PMD5 => :P106_MD5,
                    POPERACAO_DML => voperacao_dml );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 14660519934466182
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 106
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

)

