page 260 (
    name: Vincular Cliente em Tarefa
    title: Vincular Cliente em Tarefa
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region vincular-cliente (
        name: VIncular Cliente
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P260_IDPESSOA (
        type: popupLov
        label {
            label: Cliente
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' ('||p.cpf||')'||' ID: '||p.idpessoa d
                     , p.idpessoa r
                from pessoas p
                   , vendedoras v
                where p.idpessoa = v.idpessoa
                order by 1
                ```
            nullDisplayValue: - Selecione a Cliente -
        }
        layout {
            sequence: 20
            region: @vincular-cliente
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P260_IDTAREFA (
        type: displayOnly
        label {
            label: Nr Tarefa
            alignment: left
        }
        layout {
            sequence: 10
            region: @vincular-cliente
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                 vidtarefa number;
                begin
                  --
                  select idtarefa
                  into vidtarefa 
                  from tarefas t
                  where t.idusuario = :P0_IDUSUARIO
                    and t.idpessoa is null
                    and t.idsituacao = 10;
                  --
                  return vidtarefa;
                  --
                exception
                  when others then
                    null;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 10
            region: @vincular-cliente
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 20
            region: @vincular-cliente
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process atualiza-cliente-em-tarefa (
        name: Atualiza Cliente em Tarefa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_tarefas_fav.prc_atualizaidpessoatarefa(pidtarefa => :P260_IDTAREFA,
                                                             pidpessoa => :P260_IDPESSOA);
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Tarefa atualizada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 574153590611641030
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 71
                action: resetPagination
            }
        }
    )

)

