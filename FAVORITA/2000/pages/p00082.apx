page 82 (
    name: Cadastro de Categorias Site
    title: Categorias Site
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region categorias-site (
        name: Categorias Site
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P82_ATIVO (
        type: radioGroup
        label {
            label: Ativo
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-simnao
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @categorias-site
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P82_IDCATEGORIASITE (
        type: hidden
        layout {
            sequence: 10
            region: @categorias-site
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P82_IDTEXTO (
        type: hidden
        layout {
            sequence: 40
            region: @categorias-site
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P82_MD5 (
        type: hidden
        layout {
            sequence: 50
            region: @categorias-site
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P82_NOMECATEGORIA (
        type: textField
        label {
            label: Categoria Site
            alignment: left
        }
        layout {
            sequence: 20
            region: @categorias-site
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P82_OPERACAODML (
        type: hidden
        layout {
            sequence: 60
            region: @categorias-site
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 50
            region: @categorias-site
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P82_IDCATEGORIASITE
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 40
            region: @categorias-site
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P82_IDCATEGORIASITE
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 30
            region: @categorias-site
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 81
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 20
            region: @categorias-site
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P82_IDCATEGORIASITE
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @categorias-site
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P82_IDCATEGORIASITE
        }
    )

    process consulta-em-categorias-site (
        name: Consulta em Categorias Site
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                #OWNER#.PCK_CADASTROS_FAV.PRC_CATEGORIASSITE (
                  PIDCATEGORIASITE => :P82_IDCATEGORIASITE,
                  PNOMECATEGORIA => :P82_NOMECATEGORIA,
                  PATIVO => :P82_ATIVO,
                  PMD5 => :P82_MD5,
                  POPERACAO_DML => 'S');
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 12363315786677828
        }
    )

    process limpar-campos-ao-sair (
        name: Limpar Campos ao Sair
        type: clearSessionState
        execution {
            sequence: 10
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 12363404330677829
        }
    )

    process limpar-campos-para-adicionar (
        name: Limpar Campos para Adicionar
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 12363518055677830
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    process operação-dml-em-categorias-site (
        name: Operação DML em Categorias Site
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  #OWNER#.PCK_CADASTROS_FAV.PRC_CATEGORIASSITE (
                    PIDCATEGORIASITE => :P82_IDCATEGORIASITE,
                    PNOMECATEGORIA => :P82_NOMECATEGORIA,
                    PATIVO => :P82_ATIVO,
                    PMD5 => :P82_MD5,
                    POPERACAO_DML => voperacao_dml);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 12476299822153541
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 82
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

)

