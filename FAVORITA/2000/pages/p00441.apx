            virtualKeyboard: text
        }
        layout {
            sequence: 20
            region: @anexos-de-questionamentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: databaseColumn
