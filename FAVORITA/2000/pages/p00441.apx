    pageItem P441_IDUSUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @anexos-de-questionamentos
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDUSUARIO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  vidusuario number;
                  --
                begin
                  --
                  select idusuario
                  into vidusuario
                  from usuarios
                  where usuario = v('APP_USER');
                  --
                  return vidusuario;
                  --
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P441_NOMEARQUIVO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @anexos-de-questionamentos
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: NOMEARQUIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Anexar este arquivo!
        layout {
            sequence: 60
            region: @anexos-de-questionamentos
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P441_IDANEXOQUESTIONAMENTO
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 20
            region: @anexos-de-questionamentos
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P441_IDANEXOQUESTIONAMENTO
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @anexos-de-questionamentos
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 440
                items: {
                    P440_IDQUESTIONAMENTO: &P441_IDQUESTIONAMENTO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation new (
        name: New
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P441_ARQUIVOTEMP
            alwaysExecute: true
        }
        error {
            errorMessage: Por favor, anexo um arquivo válido!
        }
        serverSideCondition {
            type: request=Value
            value: CREATE
        }
    )

    process anexo (
        name: Anexo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  commit;
                  -- Call the procedure
                  roman.pck_anexos.blob_to_file_questionamento(pidquestionamento => :P441_IDQUESTIONAMENTO);
                  commit;
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Arquivo anexado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 24343758551202826
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process deletar (
        name: Deletar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  roman.pck_anexos.prc_apagaanexo_questionamento( pidanexoquestionamento => :P441_IDANEXOQUESTIONAMENTO);
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 24344111294202828
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    process fetch-row-from-anexosquestionamentos (
        name: Fetch Row from ANEXOSQUESTIONAMENTOS
        type: autoRowFetch
        source {
            tableOwner: ROMAN
            tableName: ANEXOSQUESTIONAMENTOS
            pkColumn: IDANEXOQUESTIONAMENTO
            pkItem: P441_IDANEXOQUESTIONAMENTO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 24344526983202828
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P441_IDANEXOQUESTIONAMENTO is null then
                        select roman.SEQ_IDANEXOQUESTIONAMENTO.nextval
                          into :P441_IDANEXOQUESTIONAMENTO
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 24344963288202828
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-anexosquestionamentos (
        name: Process Row of ANEXOSQUESTIONAMENTOS
        type: autoRowProcessing
        target {
            tableOwner: ROMAN
            tableName: ANEXOSQUESTIONAMENTOS
            pkColumn: IDANEXOQUESTIONAMENTO
            pkItem: P441_IDANEXOQUESTIONAMENTO
            supportedOperations: [
                insert
                update
            ]
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Arquivo Anexado.
        }
        advanced {
            executionMappingIdentifier: 24345304989202828
        }
    )

    branch (
        name: Go To Page 441
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 441
                items: {
                    P441_IDANEXOQUESTIONAMENTO:
                    P441_IDQUESTIONAMENTO: &P441_IDQUESTIONAMENTO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('DELETAR','SAVE','CREATE')
                ```
        }
    )

)

