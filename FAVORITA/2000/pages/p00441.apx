page 441 (
    name: Anexos de Questionamentos
    title: Anexos de Questionamentos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function fnc_verimg(pid)
            {
              window.open('http://anexos.romancemoda.com.br/'+pid);
              void(0);
            }
            
            function fnc_removeanexo(pidanexo,pnomeanexo)
            {
                apex.confirm("Deseja realmente remover o anexo "+pnomeanexo+"?", {
              request:"DELETAR",
              set:{"P449_IDANEXOQUESTIONAMENTO":pidanexo}
              });
            }
            ```
    }

    region anexos-de-questionamentos (
        name: Anexos de Questionamentos
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region arquivos-anexados (
        name: Arquivos Anexados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomearquivo
                     , t.idquestionamento||t.idanexoquestionamento||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10) link
                     , dataanexo
                     , ( select roman.pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario ) usuario 
                     , '<a href="javascript: fnc_removeanexo('||t.idanexoquestionamento||','''||nomearquivo||''');">Remover</a>' remover
                from roman.ANEXOSQUESTIONAMENTOS t
                where t.idquestionamento = :P441_IDQUESTIONAMENTO
                order by t.dataanexo
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P441_IDQUESTIONAMENTO
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum anexo encontrado!
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 3831021976951384629
        }

        column DATAANEXO (
            type: plainText
            heading {
                heading: Data do Anexo
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column LINK (
            type: link
            heading {
                heading: Ver Arquivo
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            link {
                target: {
                    page: 357
                    items: {
                        P357_ARQUIVO: #LINK#
                    }
                    action: resetPagination
                }
                linkText: #LINK#
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOMEARQUIVO (
            type: plainText
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column REMOVER (
            type: plainText
            heading {
                heading: Remover
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
            security {
                escapeSpecialChars: false
            }
        )

        column USUARIO (
            type: plainText
            heading {
                heading: Anexado por
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        savedReport 243386 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAANEXO (
                sequence: 3
            )

            displayColumn LINK (
                sequence: 2
            )

            displayColumn NOMEARQUIVO (
                sequence: 1
            )

            displayColumn REMOVER (
                sequence: 5
            )

            displayColumn USUARIO (
                sequence: 4
            )

        )

    )

    pageItem P441_ARQUIVOTEMP (
        type: fileUpload
        label {
            label: Arquivo
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
        }
        storage {
            filenameColumn: NOMEARQUIVO
            fileTypes: image/png,image/jpeg,application/pdf
        }
        layout {
            sequence: 50
            region: @anexos-de-questionamentos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: ARQUIVOTEMP
            used: always
        }
    )

    pageItem P441_DATAANEXO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
