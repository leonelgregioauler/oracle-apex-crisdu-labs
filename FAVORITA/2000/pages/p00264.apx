page 264 (
    name: Nova Saida
    title: Nova Saida
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 55%
        height: 65%
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region nova-saida (
        name: Nova Saida
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P264_DATA (
        type: datePickerJquery
        label {
            label: Data
            alignment: left
        }
        layout {
            sequence: 100
            region: @nova-saida
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr
            width: 8
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: DATA
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                return sysdate;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P264_DESCRICAO (
        type: textarea
        label {
            label: Descrição
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 120
            region: @nova-saida
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
            height: 4
        }
        validation {
            maxLength: 200
        }
        source {
            type: databaseColumn
            databaseColumn: DESCRICAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P264_FECHAMENTOORIG (
        type: selectList
        label {
            label: Fechamento
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select semana DISPLAY_VALUE
                     , semana return_value
                from fechamentossemanais  f
                where idfechamento     = :P264_IDFECHAMENTO
                  and concluido = 'N'
                order by f.idfechamento desc
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @nova-saida
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            customAttributes: style="text-align: right;" readonly
        }
        source {
            type: databaseColumn
            databaseColumn: FECHAMENTOORIG
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P264_IDCONTACONTABIL (
        type: selectList
        label {
            label: Conta Contábil
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(c.nomeconta) display_value
                     , c.idcontafinan  return_value
                from roman.contasfinanceiras c
                where c.debitocredito = 'D'
                AND ATIVO = 'S'
                order by 1
                ```
            nullDisplayValue: - Selecione a Conta Contábil -
        }
        layout {
            sequence: 60
            region: @nova-saida
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDCONTACONTABIL
            used: always
        }
        readOnly {
            type: itemIsNotNull
            item: P82_IDREPRESENTANTE
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P264_IDFECHAMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 130
            region: @nova-saida
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFECHAMENTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P264_IDFILIAL (
        type: hidden
        layout {
            sequence: 20
            region: @nova-saida
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P264_IDFILIALDEST (
        type: selectList
        label {
            label: Empresa Destino
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome display_value
                     , idfilial return_value
                from roman.vw_filiais    f
                where f.ativo = 'S'
                  and f.idfilial != nvl(:P0_IDFILIALCAIXA,1)
                order by 1
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 30
            region: @nova-saida
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIALDEST
            used: always
        }
        readOnly {
            type: itemIsNotNull
            item: P264_IDFILIALDEST
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P264_IDSAIDA (
        type: hidden
        layout {
            sequence: 10
            region: @nova-saida
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDSAIDA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P264_IDSUBCONTACONTABIL (
        type: selectList
        label {
            label: Sub Conta
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(c.nomeconta) display_value
                     , c.idSUBcontafinan  return_value
                from roman.SUBcontasfinanceiras c
                where c.debitocredito = 'D'
                AND IDCONTAFINAN = :P264_IDCONTACONTABIL
                  AND ATIVO = 'S'
                order by 1
                ```
            nullDisplayValue: - Selecione a Conta Contábil -
        }
        cascadingLov {
            parentItems: P264_IDCONTACONTABIL
        }
        layout {
            sequence: 70
            region: @nova-saida
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDSUBCONTACONTABIL
            used: always
        }
        readOnly {
            type: itemIsNotNull
            item: P82_IDREPRESENTANTE
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P264_SEMANA (
        type: hidden
        layout {
            sequence: 50
            region: @nova-saida
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: SEMANA
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                return to_char(sysdate,'IW/RRRR');
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P264_TIPO (
        type: radioGroup
        label {
            label: Tipo
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Dinheiro-Cheque;D,Pagamento de Conta;O
            displayNullValue: false
        }
        layout {
            sequence: 105
            region: @nova-saida
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: TIPO
            used: always
        }
        default {
            type: static
            staticValue: O
        }
        readOnly {
            type: itemIsNotNull
            item: P264_IDSAIDA
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P264_VALORTOTAL (
        type: numberField
        label {
            label: Valor Total
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 110
            region: @nova-saida
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G990D00
            width: 15
        }
        validation {
            maxLength: 255
        }
        advanced {
            customAttributes: style="text-align: right;"
        }
        source {
            type: databaseColumn
            databaseColumn: VALORTOTAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Fechar
        layout {
            sequence: 10
            region: @nova-saida
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 246
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 40
            region: @nova-saida
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P264_IDSAIDA
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @nova-saida
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P264_IDSAIDA is NOT null
                  and exists ( select 1
                               from fechamentossemanais f
                               where f.idfechamento = :P264_IDFECHAMENTO 
                                 and f.concluido = 'N')
                ```
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @nova-saida
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P264_IDSAIDA is NOT null
                  and exists ( select 1
                               from fechamentossemanais f
                               where f.idfechamento = :P264_IDFECHAMENTO 
                                 and f.concluido = 'N')
                ```
        }
    )

    validation p264-descricao (
        name: P264_DESCRICAO
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P264_DESCRICAO
        }
        error {
            errorMessage: #LABEL# deve ser informado!
            associatedItem: @P264_DESCRICAO
        }
    )

    validation p264-idfilialdest (
        name: P264_IDFILIALDEST
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P264_IDFILIALDEST
        }
        error {
            errorMessage: #LABEL# deve ser informado.
            associatedItem: @P264_IDFILIALDEST
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    validation p264-tipo (
        name: P264_TIPO
        execution {
            sequence: 40
        }
        validation {
            type: itemIsNotNull
            item: P264_TIPO
        }
        error {
            errorMessage: Tipo deve ser informado!
            associatedItem: @P264_TIPO
        }
    )

    validation p264-valortotal (
        name: P264_VALORTOTAL
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNullOrZero
            item: P264_VALORTOTAL
        }
        error {
            errorMessage: #LABEL# deve ser informado!
            associatedItem: @P264_VALORTOTAL
        }
    )

    process fetch-saidasdiversas (
        name: Fetch SAIDASDIVERSAS
        type: autoRowFetch
        source {
            tableOwner: ROMAN
            tableName: SAIDASDIVERSAS
            pkColumn: IDSAIDA
            pkItem: P264_IDSAIDA
        }
        execution {
            sequence: 50
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 766596333106194702
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P264_IDSAIDA
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select roman.SEQ_IDSAIDASDIVERSAS.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  --
                  :P264_IDSAIDA := get_pk; 
                  --
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Unable to get primary key item value.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 766595168724194701
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-saidasdiversas (
        name: Process Row of SAIDASDIVERSAS
        type: autoRowProcessing
        target {
            tableOwner: ROMAN
            tableName: SAIDASDIVERSAS
            pkColumn: IDSAIDA
            pkItem: P264_IDSAIDA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Saída inserida!
        }
        error {
            errorMessage: Unable to process row of table SAIDASDIVERSAS.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 766595503342194702
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 766595928856194702
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        name: Go To Page 250
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 250
            }
            saveStateBeforeBranching: true
        }
    )

)

