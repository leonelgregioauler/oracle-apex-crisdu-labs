    dynamicAction definecampos (
        name: DefineCampos
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var vsit = apex.item("P527_SITUACAO").getValue();
                    
                    apex.item("P527_IDPRODUTODETALHADO").enable();
                    
                    apex.item("P527_IDPRODUTO").hide();
                    
                    apex.item("P527_QTDFISICACONTADA").disable();
                    apex.item("P527_QTDVIRTUALAGE").disable();
                    apex.item("P527_QTDOPTIMUSFISICO").disable();
                    apex.item("P527_DIVFISICOOPTIMUS").disable();
                    apex.item("P527_DIVFISICOFISCAL").disable();
                    apex.item("P527_DIVOPTIMUSFISCAL").disable();
                    apex.item("P527_VLRCUSTO").disable();
                    apex.item("P527_VLRAPAGAR").disable();
                    
                    if (vsit == "2") {
                    
                        apex.item("P527_QTDFISICACONTADA").enable();
                        apex.item("P527_QTDFISICACONTADA").setFocus();
                        apex.item("P527_QTDVIRTUALAGE").enable();
                    
                    } 
                    
                    if (vsit == "5") {
                    
                        apex.item("P527_IDPRODUTODETALHADO").disable();
                        
                    //    apex.item("P527_QTDVIRTUALAGE").setFocus();
                    //    apex.item("P527_QTDOPTIMUSFISICO").enable();
                    //    apex.item("P527_DIVFISICOOPTIMUS").enable();
                    //    apex.item("P527_DIVFISICOFISCAL").enable();
                    //    apex.item("P527_DIVOPTIMUSFISCAL").enable();
                        apex.item("P527_VLRCUSTO").enable();
                        apex.item("P527_VLRAPAGAR").enable();
                        
                    }
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction setasku (
        name: SetaSKU
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P527_IDPRODUTODETALHADO
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    v_sku number;
                    begin
                        begin
                            SELECT skuVirtualAge
                              INTO v_sku
                              FROM deparaprodfavoritavirtualage xx
                             WHERE xx.idprodutodetalhado = :P527_IDPRODUTODETALHADO;
                    
                        exception
                            when no_data_found then
                              begin
                                  SELECT dep.skuvirtualage
                                    INTO v_sku
                                    FROM deparaprodfavoritavirtualage dep
                                   WHERE dep.idprodutodetalhado = :P527_IDPRODUTODETALHADO ;
                              exception
                                when others then
                                  v_sku :=  6000000 + :P527_IDPRODUTODETALHADO;
                              end;
                        end;
                    return v_sku;
                    end;
                    ```
                itemsToSubmit: P527_IDPRODUTODETALHADO
            }
            affectedElements {
                selectionType: items
                items: P527_SKUVIRTUALAGE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select idEstoque 
                      from estoques e
                     where e.idFilialFavorita   = :P527_IDFILIAL
                       and e.idProdutoDetalhado = :P527_IDPRODUTODETALHADO
                    ```
                itemsToSubmit: [
                    P527_IDPRODUTODETALHADO
                    P527_IDFILIAL
                ]
            }
            affectedElements {
                selectionType: items
                items: P527_IDESTOQUE
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

