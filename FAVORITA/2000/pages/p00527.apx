        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 526
                items: {
                    P526_IDFILIAL: &P527_IDFILIAL.
                    P526_IDINVENTARIOCICLICO: &P527_IDINVENTARIOCICLICO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

