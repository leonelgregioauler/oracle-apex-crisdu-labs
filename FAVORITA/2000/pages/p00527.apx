    dynamicAction valorcusto (
        name: VALORCUSTO
        execution {
            sequence: 80
        }
        when {
            selectionType: items
            items: P527_IDPRODUTODETALHADO
        }

        action valorcusto (
            name: VALORCUSTO
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                      v_idpais          favorita.filiaisfavorita.idpais%type;
                      v_idedicaorevista favorita.edicoesrevistas.idedicaorevista%type;
                      v_idestoque       favorita.estoques.idestoque%type;
                      v_custo           number;
                    begin
                      -- país da filial (Brasil, Paraguai, Uruguai, Chile, Panamá...)
                      select f.idpais
                        into v_idpais
                        from favorita.filiaisfavorita f
                       where f.idfilialfavorita = :P527_IDFILIAL;
                    
                      -- edição vigente PARA ESSE PAÍS (tem uma edição vigente por país rodando ao mesmo
                      -- tempo, por isso não pode ser só MAX() sem filtrar país)
                      select max(idedicaorevista)
                        into v_idedicaorevista
                        from favorita.edicoesrevistas
                       where trunc(sysdate) between datainicial and datafinal
                         and idpais = v_idpais;
                    
                      -- estoque do produto nessa filial
                      select e.idestoque
                        into v_idestoque
                        from favorita.estoques e
                       where e.idfilialfavorita   = :P527_IDFILIAL
                         and e.idprodutodetalhado = :P527_IDPRODUTODETALHADO;
                    
                      v_custo := favorita.pck_integracao_fav_widecomm.fnc_buscavalorcomdesconto(
                                    v_idedicaorevista,
                                    :P527_IDPRODUTODETALHADO,
                                    v_idpais,
                                    v_idestoque
                                 ).valorcusto;
                    
                      return v_custo;
                    exception
                      when others then
                        return null;
                    end;
                    ```
                itemsToSubmit: [
                    P527_IDPRODUTODETALHADO
                    " P527_IDFILIAL"
                ]
            }
            affectedElements {
                selectionType: items
                items: P527_VLRCUSTO
            }
            execution {
                sequence: 10
            }
        )

    )

    process consulta-inventarios (
        name: Consulta Inventarios
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                v1 number;
                begin
                  --
                  if :P527_IDITENSINVENTARIOCICLICO is not null then
                    --
                    FAVORITA.PCK_CADASTROS_FAV.PRC_ITENSINVENTARIOCICLICO ( :P527_IDITENSINVENTARIOCICLICO      
                                                                          , :P527_IDINVENTARIOCICLICO        
                                                                          , :P527_IDESTOQUE
                                                                          , :P527_IDPRODUTODETALHADO
                                                                          , :P527_QTDFISICACONTADA              
                                                                          , :P527_QTDVIRTUALAGE                 
                                                                          , :P527_VLRCUSTO                      
                                                                          , :P527_DIVFISICOOPTIMUS              
                                                                          , :P527_DIVFISICOFISCAL               
                                                                          , :P527_DIVOPTIMUSFISCAL              
                                                                          , :P527_SKUVIRTUALAGE                 
                                                                          , :P527_QTDOPTIMUSFISICO              
                                                                          , :P527_VLRAPAGAR  
