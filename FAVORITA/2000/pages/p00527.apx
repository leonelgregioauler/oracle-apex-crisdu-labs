    process operação-dml-em-itens (
        name: Operação DML em Itens
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                
                  voperacao_dml  varchar2(1);
                  v_Itens         varchar2(4000);
                  v_sku          number;  
                  v_idprod       number;
                  v_idestoque    number;
                  
                begin
                
                  if v('REQUEST')    = 'INSERIR' then
                  
                    voperacao_dml := 'I';
                    
                    -- Valida se item já esta sendo inventariado
                    begin
                      select listagg(pck_util_fav.fnc_nomeprodutodetalhado(i.idprodutodetalhado, :P0_IDIDIOMA) ||' | ')
                                     within group ( order by i.idprodutodetalhado)
                             INTO v_Itens
                      from favorita.inventarioCiclico        c
                         , favorita.itensInventarioCiclico   i
                         , favorita.produtosdetalhados       pd
                         , favorita.produtos                 pr
                         , favorita.categorias               ct
                         , favorita.subcategorias            sc
                      where c.idInventarioCiclico = i.idInventarioCiclico
                        and i.idprodutodetalhado = pd.idprodutodetalhado
                        and pr.idcategoria = ct.idcategoria
                        and pr.idsubcategoria = sc.idsubcategoria(+)
                        and pd.idproduto = pr.idproduto
                        and c.idFilial = :P527_IDFILIAL
                        and c.idTipoSituacao not in (5)
                        and ( i.idProdutoDetalhado = :P527_IDPRODUTODETALHADO and :P527_TIPOPRODUTO = 'S' 
                           or pd.idproduto         = :P527_IDPRODUTO          and :P527_TIPOPRODUTO = 'P'
                           or ct.idcategoriasite   = :P527_IDCATEGORIA        and :P527_TIPOPRODUTO = 'C'
                           or sc.idsubcategoria    = :P527_IDSUBCATEGORIA     and :P527_TIPOPRODUTO = 'SC' );
                      exception
                         when others then v_Itens := null;
                    end;
                    --
                    if v_Itens is not null then
                       --
                       raise_application_error(-20001,'Item(s) já sendo inventariado(s)! '||v_Itens);
                       --
                    end if;
                    --
                    v_itens := null;
                    --
                    begin
                      --
                      select listagg(pck_util_fav.fnc_nomeprodutodetalhado(i.idprodutodetalhado, :P0_IDIDIOMA) ||' | ')
                                     within group ( order by i.idprodutodetalhado)
                        into v_Itens
                      from favorita.inventarioCiclico        c
                         , favorita.itensInventarioCiclico   i
                         , favorita.produtosdetalhados       pd
                         , favorita.produtos                 pr
                         , favorita.categorias               ct
                         , favorita.subcategorias            sc
                      where c.idInventarioCiclico = i.idInventarioCiclico
                        and i.idprodutodetalhado = pd.idprodutodetalhado
                        and pd.idproduto = pr.idproduto
                        and pr.idcategoria = ct.idcategoria
                        and pr.idsubcategoria = sc.idsubcategoria(+)
                        and c.idFilial  = :P527_IDFILIAL
                        and c.idTipoSituacao not in (5)
                        and ( i.idProdutoDetalhado = :P527_IDPRODUTODETALHADO and :P527_TIPOPRODUTO = 'S' 
                           or pd.idproduto         = :P527_IDPRODUTO          and :P527_TIPOPRODUTO = 'P'
                           or ct.idcategoriasite   = :P527_IDCATEGORIA        and :P527_TIPOPRODUTO = 'C'
                           or sc.idsubcategoria    = :P527_IDSUBCATEGORIA     and :P527_TIPOPRODUTO = 'SC' ) 
                        and not exists ( select 1 
                                         from estoques e
                                         where e.idFilialFavorita   = c.idFilial
                                           and e.idProdutoDetalhado = i.idprodutodetalhado );
                    exception
                      when others then raise_application_error(-20001,'Nao tem valor de IDESTOQUE PARA filial '||:P527_IDFILIAL||' e produto '||v_Itens);
                    end;
                
                    
                  elsif v('REQUEST') = 'ATUALIZAR' then
                  
                    voperacao_dml := 'U';
                    
                  elsif v('REQUEST') = 'EXCLUIR' then
                
                    voperacao_dml := 'D';
                    
                  end if;
                  --
                  
                  for c1 in ( select pd.idprodutodetalhado
                              from favorita.produtosdetalhados pd
                                 , favorita.produtos           pr
                                 , favorita.categorias         ct
                                 , favorita.subcategorias      sc
                              where pd.idproduto = pr.idproduto
                                and pr.idcategoria = ct.idcategoria
                                and pr.idsubcategoria = sc.idsubcategoria(+)
                                and ( pd.idprodutodetalhado = :P527_IDPRODUTODETALHADO and :P527_TIPOPRODUTO = 'S' 
                                  or  pd.idproduto          = :P527_IDPRODUTO          and :P527_TIPOPRODUTO = 'P'
                                  or  ct.idcategoriasite    = :P527_IDCATEGORIA        and :P527_TIPOPRODUTO = 'C'
                                  or  sc.idsubcategoria     = :P527_IDSUBCATEGORIA     and :P527_TIPOPRODUTO = 'SC' )  
                             ) loop
                      
                      begin
                        SELECT skuVirtualAge
                          INTO v_sku
                          FROM deparaprodfavoritavirtualage xx
                         WHERE xx.idprodutodetalhado = c1.idprodutodetalhado;
                
                      exception
                        when no_data_found then
                           v_sku :=  6000000 + c1.idprodutodetalhado;
                      end;
                      --
                      SELECT idEstoque 
                        INTO v_idestoque
                        FROM estoques e
                       WHERE e.idFilialFavorita   = :P527_IDFILIAL
                         AND e.idProdutoDetalhado = c1.idprodutodetalhado;
                      --
                      v_idprod := c1.idprodutodetalhado;
                      
                      FAVORITA.PCK_CADASTROS_FAV.PRC_ITENSINVENTARIOCICLICO (  PIDITENSINVENTARIOCICLICO => :P527_IDITENSINVENTARIOCICLICO 
                                                                             , PIDINVENTARIOCICLICO      => :P527_idinventariociclico
                                                                             , PIDESTOQUE                => v_idestoque --:P527_IDESTOQUE                
                                                                             , PQTDFISICACONTADA         => :P527_QTDFISICACONTADA
                                                                             , PIDPRODUTODETALHADO       => v_idprod --:P527_IDPRODUTODETALHADO
                                                                             , PQTDVIRTUALAGE            => :P527_QTDVIRTUALAGE            
                                                                             , PVLRCUSTO                 => :P527_VLRCUSTO                 
                                                                             , PDIVFISICOOPTIMUS         => :P527_DIVFISICOOPTIMUS         
                                                                             , PDIVFISICOFISCAL          => :P527_DIVFISICOFISCAL          
                                                                             , PDIVOPTIMUSFISCAL         => :P527_DIVOPTIMUSFISCAL         
                                                                             , PSKUVIRTUALAGE            => v_sku --:P527_SKUVIRTUALAGE            
                                                                             , PQTDOPTIMUSFISICO         => :P527_QTDOPTIMUSFISICO   
                                                                             , PVLRAPAGAR                => :P527_VLRAPAGAR 
                                                                             , PIDCATEGORIA              => :P527_IDCATEGORIA
                                                                             , PMD5                      => :P527_PMD5                     
                                                                             , POPERACAO_DML             => voperacao_dml ) ;
                
                  end loop;
                  
                
                  if voperacao_dml = 'I' then -- limpa campos para nova entrada. Só não limpa o idInventario
                  
                    :P527_IDITENSINVENTARIOCICLICO := null;
                    :P527_IDESTOQUE                := null;
                    :P527_IDPRODUTODETALHADO       := null;
                    :P527_QTDFISICACONTADA         := null;
                    :P527_QTDVIRTUALAGE            := null;
                    :P527_VLRCUSTO                 := null;
                    :P527_DIVFISICOOPTIMUS         := null;
                    :P527_DIVFISICOFISCAL          := null;
                    :P527_DIVOPTIMUSFISCAL         := null;
                    :P527_SKUVIRTUALAGE            := null;
                    :P527_QTDOPTIMUSFISICO         := null;
                    :P527_VLRAPAGAR                := null;
                    :P527_IDCATEGORIA              := null;
                    :P527_IDSUBCATEGORIA           := null;
                    
                  end if;
                  
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Ação de &REQUEST. realizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 12737381528565466
        }
    )

