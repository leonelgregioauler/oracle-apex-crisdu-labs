    process getidestoque (
        name: getIdEstoque
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                --
                -- Criado pelo fato de um erro do javascript nao conseguir executar na segunda insercao, o select que busca o id do estoque.
                --
                if :P527_IDESTOQUE is null and :P527_IDPRODUTODETALHADO is not null then
                
                    begin
                        select idEstoque into :P527_IDESTOQUE
                          from estoques e
                         where e.idFilialFavorita   = :P527_IDFILIAL
                           and e.idProdutoDetalhado = :P527_IDPRODUTODETALHADO;
                    exception
                      when others then raise_application_error(-20001,'Nao tem valor de IDESTOQUE PARA filial '||:P527_IDFILIAL||' e produto '||:P527_IDPRODUTODETALHADO);
                    end;
                end if;
                
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 12946233750554410
        }
    )

