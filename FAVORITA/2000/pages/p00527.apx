    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 40
            region: @itens-inventario
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P527_IDITENSINVENTARIOCICLICO
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 30
            region: @itens-inventario
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Confirma exclusão do item?','EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P527_IDITENSINVENTARIOCICLICO
