page 527 (
    name: Itens do Inventário
    title: Itens do Inventário
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 50%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    css {
        inline: ".t-Region-body { background-color: Beige !important;},"
    }
    security {
        pageAccessProtection: unrestricted
    }

    region itens-inventario (
        name: Itens Inventario
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P527_DIVFISICOFISCAL (
        type: numberField
        label {
            label: Divergência Físico/Fiscal
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 120
            region: @itens-inventario
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G990D00
            width: 15
        }
        security {
            encryptSessionState: false
        }
    )

