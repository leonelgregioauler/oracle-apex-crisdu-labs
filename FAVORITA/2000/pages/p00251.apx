    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 10
            region: @movimentar-estoque
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 239
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button movimentar (
        buttonName: MOVIMENTAR
        label: Movimentar
        layout {
            sequence: 20
            region: @movimentar-estoque
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction tipo-movimento (
        name: Tipo movimento
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P251_TIPOMOVIMENTO
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P251_TIPOMOVIMENTO
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P251_QUANTIDADE
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P251_QUANTIDADE
            }
            execution {
                sequence: 10
            }
        )

    )

    validation estoque-obrigatório (
        name: ESTOQUE obrigatório
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P251_IDFILIALFAVORITA
        }
        error {
            errorMessage: Estoque deve ter um valor.
            associatedItem: @P251_IDFILIALFAVORITA
        }
    )

    validation motivo-maior-que-20-caracteres (
        name: MOTIVO maior que 20 caracteres
        execution {
            sequence: 70
        }
        validation {
            plsqlExpression: length(:P251_MOTIVO) > 20
        }
        error {
            errorMessage: Motivo deve ter mais do que 20 caracteres.
            associatedItem: @P251_MOTIVO
        }
    )

    validation motivo-obrigatório (
        name: MOTIVO obrigatório
        execution {
            sequence: 80
        }
        validation {
            type: itemIsNotNull
            item: P251_MOTIVO
        }
        error {
            errorMessage: Motivo deve ter um valor.
            associatedItem: @P251_MOTIVO
        }
    )

    validation produto-obrigatório (
        name: PRODUTO obrigatório
        execution {
            sequence: 60
        }
        validation {
            type: itemIsNotNull
            item: P251_IDPRODUTODETALHADO
        }
        error {
            errorMessage: Produto deve ter um valor.
            associatedItem: @P251_IDPRODUTODETALHADO
        }
    )

    validation qtd-entrada-não-deve-ser-maior-que-qtd-estoque (
        name: QTD ENTRADA NÃO DEVE SER MAIOR QUE QTD ESTOQUE
        execution {
            sequence: 110
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from dual
                 where (   (:P251_TIPOMOVIMENTO = 'S')
                        or (:P251_TIPOMOVIMENTO = 'E' and :P251_QUANTIDADE <= nvl((select e.quantidade
                                                                                     from favorita.estoques e
                                                                                    where e.idfilialfavorita   = :P251_IDFILIALFAVORITA
                                                                                      and e.idprodutodetalhado = :P251_IDPRODUTODETALHADO),0)));
                ```
        }
        error {
            errorMessage: Atenção! A quantidade de movimento ENTRADA para defeito não pode exceder o estoque disponível.
        }
        serverSideCondition {
            whenButtonPressed: @movimentar
        }
    )

    validation quantidade-inteiro (
        name: QUANTIDADE inteiro
        execution {
            sequence: 90
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  verro varchar2(1000);
                begin
                  if instr(:P251_QUANTIDADE, ',') > 0 or
                     instr(:P251_QUANTIDADE,'.') > 0 then
                    --
                    return 'Quantidade deve ser um número inteiro';
                    --
                  else
                    null;
                  end if;
                end;
                ```
        }
        error {
            associatedItem: @P251_QUANTIDADE
        }
    )

    validation quantidade-maior-que (
        name: QUANTIDADE maior que 0
        execution {
            sequence: 100
        }
        validation {
            plsqlExpression: :P251_QUANTIDADE > 0
        }
        error {
            errorMessage: "Quantidade deve ser maior que zero (0) "
            associatedItem: @P251_QUANTIDADE
        }
        serverSideCondition {
            type: expression
            plsqlExpression: instr(:P251_QUANTIDADE, '.') = 0
        }
    )

    validation quantidade-obrigatório (
        name: QUANTIDADE obrigatório
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P251_QUANTIDADE
        }
        error {
            errorMessage: Quantidade deve ser informada.
            associatedItem: @P251_QUANTIDADE
        }
    )

    validation tipomovimento-obrigatório (
        name: TIPOMOVIMENTO obrigatório
        execution {
            sequence: 50
        }
        validation {
            type: itemIsNotNull
            item: P251_TIPOMOVIMENTO
        }
        error {
            errorMessage: Selecione o tipo de movimento.
            associatedItem: @P251_TIPOMOVIMENTO
        }
    )

    process processo-dml-para-movimentar-estoque-defeito (
        name: Processo DML para Movimentar Estoque Defeito
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    v_idestoque number;
                    v_motivo    varchar2(300);
                begin
                    -- quando for (E)ntrada: Significa que deve entrar no estoque defeito e sair do estoque loja
                    -- quando for (S)aída: Significa que devesair do estoque defeito, e não precisa entrar no estoque da loja.
                
                
                    -- Ajusta a quantidade para ESTOQUE DEFEITO, se ENTRADA (valor positivo), se SAÍDA (valor negativo)
                    if :P251_TIPOMOVIMENTO = 'S' then
                        :P251_QUANTIDADE := to_number(:P251_QUANTIDADE)*-1;
                        v_motivo := 'Retorno ao estoque, saiu do estoque defeito e retornou para estoque da loja.';
                    end if;
                
                    -- Movimnenta o estoque defeito
                    favorita.pck_estoque_fav.prc_movimentosestoquesdefeitos( pidestoquedefeito => null,
                                                                             pidfilialfavorita => :P251_IDFILIALFAVORITA,
                                                                             piddefeito => :P251_IDDEFEITO,
                                                                             pidusuario => :P0_IDUSUARIO,
                                                                             pidprodutodetalhado => :P251_IDPRODUTODETALHADO,
                                                                             piditemdevolucaopedido => null,
                                                                             piditemcompratransferencia => null,
                                                                             piditempedidotrocado => null,
                                                                             pquantidade => :P251_QUANTIDADE,
                                                                             pmotivo => :P251_MOTIVO);
                
                    -- 9495715 -- Maicon Aimi -- 21/01/2025 (INICIO)
                    if :P251_TIPOMOVIMENTO = 'E' then
                        
                        -- Busca dados para serem usados nos parametros da prc_movimentosestoques
                        select e.idestoque
                          into v_idestoque
                          from favorita.estoques e
                         where e.idprodutodetalhado = :P251_IDPRODUTODETALHADO
                           and e.idfilialfavorita   = :P251_IDFILIALFAVORITA;
                
                        -- Ajusta a quantidade para ESTOQUE loja, se ENTRADA (valor NEGATIVO), se SAÍDA (valor POSITIVO)
                        :P251_QUANTIDADE := to_number(:P251_QUANTIDADE)*-1;
                        v_motivo := 'Saida de estoque, produto foi enviado ao estoque defeito.';
                        
                        -- Movimenta o estoque da filial favorita
                        favorita.pck_estoque_fav.prc_movimentosestoques( pidestoque           => v_idestoque,
                                                                         pidfilialfavorita    => :P251_IDFILIALFAVORITA,
                                                                         pidusuario           => :P0_IDUSUARIO,
                                                                         pidprodutodetalhado  => :P251_IDPRODUTODETALHADO,
                                                                         piditempedido        => null,
                                                                         piditemcompratransf  => null,
                                                                         pquantidade          => :P251_QUANTIDADE,
                                                                         pmotivo              => v_motivo,
                                                                         piditeminventciclico => null);
                        
                    end if;
                    -- 9495715 -- Maicon Aimi -- 21/01/2025 (FIM)
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 766990021540868029
        }
        serverSideCondition {
            whenButtonPressed: @movimentar
        }
    )

)

