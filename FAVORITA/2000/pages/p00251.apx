page 251 (
    name: Movimentações de Estoque Defeitos
    title: Movimentações de Estoque Defeitos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function confirmaitem(event)
            {
             var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
             console.log (tecla);
             if (tecla==13) 
             { 
              var answer = confirm("Confirma inclusão do item no estoque de defeito ?")
              if (answer)
              {
                apex.submit('CREATE');
              }
             } 
              else 
              { if([190,188,110,194].indexOf(tecla) !=-1) 
                {
                 alert('Informe uma Quantidade Válida!'); 
                 return false;
                }
              }
            }
            
            function tem_casas_decimais(valor)
            {
             if (typeof(valor) != 'String')
              valor = valor.toString();
            
             return valor.match(/[.,]/) != null;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region movimentar-estoque (
        name: Movimentar Estoque
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P251_IDDEFEITO (
        type: plugin/select
        label {
            label: Defeito
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select descricao d
                     , iddefeito r
                from defeitos d
                where aparecer = 'S'
                order by 1 
                ```
        }
        layout {
            sequence: 30
            region: @movimentar-estoque
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P251_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Estoque
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomefilialfavorita display_value
                     , idfilialfavorita  return_value
                from vw_filiaisfavorita w
                where exists ( select 1
                               from usuariosfiliaisfavorita u
                               where u.idfilialfavorita = w.idfilialfavorita
                                 and u.movimentar = 'S'
                                 and u.idusuario = :P0_IDUSUARIO )
                order by 1
                ```
            nullDisplayValue: " - Selecione o Estoque- "
        }
        layout {
            sequence: 20
            region: @movimentar-estoque
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P251_IDPRODUTODETALHADO (
        type: plugin/select
        label {
            label: Produto
            alignment: left
        }
        settings {
            width: 450
        }
        lov {
            type: sharedComponent
            lov: @lov-produtosdetalhados
            displayExtraValues: false
            nullDisplayValue: "- Selecione o Produto - "
        }
        cascadingLov {
            parentItems: P251_IDFILIALFAVORITA
        }
        layout {
            sequence: 40
            region: @movimentar-estoque
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P251_MOTIVO (
        type: textarea
