page 15 (
    name: Relatório de Filiais Favorita
    title: Filiais Favorita
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filiais-favorita (
        name: Filiais Favorita
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ff.idfilialfavorita 
                     , ff.nomefilialfavorita
                     , ff.idfilialromance
                     , ff.ativo
                     , ff.nomeantigo
                     , ff.cep
                     , ff.tipofilial
                     , ff.pais
                     , null formaspagamentos
                     , null formasentregas
                     , ff.idregionalfavorita
                     , ff.data_inauguracao
                     , ff.metragem_total_loja
                     , ff.metragem_exposicao_loja
                from favorita.vw_filiaisfavorita ff
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 11921219254031004
        }

        savedReport 17891662 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDFILIALFAVORITA
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @NOMEFILIALFAVORITA
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDFILIALROMANCE
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @ATIVO
                layout {
                    width: 81
                    sequence: 3
                }
            )

            displayColumn (
                column: @NOMEANTIGO
                layout {
                    show: false
                    sequence: 4
                }
            )

            displayColumn (
                column: @CEP
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @FORMASPAGAMENTOS
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @FORMASENTREGAS
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @TIPOFILIAL
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @PAIS
                layout {
                    show: false
                    sequence: 8
                }
            )

            displayColumn (
                column: @DATA_INAUGURACAO
                layout {
                    sequence: 11
                }
            )

            displayColumn (
                column: @METRAGEM_TOTAL_LOJA
                layout {
                    sequence: 12
                }
            )

            displayColumn (
                column: @METRAGEM_EXPOSICAO_LOJA
                layout {
                    sequence: 13
                }
            )

            displayColumn (
                column: @IDREGIONALFAVORITA
                layout {
                    sequence: 10
                }
            )

            controlBreak (
                column: @PAIS
                sort {
                    nulls: last
                }
                layout {
                    sequence: 5
                }
            )

        )

        column ATIVO (
            type: textField
            heading {
                heading: Ativo
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            validation {
                maxLength: 3
            }
            source {
                databaseColumn: ATIVO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column CEP (
            type: textField
            heading {
                heading: CEP
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: CEP
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column DATA_INAUGURACAO (
            type: datePicker
            heading {
                heading: Data de Inauguração
                alignment: center
            }
            layout {
                sequence: 140
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/YYYY
            }
            source {
                databaseColumn: DATA_INAUGURACAO
                dataType: date
            }
        )

        column FORMASENTREGAS (
            type: link
            heading {
                heading: Formas de Entrega
                alignment: center
            }
            layout {
                sequence: 120
                columnAlignment: center
            }
            link {
                target: {
                    page: 138
                    items: {
                        P138_IDFILIALFAVORITA: &IDFILIALFAVORITA.
                    }
                    action: resetPagination
                }
                linkText: <b>Formas de Entrega</b>
                linkAttributes: class="t-Button t-Button--sucess"
            }
            source {
                databaseColumn: FORMASENTREGAS
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column FORMASPAGAMENTOS (
            type: link
            heading {
                heading: Formas de Pagamento
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: center
            }
            link {
                target: {
                    page: 75
                    items: {
                        P75_IDFILIALFAVORITA: &IDFILIALFAVORITA.
                    }
                    action: resetPagination
                }
                linkText: <b>Formas de Pagamento</b>
                linkAttributes: class="t-Button t-Button--sucess"
            }
            source {
                databaseColumn: FORMASPAGAMENTOS
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column IDFILIALFAVORITA (
            type: link
            heading {
                heading: Editar
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            link {
                target: {
                    page: 16
                    items: {
                        P16_IDFILIALFAVORITA: &IDFILIALFAVORITA.
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                databaseColumn: IDFILIALFAVORITA
                dataType: number
            }
        )

        column IDFILIALROMANCE (
            type: hidden
            layout {
                sequence: 50
            }
            source {
                databaseColumn: IDFILIALROMANCE
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDREGIONALFAVORITA (
            type: selectList
            heading {
                heading: Regional
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select f.descricaoregionalfavorita display_value,
                           f.idregionalfavorita return_value
                      from favorita.regionaislojasfavorita f
                     order by f.descricaoregionalfavorita;
                    ```
            }
            layout {
                sequence: 130
            }
            source {
                databaseColumn: IDREGIONALFAVORITA
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column METRAGEM_EXPOSICAO_LOJA (
            type: numberField
            heading {
                heading: Metragem Exposição Loja
                alignment: center
            }
            layout {
                sequence: 160
                columnAlignment: center
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                databaseColumn: METRAGEM_EXPOSICAO_LOJA
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column METRAGEM_TOTAL_LOJA (
            type: numberField
            heading {
                heading: Metragem Total Loja
                alignment: center
            }
            layout {
                sequence: 150
                columnAlignment: center
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                databaseColumn: METRAGEM_TOTAL_LOJA
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column NOMEANTIGO (
            type: textarea
            heading {
                heading: Nome Antigo
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: NOMEANTIGO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column NOMEFILIALFAVORITA (
            type: textarea
            heading {
                heading: Nome Filial Favorita
                alignment: center
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
                maxLength: 100
            }
            source {
                databaseColumn: NOMEFILIALFAVORITA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column PAIS (
            type: textarea
            heading {
                heading: País
                alignment: center
            }
            layout {
                sequence: 100
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: PAIS
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
        )

        column TIPOFILIAL (
            type: textField
            heading {
                heading: Tipo Filial
                alignment: center
            }
            layout {
                sequence: 90
            }
            validation {
                maxLength: 14
            }
            source {
                databaseColumn: TIPOFILIAL
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

    )

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
                t-Button--padTop
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 16
                items: {
                    P16_IDFILIALFAVORITA: &P16_IDFILIALFAVORITA.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button regional-loja-favorita (
        buttonName: REGIONAL_LOJA_FAVORITA
        label: Regional Loja Favorita
        layout {
            sequence: 20
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 633
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

