page 430 (
    name: Atendimento Por Estado
    title: Atendimento Por Estado
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region atendimentos-de-atendentes-por-estado (
        name: "Atendimentos de Atendentes Por Estado "
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDATENDIMENTOESTADOSAC
                     , IDUSUARIO
                     , IDESTADO
                from ATENDIMENTOSESTADOSSAC a
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 5992460428724510
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDATENDIMENTOESTADOSAC
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDUSUARIO
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDESTADO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @ROWID
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column IDATENDIMENTOESTADOSAC (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDATENDIMENTOESTADOSAC
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: SEQ_IDATENDIMENTOESTADOSAC
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDESTADO (
            type: selectList
            heading {
                heading: Estado
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select e.nome||'/'||e.sigla d
                         , e.idestado r
                    from catal.estados e
                    where e.idpais = 1
                    order by 1
                    ```
            }
            layout {
                sequence: 60
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDESTADO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDUSUARIO (
            type: selectList
            heading {
                heading: Atendente
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select initcap(p.nomepessoa) d
                         , u.idusuario r
                    from usuarios u
                       , pessoas p
                    where u.idpessoa = p.idpessoa
                      and u.ativo    = 'S'
                      and exists ( select 1
                                   from roman.usuariosgruposatendimento ug
                                   where ug.idgrupoatendimento = 9
                                     and ug.usuario            = u.usuario )
                    order by 1    
                    ```
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDUSUARIO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column ROWID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ROWID
                dataType: rowid
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

    )

    process atendimentos-de-atendentes-por-estado-save-interactive-grid-data (
        name: Atendimentos de Atendentes Por Estado  - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @atendimentos-de-atendentes-por-estado
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 5993166793724517
        }
    )

)

