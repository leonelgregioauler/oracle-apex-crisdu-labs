page 131 (
    name: 1a Etapa
    title: Primeira Etapa
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region novo-protocolo-de-atendimento (
        name: Novo Protocolo de Atendimento
        type: list
        source {
            list: @novo-protocolo-de-atendimento
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    region tipo-de-protocolo (
        name: Tipo de Protocolo
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P131_IDPROTOCOLOATENDIMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @tipo-de-protocolo
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P131_IDTIPOPROTOCOLO (
        type: radioGroup
        label {
            alignment: left
        }
        settings {
            pageActionOnSelection: submitPage
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_retornatipoprotocolo(t.idtipoprotocolo,:P0_IDIDIOMA) display_value
                 , t.idtipoprotocolo return_value
                from tiposprotocolosatendimentos t
                where exists ( select 1
                               from permissoestiposprotocolos p
                               where p.idtipoprotocolo = t.idtipoprotocolo
                                 and p.idusuario = :P0_IDUSUARIO 
                                 and p.criar     = 'S' )
                order by idtipoprotocolo
                ```
            displayNullValue: false
        }
        layout {
            sequence: 120
            region: @tipo-de-protocolo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            cssClasses: [
                text-align:
                center
            ]
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    button proximo (
        buttonName: PROXIMO
        label: Próximo Passo
        layout {
            sequence: 10
            region: @tipo-de-protocolo
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    branch (
        name: go to page 132
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 132
                items: {
                    P132_IDPROTOCOLOATENDIMENTO: &P131_IDPROTOCOLOATENDIMENTO.
                    P132_IDTIPOPROTOCOLO: &P131_IDTIPOPROTOCOLO.
                    P132_CPF:
                    P132_IDVENDEDORA:
                    P132_NUMEROPEDIDO:
                    P132_DOCESTRANGEIRO:
                    P132_ETIQUETA: S
                    P132_CODBARRASPEDIDO:
                    P132_DOCESTRANGEIRO_ETIQUETA:
                    P132_IDPEDIDO_ETIQUETA:
                    P132_IDVENDEDORA_ETIQUETA:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P131_IDTIPOPROTOCOLO not in 11
        }
    )

    branch (
        name: go to page 133
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 133
                items: {
                    P133_IDPROTOCOLOATENDIMENTO: &P131_IDPROTOCOLOATENDIMENTO.
                    P133_IDTIPOPROTOCOLO: &P131_IDTIPOPROTOCOLO.
                    P133_NUMEROCOMPROVANTE:
                    P133_CONTAPAGAMENTO:
                    P133_DATAPAGAMENTO:
                    P133_VALORDEPOSITADO:
                    P133_JUSTIFICATIVA:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P131_IDTIPOPROTOCOLO = 11
        }
    )

)

