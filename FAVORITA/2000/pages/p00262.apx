page 262 (
    name: Inserir Despesa
    title: Inserir Despesa
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 65%
        height: 65%
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='Deseja realmente deletar esta despesa?';
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region inserir-nova-despesa (
        name: Inserir Nova Despesa
        type: staticContent
        layout {
            sequence: 10
            slot: body-3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P262_ANO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @inserir-nova-despesa
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ANO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                return to_char(sysdate,'RRRR');
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P262_DATAVENCIMENTO (
        type: datePickerJquery
        label {
            label: Data Vencimento
            alignment: left
        }
        layout {
            sequence: 100
            region: @inserir-nova-despesa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 10
        }
        validation {
            maxLength: 4000
        }
        source {
            type: databaseColumn
            databaseColumn: DATAVENCIMENTO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                return trunc(sysdate);
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P262_DESCRICAOORIGEM (
        type: displayOnly
        label {
            label: Descr. Origem
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 175
            region: @inserir-nova-despesa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: DESCRICAOORIGEM
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P262_IDCONTACONTABIL (
        type: selectList
        label {
            label: Conta Contábil
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(c.nomeconta) display_value
                     , c.idcontafinan  return_value
                from roman.contasfinanceiras c
                where c.debitocredito = 'D'
                AND ATIVO = 'S'
                order by 1
                ```
            nullDisplayValue: - Selecione a Conta Contábil -
        }
        layout {
            sequence: 80
            region: @inserir-nova-despesa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDCONTACONTABIL
            used: always
        }
        readOnly {
            type: itemIsNotNull
            item: P262_IDREPRESENTANTE
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P262_IDDESPESA (
        type: textField
        label {
            label: ID Controle
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 10
            region: @inserir-nova-despesa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 2000
        }
        advanced {
            customAttributes: readonly
        }
        source {
            type: databaseColumn
            databaseColumn: IDDESPESA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P262_IDENTRADADIVERSA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 165
            region: @inserir-nova-despesa
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDENTRADADIVERSA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P262_IDFECHAMENTO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @inserir-nova-despesa
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFECHAMENTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P262_IDFECHAMENTOREPRES (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @inserir-nova-despesa
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFECHAMENTOREPRES
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P262_IDFILIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @inserir-nova-despesa
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P262_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @inserir-nova-despesa
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDREPRESENTANTE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P262_IDSUBCONTACONTABIL (
        type: selectList
        label {
            label: Sub Conta
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(c.nomeconta) display_value
                     , c.idSUBcontafinan  return_value
                from roman.SUBcontasfinanceiras c
                where c.debitocredito = 'D'
                AND IDCONTAFINAN = :P262_IDCONTACONTABIL
                  AND ATIVO = 'S'
                order by 1
                ```
            nullDisplayValue: - Selecione a Conta Contábil -
        }
        cascadingLov {
            parentItems: P262_IDCONTACONTABIL
        }
        layout {
            sequence: 90
            region: @inserir-nova-despesa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDSUBCONTACONTABIL
            used: always
        }
        readOnly {
            type: itemIsNotNull
            item: P262_IDREPRESENTANTE
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P262_OBSERVACAO (
        type: textField
        label {
            label: Descrição
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 120
            region: @inserir-nova-despesa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
        }
        validation {
            maxLength: 200
        }
        source {
            type: databaseColumn
            databaseColumn: OBSERVACAO
            used: always
        }
        readOnly {
            type: itemIsNotNull
            item: P262_IDREPRESENTANTE
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P262_SEMANA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @inserir-nova-despesa
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: SEMANA
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                return to_char(sysdate,'IW')||'/'||to_char(sysdate,'RRRR');
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P262_VALOR (
        type: numberField
        label {
            label: Valor
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 110
            region: @inserir-nova-despesa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 12
        }
        validation {
            maxLength: 255
        }
        advanced {
            customAttributes: style="text-align: right;"
        }
        source {
            type: databaseColumn
            databaseColumn: VALOR
            used: always
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P262_IDREPRESENTANTE is not null
                 or :P262_IDENTRADADIVERSA is not null
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Fechar e Atualizar
        layout {
            sequence: 10
            region: @inserir-nova-despesa
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 245
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Inserir
        layout {
            sequence: 40
            region: @inserir-nova-despesa
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P262_IDDESPESA
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @inserir-nova-despesa
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P262_IDDESPESA is not null
                and :P262_IDREPRESENTANTE is null
                and :P262_IDENTRADADIVERSA is null
                and exists ( select 1 
                             from fechamentossemanais f
                             where idfechamento = :P262_IDFECHAMENTO
                               and concluido = 'N')
                ```
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 60
            region: @inserir-nova-despesa
            slot: aboveBox
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 262
                items: {
                    P262_SEMANA: &P262_SEMANA.
                    P262_IDFILIAL: &P262_IDFILIAL.
                    P262_IDDESPESA:
                    P262_IDFECHAMENTO: &P262_IDFECHAMENTO.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentossemanais
                where idfechamento = :P262_IDFECHAMENTO
                  AND CONCLUIDO = 'N'
                ```
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @inserir-nova-despesa
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P262_IDDESPESA is not null
                and :P262_IDREPRESENTANTE is null
                and exists ( select 1 
                             from fechamentossemanais f
                             where idfechamento = :P262_IDFECHAMENTO
                               and concluido = 'N')
                ```
        }
    )

    validation p262-idsubcontacontabil (
        name: P262_IDSUBCONTACONTABIL
        execution {
            sequence: 120
        }
        validation {
            type: itemIsNotNull
            item: P262_IDSUBCONTACONTABIL
        }
        error {
            errorMessage: #LABEL# deve ser informada!
            associatedItem: @P262_IDSUBCONTACONTABIL
        }
        serverSideCondition {
            type: never
        }
    )

    validation saldo (
        name: Saldo
        execution {
            sequence: 130
        }
        validation {
            type: itemIsNotNullOrZero
            item: P262_VALOR
        }
        error {
            errorMessage: Informe o valor corretamente!
        }
    )

    validation valida-semana-fechada (
        name: valida semana fechada
        execution {
            sequence: 140
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.fechamentossemanais
                where idfechamento = :P262_IDFECHAMENTO
                  AND CONCLUIDO = 'N'
                ```
        }
        error {
            errorMessage: A semana que está incluindo esta despesa já está fechada, feche esta tela, selecione uma semana em aberto, e clique em nova despesa.
        }
    )

    process atualiza-fechamentos (
        name: atualiza fechamentos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  pck_fechamentos_fav.prc_atualiza_gavetas ( :P262_IDFECHAMENTO );
                exception 
                  when others then 
                    null;
                end;
                ```
        }
        execution {
            sequence: 50
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 766580377532191556
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P262_IDFECHAMENTO
        }
    )

    process fetch-row-from-despesas (
        name: Fetch Row from DESPESAS
        type: autoRowFetch
        source {
            tableOwner: ROMAN
            tableName: DESPESAS
            pkColumn: IDDESPESA
            pkItem: P262_IDDESPESA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        error {
            errorMessage: Unable to fetch row.
        }
        advanced {
            executionMappingIdentifier: 766579959496191555
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  function get_pk return varchar2 
                  is 
                  begin 
                    for c1 in (select roman.SEQ_IDDESPESAS.nextval next_val
                               from dual)
                    loop
                        return c1.next_val;
                    end loop;
                  end; 
                begin 
                  :P262_IDDESPESA := get_pk; 
                end; 
                ```
        }
        execution {
            sequence: 10
        }
        error {
            errorMessage: Unable to get primary key item value.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 766578756493191555
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-despesas (
        name: Process Row of DESPESAS
        type: autoRowProcessing
        target {
            tableOwner: ROMAN
            tableName: DESPESAS
            pkColumn: IDDESPESA
            pkItem: P262_IDDESPESA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Despesa salva com sucesso!
        }
        error {
            errorMessage: Ocorreu um erro ao salvar a despesa.
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 766579145664191555
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        clear {
            type: pages
            pages: 60
        }
        execution {
            sequence: 40
            point: newSession
        }
        advanced {
            executionMappingIdentifier: 766579585562191555
        }
        serverSideCondition {
            whenButtonPressed: @delete
            type: never
        }
    )

    branch (
        name: Go To Page 249
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 249
                items: {
                    P249_SEMANA: &P249_SEMANA.
                    P249_IDDESPESA:
                    P249_IDFECHAMENTO: &P249_IDFECHAMENTO.
                }
                action: resetPagination
            }
        }
    )

)

