page 273 (
    name: Tempo Trabalhado
    title: Tempo Trabalhado
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region tarefas-atendidas (
        name: Tarefas Atendidas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeusuario(h.idusuario) atendente
                     , trunc(( sum(h.datafim - h.datainicio) * 86400 / 3600)) ||':' || 
                                        trunc(mod( sum(h.datafim - h.datainicio) * 86400 , 3600 ) / 60 ) || ':'|| 
                                        trunc(mod ( mod ( sum(h.datafim - h.datainicio) * 86400, 3600 ), 60 )) tempo
                     , round(trunc(( sum(h.datafim - h.datainicio) * 86400 )) *100/21600 * (decode((to_date(:P273_DATAFIM,'dd/mm/rrrr') - to_date(:P273_DATAINICIO,'dd/mm/rrrr')),0,1,(to_date(:P273_DATAFIM,'dd/mm/rrrr') - to_date(:P273_DATAINICIO,'dd/mm/rrrr')))),2) perctempo
                     , count(distinct(t.idtarefa)) qtd
                from historicostarefas h
                   , tarefas t
                where h.idtarefa = t.idtarefa
                  and ( :P273_IDUSUARIO is null or h.idusuario = :P273_IDUSUARIO )
                  and ( :P273_TIPOTAREFA is null or t.idtipotarefa = :P273_TIPOTAREFA )
                  and trunc(h.datainicio) between to_date(:P273_DATAINICIO,'DD/MM/RRRR') and to_date(:P273_DATAFIM,'DD/MM/RRRR')
                  and t.idgrupoatendimento in ( select ug.idgrupoatendimento
                                                from roman.usuariosgruposatendimento ug
                                                   , usuarios u
                                                where ug.usuario = u.usuario 
                                                  and u.idusuario = :P0_IDUSUARIO )
                group by h.idusuario
                order by 1
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Verifique os filtros informados!
        }
        advanced {
            savedReportMappingIdentifier: 774921369824524204
        }

        column ATENDENTE (
            type: plainText
            heading {
                heading: Atendente
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column PERCTEMPO (
            type: plainText
            heading {
                heading: Perc. Tempo
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        column QTD (
            type: plainText
            heading {
                heading: Qtd Tarefas
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column TEMPO (
            type: plainText
            heading {
                heading: Tempo
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 7749335 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ATENDENTE (
                sequence: 1
            )

            displayColumn PERCTEMPO (
                sequence: 3
            )

            displayColumn QTD (
                sequence: 4
            )

            displayColumn TEMPO (
                sequence: 2
            )

        )

    )

    pageItem P273_DATAFIM (
        type: datePickerJquery
        label {
            label: até
            alignment: left
        }
        layout {
            sequence: 30
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: DD/MM/RRRR
            width: 15
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P273_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: DD/MM/RRRR
            width: 15
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P273_IDUSUARIO (
        type: selectList
        label {
            label: Atendente
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeusuario(u.idusuario) display_value
                     , u.idusuario return_value
                from usuarios u
                where exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.usuario = u.usuario 
                                 and ug.idgrupoatendimento in ( select ga.idgrupoatendimento
                                                                from roman.usuariosgruposatendimento ga
                                                                where ga.usuario = ( select usuario
                                                                                     from usuarios
                                                                                     where idusuario = :P0_IDUSUARIO ) ) )
                order by 1
                ```
        }
        layout {
            sequence: 50
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P273_TIPOTAREFA (
        type: selectList
        label {
            label: Tipo de Tarefa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.descricao display_value
                     , t.idtipotarefa return_value
                from tipostarefas t
                where exists ( select 1
                               from permissoestipostarefas pt
                               where pt.idtipotarefa = t.idtipotarefa
                                 and pt.buscartarefa = 'S' )
                order by 2
                ```
        }
        layout {
            sequence: 40
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 60
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 273
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 273
                items: {
                    P273_TIPOTAREFA: &P273_TIPOTAREFA.
                    P273_IDUSUARIO: &P273_IDUSUARIO.
                    P273_DATAINICIO: &P273_DATAINICIO.
                    P273_DATAFIM: &P273_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

