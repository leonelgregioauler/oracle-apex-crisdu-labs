    button filtrar (
        buttonName: FILTRAR
        label: FILTRAR
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 344
                items: {
                    P344_PEDIDO_GERADO: &P344_PEDIDO_GERADO.
                    P344_TIPO: &P344_TIPO.
                    P344_DATAINICIO: &P344_DATAINICIO.
                    P344_DATAFIM: &P344_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
