page 344 (
    name: Atendimento de Venda Ativa
    title: Atendimento de Venda Ativa
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region acompanhamento-de-tarefas-de-venda-ativa (
        name: Acompanhamento de Tarefas de Venda Ativa
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idtarefa 
                     , t.idusuario
                     , t.nomeusuario
                     , t.situacao
                     , t.datainclusao
                     , t.datainicio
                     , t.dataconclusao
                     , t.cliente
                     , t.cpfcliente
                     , t.telefone
                     , t.historicos
                from vw_tarefas_fav t
                where t.idtipotarefa = 11
                  and t.ididioma = :P0_IDIDIOMA
                  and ( :P344_DATAINICIO is not null and trunc(t.datainclusao) between to_date(:P344_DATAINICIO) and to_date(:P344_DATAFIM) )
                  and ( :P344_PEDIDO_GERADO is null 
                       or ( :P344_PEDIDO_GERADO = 'N' and not exists ( select 1
                                                                       from pedidos p
                                                                          , vendedoras v
                                                                       where v.idvendedora = p.idvendedora
                                                                         and v.idpessoa    = t.idpessoa
                                                                         and p.idtarefa    = t.idtarefa
                                                                         and p.idsituacaoentrega >= 20000
                                                                         and trunc(p.dataemissao) >= trunc(t.datainclusao)
                                                                         and not exists ( select 1
                                                                                          from classificacoespedidos c
                                                                                          where c.idpedido = p.idpedido
                                                                                            and c.idcaracteristicapedido = 25 ) ) )
                       or ( :P344_PEDIDO_GERADO = 'S' and exists ( select 1
                                                                   from pedidos p
                                                                      , vendedoras v
                                                                   where v.idvendedora = p.idvendedora
                                                                     and v.idpessoa    = t.idpessoa
                                                                     and p.idsituacaoentrega >= 20000
                                                                     and p.idtarefa    = t.idtarefa
                                                                     and ( :P344_TIPO is null
                                                                          or ( :P344_TIPO = 'G' and p.idusuario = t.idusuario )
                                                                          or ( :P344_TIPO = 'C' and p.idusuario is null ) )
                                                                     and trunc(p.dataemissao) >= trunc(t.datainclusao)
                                                                     and not exists ( select 1
                                                                                      from classificacoespedidos c
                                                                                      where c.idpedido = p.idpedido
                                                                                        and c.idcaracteristicapedido = 25 ) ) ) )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum dado encontrado. Verifique os Filtros!
        }
        advanced {
            savedReportMappingIdentifier: 1501354694285848302
        }

