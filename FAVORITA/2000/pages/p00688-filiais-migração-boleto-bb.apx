page 688 (
    name: Filiais Migração Boleto BB
    alias: FILIAIS-MIGRAÇÃO-BOLETO-BB
    title: Filiais Migração Boleto BB
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    css {
        inline:
            ```css
            .bb-migracao-alerta{
              display: flex;
              align-items: flex-start;
              gap: 18px;
              padding: 22px 24px;
              border-radius: 16px;
              border: 1px solid #f5c26b;
              background: linear-gradient(180deg, #fffaf0 0%, #fff6e5 100%);
              box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
              margin-bottom: 16px;
            }
            
            .bb-migracao-alerta__icon{
              flex: 0 0 auto;
              width: 52px;
              height: 52px;
              border-radius: 14px;
              display: flex;
              align-items: center;
              justify-content: center;
              background: linear-gradient(135deg, #f59e0b 0%, #f97316 100%);
              color: #ffffff;
              font-size: 24px;
              box-shadow: 0 8px 18px rgba(245, 158, 11, 0.28);
            }
            
            .bb-migracao-alerta__content{
              flex: 1 1 auto;
            }
            
            .bb-migracao-alerta__badge{
              display: inline-block;
              margin-bottom: 10px;
              padding: 5px 10px;
              border-radius: 999px;
              background: #fff;
              border: 1px solid #f5d08a;
              color: #9a6700;
              font-size: 12px;
              font-weight: 700;
              letter-spacing: 0.04em;
              text-transform: uppercase;
            }
            
            .bb-migracao-alerta__title{
              margin: 0 0 10px 0;
              color: #7c2d12;
              font-size: 22px;
              line-height: 1.25;
              font-weight: 700;
            }
            
            .bb-migracao-alerta__text{
              margin: 0 0 10px 0;
              color: #5b4530;
              font-size: 14px;
              line-height: 1.65;
            }
            
            .bb-migracao-alerta__warning{
              margin: 14px 0;
              padding: 14px 16px;
              border-left: 4px solid #f59e0b;
              border-radius: 10px;
              background: rgba(255,255,255,0.72);
              color: #6b4f1d;
              font-size: 14px;
              line-height: 1.6;
            }
            
            .bb-migracao-alerta__list{
              margin: 14px 0 0 0;
              padding-left: 18px;
              color: #5b4530;
            }
            
            .bb-migracao-alerta__list li{
              margin-bottom: 8px;
              line-height: 1.55;
            }
            
            @media (max-width: 640px){
              .bb-migracao-alerta{
                flex-direction: column;
                padding: 18px;
              }
            
              .bb-migracao-alerta__title{
                font-size: 19px;
              }
            }
            ```
    }

    region aviso (
        name: Aviso
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="bb-migracao-alerta">
                  <div class="bb-migracao-alerta__icon">
                    <span class="fa fa-exclamation-triangle" aria-hidden="true"></span>
                  </div>
                
                  <div class="bb-migracao-alerta__content">
                    <div class="bb-migracao-alerta__badge">Atenção</div>
                
                    <h2 class="bb-migracao-alerta__title">
                      Controle de migração para o novo processo de boletos
                    </h2>
                
                    <p class="bb-migracao-alerta__text">
                      As filiais cadastradas nesta tela serão consideradas como <strong>migradas para o novo fluxo de geração e registro de boletos</strong>.
                    </p>
                
                    <p class="bb-migracao-alerta__text">
                      Sempre que uma filial estiver listada aqui, o sistema poderá direcionar o processamento de boletos para o <strong>novo motor / nova integração</strong>, conforme as regras internas da aplicação.
                    </p>
                
                    <div class="bb-migracao-alerta__warning">
                      <strong>Importante:</strong> incluir uma filial nesta lista impacta diretamente o comportamento do processo de boleto. 
                      Cadastre somente filiais que já estejam validadas e liberadas para operar no novo fluxo.
                    </div>
                
                    <ul class="bb-migracao-alerta__list">
                      <li>Filiais presentes na tela entram no processo novo.</li>
                      <li>Filiais removidas da tela deixam de participar desse fluxo.</li>
                      <li>Qualquer alteração deve ser realizada com atenção e validação prévia.</li>
                    </ul>
                  </div>
                </div>
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region filiais-migração-boleto-bb (
        name: Filiais Migração Boleto BB
        title: Filiais Migração Boleto BB
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select b.ID,
                       b.IDFILIAL,
                       f.NOMEFILIALFAVORITA
                  from BB_FILIAIS_MIGRACAO_BOLETO b
                  join filiaisfavorita f on b.idfilial = f.idfilialfavorita
                  order by idfilial
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 689
                items: {
                    P689_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 45304984528830018
        }

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column IDFILIAL (
            type: plainText
            heading {
                heading: Id Filial
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column NOMEFILIALFAVORITA (
            type: plainText
            heading {
                heading: Nome Filial
                alignment: center
            }
            layout {
                sequence: 12
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Filiais Migração Boleto BB
        }

        savedReport 453080 (
