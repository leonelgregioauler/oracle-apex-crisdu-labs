    pageItem P469_FATORCONVERSAO (
        type: numberField
        label {
            label: Fator Conversão
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 120
            region: @saidas-diversas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: databaseColumn
            databaseColumn: FATORCONVERSAO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vfatorconversao number;
                  vidgrupo        number := 1;
                  vidgrupodestino number := 1;
                  vididioma       number := 1;
                  vididiomadest   number := 1;
                begin
                  --
                  begin
                    select idgrupo
                         , f.ididioma
                    into vidgrupo
                       , vididioma
                    from filiais f
                    where f.idfilial = :P469_IDFILIAL;
                  exception
                    when others then
                      vidgrupo := 1;
                  end;
                  --
                  begin
                    select idgrupo
                         , f.ididioma
                    into vidgrupodestino
                       , vididiomadest
                    from filiais f
                    where f.idfilial = :P469_IDFILIALDEST
                      and f.tipofilial = 'D';
                  exception
                    when others then
                      begin
                        --
                        select case
                                 when ididioma in (2,4) then
                                   5 
                                 else 
                                   1
                               end idgrupo
                             , f.ididioma
                        into vidgrupodestino
                           , vididiomadest
                        from filiais f
                        where f.idfilial = :P469_IDFILIALDEST
                          and f.tipofilial != 'D';
                        --
                      exception
                        when others then
                          vidgrupo := 1;
                      end;
                  end;
                  --
                  if vididioma != 1 and vididiomadest != 1 and vididiomadest != vididioma then
                    --
                    select fatorconversao
                    into vfatorconversao
                    from fechamentossemanais f
                    where f.idfechamento = ( select max(idfechamento)
                                             from fechamentossemanais ff
                                             where ff.idfilial = :P469_IDFILIALDEST);
                    --
                  elsif vididioma = vididiomadest then
                    --
                    vfatorconversao := 1;
                    --
                  elsif vidgrupo = 5 and nvl(vidgrupodestino,1) = 5 then
                    --
                    vfatorconversao := 1;
                    --    
                  elsif vidgrupo = 5 and nvl(vidgrupodestino,1) != 5 then
                    --
                    select fatorconversao
                    into vfatorconversao
                    from roman.vw_filiais f
                    where f.idfilial = :P469_IDFILIAL;
                    --
                  else 
                    --
                    select fatorconversao
                    into vfatorconversao
                    from fechamentossemanais f
                    where f.idfechamento = ( select max(idfechamento)
                                             from fechamentossemanais ff
                                             where ff.idfilial = :P469_IDFILIALDEST );
                    --
                  end if;
                  --
                  return nvl(vfatorconversao,1);
                  --
                exception
                  when others then
                    return 1;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

