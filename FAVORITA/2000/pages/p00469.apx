    region arquivos-anexados (
        name: Arquivos Anexados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomearquivo
                    -- , '<a href="javascript: fnc_verimg('''||idsaida||idanexosaida||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10)||''');">Ver arquivo</a>' link
                     , idsaida||idanexosaida||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10) id
                     , dataanexo data
                     , ( select roman.pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario) usuario
                     , url_bucket link
                from roman.anexossaidas t
                where idsaida = :P469_IDSAIDA
                order by t.dataanexo
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.anexossaidas s
                where s.idsaida = :P469_IDSAIDA
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
