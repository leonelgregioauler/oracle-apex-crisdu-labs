        clientSideCondition {
            type: itemIsNotNull
            item: P469_IDFILIALDEST
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: REFRESH
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation descricao-obrigatoria (
        name: Descricao Obrigatoria
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P469_DESCRICAO
        }
        error {
            errorMessage: #LABEL# deve ser informado!
            associatedItem: @P469_DESCRICAO
        }
        serverSideCondition {
            type: request!=Value
            value: REFRESH
        }
    )

    validation destino-obrigatorio (
        name: Destino Obrigatorio
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P469_IDFILIALDEST
        }
        error {
            errorMessage: #LABEL# deve ser informado.
            associatedItem: @P469_IDFILIALDEST
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    validation valida-matriz-de-classificação (
        name: "Valida Matriz de Classificação "
        execution {
            sequence: 40
        }
        validation {
            type: itemIsNotNull
            item: P469_IDMATRIZCLASSIFICACAO
        }
        error {
            errorMessage: Por favor, utilize a classificação da Saida!
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('SAVE','CREATE')
        }
    )

    validation valor-obrigatório (
        name: Valor Obrigatório
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNullOrZero
            item: P469_VALORTOTAL
        }
        error {
            errorMessage: #LABEL# deve ser informado!
            associatedItem: @P469_VALORTOTAL
        }
        serverSideCondition {
            type: request!=Value
            value: REFRESH
        }
