    pageItem P469_IDFILIAL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @saidas-diversas
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIAL
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidfilial number;
                begin
                  --
                  if :P0_IDFILIALFAVORITA is not null then
                    --
                    select idfilialantigo
                    into vidfilial
                    from filiaisfavorita f
                    where f.idfilialfavorita = :P0_IDFILIALFAVORITA;
                    --
                  else
                    --
                    select idfilialromance
                    into vidfilial
                    from filiaisfavorita f
                    where f.idfilialfavorita = :P0_IDFILIALCAIXA;
                    --
                  end if;
                  --
                  return vidfilial;
                  --
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P469_IDFILIALDEST (
        type: selectList
        label {
            label: Destino
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct initcap(nvl(p.apelido,p.nomepessoa)) display_value
                     , f.idfilial return_value
                from filiais    f
                   , pessoas    p
                where f.idpessoa  = p.idpessoa
                  and f.ativo = 'S'
                  and f.idfilial != :P469_IDFILIAL
                  and ( :P469_IDFILIALDEST is null or f.idfilial = :P469_IDFILIALDEST )
                order by 1
                ```
        }
        layout {
            sequence: 30
            region: @saidas-diversas
            slot: regionBody
            alignment: left
