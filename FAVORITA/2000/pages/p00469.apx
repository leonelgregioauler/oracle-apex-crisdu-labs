            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(c.nomeconta) display_value
                     , c.idcontafinan  return_value
                from roman.contasfinanceiras c
                where exists ( select 1
                               from roman.matrizclassificacoesdespesas m
                               where m.idmatrizclassificacao = :P469_IDMATRIZCLASSIFICACAO
                                 and m.idcontafinan          = c.idcontafinan )
                order by 1
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P469_IDMATRIZCLASSIFICACAO
        }
        layout {
