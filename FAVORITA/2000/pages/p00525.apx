page 525 (
    name: Relatorio Inventario Ciclico
    title: Relatorio Inventario Ciclico
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region inventário (
        name: Inventário
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                  select c.idinventarioCiclico
                       , c.idinventariociclico idinventario
                       , t.descricao situacao
                       , idusuario
                       , datacriacao
                       , idfilial
                       , favorita.pck_util_fav.fnc_nomefilialfavorita(idfilial) Filial
                       , dataencerramento
                       , idusuarioencerra
                       , decode(c.tipoinventario,'C','Cíclico','G','Geral','O','Constelacão',c.tipoinventario) Tipo_inventario
                       , sum(nvl(vlrCusto,0) * nvl(divFisicoOptimus,0) )  vlrDiferenca
                       , sum(nvl(i.divFisicoOptimus,0) * i.vlraPagar)     vlraPagarFO
                       , sum(nvl(vlrCusto,0) * nvl(i.divfisicofiscal,0))  vlrDiffisicoFiscal
                       , sum(nvl(i.divfisicofiscal,0) * i.vlraPagar)      vlraPagarFF
                       /*sum(case when nvl(divFisicoOptimus,0) < 0 
                                               then nvl(vlrCusto,0) * nvl(divFisicoOptimus,0)
                                          else
                                               0
                                      end)  vlrDiferenca
                       , sum(case when nvl(i.divfisicofiscal,0) < 0 
                                               then nvl(vlrCusto,0) * nvl(i.divfisicofiscal,0)
                                          else
                                               0
                                      end)  vlrDiffisicoFiscal*/
                  from favorita.inventarioCiclico        c
                     , favorita.itensInventarioCiclico   i
                     , favorita.tiposSituacoesInventario t
                  where c.idInventarioCiclico = i.idInventarioCiclico(+)
                    and c.idtiposituacao      = t.idtiposituacao
                    and ( :P525_DATAINICIO is null or datacriacao between :P525_DATAINICIO and :P525_DATAFIM ) 
                    and ( :P525_SITUACAO   is null or c.idTipoSituacao = :P525_SITUACAO)
                    and ( :P525_IDFILIAL   is null or c.idfilial       = :P525_IDFILIAL)
                    and ( :P525_IDUSUARIO  is null or c.idusuario      = :P525_IDUSUARIO)
                    and c.tipoinventario not in ('P', 'T')
                  group by c.idinventarioCiclico
                         , t.descricao
                         , c.idusuario
                         , c.datacriacao
                         , c.idfilial
                         , pck_util_fav.fnc_nomefilialfavorita(c.idfilial)
                         , c.dataencerramento
                         , c.idusuarioencerra
                         , c.tipoinventario
                --         , nvl(i.divFisicoOptimus,0) 
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        advanced {
            savedReportMappingIdentifier: 12493964123227402
        }

