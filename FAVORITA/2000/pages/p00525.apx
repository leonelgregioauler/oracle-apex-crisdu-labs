            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from roman.aplicacoes p
                     , roman.acessos    a
                 where p.idsistema = 2000
                   and p.idaplicacao = 34254
                   and p.idAplicacao = a.idAplicacao
                   and a.ativo = 'S'
                   and a.usuario = :P0_USUARIO
                ```
        }
    )

    dynamicAction esconde-data (
        name: Esconde Data
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P525_DATA
        }
        clientSideCondition {
            type: item=value
            item: P525_DATA
            value: 0
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P525_DATAINICIO
            }
            execution {
                sequence: 10
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P525_DATAFIM
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P525_DATAINICIO
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P525_DATAFIM
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

    )

)

