page 597 (
    name: Perfil de Usuário
    title: Perfil de Usuário
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region perfis-de-usuários (
        name: Perfis de Usuários
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idperfil
                     , descricao
                from roman.perfil
                where idsistema = 2000
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 599
                items: {
                    P599_IDPERFIL: #IDPERFIL#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 573071876154347802
        }

        column DESCRICAO (
            type: plainText
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
            enableUsersTo {
                hide: false
                sort: false
                filter: false
                highlight: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
                pivot: false
            }
        )

        column IDPERFIL (
            type: hidden
            heading {
                heading: Idperfil
            }
            layout {
                sequence: 10
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        savedReport 5731556 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DESCRICAO (
                sequence: 2
            )

            displayColumn IDPERFIL (
                sequence: 1
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Cadastrar
        layout {
            sequence: 20
            region: @perfis-de-usuários
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 599
                clearCache: 599
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button liberar (
        buttonName: LIBERAR
        label: Liberar Perfil p/ Usuário
        layout {
            sequence: 10
            region: @perfis-de-usuários
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 601
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

