    process operação-dml-em-compre-e-ganhe (
        name: Operação DML em Compre e Ganhe
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidcompreeganhe   number;
                  voperacao_dml     varchar2(1);
                  --
                  vfiliais    APEX_APPLICATION_GLOBAL.VC_ARR2;
                  vfiliaisfav APEX_APPLICATION_GLOBAL.VC_ARR2;
                  --
                begin
                  --
                  --transforma o string do shutle em tabela
                  --
                  vfiliais    := APEX_UTIL.STRING_TO_TABLE(:P32_IDFILIALROMANCE);
                  vfiliaisfav := APEX_UTIL.STRING_TO_TABLE(:P32_IDFILIALFAVORITA);  
                  --
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') in ('ATUALIZAR', 'ATUALIZARTODOS') then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') in ('EXCLUIR', 'EXCLUIRTODOS') then
                    voperacao_dml := 'D';
                  end if;
                  --
                  if v('REQUEST') in ('INSERIR', 'ATUALIZARTODOS') then
                    --
                    for rfil in 1.. vfiliais.count 
                    loop
                      --
                      #OWNER#.PCK_COMERCIAL_FAV.PRC_COMPREEGANHE(
                        PIDCOMPREEGANHE => vidcompreeganhe,
                        PIDPRODUTODETALHADO => :P32_IDPRODUTODETALHADO,
                        PIDFILIALROMANCE => vfiliais(rfil),
                        PDATAINICIAL => :P32_DATAINICIAL,
                        PDATAFINAL => :P32_DATAFINAL,
                        PQUANTIDADECOMPRADA => :P32_QUANTIDADECOMPRADA,
                        PQUANTIDADEBRINDE => :P32_QUANTIDADEBRINDE,
                        PIDPRODUTODETALHADOBRINDE => :P32_IDPRODUTODETALHADOBRINDE,
                        PDESCRICAO => :P32_DESCRICAO,
                        PIDEDICAOREVISTA => :P32_IDEDICAOREVISTA,
                        PIDFILIALFAVORITA => :P32_IDFILIALFAVORITA,
                        PMD5 => :P32_MD5,
                        POPERACAO_DML => voperacao_dml);
                        --
                    end loop;
                    --
                    for rfilfav in 1.. vfiliaisfav.count
                    loop
                      --
                      #OWNER#.PCK_COMERCIAL_FAV.PRC_COMPREEGANHE(
                        PIDCOMPREEGANHE => vidcompreeganhe,
                        PIDPRODUTODETALHADO => :P32_IDPRODUTODETALHADO,
                        PIDFILIALROMANCE => :P32_IDFILIALROMANCE,
                        PDATAINICIAL => :P32_DATAINICIAL,
                        PDATAFINAL => :P32_DATAFINAL,
                        PQUANTIDADECOMPRADA => :P32_QUANTIDADECOMPRADA,
                        PQUANTIDADEBRINDE => :P32_QUANTIDADEBRINDE,
                        PIDPRODUTODETALHADOBRINDE => :P32_IDPRODUTODETALHADOBRINDE,
                        PDESCRICAO => :P32_DESCRICAO,
                        PIDEDICAOREVISTA => :P32_IDEDICAOREVISTA,
                        PIDFILIALFAVORITA => vfiliaisfav(rfilfav),
                        PMD5 => :P32_MD5,
                        POPERACAO_DML => voperacao_dml);
                        --
                    end loop;
                    --
                  elsif v('REQUEST') in ('EXCLUIR', 'EXCLUIRTODOS', 'ATUALIZAR') then
                    --
                    vfiliais    := APEX_UTIL.STRING_TO_TABLE(:P32_IDFILIALROMANCE_ATUALIZAR);
                    vfiliaisfav := APEX_UTIL.STRING_TO_TABLE(:P32_IDFILIALFAVORITA_ATUALIZAR);
                    --
                    for rfil in 1.. vfiliais.count 
                    loop
                      --
                      #OWNER#.PCK_COMERCIAL_FAV.PRC_COMPREEGANHE(
                        PIDCOMPREEGANHE => :P32_IDCOMPREEGANHE,
                        PIDPRODUTODETALHADO => :P32_IDPRODUTODETALHADO,
                        PIDFILIALROMANCE => vfiliais(rfil),
                        PDATAINICIAL => :P32_DATAINICIAL,
                        PDATAFINAL => :P32_DATAFINAL,
                        PQUANTIDADECOMPRADA => :P32_QUANTIDADECOMPRADA,
                        PQUANTIDADEBRINDE => :P32_QUANTIDADEBRINDE,
                        PIDPRODUTODETALHADOBRINDE => :P32_IDPRODUTODETALHADOBRINDE,
                        PDESCRICAO => :P32_DESCRICAO,
                        PIDEDICAOREVISTA => :P32_IDEDICAOREVISTA,
                        PIDFILIALFAVORITA => :P32_IDFILIALFAVORITA,
                        PMD5 => :P32_MD5,
                        POPERACAO_DML => voperacao_dml);
                        --
                    end loop;
                    --
                    for rfilfav in 1.. vfiliaisfav.count
                    loop
                      --
                      #OWNER#.PCK_COMERCIAL_FAV.PRC_COMPREEGANHE(
                        PIDCOMPREEGANHE => :P32_IDCOMPREEGANHE,
                        PIDPRODUTODETALHADO => :P32_IDPRODUTODETALHADO,
                        PIDFILIALROMANCE => :P32_IDFILIALROMANCE,
                        PDATAINICIAL => :P32_DATAINICIAL,
                        PDATAFINAL => :P32_DATAFINAL,
                        PQUANTIDADECOMPRADA => :P32_QUANTIDADECOMPRADA,
                        PQUANTIDADEBRINDE => :P32_QUANTIDADEBRINDE,
                        PIDPRODUTODETALHADOBRINDE => :P32_IDPRODUTODETALHADOBRINDE,
                        PDESCRICAO => :P32_DESCRICAO,
                        PIDEDICAOREVISTA => :P32_IDEDICAOREVISTA,
                        PIDFILIALFAVORITA => vfiliaisfav(rfilfav),
                        PMD5 => :P32_MD5,
                        POPERACAO_DML => voperacao_dml);
                        --
                    end loop;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 3073633650006590
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 32
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

)

