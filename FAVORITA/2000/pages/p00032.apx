        }
    )

    pageItem P32_IDESTOQUE (
        type: radioGroup
        label {
            label: Estoque
            alignment: left
        }
        settings {
            noOfCols: 6
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) display_value
                     , idfilialfavorita   return_value
                from filiaisfavorita f
                where f.tipofilial = 'E'
                and f.idpais = :P32_IDPAIS
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P32_IDPAIS
            itemsToSubmit: P32_IDPAIS
        }
        layout {
            sequence: 70
            region: @compre-e-ganhe
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P32_IDFILIALFAVORITA (
        type: shuttle
        label {
            label: Filial Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) as d,
                       idfilialfavorita as r
                  from filiaisfavorita
                where tipofilial in ('L')
                 order by 1
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 90
            region: @compre-e-ganhe
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 3
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P32_IDFILIALFAVORITA_ATUALIZAR (
        type: hidden
        layout {
            sequence: 170
            region: @compre-e-ganhe
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P32_IDFILIALROMANCE (
        type: shuttle
        label {
            label: Filial Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome as d,
                       idfilial as r
                  from roman.vw_filiais f
                 where tipofilial in ('C', 'D', 'P')
                   and ativo = 'S'
                   and ( idfilial in (1041, 1096) and :P32_IDPAIS = 2
                      or idfilial in (1094) and :P32_IDPAIS = 3
                      or idfilial in (1095, 1081, 1111) and :P32_IDPAIS = 4
                      or idfilial in (1108) and :P32_IDPAIS = 6
                      or idfilial not in (1041, 1096, 1095, 1081, 1085) and :P32_IDPAIS = 1 )
                      and exists ( select 1
                                   from atendimentosfiliaisrmc a
                                   where a.idfilialfavoritaorigem = nvl(:P32_IDESTOQUE, a.idfilialfavoritaorigem)
                                   and a.idfilialdestino = f.idfilial )
                 order by 1
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: [
                P32_IDPAIS
                P32_IDESTOQUE
            ]
            itemsToSubmit: [
                P32_IDPAIS
                P32_IDESTOQUE
            ]
        }
        layout {
            sequence: 80
            region: @compre-e-ganhe
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 5
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P32_IDFILIALROMANCE_ATUALIZAR (
        type: hidden
        layout {
