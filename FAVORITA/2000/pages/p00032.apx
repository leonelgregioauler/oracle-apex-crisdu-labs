    dynamicAction desabilita-filial-romance-e-favorita (
        name: Desabilita Filial Romance e Favorita
        execution {
            sequence: 10
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: item=value
            item: P32_ORIGEM
            value: 31
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: items
                items: P32_IDFILIALROMANCE
            }
            execution {
                sequence: 10
            }
        )

        action native-disable-2 (
            action: disable
            affectedElements {
                selectionType: items
                items: P32_IDFILIALFAVORITA
            }
            execution {
                sequence: 20
            }
        )

        action native-disable-3 (
            action: disable
            affectedElements {
                selectionType: items
                items: P32_IDEDICAOREVISTA
            }
            execution {
                sequence: 30
            }
        )

    )

    dynamicAction habilita-filial-favorita-desabilita-filial-romance (
        name: Habilita Filial Favorita / Desabilita Filial Romance
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: items
            items: P32_IDFILIALFAVORITA
        }
        clientSideCondition {
            type: item=value
            item: P32_ORIGEM
            value: 0
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: items
                items: P32_IDFILIALROMANCE
            }
            execution {
                sequence: 10
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: items
                items: P32_IDFILIALFAVORITA
            }
            execution {
                sequence: 20
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: :P32_IDFILIALROMANCE := null;
                itemsToSubmit: P32_IDFILIALROMANCE
                itemsToReturn: P32_IDFILIALROMANCE
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction habilita-filial-romance-desabilita-filial-favorita (
        name: Habilita Filial Romance / Desabilita Filial Favorita
        execution {
            sequence: 20
        }
