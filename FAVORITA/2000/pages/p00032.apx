    validation valida-se-pode-excluir-compre-e-ganhe-já-usado (
        name: Valida se pode excluir (compre e ganhe já usado)
        execution {
            sequence: 140
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  --
                  if v('REQUEST') = 'EXCLUIRTODOS' then
                    --
                    for i in ( select cg.*
                               from itenspedidos ip
                                  , compreeganhe cg
                               where ip.idcompreeganhe = cg.idcompreeganhe
                              and cg.descricao = :P32_DESCRICAO ) 
                    --
                    loop
                      --
                      return 'Compre e ganhe já foi utilizado em pedidos. Não pode ser excluído.';
                      --
                    end loop;
                    --
                  elsif v('REQUEST') = 'EXCLUIR' then
                    --
                    for i in ( select cg.*
                               from itenspedidos ip
                                  , compreeganhe cg
                               where ip.idcompreeganhe = cg.idcompreeganhe
                              and cg.idcompreeganhe = :P32_IDCOMPREEGANHE ) 
                    --
                    loop
                      --
                      return 'Compre e ganhe já foi utilizado em pedidos. Não pode ser excluído.';
                      --
                    end loop;
                    --
                  end if;
                  --
                end;
                ```
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('EXCLUIRTODOS', 'EXCLUIR')
        }
    )

