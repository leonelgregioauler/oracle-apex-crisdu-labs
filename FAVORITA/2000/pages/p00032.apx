                plsqlCode: :P32_IDFILIALFAVORITA := null;
                itemsToSubmit: P32_IDFILIALFAVORITA
                itemsToReturn: P32_IDFILIALFAVORITA
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

