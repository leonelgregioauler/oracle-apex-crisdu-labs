    validation quantidadebrinde-inteiro (
        name: QUANTIDADEBRINDE inteiro
        execution {
            sequence: 120
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  verro varchar2(1000);
                begin
                  if instr(:P32_QUANTIDADEBRINDE, ',') > 0 or
                     instr(:P32_QUANTIDADEBRINDE,'.') > 0 then
                    --
                    return 'Quantidade brinde deve ser um número inteiro';
                    --
                  else
                    null;
                  end if;
                end;
                ```
        }
        error {
            associatedItem: @P32_QUANTIDADEBRINDE
        }
    )

    validation quantidadebrinde-maior-que (
        name: QUANTIDADEBRINDE maior que 0
        execution {
            sequence: 130
        }
        validation {
            plsqlExpression: :P32_QUANTIDADEBRINDE > 0
        }
        error {
            errorMessage: "Quantidade brinde deve ser maior que zero (0) "
            associatedItem: @P32_QUANTIDADEBRINDE
        }
        serverSideCondition {
            type: expression
            plsqlExpression: instr(:P32_QUANTIDADEBRINDE, '.') = 0
        }
    )

