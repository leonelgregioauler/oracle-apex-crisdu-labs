page 514 (
    name: Kits de Produtos
    title: Kits de Produtos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region kits-produtos (
        name: Kits Produtos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idkitproduto
                     , referencia
                     , descricao
                     , ( select listagg(f.nomefilialfavorita,',') within group ( order by 1)
                         from favorita.filiaisfavorita f
                         where f.idfilialfavorita in ( select column_value
                                                       from table (pck_util_fav.fnc_array_to_table(replace(k.filiaisfavorita,',',':'))) ) ) filiaisfavorita
                     , ( select listagg(pck_util_fav.fnc_nomefilialromance(f.idfilial),',') within group ( order by 1)
                         from catal.filiais f
                         where f.idfilial in ( select column_value
                                               from table (pck_util_fav.fnc_array_to_table(replace(k.filiaisromance,',',':'))) ) ) filiaisromance
                     , ( select pck_util_fav.fnc_nomecategoriasite( pidcategoriasite => cc.idcategoriasite
                                                                  , pididioma    => 1)
                        ||' - '||pck_util_fav.fnc_nomecategoria( pidcategoria => cc.idcategoria
                                                               , pididioma => 1)
                         from categorias cc
                         where cc.idcategoria = k.idcategoria ) categoriasite
                     , decode(k.habilitarpara, 'T', 'Distribuidor e Consultora'
                                             , 'D', 'Distribuidor'
                                             , 'C', 'Consultora') habilitarparadescricao
                     , decode(k.kitcampanha,'S','Sim','Não') kitcampanha
                     , datainicial
                     , datafinal
                from kitsprodutos k
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 116933002419469348
        }

        column CATEGORIASITE (
            type: plainText
            heading {
                heading: Categoria Site
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column DATAFINAL (
