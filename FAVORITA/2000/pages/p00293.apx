page 293 (
    name: Relatório de Itens Enviados Errados
    title: Relatório de Itens Enviados Trocados
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region protocolos-de-erros (
        name: Protocolos de Erros
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select --'<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':130:'||v('APP_SESSION')||'::NO::P130_IDPROTOCOLOATENDIMENTO:'||idprotocoloatendimento ,'SESSION')||''',''_blank''); void(0)">'||idprotocoloatendimento||'</a>' idprotocoloatendimento
                     --, '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||idpedido ,'SESSION')||''',''_blank''); void(0)">'||idpedido||'</a>' idpedido
                       idprotocoloatendimento idprotocolo
                     , idprotocoloatendimento
                     , idpedido
                     , nomefilialromance
                     , sum(quantidade)
                     , 'Cancelamento'
                     , sum(quantidadetrocado+quantidadenaorecebida) Erros
                     , LISTAGG(dataconfirmacaoestoque, '; ')
                         WITHIN GROUP (ORDER BY 1) "dataconfirmacaoestoque"
                     , ( select  LISTAGG(pck_util_fav.fnc_nomeusuario(c.idusuario), '; ')
                                               WITHIN GROUP (ORDER BY 1) usuario
                         from vw_classificacoespedidos_fav c
                         where c.idcaracteristicapedido = 18
                           and c.ididioma               = :P0_IDIDIOMA
                       and c.idpedido = id.idpedido ) "Usuario Montou" 
                     , ( select pck_util_fav.fnc_retornamotivoprotocolo(p.idmotivoprotocolo,:P0_IDIDIOMA)
                         from favorita.protocolosatendimentos p
                         where p.idprotocoloatendimento = id.idprotocoloatendimento ) Motivo
                     , ( select decode(p.situacao,'P','Pendente','C','Concluído','R','Rejeitado')
                         from favorita.protocolosatendimentos p
                         where p.idprotocoloatendimento = id.idprotocoloatendimento ) Situacao
                     , (sum(quantidade) - sum(quantidadetrocado+quantidadenaorecebida)) Diferença
                     , pck_util_fav.fnc_nomeprodutodetalhado(id.idprodutodetalhado, :P0_IDIDIOMA)        produtodetalhado
                     , pck_util_fav.fnc_nomeprodutodetalhado(id.idprodutodetalhadotrocado, :P0_IDIDIOMA) produtodetalhadotrocado
                from vw_itensdevolucaopedidos_fav id
                where idtipoprotocolo in (1)
                  and ( (:P293_DATACONFIRMACAOINICIAL is null and :P293_DATACONFIRMACAOFINAL is null) 
                         or trunc(( select p.dataprotocolo
                                    from favorita.protocolosatendimentos p
                                    where p.idprotocoloatendimento = id.idprotocoloatendimento
                                      and p.idmotivoprotocolo in (18,28,29,32,41))) between :P293_DATACONFIRMACAOINICIAL and :P293_DATACONFIRMACAOFINAL)
                  and not exists( select 1
                                  from favorita.protocolosatendimentos p
                                  where p.situacao = 'R'
                                    and p.idprotocoloatendimento = id.idprotocoloatendimento )
                  and idfilialromance in ( select a.idfilialdestino
                                           from atendimentosfiliaisrmc a
                                           where a.idfilialdestino = id.idfilialromance
                                             and a.idfilialfavoritaorigem = :P293_IDFILIALFAVORITA )
                and ididioma = 1  
                group by idprotocoloatendimento, idpedido, nomefilialromance, idprodutodetalhado, idprodutodetalhadotrocado
                union
                select --'<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':130:'||v('APP_SESSION')||'::NO::P130_IDPROTOCOLOATENDIMENTO:'||idprotocoloatendimento ,'SESSION')||''',''_blank''); void(0)">'||idprotocoloatendimento||'</a>' idprotocoloatendimento
                     --, '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||idpedido ,'SESSION')||''',''_blank''); void(0)">'||idpedido||'</a>' idpedido
                       idprotocoloatendimento idprotocolo
                     , idprotocoloatendimento
                     , idpedido
                     , nomefilialromance
                     , sum(quantidade)
                     , 'Troca'
                     , sum(it.quantidadenaorecebida+it.quantidaderecebidatrocada) Erros
                     , LISTAGG(dataconfirmacaoestoque, '; ')
                         WITHIN GROUP (ORDER BY 1) dataconfirmacaoestoque
                     , ( select LISTAGG(pck_util_fav.fnc_nomeusuario(c.idusuario), '; ')   
                                               WITHIN GROUP (ORDER BY 1) usuario           
                         from vw_classificacoespedidos_fav c                               
                         where c.idcaracteristicapedido = 18                               
                           and c.ididioma               = :P0_IDIDIOMA                     
                       and c.idpedido = it.idpedido ) "Usuario Montou"
                     , ( select pck_util_fav.fnc_retornamotivoprotocolo(p.idmotivoprotocolo,:P0_IDIDIOMA)
                         from favorita.protocolosatendimentos p
                         where p.idprotocoloatendimento = it.idprotocoloatendimento ) Motivo
                     , ( select decode(p.situacao,'P','Pendente','C','Concluído','R','Rejeitado')
                         from favorita.protocolosatendimentos p
                         where p.idprotocoloatendimento = it.idprotocoloatendimento ) Situacao      
                     , (sum(quantidade) - sum(quantidaderecebidatrocada+quantidadenaorecebida)) Diferença
                     , pck_util_fav.fnc_nomeprodutodetalhado(it.idprodutodetalhado, :P0_IDIDIOMA)        produtodetalhado
                     , pck_util_fav.fnc_nomeprodutodetalhado(it.idprodutodetalhadotrocado, :P0_IDIDIOMA) produtodetalhadotrocado
                from vw_itenstrocapedidos_fav it
                where idtipoprotocolo in (6)
                  and ( (:P293_DATACONFIRMACAOINICIAL is null and :P293_DATACONFIRMACAOFINAL is null) 
                      or trunc(( select p.dataprotocolo
                                 from favorita.protocolosatendimentos p
                                 where p.idprotocoloatendimento = it.idprotocoloatendimento
                                   and p.idmotivoprotocolo in (18,28,29,32,41))) between :P293_DATACONFIRMACAOINICIAL and :P293_DATACONFIRMACAOFINAL)
                  and idfilialromance in ( select a.idfilialdestino
                                           from atendimentosfiliaisrmc a
                                           where a.idfilialdestino = it.idfilialromance
                                             and a.idfilialfavoritaorigem = :P293_IDFILIALFAVORITA )
                  and not exists( select 1
                                  from favorita.protocolosatendimentos p
                                  where p.situacao = 'R'
                                    and p.idprotocoloatendimento = it.idprotocoloatendimento )
                  and ididioma = 1
                group by idprotocoloatendimento, idpedido, nomefilialromance, idprodutodetalhado, idprodutodetalhadotrocado
                union
                select --'<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':130:'||v('APP_SESSION')||'::NO::P130_IDPROTOCOLOATENDIMENTO:'||idprotocoloatendimento ,'SESSION')||''',''_blank''); void(0)">'||idprotocoloatendimento||'</a>' idprotocoloatendimento
                     --, '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||idpedido ,'SESSION')||''',''_blank''); void(0)">'||idpedido||'</a>' idpedido
                       idprotocoloatendimento idprotocolo
                     , idprotocoloatendimento
                     , idpedido
                     , nomefilialromance
                     , sum(quantidade)
                     , 'Alteração'
                     , sum(ie.quantidaderecebidatrocada+quantidadenaorecebida) Erros
                     , LISTAGG(dataconfirmacaoestoque, '; ')
                         WITHIN GROUP (ORDER BY 1) dataconfirmacaoestoque
                     , ( select LISTAGG(pck_util_fav.fnc_nomeusuario(c.idusuario), '; ')
                                               WITHIN GROUP (ORDER BY 1) usuario
                         from vw_classificacoespedidos_fav c
                         where c.idcaracteristicapedido = 18
                           and c.ididioma               = :P0_IDIDIOMA
                       and c.idpedido = ie.idpedido ) "Usuario Montou"
                     , ( select pck_util_fav.fnc_retornamotivoprotocolo(p.idmotivoprotocolo,:P0_IDIDIOMA)
                         from favorita.protocolosatendimentos p
                         where p.idprotocoloatendimento = ie.idprotocoloatendimento ) Motivo
                     , ( select decode(p.situacao,'P','Pendente','C','Concluído','R','Rejeitado')
                         from favorita.protocolosatendimentos p
                         where p.idprotocoloatendimento = ie.idprotocoloatendimento ) Situacao     
                     , (sum(quantidade) - sum(quantidaderecebidatrocada+quantidadenaorecebida)) Diferença
                     , pck_util_fav.fnc_nomeprodutodetalhado(ie.idprodutodetalhado, :P0_IDIDIOMA)        produtodetalhado
                     , pck_util_fav.fnc_nomeprodutodetalhado(ie.idprodutodetalhadotrocado, :P0_IDIDIOMA) produtodetalhadotrocado
                from vw_itensexcluidospedidos_fav ie
                where idtipoprotocolo in (4)
                  and ( (:P293_DATACONFIRMACAOINICIAL is null and :P293_DATACONFIRMACAOFINAL is null) 
                      or trunc(( select p.dataprotocolo
                                 from favorita.protocolosatendimentos p
                                 where p.idprotocoloatendimento = ie.idprotocoloatendimento
                                   and p.idmotivoprotocolo in (18,28,29,32,41))) between :P293_DATACONFIRMACAOINICIAL and :P293_DATACONFIRMACAOFINAL)
                  and idfilialromance in ( select a.idfilialdestino
                                           from atendimentosfiliaisrmc a
                                           where a.idfilialdestino = ie.idfilialromance
                                             and a.idfilialfavoritaorigem = :P293_IDFILIALFAVORITA )
                  and not exists( select 1
                                  from favorita.protocolosatendimentos p
                                  where p.situacao = 'R'
                                    and p.idprotocoloatendimento = ie.idprotocoloatendimento )  and ididioma = 1   
                group by idprotocoloatendimento, idpedido, nomefilialromance, idprodutodetalhado, idprodutodetalhadotrocado
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P293_TIPO
            value: P
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1495164209578610215
        }

