        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @relatório-de-itens-excluídos-outros-motivos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P293_TIPO (
        type: radioGroup
        label {
            label: Tipo
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Itens;I,Protocolos;P
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 60
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-filter
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction desativado-lista-itens (
        name: DESATIVADO!!! - Lista Itens
        execution {
            sequence: 20
            eventScope: dynamic
            staticContainer: body
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .listaitensprotocolo
        }
        serverSideCondition {
            type: never
        }

        action plugin-pretius-apex-nested-reports (
            action: plugin/pretiusApexNestedReports
            settings {
                defaultCallbackOptions: [
                    cacheResults
                    collapseExpanded
                    addAnimation
                    loadingIndicator
                ]
                defaultTemplateOptions: [
                    strechReport
                    sortingData
                    extendDefaultTemplate
                ]
                defaultTemplateHtml: #DEFAULT_TEMPLATE#
                loadingIndicatorStyle: replaceCellContent
                detailsQuery:
                    ```sql
                    select i.nomefilialromance        "Filial Romance"    
                         , nomeprodutodetalhado       "Produto Detalhado"
                         , quantidade                 "Quantidade"
                         , quantidadedevolvido        "Quantidade Devolvida"
                         , quantidadedefeito          "Quantidade Defeito"
                         , quantidadeavaria           "Quantidade Avariada"
                         , quantidadenaorecebida      "Quantidade não Recebida"
                         , quantidadetrocado          "Quantidade Recebida Trocada"
                         , pck_util_fav.fnc_nomeprodutodetalhado(idprodutodetalhadotrocado, :P0_IDIDIOMA)  "Produto Enviado Trocado"
                    from vw_itensdevolucaopedidos_fav i
                    where idprotocoloatendimento = '#IDPROTOCOLO#'
                    and ididioma = :P0_IDIDIOMA
                    union all
                    select i.nomefilialromance       "Filial Romance" 
                         , nomeprodutodetalhado      "Produto Detalhado"
                         , quantidade                "Quantidade"
                         , null                      "Quantidade Devolvida"  
                         , quantidadedefeito         "Quantidade Defeito"
                         , quantidadeavaria          "Quantidade Avariada"
                         , quantidadenaorecebida     "Quantidade não Recebida"
                         , quantidaderecebidatrocada "Quantidade Recebida Trocada"
                         , pck_util_fav.fnc_nomeprodutodetalhado(idprodutodetalhadotrocado, :P0_IDIDIOMA)  "Produto Enviado Trocado"
                    from vw_itenstrocapedidos_fav i
                    where idprotocoloatendimento = '#IDPROTOCOLO#'
                    and ididioma = :P0_IDIDIOMA
                    union all
                    select i.nomefilialromance       "Filial Romance" 
                         , nomeprodutodetalhado      "Produto Detalhado"
                         , quantidade                "Quantidade"
                         , quantidadedevolvida       "Quantidade Devolvida"
                         , quantidadedefeito         "Quantidade Defeito"
                         , quantidadeavaria          "Quantidade Avariada"
                         , quantidadenaorecebida     "Quantidade não Recebida"
                         , quantidaderecebidatrocada "Quantidade Recebida Trocada"
                         , pck_util_fav.fnc_nomeprodutodetalhado(idprodutodetalhadotrocado, :P0_IDIDIOMA)  "Produto Enviado Trocado"
                    from vw_itensexcluidospedidos_fav i
                    where idprotocoloatendimento = '#IDPROTOCOLO#'
                    and ididioma = :P0_IDIDIOMA
                    ```
                whenNoDataFound: Não encontrou informações.
            }
            affectedElements {
                selectionType: region
                region: @protocolos-de-erros
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation data-final (
        name: Data Final
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P293_DATACONFIRMACAOFINAL
        }
        error {
            errorMessage: Informe a data final
        }
        serverSideCondition {
            type: request=Value
            value: FILTRAR
        }
    )

    validation data-inicial (
        name: Data Inicial
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P293_DATACONFIRMACAOINICIAL
        }
        error {
            errorMessage: Informe a data inicial
        }
        serverSideCondition {
            type: request=Value
            value: FILTRAR
        }
    )

    process confirmar-ajuste-devolução (
        name: Confirmar Ajuste (Devolução)
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                update itensdevolucaopedidos
                set confirmaajusteitemtrocado = 'S'
                where iditemdevolucaopedido = :P293_IDITEMDEVOLUCAOPEDIDO;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1387014007455026683
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMARAJUSTEDEVOLUCAO
        }
    )

