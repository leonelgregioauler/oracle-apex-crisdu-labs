        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 14952040 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn 'CANCELAMENTO' (
                sequence: 2
            )

            displayColumn ERROS (
                sequence: 8
            )

            displayColumn IDPEDIDO (
                sequence: 5
            )

            displayColumn IDPROTOCOLOATENDIMENTO (
                sequence: 1
            )

            displayColumn MOTIVO (
                sequence: 3
            )

            displayColumn NOMEFILIALROMANCE (
                sequence: 6
            )

            displayColumn PRODUTODETALHADO (
                sequence: 11
            )

            displayColumn PRODUTODETALHADOTROCADO (
                sequence: 12
            )

            displayColumn SITUACAO (
                sequence: 4
            )

            displayColumn "SUM(QUANTIDADE)" (
                sequence: 7
            )

            displayColumn "Usuario Montou" (
                sequence: 10
            )

            displayColumn "dataconfirmacaoestoque" (
                sequence: 9
            )

            sort (
                column: IDPROTOCOLOATENDIMENTO
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            sort (
                column: "Usuario Montou"
                sort {
                    direction: desc
                    sequence: 2
                }
            )

            sort (
                column: NOMEFILIALROMANCE
                sort {
                    direction: desc
                    sequence: 3
                }
            )

            highlight ir-condition (
                condition {
                    column: DIFERENÇA
                    operator: >
                    value: 0
                }
                colors {
                    background: #FF7755
                }
                execution {
                    sequence: 8
                }
            )

            highlight ir-condition-2 (
                name: Situação
                condition {
                    column: SITUACAO
                    operator: !=
                    value: Concluído
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #FFFF99
                }
                execution {
                    sequence: 10
                }
            )

        )

    )

    region relatório-de-itens-enviados-errados (
        name: Relatório de Itens Enviados Errados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select iditemdevolucaopedido
                     --, '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':130:'||v('APP_SESSION')||'::NO::P130_IDPROTOCOLOATENDIMENTO:'||idprotocoloatendimento ,'SESSION')||''',''_blank''); void(0)">'||idprotocoloatendimento||'</a>' idprotocoloatendimento
                     --, '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||idpedido ,'SESSION')||''',''_blank''); void(0)">'||idpedido||'</a>' idpedido
                     , idprotocoloatendimento
                     , idpedido
                     , idfilialromance
                     , nomefilialromance
                     , idprodutodetalhado
                     , nomeprodutodetalhado
                     , quantidade
                     , idprodutodetalhadotrocado
                     , nomeprodutotrocado
                     , (quantidadetrocado + id.quantidadenaorecebida) erros
                     , dataconfirmacaoestoque
                     , ( select pck_util_fav.fnc_nomeusuario(c.idusuario) usuario
                         from vw_classificacoespedidos_fav c
                         where c.idcaracteristicapedido = 18
                           and c.ididioma               = :P0_IDIDIOMA
                       and c.idpedido = id.idpedido ) "Usuario Montou"
                     , case
                         when confirmaajusteitemtrocado is null then
                           '<a href="javascript:apex.confirm(''Confirmar o ajuste de '||quantidade||' item(s) do produto '||nomeprodutodetalhado||
                                                                              ' e de '||quantidadetrocado||' item(s) do produto '||nomeprodutotrocado||' trocado ?'', 
                             { request:''CONFIRMARAJUSTEDEVOLUCAO'', set:{''P293_IDITEMDEVOLUCAOPEDIDO'':'||iditemdevolucaopedido||' }} )";><img src="#APP_IMAGES#ok.png"  border="0"></a>'
                         else
                           'Ajuste realizado'
                       end confirmaajusteitemtrocado
                 from vw_itensdevolucaopedidos_fav id
                where quantidadetrocado > 0
                and codconfirmacaoestoque = 'S'
                and idtipoprotocolo in (1)
                and ( 
                        (   confirmaajusteitemtrocado = 'S'   and :P293_AJUSTE = 'E' )
                     or (   confirmaajusteitemtrocado is null and :P293_AJUSTE = 'P' )
                     or ( ( confirmaajusteitemtrocado is null or confirmaajusteitemtrocado is not null ) and :P293_AJUSTE = 'T' )
                      )
                and ( (:P293_DATACONFIRMACAOINICIAL is null and :P293_DATACONFIRMACAOFINAL is null) 
                  or trunc(dataconfirmacaoestoque) between :P293_DATACONFIRMACAOINICIAL and :P293_DATACONFIRMACAOFINAL)
                and idfilialromance in ( select a.idfilialdestino
                                         from atendimentosfiliaisrmc a
                                         where a.idfilialdestino = id.idfilialromance
                                         and a.idfilialfavoritaorigem = :P293_IDFILIALFAVORITA )
                and ididioma = 1                         
                union
                select iditempedidotrocado
                     --, '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':130:'||v('APP_SESSION')||'::NO::P130_IDPROTOCOLOATENDIMENTO:'||idprotocoloatendimento ,'SESSION')||''',''_blank''); void(0)">'||idprotocoloatendimento||'</a>' idprotocoloatendimento
                     --, '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||idpedido ,'SESSION')||''',''_blank''); void(0)">'||idpedido||'</a>' idpedido
                     , idprotocoloatendimento
                     , idpedido
                     , idfilialromance
                     , nomefilialromance
                     , idprodutodetalhado
                     , nomeprodutodetalhado
                     , quantidade
                     , idprodutodetalhadotrocado
                     , nomeprodutotrocado
                     , (quantidaderecebidatrocada + it.quantidadenaorecebida) erros
                     , dataconfirmacaoestoque
                     , ( select pck_util_fav.fnc_nomeusuario(c.idusuario) usuario
                         from vw_classificacoespedidos_fav c
                         where c.idcaracteristicapedido = 18
                           and c.ididioma               = :P0_IDIDIOMA
                       and c.idpedido = it.idpedido ) "Usuario Montou"
                     , case
                         when confirmaajusteitemtrocado is null then
                           '<a href="javascript:apex.confirm(''Confirmar o ajuste de '||quantidade||' item(s) do produto '||nomeprodutodetalhado||
                                                                              ' e de '||quantidaderecebidatrocada||' item(s) do produto '||nomeprodutotrocado||' trocado ?'', 
                             { request:''CONFIRMARAJUSTETROCA'', set:{''P293_IDITEMPEDIDOTROCADO'':'||iditempedidotrocado||' }} )";><img src="#APP_IMAGES#ok.png"  border="0"></a>'
                         else
                           'Ajuste realizado'
                       end confirmaajusteitemtrocado
                 from vw_itenstrocapedidos_fav it
                where quantidaderecebidatrocada > 0
                and codconfirmacaoestoque = 'S'
                and idtipoprotocolo in (6)
                and ( 
                        (   confirmaajusteitemtrocado = 'S'   and :P293_AJUSTE = 'E' )
                     or (   confirmaajusteitemtrocado is null and :P293_AJUSTE = 'P' )
                     or ( ( confirmaajusteitemtrocado is null or confirmaajusteitemtrocado is not null ) and :P293_AJUSTE = 'T' )
                      )
                and ( (:P293_DATACONFIRMACAOINICIAL is null and :P293_DATACONFIRMACAOFINAL is null) 
                  or trunc(dataconfirmacaoestoque) between :P293_DATACONFIRMACAOINICIAL and :P293_DATACONFIRMACAOFINAL)
                and idfilialromance in ( select a.idfilialdestino
                                         from atendimentosfiliaisrmc a
                                         where a.idfilialdestino = it.idfilialromance
                                         and a.idfilialfavoritaorigem = :P293_IDFILIALFAVORITA )
                and ididioma = 1
                
                union
                select iditemexcluido
                     --, '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':130:'||v('APP_SESSION')||'::NO::P130_IDPROTOCOLOATENDIMENTO:'||idprotocoloatendimento ,'SESSION')||''',''_blank''); void(0)">'||idprotocoloatendimento||'</a>' idprotocoloatendimento
                     --, '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||idpedido ,'SESSION')||''',''_blank''); void(0)">'||idpedido||'</a>' idpedido
                     , idprotocoloatendimento
                     , idpedido
                     , idfilialromance
                     , nomefilialromance
                     , idprodutodetalhado
                     , nomeprodutodetalhado
                     , quantidade
                     , idprodutodetalhadotrocado
                     , nomeprodutotrocado
                     , (quantidaderecebidatrocada + ie.quantidadenaorecebida) erros
                     , dataconfirmacaoestoque
                     , ( select pck_util_fav.fnc_nomeusuario(c.idusuario) usuario
                         from vw_classificacoespedidos_fav c
                         where c.idcaracteristicapedido = 18
                           and c.ididioma               = :P0_IDIDIOMA
                       and c.idpedido = ie.idpedido ) "Usuario Montou"
                     , case
                         when confirmaajusteitemtrocado is null then
                           '<a href="javascript:apex.confirm(''Confirmar o ajuste de '||quantidade||' item(s) do produto '||nomeprodutodetalhado||
                                                                              ' e de '||quantidaderecebidatrocada||' item(s) do produto '||nomeprodutotrocado||' trocado ?'', 
                             { request:''CONFIRMARAJUSTEEXCLUSAO'', set:{''P293_IDITEMEXCLUIDO'':'||iditemexcluido||' }} )";><img src="#APP_IMAGES#ok.png"  border="0"></a>'
                         else
                           'Ajuste realizado'
                       end confirmaajusteitemtrocado
                 from vw_itensexcluidospedidos_fav ie
                where quantidaderecebidatrocada > 0
                and codconfirmacaoestoque = 'S'
                and idtipoprotocolo in (4)
                and ( 
                        (   confirmaajusteitemtrocado = 'S'   and :P293_AJUSTE = 'E' )
                     or (   confirmaajusteitemtrocado is null and :P293_AJUSTE = 'P' )
                     or ( ( confirmaajusteitemtrocado is null or confirmaajusteitemtrocado is not null ) and :P293_AJUSTE = 'T' )
                      )
                and ( (:P293_DATACONFIRMACAOINICIAL is null and :P293_DATACONFIRMACAOFINAL is null) 
                  or trunc(dataconfirmacaoestoque) between :P293_DATACONFIRMACAOINICIAL and :P293_DATACONFIRMACAOFINAL)
                and idfilialromance in ( select a.idfilialdestino
                                         from atendimentosfiliaisrmc a
                                         where a.idfilialdestino = ie.idfilialromance
                                         and a.idfilialfavoritaorigem = :P293_IDFILIALFAVORITA )
                and ididioma = 1                         
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
