            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: GRUPO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column QTDPEDIDOS (
            type: numberField
            heading {
                heading: Pedidos
                alignment: center
            }
            settings {
                numberAlignment: center
                virtualKeyboard: text
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                databaseColumn: QTDPEDIDOS
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column VALORPAGO (
            type: numberField
            heading {
                heading: Valor Pago
                alignment: center
            }
            settings {
                numberAlignment: center
                virtualKeyboard: text
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                databaseColumn: VALORPAGO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

    )

    pageItem P359_IDGRUPO (
        type: selectList
        label {
            label: Grupo
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct 
                       grupo as d
                     , idgrupo as r
                from roman.vw_filiais
                where idgrupo is not null
                order by grupo
                ```
            displayExtraValues: false
            nullDisplayValue: "- Todos - "
        }
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 20
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconRight
                t-Button--stretch
