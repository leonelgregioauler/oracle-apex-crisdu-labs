page 359 (
    name: Relatório Pagamentos por Grupo (Agosto 2019 a Novembro 2020)
    title: Relatório Pagamentos por Grupo
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region relatório-pagamentos-por-distribuidor-grupo-agosto-2019-a-novembro (
        name: Relatório Pagamentos por Distribuidor / Grupo (Agosto 2019 a Novembro 2020)
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select count(ped.idpedido) qtdpedidos
                     , sum(( select sum(v.valorpago)
                        from vencimentospedidos v
                        where v.idpedido = ped.idpedido
                        and v.situacaovencimento = 'V' )) valorpago
                     , pck_util_fav.fnc_nomerepresentante(idrepresentante) distribuidor
                     , pck_util_fav.fnc_nomefilialromance(idfilialromance) filialromance
                from pedidos ped 
                   , roman.vw_filiais f
                where ped.idfilialromance = f.idfilial 
                and (:P359_IDGRUPO is null or f.idgrupo = :P359_IDGRUPO)
                and exists ( select 1
                             from pagamentospedidos  pp  
                                , vencimentospedidos vp
                             where pp.idvencimentopedido = vp.idvencimentopedido 
                             and vp.idpedido = ped.idpedido
                             and trunc(pp.databaixa) between to_date('08/2019', 'mm/rrrr') and to_date('30/11/2020', 'dd/mm/rrrr') 
                             --and vp.valorpagar - vp.valorpago = 0
                             and vp.situacaovencimento = 'V' )
                and f.idgrupo is not null
                and not exists ( select 1
                                 from classificacoespedidos cp
                                 where cp.idpedido = ped.idpedido
                                 and cp.idcaracteristicapedido = 25 )
                and not exists ( select 1
                                 from vendedoras v
                                 where v.idvendedora = ped.idvendedora
                                  and v.idrepresentante = ped.idrepresentante
                                  and v.idpessoa     = ( select f.idpessoa
                                                         from roman.funcionarios f
                                                         where f.idpessoa = v.idpessoa
                                                         and f.ativo = 'S' ) ) 
                and not exists ( select 1
                                 from vendedoras v
                                 where v.idvendedora = ped.idvendedora
                                  and v.idrepresentante = ped.idrepresentante
                                  and v.idpessoa     = ( select g.idpessoa
                                                         from gerentes g
                                                         where g.idgerente = ped.idgerente
                                                         and g.ativo = 'S' ) ) 
                and not exists ( select 1
                                 from representantes r
                                 where r.idrepresentante = ped.idrepresentante
                                 and r.ativo = 'N' )
                group by idrepresentante, idfilialromance
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
            filename: relatorio
        }
        advanced {
            savedReportMappingIdentifier: 1565052744336769462
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @QTDPEDIDOS
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @DISTRIBUIDOR
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @VALORPAGO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @FILIALROMANCE
                layout {
                    sequence: 0
                }
            )

        )

        column DISTRIBUIDOR (
            type: textarea
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 10
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: DISTRIBUIDOR
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column FILIALROMANCE (
            type: textarea
            heading {
                heading: Filial Romance
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: FILIALROMANCE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column QTDPEDIDOS (
            type: numberField
            heading {
                heading: Pedidos
                alignment: center
            }
            settings {
                numberAlignment: center
                virtualKeyboard: text
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                databaseColumn: QTDPEDIDOS
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column VALORPAGO (
            type: numberField
            heading {
                heading: Valor Pago
                alignment: center
            }
            settings {
                numberAlignment: center
                virtualKeyboard: text
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                databaseColumn: VALORPAGO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

    )

    region relatório-pagamentos-por-grupo-agosto-2019-a-novembro (
        name: Relatório Pagamentos por Grupo (Agosto 2019 a Novembro 2020)
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select count(ped.idpedido) qtdpedidos
                     , sum(( select sum(v.valorpago)
                        from vencimentospedidos v
                        where v.idpedido = ped.idpedido
                        and v.situacaovencimento = 'V' )) valorpago
                     , grupo
                from pedidos ped 
                   , roman.vw_filiais f
                where ped.idfilialromance = f.idfilial 
                and exists ( select 1
                             from pagamentospedidos  pp  
                                , vencimentospedidos vp
                             where pp.idvencimentopedido = vp.idvencimentopedido 
                             and vp.idpedido = ped.idpedido
                             and trunc(pp.databaixa) between to_date('08/2019', 'mm/rrrr') and to_date('30/11/2020', 'dd/mm/rrrr') 
                             --and vp.valorpagar - vp.valorpago = 0
                             and vp.situacaovencimento        = 'V' )
                and f.idgrupo is not null
                and not exists ( select 1
                                 from classificacoespedidos cp
                                 where cp.idpedido = ped.idpedido
                                 and cp.idcaracteristicapedido = 25 )
                and not exists ( select 1
                                 from vendedoras v
                                 where v.idvendedora = ped.idvendedora
                                  and v.idrepresentante = ped.idrepresentante
                                  and v.idpessoa     = ( select f.idpessoa
                                                         from roman.funcionarios f
                                                         where f.idpessoa = v.idpessoa
                                                         and f.ativo = 'S' ) ) 
                and not exists ( select 1
                                 from vendedoras v
                                 where v.idvendedora = ped.idvendedora
                                  and v.idrepresentante = ped.idrepresentante
                                  and v.idpessoa     = ( select g.idpessoa
                                                         from gerentes g
                                                         where g.idgerente = ped.idgerente
                                                         and g.ativo = 'S' ) )   
                and not exists ( select 1
                                 from representantes r
                                 where r.idrepresentante = ped.idrepresentante
                                 and r.ativo = 'N' )                                         
                group by grupo
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
            filename: relatorio
        }
        advanced {
            savedReportMappingIdentifier: 1561460713557142650
        }

