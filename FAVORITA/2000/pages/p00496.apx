                t-Button--warning
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @filtrar-2
        }

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        name: Go To Page 496
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 496
                items: {
                    P496_NAOFILTRAR: S
                }
                action: resetPagination
            }
        }
    )

)

