    region aniversariantes-do-dia-lojas (
        name: Aniversariantes do Dia (Lojas)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) nome
                     , roman.pck_romance.fnc_nomerepresentante(v.idrepresentante) distribuidor
                     , p.cpf
                     , p.datanascimento
                     , p.enderecoprincipal endereco
                     , p.numero nr
                     , p.bairro bairro
                     , p.cep
                     , roman.pck_romance.fnc_nomecidade(p.idcidade) cidade
                     , roman.pck_romance.fnc_retornatelefones(v.idvendedora) telefone
                     , case
                         when :P0_IDFILIALFAVORITA is not null and :P496_IDESTADO is not null then
                           nvl( ( select 'Sim'
                                  from dual
                                  where exists ( select 1
                                                 from pedidos pp
                                                 where pp.idvendedora = v.idvendedora
                                                   and pp.datacancelamento is null
                                                   and pp.idfilialfavorita = :P0_IDFILIALFAVORITA ) ),'Não') 
                          else
                            'Não'
                        end visitou_loja
                     , case
                         when :P0_IDFILIALFAVORITA is not null and :P496_IDESTADO is not null then
                           nvl( ( select 'Sim'
                                  from dual
                                  where ( select nvl(( select sum(pv.saldodevedor)
                                                       from vw_pedidos_fav pv
                                                       where pv.idvendedora    = v.idvendedora          
                                                         and pv.datacancelamento is null
                                                         and pv.saldodevedor > 0)  ,0)
                                               + nvl(( select sum(c.valorapagar - c.valorpago)
                                                       from vw_pedidos_old c
                                                       where c.idvendedora    = v.idvendedora
                                                         and c.saldodevedor > 0.5 
                                                         and c.idsituacao not in ( 'Q','U','K') ) ,0)
                                          from dual ) > 0 ),'Não') 
                         else
                           '-'
                       end debito_favorita
                     , case
                         when :P0_IDFILIALFAVORITA is not null and :P496_IDESTADO is not null then
                           nvl( ( select 'Sim'
                                  from dual
                                  where exists ( select 1
                                                 from roman.notasvendas nv
                                                 where nv.idvendedora = v.idvendedora
                                                   and nv.idsituacaonotavenda = 4
                                                   and nv.saldo > 0 ) ),'Não')
                         else
                           '-'
                       end debito_romance
                    , round(v.pontos) pontos
                from pessoas p
                   , vendedoras v
                where --(to_char(p.datanascimento,'DD/MM') between :P496_DATAINI and :P496_DATAFIM)
                      TO_CHAR(p.datanascimento, 'MMDD') BETWEEN TO_CHAR(TO_DATE(:P496_DATAINI, 'DD/MM'), 'MMDD') 
                                                            AND TO_CHAR(TO_DATE(:P496_DATAFIM, 'DD/MM'), 'MMDD') 
                  and v.idpessoa                        = p.idpessoa
                  and v.ativo                           = 'S'
                  and p.idpais                          = :P0_IDIDIOMA
                  and ( :P496_IDESTADO is null or exists ( select 1
                                                           from catal.cidades c
                                                           where c.idcidade = p.idcidade
                                                             and c.idestado = :P496_IDESTADO ) )
                  and not exists ( select 1
                                   from representantes r
                                   where r.idpessoa = p.idpessoa )
                  and not exists ( select 1
                                   from gerentes g
                                   where g.idpessoa = p.idpessoa )
                  and (:P496_NAOFILTRAR = 'S')
                order by 1
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: Aniversariantes do Dia (Lojas)
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.usuariosgruposatendimento ug
                where ug.idgrupoatendimento in (0,3,4,33,34)
                  and ug.usuario = V('APP_USER')
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 103179907222379144
        }

