    region aniversariantes-do-dia-call-center (
        name: Aniversariantes do Dia (Call Center)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) nome
                     , roman.pck_romance.fnc_nomerepresentante(v.idrepresentante) distribuidor
                     , case
                         when p.idpais = 1 then
                           p.cpf
                         else
                           p.documentoestrangeiro
                       end cpf 
                     , p.datanascimento
                     , p.enderecoprincipal endereco
                     , p.numero nr
                     , p.bairro bairro
                     , p.cep
                     , roman.pck_romance.fnc_nomecidade(p.idcidade) cidade
                     , roman.pck_romance.fnc_retornatelefones(v.idvendedora) telefone
                     , round(v.pontos) pontos
                     , ( select max(dataretorno)
                         from roman.notasvendas nv
                         where nv.idvendedora = v.idvendedora
                           and nv.idsituacaonotavenda = 3 ) dataretorno
                from pessoas p
                   , vendedoras v
                where TO_CHAR(p.datanascimento, 'MMDD') BETWEEN TO_CHAR(TO_DATE(:P496_DATAINI_1, 'DD/MM'), 'MMDD') 
                                                            AND TO_CHAR(TO_DATE(:P496_DATAFIM_1, 'DD/MM'), 'MMDD') -- t9946631
                  and v.idpessoa                        = p.idpessoa
                  and v.ativo                           = 'S'
                  and p.idpais                          = :P496_IDPAIS
                  and ( :P496_IDESTADO_1 is null or exists ( select 1
                                                           from catal.cidades c
                                                           where c.idcidade = p.idcidade
                                                             and c.idestado = :P496_IDESTADO_1 ) )
                  and not exists ( select 1
                                   from roman.notasvendas nv
                                   where nv.idvendedora = v.idvendedora
                                     and nv.saldo       > 0
                                     and nv.idsituacaonotavenda = 4 )
                  and not exists ( select 1
                                   from pedidos pf
                                      , vencimentospedidos vp
                                   where pf.idvendedora = v.idvendedora
                                     and pf.datacancelamento is null
                                     and vp.idpedido = pf.idpedido
                                     and vp.situacaovencimento = 'V'
                                     and trunc(vp.datavencimento) < trunc(sysdate)
                                     and vp.valorpagar > vp.valorpago )
                  and not exists ( select 1
                                   from catal.boletos b
                                   where b.idvendedora = v.idvendedora
                                     and b.situacao in ('V','G','S','M','K','E') )
                  and not exists ( select 1
                                   from representantes r
                                   where r.idpessoa = p.idpessoa )
                  and not exists ( select 1
                                   from gerentes g
                                   where g.idpessoa = p.idpessoa )
                order by 1
                ```
            pageItemsToSubmit: [
                P496_IDESTADO_1
                P496_IDPAIS
            ]
        }
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.usuariosgruposatendimento ug
                where ug.idgrupoatendimento in (0,3,4,33,34)
                  and ug.usuario = V('APP_USER')
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 5985920922554045720
        }

