    pageItem P280_IDPRODUTO (
        type: plugin/select
        label {
            label: Produto
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select referencia||'-'||nomeproduto display_value
                  , idproduto
                from vw_produtos_fav
                where ididioma = :P0_IDIDIOMA
                order by nomeproduto
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 120
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
