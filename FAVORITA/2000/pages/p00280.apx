    validation data-final (
        name: Data Final
        execution {
            sequence: 20
        }
        validation {
            language: sql
            sqlExpression: :P280_DATACONFIRMACAOFINAL is not null or :P280_TIPOITEM = 'F'
        }
        error {
            errorMessage: Informe a data final
        }
        serverSideCondition {
            type: request=Value
            value: FILTRAR
        }
    )

