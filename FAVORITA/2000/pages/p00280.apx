    process ajustar-pedido-virtual-age (
        name: Ajustar Pedido Virtual Age
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidvalorcaracteristica   number;
                begin
                  --
                  select idvalorcaracteristica
                  into vidvalorcaracteristica
                  from classificacoespedidos 
                  where idpedido = :P280_PEDIDO
                  and idcaracteristicapedido = 43;
                  --
                  update pedidos 
                  set idpedidovirtualage = vidvalorcaracteristica
                  where idpedido = :P280_PEDIDO;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 110
        }
        advanced {
            executionMappingIdentifier: 1492700248408274128
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMARAJUSTEINTEGRACAO
        }
    )

