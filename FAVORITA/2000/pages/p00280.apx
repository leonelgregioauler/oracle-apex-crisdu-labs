    region itens-com-aviso-de-falta (
        name: Itens com Aviso de Falta
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select iditempedido
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||ii.idpedido ,'SESSION')||''',''_blank''); void(0)">'||ii.idpedido||'</a>' idpedido
                     , idfilialromance
                     , nomefilialromance
                     , ( select pes.nomepessoa 
                         from pessoas pes
                            , vendedoras v
                         where pes.idpessoa = v.idpessoa
                         and v.idvendedora  = ( select ped.idvendedora
                                                from pedidos ped
                                                where ped.idpedido = ii.idpedido ) ) nomeconsultora
                     , ( select pes.cpf 
                         from pessoas pes
                            , vendedoras v
                         where pes.idpessoa = v.idpessoa
                         and v.idvendedora  = ( select ped.idvendedora
                                                from pedidos ped
                                                where ped.idpedido = ii.idpedido ) ) cpfconsultora
                     , case
                         when confirmaentradavirtualage is null then
                          '<a href="javascript:apex.confirm(''Confirmar entrada de '||quantidade||' item(s) do produto '||nomeprodutodetalhado||' no estoque do Virtual Age ? '', 
                              { request:''CONFIRMARAVISOFALTA'', set:{''P280_IDITEMPEDIDOAVISOFALTA'':'||iditempedido||' }} )";><img src="#APP_IMAGES#ok.png"  border="0"></a>'
                         else
                          'Entrada realizada'
                       end confirmarentrada
                     , case
                         when confirmaentradavirtualage is null then
                           '<a href="javascript:apex.confirm(''Confirmar entrada de todos os itens do pedido '||idpedido||' no estoque do Virtual Age ? '', 
                             { request:''CONFIRMARAVISOFALTATODOS'', set:{''P280_IDPEDIDOAVISOFALTA'':'||idpedido||' }} )";><img src="#APP_IMAGES#ok.png"  border="0"></a>'
                         else
                           'Entrada realizada'
                       end confirmarentradatodos
                     , idproduto
                     , nomeproduto
                     , idprodutodetalhado
                     , nomeprodutodetalhado
                     , quantidade
                     , (select p.dataemissao
                        from favorita.pedidos p
                        where p.idpedido = ii.idpedido) dataemissao_pedido
                     , (select p.dataentrega
                        from favorita.pedidos p
                        where p.idpedido = ii.idpedido) dataentrega_pedido
                from vw_itensindisppedidos_fav ii
                where idusuario is not null -- Aviso gerado por usuário do estoque 
                  and (:P280_IDPEDIDO is null or idpedido  = :P280_IDPEDIDO)
                  and (:P280_IDPRODUTO is null or idproduto = :P280_IDPRODUTO)
                  and (:P280_IDPRODUTODETALHADO is null or idprodutodetalhado = :P280_IDPRODUTODETALHADO)
                  and (:P280_IDFILIALROMANCE is null or idfilialromance = :P280_IDFILIALROMANCE)
                  and exists ( select 1
                               from pedidos ped
                               where ped.idfilialfavorita = :P280_IDFILIALFAVORITA
                               and ped.idpedido = ii.idpedido )   
                  and ( ii.idfilialromance in ( select idfilialdestino
                                                from atendimentosfiliaisrmc a
                                                where a.idfilialfavoritaorigem = :P280_IDFILIALFAVORITA ) )
                  and ( 
                        (   confirmaentradavirtualage = 'S'   and :P280_ENTRADAVIRTUALAGE = 'E' )
                     or (   confirmaentradavirtualage is null and :P280_ENTRADAVIRTUALAGE = 'P' )
                     or ( ( confirmaentradavirtualage is null or confirmaentradavirtualage is not null ) and :P280_ENTRADAVIRTUALAGE = 'T' )
                      )
                   and ididioma = :P0_IDIDIOMA
                
                 
                
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1504276518515921104
        }

