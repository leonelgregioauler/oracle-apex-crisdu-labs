    pageItem P280_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Filial Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) display_value
                     , idfilialfavorita   return_value
                from filiaisfavorita f
                where ( :P280_TIPOFILIAL = 'L'  and f.tipofilial  = 'L'
                     or :P280_TIPOFILIAL = 'CS' and f.tipofilial != 'L' )
                  and f.tipofilial not in ('E', 'V')
                  and exists ( select 1
                               from usuariosfiliaisfavorita u
                               where u.idfilialfavorita = f.idfilialfavorita
                                 and u.consultar = 'S'
                                 and u.idusuario = :P0_IDUSUARIO )
                ```
            nullDisplayValue: - Todas -
        }
        cascadingLov {
            parentItems: [
                P280_TIPOFILIAL
                P0_IDUSUARIO
            ]
        }
        layout {
            sequence: 150
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P280_IDFILIALROMANCE (
        type: selectList
        label {
            label: Filial Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct 
                       pck_util_fav.fnc_nomefilialromance(afr.idfilialdestino) as d,
                       afr.idfilialdestino as r
                  from atendimentosfiliaisrmc afr
                     , filiaisfavorita f
                 where afr.idfilialfavoritaorigem = f.idfilialfavorita
                   and afr.idfilialdestino in ( select idfilial
                                                from roman.vw_filiais
                                                where tipofilial != 'P')
                 order by 1
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 160
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

