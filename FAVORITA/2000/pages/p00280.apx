    region itens-excluídos (
        name: Itens Excluídos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select iditemexcluido
                     , iditempedido
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||ie.idpedido ,'SESSION')||''',''_blank''); void(0)">'||ie.idpedido||'</a>' idpedido
                     , idfilialromance
                     , nomefilialromance
                     , ( select pes.nomepessoa 
                         from pessoas pes
                            , vendedoras v
                         where pes.idpessoa = v.idpessoa
                         and v.idvendedora  = ( select ped.idvendedora
                                                from pedidos ped
                                                where ped.idpedido = ie.idpedido ) ) nomeconsultora
                     , ( select pes.cpf 
                         from pessoas pes
                            , vendedoras v
                         where pes.idpessoa = v.idpessoa
                         and v.idvendedora  = ( select ped.idvendedora
                                                from pedidos ped
                                                where ped.idpedido = ie.idpedido ) ) cpfconsultora
                     , case
                         when confirmaentradavirtualage is null then
                          '<a href="javascript:apex.confirm(''Confirmar entrada de '||quantidade||' item(s) do produto '||nomeprodutodetalhado||' no estoque do Virtual Age ? '', 
                              { request:''CONFIRMAREXCLUSAO'', set:{''P280_IDITEMPEDIDOEXCLUIDO'':'||iditemexcluido||' }} )";><img src="#APP_IMAGES#ok.png"  border="0"></a>'
                         else
                          'Entrada realizada'
                       end confirmarentrada
                     , case
                         when confirmaentradavirtualage is null then
                           '<a href="javascript:apex.confirm(''Confirmar entrada de todos os itens do pedido '||idpedido||' no estoque do Virtual Age ? '', 
                             { request:''CONFIRMAREXCLUSAOTODOS'', set:{''P280_IDPEDIDOEXCLUIDO'':'||idpedido||' }} )";><img src="#APP_IMAGES#ok.png"  border="0"></a>'
                         else
                           'Entrada realizada'
                       end confirmarentradatodos
                     , case
                         when idpedidovirtualage is null then
                           '<a href="javascript:apex.confirm(''Confirmar ajuste na integração do pedido '||idpedido||' ? '', 
                             { request:''CONFIRMARAJUSTEINTEGRACAO'', set:{''P280_PEDIDO'':'||idpedido||' }} )";><img src="#APP_IMAGES#ok.png"  border="0"></a>'
                         else
                           null
                       end confirmarajusteintegracao
                     , idproduto
                     , nomeproduto
                     , idprodutodetalhado
                     , nomeprodutodetalhado
                     , quantidade
                     , idprotocoloatendimento
                     , confirmacaoestoque
                     , idusuarioestoque
                     , usuarioestoque
                     , idmotivoprotocolo
                     , motivoprotocolo
                     , justificativa
                     , iddefeito
                     , defeito
                     , quantidadedevolvida
                     , valorvendaoriginal
                     , codconfirmacaoestoque
                     , dataconfirmacaoestoque
                     , ( select pck_util_fav.fnc_nomeusuario(c.idusuario) usuario
                         from vw_classificacoespedidos_fav c
                         where c.idcaracteristicapedido = 18
                           and c.ididioma = :P0_IDIDIOMA
                           and c.idpedido = ie.idpedido) "Usuario Montou"
                     , (select p.dataemissao
                        from favorita.pedidos p
                        where p.idpedido = ie.idpedido) dataemissao_pedido
                     , (select p.dataentrega
                        from favorita.pedidos p
                        where p.idpedido = ie.idpedido) dataentrega_pedido
                from vw_itensexcluidospedidos_fav ie
                where ie.codconfirmacaoestoque = 'S'
                  and ie.situacaoprotocolo = 'C'
                  and dataconfirmacaoestoque is not null and trunc(dataconfirmacaoestoque) between :P280_DATACONFIRMACAOINICIAL and :P280_DATACONFIRMACAOFINAL
                  and (:P280_IDPEDIDO is null or idpedido  = :P280_IDPEDIDO)
                  and (:P280_IDPROTOCOLOATENDIMENTO is null or idprotocoloatendimento = :P280_IDPROTOCOLOATENDIMENTO )
                  and (:P280_IDPRODUTO is null or idproduto = :P280_IDPRODUTO)
                  and (:P280_IDPRODUTODETALHADO is null or idprodutodetalhado = :P280_IDPRODUTODETALHADO)
                  and (:P280_TIPOFILIAL = 'L' and (idfilialfavorita in ( select idfilialfavorita
                                                                           from filiaisfavorita
                                                                           where tipofilial = 'L' ) and (:P280_IDFILIALFAVORITA is null or idfilialfavorita = :P280_IDFILIALFAVORITA) )
                   or  :P280_TIPOFILIAL = 'CS' and (idfilialfavorita in ( select idfilialfavorita 
                                                                            from filiaisfavorita 
                                                                            where tipofilial in ('C', 'S') ) and (:P280_IDFILIALFAVORITA is null or idfilialfavorita = :P280_IDFILIALFAVORITA) ) )
                  and (:P280_IDFILIALROMANCE is null or idfilialromance = :P280_IDFILIALROMANCE)
                  and (  
                        ( idpedidovirtualage is not null and :P280_INTEGRADOVIRTUALAGE = 'S')
                     or ( :P280_INTEGRADOVIRTUALAGE is null )
                      )
                  and (  
                        ( idpedidovirtualage is null and :P280_INTEGRADOCOMERRO = 'S'
                          and exists ( select 1
                                       from classificacoespedidos cp
                                       where cp.idcaracteristicapedido = 43
                                       and cp.idvalorcaracteristica is not null
                                       and cp.idpedido = ie.idpedido ) )
                     or ( :P280_INTEGRADOCOMERRO is null )
                      ) 
                  and ( 
                        (   confirmaentradavirtualage = 'S'   and :P280_ENTRADAVIRTUALAGE = 'E' )
                     or (   confirmaentradavirtualage is null and :P280_ENTRADAVIRTUALAGE = 'P' )
                     or ( ( confirmaentradavirtualage is null or confirmaentradavirtualage is not null ) and :P280_ENTRADAVIRTUALAGE = 'T' )
                      )
                   and ididioma = :P0_IDIDIOMA
                
                 
                
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
