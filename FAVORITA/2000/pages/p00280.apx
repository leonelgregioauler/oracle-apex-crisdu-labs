    dynamicAction itens-de-aviso-de-falta (
        name: Itens de Aviso de Falta
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P280_TIPOITEM
        }
        clientSideCondition {
            type: item=value
            item: P280_TIPOITEM
            value: F
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: region
                region: @filtros
            }
            execution {
                sequence: 10
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: region
                region: @itens-pedidos-de-devolução
            }
            execution {
                sequence: 20
            }
        )

        action native-hide-3 (
            action: hide
            affectedElements {
                selectionType: region
                region: @itens-pedidos-de-troca
            }
            execution {
                sequence: 30
            }
        )

        action native-hide-4 (
            action: hide
            affectedElements {
                selectionType: region
                region: @itens-excluídos
            }
            execution {
                sequence: 40
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: region
                region: @itens-com-aviso-de-falta
            }
            execution {
                sequence: 50
            }
        )

    )

