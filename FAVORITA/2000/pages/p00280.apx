        }
    )

    pageItem P280_IDPRODUTODETALHADO (
        type: plugin/select
        label {
            label: Produto Detalhado
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomeprodutodetalhado(idprodutodetalhado, 1) as d
                     , idprodutodetalhado as r
                   from favorita.produtosdetalhados
                 where idproduto = :P280_IDPRODUTO
                 order by 1
                ```
            nullDisplayValue: - Todos -
        }
        cascadingLov {
            parentItems: P280_IDPRODUTO
        }
        layout {
