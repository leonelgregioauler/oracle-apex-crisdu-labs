    pageItem P368_IDPROUTODETALHADO (
        type: popupLov
        label {
            label: Produto
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeprodutodetalhado(pd.idprodutodetalhado,:P0_IDIDIOMA) display_value
                     , pd.idprodutodetalhado
                from produtosdetalhados pd
                   , fornecedoresprodutos fp
                where ( :P368_IDFORNECEDOR is null or fp.idfornecedor = :P368_IDFORNECEDOR )
                  and fp.idproduto = pd.idproduto
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P368_IDFORNECEDOR
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: FILTRAR
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 368
                items: {
                    P368_IDFORNECEDOR: &P368_IDFORNECEDOR.
                    P368_IDPROUTODETALHADO: &P368_IDPROUTODETALHADO.
                    P368_DATAINICIO: &P368_DATAINICIO.
                    P368_DATAFIM: &P368_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

