page 368 (
    name: Acompanhamento de Compras
    title: Acompanhamento de Compras
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region acompanhamento-de-compras (
        name: Acompanhamento de Compras
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idcompratransferencia
                     , c.idfornecedor
                     , c.nomefornecedor
                     , c.idfilialfavoritadestino
                     , c.filialfavoritadestino
                     , c.numero
                     , c.notafiscal
                     , c.idtipocomptransrem
                     , c.desctipo tipo
                     , c.dataemissao
                     , c.datarecebimento
                     , ic.idprodutodetalhado
                     , pck_util_fav.fnc_nomeprodutodetalhado(ic.idprodutodetalhado,:P0_IDIDIOMA) produto
                     , ic.valorcusto
                     , nvl(ic.quantidadecomprada,0) quantidadecomprada
                     , nvl(ic.quantidaderecebida,0) quantidaderecebida
                     , nvl(ic.quantidaderecebida,0) * valorcusto totalrecebida
                     , nvl(ic.quantidadeavariada,0) quantidadeavariada
                     , nvl(ic.quantidadeavariada,0) * valorcusto totalavaria
                     , ic.observacao
                     , ic.observacaoavaria
                from itenscomprastransferencias ic
                   , vw_comprastransferencias_fav c
                where ic.idcompratransferencia = c.idcompratransferencia
                  and ( :P368_IDFORNECEDOR is null or c.idfornecedor = :P368_IDFORNECEDOR)
                  and ic.idprodutodetalhado = :P368_IDPROUTODETALHADO
                  and exists ( select 1
                               from classificacoescomprastransf cc
                               where cc.idcompratransferencia = c.idcompratransferencia
                                 and cc.idcaracteristicacomptransf = 6
                                 and trunc(cc.dataclassificado) between to_date(:P368_DATAINICIO) and to_date(:P368_DATAFIM) )
                  and c.ididioma = :P0_IDIDIOMA
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum dado encontrado, verifique os filtros.
        }
        advanced {
            savedReportMappingIdentifier: 1514290392380217002
        }

