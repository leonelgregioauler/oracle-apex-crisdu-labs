page 484 (
    name: Impressão Remessa
    title: Impressão Remessa
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
        cssClasses: 10
    }
    javaScript {
        fileUrls: <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css" integrity="sha384-MCw98/SFnGE8fJT3GXwEOngsV7Zt27NXFoaoApmYm81iuXoPkFOJwJ8ERdknLPMO" crossorigin="anonymous">
    }
    security {
        pageAccessProtection: unrestricted
    }

    region new (
        name: New
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                -- Created on 04/12/2020 by MAX.BERKEUER 
                declare 
                  --
                  vid_remessa number := :P484_ID_REMESSA;
                  vprot_total_exp number;
                  --
                begin
                  --
                  select cc.protocolototalexp
                  into vprot_total_exp
                  from comprastransferencias cc
                  where cc.idcompratransferencia = vid_remessa;
                  --
                  htp.p('    <style type="text/css">');
                  htp.p('        .folha {font-size: 12px;');
                  htp.p('                   font-family: Roboto, sans-serif;');
                  htp.p('                   page-break-after: always;');
                  htp.p('    </style>');  
                  --  
                  for i in 1..2 loop
                    --
                    htp.p('<div class="folha">');
                    htp.p('<div class="row justify-content-center thumbnail">');
                    htp.p('    <div class="col-xs-4 col-md-4" align="center">');
                    htp.p('        <h3>Romaneio de carga</h3>');
                    htp.p('    </div>');
                    htp.p('    <div class="col-xs-4 col-md-4">');
                    htp.p('        <span>Número da Remessa: '||vid_remessa||'</span><br>');
                    htp.p('        <span>Protocolo Integração: '||vprot_total_exp||'</span><br>');
                    htp.p('    </div>');
                    htp.p('    <div class="col-xs-4 col-md-4">');
                    htp.p('        <span>Data/Hora: '||to_char(sysdate,'DD/MM/YYYY HH24:MI')||'</span><br>');
                    htp.p('        <span>Usuário: '||:APP_USER||'</span><br>');
                    htp.p('    </div>        ');
                    htp.p('</div>    ');
                    htp.p('<br>');
                    htp.p('<br>');
                    htp.p('<table class="table table-sm table-bordered">');
                    htp.p('  <thead>');
                    htp.p('    <tr>');
                    htp.p('      <th scope="col"></th>');
                    htp.p('      <th scope="col">Pedido</th>');  
                    htp.p('      <th scope="col">Cliente</th>');
                    htp.p('      <th scope="col">Cpf</th>');
                    htp.p('      <th scope="col">Dt Emissão</th>');
                    htp.p('      <th scope="col">NFe</th>');
                    htp.p('      <th scope="col">Protocolo</th>');
                    htp.p('    </tr>');
                    htp.p('  </thead>');
                    htp.p('  <tbody>');
                    --
                    for c in (select rownum as nr_linha,
                                     p.idcompratransferencia,
                                     p.idpedido,
                                     initcap(pes.nomepessoa) as nome,
                                     pck_util_fav.fnc_mascara_documento(pes.cpf) as documento,
                                     pe.dataemissao as dt_emissao,
                                     (select max(n.numero)
                                     from crisdu.notasfiscais n
                                     where n.idpedidofavorita = pe.idpedido) as nfe,
                                     c.protocolototalexp as protocolo
                              from pedidosremessasct p,
                                   comprastransferencias c,
                                   pedidos pe,
                                   vendedoras v,
                                   pessoas pes
                              where p.idcompratransferencia = c.idcompratransferencia 
                              and p.idpedido = pe.idpedido
                              and pe.idvendedora = v.idvendedora
                              and v.idpessoa = pes.idpessoa
                              and p.idcompratransferencia = vid_remessa)
                    loop
                      --
                      htp.p('    <tr>');
                      htp.p('      <th scope="row">'||c.nr_linha||'</th>');
                      htp.p('      <td>'||c.idpedido||'</td>');    
                      htp.p('      <td>'||c.nome||'</td>');
                      htp.p('      <td>'||c.documento||'</td>');
                      htp.p('      <td>'||c.dt_emissao||'</td>');
                      htp.p('      <td>'||c.nfe||'</td>');
                      htp.p('      <td>'||c.protocolo||'</td>');
                      htp.p('    </tr>');    
                      --
                    end loop;
                    --
                    htp.p('  </tbody>');
                    htp.p('</table>');
                    htp.p('<br><br><br><br><br><br>');
                    htp.p('<div class="row">');
                    htp.p('<br><br><br><br><br><br>');
                    htp.p('    <div class="col-xs-6 col-md-6">');
                    htp.p('        <span>Assinatura Motorista:___________________________________________________</span>');
                    htp.p('    </div>');
                    htp.p('    <div class="col-xs-6 col-md-6">');
                    htp.p('        <span>Assinatura Responsável:___________________________________________________</span>');
                    htp.p('    </div>    ');
                    htp.p('</div>');
                    htp.p('</div>');  
                    --
                  end loop;
                  --
                end;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P484_ID_REMESSA (
        type: hidden
        layout {
            sequence: 10
            region: @new
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

