page 590 (
    name: Relatorio de  Subremessas de Pedidos
    title: Relatorio de  Subremessas de Pedidos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region report (
        name: Report 1
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select S.IDSUBREMESSA, 
                       S.IDREMESSA,
                       R.DESCRICAO REMESSA,
                       S.DESCRICAO,
                       to_char(S.DATAABERTURA,'DD/MM/RRRR HH24:MI:SS')   DATAABERTURA,
                       to_char(S.DATAFECHAMENTO,'DD/MM/RRRR HH24:MI:SS') DATAFECHAMENTO,
                       S.IDFILIALFAVORITA,
                       decode(S.TIPOSUBREMESSA,'N', 'Normal','Imediata') "Tipo Sub-Remessa",
                       (select count(*) 
                          from pedidos 
                         where idsubremessa = s.idsubremessa) QtdPedidos
                  from SUBREMESSAS  S
                     , REMESSAS     R
                 where s.idremessa = R.idremessa
                  
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 591
                items: {
                    P591_IDSUBREMESSA: #IDSUBREMESSA#
                    P591_VOLTAPARA: 590
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhuma Sub-remessa localizada!
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 565684718789928147
        }

        column DATAABERTURA (
            type: plainText
            heading {
                heading: Dataabertura
                alignment: center
            }
            layout {
                sequence: 57
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: L
            }
        )

        column DATAFECHAMENTO (
            type: plainText
            heading {
                heading: Data Fechamento
            }
            layout {
                sequence: 47
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: K
            }
        )

        column DESCRICAO (
            type: plainText
            heading {
                heading: Sub-Remessa
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column IDFILIALFAVORITA (
            type: plainTextBasedOnLov
            heading {
                heading: Filial Favorita
            }
            lov {
                lov: @lov-filiaisfavorita
            }
            layout {
                sequence: 6
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column IDREMESSA (
            type: hidden
            heading {
                heading: Idremessa
            }
            layout {
                sequence: 2
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
            security {
                escapeSpecialChars: false
            }
        )

        column IDSUBREMESSA (
            type: hidden
            heading {
                heading: Idsubremessa
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column QTDPEDIDOS (
            type: plainText
            heading {
                heading: Qtd.Pedidos
                alignment: end
            }
            layout {
                sequence: 37
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: J
            }
        )

        column REMESSA (
            type: plainText
            heading {
                heading: Remessa
            }
            layout {
                sequence: 17
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column "Tipo Sub-Remessa" (
            type: plainText
            heading {
                heading: Tipo Sub-remessa
            }
            layout {
                sequence: 27
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 5657169 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAABERTURA (
                sequence: 2
            )

            displayColumn DATAFECHAMENTO (
                sequence: 3
            )

            displayColumn DESCRICAO (
                sequence: 1
            )

            displayColumn IDFILIALFAVORITA (
                sequence: 4
            )

            displayColumn QTDPEDIDOS (
                sequence: 7
            )

            displayColumn REMESSA (
                sequence: 5
            )

            displayColumn "Tipo Sub-Remessa" (
                sequence: 6
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Nova Sub-Remessa
        layout {
            sequence: 30
            region: @report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 591
                items: {
                    P591_VOLTAPARA: 590
                }
                clearCache: 591
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

