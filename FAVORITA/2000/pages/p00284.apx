page 284 (
    name: Controle de Atendimento por Area
    title: Controle de Atendimento por Area
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region controle-de-atendimento-por-código-de-area (
        name: Controle de Atendimento por Código de Area
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDCODIGOAREAATENDENTE,
                       CODIGOAREA,
                       IDUSUARIO
                from CODIGOAREAATENDENTES c
                where exists ( select 1 
                               from roman.usuariosgruposatendimento ug
                                  , usuarios u
                               where u.usuario = ug.usuario
                                 and u.idusuario = c.idusuario 
                                 and ug.idgrupoatendimento in ( select ugg.idgrupoatendimento
                                                                from roman.usuariosgruposatendimento ugg
                                                                where ugg.usuario = v('APP_USER' ) ) )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 1565503544321609006
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDCODIGOAREAATENDENTE
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @CODIGOAREA
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @IDUSUARIO
                layout {
                    sequence: 2
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column CODIGOAREA (
            type: numberField
            heading {
                heading: Código de Area
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                databaseColumn: CODIGOAREA
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column IDCODIGOAREAATENDENTE (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDCODIGOAREAATENDENTE
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: SEQ_IDCODIGOAREAATENDENTE
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDUSUARIO (
            type: selectList
            heading {
                heading: Atendente
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select roman.pck_romance.fnc_nomeusuario(u.usuario) display_value
                         , idusuario return_value
                    from usuarios u 
                       , roman.usuariosgruposatendimento ug
                    where ug.usuario = u.usuario
                      and exists ( select 1
                                   from roman.usuariosgruposatendimento ugg
                                   where ugg.idgrupoatendimento = ug.idgrupoatendimento
                                     and ugg.usuario = v('APP_USER') )
                    order by 1
                    ```
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDUSUARIO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

    )

    process save-interactive-grid-data (
        name: " - Save Interactive Grid Data"
        type: interactiveGridAutoRowProcessing
        editableRegion: @controle-de-atendimento-por-código-de-area
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 782770309400726291
        }
    )

)

