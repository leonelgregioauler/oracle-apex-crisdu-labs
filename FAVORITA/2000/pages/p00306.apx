page 306 (
    name: Prêmios
    title: Prêmios
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region prêmios-clube-favorita (
        name: Prêmios Clube Favorita
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pf.idpremioclube
                     , pf.nome
                     , pf.valor
                     , pf.ativo
                     , pf.descativo
                     , pf.custopontos
                     , pf.urlimagem
                from vw_premiosclube_fav pf
                order by 2
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 307
                items: {
                    P307_IDPREMIOCLUBE: #IDPREMIOCLUBE#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum registro encontrado.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 1402204323309892650
        }

        column ATIVO (
            type: plainText
            heading {
                heading: Ativo
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column CUSTOPONTOS (
            type: plainText
            heading {
                heading: Custopontos
            }
            layout {
                sequence: 5
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column DESCATIVO (
            type: plainText
            heading {
                heading: Descativo
                alignment: center
            }
            layout {
                sequence: 16
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column IDPREMIOCLUBE (
            type: plainText
            heading {
                heading: Idpremioclube
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column NOME (
            type: plainText
            heading {
                heading: Nome
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column URLIMAGEM (
            type: plainText
            heading {
                heading: Urlimagem
            }
            layout {
                sequence: 6
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column VALOR (
            type: plainText
            heading {
                heading: Valor
            }
            layout {
                sequence: 3
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 14022349 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ATIVO (
                sequence: 4
            )

            displayColumn CUSTOPONTOS (
                sequence: 5
            )

            displayColumn DESCATIVO (
                sequence: 7
            )

            displayColumn IDPREMIOCLUBE (
                sequence: 1
            )

            displayColumn NOME (
                sequence: 2
            )

            displayColumn URLIMAGEM (
                sequence: 6
            )

            displayColumn VALOR (
                sequence: 3
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Novo Prêmio
        layout {
            sequence: 10
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 307
                clearCache: 307
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction create-button-dialog-closed (
        name: Create Button - Dialog Closed
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @prêmios-clube-favorita
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @prêmios-clube-favorita
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @prêmios-clube-favorita
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

