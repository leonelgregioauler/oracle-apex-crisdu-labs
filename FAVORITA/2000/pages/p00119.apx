    pageItem P119_CONSULTORA (
        type: popupLov
        label {
            label: Cliente
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' ('||nvl(p.cpf,p.documentoestrangeiro)||')' display_value
                     , v.idvendedora
                from vendedoras v
                   , pessoas p
                where p.idpessoa = v.idpessoa
                  and (:P119_DISTRIBUIDORA is null or v.idrepresentante = :P119_DISTRIBUIDORA) 
                order by 1
                ```
            nullDisplayValue: - Todas -
        }
        cascadingLov {
            parentItems: P119_DISTRIBUIDORA
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

