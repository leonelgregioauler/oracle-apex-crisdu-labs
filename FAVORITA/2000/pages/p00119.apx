    pageItem P119_DISTRIBUIDORA (
        type: popupLov
        label {
            label: Distribuidora
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROMAN.pck_romance.fnc_nomerepresentante(idrepresentante) DISPLAY_VALUE
                     , idrepresentante RETURN_VALUE
                from representantes
                where (:P119_FILIALROMANCE is null or
                    ( :P119_FILIALROMANCE is not null and idgerente in ( select idgerente from gerentes where idfilial = :P119_FILIALROMANCE) ))
                order by 1
                ```
            nullDisplayValue: - Todas -
        }
        cascadingLov {
            parentItems: P119_FILIALROMANCE
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util_fav.fnc_verificaacesso(58005,:P0_IDUSUARIO) = 'S'
                ```
        }
        security {
            encryptSessionState: false
        }
    )

