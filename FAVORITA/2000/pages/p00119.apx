    pageItem P119_VISUALIZATODOS (
        type: hidden
        layout {
            sequence: 30
            region: @vencimentos-de-pedidos
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vvalor varchar2(1);
                begin
                  --
                  vvalor := pck_util_fav.fnc_verificaacesso(58005,:P0_IDUSUARIO);
                  --
                  return vvalor;
                  --
                exception
                when others then
                  vvalor := 'N';
                end;
                ```
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vvalor varchar2(1);
                begin
                  --
                  vvalor := pck_util_fav.fnc_verificaacesso(58005,:P0_IDUSUARIO);
                  --
                  return vvalor;
                  --
                exception
                when others then
                  vvalor := 'N';
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 120
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction atualiza-valor-de-juros (
        name: Atualiza Valor de Juros
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P119_DATAATUALIZADO
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P119_DATAATUALIZADO
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: DATAATUALIZADO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction mostra-data (
        name: Mostra Data
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P119_FILTRARDATA
        }
        clientSideCondition {
            type: itemIsInList
            item: P119_FILTRARDATA
            list: [
                E
                V
            ]
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P119_DATAINI
                    P119_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P119_DATAINI
                    P119_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    validation existe-filtro (
        name: Existe Filtro
        execution {
            sequence: 20
        }
        validation {
            plsqlExpression:
                ```plsql
                :P119_DATAINI is not null
                or :P119_DATAFIM is not null
                or :P119_SITUACAO is not null
                or :P119_FILIALFAVORITA is not null
                or :P119_FILIALROMANCE is not null
                or :P119_FILIALFAVORITA is not null
                or :P119_DISTRIBUIDORA is not null
                or :P119_CONSULTORA is not null
                or :P119_IDCIDADE is not null
                or :P119_NRPEDIDO is not null
                or :P119_NRBOLETO is not null
                ```
        }
        error {
            errorMessage: Não é possivel filtrar sem nenhum filtro, favor filtrar alguma informação
        }
    )

    validation valida-uso-da-data-atualizada (
        name: Valida Uso da Data Atualizada
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where to_date(:P119_DATAATUALIZADO,'DD/MM/RRRR') < trunc(sysdate)
                ```
        }
        error {
            errorMessage: Data não permitida, utilize uma data maior ou igual ao dia de hoje!
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P119_DATAATUALIZADO
        }
    )

    process gerar-tarefa-de-cobrança (
        name: Gerar Tarefa de Cobrança
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_tarefas_fav.prc_geratarefacobrancacall(pidpedido => :P119_IDEDITAR,
                                                             pidusuario => :P0_IDUSUARIO);
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Tarefa de Cobrança gerada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 5052022830394241933
        }
        serverSideCondition {
            type: request=Value
            value: GERARTAREFA
        }
    )

    branch (
        name: go to page 119
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 119
                items: {
                    P119_SITUACAO: &P119_SITUACAO.
                    P119_CONSULTORA: &P119_CONSULTORA.
                    P119_NRPEDIDO: &P119_NRPEDIDO.
                    P119_NRBOLETO: &P119_NRBOLETO.
                    P119_FILIALFAVORITA: &P119_FILIALFAVORITA.
                    P119_FILIALROMANCE: &P119_FILIALROMANCE.
                    P119_DISTRIBUIDORA: &P119_DISTRIBUIDORA.
                    P119_FILTRARDATA: &P119_FILTRARDATA.
                    P119_DATAINI: &P119_DATAINI.
                    P119_DATAFIM: &P119_DATAFIM.
                    P119_IDCIDADE: &P119_IDCIDADE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

    branch (
        name: go to page 119
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 119
                items: {
                    P119_DATAINI: &P119_DATAINI.
                    P119_DATAFIM: &P119_DATAFIM.
                    P119_SITUACAO: &P119_SITUACAO.
                    P119_CONSULTORA: &P119_CONSULTORA.
                    P119_NRPEDIDO: &P119_NRPEDIDO.
                    P119_NRBOLETO: &P119_NRBOLETO.
                    P119_DATAATUALIZADO: &P119_DATAATUALIZADO.
                    P119_FILTRARDATA: &P119_FILTRARDATA.
                    P119_IDCIDADE: &P119_IDCIDADE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: DATAATUALIZADO
        }
    )

    branch (
        name: go to page 119
        execution {
            sequence: 30
        }
        behavior {
            target: {
                page: 119
                items: {
                    P119_DATAINI: &P119_DATAINI.
                    P119_DATAFIM: &P119_DATAFIM.
                    P119_SITUACAO: &P119_SITUACAO.
                    P119_CONSULTORA: &P119_CONSULTORA.
                    P119_NRPEDIDO: &P119_NRPEDIDO.
