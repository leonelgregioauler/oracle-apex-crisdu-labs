page 119 (
    name: "Vencimentos de Pedidos "
    title: "Vencimentos de Pedidos "
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function imprimeboleto(vidpedido,vidvendedora)
            {   
              /*vurl = 'https://boleto.romancemoda.com.br/boleto_bb_favorita_sem_iframe_com_pix_v2.php?cod1='+vidpedido+'&cod2='+vidvendedora;*/
              vurl = document.getElementById('P0_URLBOLETOBASE').value+'?cod1='+vidpedido+'&cod2='+vidvendedora;
              pjan = window.open(vurl,'boleto','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1024,height=1000,left=20,top=10','_blank'); 
              pjan.focus();
            }
            
            function fnc_gerartarefa(pid)
            {
              document.getElementById("P119_IDEDITAR").value = pid;
              apex.submit('GERARTAREFA');
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region vencimentos-de-pedidos (
        name: Vencimentos de Pedidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.idvencimentopedido
                     , case 
                         when favorita.pck_util_fav.fnc_retornapedidowidecommerce(p.idpedido) is null then
                           '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||p.idpedido ,'SESSION')||''',''_blank''); void(0)">'||p.idpedido||'</a>' 
                         when favorita.pck_util_fav.fnc_retornapedidowidecommerce(p.idpedido) is not null then
                           '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':415:'||v('APP_SESSION')||'::NO::P415_IDPEDIDO:'||p.idpedido ,'SESSION')||''',''_blank''); void(0)">'||p.idpedido||'</a>' 
                       end nrpedidos     
                     , v.datavencimento
                     , (p.vendedora||' - '||p.cpf) vendedora
                     , v.valorpagar
                     , v.valorpago
                     , v.saldo
                     , v.verificarnaconta
                     , v.idtarefa
                     , case
                         when p.idsituacaocobranca = 600 then
                           v.situacaovencimento||' (Incobrável)'
                         when v.datavencimento >= trunc(sysdate) and v.saldo = 0 then
                           v.situacaovencimento||' (Quitado)'
                         when v.datavencimento >= trunc(sysdate) then 
                           v.situacaovencimento||' (Aberto)'
                         when v.datavencimento < trunc(sysdate) and v.saldo > 0 then
                           v.situacaovencimento||' (Vencido)'
                         when v.datavencimento < trunc(sysdate) and v.saldo = 0 then
                           v.situacaovencimento||' (Quitado)'
                       end situacaodovencimento
                     , v.codsituacaovencimento
                     , null efetuarpagamento
                     , case 
                         when (select 1 
                               from pagamentospedidos pg
                               where pg.idvencimentopedido = v.idvencimentopedido
                                 and pg.idformapagamento   = 1
                                 and rownum = 1 ) = 1 then
                           '<a href=javascript:imprimeboleto('||p.idpedido||','||p.idvendedora||');><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' 
                         else
                          '-'
                       end url
                     , case 
                         when v.saldo > 0 and :P119_DATAATUALIZADO > v.datavencimento then
                           pck_util_fav.fnc_calculajuros(pvalororiginal      => v.saldo,
                                                         pdatavencimentoorig => v.datavencimento,
                                                         pdatavencimentonovo => to_date(:P119_DATAATUALIZADO,'DD/MM/RRRR'),
                                                         ppercmulta          => 2,
                                                         ppercjuros          => 1)
                         when v.saldo > 0 and trunc(sysdate) > v.datavencimento then
                           pck_util_fav.fnc_calculajuros(pvalororiginal      => v.saldo,
                                                         pdatavencimentoorig => v.datavencimento,
                                                         pdatavencimentonovo => to_date(:P119_DATAATUALIZADO,'DD/MM/RRRR'),
                                                         ppercmulta          => 2,
                                                         ppercjuros          => 1)         else
                           v.saldo
                       end valoratualizado
                     , idvencimentopedido verpagamentos
                     , p.filialromance
                     , p.representante 
                     , p.idpedido verhistoricos
                     , case
                         when ( select 1
                                from classificacoespedidos c
                                where c.idcaracteristicapedido = 28
                                  and c.idpedido               = v.idpedido
                                  and not exists ( select 1
                                                   from classificacoespedidos c
                                                   where c.idcaracteristicapedido = 27
                                                     and c.idpedido               = v.idpedido ) ) = 1 then
                           'Sim'
                         else 
                           'Não'
                       end pedidoproprio
                      , ( select roman.pck_romance.fnc_nomecidade(idcidade)
                          from pessoas pp
                             , vendedoras vv
                          where vv.idvendedora = p.idvendedora
                            and vv.idpessoa    = pp.idpessoa ) nomecidade
                      , p.idpedido
                      , case 
                          when v.datavencimento < trunc(sysdate) and not exists ( select 1
                                                                                  from tarefas t
                                                                                  where t.idpedido = p.idpedido
                                                                                    and t.idtipotarefa = 4 
                                                                                    and t.idsituacao in (0,10,20,40) ) then
                            '<a href="javascript:fnc_gerartarefa('|| p.idpedido ||')" ><img src="#APP_IMAGES#ok.png"  border="0"></a>' 
                          else
                           '<font color="red">Tarefa já Gerada '||(select idtarefa 
                                                                   from tarefas t
                                                                   where t.idpedido = p.idpedido
                                                                     and t.idtipotarefa = 4
                                                                     and t.idsituacao = 0)||'</font>'
                        end tarefacobranca
                      , p.situacaocobrancainterno
                      , null smsboleto
                from vw_vencimentospedidos_fav v
                   , vw_pedidos_fav            p
                where p.idpedido = v.idpedido
                  and p.ididioma = :P0_IDIDIOMA
                  and ( :P119_FILTRARDATA = 'N' or :P119_FILTRARDATA = 'E' or ( :P119_FILTRARDATA = 'V' and v.datavencimento between to_date(:P119_DATAINI,'DD/MM/RRRR') and to_date(:P119_DATAFIM,'DD/MM/RRRR') ) )
                  and ( :P119_FILTRARDATA = 'N' or :P119_FILTRARDATA = 'V' or ( :P119_FILTRARDATA = 'E' and p.dataemissao between to_date(:P119_DATAINI,'DD/MM/RRRR') and to_date(:P119_DATAFIM,'DD/MM/RRRR') ) )
                 -- and ( :P119_FILTRARDATA = 'N' or ( :P119_FILTRARDATA = 'V' and v.datavencimento between to_date(:P119_DATAINI,'DD/MM/RRRR') and to_date(:P119_DATAFIM,'DD/MM/RRRR') ) or ( :P119_FILTRARDATA = 'E' and p.dataemissao between to_date(:P119_DATAINI,'DD/MM/RRRR') and to_date(:P119_DATAFIM,'DD/MM/RRRR') ) )
                  and ( :P119_SITUACAO is null or v.codsituacaovencimento = :P119_SITUACAO )
                   and ( ( ( :P119_VISUALIZATODOS = 'S' and :P119_FILIALROMANCE is null) 
                            or p.idfilialromance = :P119_FILIALROMANCE )
                        or (( select nvl(u.atendenteloja,'N') 
                               from usuarios u   
                               where idusuario =  :P0_IDUSUARIO ) = 'N' and p.idfilialromance = roman.pck_romance.fnc_filialusuario(v('APP_USER')) )
                        or ((( select nvl(u.atendenteloja,'N') 
                               from usuarios u   
                               where idusuario =  :P0_IDUSUARIO )= 'S' and :P119_FILIALROMANCE is null) 
                               or p.idfilialromance = :P119_FILIALROMANCE ))
                  and ( :P119_FILIALFAVORITA is null or p.idfilialfavorita = :P119_FILIALFAVORITA )
                  and ( :P119_DISTRIBUIDORA is null or p.idrepresentante = :P119_DISTRIBUIDORA )
                  and ( :P119_CONSULTORA is null or p.idvendedora = :P119_CONSULTORA )
                  and ( :P119_NRPEDIDO is null or v.idpedido = :P119_NRPEDIDO )
                  and ( :P119_IDCIDADE is null or exists ( select 1
                                                           from pessoas pp
                                                              , vendedoras vv
                                                           where vv.idvendedora = p.idvendedora
                                                             and vv.idpessoa    = pp.idpessoa
                                                             and pp.idcidade    = :P119_IDCIDADE ) )
                  and ( :P119_NRBOLETO is null or exists ( select 1
                                                           from pagamentospedidos pg
                                                           where pg.idvencimentopedido = v.IDVENCIMENTOPEDIDO
                                                             and pg.idformapagamento   = 1
                                                             and pg.numeroboleto = :P119_NRBOLETO ) )
                                       
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                :P119_DATAINI is not null
                or :P119_DATAFIM is not null
                or :P119_SITUACAO is not null
                or :P119_FILIALFAVORITA is not null
                or :P119_FILIALROMANCE is not null
                or :P119_FILIALFAVORITA is not null
                or :P119_DISTRIBUIDORA is not null
                or :P119_CONSULTORA is not null
                or :P119_IDCIDADE is not null
                or :P119_NRPEDIDO is not null
                or :P119_NRBOLETO is not null
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Nenhum Vencimento encontrado!
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            savePublicReport: true
            subscription: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 16658447763982786393
        }

