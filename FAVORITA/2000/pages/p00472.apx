page 472 (
    name: Adicionar Item Uso e Consumo
    title: Adicionar Item Uso e Consumo
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region inclusão-de-produtos (
        name: Inclusão de Produtos
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P472_IDCOMPRATRANSFERENCIA (
        type: hidden
        layout {
            sequence: 40
            region: @inclusão-de-produtos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P472_IDFILIALORIGEM (
        type: hidden
        layout {
            sequence: 50
            region: @inclusão-de-produtos
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select c.idfilialfavoritaorigem
                from comprastransferencias c
                where c.idcompratransferencia = :P472_IDCOMPRATRANSFERENCIA;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P472_IDPRODUTODETALHADO (
        type: plugin/select
        label {
            label: Produto
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeprodutodetalhado(p.idprodutodetalhado,:P0_IDIDIOMA) display_value
                  , p.idprodutodetalhado return_value
                from produtosdetalhados p
                   , estoques e
                where p.idprodutodetalhado = e.idprodutodetalhado
                  and e.idfilialfavorita   = :P472_IDFILIALORIGEM
                
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 10
            region: @inclusão-de-produtos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P472_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        layout {
            sequence: 60
            region: @inclusão-de-produtos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 4000
            height: 5
        }
        validation {
            maxLength: 4000
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P472_PIDITEMCOMPRATRANF (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @inclusão-de-produtos
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P472_QUANTIDADE (
        type: numberField
        label {
            label: Quantidade
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 20
            region: @inclusão-de-produtos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            width: 5
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P472_QUANTIDADEDISPONIVEL (
        type: selectList
        label {
            label: Quantidade Disponível
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_estoque_fav.fnc_estoquedisponivel(idestoque) disponivel
                     , pck_estoque_fav.fnc_estoquedisponivel(idestoque) disponivel1
                from estoques
                where idfilialfavorita = :P472_IDFILIALORIGEM
                  and idprodutodetalhado = :P472_IDPRODUTODETALHADO;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P472_IDPRODUTODETALHADO
            itemsToSubmit: P472_IDPRODUTODETALHADO
        }
        layout {
            sequence: 30
            region: @inclusão-de-produtos
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select pck_estoque_fav.fnc_estoquedisponivel(idestoque) disponivel
                from estoques
                where idfilialfavorita = :P472_IDFILIALORIGEM
                and idprodutodetalhado = :P472_IDPRODUTODETALHADO;
                ```
            used: always
        }
        readOnly {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 465
                items: {
                    P465_IDCOMPRATRANSFERENCIA: &P472_IDCOMPRATRANSFERENCIA.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button incluir (
        buttonName: INCLUIR
        label: Salvar
        layout {
            sequence: 20
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation valida-quantidade-dispon-ivel (
        name: "Valida quantidade dispon[ivel"
        execution {
            sequence: 10
        }
        validation {
            language: sql
            sqlExpression:
                ```sql
                :P472_QUANTIDADE <= (
                select pck_estoque_fav.fnc_estoquedisponivel(idestoque) 
                from estoques
                where idfilialfavorita = :P472_IDFILIALORIGEM
                  and idprodutodetalhado = :P472_IDPRODUTODETALHADO)
                ```
        }
        error {
            errorMessage: Quantidade não pode ser maior que a quantidade disponível!
            associatedItem: @P472_QUANTIDADE
        }
    )

    validation valida-qunatidades-quebradas (
        name: Valida Qunatidades Quebradas
        execution {
            sequence: 20
        }
        validation {
            plsqlExpression: :P472_QUANTIDADE = trunc(:P472_QUANTIDADE)
        }
        error {
            errorMessage: Quantidade não pode ter virgula
        }
    )

    process incluir-alterar-item (
        name: Incluir alterar item
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vmsg_erro varchar2(500);
                  voperacao_dml varchar2(2):= 'I';
                  --
                Begin
                  --
                  if :P472_PIDITEMCOMPRATRANF is not null then
                    --
                    voperacao_dml := 'U';
                    --
                  end if;
                  --
                  pck_comprastransf_fav_v2.prc_item_uso_consumo(pidcompratransferencia => :P472_IDCOMPRATRANSFERENCIA,
                                                                       pidprodutodetalhado => :P472_IDPRODUTODETALHADO,
                                                                       pquantidadecomprada => :P472_QUANTIDADE,
                                                                       pobservacaoitem => :P472_OBSERVACAO,
                                                                       piditemcompratransferencia => :P472_PIDITEMCOMPRATRANF,
                                                                       poperacao_dml => voperacao_dml,
                                                                       pmsg_erro => vmsg_erro);
                  --
                  if :P472_PIDITEMCOMPRATRANF is null or vmsg_erro is not null then
                    --
                    apex_error.add_error(p_message          => vmsg_erro,
                                         p_display_location => apex_error.c_inline_with_field_and_notif);
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Ação Processada!
        }
        advanced {
            executionMappingIdentifier: 79221437187626812
        }
        serverSideCondition {
            type: request=Value
            value: INCLUIR
        }
    )

    branch (
        name: Go To Page 472
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 472
                items: {
                    P472_IDPRODUTODETALHADO:
                    P472_IDFILIALORIGEM: &P472_IDFILIALORIGEM.
                    P472_IDCOMPRATRANSFERENCIA: &P472_IDCOMPRATRANSFERENCIA.
                    P472_QUANTIDADE:
                    P472_PIDITEMCOMPRATRANF:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: INCLUIR
        }
    )

)

