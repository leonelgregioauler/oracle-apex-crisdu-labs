page 245 (
    name: Demonstrativo Semanal de Despesas
    title: Demonstrativo Semanal de Despesas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function abreconta ( pid )
             {
               window.open('f?p=&APP_ID.:159:&SESSION.::&DEBUG.::P159_IDPGTOFORN:'+pid, 'telaconta', 'status = 1, height = 400, width = 1000, resizable = 0');
               void(0);
             }
            ```
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region despesas (
        name: Despesas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.idfechamento 
                     , d.nomefilial filial
                     , ano "Ano"
                     , semana "Semana"
                     , d.IDCONTACONTABIL Conta
                     , d.IDSUBCONTACONTABIL subConta
                     , d.observacao
                     , d.valor
                     , d.iddespesa
                     , d.iddespesa idcontrole
                     , trunc(d.datavencimento) datavencimento
                     , mes "Mês"
                     , d.descricaoorigem "Descrição de Origem"
                     , nvl((select count(1)
                            from roman.anexosdespesas ad
                            where ad.iddespesa = d.iddespesa),0) qtdanexos
                     , case
                         when d.IDDESPESA is null then
                           'Pagamento de Conta'
                         else
                           'Despesa Própria'
                       end tipo
                     , matrizclassificacao
                     , nvl(d.valor*ff.fatorconversao,0) valorpagoconversao 
                     , 'D' origem
                from roman.vw_despesas_distribuidoras d
                   , roman.vw_filiais ff
                where d.idfilial = ff.idfilial 
                  and ( :P0_IDFECHAMENTO = 999999999999   or idfechamento = :P0_IDFECHAMENTO )
                  and exists ( select 1
                               from fechamentossemanais f
                               where f.idfechamento = d.idfechamento
                                 and f.idfilialfavorita = :P0_IDFILIALCAIXA )
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 278
                items: {
                    P278_IDDESPESA: #IDDESPESA#
                }
                action: resetPagination
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhuma despesa incluida.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 5000514200040107655
        }

