    region detalhes-de-despesas-da-unidade (
        name: Detalhes de Despesas da Unidade
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.iddetalhedespesa
                     , d.idfilial
                     , d.data
                     , d.usuario
                     , d.detalhe
                from roman.detalhesdespesasfiliais d
                where exists (select f.idfilialantigo
                                from favorita.filiaisfavorita f
                                where f.idfilialfavorita = :P0_IDFILIALCAIXA
                                  and f.idfilialantigo = d.idfilial);
                 
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.usuariosgruposatendimento ug
                where ug.idgrupoatendimento in (0,2)
                  and ug.usuario = v('APP_USER')
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }
        messages {
            whenNoDataFound: Nenhum detalhe inserido para essa unidade!
        }

        column DATA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Incluído em
                alignment: center
            }
            layout {
                sequence: 3
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            sorting {
                sortable: false
            }
        )

        column DETALHE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Detalhe
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
        )

        column IDDETALHEDESPESA (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: Ver/Editar
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            link {
                target: {
                    page: 532
                    items: {
                        P532_IDDETALHEDESPESA: #IDDETALHEDESPESA#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            sorting {
                sortable: false
            }
        )

        column IDFILIAL (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column USUARIO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Incluído Por
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P245_IDFILIALCAIXA (
        type: hidden
        layout {
            sequence: 10
            region: @detalhes-de-despesas-da-unidade
            slot: regionBody
        }
        source {
            type: item
            item: P0_IDFILIALCAIXA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button criar-detalhe (
        buttonName: CRIAR_DETALHE
        label: Criar Detalhe
        layout {
            sequence: 10
            region: @detalhes-de-despesas-da-unidade
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 532
                items: {
                    P532_DETALHE:
                    P532_IDDETALHEDESPESA:
                    P532_MD5:
                    P532_IDFILIALCAIXA: &P245_IDFILIALCAIXA.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button nova-despesa (
        buttonName: NOVA_DESPESA
        label: Nova Despesa
        layout {
            sequence: 10
            region: @despesas
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 278
                items: {
                    P278_IDDESPESA:
                    P278_IDFECHAMENTO: &P0_IDFECHAMENTO.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P0_IDFECHAMENTO IS NOT NULL
                  AND :P0_IDFECHAMENTO != 999999999999
                  and exists ( select 1
                               from roman.fechamentossemanais
                               where idfechamento = :P0_IDFECHAMENTO
                                 and concluido = 'N')
                ```
        }
    )

    button revisar-despesas (
        buttonName: REVISAR_DESPESAS
        label: Revisar Despesas
        layout {
            sequence: 20
            region: @despesas
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 438
                items: {
                    P438_ORIGEMD: D
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util.fnc_verificaacesso(2309,v('APP_USER') ) = 'S'
                ```
        }
    )

    branch (
        name: Go to 81
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 81
                action: resetPagination
            }
        }
    )

)

