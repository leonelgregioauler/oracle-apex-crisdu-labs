page 471 (
    name: Relatório de  Boletos Pagos em outra forma de Pagamento
    title: Relatório de  Boletos Pagos em outra forma de Pagamento
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region gráfico (
        name: Gráfico
        type: chart
        layout {
            sequence: 50
            parentRegion: @relatório-por-distribuidor
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P471_OPCAO
            value: 2
        }
        chartAppearance {
            orientation: horizontal
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        animation {
            onDataChange: none
        }
        legend {
            hideAndShowBehavior: none
        }

        series valor-líquido (
            name: Valor Líquido
            execution {
                sequence: 20
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select upper(rep.nomepessoa) distribuidor
                         , sum(pp.valorliquido) valorliquido
                      from pedidos p, classificacoespedidos cp, pagamentospedidos pp, vencimentospedidos vp, formaspagamentos fp
                         , representantes r, vendedoras v, pessoas rep, pessoas ven
                     where cp.idpedido = p.idpedido
                       and p.idpedido = vp.idpedido
                       and pp.idvencimentopedido = vp.idvencimentopedido
                       and pp.idformapagamento = fp.idformapagamento
                       and p.idrepresentante = r.idrepresentante
                       and p.idvendedora = v.idvendedora
                       and r.idpessoa = rep.idpessoa
                       and v.idpessoa = ven.idpessoa
                       and cp.idcaracteristicapedido = 8
                       and cp.idvalorcaracteristica = 1
                       and pp.idsituacao = 20
                       and vp.situacaovencimento = 'V'
                       and pp.idformapagamento != 1
                       and p.dataemissao between to_date(:P471_DATAINICIAL,'dd/mm/rrrr hh24:mi:ss')
                                             and to_date(:P471_DATAFINAL,'dd/mm/rrrr hh24:mi:ss')
                       and vp.datavencimento between to_date(:P471_DATAINICIALV,'dd/mm/rrrr hh24:mi:ss')
                                                 and to_date(:P471_DATAFINALV,'dd/mm/rrrr hh24:mi:ss')
                       and pp.datapagamento between to_date(:P471_DATAINICIALP,'dd/mm/rrrr hh24:mi:ss')
                                                and to_date(:P471_DATAFINALP,'dd/mm/rrrr hh24:mi:ss')
                       and p.idfilialfavorita = decode(:P471_FILIAL,null,p.idfilialfavorita,:P471_FILIAL)
                       and :P471_OPCAO = 2
                     group by upper(rep.nomepessoa)
                     order by 1
                    ```
            }
            columnMapping {
                label: DISTRIBUIDOR
                value: VALORLIQUIDO
            }
        )

        series valor-pago (
            name: Valor Pago
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select upper(rep.nomepessoa) distribuidor
                         , sum(pp.valorpago) valorpago
                      from pedidos p, classificacoespedidos cp, pagamentospedidos pp, vencimentospedidos vp, formaspagamentos fp
                         , representantes r, vendedoras v, pessoas rep, pessoas ven
                     where cp.idpedido = p.idpedido
                       and p.idpedido = vp.idpedido
                       and pp.idvencimentopedido = vp.idvencimentopedido
                       and pp.idformapagamento = fp.idformapagamento
                       and p.idrepresentante = r.idrepresentante
                       and p.idvendedora = v.idvendedora
                       and r.idpessoa = rep.idpessoa
                       and v.idpessoa = ven.idpessoa
                       and cp.idcaracteristicapedido = 8
                       and cp.idvalorcaracteristica = 1
                       and pp.idsituacao = 20
                       and vp.situacaovencimento = 'V'
                       and pp.idformapagamento != 1
                       and p.dataemissao between to_date(:P471_DATAINICIAL,'dd/mm/rrrr hh24:mi:ss')
                                             and to_date(:P471_DATAFINAL,'dd/mm/rrrr hh24:mi:ss')
                       and vp.datavencimento between to_date(:P471_DATAINICIALV,'dd/mm/rrrr hh24:mi:ss')
                                                 and to_date(:P471_DATAFINALV,'dd/mm/rrrr hh24:mi:ss')
                       and pp.datapagamento between to_date(:P471_DATAINICIALP,'dd/mm/rrrr hh24:mi:ss')
                                                and to_date(:P471_DATAFINALP,'dd/mm/rrrr hh24:mi:ss')
                       and p.idfilialfavorita = decode(:P471_FILIAL,null,p.idfilialfavorita,:P471_FILIAL)
                       and :P471_OPCAO = 2
                     group by upper(rep.nomepessoa)
                     order by 1
                    ```
            }
            columnMapping {
                label: DISTRIBUIDOR
                value: VALORPAGO
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            minorTicks {
                show: false
            }
        )

    )

    region relatório-detalhado (
        name: Relatório Detalhado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select upper(rep.nomepessoa) distribuidor
                     , upper(ven.nomepessoa) vendedora
                     , p.idpedido
                     , upper(fp.descricao) descricao
                     , trunc(p.dataemissao) dataemissao
                     , trunc(vp.datavencimento) datavencimento
                     , pp.datapagamento
                     , pp.valorpago
                     , pp.valorliquido
                  from pedidos p, classificacoespedidos cp, pagamentospedidos pp, vencimentospedidos vp, formaspagamentos fp
                     , representantes r, vendedoras v, pessoas rep, pessoas ven
                 where cp.idpedido = p.idpedido
                   and p.idpedido = vp.idpedido
                   and pp.idvencimentopedido = vp.idvencimentopedido
                   and pp.idformapagamento = fp.idformapagamento
                   and p.idrepresentante = r.idrepresentante
                   and p.idvendedora = v.idvendedora
                   and r.idpessoa = rep.idpessoa
                   and v.idpessoa = ven.idpessoa
                   and cp.idcaracteristicapedido = 8
                   and cp.idvalorcaracteristica = 1
                   and pp.idsituacao = 20
                   and vp.situacaovencimento = 'V'
                   and pp.idformapagamento != 1
                   and p.dataemissao between to_date(:P471_DATAINICIAL,'dd/mm/rrrr hh24:mi:ss')
                                         and to_date(:P471_DATAFINAL,'dd/mm/rrrr hh24:mi:ss')
                   and vp.datavencimento between to_date(:P471_DATAINICIALV,'dd/mm/rrrr hh24:mi:ss')
                                             and to_date(:P471_DATAFINALV,'dd/mm/rrrr hh24:mi:ss')
                   and pp.datapagamento between to_date(:P471_DATAINICIALP,'dd/mm/rrrr hh24:mi:ss')
                                            and to_date(:P471_DATAFINALP,'dd/mm/rrrr hh24:mi:ss')
                   and p.idfilialfavorita = decode(:P471_FILIAL,null,p.idfilialfavorita,:P471_FILIAL)
                   and :P471_OPCAO = 0
                 order by 1, 2
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P471_OPCAO
            value: 0
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 81895677400604603
        }

