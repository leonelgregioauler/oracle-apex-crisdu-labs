        type: plugin/select
        label {
            label: Filial
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) as d,
                       idfilialfavorita as r
                  from filiaisfavorita f
                 where f.tipofilial in ('L','C') -- loja e call center
                   and exists (select 1
                                 from usuariosfiliaisfavorita u
                                where u.idfilialfavorita = f.idfilialfavorita
                                  and u.consultar        = 'S' 
                                  and u.idusuario        = :P0_IDUSUARIO )
                 order by 1
                ```
            nullDisplayValue: Selecione uma filial
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P471_OPCAO (
        type: radioGroup
        label {
            label: Tipo de Relatório
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Detalhado;0,Por Forma de Pagamento;1,Por Distribuidor;2
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: 0
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

