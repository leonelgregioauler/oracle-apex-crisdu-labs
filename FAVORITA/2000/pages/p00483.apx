page 483 (
    name: Morte Programada
    title: Morte Programada
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region lista-de-morte-programada (
        name: Lista de Morte Programada
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select *
                  from produtosdescontinuadospais
                 where idprodutodetalhado = :P483_IDPRODUTODETALHADO
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-Form--leftLabels
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: delete
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 107454066154774103
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDPRODUTOSDESCONTINUADOSPAIS
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDPRODUTODETALHADO
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDPAIS
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @IDEDICAOREVISTA
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @ROWID
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            settings {
                hideControl: true
            }
            layout {
                sequence: 10
            }
        )

        column IDEDICAOREVISTA (
            type: selectList
            heading {
                heading: Edição da Revista
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nome, idedicaorevista
                      from edicoesrevistas
                    ```
            }
            layout {
                sequence: 70
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDEDICAOREVISTA
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDPAIS (
            type: selectList
            heading {
                heading: País
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nome, idpais
                      from roman.paises
                    ```
            }
            layout {
                sequence: 60
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDPAIS
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDPRODUTODETALHADO (
            type: hidden
            layout {
                sequence: 50
            }
            source {
                databaseColumn: IDPRODUTODETALHADO
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDPRODUTOSDESCONTINUADOSPAIS (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDPRODUTOSDESCONTINUADOSPAIS
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ROWID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ROWID
                dataType: rowid
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

    )

    region morte-programada (
        name: Morte Programada
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P483_IDEDICAOREVISTA (
        type: selectList
        label {
            label: Edição da Revista
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome, idedicaorevista
                  from edicoesrevistas
                 where tipovenda = 'R'
                --   and linkcatalogo is not null
                   and idpais = :P483_IDPAIS
                 order by 2 desc
                ```
        }
        cascadingLov {
            parentItems: P483_IDPAIS
        }
        layout {
            sequence: 30
            region: @morte-programada
            slot: regionBody
            alignment: left
            columnSpan: 8
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P483_IDPAIS (
        type: selectList
        label {
            label: País
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome, idpais
                  from roman.paises
                 where idpais in (select idpais 
                                    from edicoesrevistas 
                                   where tipovenda = 'R')
                                     -- and linkcatalogo is not null) removido por Maicon em 01/07/2025 - 10576696	
                 order by 1
                ```
        }
        layout {
            sequence: 20
            region: @morte-programada
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P483_IDPRODUTODETALHADO (
        type: hidden
        layout {
            sequence: 10
            region: @morte-programada
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button adicionar (
        buttonName: Adicionar
        label: Adicionar à Lista
        layout {
            sequence: 40
            region: @morte-programada
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--simple
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: definedByDynamicAction
        }
        advanced {
            htmlDomId: ADICIONAR
        }
    )

    dynamicAction adicionar-click (
        name: Adicionar_Click
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @adicionar
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                     update produtosdescontinuadospais
                        set idedicaorevista = :P483_IDEDICAOREVISTA
                      where idpais = :P483_IDPAIS
                        and idprodutodetalhado  = :P483_IDPRODUTODETALHADO;
                     if sql%rowcount = 0 then
                      insert into produtosdescontinuadospais
                            ( idprodutosdescontinuadospais
                            , idprodutodetalhado
                            , idpais
                            , idedicaorevista)
                       values
                            ( seq_produtosdescontinuadospais.nextval
                            , :P483_IDPRODUTODETALHADO
                            , :P483_IDPAIS
                            , :P483_IDEDICAOREVISTA);
                     end if;
                     commit;
                    end;
                    
                    ```
                itemsToSubmit: P483_IDEDICAOREVISTA
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @lista-de-morte-programada
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    process produtos-save-interactive-grid-data (
        name: Produtos - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @lista-de-morte-programada
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 107455455197774117
        }
    )

)

