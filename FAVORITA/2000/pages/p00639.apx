page 639 (
    name: Pontos Clientes
    title: Pontos Clientes
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        authentication: public
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pontos-clientes (
        name: Pontos Clientes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nomepessoa
                     , p.cpf   
                     , nvl(pontos,0) Pontos
                     , favorita.pck_util_fav.fnc_nomefilialromance(v.idfilial)Filial
                     , p.idpessoa
                     , v.idvendedora
                from catal.vendedoras v
                   , catal.pessoas p
                   --, roman.vw_filiais f
                where v.idpessoa = p.idpessoa
                  --and v.idfilial = f.idfilial
                  and v.ativo = 'S'
                  --and (:P639_PONTUACAO = 1 and v.pontos between 0 and 50
                  and (:P639_PONTUACAO = 2 and v.pontos between 50 and 1000
                   or (:P639_PONTUACAO = 3 and v.pontos between 1000 and 5000)
                   or (:P639_PONTUACAO = 4 and v.pontos > 5000))
                  and (:P639_IDFILIAL is null or v.idfilial = :P639_IDFILIAL)
                  and v.ativo = 'S'
                  and favorita.pck_controle_fav.fn_debito_pessoa(p.idpessoa) = 0
                order by 1
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Verifique os Filtros Informados!
        }
        advanced {
            savedReportMappingIdentifier: 3520545579810143970
        }

        column CPF (
            type: plainText
            heading {
                heading: CPF
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column FILIAL (
            type: plainText
            heading {
                heading: Filial
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: J
            }
        )

        column IDPESSOA (
            type: link
            heading {
                heading: Ver Cadastro
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            link {
                target: {
                    page: 80
                    items: {
                        P80_IDPESSOA: #IDPESSOA#
                        P80_IDVENDEDORA: #IDVENDEDORA#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-view.png" class="apex-edit-view" alt="">
                linkAttributes: target="_blank"
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: M
            }
        )

        column IDVENDEDORA (
            type: plainText
            heading {
                heading: Idvendedora
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: N
            }
        )

        column NOMEPESSOA (
            type: plainText
            heading {
                heading: Cliente
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column PONTOS (
            type: plainText
            heading {
                heading: Pontos
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: I
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 30733425 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CPF (
                sequence: 4
            )

            displayColumn FILIAL (
                sequence: 2
            )

            displayColumn IDPESSOA (
                sequence: 1
            )

            displayColumn NOMEPESSOA (
                sequence: 3
            )

            displayColumn PONTOS (
                sequence: 5
            )

            sort (
                column: QUANTIDADE
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            aggregate (
                column: QUANTIDADE
            )

            aggregate (
                column: VALOR
            )

            controlBreak (
                column: FILIAL
                layout {
                    sequence: 1
                }
            )

        )

    )

    pageItem P639_IDFILIAL (
        type: selectList
        label {
            label: Filial
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.nome showvalue
                     , v.idfilial returnvalue
                from roman.vw_filiais v
                order by 1;
                ```
            displayExtraValues: false
            nullDisplayValue: -- Todas --
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P639_PONTUACAO (
        type: selectList
        label {
            label: Pontuação
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:50 a 1k;2,1k a 5k;3,a cima de 5k;4
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-submit-page (
            action: submitPage
            settings {
                showProcessing: false
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

