page 283 (
    name: Anexos Depósitos
    title: Anexos Depósitos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function fnc_verimg(pid)
            {
              window.open('http://anexos.romancemoda.com.br/'+pid);
              void(0);
            }
            
            function fnc_removeanexo(pidanexo,pnomeanexo)
            {
                apex.confirm("Deseja realmente remover o anexo "+pnomeanexo+"?", {
              request:"DELETAR",
              set:{"P283_IDANEXODELETAR":pidanexo}
              });
            }
            ```
    }

    region anexos-depósitos (
        name: Anexos Depósitos
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region arquivos-anexados (
        name: Arquivos Anexados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomearquivo
                     , iddeposito||idanexodeposito||substr(t.nomearquivo,instr(t.nomearquivo,'.',-1),10) link
                     , dataanexo
                     , ( select roman.pck_romance.fnc_nomeusuario(usuario)
                         from usuarios
                         where idusuario = t.idusuario ) usuario 
                     , '<a href="javascript: fnc_removeanexo('||t.idanexodeposito||','''||t.nomearquivo||''');">Remover</a>' remover
                from roman.anexosdepositos t
                where iddeposito = :P283_IDDEPOSITO
                order by t.dataanexo
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 3525720249452201958
        }

        column DATAANEXO (
            type: plainText
            heading {
                heading: Data do Anexo
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column LINK (
            type: link
            heading {
                heading: Ver Arquivo
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            link {
                target: {
                    page: 319
                    items: {
                        P319_NOMEARQUIVO: #LINK#
                    }
                    action: resetPagination
                }
                linkText: #LINK#
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NOMEARQUIVO (
            type: plainText
