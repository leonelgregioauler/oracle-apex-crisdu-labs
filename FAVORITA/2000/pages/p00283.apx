    button create (
        buttonName: CREATE
        label: Anexar este arquivo!
        layout {
            sequence: 60
            region: @anexos-depósitos
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P283_IDANEXODEPOSITO
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 50
            region: @anexos-depósitos
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
            icon: fa-filter
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 277
                items: {
                    P277_IDDEPOSITOFAVORITA: &P283_IDDEPOSITO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation verifica-anexo (
        name: Verifica Anexo
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P283_ARQUIVOTEMP
        }
        error {
            errorMessage: Escolha um Arquivo!
        }
        serverSideCondition {
            type: request=Value
            value: CREATE
        }
    )

    process anexar (
        name: Anexar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  commit;
                  -- Call the procedure
                  roman.pck_anexos.blob_to_file_depositos(piddeposito => :P283_IDDEPOSITO
                                                         ,pidanexo => :P283_IDANEXODEPOSITO );
                  commit;
                end;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 1373324718764429418
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process deletar (
        name: Deletar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  :P282_IDANEXODEPOSITO := null;
                  roman.pck_anexos.prc_apagaanexo_depositos(pidanexodeposito => :P283_IDANEXODELETAR);
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Anexo deletado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1373325198591429418
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    process fetch-row-from-anexosdepositos (
        name: Fetch Row from ANEXOSDEPOSITOS
        type: autoRowFetch
        source {
            tableOwner: ROMAN
            tableName: ANEXOSDEPOSITOS
            pkColumn: IDANEXODEPOSITO
            pkItem: P283_IDANEXODEPOSITO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1373325562738429419
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P283_IDANEXODEPOSITO is null then
                        select "ROMAN"."SEQ_IDANEXODEPOSITO".nextval
                          into :P283_IDANEXODEPOSITO
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1373325998292429419
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-anexosdepositos (
        name: Process Row of ANEXOSDEPOSITOS
        type: autoRowProcessing
        target {
            tableOwner: ROMAN
            tableName: ANEXOSDEPOSITOS
            pkColumn: IDANEXODEPOSITO
            pkItem: P283_IDANEXODEPOSITO
            supportedOperations: [
                insert
                update
            ]
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Arquivo anexado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1373326335341429420
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 283
                items: {
                    P283_IDANEXODEPOSITO:
                    P283_IDDEPOSITO: &P283_IDDEPOSITO.
                }
                action: resetPagination
            }
        }
    )

    branch (
        name: Go To Page 283
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 283
                items: {
                    P283_IDDEPOSITO: &P283_IDDEPOSITO.
                    P283_IDANEXODEPOSITO: &P283_IDANEXODEPOSITO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request!=Value
            value: DELETAR
        }
    )

)

