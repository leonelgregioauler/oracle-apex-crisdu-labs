    pageItem P342_FILTRARDATA (
        type: radioGroup
        label {
            label: Filtrar Data
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: sharedComponent
            lov: @lov-simnao
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P342_IDBANCO (
        type: radioGroup
        label {
            label: Banco
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ' - Todos - ' d
                     , -1 r
                from dual
                union
                select initcap(b.nomebanco) d
                     , b.idbanco r
                from roman.bancos b
                where exists ( select 1
                               from roman.contasbancarias c
                               where c.idbanco = b.idbanco
                                 and c.usosetorcobranca = 'S' )
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        default {
            type: static
            staticValue: -1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P342_IDCONTABANCARIA (
        type: selectList
        label {
            label: Conta Bancária
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select cb.beneficiario||' ('||b.nomebanco||' - '||cb.agencia||' CC '||cb.conta||')' conta
                     , cb.idcontabanc
                from roman.contasbancarias cb
                   , roman.bancos b
                where b.idbanco = cb.idbanco
                  and ( :P342_IDBANCO = -1 or b.idbanco = :P342_IDBANCO )
                  and ( :P342_TIPO_CONTA = 'T'
                     or ( :P342_TIPO_CONTA = 'C' and upper(cb.beneficiario) like '%CRISDU%' )
                     or ( :P342_TIPO_CONTA = 'R' and upper(cb.beneficiario) not like '%CRISDU%' ) )
                  and cb.usosetorcobranca = 'S'
                ```
        }
        cascadingLov {
            parentItems: [
                P342_TIPO_CONTA
                P342_IDBANCO
            ]
        }
        layout {
            sequence: 80
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P342_IDPEDIDO (
        type: numberField
        label {
            label: Pedido
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P342_NUMEROCOMPROVANTE (
        type: numberField
        label {
            label: Comprovante
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 20
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P342_TIPO_CONTA (
        type: radioGroup
        label {
            label: Conta
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Crisdu;C,Romance;R,Todas;T
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        default {
            type: static
            staticValue: T
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 90
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction filtro-por-data (
        name: Filtro por Data
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P342_FILTRARDATA
        }
        clientSideCondition {
            type: item=value
            item: P342_FILTRARDATA
            value: S
        }

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P342_DATAINICIAL
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P342_DATAFINAL
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction sem-filtro-por-data (
        name: Sem Filtro por Data
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P342_FILTRARDATA
        }
        clientSideCondition {
            type: item=value
            item: P342_FILTRARDATA
            value: N
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P342_DATAINICIAL
            }
            execution {
                sequence: 10
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P342_DATAFINAL
            }
            execution {
                sequence: 20
            }
        )

    )

    branch (
        name: Go To Page 342
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 342
                items: {
                    P342_IDPEDIDO: &P342_IDPEDIDO.
                    P342_NUMEROCOMPROVANTE: &P342_NUMEROCOMPROVANTE.
                    P342_FILTRARDATA: &P342_FILTRARDATA.
                    P342_TIPO_CONTA: &P342_TIPO_CONTA.
                    P342_IDCONTABANCARIA: &P342_IDCONTABANCARIA.
                    P342_DATAINICIAL: &P342_DATAINICIAL.
                    P342_DATAFINAL: &P342_DATAFINAL.
                    P342_IDCONTABANCARIA: &P342_IDCONTABANCARIA.
                    P342_IDBANCO: &P342_IDBANCO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

