page 342 (
    name: Relatório Monitoramento Depósitos
    title: Relatório Monitoramento Depósitos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    htmlHeader {
        htmlHeader:
            ```html
            <style>
            
              .contadores {
                color: black;
                font-weight: bold;  
              }
                
                .t-BadgeList-label {
                    color: cadetblue !important;
                    font-weight: bold !important; 
                }
                
                .t-BadgeList--circular .t-BadgeList-value {
                    background-color: cadetblue !important;
                }
            
            </style>
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region depósitos-pendentes (
        name: Depósitos Pendentes
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idextratobanco
                     , idpagamentopedido
                     , idpedido
                     , idbanco
                     , numerocomprovante
                     , valorextrato
                     , processado
                     , dataprocessado
                     , nomedepositante
                     , datadeposito
                     , tipooperacao
                     , codigooperacao
                     , descricaooperacao
                from vw_extratosbancos_fav
                where processado is null 
                  and ( :P342_IDPEDIDO is null or idpedido = :P342_IDPEDIDO )
                  and ( :P342_NUMEROCOMPROVANTE is null or numerocomprovante like '%'||:P342_NUMEROCOMPROVANTE||'%' )
                  and ( :P342_FILTRARDATA = 'N' or ( :P342_FILTRARDATA = 'S' and trunc(dataprocessado) between :P342_DATAINICIAL and :P342_DATAFINAL ) )
                  and ( :P342_IDCONTABANCARIA is null or idcontabancaria = :P342_IDCONTABANCARIA );
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 1500796366319215033
        }

