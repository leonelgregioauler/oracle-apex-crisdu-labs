    region depósitos-totalizadores (
        name: Depósitos - Totalizadores
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct depositosprocessados
                     , depositospendentes
                from vw_extratosbancos_fav;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/badge-list
            templateOptions: [
                #DEFAULT#
                t-BadgeList--xxlarge
                t-BadgeList--fixed
                t-BadgeList--circular
            ]
            showNullValuesAs: -
        }
        pagination {
