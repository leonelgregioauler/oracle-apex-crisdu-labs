page 622 (
    name: Gravar Taxa Delivery Pedido
    title: Gravar Taxa Delivery Pedido
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 300
        height: 550
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region buttons (
        name: BUTTONS
        type: staticContent
        layout {
            sequence: 30
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region gravar-taxa-delivery-pedido (
        name: Gravar Taxa Delivery Pedido
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P622_BAIRRO (
        type: displayOnly
        label {
            label: Bairro
            alignment: left
        }
        layout {
            sequence: 60
            region: @gravar-taxa-delivery-pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select initcap(lower(pess.bairro))
                  from favorita.pedidos p,
                       catal.vendedoras v,
                       catal.pessoas pess,
                       catal.cidades cid,
                       favorita.tabelaprecosdelivery tpd
                 where v.idvendedora = p.idvendedora
                   and pess.idpessoa = v.idpessoa
                   and cid.idcidade = pess.idcidade
                   and p.idpedido = :P622_IDPEDIDO;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P622_CIDADE (
        type: displayOnly
        label {
            label: Cidade
            alignment: left
        }
        layout {
            sequence: 50
            region: @gravar-taxa-delivery-pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select cid.nomecidade
                  from favorita.pedidos p,
                       catal.vendedoras v,
                       catal.pessoas pess,
                       catal.cidades cid,
                       favorita.tabelaprecosdelivery tpd
                 where v.idvendedora = p.idvendedora
                   and pess.idpessoa = v.idpessoa
                   and cid.idcidade = pess.idcidade
                   and p.idpedido = :P622_IDPEDIDO;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P622_IDPEDIDO (
        type: textField
        label {
            label: Pedido
            alignment: left
        }
        layout {
            sequence: 10
            region: @gravar-taxa-delivery-pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P622_IDTABELATAXADELIVERY (
        type: selectList
        label {
            label: Taxa Delivery
            alignment: left
        }
        settings {
            pageActionOnSelection: submitPage
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'R$' || to_char(t.valor, 'FM999,999,990.00') || ' - '|| t.nome  as display_value,
                       t.idtabelaprecosdelivery                                        as return_value
                from favorita.tabelaprecosdelivery t
                where t.ativo = 'S'
                  and t.idfilialfavorita = (select p.idfilialfavorita
                                              from favorita.pedidos p
                                             where p.idpedido = :P622_IDPEDIDO);
                ```
            nullDisplayValue: Selecione uma taxa!
        }
        layout {
            sequence: 70
            region: @gravar-taxa-delivery-pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P622_VALORPEDIDO (
        type: displayOnly
        label {
            label: Valor a Pagar
            alignment: left
        }
        layout {
            sequence: 30
            region: @gravar-taxa-delivery-pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P622_VENDEDORA (
        type: displayOnly
        label {
            label: Vendedora
            alignment: left
        }
        layout {
            sequence: 40
            region: @gravar-taxa-delivery-pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomevendedora(P.idvendedora)
                  from favorita.pedidos p
                 where p.idpedido = :P622_IDPEDIDO;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    button grava-taxa-delivery (
        buttonName: GRAVA_TAXA_DELIVERY
        label: <Div style="color: white;">Grava Taxa Delivery</div>
        layout {
            sequence: 10
            region: @buttons
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction grava-taxa-delivery (
        name: GRAVA_TAXA_DELIVERY
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @grava-taxa-delivery
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    
                    
                        vTaxaDelivery     number := null;
                        vIDTabelaDelivery number := null;
                        
                        
                    begin
                    
                    
                        select valor, t.idtabelaprecosdelivery
                          into vTaxaDelivery, vIDTabelaDelivery
                          from favorita.tabelaprecosdelivery t
                         where t.idtabelaprecosdelivery = :P622_IDTABELATAXADELIVERY;
                    
                    
                        update favorita.pedidos P
                           set taxadelivery     = vTaxaDelivery,
                               idtabeladelivery = vIDTabelaDelivery
                         where p.idpedido = :P622_IDPEDIDO;
                         
                    
                         commit;
                        
                    
                    exception
                        when others then
                            null;
                    end;
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: GRAVA_TAXA_DELIVERY
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-grade-delivery (
        name: REFRESH_GRADE_DELIVERY
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @gravar-taxa-delivery-pedido
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @gravar-taxa-delivery-pedido
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation valida-taxa-delivery (
        name: VALIDA_TAXA_DELIVERY
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P622_IDTABELATAXADELIVERY
        }
        error {
            errorMessage: Favor selecionar a taxa delivery!
            displayLocation: onErrorPage
        }
        serverSideCondition {
            whenButtonPressed: @grava-taxa-delivery
        }
    )

    process carrega-campos (
        name: CARREGA_CAMPOS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                select 'R$ ' || to_char( p.valorapagar, 'FM999,999,999.00'),
                       favorita.pck_util_fav.fnc_nomevendedora(v.idvendedora) Vendedora,
                       cid.nomecidade cidade,
                       initcap(lower(pess.bairro)) bairro
                  into :P622_VALORPEDIDO,
                       :P622_VENDEDORA,
                       :P622_CIDADE,
                       :P622_BAIRRO
                  from favorita.pedidos p,
                       catal.vendedoras v,
                       catal.pessoas pess,
                       catal.cidades cid
                 where v.idvendedora = p.idvendedora
                   and pess.idpessoa = v.idpessoa
                   and cid.idcidade = pess.idcidade
                   and p.idpedido = :P622_IDPEDIDO;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 2119375573862416045
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 502
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @grava-taxa-delivery
        }
    )

)

