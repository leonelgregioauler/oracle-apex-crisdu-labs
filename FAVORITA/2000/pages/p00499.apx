page 499 (
    name: Lista SubCategorias
    title: Cadastro SubCategorias
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region opções (
        name: " Opções "
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region subcategorias (
        name: SubCategorias
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.idsubcategoria
                     , s.nome
                     , s.observacao
                     , s.ativo
                     , s.idcategoria
                     , s.nomecategoria
                     , s.idtexto
                from favorita.vw_subcategorias_fav s
                where s.ididioma = :P0_IDIDIOMA;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 107577067812165705
        }

        column ATIVO (
            type: plainText
            heading {
                heading: Ativo
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column IDCATEGORIA (
            type: plainText
            heading {
                heading: Idcategoria
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column IDSUBCATEGORIA (
            type: link
            heading {
                heading: Alterar
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 501
                    items: {
                        P501_IDSUBCATEGORIA: #IDSUBCATEGORIA#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column IDTEXTO (
            type: link
            heading {
                heading: Tradução
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            link {
                target: {
                    page: 100
                    items: {
                        P100_IDTEXTOTRADUZIDO: #IDTEXTO#
                    }
                    action: resetPagination
                }
                linkText: <b>Visualizar / Atualizar texto traduzido</b>
                linkAttributes: class="t-Button t-Button--sucess"
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: L
            }
        )

        column NOME (
            type: plainText
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column NOMECATEGORIA (
            type: plainText
            heading {
                heading: Categoria
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: K
            }
        )

        column OBSERVACAO (
            type: plainText
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 1076139 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ATIVO (
                sequence: 4
            )

            displayColumn IDSUBCATEGORIA (
                sequence: 1
            )

            displayColumn IDTEXTO (
                sequence: 6
            )

            displayColumn NOME (
                sequence: 2
            )

            displayColumn NOMECATEGORIA (
                sequence: 5
            )

            displayColumn OBSERVACAO (
                sequence: 3
            )

        )

    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 501
                items: {
                    P501_IDSUBCATEGORIA:
                    P501_ATIVO:
                    P501_IDCATEGORIA:
                    P501_IDCATEGORIASITE:
                    P501_NOME:
                    P501_OBSERVACAO:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

