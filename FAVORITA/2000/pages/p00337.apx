    region pedidos-de-distribuidoras-parceiras (
        name: Pedidos de Distribuidoras Parceiras
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpedido
                     , p.representante
                     , p.vendedora
                     , p.dataemissao
                     , p.dataentrega
                     , p.valortotal
                     , ( select sum(it.valorapagar)
                         from vw_itenspedidos_fav it
                         where it.idpedido = p.idpedido 
                           and it.ididioma = 1 ) valorapagar
                     , pg.datapagamento datapgtocomissao
                     , pg.valorpago valorcomissao
                     , pg.nomeusuario usuariopagou
                     , '<a href="javascript: deletapgto('||p.idpedido||')"> Excluir Pgto</a>' excluir
                from vw_pedidos_fav p
                   , vw_pgtocomissoesparceiras_fav pg
                where p.idpedido = pg.idpedido
                  and p.ididioma = 1
                  and exists ( select 1
                               from roman.vw_filiais f
                               where f.idfilial   = p.idfilialromance
                                 and f.tipofilial = 'P' )
                  and ( :P337_IDFILIALROMANCE is null or p.idfilialromance = :P337_IDFILIALROMANCE )
                  and ( :P337_DATAINICIO is null or trunc(pg.datapagamento) between to_date(:P337_DATAINICIO) and to_date(:P337_DATAFIM) )
                order by 1
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P337_COMISSAO
            value: P
        }
