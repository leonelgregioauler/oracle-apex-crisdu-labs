                    P337_DATAINICIO
                    P337_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P337_DATAINICIO
                    P337_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    process deleta-pagamento-de-comissão (
        name: Deleta Pagamento de Comissão
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  voperacao_dml varchar2(1);
                  --
                begin
                  --
                  if v('REQUEST') = 'DELETAR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  pck_pedidos_fav.prc_pgtocomissoesparceiras(pidpedido => :P337_IDDELETAR,
                                                             pidusuario => :P0_IDUSUARIO,
                                                             poperacao_dml => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Pagamento de Comissão deletado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1422736462201768235
        }
        serverSideCondition {
            type: request=Value
            value: DELETAR
        }
    )

    process realiza-pagamento-de-comissões (
        name: Realiza Pagamento de Comissões
        type: executeCode
        editableRegion: @comissões-a-pagar
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  voperacao_dml varchar2(1);
                  --
                begin
                  --
                  if v('REQUEST') = 'PAGAR_COMISSAO' then
                    voperacao_dml := 'I';
                  end if;
                  --
                  pck_pedidos_fav.prc_pgtocomissoesparceiras(pidpedido => :IDPEDIDO,
                                                             pidusuario => :P0_IDUSUARIO,
                                                             poperacao_dml => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Comissão Paga com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1422735940793768230
        }
        serverSideCondition {
            type: request=Value
            value: PAGAR_COMISSAO
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 337
                items: {
                    P337_IDFILIALROMANCE: &P337_IDFILIALROMANCE.
                    P337_COMISSAO: &P337_COMISSAO.
                    P337_DATAINICIO: &P337_DATAINICIO.
                    P337_DATAFIM: &P337_DATAFIM.
                }
                action: resetPagination
            }
        }
    )

)

