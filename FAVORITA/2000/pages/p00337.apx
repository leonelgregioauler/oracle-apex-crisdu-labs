page 337 (
    name: Controle de Comissões Distribuidoras Parceiras
    title: Controle de Comissões Distribuidoras Parceiras
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function deletapgto(pid)
            {
            
              var answer = confirm("Confirma exlusão do pagamento da comissão?")
              if (answer)
                {
                  document.getElementById('P337_IDDELETAR').value = pid;
                  apex.submit('DELETAR');
                }
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region comissões-a-pagar (
        name: Comissões A Pagar
        type: tabform
        source {
            sqlQuery:
                ```sql
                select p.numeropedido 
                     , p.representante
                     , p.vendedora
                     , p.dataemissao
                     , p.valortotal
                     , ( p.valortotal - ( p.valortotal * 0.96 )) valorcomissao
                     , p.idpedido
                from vw_pedidos_fav p
                where p.ididioma = 1
                  and p.datacancelamento is null
                  and (:P337_IDFILIALROMANCE is null or p.idfilialromance = :P337_IDFILIALROMANCE )
                  and exists ( select 1
                               from pedidosremessasct pr
                               where pr.idpedido = p.idpedido
                                 and exists ( select 1
                                              from vencimentoscomprastransf vc
                                              where vc.idcompratransferencia = pr.idcompratransferencia
                                                and vc.situacaovencimento    = 'V'
                                                and round(vc.valorpago,2)    = round(vc.valorvencimento,2)
                                                and vc.valorvencimento       > 0 ) )
                  and exists ( select 1
                               from roman.vw_filiais f
                               where f.idfilial   = p.idfilialromance
                                 and f.tipofilial = 'P' )
                  and not exists ( select 1
                                   from PAGAMENTOSCOMISSOESPARCEIRAS pg
                                   where pg.idpedido = p.idpedido )            
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P337_COMISSAO
            value: A
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

