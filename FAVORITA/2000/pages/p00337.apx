    pageItem P337_VALORTOTAL (
        type: numberField
        label {
            label: Valor Total a Pagar
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 10
            region: @comissões-a-pagar
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select nvl(to_char(sum(p.valortotal - ( p.valortotal * 0.96 ) ),'999G999G999G990D00'),0) valorcomissao
                from vw_pedidos_fav p
                where p.ididioma = 1
                  and p.idfilialromance = :P337_IDFILIALROMANCE 
                  and exists ( select 1
                               from pedidosremessasct pr
                               where pr.idpedido = p.idpedido
                                 and exists ( select 1
                                              from vencimentoscomprastransf vc
                                              where vc.idcompratransferencia = pr.idcompratransferencia
                                                and vc.situacaovencimento    = 'V'
                                                and round(vc.valorpago,2)    = round(vc.valorvencimento,2)
                                                and vc.valorvencimento       > 0 ) )
                  and exists ( select 1
                               from roman.vw_filiais f
                               where f.idfilial   = p.idfilialromance
                                 and f.tipofilial = 'P' )
                  and not exists ( select 1
                                   from PAGAMENTOSCOMISSOESPARCEIRAS pg
                                   where pg.idpedido = p.idpedido )
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
