        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from roman.vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'P'
                order by 1
                ```
            displayExtraValues: false
