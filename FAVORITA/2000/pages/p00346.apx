page 346 (
    name: Acompanhamento de Consultas SPC
    title: Acompanhamento de Consultas SPC
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region acompanhamento-do-dia (
        name: Acompanhamento do Dia
        type: plugin/flotPieChart
        source {
            sqlQuery:
                ```sql
                select decode(liberado,'S','Aprovado','N','Reprovado') liberado
                     , count(1) qtd
                from roman.historicosconsultasdoc h
                where trunc(h.dataconsulta) = trunc(sysdate)
                  and ( :P346_IDFILIAL is null or h.idfilial = :P346_IDFILIAL )
                  and exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.idgrupoatendimento = 22
                                 and ug.usuario = h.usuario )
                group by h.liberado
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: LIBERADO
            valueColumn: QTD
            width: 500
        }
    )

    region acompanhamento-do-período (
        name: Acompanhamento do Período
        type: plugin/flotPieChart
        source {
            sqlQuery:
                ```sql
                select decode(liberado,'S','Aprovado','N','Reprovado') liberado
                     , count(1) qtd
                from roman.historicosconsultasdoc h
                where h.dataconsulta between to_date(:P346_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P346_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                  and ( :P346_IDFILIAL is null or h.idfilial = :P346_IDFILIAL )
                  and ( :P346_USUARIO is null or h.usuario = :P346_USUARIO )
                  and exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.idgrupoatendimento = 22
                                 and ug.usuario = h.usuario )
                group by h.liberado
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: LIBERADO
            valueColumn: QTD
            width: 500
            colorScheme: modern2
        }
    )

    region controle-por-usuário (
        name: Controle por Usuário
        type: plugin/flotPieChart
        source {
            sqlQuery:
                ```sql
                select usuario
                     , count(1) quantidade
                from roman.historicosconsultasdoc h
                where h.dataconsulta between to_date(:P346_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P346_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                  and ( :P346_IDFILIAL is null or h.idfilial = :P346_IDFILIAL )
                  and exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.idgrupoatendimento = 22
                                 and ug.usuario = h.usuario )
                group by usuario
                order by 1
                ```
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: USUARIO
            valueColumn: QUANTIDADE
            width: 600
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region por-data (
        name: Por Data
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'fa-circle' icon
                     , trunc(h.dataconsulta) dataconsulta
                     , ( select count(1)
                         from roman.historicosconsultasdoc hd
                         where hd.liberado = 'S'
                           and trunc(hd.dataconsulta) = trunc(h.dataconsulta)
                           and ( :P346_IDFILIAL is null or hd.idfilial = :P346_IDFILIAL ) 
                           and exists ( select 1
                                        from roman.usuariosgruposatendimento ug
                                        where ug.idgrupoatendimento = 22
                                          and ug.usuario = hd.usuario ) ) aprovado
                     , ( select count(1)
                         from roman.historicosconsultasdoc hd
                         where nvl(hd.liberado,'N') = 'N'
                           and trunc(hd.dataconsulta) = trunc(h.dataconsulta)
                           and ( :P346_IDFILIAL is null or hd.idfilial = :P346_IDFILIAL )
                           and exists ( select 1
                                        from roman.usuariosgruposatendimento ug
                                        where ug.idgrupoatendimento = 22
                                          and ug.usuario = hd.usuario ) ) reprovado
                     , count(1) quantidade
                from roman.historicosconsultasdoc h
                where h.dataconsulta between to_date(:P346_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P346_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                  and ( :P346_IDFILIAL is null or h.idfilial = :P346_IDFILIAL )
                  and exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.idgrupoatendimento = 22
                                 and ug.usuario = h.usuario )
                group by trunc(h.dataconsulta)
                order by 2 
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 30
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        download {
            csvExportEnabled: true
            linkText: Clique aqui para fazer o Download
        }

