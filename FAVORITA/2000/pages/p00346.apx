    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 346
                items: {
                    P346_IDFILIAL: &P346_IDFILIAL.
                    P346_USUARIO: &P346_USUARIO.
                    P346_DATAINICIO: &P346_DATAINICIO.
                    P346_DATAFIM: &P346_DATAFIM.
                }
                action: resetPagination
            }
        }
    )

)

