    pageItem P346_TOTAL_DIA_REP_DEBITO (
        type: numberField
        label {
            label: Total Dia Rep. Débito
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 30
            region: @acompanhamento-do-dia
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select count(1) qtd
                from roman.historicosconsultasdoc h
                where trunc(h.dataconsulta) = trunc(sysdate)
                  and ( :P346_IDFILIAL is null or h.idfilial = :P346_IDFILIAL )
                  and ( :P346_USUARIO is null or h.usuario = :P346_USUARIO )
                  and h.liberado = 'N'
                  and exists ( select 1
                               from roman.notasvendas n
                                  , vendedoras v
                                  , pessoas p 
                               where n.idvendedora = v.idvendedora
                                 and v.idpessoa    = p.idpessoa
                                 and p.cpf         = replace(replace(replace(h.documento,'-',''),'.',''),' ','')
                                 and n.idsituacaonotavenda = 4
                                 and n.saldo       > 0 )
                  and exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.idgrupoatendimento = 22
                                 and ug.usuario = h.usuario )
                ```
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

