    pageItem P346_IDFILIAL (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from roman.vw_filiais f
                where exists ( select 1
                               from roman.historicosconsultasdoc h
                               where h.idfilial = f.idfilial
                                 and exists ( select 1
                                              from roman.usuariosgruposatendimento ug
                                              where ug.idgrupoatendimento = 22
                                                and ug.usuario = h.usuario ) )
                order by 1
                ```
            nullDisplayValue: "- Todas - "
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P346_TOTAL (
        type: numberField
        label {
            label: Total
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 10
            region: @acompanhamento-do-período
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select count(1) qtd
                from roman.historicosconsultasdoc h
                where trunc(h.dataconsulta) between to_date(:P346_DATAINICIO) and to_date(:P346_DATAFIM)
                  and ( :P346_IDFILIAL is null or h.idfilial = :P346_IDFILIAL )
                  and ( :P346_USUARIO is null or h.usuario = :P346_USUARIO )
                  and exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.idgrupoatendimento = 22
                                 and ug.usuario = h.usuario )
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

