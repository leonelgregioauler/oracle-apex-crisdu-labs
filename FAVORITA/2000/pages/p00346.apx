    region por-empresa-2 (
        name: Por Empresa
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'fa-circle' icon
                     , roman.pck_romance.fnc_nomefilial(idfilial) filial
                     , ( select count(1)
                         from roman.historicosconsultasdoc hd
                         where hd.liberado = 'S'
                           and hd.dataconsulta between to_date(:P346_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P346_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                           and hd.idfilial = h.idfilial
                           and exists ( select 1
                                        from roman.usuariosgruposatendimento ug
                                        where ug.idgrupoatendimento = 22
                                          and ug.usuario = hd.usuario ) ) aprovado
                     , ( select count(1)
                         from roman.historicosconsultasdoc hd
                         where nvl(hd.liberado,'N') = 'N'
                           and hd.dataconsulta between to_date(:P346_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P346_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                           and hd.idfilial = h.idfilial
                           and exists ( select 1
                                        from roman.usuariosgruposatendimento ug
                                        where ug.idgrupoatendimento = 22
                                          and ug.usuario = hd.usuario ) ) reprovado
                     , count(1) quantidade
                from roman.historicosconsultasdoc h
                where h.dataconsulta between to_date(:P346_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P346_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                  and exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.idgrupoatendimento = 22
                                 and ug.usuario = h.usuario )
                group by h.idfilial
                order by 2 
                ```
        }
        layout {
            sequence: 70
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 30
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        download {
            csvExportEnabled: true
            linkText: Clique aqui para fazer o Download
        }

        column APROVADO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Aprovado
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

        column FILIAL (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Filial
                alignment: center
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

        column ICON (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
            security {
                escapeSpecialChars: false
            }
        )

        column QUANTIDADE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Quantidade
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

        column REPROVADO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Reprovado
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
        )

    )

