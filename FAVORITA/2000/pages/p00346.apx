    region por-empresa (
        name: Por Empresa
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select *
                from ( select h.idfilial
                            , h.usuario
                       from roman.historicosconsultasdoc h 
                          , roman.consultaspc c
                       where h.dataconsulta between to_date(:P346_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P346_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                         and c.dataconsulta between to_date(:P346_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P346_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                         and replace(replace(replace(c.cpf,'.',''),'-',''),' ','') = replace(replace(replace(h.documento,'.',''),'-',''),' ','')
                         and h.usuario != 'OPTIMUS'
                         and exists ( select 1
                                      from roman.usuariosgruposatendimento ug
                                      where ug.idgrupoatendimento in ( 22 , 0 , 1 , 4 , 7 , 9 , 3 )
                                        and ug.usuario = h.usuario ) ) 
                pivot 
                (
                  count(idfilial)
                  for idfilial in ( 100 as "Igrejinha"
                                  , 120 as "Campo Grande"
                                  , 121 as "Belem"
                                  , 122 as "Londrina"
                                  , 123 as "Canoas"
                                  , 124 as "Pato Branco"
                                  , 140 as "Manaus"
                                  , 200 as "Favorita"
                                  , 221 as "Santarem"
                                  , 222 as "Macapa"
                                  , 230 as "Sao Luis"
                                  , 290 as "Boa Vista"
                                  , 320 as "Porto Velho"
                                  , 401 as "Florianopolis"
                                  , 1070 as "Cuiaba"
                                  , 1071 as "Salvador"
                                  , 1072 as "Imperatriz"
                                  , 1082 as "Itabuna"
                                  , 1083 as "Rio Branco"
                                  , 1084 as "Curitiba"
                                  , 1089 as "Altamira"
                                  , 1090 as "Maraba"
                                  , 1106 as "Cascavel"
                                  , 1132 as "Pres. Prudente"
                                  , 1196 as "Goiania"
                                  , 1202 as "Vitoria"
                                  , 1210 as "Palmas"
                                  , 1223 as "Teresina"
                                  , 1227 as "Chapeco"
                                  , 1242 as "Ji-Parana"
                                  , 1243 as "Juazeiro"
                                  , 1252 as "Aracaju" )  
                )
                union
                select *
                from ( select hg.idfilial
                            , 'Secretária' n1
                       from roman.historicosconsultasdoc hg
                       where hg.dataconsulta between to_date(:P346_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P346_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                         and hg.usuario != 'OPTIMUS'
                         and exists ( select 1
                                      from roman.consultaspc c
                                      where replace(replace(replace(c.cpf,'.',''),'-',''),' ','') = replace(replace(replace(hg.documento,'.',''),'-',''),' ','')
                                        and c.dataconsulta between to_date(:P346_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P346_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS') )
                         and not exists ( select 1
                                          from roman.usuariosgruposatendimento ug
                                          where ug.idgrupoatendimento in ( 22 , 0 , 1 , 4 , 7 , 9 , 3 )
                                            and ug.usuario = hg.usuario ) )
                pivot 
                (
                  count(idfilial)
                  for idfilial in ( 100 as "Igrejinha"
                                  , 120 as "Campo Grande"
                                  , 121 as "Belem"
                                  , 122 as "Londrina"
                                  , 123 as "Canoas"
                                  , 124 as "Pato Branco"
                                  , 140 as "Manaus"
                                  , 200 as "Favorita"
                                  , 221 as "Santarem"
                                  , 222 as "Macapa"
                                  , 230 as "Sao Luis"
                                  , 290 as "Boa Vista"
                                  , 320 as "Porto Velho"
                                  , 401 as "Florianopolis"
                                  , 1070 as "Cuiaba"
                                  , 1071 as "Salvador"
                                  , 1072 as "Imperatriz"
                                  , 1082 as "Itabuna"
                                  , 1083 as "Rio Branco"
                                  , 1084 as "Curitiba"
                                  , 1089 as "Altamira"
                                  , 1090 as "Maraba"
                                  , 1106 as "Cascavel"
                                  , 1132 as "Pres. Prudente"
                                  , 1196 as "Goiania"
                                  , 1202 as "Vitoria"
                                  , 1210 as "Palmas"
                                  , 1223 as "Teresina"
                                  , 1227 as "Chapeco"
                                  , 1242 as "Ji-Parana"
                                  , 1243 as "Juazeiro"
                                  , 1252 as "Aracaju" )  
                )
                union
                select *
                from ( select hg.idfilial
                            , 'OPTIMUS' n1
                       from roman.historicosconsultasdoc hg
                       where hg.dataconsulta between to_date(:P346_DATAINICIO||' 00:00:01','DD/MM/RRRR HH24:MI:SS') and to_date(:P346_DATAFIM||' 23:59:59','DD/MM/RRRR HH24:MI:SS')
                         and hg.usuario = 'OPTIMUS' )
                pivot 
                (
                  count(idfilial)
                  for idfilial in ( 100 as "Igrejinha"
                                  , 120 as "Campo Grande"
                                  , 121 as "Belem"
                                  , 122 as "Londrina"
                                  , 123 as "Canoas"
                                  , 124 as "Pato Branco"
                                  , 140 as "Manaus"
                                  , 200 as "Favorita"
                                  , 221 as "Santarem"
                                  , 222 as "Macapa"
                                  , 230 as "Sao Luis"
                                  , 290 as "Boa Vista"
                                  , 320 as "Porto Velho"
                                  , 401 as "Florianopolis"
                                  , 1070 as "Cuiaba"
                                  , 1071 as "Salvador"
                                  , 1072 as "Imperatriz"
                                  , 1082 as "Itabuna"
                                  , 1083 as "Rio Branco"
                                  , 1084 as "Curitiba"
                                  , 1089 as "Altamira"
                                  , 1090 as "Maraba"
                                  , 1106 as "Cascavel"
                                  , 1132 as "Pres. Prudente"
                                  , 1196 as "Goiania"
                                  , 1202 as "Vitoria"
                                  , 1210 as "Palmas"
                                  , 1223 as "Teresina"
                                  , 1227 as "Chapeco"
                                  , 1242 as "Ji-Parana"
                                  , 1243 as "Juazeiro"
                                  , 1252 as "Aracaju" )  
                )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

