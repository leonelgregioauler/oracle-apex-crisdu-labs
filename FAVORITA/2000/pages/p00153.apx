    pageItem P153_DATAFIM (
        type: datePickerJquery
        label {
            label: até
            alignment: left
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: DD/MM/RRRR
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P153_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: DD/MM/RRRR
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P153_DISTRIBUIDOR (
        type: plugin/select
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(r.idrepresentante) display_value
                     , r.idrepresentante return_value
                from representantes r
                where r.ativo = 'S'
                  and r.idgerente = ( select idgerente
                                      from gerentes 
                                      where idfilial = roman.pck_romance.fnc_filialusuario(v('APP_USER')) )
                  and :P153_IDREPRESENTANTE is null or idrepresentante = :P153_IDREPRESENTANTE
                order by 1
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P153_TIPODATA (
        type: radioGroup
        label {
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Emissão;E,Entrega;T
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
