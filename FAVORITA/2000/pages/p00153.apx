    pageItem P153_TIPORELATORIO (
        type: radioGroup
        label {
            label: Relatório
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Resumido;R,Detalhado;D
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 153
                items: {
                    P153_TIPODATA: &P153_TIPODATA.
                    P153_DATAINICIO: &P153_DATAINICIO.
                    P153_DATAFIM: &P153_DATAFIM.
                    P153_DISTRIBUIDOR: &P153_DISTRIBUIDOR.
                    P153_TIPORELATORIO: &P153_TIPORELATORIO.
                }
                action: resetPagination
            }
        }
    )

)

