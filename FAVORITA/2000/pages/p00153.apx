    region pedidos-2 (
        name: "Pedidos "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(p.idrepresentante) distribuidor    
                     , count(1)
                     , sum(p.valortotal) valortotal
                     , sum(p.valorapagar) totalapagar                                                                       
                from vw_pedidos_fav p
                where ( :P153_TIPODATA = 'E' and trunc(p.dataemissao) between to_date(:P153_DATAINICIO,'DD/MM/RRRR') and to_date(:P153_DATAFIM,'DD/MM/RRRR')  
                     or :P153_TIPODATA = 'T' and trunc(p.dataentrega) between to_date(:P153_DATAINICIO,'DD/MM/RRRR') and to_date(:P153_DATAFIM,'DD/MM/RRRR') )
                  and ( :P153_DISTRIBUIDOR is null or p.idrepresentante = :P153_DISTRIBUIDOR )
                  and :P153_TIPORELATORIO = 'R'
                  and p.idsituacaoentrega > 20000
                  and p.idfilialromance = roman.pck_romance.fnc_filialusuario(v('APP_USER'))
                  and not exists ( select 1
                                   from classificacoespedidos c
                                   where c.idcaracteristicapedido = 25
                                     and c.idpedido               = p.idpedido )
                  and p.ididioma = :P0_IDIDIOMA
                group by p.idrepresentante
                order by 1
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P153_TIPORELATORIO
            value: R
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum pedido encontrado, verifique os filtros!
        }
        advanced {
            savedReportMappingIdentifier: 185783643872566408
        }

