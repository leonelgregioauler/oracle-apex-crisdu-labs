page 153 (
    name: Emissão de Pedidos Distribuidoras
    title: Emissão de Pedidos Distribuidoras
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pedidos (
        name: Pedidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.numeropedido
                     , p.vendedora
                     , p.representante
                     , p.dataemissao
                     , p.dataentrega
                     , p.datavencimento
                     , p.valortotal
                     , p.tipopedido
                     , p.regiaocliente
                     , roman.pck_romance.fnc_nomecidade(roman.pck_romance.fnc_idcidadevendedora(p.idvendedora)) cidadevendedora
                     , decode(( select 1
                                from classificacoespedidos c
                                where c.idcaracteristicapedido = 2
                                  and c.idpedido               = p.idpedido ),1,'Sim','Não') distfezparacliente
                     , p.cpf                                                                              
                from vw_pedidos_fav p
                where ( :P153_TIPODATA = 'E' and trunc(p.dataemissao) between to_date(:P153_DATAINICIO,'DD/MM/RRRR') and to_date(:P153_DATAFIM,'DD/MM/RRRR')  
                     or :P153_TIPODATA = 'T' and trunc(p.dataentrega) between to_date(:P153_DATAINICIO,'DD/MM/RRRR') and to_date(:P153_DATAFIM,'DD/MM/RRRR') )
                  and ( :P153_DISTRIBUIDOR is null or p.idrepresentante = :P153_DISTRIBUIDOR )
                  and :P153_TIPORELATORIO = 'D'
                  and p.idsituacaoentrega > 20000
                  and p.idfilialromance = roman.pck_romance.fnc_filialusuario(v('APP_USER'))
                  and not exists ( select 1
                                   from classificacoespedidos c
                                   where c.idcaracteristicapedido = 25
                                     and c.idpedido               = p.idpedido )
                  and p.ididioma = :P0_IDIDIOMA
                order by p.representante
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P153_TIPORELATORIO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum pedido encontrado, verifique os filtros!
        }
        advanced {
            savedReportMappingIdentifier: 58732338729973345
        }

