page 215 (
    name: Históricos do Pedido
    title: Históricos do Pedido
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region históricos (
        name: Históricos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select h.datahistorico
                     , h.descricao
                     , h.nomeusuario
                from vw_historicospedidos_fav h
                where h.idpedido = :P215_IDPEDIDO
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum histórico encontrado!
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 477935688414721429
        }

        column DATAHISTORICO (
            type: plainText
            heading {
                heading: Data
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: A
            }
        )

        column DESCRICAO (
            type: plainText
            heading {
                heading: HIstórico
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column NOMEUSUARIO (
            type: plainText
            heading {
                heading: Atendente
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        savedReport 4781226 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAHISTORICO (
                sequence: 1
            )

            displayColumn DESCRICAO (
                sequence: 2
            )

            displayColumn NOMEUSUARIO (
                sequence: 3
            )

        )

    )

    pageItem P215_IDPEDIDO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @históricos
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

)

