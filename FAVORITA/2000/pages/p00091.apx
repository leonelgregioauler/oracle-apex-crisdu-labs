page 91 (
    name: Anexos Compras Transferencias
    title: Anexos Compras Transferencias
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG_9"';
            
            function deletaanexo(pid)
            {
            
              var answer = confirm("Confirma exlusão do Anexo?")
              if (answer)
                {
                  document.getElementById('P91_DELETAR').value = pid;
                  apex.submit('DELETAR');
                }
            }
            ```
    }

    region anexos-compras-transferencias (
        name: Anexos Compras Transferencias
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region arquivos-anexados (
        name: Arquivos Anexados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.idanexocompratransferencia,
                       a.idcompratransferencia,
                       ATTACH_DATA,
                       ATTACH_MIMETYPE,
                       ATTACH_FILENAME,
                       ATTACH_LAST_UPDATE,
                       ATTACH_CHARSET,
                       case when (sys.dbms_lob.getlength(ATTACH_DATA)/1024) < 1 then 0 end || round(sys.dbms_lob.getlength(ATTACH_DATA)/1024,2)||' kb' file_length,
                       sys.dbms_lob.getlength(ATTACH_DATA) download,
                       '<a href="javascript: deletaanexo('||a.idanexocompratransferencia||')"> Excluir </a>' remover,
                       idcompratransferencia||idanexocompratransferencia||substr(a.ATTACH_FILENAME,instr(a.ATTACH_FILENAME,'.',-1),10) link
                from anexoscomprastransferencias a
                where a.idcompratransferencia = :P91_IDCOMPRATRANSFERENCIA
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from anexoscomprastransferencias a
                where a.idcompratransferencia = :P91_IDCOMPRATRANSFERENCIA
                ```
        }
