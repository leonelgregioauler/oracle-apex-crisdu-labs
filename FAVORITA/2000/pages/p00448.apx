page 448 (
    name: Lista de Tags
    title: Lista de Tags
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region relatório-de-tags (
        name: Relatório de TAGs
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idtagproduto
                     , initcap(t.nome) as "Nome"
                     , decode(contabilizarelatorio,'S','Sim','Não') contabilizarelatorio  
                from tagsprodutos t
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 445
                items: {
                    P445_IDTAG: #IDTAGPRODUTO#
                }
                action: resetPagination
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 36118390188240146
        }

        column CONTABILIZARELATORIO (
            type: plainText
            heading {
                heading: Contabiliza em Relatórios
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column IDTAGPRODUTO (
            type: plainText
            heading {
                heading: Código
            }
            layout {
                sequence: 10
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column Nome (
            type: plainText
            heading {
                heading: Nome
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 383637 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CONTABILIZARELATORIO (
                sequence: 3
            )

            displayColumn IDTAGPRODUTO (
                sequence: 1
            )

            displayColumn "Nome" (
                sequence: 2
            )

        )

    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @ações
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 445
                items: {
                    P445_IDTAG:
                }
                clearCache: 445
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh-report (
        name: Refresh report
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @relatório-de-tags
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @relatório-de-tags
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-report-2 (
        name: Refresh report_1
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @ações
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @relatório-de-tags
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

