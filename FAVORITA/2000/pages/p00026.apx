page 26 (
    name: Cadastro de Situações Financeiro
    title: Situações Financeiro
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region situações-financeiro (
        name: Situações Financeiro
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P26_CODIGOCOR (
        type: colorPicker
        label {
            label: Código da Cor
            alignment: left
        }
        layout {
            sequence: 70
            region: @situações-financeiro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P26_DESCRICAOSISTEMA (
        type: textField
        label {
            label: Descrição do Sistema
            alignment: left
        }
        layout {
            sequence: 20
            region: @situações-financeiro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P26_DESCRICAOSITE (
        type: textField
        label {
            label: Descrição do Site
            alignment: left
        }
        layout {
            sequence: 30
            region: @situações-financeiro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P26_IDSITUACAOFINANCEIRO (
        type: hidden
        layout {
            sequence: 10
            region: @situações-financeiro
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P26_IDTEXTOSISTEMA (
        type: hidden
        layout {
            sequence: 50
            region: @situações-financeiro
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P26_IDTEXTOSITE (
        type: hidden
        layout {
            sequence: 60
            region: @situações-financeiro
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P26_MD5 (
        type: hidden
        layout {
            sequence: 80
            region: @situações-financeiro
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P26_OPERACAO_DML (
        type: hidden
        layout {
            sequence: 90
            region: @situações-financeiro
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 50
            region: @situações-financeiro
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P26_IDSITUACAOFINANCEIRO
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 40
            region: @situações-financeiro
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P26_IDSITUACAOFINANCEIRO
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 30
            region: @situações-financeiro
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 25
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 20
            region: @situações-financeiro
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P26_IDSITUACAOFINANCEIRO
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @situações-financeiro
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P26_IDSITUACAOFINANCEIRO
        }
    )

    validation descricaosite-obrigatório (
        name: DESCRICAOSITE obrigatório
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P26_DESCRICAOSITE
        }
        error {
            errorMessage: Descrição do site deve ter um valor.
            associatedItem: @P26_DESCRICAOSITE
        }
    )

    validation descriçãosistema-obrigatório (
        name: DESCRIÇÃOSISTEMA obrigatório
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P26_DESCRICAOSISTEMA
            alwaysExecute: true
        }
        error {
            errorMessage: Descrição do sistema deve ter um valor.
            associatedItem: @P26_DESCRICAOSISTEMA
        }
    )

    process consulta-situações-financeiro (
        name: Consulta Situações Financeiro
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                #OWNER#.PCK_CADASTROSSITUACOES_FAV.PRC_SITUACOESFINANCEIRO (
                  PIDSITUACAOFINANCEIRO => :P26_IDSITUACAOFINANCEIRO,
                  PDESCRICAOSISTEMA => :P26_DESCRICAOSISTEMA,
                  PDESCRICAOSITE => :P26_DESCRICAOSITE,
                  PCODIGOCOR => :P26_CODIGOCOR,
                  PMD5 => :P26_MD5,
                  POPERACAO_DML => 'S');
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 3316708515101039
        }
    )

    process limpar-campos-ao-sair (
        name: Limpar Campos ao Sair
        type: clearSessionState
        execution {
            sequence: 10
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 3317667887101048
        }
    )

    process limpar-campos-para-adicionar (
        name: Limpar Campos para Adicionar
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 3317721432101049
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    process operação-dml-em-situações-entrega (
        name: Operação DML em Situações Entrega
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  #OWNER#.PCK_CADASTROSSITUACOES_FAV.PRC_SITUACOESFINANCEIRO (
                    PIDSITUACAOFINANCEIRO => :P26_IDSITUACAOFINANCEIRO,
                    PDESCRICAOSISTEMA => :P26_DESCRICAOSISTEMA,
                    PDESCRICAOSITE => :P26_DESCRICAOSITE,
                    PCODIGOCOR => :P26_CODIGOCOR,
                    PMD5 => :P26_MD5,
                    POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 3355312511324451
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 26
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

)

