    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 60
            region: @kits-produtos
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-reply
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 514
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction desabilita-caixa-de-seleção-do-check-box (
        name: Desabilita Caixa de seleção do Check-box
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $(".check-box input").addClass("caixa");
            }
            execution {
                sequence: 10
            }
        )

    )

    validation data-inicial-precisa-ser-menor-ou-igual-a-final (
        name: Data inicial Precisa ser menor ou igual a Final
        execution {
            sequence: 30
        }
        validation {
            plsqlExpression: :P515_DATAINICIAL <= :P515_DATAFINAL
        }
        error {
            errorMessage: Data inicial Precisa ser menor ou igual a Final
        }
    )

    validation quantidade-maior-zero (
        name: Quantidade Maior Zero
        execution {
            sequence: 20
        }
        validation {
            editableRegion: @cadastro-de-itens-de-kitsprodutos
            plsqlExpression: :quantidade > 0
        }
        error {
            errorMessage: Quantidade precisa ser maior que zero
        }
    )

    validation referencia-obrigatório (
        name: REFERENCIA obrigatório
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNullOrZero
            item: P515_REFERENCIA
        }
        error {
            errorMessage: "Referência não pode ser vazia "
        }
    )

    process cadastro-de-itenskitsprodutos (
        name: Cadastro de itenskitsprodutos
        type: executeCode
        editableRegion: @cadastro-de-itens-de-kitsprodutos
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vexist number;
                  --
                  vmd5              varchar2(4000);
                  vmensagem         varchar2(4000);
                  --
                begin  
                     case :APEX$ROW_STATUS  
                     when 'C' then
                       --
                       favorita.PCK_CADASTROS_FAV.prc_itenskitsprodutos ( piditemkitproduto => :iditemkitproduto
                                                                        , pidkitproduto     => :idkitproduto
                                                                        , pidproduto        => :idproduto
                                                                        , pquantidade       => :quantidade
                                                                        , pbrinde           => :brinde
                                                                        , pmensagem         => vmensagem
                                                                        , pmd5              => vmd5
                                                                        , poperacao_dml     =>'I' );
                       --
                       apex_util.set_session_state('P515_ALERTA_MENSAGEM', vmensagem);
                       --
                     when 'U' then  
                       --
                       favorita.PCK_CADASTROS_FAV.prc_itenskitsprodutos ( piditemkitproduto => :iditemkitproduto
                                                                        , pidkitproduto     => :idkitproduto
                                                                        , pidproduto        => :idproduto
                                                                        , pquantidade       => :quantidade
                                                                        , pbrinde           => :brinde
                                                                        , pmensagem         => vmensagem
                                                                        , pmd5              => vmd5
                                                                        , poperacao_dml     =>'U' );
                       --
                       apex_util.set_session_state('P515_ALERTA_MENSAGEM', vmensagem);
                       --
                     when 'D' then  
                       --
                       favorita.PCK_CADASTROS_FAV.prc_itenskitsprodutos ( piditemkitproduto => :iditemkitproduto
                                                                        , pidkitproduto     => :idkitproduto
                                                                        , pidproduto        => :idproduto
                                                                        , pquantidade       => :quantidade
                                                                        , pbrinde           => :brinde
                                                                        , pmensagem         => vmensagem
                                                                        , pmd5              => vmd5
                                                                        , poperacao_dml     =>'D' );
                       --
                       apex_util.set_session_state('P515_ALERTA_MENSAGEM', vmensagem);
                       --
                     end case;  
                exception
                  when others then
                    apex_util.set_session_state('P515_ALERTA_MENSAGEM', 'Erro ao execultar processo'||DBMS_UTILITY.FORMAT_ERROR_BACKTRACE||' - '||sqlerrm);
                end;
                ```
        }
