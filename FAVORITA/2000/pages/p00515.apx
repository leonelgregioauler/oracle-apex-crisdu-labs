page 515 (
    name: Cadastro de Kits Produtos
    title: Cadastro de Kits Produtos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    headerAndFooter {
        headerText:
            ```html
            <style>
              
                .caixa {
                    display: none;
                }
             
            
            </style>
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-de-itens-de-kitsprodutos (
        name: Cadastro de Itens de KitsProdutos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.iditemkitproduto
                     , i.idkitproduto
                     , i.idproduto
                     , i.quantidade
                     , i.brinde
                from ITENSKITSPRODUTOS i
                where i.idkitproduto = :P515_IDKITPRODUTO
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 119696364172230438
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDITEMKITPRODUTO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDKITPRODUTO
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDPRODUTO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @QUANTIDADE
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @BRINDE
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @PrecoItemKit
                layout {
                    sequence: 6
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column BRINDE (
            type: selectList
            heading {
                heading: Brinde
            }
            lov {
                type: staticValues
                staticValues: STATIC:Sim;S,Não;N
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: BRINDE
                dataType: varchar2
            }
            default {
                type: static
                staticValue: N
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDITEMKITPRODUTO (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDITEMKITPRODUTO
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDKITPRODUTO (
            type: hidden
            layout {
                sequence: 50
            }
            source {
                databaseColumn: IDKITPRODUTO
                dataType: number
            }
            default {
                type: item
                item: P515_IDKITPRODUTO
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDPRODUTO (
            type: selectList
            heading {
                heading: Produto
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select p.referencia||' - '||p.nomeproduto showvalue
                         , p.idproduto returnvalue
                    from favorita.produtos p
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 60
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDPRODUTO
                dataType: number
            }
        )

        column PrecoItemKit (
            type: link
            heading {
                heading: Cadastrar Preços
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            link {
                target: {
                    page: 516
                    items: {
                        P516_IDITEMKITPRODUTO: &IDITEMKITPRODUTO.
                        P516_IDKITPRODUTO: &IDKITPRODUTO.
                        P516_IDPRODUTO: &IDPRODUTO.
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                type: none
            }
        )

        column QUANTIDADE (
            type: numberField
            heading {
                heading: Quantidade
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: QUANTIDADE
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

    )

