    process gerar-novo-preco (
        name: GERAR_NOVO_PRECO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vvalortotal       number;
                  vidkitproduto       number := :P515_IDKITPRODUTO;
                  valordescontonovo number := to_number(:P515_PRECO_NOVO,'999G999G999G990D00');
                  vvalordescontado  number;
                  --
                begin
                  --
                  for rrev in ( select distinct p.idedicaorevista
                                from favorita.precositenskitsprodutos p
                                   , favorita.itenskitsprodutos i 
                                where i.iditemkitproduto = p.iditemkitproduto
                                  and i.idkitproduto =  vidkitproduto)
                  loop
                    --
                    select round(sum((valorvendaoriginal - (pk.valorvendaoriginal * (nvl(pk.perccomissaoconsultora,1)/100)))),2) valor_pagar_consultora
                    into vvalortotal
                    from favorita.itenskitsprodutos k
                       , favorita.precositenskitsprodutos pk
                    where k.iditemkitproduto = pk.iditemkitproduto
                      and k.idkitproduto = vidkitproduto
                      and pk.idedicaorevista = rrev.idedicaorevista;
                    --
                    for rprec in ( select pk.idprecoitemkitproduto
                                        , round((((valorvendaoriginal - (valorvendaoriginal * (pk.perccomissaoconsultora/100)))/vvalortotal)/k.quantidade),2) perc_part_pagar
                                   from favorita.itenskitsprodutos k
                                      , favorita.precositenskitsprodutos pk
                                   where k.iditemkitproduto = pk.iditemkitproduto
                                     and k.idkitproduto = vidkitproduto
                                     and pk.idedicaorevista = rrev.idedicaorevista)
                    loop
                      --
                      dbms_output.put_line('valor desconto inicio calculo - '||valordescontonovo);
                      dbms_output.put_line('% desconto inicio calculo - '||rprec.perc_part_pagar);
                      --
                      vvalordescontado := valordescontonovo * rprec.perc_part_pagar;
                      --
                      dbms_output.put_line('valor a ser descontado - '||vvalordescontado);
                      --
                      update favorita.precositenskitsprodutos pk
                        set pk.valorvenda = round(vvalordescontado,2)
                      where pk.idprecoitemkitproduto = rprec.idprecoitemkitproduto;
                      --
                    end loop;
                    --
                  end loop;
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 119765977066013336
        }
        serverSideCondition {
            type: request=Value
            value: GERAR_NOVO_PRECO
        }
    )

    process operação-dml-em-kits-produtos (
        name: Operação DML em Kits Produtos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                  vmd5          varchar2(4000);
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  favorita.pck_cadastros_fav.prc_kitsprodutos( pidkitproduto    => :P515_IDKITPRODUTO
                                                             , preferencia      => :P515_REFERENCIA
                                                             , pdescricao       => :P515_DESCRICAO
                                                             , pfiliaisfavorita => :P515_FILIAISFAVORITA
                                                             , pidcategoria     => :P515_IDCATEGORIA
                                                             , phabilitarpara   => :P515_HABILITARPARA
                                                             , pfiliaisromance  => :P515_FILIAISROMANCE
                                                             , pkitcampanha     => :P515_KITCAMPANHA
                                                             , pdatainicial     => :P515_DATAINICIAL
                                                             , pdatafinal       => :P515_DATAFINAL
                                                             , pcodigovirtualage => :P515_CODIGOVIRTUALAGE
                                                             , PIDENTIFICADORECOMMERCE => :P515_IDENTIFICADORECOMMERCE
                                                             , pmd5             => vmd5
                                                             , poperacao_dml    => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 119694260888230417
        }
    )

    process preco-original-revista (
        name: PRECO_ORIGINAL_REVISTA
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vvalorvenda               number;
                  vperccomissaoconsultora   number;
                  vperccomissaodistribuidor number;
                  vperccomissaogerente      number;
                  --
                begin
                  --
                  for rprec in ( select pik.valorvendaoriginal,
                                        pik.perccomissaogerente,
                                        pik.perccomissaodistribuidor,
                                        pik.perccomissaoconsultora,
                                        pik.valorcomissaoatendente,
                                        pik.idedicaorevista,
                                        max(pd.idprodutodetalhado) idprodutodetalhado,
                                        ee.idpais idpais,
                                        pik.idprecoitemkitproduto
                                 from favorita.precositenskitsprodutos pik
                                    , favorita.itenskitsprodutos i
                                    , favorita.produtosdetalhados pd
                                    , favorita.edicoesrevistas ee
                                    , favorita.produtosdetedrevistas pr
                                 where pik.iditemkitproduto = i.iditemkitproduto 
                                   and pd.idproduto = i.idproduto
                                   and ee.idedicaorevista = pik.idedicaorevista
                                   and ee.idedicaorevista = pr.idedicaorevista
                                   and pd.idprodutodetalhado = pr.idprodutodetalhado
                                   and i.idkitproduto = :P515_IDKITPRODUTO
                                 group by i.idproduto ,
                                          pik.valorvendaoriginal,
                                          pik.perccomissaogerente,
                                          pik.perccomissaodistribuidor,
                                          pik.perccomissaoconsultora,
                                          pik.valorcomissaoatendente,
                                          pik.idedicaorevista,
                                          pik.idprecoitemkitproduto,
                                          ee.idpais)
                  loop
                    --
                    select a.a.valorvenda
                     , a.a.perccomissaoconsultora
                     , a.a.perccomissaodistribuidor
                     , a.a.perccomissaogerente
                    into 
                       vvalorvenda
                     , vperccomissaoconsultora
                     , vperccomissaodistribuidor
                     , vperccomissaogerente
                    from(
                    select favorita.pck_integracao_fav_widecomm.fnc_buscavalorcomdesconto( pidedicaorevista    => rprec.idedicaorevista
                                                                                         , pidprodutodetalhado => rprec.idprodutodetalhado
                                                                                         , pidpais             => rprec.idpais) a
                    from dual)a;
                    --
                    update precositenskitsprodutos pik
                      set pik.valorvendaoriginal       = vvalorvenda
                        , pik.valorvenda               = vvalorvenda 
                        , pik.perccomissaoconsultora   = vperccomissaoconsultora
                        , pik.perccomissaodistribuidor = vperccomissaodistribuidor
                        , pik.perccomissaogerente      = vperccomissaogerente
                    where pik.idprecoitemkitproduto = rprec.idprecoitemkitproduto;
                    --
                    commit;
                    --
                  end loop;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 119766000970013337
        }
        serverSideCondition {
            type: request=Value
            value: PRECO_ORIGINAL_REVISTA
        }
    )

