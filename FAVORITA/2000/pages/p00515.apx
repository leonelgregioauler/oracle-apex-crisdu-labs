    pageItem P515_PRECOKIT_ORIGINAL (
        type: checkboxGroup
        label {
            label: Preco Original Revista
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'R$ '|| sum(pik.valorvendaoriginal * ik.quantidade) ||' - '||
                       pck_util_fav.fnc_edicaorevista(idedicaorevista) as d
                     , idedicaorevista as r
                from precositenskitsprodutos pik
                   , itenskitsprodutos ik
                where pik.iditemkitproduto = ik.iditemkitproduto
                and ik.idkitproduto = :P515_IDKITPRODUTO
                group by pik.idedicaorevista
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 140
            region: @kits-produtos
            slot: regionBody
            alignment: left
            columnCssClasses: check-box
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select 'R$ '|| sum(pik.valorvendaoriginal * ik.quantidade) ||' - '||
                       pck_util_fav.fnc_edicaorevista(idedicaorevista) as d
                from precositenskitsprodutos pik
                   , itenskitsprodutos ik
                where pik.iditemkitproduto = ik.iditemkitproduto
                and ik.idkitproduto = :P515_IDKITPRODUTO
                group by pik.idedicaorevista
                ```
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P515_PRECO_CONSULTORA (
        type: checkboxGroup
        label {
            label: Valor Pagar Consultora
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'R$ '|| round(sum(((pik.valorvenda -(pik.valorvenda * pik.perccomissaoconsultora/100)) * ik.quantidade)),2) ||' - '||
                       pck_util_fav.fnc_edicaorevista(pik.idedicaorevista) as d
                     , pik.idedicaorevista as r
                from precositenskitsprodutos pik
                   , itenskitsprodutos ik
                where pik.iditemkitproduto = ik.iditemkitproduto
                and ik.idkitproduto = :P515_IDKITPRODUTO
                group by pik.idedicaorevista;
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 160
            region: @kits-produtos
            slot: regionBody
            alignment: left
            columnCssClasses: check-box
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P515_PRECO_KIT (
        type: checkboxGroup
        label {
            label: Preço S/ desconto Kit
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'R$ '|| sum(pik.valorvenda * ik.quantidade) ||' - '||
                       pck_util_fav.fnc_edicaorevista(idedicaorevista) as d
                     , idedicaorevista as r
                from precositenskitsprodutos pik
                   , itenskitsprodutos ik
                where pik.iditemkitproduto = ik.iditemkitproduto
                and ik.idkitproduto = :P515_IDKITPRODUTO
                group by pik.idedicaorevista
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 150
            region: @kits-produtos
            slot: regionBody
            alignment: left
            startNewRow: false
            columnCssClasses: check-box
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P515_PRECO_KIT_DIST (
        type: checkboxGroup
        label {
            label: Valor Pagar Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'R$ '|| round(sum( ((pik.valorvenda - (pik.valorvenda * pik.perccomissaoconsultora/100)) - ((pik.valorvenda - (pik.valorvenda * pik.perccomissaoconsultora/100)) * pik.perccomissaodistribuidor/100))* ik.quantidade),2) ||' - '||
                       pck_util_fav.fnc_edicaorevista(pik.idedicaorevista) as d
                     , pik.idedicaorevista as r
                from precositenskitsprodutos pik
                   , itenskitsprodutos ik
                where pik.iditemkitproduto = ik.iditemkitproduto
                and ik.idkitproduto = :P515_IDKITPRODUTO
                group by pik.idedicaorevista;
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 170
            region: @kits-produtos
            slot: regionBody
            alignment: left
            startNewRow: false
            columnCssClasses: check-box
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

