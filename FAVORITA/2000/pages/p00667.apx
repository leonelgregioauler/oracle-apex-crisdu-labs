    region recebimento-de-brindes (
        name: Recebimento de Brindes
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
    )

    pageItem P667_CAMPANHA (
        type: selectList
        label {
            label: "Campanha : "
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select cp.nomecampanha
                     , cp.idconquistoulevou
                from roman.campanhasconquistoulevou cp
                where /*cp.status = 'S'
                  and trunc(sysdate) between cp.datadivulgacao and cp.datafimdivulgacao --valida campanha vigente.
                  and*/ cp.idpais = (select u.ididioma
                                   from catal.usuarios u 
                                   where u.usuario = v('APP_USER')
                                     and u.usuario not in (select ug.usuario
                                                           from roman.usuariosgruposatendimento ug
                                                           where ug.usuario = v('APP_USER')
                                                             and ug.idgrupoatendimento = 0 ))--Não lista filial do usuário do TI. )  
                union 
                select cp.nomecampanha
                     , cp.idconquistoulevou
                from roman.campanhasconquistoulevou cp
                where /*cp.status = 'S'
                  and trunc(sysdate) between cp.datadivulgacao and cp.datafimdivulgacao --valida campanha vigente.
                  and */ cp.idpais = ( select f.idpais
                                    from favorita.filiaisfavorita f
                                    where f.idfilialfavorita = :P667_LOJA)
                  and exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.usuario = v('APP_USER')
                                 and ug.idgrupoatendimento = 0 ) -- usuários TI
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P667_LOJA
        }
        layout {
            sequence: 30
            region: @recebimento-de-brindes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P667_GUIAENVIO (
        type: selectList
        label {
            label: "Guia Envio : "
            alignment: left
        }
        settings {
            pageActionOnSelection: submitPage
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select g.idguiaentregabrinde d
                     , g.idguiaentregabrinde r
                from roman.guiasentregasbrindes g 
                where g.dataenvio is not null
                  and g.idfilial = :P667_LOJA
                  and g.idconquistoulevou = :P667_CAMPANHA
                /* and exists ( select 1 
                              from roman.campanhasconquistoulevou cp
                              where cp.idconquistoulevou = g.idconquistoulevou
                                and cp.status = 'S')*/
                order by 1               
                ```
        }
        cascadingLov {
            parentItems: [
                P667_LOJA
                P667_CAMPANHA
            ]
        }
        layout {
            sequence: 50
            region: @recebimento-de-brindes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDGUIAENTREGABRINDE
            used: always
        }
        default {
            type: item
            item: P667_GUIAENVIO
        }
    )

    pageItem P667_IDCUPIOM (
        type: hidden
        layout {
            sequence: 70
            region: @recebimento-de-brindes
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select cl.idconquistoulevoucupom
                from roman.conquistoulevoucupons cl 
                   , roman.guiasentregascupons gc
                   , roman.guiasentregasbrindes ge
                where cl.idconquistoulevoucupom = gc.idconquistoulevoucupom
                  and gc.idguiaentregabrinde = ge.idguiaentregabrinde
                  and cl.datarecebfilial is null
                  and ge.idguiaentregabrinde = :P667_GUIAENVIO
                ```
        }
        default {
            type: item
            item: P667_IDCUPIOM
        }
    )

    pageItem P667_ITENSFALTANTES (
        type: selectList
        label {
            label: "Itens Faltantes "
            alignment: left
        }
        settings {
            pageActionOnSelection: submitPage
        }
        lov {
            type: staticValues
            staticValues: STATIC:Sim;S,Não;N
        }
        layout {
            sequence: 20
            region: @recebimento-de-brindes
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P667_LOJA (
        type: selectList
        label {
            label: Loja :
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomefilialfavorita(u.idfilialfavorita) loja  --Somente a filial do usuário 
                     , u.idfilialfavorita
                from catal.usuarios u 
                where u.usuario = v('APP_USER')
                  and u.usuario not in (select ug.usuario
                                        from roman.usuariosgruposatendimento ug
                                        where ug.usuario = v('APP_USER')
                                          and ug.idgrupoatendimento = 0 ) --Não lista junto a filial do usuário do TI. 
                 
                union 
                select favorita.pck_util_fav.fnc_nomefilialfavorita(u.idfilialfavorita) loja --Para usuários do TI mostra todas as filiais que tenham cupom gerado. 
                     , u.idfilialfavorita
                from catal.usuarios u 
                where exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.usuario = v('APP_USER')
                                 and ug.idgrupoatendimento = 0 )-- Grupo TI
                 and exists ( select 1 
                              from roman.conquistoulevoucupons cl
                              where cl.idfilialretira = u.idfilialfavorita 
                                and exists ( select 1 
                                             from roman.guiasentregascupons g
                                             where g.idconquistoulevoucupom = cl.idconquistoulevoucupom ))
                order by 1                             
                ```
        }
        layout {
            sequence: 10
            region: @recebimento-de-brindes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P667_NOMECAMPANHA (
        type: hidden
        layout {
            sequence: 90
            region: @recebimento-de-brindes
            slot: regionBody
        }
