    dynamicAction deixa-item-inacessível (
        name: "Deixa item inacessível "
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P667_ITENSFALTANTES
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: items
                items: P667_ITENSFALTANTES
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: noRowsReturned
                sqlQuery:
                    ```sql
                    select distinct 1
                    from roman.conquistoulevoucupons clc
                       , roman.guiasentregascupons gec 
                       , roman.guiasentregasbrindes ge
                    where clc.idconquistoulevoucupom = gec.idconquistoulevoucupom
                      and gec.idguiaentregabrinde = ge.idguiaentregabrinde
                      and ge.idguiaentregabrinde = :P667_GUIAENVIO
                      and clc.datarecebfilial is null
                    ```
            }
        )

    )

