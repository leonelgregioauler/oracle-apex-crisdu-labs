    region cupons-guia-de-envios (
        name: Cupons Guia de Envios
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ge.idguiaentregabrinde
                     , cl.idconquistoulevoucupom
                     , roman.pck_romance.fnc_nomevendedora(cl.idvendedora) Vendedora 
                     , ge.dataemissao
                     , ge.dataenvio
                     , cl.datarecebfilial
                     , cl.retiradopor
                     , cl.idvendedora
                     , (select ff.nomefilialfavorita
                        from favorita.filiaisfavorita ff
                        where ff.idfilialfavorita= cl.idfilialretira ) Loja
                from roman.conquistoulevoucupons cl 
                   , roman.guiasentregascupons gc
                   , roman.guiasentregasbrindes ge
                where cl.idconquistoulevoucupom = gc.idconquistoulevoucupom
                  and gc.idguiaentregabrinde = ge.idguiaentregabrinde
                  and ge.dataenvio is not null
                  and ge.idguiaentregabrinde = :P667_GUIAENVIO
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1803628783311654002
        }

