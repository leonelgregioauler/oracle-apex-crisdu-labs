    process busca-dados (
        name: "Busca dados "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                --
                vitensfaltantes  varchar2(10);
                --
                begin
                   --
                  select gt.itensfaltantes
                    into :P667_ITENSFALTANTES
                  from roman.guiasentregasbrindes gt
                  where gt.idguiaentregabrinde = :P667_GUIAENVIO;
                 exception
                   when no_data_found then
                   :P667_ITENSFALTANTES := null;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1807362220152565203
        }
        serverSideCondition {
            type: itemIsNull
            item: P667_ITENSFALTANTES
        }
    )

    process recebe-brindes-faltantes (
        name: Recebe Brindes Faltantes
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  -- 
                  vcontrolaitfalt number;
                  vidusuario      number;
                  vguiaentrega    number := :P667_GUIAENVIO;
                  --
                begin
                  --
                  for i in (select it.iditemfaltante
                                , cbc.idbrindeclube
                                , cbc.idclassificacao
                                , cbc.idcaracteristica
                                , it.qtdfaltante
                                , it.idguiaentregabrinde
                           from roman.itensfaltantes it 
                              , roman.classificacoesbrindesclub cbc
                           where cbc.idclassifbrindeclub = it.idclassifbrindeclub
                             and it.idguiaentregabrinde = vguiaentrega
                             and it.datarecebimento is null ) 
                  loop 
                    --
                    vcontrolaitfalt := i.qtdfaltante;
                  
                    for x in (select cl.idconquistoulevoucupom
                                   , cl.idvendedora
                                   , gc.idguiaentregacupon
                              from roman.conquistoulevoucupons cl
                                 , roman.guiasentregascupons gc
                                 , roman.guiasentregasbrindes gb 
                                 , roman.itensconqlevcupons itc
                              where cl.idconquistoulevoucupom = gc.idconquistoulevoucupom
                                and gb.idguiaentregabrinde = gc.idguiaentregabrinde
                                and itc.idconquistoulevoucupom = cl.idconquistoulevoucupom
                                and itc.idbrindeclube = i.idbrindeclube
                                and itc.idclassificacao = i.idclassificacao
                                and itc.idcaracteristica = i.idcaracteristica
                                and gb.idguiaentregabrinde = i.idguiaentregabrinde
                            order by cl.idconquistoulevoucupom desc ) 
                    loop 
                      --
                      if vcontrolaitfalt > 0 then  
                        --
                        update roman.guiasentregascupons gec
                        set gec.itensfaltantes = 'S'
                        where gec.idguiaentregacupon = x.idguiaentregacupon;
                        --
                        vcontrolaitfalt := (vcontrolaitfalt - 1);
                        --
                      else
                        --
                        exit;
                        --
                      end if;
                      --
                      end loop;
                      --
                  end loop; 
                  --
                  commit;
                  
                  --cupons validos sem itens faltantes 
                
                    for i in (select clc.idconquistoulevoucupom
                              from roman.conquistoulevoucupons clc
                                 , roman.guiasentregascupons gc
                              where gc.idconquistoulevoucupom = clc.idconquistoulevoucupom
                                and gc.idguiaentregabrinde = vguiaentrega
                                and nvl(gc.itensfaltantes, 'N') = 'N' ) 
                    loop
                      --
                      update roman.conquistoulevoucupons c
                      set c.datarecebfilial = sysdate 
                      where c.idconquistoulevoucupom = i.idconquistoulevoucupom;
                      --    
                    end loop; 
                    --
                    select u.idusuario
                      into vidusuario
                    from catal.usuarios u 
                    where u.usuario =  v('APP_USER'); 
                    --
                    update roman.guiasentregasbrindes geb
                    set geb.idusuario = vidusuario, geb.itensfaltantes = 'S'
                    where geb.idguiaentregabrinde = vguiaentrega;
                    
                    --
                    commit;
                    --
                end;
                  
                  
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 1804096839219169422
        }
        serverSideCondition {
            whenButtonPressed: @receberfaltante
            type: never
        }
    )

    process recebe-brindes-loja (
        name: "Recebe Brindes Loja "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidusuario number;
                  --vguiaentrega number := :P667_GUIAENVIO;
                  --
                begin
                  --
                  select u.IDUSUARIO
                    into vidusuario
                    from catal.usuarios u 
                   where u.usuario =  v('APP_USER') ;
                  --
                  for c in (select ifa.iditemfaltante
                                 , ifa.idguiaentregabrinde
                              from roman.itensfaltantes ifa
                             where ifa.idguiaentregabrinde = :P667_GUIAENVIO
