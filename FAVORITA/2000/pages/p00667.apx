page 667 (
    name: Receber Guia Cupons
    title: Receber Guia Cupons
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 30
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
