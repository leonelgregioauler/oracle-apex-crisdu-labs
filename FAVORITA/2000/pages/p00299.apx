page 299 (
    name: Movimentações de Estoque de Avarias
    title: Movimentações de Estoque de Avarias
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: firstItemOnPage
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function confirmaitem(event)
            {
             var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
             console.log (tecla);
             if (tecla==13) 
             { 
              var answer = confirm("Confirma inclusão do item no estoque de defeito ?")
              if (answer)
              {
                apex.submit('CREATE');
              }
             } 
              else 
              { if([190,188,110,194].indexOf(tecla) !=-1) 
                {
                 alert('Informe uma Quantidade Válida!'); 
                 return false;
                }
              }
            }
            
            function tem_casas_decimais(valor)
            {
             if (typeof(valor) != 'String')
              valor = valor.toString();
            
             return valor.match(/[.,]/) != null;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region movimentar-estoque (
        name: Movimentar Estoque
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P299_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Estoque
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomefilialfavorita display_value
                     , idfilialfavorita  return_value
                from vw_filiaisfavorita w
                where exists ( select 1
                               from usuariosfiliaisfavorita u
                               where u.idfilialfavorita = w.idfilialfavorita
                                 and u.movimentar = 'S'
                                 and u.idusuario = :P0_IDUSUARIO )
                order by 1
                ```
            nullDisplayValue: " - Selecione o Estoque- "
        }
        layout {
            sequence: 20
            region: @movimentar-estoque
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P299_IDPRODUTODETALHADO (
        type: plugin/select
        label {
            label: Produto
            alignment: left
        }
        settings {
            width: 450
        }
        lov {
            type: sharedComponent
            lov: @lov-produtosdetalhados
            displayExtraValues: false
            nullDisplayValue: "- Selecione o Produto - "
        }
        cascadingLov {
            parentItems: P299_IDFILIALFAVORITA
        }
        layout {
            sequence: 40
            region: @movimentar-estoque
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P299_MOTIVO (
        type: textarea
        label {
            label: Motivo
            alignment: left
        }
        layout {
            sequence: 100
            region: @movimentar-estoque
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
        source {
            type: databaseColumn
            databaseColumn: MOTIVO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P299_QUANTIDADE (
        type: numberField
        label {
            label: Quantidade
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 90
            region: @movimentar-estoque
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 10
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P299_TIPOMOVIMENTO (
        type: radioGroup
        label {
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC:Entrada;E,Saída;S
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @movimentar-estoque
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 10
            region: @movimentar-estoque
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 300
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button movimentar (
        buttonName: MOVIMENTAR
        label: Movimentar
        layout {
            sequence: 20
            region: @movimentar-estoque
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction tipo-movimento (
        name: Tipo movimento
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P299_TIPOMOVIMENTO
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P299_TIPOMOVIMENTO
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P299_QUANTIDADE
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P299_QUANTIDADE
            }
            execution {
                sequence: 10
            }
        )

    )

    validation estoque-obrigatório (
        name: ESTOQUE obrigatório
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P299_IDFILIALFAVORITA
        }
        error {
            errorMessage: Estoque deve ter um valor.
            associatedItem: @P299_IDFILIALFAVORITA
        }
    )

    validation motivo-maior-que-20-caracteres (
        name: MOTIVO maior que 20 caracteres
        execution {
            sequence: 70
        }
        validation {
            plsqlExpression: length(:P299_MOTIVO) > 20
        }
        error {
            errorMessage: Motivo deve ter mais do que 20 caracteres.
            associatedItem: @P299_MOTIVO
        }
    )

    validation motivo-obrigatório (
        name: MOTIVO obrigatório
        execution {
            sequence: 80
        }
        validation {
            type: itemIsNotNull
            item: P299_MOTIVO
        }
        error {
            errorMessage: Motivo deve ter um valor.
            associatedItem: @P299_MOTIVO
        }
    )

    validation produto-obrigatório (
        name: PRODUTO obrigatório
        execution {
            sequence: 60
        }
        validation {
            type: itemIsNotNull
            item: P299_IDPRODUTODETALHADO
        }
        error {
            errorMessage: Produto deve ter um valor.
            associatedItem: @P299_IDPRODUTODETALHADO
        }
    )

    validation quantidade-inteiro (
        name: QUANTIDADE inteiro
        execution {
            sequence: 90
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  verro varchar2(1000);
                begin
                  if instr(:P299_QUANTIDADE, ',') > 0 or
                     instr(:P299_QUANTIDADE,'.') > 0 then
                    --
                    return 'Quantidade deve ser um número inteiro';
                    --
                  else
                    null;
                  end if;
                end;
                ```
        }
        error {
            associatedItem: @P299_QUANTIDADE
        }
    )

    validation quantidade-maior-que (
        name: QUANTIDADE maior que 0
        execution {
            sequence: 100
        }
        validation {
            plsqlExpression: :P299_QUANTIDADE > 0
        }
        error {
            errorMessage: "Quantidade deve ser maior que zero (0) "
            associatedItem: @P299_QUANTIDADE
        }
        serverSideCondition {
            type: expression
            plsqlExpression: instr(:P299_QUANTIDADE, '.') = 0
        }
    )

    validation quantidade-obrigatório (
        name: QUANTIDADE obrigatório
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P299_QUANTIDADE
        }
        error {
            errorMessage: Quantidade deve ser informada.
            associatedItem: @P299_QUANTIDADE
        }
    )

    validation tipomovimento-obrigatório (
        name: TIPOMOVIMENTO obrigatório
        execution {
            sequence: 50
        }
        validation {
            type: itemIsNotNull
            item: P299_TIPOMOVIMENTO
        }
        error {
            errorMessage: Selecione o tipo de movimento.
            associatedItem: @P299_TIPOMOVIMENTO
        }
    )

    process processo-dml-para-movimentar-estoque-defeito (
        name: Processo DML para Movimentar Estoque Defeito
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  videstoquedefeito    number;
                  viddefeito           number := 8;
                  vnumbernull          number := null;
                begin
                  -- 
                  if :P299_TIPOMOVIMENTO = 'S' then
                    :P299_QUANTIDADE := to_number(:P299_QUANTIDADE)*-1;
                  end if;
                  --
                  -- 
                  if v('REQUEST') = 'MOVIMENTAR' then
                    --
                    pck_estoque_fav.prc_movimentosestoquesdefeitos(pidestoquedefeito => videstoquedefeito,
                                                                   pidfilialfavorita => :P299_IDFILIALFAVORITA,
                                                                   piddefeito => viddefeito,
                                                                   pidusuario => :P0_IDUSUARIO,
                                                                   pidprodutodetalhado => :P299_IDPRODUTODETALHADO,
                                                                   piditemdevolucaopedido => vnumbernull,
                                                                   piditemcompratransferencia => vnumbernull,
                                                                   piditempedidotrocado => vnumbernull,
                                                                   pquantidade => :P299_QUANTIDADE,
                                                                   pmotivo => :P299_MOTIVO);
                    --
                  end if;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1399418100822260547
        }
    )

)

