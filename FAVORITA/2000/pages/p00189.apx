                  and ( :P189_PEDIDOSZERADOS = 'T' or ( :P189_PEDIDOSZERADOS = 'S' and p.valorapagar_vencimento = 0  ) or ( :P189_PEDIDOSZERADOS = 'N' and p.valorapagar_vencimento != 0 ))
                  and ( nvl(:P189_LIVE,'0') = '0'   -- Filtro Live (0 = Todos)
