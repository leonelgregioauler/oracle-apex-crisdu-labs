    region resumido-coordenação-teste (
        name: Resumido Coordenação TESTE
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select filialfavorita
                     , count(x.numeropedido) quantidade
                     , sum(x.valortotal ) valortotal
                     , sum(x.valorapagar_pedido) valorapagar
                     , sum(x.valorapagar_pedido_Conv) valorapagarConv
                     , x.MesEmissao
                     , x.FeitoEntregue
                     , 'CD' tipo
                from ( select 'P'||p.idpedido numeropedido
                            , p.filialfavoritausu filialfavorita
                            , p.MesEmissao
                            , p.valortotal
                            , p.valorapagar_pedido
                            , p.valorapagar_pedido_Conv
                            , p.FeitoEntregue
                from REL_RESUMIDO_2000_189 p
                where ( :P189_IDFILIALFAVORITA is null or p.idfilialfavoritausu in (select regexp_substr(:P189_IDFILIALFAVORITA, '[^:]+', 1, level) 
                                                                                      from dual connect by level <= regexp_count(:P189_IDFILIALFAVORITA, ':') + 1))
                  and ( :P189_FORMAPAGAMENTO = -1 or exists ( select 1 from classificacoespedidos c where c.idpedido = p.idpedido and c.idcaracteristicapedido = 8 and c.idvalorcaracteristica = :P189_FORMAPAGAMENTO ) )
                  and ( :P189_PEDIDOCREDEV is null or ( :P189_PEDIDOCREDEV = 'N' and not exists ( select 1 from classificacoespedidos c where c.idpedido = p.idpedido and c.idcaracteristicapedido = 8 and c.idvalorcaracteristica = 25 ) )
                                                   or ( :P189_PEDIDOCREDEV = 'S' and exists ( select 1 from classificacoespedidos c where c.idpedido = p.idpedido and c.idcaracteristicapedido = 8 and c.idvalorcaracteristica = 25 ) ) or ( :P189_PEDIDOCREDEV = 'C' ))
                  and p.dataemissao between to_date(:P189_DATAINICIO,'DD/MM/RRRR') and to_date(:P189_DATAFIM,'DD/MM/RRRR')
                  and nvl(p.valortotal,0) > 0
                  and p.idfilialfavorita = 6 -- estoque belem
                  and exists ( select 1
                               from classificacoespedidos cp, usuarios u
                               where cp.idcaracteristicapedido = 81 -- usuario digitou o pedido
                                 and u.idusuario = cp.idusuario
                                 and u.usuario like '%DELIVERY%'
                                 and cp.idpedido               = p.idpedido )
                  and ( :P189_PESQUISAR_POR = 'A'
                      or ( :P189_PESQUISAR_POR = 'B' and exists ( select 1
                                                                  from pessoas pp, vendedoras v
                                                                  where pp.idpessoa = v.idpessoa
                                                                    and v.idvendedora = p.idvendedora
                                                                    and trim(upper(pp.bairro)) like '%'||upper(:P189_BAIRRO)||'%' ) )
                      or ( :P189_PESQUISAR_POR = 'C' and exists ( select 1
                                                                  from pessoas pp, vendedoras v
                                                                  where pp.idpessoa = v.idpessoa
                                                                    and v.idvendedora = p.idvendedora
                                                                    and pp.idcidade = :P189_IDCIDADE ) ) )
                  and ( :P189_CANCELADOS = 0 or ( :P189_CANCELADOS = 1 and p.datacancelamento is not null) or ( :P189_CANCELADOS = 2 and p.datacancelamento is null))
                  and ( :P189_EMDEBITO = 0 or ( :P189_EMDEBITO = 1 and p.saldo_vencimento > 0) or ( :P189_EMDEBITO = 2 and p.saldo_vencimento = 0))
                  and ( :P189_APROVADO = 0 or ( :P189_APROVADO = 1 and p.idsituacaoentrega > 20000) or ( :P189_APROVADO = 2 and p.idsituacaoentrega <= 20000))
                  and ( :P189_POSSUI_TAREFA = 0 or ( :P189_POSSUI_TAREFA = 1 and p.idtarefa is not null) or ( :P189_POSSUI_TAREFA = 2 and p.idtarefa is null))
                  and (:P189_PEDIDOFEITOPOR = 'T' 
                    or (:P189_PEDIDOFEITOPOR = 'C' and not exists ( select 1
                                                                    from classificacoespedidos cp
                                                                    where cp.idpedido = p.idpedido
                                                                      and cp.idcaracteristicapedido = 2 ) )
                    or (:P189_PEDIDOFEITOPOR = 'D' and exists ( select 1
                                                                from classificacoespedidos cp
                                                                where cp.idpedido = p.idpedido
                                                                  and cp.idcaracteristicapedido = 2 ) ) )
                  and ( :P189_TIPO_PEDIDO = 0 or 
                      ( :P189_TIPO_PEDIDO = 1 and p.tipopedido = 'P') or 
                      ( :P189_TIPO_PEDIDO = 2 and p.tipopedido = 'T') or 
                      ( :P189_TIPO_PEDIDO = 3 and p.tipopedido = 'V') or 
                      ( :P189_TIPO_PEDIDO = 4 and p.tipopedido = 'R' and nvl(p.idfilialfavoritaorig,p.idfilialfavorita) in (select regexp_substr(:P189_IDFILIALFAVORITA, '[^:]+', 1, level) 
                                                                                                                              from dual connect by level <= regexp_count(:P189_IDFILIALFAVORITA, ':') + 1)))
                  and ( :P189_PEDIDOSZERADOS = 'T' or ( :P189_PEDIDOSZERADOS = 'S' and p.valorapagar_vencimento = 0  ) or ( :P189_PEDIDOSZERADOS = 'N' and p.valorapagar_vencimento != 0 ))
                  and ( nvl(:P189_LIVE,'0') = '0'   -- Filtro Live (0 = Todos)
                      or ( :P189_LIVE = '1' and exists ( select 1 from favorita.classificacoespedidos cl where cl.idpedido = p.idpedido and cl.idcaracteristicapedido = 128 ) )
                      or ( :P189_LIVE = '2' and not exists ( select 1 from favorita.classificacoespedidos cl where cl.idpedido = p.idpedido and cl.idcaracteristicapedido = 128 ) ) )
                  and ( :P189_PEDIDOFEITOPOR = 'T' or (:P189_PEDIDOFEITOPOR = p.pedido_feito_por ))
                  and ( :P189_FEITOPOR_ENTREGUEPOR = 'T' or (:P189_FEITOPOR_ENTREGUEPOR = p.feitopor_entreguepor)) ) x
                group by x.MesEmissao, x.filialfavorita, x.FeitoEntregue         
                union
                select t.filialfavorita
                     , sum(t.conta) Quantidade
                     , sum(t.valortotal) valortotal
                     , sum(t.valorapagar) valorapagar
                     , sum(t.valorapagarconv) valorapagarconv
                     , t.MesEmissao
                     , t.FeitoEntregue
                     , 'Loja' tipo
                from (select decode(p.tipopedido, 'R', nvl(p.filialfavoritaorig, p.filialfavorita), p.filialfavorita) filialfavorita
                     , count(1) conta
                     , sum(p.valortotal) valortotal
                     , sum(p.valorapagar_vencimento) valorapagar
                     , case when p.idfilialfavorita = 109 then -- 109 Loja Ponta Porã
                            sum(p.valorapagar_vencimento)
                       else
                           sum(p.valorapagar_vencimento_Conv) 
                       end valorapagarconv
                     , p.MesEmissao
                     , p.FeitoEntregue
                from REL_RESUMIDO_2000_189 p
                where p.idvendedora not in (2363887,2386265,2398240,2422007,2674982)
                  and ( :P189_FORMAPAGAMENTO = -1 or exists ( select 1
                                                             from classificacoespedidos c
                                                             where c.idpedido = p.idpedido
                                                               and c.idcaracteristicapedido = 8
                                                               and c.idvalorcaracteristica = :P189_FORMAPAGAMENTO ) )
                  and p.dataemissao between to_date(:P189_DATAINICIO,'DD/MM/RRRR') and to_date(:P189_DATAFIM,'DD/MM/RRRR')
                  and nvl(p.valortotal,0) > 0
                  and (:P189_IDFILIALFAVORITA is null and :P189_PORFILIAIS = 'T' and exists ( select 1
                                                                                                from filiaisfavorita ff
                                                                                               where ff.idfilialfavorita = p.idfilialfavorita
                                                                                                 and ff.ativo = 'S'
                                                                                                 and p.tipopedido <> 'R'
                                                                                                 and ff.tipofilial IN ('L','C')
                                                                                              union
                                                                                              select 1
                                                                                                from filiaisfavorita ff
                                                                                               where ff.idfilialfavorita = nvl(p.idfilialfavoritaorig, p.idfilialfavorita)
                                                                                                 and ff.ativo = 'S'
                                                                                                 and p.tipopedido = 'R'
                                                                                                 and ff.tipofilial IN ('L','C') ) 
                          OR ( :P189_PORFILIAIS = 'L' and p.tipopedido <> 'R' and p.idfilialfavorita in (select regexp_substr(:P189_IDFILIALFAVORITA, '[^:]+', 1, level) 
                                                                                                           from dual connect by level <= regexp_count(:P189_IDFILIALFAVORITA, ':') + 1) )
                          /*and exists ( select 1
                                    from filiaisfavorita f
                                   where f.idfilialfavorita = p.idfilialfavorita
                                     and f.tipofilial  IN ('L','C')
                                     and f.ativo            = 'S' )*/ 
                          OR ( :P189_PORFILIAIS = 'L' and p.tipopedido = 'R' and nvl(p.idfilialfavoritaorig, p.idfilialfavorita) in (select regexp_substr(:P189_IDFILIALFAVORITA, '[^:]+', 1, level) 
                                                                                                                                        from dual connect by level <= regexp_count(:P189_IDFILIALFAVORITA, ':') + 1) ))
                  and ( :P189_PESQUISAR_POR = 'A' or ( :P189_PESQUISAR_POR = 'B' and exists ( select 1
                                                                                                from pessoas pp
                                                                                                   , vendedoras v
                                                                                                where pp.idpessoa = v.idpessoa
                                                                                                  and v.idvendedora = p.idvendedora
                                                                                                  and trim(upper(pp.bairro)) like '%'||upper(:P189_BAIRRO)||'%' ) )
                      or ( :P189_PESQUISAR_POR = 'C' and exists ( select 1
                                                                    from pessoas pp
                                                                       , vendedoras v
                                                                    where pp.idpessoa = v.idpessoa
                                                                      and v.idvendedora = p.idvendedora
                                                                      and pp.idcidade = :P189_IDCIDADE ) ) )
                  and ( :P189_CANCELADOS = 0 or ( :P189_CANCELADOS = 1 and p.datacancelamento is not null) or ( :P189_CANCELADOS = 2 and p.datacancelamento is null))
                  and ( :P189_EMDEBITO = 0 or ( :P189_EMDEBITO = 1 and p.saldo_vencimento > 0) or ( :P189_EMDEBITO = 2 and p.saldo_vencimento = 0))
                  and ( :P189_APROVADO = 0 or ( :P189_APROVADO = 1 and p.idsituacaoentrega > 20000) or ( :P189_APROVADO = 2 and p.idsituacaoentrega <= 20000))
                  and ( :P189_POSSUI_TAREFA = 0 or ( :P189_POSSUI_TAREFA = 1 and p.idtarefa is not null) or ( :P189_POSSUI_TAREFA = 2 and p.idtarefa is null))
                  and (:P189_PEDIDOFEITOPOR = 'T' or (:P189_PEDIDOFEITOPOR = 'C' and not exists ( select 1
                                                                    from classificacoespedidos cp
                                                                    where cp.idpedido = p.idpedido
                                                                      and cp.idcaracteristicapedido = 2 ) )  -- Não listar pedidos que distribuidor fez para consultora
                    or (:P189_PEDIDOFEITOPOR = 'D' and exists ( select 1
                                                                from classificacoespedidos cp
                                                                where cp.idpedido = p.idpedido
                                                                  and cp.idcaracteristicapedido = 2 ) ) ) -- Listar pedidos que distribuidor fez para consultora     
                  and ( :P189_TIPO_PEDIDO = 0 or 
                      ( :P189_TIPO_PEDIDO = 1 and p.tipopedido = 'P') or 
                      ( :P189_TIPO_PEDIDO = 2 and p.tipopedido = 'T') or 
                      ( :P189_TIPO_PEDIDO = 3 and p.tipopedido = 'V') or 
                      ( :P189_TIPO_PEDIDO = 4 and p.tipopedido = 'R' and nvl(p.idfilialfavoritaorig,p.idfilialfavorita ) in (select regexp_substr(:P189_IDFILIALFAVORITA, '[^:]+', 1, level) 
                                                                                                                               from dual connect by level <= regexp_count(:P189_IDFILIALFAVORITA, ':') + 1)))
                  and ( :P189_PEDIDOCREDEV is null or ( :P189_PEDIDOCREDEV = 'N' and not exists ( select 1 from classificacoespedidos c where c.idpedido = p.idpedido and c.idcaracteristicapedido = 8 and c.idvalorcaracteristica = 25 ) )
                                                   or ( :P189_PEDIDOCREDEV = 'S' and exists ( select 1
                                                                                                from classificacoespedidos c
                                                                                               where c.idpedido = p.idpedido
                                                                                                 and c.idcaracteristicapedido = 8
                                                                                                 and c.idvalorcaracteristica = 25 ) ) or ( :P189_PEDIDOCREDEV = 'C' ))    
                  and ( :P189_PEDIDOSZERADOS = 'T' or ( :P189_PEDIDOSZERADOS = 'S' and p.valorapagar_vencimento = 0  )or ( :P189_PEDIDOSZERADOS = 'N' and p.valorapagar_vencimento != 0 ))
                  and ( nvl(:P189_LIVE,'0') = '0'   -- Filtro Live (0 = Todos)
                      or ( :P189_LIVE = '1' and exists ( select 1 from favorita.classificacoespedidos cl where cl.idpedido = p.idpedido and cl.idcaracteristicapedido = 128 ) )
                      or ( :P189_LIVE = '2' and not exists ( select 1 from favorita.classificacoespedidos cl where cl.idpedido = p.idpedido and cl.idcaracteristicapedido = 128 ) ) )
                  and ( :P189_PEDIDOFEITOPOR = 'T' or (:P189_PEDIDOFEITOPOR = p.pedido_feito_por ))
                  and ( :P189_FEITOPOR_ENTREGUEPOR = 'T' or (:P189_FEITOPOR_ENTREGUEPOR = p.feitopor_entreguepor))
                group by p.mesemissao, p.idfilialfavorita, p.filialfavorita, p.FeitoEntregue, p.tipopedido, p.filialfavoritaorig
                union
                select decode(p.tipopedido, 'R', nvl(p.filialfavoritaorig, p.filialfavorita), p.filialfavorita) filialfavorita
                     , count(1) conta
                     , sum(p.valortotal)  valortotal
                     , sum(p.valorapagar_pedido) valorapagar
                     , sum(p.valorapagar_pedido_Conv) valorapagarConv
                     , p.MesEmissao
                     , p.FeitoEntregue
                from REL_RESUMIDO_2000_189 p
                where (:P189_IDFILIALFAVORITA is null and :P189_PORFILIAIS = 'T' and exists ( select 1
                                                                                                from filiaisfavorita ff
                                                                                               where ff.idfilialfavorita = p.idfilialfavorita
                                                                                                 and ff.ativo = 'S'
                                                                                                 and p.tipopedido <> 'R'
                                                                                                 and ff.tipofilial IN ('L','C')
                                                                                              union
                                                                                              select 1
                                                                                                from filiaisfavorita ff
                                                                                               where ff.idfilialfavorita = nvl(p.idfilialfavoritaorig, p.idfilialfavorita)
                                                                                                 and ff.ativo = 'S'
                                                                                                 and p.tipopedido = 'R'
                                                                                                 and ff.tipofilial IN ('L','C') ) 
                          OR ( :P189_PORFILIAIS = 'L' and p.tipopedido <> 'R' and p.idfilialfavorita in (select regexp_substr(:P189_IDFILIALFAVORITA, '[^:]+', 1, level) 
                                                                                                           from dual connect by level <= regexp_count(:P189_IDFILIALFAVORITA, ':') + 1) )
                          /*and exists ( select 1
                                    from filiaisfavorita f
                                   where f.idfilialfavorita = p.idfilialfavorita
                                     and f.tipofilial  IN ('L','C')
                                     and f.ativo            = 'S' )*/ 
                          OR ( :P189_PORFILIAIS = 'L' and p.tipopedido = 'R' and nvl(p.idfilialfavoritaorig, p.idfilialfavorita) in (select regexp_substr(:P189_IDFILIALFAVORITA, '[^:]+', 1, level) 
                                                                                                                                        from dual connect by level <= regexp_count(:P189_IDFILIALFAVORITA, ':') + 1) ))
                  and ( :P189_FORMAPAGAMENTO = -1 or exists ( select 1
                                                             from classificacoespedidos c
                                                             where c.idpedido = p.idpedido
                                                               and c.idcaracteristicapedido = 8
                                                               and c.idvalorcaracteristica = :P189_FORMAPAGAMENTO ) )
                  and ( :P189_PEDIDOCREDEV is null or ( :P189_PEDIDOCREDEV = 'N' and not exists ( select 1
                                                                                                  from classificacoespedidos c
                                                                                                  where c.idpedido = p.idpedido
                                                                                                    and c.idcaracteristicapedido = 8
                                                                                                    and c.idvalorcaracteristica = 25 ) )
                                                   or ( :P189_PEDIDOCREDEV = 'S' and exists ( select 1
                                                                                              from classificacoespedidos c
                                                                                              where c.idpedido = p.idpedido
                                                                                                and c.idcaracteristicapedido = 8
                                                                                                and c.idvalorcaracteristica = 25 ) ) or ( :P189_PEDIDOCREDEV = 'C' ))
                  and p.dataemissao between to_date(:P189_DATAINICIO,'DD/MM/RRRR') and to_date(:P189_DATAFIM,'DD/MM/RRRR')
                  and nvl(p.valortotal,0) > 0
                  and p.idfilialfavorita = 6 -- estoque belem
                  and exists ( select 1
                               from classificacoespedidos cp, usuarios u
                               where cp.idcaracteristicapedido = 81 -- usuario digitou pedido
                                 and u.idusuario = cp.idusuario
                                 and u.usuario like '%DELIVERY%'
                                 and cp.idpedido = p.idpedido )
                  and ( :P189_PESQUISAR_POR = 'A' or ( :P189_PESQUISAR_POR = 'B' and exists ( select 1
                                                                  from pessoas pp, vendedoras v
                                                                  where pp.idpessoa = v.idpessoa
                                                                    and v.idvendedora = p.idvendedora
                                                                    and trim(upper(pp.bairro)) like '%'||upper(:P189_BAIRRO)||'%' ) )
                      or ( :P189_PESQUISAR_POR = 'C' and exists ( select 1
                                                                  from pessoas pp, vendedoras v
                                                                  where pp.idpessoa = v.idpessoa
                                                                    and v.idvendedora = p.idvendedora
                                                                    and pp.idcidade = :P189_IDCIDADE ) ) )
                  and ( :P189_CANCELADOS = 0 or ( :P189_CANCELADOS = 1 and p.datacancelamento is not null) or ( :P189_CANCELADOS = 2 and p.datacancelamento is null))
                  and ( :P189_EMDEBITO = 0 or ( :P189_EMDEBITO = 1 and p.saldo_vencimento > 0) or ( :P189_EMDEBITO = 2 and p.saldo_vencimento = 0))
                  and ( :P189_APROVADO = 0 or ( :P189_APROVADO = 1 and p.idsituacaoentrega > 20000) or ( :P189_APROVADO = 2 and p.idsituacaoentrega <= 20000))
                  and ( :P189_POSSUI_TAREFA = 0 or ( :P189_POSSUI_TAREFA = 1 and p.idtarefa is not null) or ( :P189_POSSUI_TAREFA = 2 and p.idtarefa is null))
                  and (:P189_PEDIDOFEITOPOR = 'T' or (:P189_PEDIDOFEITOPOR = 'C' and not exists ( select 1
                                                                    from classificacoespedidos cp
                                                                    where cp.idpedido = p.idpedido
                                                                      and cp.idcaracteristicapedido = 2 ) )
                    or (:P189_PEDIDOFEITOPOR = 'D' and exists ( select 1
                                                                from classificacoespedidos cp
                                                                where cp.idpedido = p.idpedido
                                                                  and cp.idcaracteristicapedido = 2 ) ) )     
                  and ( :P189_TIPO_PEDIDO = 0 or 
                      ( :P189_TIPO_PEDIDO = 1 and p.tipopedido = 'P') or 
                      ( :P189_TIPO_PEDIDO = 2 and p.tipopedido = 'T') or 
                      ( :P189_TIPO_PEDIDO = 3 and p.tipopedido = 'V') or 
                      ( :P189_TIPO_PEDIDO = 4 and p.tipopedido = 'R' and nvl(p.idfilialfavoritaorig,p.idfilialfavorita) in (select regexp_substr(:P189_IDFILIALFAVORITA, '[^:]+', 1, level) 
                                                                                                                              from dual connect by level <= regexp_count(:P189_IDFILIALFAVORITA, ':') + 1)))
                  and ( :P189_PEDIDOSZERADOS = 'T' or ( :P189_PEDIDOSZERADOS = 'S' and p.valorapagar_vencimento = 0  ) or ( :P189_PEDIDOSZERADOS = 'N' and p.valorapagar_vencimento != 0 ))
                  and ( nvl(:P189_LIVE,'0') = '0'   -- Filtro Live (0 = Todos)
                      or ( :P189_LIVE = '1' and exists ( select 1 from favorita.classificacoespedidos cl where cl.idpedido = p.idpedido and cl.idcaracteristicapedido = 128 ) )
                      or ( :P189_LIVE = '2' and not exists ( select 1 from favorita.classificacoespedidos cl where cl.idpedido = p.idpedido and cl.idcaracteristicapedido = 128 ) ) )
                  and ( :P189_PEDIDOFEITOPOR = 'T' or (:P189_PEDIDOFEITOPOR = p.pedido_feito_por ))
                  and ( :P189_FEITOPOR_ENTREGUEPOR = 'T' or (:P189_FEITOPOR_ENTREGUEPOR = p.feitopor_entreguepor))
                group by p.filialfavorita, p.mesemissao, p.FeitoEntregue, p.tipopedido, p.filialfavoritaorig) t
                group by t.filialfavorita, t.mesemissao, t.FeitoEntregue
                union
                select decode(p.tipopedido, 'R', nvl(p.filialfavoritaorig, p.filialfavorita), p.filialfavorita) filialfavorita
                     , count(1)
                     , sum(p.valortotal) valortotal
                     , sum(p.valorapagar_pedido) valorapagar
                     , case when p.idfilialfavorita = 109 then -- 109 Loja Ponta Porã
                            sum(p.valorapagar_vencimento)
                       else
                           sum(p.valorapagar_vencimento_Conv) 
                       end valorapagarconv
                     , p.MesEmissao
                     , p.FeitoEntregue
                   , 'Loja' tipo
                from REL_RESUMIDO_2000_189 p
                where p.idvendedora in (2363887,2386265,2398240,2422007,2674982)
                  and ( :P189_FORMAPAGAMENTO = -1 or exists ( select 1
                                                             from classificacoespedidos c
                                                             where c.idpedido = p.idpedido
                                                               and c.idcaracteristicapedido = 8
                                                               and c.idvalorcaracteristica = :P189_FORMAPAGAMENTO ) )
                  and p.dataemissao between to_date(:P189_DATAINICIO,'DD/MM/RRRR') and to_date(:P189_DATAFIM,'DD/MM/RRRR')
                  and nvl(p.valortotal,0) > 0
                  and (:P189_IDFILIALFAVORITA is null and :P189_PORFILIAIS = 'T' and exists ( select 1
                                                                                                from filiaisfavorita ff
                                                                                               where ff.idfilialfavorita = p.idfilialfavorita
                                                                                                 and ff.ativo = 'S'
                                                                                                 and p.tipopedido <> 'R'
                                                                                                 and ff.tipofilial IN ('L','C')
                                                                                              union
                                                                                              select 1
                                                                                                from filiaisfavorita ff
                                                                                               where ff.idfilialfavorita = nvl(p.idfilialfavoritaorig, p.idfilialfavorita)
                                                                                                 and ff.ativo = 'S'
                                                                                                 and p.tipopedido = 'R'
                                                                                                 and ff.tipofilial IN ('L','C') ) 
                          OR ( :P189_PORFILIAIS = 'L' and p.tipopedido <> 'R' and p.idfilialfavorita in (select regexp_substr(:P189_IDFILIALFAVORITA, '[^:]+', 1, level) 
                                                                                                           from dual connect by level <= regexp_count(:P189_IDFILIALFAVORITA, ':') + 1) )
                          /*and exists ( select 1
                                    from filiaisfavorita f
                                   where f.idfilialfavorita = p.idfilialfavorita
                                     and f.tipofilial  IN ('L','C')
                                     and f.ativo            = 'S' )*/ 
                          OR ( :P189_PORFILIAIS = 'L' and p.tipopedido = 'R' and nvl(p.idfilialfavoritaorig, p.idfilialfavorita) in (select regexp_substr(:P189_IDFILIALFAVORITA, '[^:]+', 1, level) 
                                                                                                                                       from dual connect by level <= regexp_count(:P189_IDFILIALFAVORITA, ':') + 1) ))
                  and ( :P189_PESQUISAR_POR = 'A' or ( :P189_PESQUISAR_POR = 'B' and exists ( select 1
                                                                  from pessoas pp, vendedoras v
                                                                  where pp.idpessoa = v.idpessoa
                                                                    and v.idvendedora = p.idvendedora
                                                                    and trim(upper(pp.bairro)) like '%'||upper(:P189_BAIRRO)||'%' ) )
                      or ( :P189_PESQUISAR_POR = 'C' and exists ( select 1
                                                                  from pessoas pp, vendedoras v
                                                                  where pp.idpessoa = v.idpessoa
                                                                    and v.idvendedora = p.idvendedora
                                                                    and pp.idcidade = :P189_IDCIDADE ) ) )
                  and ( :P189_CANCELADOS = 0 or ( :P189_CANCELADOS = 1 and p.datacancelamento is not null) or ( :P189_CANCELADOS = 2 and p.datacancelamento is null))
                  and ( :P189_EMDEBITO = 0 or ( :P189_EMDEBITO = 1 and p.saldo_vencimento > 0) or ( :P189_EMDEBITO = 2 and p.saldo_vencimento = 0))
                  and ( :P189_APROVADO = 0 or ( :P189_APROVADO = 1 and p.idsituacaoentrega > 20000) or ( :P189_APROVADO = 2 and p.idsituacaoentrega <= 20000))
                  and ( :P189_POSSUI_TAREFA = 0 or ( :P189_POSSUI_TAREFA = 1 and p.idtarefa is not null) or ( :P189_POSSUI_TAREFA = 2 and p.idtarefa is null))
                  and (:P189_PEDIDOFEITOPOR = 'T' or (:P189_PEDIDOFEITOPOR = 'C' and not exists ( select 1
                                                                    from classificacoespedidos cp
                                                                    where cp.idpedido = p.idpedido
                                                                      and cp.idcaracteristicapedido = 2 ) )  -- Não listar pedidos que distribuidor fez para consultora
                    or (:P189_PEDIDOFEITOPOR = 'D' and exists ( select 1
                                                                from classificacoespedidos cp
                                                                where cp.idpedido = p.idpedido
                                                                  and cp.idcaracteristicapedido = 2 ) ) ) -- Listar pedidos que distribuidor fez para consultora     
                  and ( :P189_TIPO_PEDIDO = 0 or 
                      ( :P189_TIPO_PEDIDO = 1 and p.tipopedido = 'P') or 
                      ( :P189_TIPO_PEDIDO = 2 and p.tipopedido = 'T') or 
                      ( :P189_TIPO_PEDIDO = 3 and p.tipopedido = 'V') or 
                      ( :P189_TIPO_PEDIDO = 4 and p.tipopedido = 'R' and nvl(p.idfilialfavoritaorig,p.idfilialfavorita) in (select regexp_substr(:P189_IDFILIALFAVORITA, '[^:]+', 1, level) 
                                                                                                                              from dual connect by level <= regexp_count(:P189_IDFILIALFAVORITA, ':') + 1)))
                  and ( :P189_PEDIDOCREDEV is null or ( :P189_PEDIDOCREDEV = 'N' and not exists ( select 1
                                                                                                  from classificacoespedidos c
                                                                                                  where c.idpedido = p.idpedido
                                                                                                    and c.idcaracteristicapedido = 8
                                                                                                    and c.idvalorcaracteristica = 25 ) )
                                                   or ( :P189_PEDIDOCREDEV = 'S' and exists ( select 1
                                                                                              from classificacoespedidos c
                                                                                              where c.idpedido = p.idpedido
                                                                                                and c.idcaracteristicapedido = 8
                                                                                                and c.idvalorcaracteristica = 25 ) ) or ( :P189_PEDIDOCREDEV = 'C' ))
                  and ( :P189_PEDIDOSZERADOS = 'T' or ( :P189_PEDIDOSZERADOS = 'S' and p.valorapagar_vencimento = 0  ) or ( :P189_PEDIDOSZERADOS = 'N' and p.valorapagar_vencimento != 0 ))
                  and ( nvl(:P189_LIVE,'0') = '0'   -- Filtro Live (0 = Todos)
                      or ( :P189_LIVE = '1' and exists ( select 1 from favorita.classificacoespedidos cl where cl.idpedido = p.idpedido and cl.idcaracteristicapedido = 128 ) )
                      or ( :P189_LIVE = '2' and not exists ( select 1 from favorita.classificacoespedidos cl where cl.idpedido = p.idpedido and cl.idcaracteristicapedido = 128 ) ) )
                  and ( :P189_PEDIDOFEITOPOR = 'T' or (:P189_PEDIDOFEITOPOR = p.pedido_feito_por ))
                  and ( :P189_FEITOPOR_ENTREGUEPOR = 'T' or (:P189_FEITOPOR_ENTREGUEPOR = p.feitopor_entreguepor))
                group by p.mesemissao, p.idfilialfavorita, p.filialfavorita, p.FeitoEntregue, p.tipopedido, p.filialfavoritaorig
                ```
        }
