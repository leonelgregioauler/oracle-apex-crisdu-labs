    button buscar (
        buttonName: BUSCAR
        label: Buscar
        layout {
            sequence: 200
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction mostra-filial-favorita (
        name: mostra filial favorita
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P189_PORFILIAIS
        }
        clientSideCondition {
            type: item=value
            item: P189_PORFILIAIS
            value: L
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P189_IDFILIALFAVORITA
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P189_IDFILIALFAVORITA
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction set-value-idfilialfavorita (
        name: set value idfilialfavorita
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P189_IDFILIALFAVORITA
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select regexp_substr(:P189_IDFILIALFAVORITA, '[^:]+', 1, level) 
                                                            from dual
                                                          connect by level <= regexp_count(:P189_IDFILIALFAVORITA, ':') + 1
                    ```
                itemsToSubmit: P189_IDFILIALFAVORITA
            }
            affectedElements {
                selectionType: items
                items: P189_SELFILIAIS
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo-bairro (
        name: Tipo Bairro
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P189_PESQUISAR_POR
        }
        clientSideCondition {
            type: item=value
            item: P189_PESQUISAR_POR
            value: B
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P189_BAIRRO
            }
            execution {
