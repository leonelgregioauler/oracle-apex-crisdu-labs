    region emissão-resumido-por-mês-com-express (
        name: Emissão Resumido Por Mês Com Express
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select filialfavorita
                     , sum(conta) Quantidade
                     , sum(valortotal) valortotal
                     , sum(valorapagar) valorapagar
                     , sum(valorapagarconv) valorapagarconv
                     , MesEmissao
                     , FeitoEntregue
                from (
                 -- nao vendedor "Consumidor Final"
                select case when p.tipopedido = 'R' then
                                 pck_util_fav.fnc_nomefilialfavorita(p.idfilialfavoritaorig) 
                            else
                            pck_util_fav.fnc_nomefilialfavorita(p.idfilialfavorita)
                       end filialfavorita
                     , count(1) conta
                     , sum(p.valortotal) valortotal
                     , sum(sd.valorapagar) valorapagar
                     -- Ajuste para não converter valor a pagar de Ponta Porã
                     , case when p.idfilialfavorita = 109 then
                            sum(sd.valorapagar * 1)
                       else
                           sum(sd.valorapagar * p.fatorconversao) 
                       end valorapagarconv
                --     , sum(sd.valorapagar * p.fatorconversao) valorapagarconv
                     , to_char(p.dataemissao,'MM/RRRR') MesEmissao
                     , pck_util_fav.fnc_obter_forma_entrega_pedido( p.idpedido ) FeitoEntregue
                from pedidos p
                   , ( select sum(v.valorpagar - v.valorpago) saldo
                            , sum(v.valorpagar) valorapagar
                            , v.idpedido
                       from vencimentospedidos v
                       where v.situacaovencimento = 'V'
                         and v.valorpago         <= v.valorpagar
                       group by idpedido ) sd
                where p.idpedido = sd.idpedido(+)
                  and p.idvendedora not in (2363887,2386265,2398240,2422007,2674982) -- Consumidor Final
                  and ( :P189_FORMAPAGAMENTO = -1 or exists ( select 1
                                                             from classificacoespedidos c
                                                             where c.idpedido = p.idpedido
                                                               and c.idcaracteristicapedido = 8
                                                               and c.idvalorcaracteristica = :P189_FORMAPAGAMENTO ) )
                  and trunc(p.dataemissao) between to_date(:P189_DATAINICIO,'DD/MM/RRRR') and to_date(:P189_DATAFIM,'DD/MM/RRRR')
                  and :P189_TIPORELATORIO = 'Z'
                  and nvl(p.valortotal,0) > 0
                  and (:P189_IDFILIALFAVORITA is null and :P189_PORFILIAIS = 'T' and exists ( select 1
                                                                                                from filiaisfavorita ff
                                                                                               where ff.idfilialfavorita = p.idfilialfavorita
                                                                                                 and ff.ativo = 'S'
                                                                                                 and p.tipopedido <> 'R'
                                                                                                 and ff.tipofilial IN ('L','C') 
                                                                                               union
                                                                                              select 1
                                                                                                from filiaisfavorita ff
                                                                                               where ff.idfilialfavorita = p.idfilialfavoritaorig
                                                                                                 and ff.ativo = 'S'
                                                                                                 and p.tipopedido = 'R'
                                                                                                 and ff.tipofilial IN ('L','C') ) 
                          OR ( p.tipopedido <> 'R' and p.idfilialfavorita in (select regexp_substr(:P189_IDFILIALFAVORITA, '[^:]+', 1, level) 
                                                        from dual
                                                     connect by level <= regexp_count(:P189_IDFILIALFAVORITA, ':') + 1) and :P189_PORFILIAIS = 'L' )
                          and exists ( select 1
                                         from filiaisfavorita f
                                        where f.idfilialfavorita = p.idfilialfavorita
                                          and p.tipopedido <> 'R'
                                          and f.tipofilial IN ('L','C')
                                          and f.ativo      = 'S' 
                                       union
                                       select 1
                                         from filiaisfavorita f
                                        where f.idfilialfavorita = p.idfilialfavoritaorig
                                          and p.tipopedido = 'R'
                                          and f.tipofilial IN ('L','C')
                                          and f.ativo      = 'S' )
                          OR ( p.tipopedido = 'R' and p.idfilialfavoritaorig in (select regexp_substr(:P189_IDFILIALFAVORITA, '[^:]+', 1, level) 
                                                          from dual
                                                          connect by level <= regexp_count(:P189_IDFILIALFAVORITA, ':') + 1) and  :P189_PORFILIAIS = 'L' ) )
                  and ( :P189_PESQUISAR_POR = 'A'
                      or ( :P189_PESQUISAR_POR = 'B' and exists ( select 1
                                                                  from pessoas pp
                                                                     , vendedoras v
                                                                  where pp.idpessoa = v.idpessoa
                                                                    and v.idvendedora = p.idvendedora
                                                                    and trim(upper(pp.bairro)) like '%'||upper(:P189_BAIRRO)||'%' ) )
                      or ( :P189_PESQUISAR_POR = 'C' and exists ( select 1
                                                                  from pessoas pp
                                                                     , vendedoras v
                                                                  where pp.idpessoa = v.idpessoa
                                                                    and v.idvendedora = p.idvendedora
                                                                    and pp.idcidade = :P189_IDCIDADE ) ) )
                  and ( :P189_CANCELADOS = 0 
                      or ( :P189_CANCELADOS = 1 and p.datacancelamento is not null)
                      or ( :P189_CANCELADOS = 2 and p.datacancelamento is null))
                  and ( :P189_EMDEBITO = 0 
                      or ( :P189_EMDEBITO = 1 and sd.saldo > 0)
                      or ( :P189_EMDEBITO = 2 and sd.saldo = 0))
                  and ( :P189_APROVADO = 0 
                      or ( :P189_APROVADO = 1 and p.idsituacaoentrega > 20000)
                      or ( :P189_APROVADO = 2 and p.idsituacaoentrega <= 20000))
                  and ( :P189_POSSUI_TAREFA = 0 
                      or ( :P189_POSSUI_TAREFA = 1 and p.idtarefa is not null)
                      or ( :P189_POSSUI_TAREFA = 2 and p.idtarefa is null))
                  and (:P189_PEDIDOFEITOPOR = 'T' 
                    or (:P189_PEDIDOFEITOPOR = 'C' and not exists ( select 1
                                                                    from classificacoespedidos cp
                                                                    where cp.idpedido = p.idpedido
                                                                      and cp.idcaracteristicapedido = 2 ) )  -- Não listar pedidos que distribuidor fez para consultora
                    or (:P189_PEDIDOFEITOPOR = 'D' and exists ( select 1
                                                                from classificacoespedidos cp
                                                                where cp.idpedido = p.idpedido
                                                                  and cp.idcaracteristicapedido = 2 ) ) ) -- Listar pedidos que distribuidor fez para consultora     
                  and ( :P189_TIPO_PEDIDO = 0 
                      or ( :P189_TIPO_PEDIDO = 1 and p.tipopedido = 'P')
                      or ( :P189_TIPO_PEDIDO = 2 and p.tipopedido = 'T')
                      or ( :P189_TIPO_PEDIDO = 3 and p.tipopedido = 'V')
                      or ( :P189_TIPO_PEDIDO = 4 and p.tipopedido = 'R' /*and p.idfilialfavoritaorig in (select regexp_substr(:P189_IDFILIALFAVORITA, '[^:]+', 1, level) 
                                                                                                         from dual connect by level <= regexp_count(:P189_IDFILIALFAVORITA, ':') + 1)*/))
                  and ( :P189_PEDIDOCREDEV = 'T' or ( :P189_PEDIDOCREDEV = 'N' and not exists ( select 1
                                                                                                  from classificacoespedidos c
                                                                                                  where c.idpedido = p.idpedido
                                                                                                    and c.idcaracteristicapedido = 8
                                                                                                    and c.idvalorcaracteristica = 25 ) )
                                                   or ( :P189_PEDIDOCREDEV = 'S' and exists ( select 1
                                                                                              from classificacoespedidos c
                                                                                              where c.idpedido = p.idpedido
                                                                                                and c.idcaracteristicapedido = 8
                                                                                                and c.idvalorcaracteristica = 25 ) )
                                                   or ( :P189_PEDIDOCREDEV = 'C' ))    
                  and ( :P189_PEDIDOSZERADOS = 'T' or ( :P189_PEDIDOSZERADOS = 'S' and sd.valorapagar = 0  )
                                                     or ( :P189_PEDIDOSZERADOS = 'N' and sd.valorapagar != 0 ))
                  and ( nvl(:P189_LIVE,'0') = '0'   -- Filtro Live (0 = Todos)
                      or ( :P189_LIVE = '1' and exists ( select 1 from favorita.classificacoespedidos cl where cl.idpedido = p.idpedido and cl.idcaracteristicapedido = 128 ) )
                      or ( :P189_LIVE = '2' and not exists ( select 1 from favorita.classificacoespedidos cl where cl.idpedido = p.idpedido and cl.idcaracteristicapedido = 128 ) ) )
                    and (    :P189_PEDIDOFEITOPOR = 'T' 
                         or (:P189_PEDIDOFEITOPOR = 'L' and favorita.pck_util_fav.fnc_obter_forma_entrega_pedido(p.idpedido) in ('Loja / Distribuidor','Loja / Delivery','Loja / Em mãos') )
                         or (:P189_PEDIDOFEITOPOR = 'D' and favorita.pck_util_fav.fnc_obter_forma_entrega_pedido(p.idpedido) in ('Pedido Feito Pelo Distribuidor (Antigo)','Distribuidor / Distribuidor','Distribuidor / Sem acerto') )
                         or (:P189_PEDIDOFEITOPOR = 'C' and favorita.pck_util_fav.fnc_obter_forma_entrega_pedido(p.idpedido) in ('Consultora / Sem acerto','Consultora / Em mãos','Pedido Feito Pela Consultora (Antigo)','Consultora / Delivery') ))
                    and (    :P189_FEITOPOR_ENTREGUEPOR = 'T'
                         or (:P189_FEITOPOR_ENTREGUEPOR = 'CM' and favorita.pck_util_fav.fnc_obter_forma_entrega_pedido(p.idpedido) = 'Consultora / Em mãos')
                         or (:P189_FEITOPOR_ENTREGUEPOR = 'DD' and favorita.pck_util_fav.fnc_obter_forma_entrega_pedido(p.idpedido) = 'Distribuidor / Distribuidor')
                         or (:P189_FEITOPOR_ENTREGUEPOR = 'LD' and favorita.pck_util_fav.fnc_obter_forma_entrega_pedido(p.idpedido) = 'Loja / Distribuidor')
                         or (:P189_FEITOPOR_ENTREGUEPOR = 'LDD' and favorita.pck_util_fav.fnc_obter_forma_entrega_pedido(p.idpedido) = 'Loja / Delivery')
                         or (:P189_FEITOPOR_ENTREGUEPOR = 'LE' and favorita.pck_util_fav.fnc_obter_forma_entrega_pedido(p.idpedido) = 'Loja / Em mãos')
                         or (:P189_FEITOPOR_ENTREGUEPOR = 'DS' and favorita.pck_util_fav.fnc_obter_forma_entrega_pedido(p.idpedido) = 'Distribuidor / Sem acerto')
                         or (:P189_FEITOPOR_ENTREGUEPOR = 'CS' and favorita.pck_util_fav.fnc_obter_forma_entrega_pedido(p.idpedido) = 'Consultora / Sem acerto')
                         or (:P189_FEITOPOR_ENTREGUEPOR = 'CD' and favorita.pck_util_fav.fnc_obter_forma_entrega_pedido(p.idpedido) = 'Pedido Feito Pelo Distribuidor (Antigo)')
                         or (:P189_FEITOPOR_ENTREGUEPOR = 'CY' and favorita.pck_util_fav.fnc_obter_forma_entrega_pedido(p.idpedido) = 'Consultora / Delivery'))
                group by to_char(p.dataemissao,'MM/RRRR')
                       , p.idfilialfavorita
                       , pck_util_fav.fnc_obter_forma_entrega_pedido( p.idpedido )
                       , p.idfilialfavoritaorig
                       , p.tipopedido
                union 
                -- Apenas filial favorita: Estoque Belém, onde "Usuário Digitou Pedido(caracteristica)"
                select favorita.pck_util_fav.fnc_nomefilialfavorita(y.idfilialfavoritausu) filialfavorita
                     , count(1) conta
                     , sum(y.valortotal)  valortotal
                     , sum(y.valorapagar) valorapagar
                     , sum(y.valorapagar * y.fatorconversao) valorapagarConv
                     , to_char(y.dataemissao,'MM/RRRR') MesEmissao
                     , favorita.pck_util_fav.fnc_obter_forma_entrega_pedido( y.idpedido ) FeitoEntregue
                from (
                select p.idpedido
                     , u.idfilialfavorita idfilialfavoritausu 
                     , p.dataemissao
                     , p.dataentrega
                     , p.valortotal
                     , p.valorapagar valorapagar
                     , p.fatorconversao
                from favorita.pedidos p
                   , usuarios u
                   , ( select sum(v.valorpagar - v.valorpago) saldo
                            , sum(v.valorpagar) valorapagar
                            , v.idpedido
                       from favorita.vencimentospedidos v
                       where v.situacaovencimento = 'V'
                         and v.valorpago         <= v.valorpagar
                       group by idpedido ) sd
                where p.idpedido = sd.idpedido(+)
                  and u.idusuario = p.idusuario
                  and ( :P189_IDFILIALFAVORITA is null
                        or :P189_IDFILIALFAVORITA = u.idfilialfavorita )
                  and ( :P189_FORMAPAGAMENTO = -1 or exists ( select 1
                                                             from favorita.classificacoespedidos c
                                                             where c.idpedido = p.idpedido
                                                               and c.idcaracteristicapedido = 8
                                                               and c.idvalorcaracteristica = :P189_FORMAPAGAMENTO ) )
                  and ( :P189_PEDIDOCREDEV = 'T' or ( :P189_PEDIDOCREDEV = 'N' and not exists ( select 1
                                                                                                  from favorita.classificacoespedidos c
                                                                                                  where c.idpedido = p.idpedido
                                                                                                    and c.idcaracteristicapedido = 8
                                                                                                    and c.idvalorcaracteristica = 25 ) )
                                                   or ( :P189_PEDIDOCREDEV = 'S' and exists ( select 1
                                                                                              from favorita.classificacoespedidos c
                                                                                              where c.idpedido = p.idpedido
                                                                                                and c.idcaracteristicapedido = 8
                                                                                                and c.idvalorcaracteristica = 25 ) )
                                                   or ( :P189_PEDIDOCREDEV = 'C' ))
                  and trunc(p.dataemissao) between to_date(:P189_DATAINICIO,'DD/MM/RRRR') and to_date(:P189_DATAFIM,'DD/MM/RRRR')
                  and :P189_TIPORELATORIO = 'Z'
                  and nvl(p.valortotal,0) > 0
                  and p.idfilialfavorita = 6 -- estoque belem
                  and exists ( select 1
                               from favorita.classificacoespedidos cp
                                  , usuarios u
                               where cp.idcaracteristicapedido = 81 -- Usuário Digitou Pedido
                                 and u.idusuario = cp.idusuario
                                 and u.usuario like '%DELIVERY%'
                                 and cp.idpedido               = p.idpedido )
                  and ( :P189_PESQUISAR_POR = 'A'
                      or ( :P189_PESQUISAR_POR = 'B' and exists ( select 1
                                                                  from pessoas pp
                                                                     , vendedoras v
                                                                  where pp.idpessoa = v.idpessoa
                                                                    and v.idvendedora = p.idvendedora
                                                                    and trim(upper(pp.bairro)) like '%'||upper(:P189_BAIRRO)||'%' ) )
                      or ( :P189_PESQUISAR_POR = 'C' and exists ( select 1
                                                                  from pessoas pp
                                                                     , vendedoras v
                                                                  where pp.idpessoa = v.idpessoa
                                                                    and v.idvendedora = p.idvendedora
                                                                    and pp.idcidade = :P189_IDCIDADE ) ) )
                  and ( :P189_CANCELADOS = 0 
                      or ( :P189_CANCELADOS = 1 and p.datacancelamento is not null)
                      or ( :P189_CANCELADOS = 2 and p.datacancelamento is null))
                  and ( :P189_EMDEBITO = 0 
                      or ( :P189_EMDEBITO = 1 and sd.saldo > 0)
                      or ( :P189_EMDEBITO = 2 and sd.saldo = 0))
                  and ( :P189_APROVADO = 0 
                      or ( :P189_APROVADO = 1 and p.idsituacaoentrega > 20000)
                      or ( :P189_APROVADO = 2 and p.idsituacaoentrega <= 20000))
                  and ( :P189_POSSUI_TAREFA = 0 
                      or ( :P189_POSSUI_TAREFA = 1 and p.idtarefa is not null)
                      or ( :P189_POSSUI_TAREFA = 2 and p.idtarefa is null))
                  and (:P189_PEDIDOFEITOPOR = 'T' 
                    or (:P189_PEDIDOFEITOPOR = 'C' and not exists ( select 1
                                                                    from favorita.classificacoespedidos cp
                                                                    where cp.idpedido = p.idpedido
                                                                      and cp.idcaracteristicapedido = 2 ) )  -- Não listar pedidos que distribuidor fez para consultora
                    or (:P189_PEDIDOFEITOPOR = 'D' and exists ( select 1
                                                                from favorita.classificacoespedidos cp
                                                                where cp.idpedido = p.idpedido
                                                                  and cp.idcaracteristicapedido = 2 ) ) ) -- Listar pedidos que distribuidor fez para consultora    
                  and ( :P189_TIPO_PEDIDO = 0 
                      or ( :P189_TIPO_PEDIDO = 1 and p.tipopedido = 'P')
                      or ( :P189_TIPO_PEDIDO = 2 and p.tipopedido = 'T')
                      or ( :P189_TIPO_PEDIDO = 3 and p.tipopedido = 'V')
                      or ( :P189_TIPO_PEDIDO = 4 and p.tipopedido = 'R' /*and p.idfilialfavoritaorig in (select regexp_substr(:P189_IDFILIALFAVORITA, '[^:]+', 1, level) 
                                                                                                         from dual
                                                                                                      connect by level <= regexp_count(:P189_IDFILIALFAVORITA, ':') + 1) */))
                  and ( :P189_PEDIDOSZERADOS = 'T' or ( :P189_PEDIDOSZERADOS = 'S' and sd.valorapagar = 0  )
                                                     or ( :P189_PEDIDOSZERADOS = 'N' and sd.valorapagar != 0 ))
                  and ( nvl(:P189_LIVE,'0') = '0'   -- Filtro Live (0 = Todos)
                      or ( :P189_LIVE = '1' and exists ( select 1 from favorita.classificacoespedidos cl where cl.idpedido = p.idpedido and cl.idcaracteristicapedido = 128 ) )
                      or ( :P189_LIVE = '2' and not exists ( select 1 from favorita.classificacoespedidos cl where cl.idpedido = p.idpedido and cl.idcaracteristicapedido = 128 ) ) )
                    and (    :P189_PEDIDOFEITOPOR = 'T' 
                         or (:P189_PEDIDOFEITOPOR = 'L' and favorita.pck_util_fav.fnc_obter_forma_entrega_pedido(p.idpedido) in ('Loja / Distribuidor','Loja / Delivery','Loja / Em mãos') )
                         or (:P189_PEDIDOFEITOPOR = 'D' and favorita.pck_util_fav.fnc_obter_forma_entrega_pedido(p.idpedido) in ('Pedido Feito Pelo Distribuidor (Antigo)','Distribuidor / Distribuidor','Distribuidor / Sem acerto') )
                         or (:P189_PEDIDOFEITOPOR = 'C' and favorita.pck_util_fav.fnc_obter_forma_entrega_pedido(p.idpedido) in ('Consultora / Sem acerto','Consultora / Em mãos','Pedido Feito Pela Consultora (Antigo)','Consultora / Delivery') ))
                    and (    :P189_FEITOPOR_ENTREGUEPOR = 'T'
                         or (:P189_FEITOPOR_ENTREGUEPOR = 'CM' and favorita.pck_util_fav.fnc_obter_forma_entrega_pedido(p.idpedido) = 'Consultora / Em mãos')
                         or (:P189_FEITOPOR_ENTREGUEPOR = 'DD' and favorita.pck_util_fav.fnc_obter_forma_entrega_pedido(p.idpedido) = 'Distribuidor / Distribuidor')
                         or (:P189_FEITOPOR_ENTREGUEPOR = 'LD' and favorita.pck_util_fav.fnc_obter_forma_entrega_pedido(p.idpedido) = 'Loja / Distribuidor')
                         or (:P189_FEITOPOR_ENTREGUEPOR = 'LDD' and favorita.pck_util_fav.fnc_obter_forma_entrega_pedido(p.idpedido) = 'Loja / Delivery')
                         or (:P189_FEITOPOR_ENTREGUEPOR = 'LE' and favorita.pck_util_fav.fnc_obter_forma_entrega_pedido(p.idpedido) = 'Loja / Em mãos')
                         or (:P189_FEITOPOR_ENTREGUEPOR = 'DS' and favorita.pck_util_fav.fnc_obter_forma_entrega_pedido(p.idpedido) = 'Distribuidor / Sem acerto')
                         or (:P189_FEITOPOR_ENTREGUEPOR = 'CS' and favorita.pck_util_fav.fnc_obter_forma_entrega_pedido(p.idpedido) = 'Consultora / Sem acerto')
                         or (:P189_FEITOPOR_ENTREGUEPOR = 'CD' and favorita.pck_util_fav.fnc_obter_forma_entrega_pedido(p.idpedido) = 'Pedido Feito Pelo Distribuidor (Antigo)')
                         or (:P189_FEITOPOR_ENTREGUEPOR = 'CY' and favorita.pck_util_fav.fnc_obter_forma_entrega_pedido(p.idpedido) = 'Consultora / Delivery'))
                              
                         ) y
                       group by favorita.pck_util_fav.fnc_nomefilialfavorita(y.idfilialfavoritausu) 
                              , to_char(y.dataemissao,'MM/RRRR') 
                              , favorita.pck_util_fav.fnc_obter_forma_entrega_pedido( y.idpedido )
                
                        /* Maicon Aimi - 9116057 - 13/09/2024
                           Implementação ajustada para atender às demandas peculiares da equipe da Favorita */
                        union
                        select f.nomefilialfavorita as filialfavorita
                             , 0                    as quantidade
                             , 0                    as valortotal
                             , 0                    as valorapagar
                             , 0                    as valorapagarconv
                             , ' - '                as mesemissao
                             , ' - '                as feitoentregue
                          from favorita.filiaisfavorita f
                         where not exists ( select 1
                                              from favorita.pedidos p
                                             where trunc(p.dataemissao) between to_date(:P189_DATAINICIO,'DD/MM/RRRR') and to_date(:P189_DATAFIM,'DD/MM/RRRR')
                                               and nvl(p.valortotal,0) > 0 
                                               and p.idfilialfavorita = f.idfilialfavorita)
                           and :P189_IDFILIALFAVORITA is null 
                           and :P189_PORFILIAIS = 'T'
                           and f.tipofilial = 'L'
                    )
                group by filialfavorita
                        , MesEmissao
                        , FeitoEntregue
                ```
        }
        layout {
            sequence: 140
            slot: body
        }
