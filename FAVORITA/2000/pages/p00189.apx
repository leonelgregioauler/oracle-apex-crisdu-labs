    pageItem P189_IDCIDADE (
        type: popupLov
        label {
            label: Cidade
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(c.nomecidade)||' - '||e.sigla d
                     , c.idcidade r
                from roman.cidades c
                   , roman.estados e
                where e.idpais = 1
                  and c.idestado = e.idestado
                order by 1
                ```
        }
        layout {
            sequence: 150
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P189_IDFILIALFAVORITA (
        type: plugin/select
        label {
            label: Filial Favorita
            alignment: left
        }
        settings {
            selectListType: multiValueSelectList
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct favorita.pck_util_fav.fnc_nomefilialfavorita(u.idfilialfavorita) showvalue
                     , u.idfilialfavorita returnvalue
                  from favorita.usuariosfiliaisfavorita u
                 where (    u.idfilialfavorita = :P0_idfilialfavorita 
                        or :P0_idusuario = u.idusuario)
                   and exists ( select 1
                                  from favorita.filiaisfavorita f
                                 where f.idfilialfavorita = u.idfilialfavorita
                                   and f.tipofilial = 'L')
                
                union
                
                select '1 - Call Center Igrejinha' showvalue
                     , 1 returnvalue
                  from dual
                 where  v('APP_USER') in ('GUILHERME','KEURIN','QUELILUMERTZ','ANTONIAN','LUIZV','EZEQUIAS','LETICIAASILVA','MARIASSILVA','HAYANES','CESARH','MAICONAIMI')
                
                union
                
                select '6 - Estoque Belem'
                     , 6
                  from dual
                 where (     v('APP_USER') in ('GUILHERME','KEURIN','QUELILUMERTZ','ANTONIAN','LUIZV','EZEQUIAS','LETICIAASILVA','MARIASSILVA','HAYANES','CESARH','MAICONAIMI')
                         or :P0_IDFILIALFAVORITA in (82,7) )
                
                union
                
                select ff.nomefilialfavorita
                     , ff.idfilialfavorita
                  from favorita.filiaisfavorita ff
                 where v('APP_USER') in ('MAICONAIMI','DIEGOPIECHO')
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P189_PORFILIAIS
        }
        layout {
            sequence: 50
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

