            action: show
            affectedElements {
                selectionType: items
                items: P189_IDCIDADE
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: buscar pedidos
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 189
                items: {
                    P189_DATAINICIO: &P189_DATAINICIO.
                    P189_DATAFIM: &P189_DATAFIM.
                    P189_TIPORELATORIO: &P189_TIPORELATORIO.
                    P189_FORMAPAGAMENTO: &P189_FORMAPAGAMENTO.
                    P189_PESQUISAR_POR: &P189_PESQUISAR_POR.
                    P189_IDCIDADE: &P189_IDCIDADE.
                    P189_BAIRRO: &P189_BAIRRO.
                    P189_CANCELADOS: &P189_CANCELADOS.
                    P189_EMDEBITO: &P189_EMDEBITO.
                    P189_APROVADO: &P189_APROVADO.
                    P189_POSSUI_TAREFA: &P189_POSSUI_TAREFA.
                    P189_TIPO_PEDIDO: &P189_TIPO_PEDIDO.
                    P189_PEDIDOFEITOPOR: &P189_PEDIDOFEITOPOR.
                    P189_PEDIDOSZERADOS: &P189_PEDIDOSZERADOS.
                    P189_PEDIDOCREDEV: &P189_PEDIDOCREDEV.
                    P189_LIVE: &P189_LIVE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

)

