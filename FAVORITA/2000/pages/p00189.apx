    region resumido-coordenação (
        name: Resumido Coordenação
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select filialfavorita
                     , count(x.numeropedido) quantidade
                     , sum(x.valortotal ) valortotal
                     , sum(x.valorapagar_vencimento) valorapagar
                     , sum(x.valorapagar_pedido_Conv) valorapagarConv
                     , x.MesEmissao
                     , x.FeitoEntregue
                     , 'CD' tipo
                from ( select 'P'||p.idpedido numeropedido
                            , p.filialfavoritausu filialfavorita
                            , p.MesEmissao
                            , p.valortotal
                            , p.valorapagar_vencimento
                            , p.valorapagar_pedido_Conv
                            , p.FeitoEntregue
                from REL_RESUMIDO_2000_189 p
                where ( :P189_IDFILIALFAVORITA is null or p.idfilialfavoritausu in ( select * from table(apex_string.split(:P189_IDFILIALFAVORITA, ':') ) ) )
                  and ( :P189_FORMAPAGAMENTO = -1 or exists ( select 1 from classificacoespedidos c where c.idpedido = p.idpedido and c.idcaracteristicapedido = 8 and c.idvalorcaracteristica = :P189_FORMAPAGAMENTO ) )
                  and ( :P189_PEDIDOCREDEV = 'T' or ( :P189_PEDIDOCREDEV = 'N' and not exists ( select 1 from classificacoespedidos c where c.idpedido = p.idpedido and c.idcaracteristicapedido = 8 and c.idvalorcaracteristica = 25 ) )
                                                   or ( :P189_PEDIDOCREDEV = 'S' and exists ( select 1 from classificacoespedidos c where c.idpedido = p.idpedido and c.idcaracteristicapedido = 8 and c.idvalorcaracteristica = 25 ) ) or ( :P189_PEDIDOCREDEV = 'C' ))
                  -- leonel
                  and trunc(p.dataemissao) between to_date(:P189_DATAINICIO,'DD/MM/RRRR') and to_date(:P189_DATAFIM,'DD/MM/RRRR')
                  and nvl(p.valortotal,0) > 0
                  and p.datacancelamento is null
                  and p.idfilialfavorita = 6 -- estoque belem
                  and exists ( select 1
                               from classificacoespedidos cp, usuarios u
                               where cp.idcaracteristicapedido = 81 -- usuario digitou o pedido
                                 and u.idusuario = cp.idusuario
                                 and u.usuario like '%DELIVERY%'
                                 and cp.idpedido               = p.idpedido )
                  and ( :P189_PESQUISAR_POR = 'A'
                      or ( :P189_PESQUISAR_POR = 'B' and exists ( select 1
                                                                  from pessoas pp, vendedoras v
                                                                  where pp.idpessoa = v.idpessoa
                                                                    and v.idvendedora = p.idvendedora
                                                                    and trim(upper(pp.bairro)) like '%'||upper(:P189_BAIRRO)||'%' ) )
                      or ( :P189_PESQUISAR_POR = 'C' and exists ( select 1
                                                                  from pessoas pp, vendedoras v
                                                                  where pp.idpessoa = v.idpessoa
                                                                    and v.idvendedora = p.idvendedora
                                                                    and pp.idcidade = :P189_IDCIDADE ) ) )
                  and ( :P189_CANCELADOS = 0 or ( :P189_CANCELADOS = 1 and p.datacancelamento is not null) or ( :P189_CANCELADOS = 2 and p.datacancelamento is null))
                  and ( :P189_EMDEBITO = 0 or ( :P189_EMDEBITO = 1 and p.saldo_vencimento > 0) or ( :P189_EMDEBITO = 2 and p.saldo_vencimento = 0))
                  and ( :P189_APROVADO = 0 or ( :P189_APROVADO = 1 and p.idsituacaoentrega > 20000) or ( :P189_APROVADO = 2 and p.idsituacaoentrega <= 20000))
                  and ( :P189_POSSUI_TAREFA = 0 or ( :P189_POSSUI_TAREFA = 1 and p.idtarefa is not null) or ( :P189_POSSUI_TAREFA = 2 and p.idtarefa is null))
                  and (:P189_PEDIDOFEITOPOR = 'T' 
