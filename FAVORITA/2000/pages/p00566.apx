page 566 (
    name: Selecionar Perfil
    title: Trocar Perfil de Atendimento
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 400
        height: 300
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region escolha-o-perfil (
        name: Escolha o Perfil
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P566_IDPERFILATENDIMENTO (
        type: selectList
        label {
            label: Perfil Atendimento
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pe.descricao || ' - ' || pv.descricao||' - '||pa.ididioma display_value
                     , pa.idperfilatendimento return_value
                  from PERFISATENDIMENTOS         pa
                     , PERFISVENDAS               pv
                     , PERFIS                     pe
                 where pa.idperfilvenda       = pv.idperfilvenda
                   and pv.idperfil            = pe.idperfil
                   and pe.ativo               = 'S'
                ```
        }
        layout {
            sequence: 10
            region: @escolha-o-perfil
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: expression
            plsqlExpression: :P0_IDPERFILATENDIMENTO
        }
        security {
            encryptSessionState: false
        }
    )

    button salvarperfil (
        buttonName: SALVARPERFIL
        label: Salvar Perfil
        layout {
            sequence: 20
            region: @escolha-o-perfil
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process fechajanela (
        name: FechaJanela
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 99932320533114013
        }
    )

    process grava-perfil (
        name: Grava_Perfil
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                
                 :P0_IDPERFILATENDIMENTO := :P566_IDPERFILATENDIMENTO;
                 
                 update usuariosperfisatendimentos
                    set idperfilatendimento = :P566_IDPERFILATENDIMENTO
                  where idusuarioperfilatend = (select max(idusuarioperfilatend)
                                                  from usuariosperfisatendimentos
                                                 where idusuario = :P0_IDUSUARIO) ;
                
                 -- sempre deve achar um registro pois é inserido no login.
                 -- se por algum motivo não achar, deixar gerar o erro em tela.
                 
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 99932258243114012
        }
        serverSideCondition {
            whenButtonPressed: @salvarperfil
        }
    )

)

