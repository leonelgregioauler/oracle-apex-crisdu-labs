page 341 (
    name: Relatório de Movimentações Manuais de Venda Direta
    title: Relatório de Movimentações Manuais de Venda Direta
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region relatório-de-movimentações-manuais-de-venda-direta (
        name: Relatório de Movimentações Manuais de Venda Direta
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idmovimentoestoque
                     , idestoque
                     , idfilialfavorita
                     , filialfavorita
                     , datamovimento
                     , idusuario
                     , nomeusuario
                     , idproduto
                     , nomeproduto
                     , idprodutodetalhado
                     , nomeprodutodetalhado
                     , iditempedido
                     , iditemcompratransf
                     , tipomovimentacao
                     , quantidade
                from vw_movimentosestoques_fav mf
                where ididioma         = :P0_IDIDIOMA
                  and mf.iditempedido is null 
                  and mf.iditemcompratransf is null
                  and ( :P341_IDFILIALFAVORITA is null or idfilialfavorita = :P341_IDFILIALFAVORITA)
                  and ( :P341_IDPRODUTO is null or idproduto = :P341_IDPRODUTO )
                  and ( :P341_IDPRODUTODETALHADO is null or idprodutodetalhado = :P341_IDPRODUTODETALHADO )
                  and ( :P341_IDUSUARIO is null or idusuario = :P341_IDUSUARIO )
                  and ( :P341_IDFORNECEDOR IS NULL or exists ( select 1 
                                                              from fornecedoresprodutos f
                                                              where f.idproduto = mf.idproduto
                                                                and f.idfornecedor = :P341_IDFORNECEDOR ) )
                ```
            pageItemsToSubmit: P341_IDFILIALFAVORITA
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 1439286435828188531
        }

