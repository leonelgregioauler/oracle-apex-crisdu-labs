            lov: @lov-produtosdetalhados
            nullDisplayValue: - Selecione o Produto -
        }
        layout {
            sequence: 40
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P341_IDUSUARIO (
        type: plugin/select
        label {
            label: Usuáro
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeusuario(u.idusuario) display_value
                     , u.idusuario return_value
                from usuarios u
                where exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.usuario = u.usuario 
                                 and ug.idgrupoatendimento in ( select uu.idgrupoatendimento
                                                                from roman.usuariosgruposatendimento uu
                                                                where uu.usuario = v('APP_USER') ) ) 
                 or pck_util_fav.fnc_verificaacesso(58305,:P0_IDUSUARIO) = 'S'                                                
                order by 1
                ```
            nullDisplayValue: - Selecione o Usuário -
        }
        layout {
            sequence: 60
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 70
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--primary
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button novo (
        buttonName: NOVO
        label: Movimentar Estoque
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 88
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 84
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 341
                items: {
                    P341_IDFILIALFAVORITA: &P341_IDFILIALFAVORITA.
                    P341_IDPRODUTO: &P341_IDPRODUTO.
                    P341_IDPRODUTODETALHADO: &P341_IDPRODUTODETALHADO.
                    P341_IDUSUARIO: &P341_IDUSUARIO.
                    P341_IDFORNECEDOR: &P341_IDFORNECEDOR.
                }
                action: resetPagination
            }
        }
    )

)

