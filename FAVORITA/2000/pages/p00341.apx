    pageItem P341_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Estoque Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) display_value
                     , idfilialfavorita   return_value
                from filiaisfavorita f
                where exists ( select 1
                               from usuariosfiliaisfavorita u
                               where u.idfilialfavorita = f.idfilialfavorita
                                 and u.consultar = 'S'
                                 and u.idusuario = :P0_IDUSUARIO )
                order by 1
                ```
            nullDisplayValue: "- Selecione um estoque - "
        }
        layout {
            sequence: 20
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P341_IDFORNECEDOR (
        type: plugin/select
        label {
            label: Fornecedor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nomepessoa display_value
                     , f.idfornecedor return_value
                from pessoas p
                   , fornecedores f
                where p.idpessoa = f.idpessoa
                  and f.ativo    = 'S'
                  and exists ( select 1 
                               from fornecedoresprodutos fp
                               where fp.idfornecedor = f.idfornecedor  )
                order by 1 
                ```
            nullDisplayValue: - Selecione o Fornecedor -
        }
        layout {
            sequence: 50
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P341_IDPRODUTO (
        type: plugin/select
        label {
            label: Produto
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-produtos
            nullDisplayValue: - Selecione o Produto -
        }
        layout {
            sequence: 30
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
