page 291 (
    name: Vinculação de Regiões às Filiais
    title: Vinculação de Regiões às Filiais
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 80%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region vinculação-de-filiais-às-regiões (
        name: Vinculação de Filiais às Regiões
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idregiaofilial,
                       idfilialromance,
                       idpostoavancado,
                       idregiao,
                       idrepresentante
                  from regioesfiliais
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 3539884127745300151
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDPOSTOAVANCADO
                layout {
                    width: 200
                    sequence: 4
                }
            )

            displayColumn (
                column: @IDREPRESENTANTE
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDREGIAOFILIAL
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDFILIALROMANCE
                layout {
                    width: 200
                    sequence: 3
                }
            )

            displayColumn (
                column: @IDREGIAO
                layout {
                    width: 300
                    sequence: 2
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column IDFILIALROMANCE (
            type: selectList
            heading {
                heading: Filial Romance
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @lov-filiaisromance
                nullDisplayValue: - Selecione a Filial Romance -
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: IDFILIALROMANCE
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDPOSTOAVANCADO (
            type: selectList
            heading {
                heading: Posto Avançado
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nome as d
                         , idpostoavancado as r
                    from roman.postoavancado
                    order by 1 desc
                    ```
                nullDisplayValue: - Selecione o Posto Avançado -
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: IDPOSTOAVANCADO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDREGIAO (
            type: selectList
            heading {
                heading: Região
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nomeregiao as d,
                           idregiao as r
                      from regioes
                     order by 1
                    ```
                nullDisplayValue: - Selecione a Região -
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: IDREGIAO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDREGIAOFILIAL (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDREGIAOFILIAL
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: seq_idregiaofilial
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDREPRESENTANTE (
            type: selectList
            heading {
                heading: Distribuidor
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select roman.pck_romance.fnc_nomerepresentante(idrepresentante) display_value
                         , idrepresentante return_value
                    from representantes r
                    where r.ativo = 'S'
                      and ( :IDFILIALROMANCE is null or exists ( select 1
                                                                 from gerentes g
                                                                 where g.idgerente = r.idgerente
                                                                   and g.idfilial  = :IDFILIALROMANCE ))
                      and not exists ( select 1
                                       from gerentes g
                                       where g.idpessoa = r.idpessoa )
                    order by 1
                    ```
                nullDisplayValue: - Selecione o Distribuidor -
            }
            cascadingLov {
                parentColumns: IDFILIALROMANCE
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: IDREPRESENTANTE
                dataType: number
            }
        )

    )

    process save-interactive-grid-data (
        name: " - Save Interactive Grid Data"
        type: interactiveGridAutoRowProcessing
        editableRegion: @vinculação-de-filiais-às-regiões
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1375266944310550719
        }
    )

)

