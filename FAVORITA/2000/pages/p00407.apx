    region relatório-de-produtos-zerados-revistas-atuais-resumido (
        name: Relatório de Produtos Zerados Revistas Atuais - Resumido
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                declare
                  vpercentualfalta           number(15,2) := 0;
                  vpercentualdescontinuado   number(15,2) := 0;
                begin
                  --
                  htp.p('<table role="presentation" class="a-GV-table">');
                    
                  htp.p('  <tr role="row" class="a-GV-row cabecalho">');
                  htp.p('    <th class="a-GV-header is-readonly">Filial Favorita</th>');
                  htp.p('    <th class="a-GV-header is-readonly">Qtd SKU Geral</th>');
                  htp.p('    <th class="a-GV-header is-readonly">Qtd SKU Zerado</th>');
                  htp.p('    <th class="a-GV-header is-readonly">Percentual de Falta</th>');
                  htp.p('    <th class="a-GV-header is-readonly">Percentual de Descontinados</th>');
                  htp.p('    <th class="a-GV-header is-readonly">Qtd SKU Maior Zero</th>');
                  htp.p('  </tr>');
                  --
                  for i in ( select pck_relatorios_fav.fnc_produtoszerados ( ff.idfilialfavorita
                                                                            , 'R'
                                                                            , :P407_IDEDICAOREVISTA ) v
                             from filiaisfavorita ff
                             where tipofilial = 'E'
                             and ff.ativo     = 'S'
                             and ff.idpais    = 1
                             and :P407_TIPOVENDA in ('R', 'T')
                             union all
                             select pck_relatorios_fav.fnc_produtoszerados ( ff.idfilialfavorita
                                                                            , 'L'
                                                                            , er.idedicaorevista ) v 
                             from filiaisfavorita ff
                                , filiaisedicoesrevistas fe 
                                , edicoesrevistas er
                             where fe.idedicaorevista = er.idedicaorevista
                             and ff.idfilialfavorita  = fe.idfilialfavorita 
                             and ff.tipofilial = 'L'
                             and ff.ativo      = 'S'
                             and ff.idpais     = 1
                             and :P407_TIPOVENDA in ('L', 'T') )
                  --
                  loop
                    --      
                    htp.p('  <tr role="row" class="a-GV-row is-readonly">');
                    htp.p('    <td role="gridcell" class="a-GV-cell u-tC">'||i.v.filialfavorita||'</td>');
                    htp.p('    <td role="gridcell" class="a-GV-cell u-tC quantidadeskugeral">'||i.v.quantidadeskugeral||'</td>');
                    htp.p('    <td role="gridcell" class="a-GV-cell u-tC quantidadeskuzerado">'||i.v.quantidadeskuzerado||'</td>');
                    htp.p('    <td role="gridcell" class="a-GV-cell u-tC percentualzerado">'||to_char(i.v.percentualfalta, 'FM990D00')||'</td>');
                    htp.p('    <td role="gridcell" class="a-GV-cell u-tC">'||to_char(i.v.percentualdescontinuado, 'FM990D00')||'</td>');
                    htp.p('    <td role="gridcell" class="a-GV-cell u-tC quantidadeskumaiorzero">'||i.v.quantidadeskumaiorzero||'</td>');
                    htp.p('  </tr>');
                    --
                    htp.p('  <tr role="row" class="a-GV-row is-readonly">');
                    htp.p('    <td role="gridcell" class="a-GV-cell u-tC">-</td>');
                    htp.p('    <td role="gridcell" class="a-GV-cell u-tC">-</td>');
                    htp.p('    <td role="gridcell" class="a-GV-cell u-tC">-</td>');
                    htp.p('    <td colspan="2" role="gridcell" class="a-GV-cell u-tC totais">'||to_char(nvl(i.v.percentualfalta - i.v.percentualdescontinuado, 0))||'</td>');
                    htp.p('    <td role="gridcell" class="a-GV-cell u-tC">-</td>');
                    htp.p('  </tr>');
                  --
                  end loop;
                  --
                  htp.p('</table>');
                  
                end;
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P407_TIPORELATORIO
            value: R
        }
    )

