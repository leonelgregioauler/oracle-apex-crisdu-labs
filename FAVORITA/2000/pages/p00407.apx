    dynamicAction destacar-informações-estoque-atualizar (
        name: Destacar Informações Estoque Atualizar
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: region
            region: @relatório-de-produtos-zerados-revistas-atuais-detalhado
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $(".qtdestoque").each(function(idx) {
                        
                      var qtdestoque       = $(".qtdestoque").eq(idx).text();
                      var qtdestoqueminimo = $(".qtdestoqueminimo").eq(idx).text();
                      var qtdestoquemaximo = $(".qtdestoquemaximo").eq(idx).text();
                        
                      qtdestoque        = parseInt(qtdestoque);
                      qtdestoqueminimo  = parseInt(qtdestoqueminimo);
                      qtdestoquemaximo  = parseInt(qtdestoquemaximo);
                       
                      if ( qtdestoque > qtdestoquemaximo ) {
                        $(this).closest("td").addClass( "verde" );
                      } else if ( (qtdestoque < qtdestoqueminimo) && (qtdestoque > 0) ) {
                        $(this).closest("td").addClass( "laranja" ); 
                      } else if ( qtdestoque === 0 ) {
                        $(this).closest("td").addClass( "vermelho" );  
                      }
                      
                    });
                    
                    
                    $(".produto").each(function(idx) {
                      
                      var descontinuado    = $(".descontinuado").eq(idx).text();
                        
                      if ( descontinuado == 'S' ) {
                        $(this).closest("td").addClass( "azul" );
                      }
                      
                    });
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction destacar-informações-estoque-detalhado (
        name: Destacar Informações Estoque Detalhado
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $(".qtdestoque").each(function(idx) {
                        
                      var qtdestoque       = $(".qtdestoque").eq(idx).text();
                      var qtdestoqueminimo = $(".qtdestoqueminimo").eq(idx).text();
                      var qtdestoquemaximo = $(".qtdestoquemaximo").eq(idx).text();
                        
                      qtdestoque        = parseInt(qtdestoque);
                      qtdestoqueminimo  = parseInt(qtdestoqueminimo);
                      qtdestoquemaximo  = parseInt(qtdestoquemaximo);
                       
                      if ( qtdestoque > qtdestoquemaximo ) {
                        $(this).closest("td").addClass( "verde" );
                      } else if ( (qtdestoque < qtdestoqueminimo) && (qtdestoque > 0) ) {
                        $(this).closest("td").addClass( "laranja" ); 
                      } else if ( qtdestoque === 0 ) {
                        $(this).closest("td").addClass( "vermelho" );  
                      }
                      
                    });
                    ```
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction destacar-informações-estoque-resumido (
        name: Destacar Informações Estoque Resumido
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $(".percentualzerado").each(function(idx) {
                        
                      var percentualzerado    = $(".percentualzerado").eq(idx).text();
                        
                      percentualzerado        = parseInt(percentualzerado);
                      
                      if ( percentualzerado >= 10 ) {
                        $(this).closest("td").addClass( "vermelho" );
                      } 
                      
                    });
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction detalhado-resumido (
        name: Detalhado / Resumido
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: items
            items: P407_TIPORELATORIO
        }
        clientSideCondition {
            type: item=value
            item: P407_TIPORELATORIO
            value: R
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P407_IDFILIALFAVORITA
                    P407_FILTRARZERADOS
                    P407_TAGS_CONTEM
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P407_IDFILIALFAVORITA
                    P407_FILTRARZERADOS
                    P407_TAGS_CONTEM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    validation filial-obrigatória (
        name: Filial Obrigatória
        execution {
            sequence: 20
        }
        validation {
            language: sql
            sqlExpression: :P407_IDFILIALFAVORITA is not null
        }
        error {
            errorMessage: Filial Favorita deve ser selecionada
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P407_TIPORELATORIO = 'D'
        }
    )

    validation tipo-de-relatório-obrigatório (
        name: Tipo de Relatório Obrigatório
        execution {
            sequence: 10
        }
        validation {
            language: sql
            sqlExpression: :P407_TIPORELATORIO is not null
        }
        error {
            errorMessage: Tipo de Relatório deve ser selecionado
        }
    )

)

