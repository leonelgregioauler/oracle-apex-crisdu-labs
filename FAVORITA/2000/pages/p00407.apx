    region relatório-de-produtos-zerados-revistas-atuais-detalhado (
        name: Relatório de Produtos Zerados Revistas Atuais - Detalhado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select er.idpais
                     , er.tipovenda
                     , pd.idprodutodetalhado
                     , pck_util_fav.fnc_nomeprodutodetalhado(pd.idprodutodetalhado, 1) as "Produto Detalhado"
                     , ( select pck_util_fav.fnc_nomecategoriasite (c.idcategoriasite, :P0_IDIDIOMA)
                         from categorias     c
                            , produtos       p
                            , produtosdetalhados prd
                         where p.idproduto           = prd.idproduto
                          and c.idcategoria          = p.idcategoria  
                          and prd.idprodutodetalhado = pd.idprodutodetalhado ) as "Catagoria Site"
                     , sum(pck_estoque_fav.fnc_estoquedisponivel(e.idestoque))  as "Qtd Disponível"
                     , ( select sum(pck_estoque_fav.fnc_estoquedisponivel(ee.idestoque)) 
                         from favorita.atendimentosestoques a
                            , favorita.estoques ee
                         where a.idfilialfavoritadestino = e.idfilialfavorita
                           and a.idfilialfavoritaorigem = ee.idfilialfavorita
                           and ee.idprodutodetalhado = pd.idprodutodetalhado) "Qtd Disponível Cd Abastecedor"
                     , sum(e.qtdestoqueminimo) as "Qtd Est Mínimo"
                     , sum(e.qtdestoquemaximo)  as "Qtd Est Máximo"
                     , nvl(( select sum(ic.quantidadecomprada)
                             from itenscomprastransferencias ic
                                , comprastransferencias ct
                             where ic.idcompratransferencia = ct.idcompratransferencia 
                             and ic.idprodutodetalhado = pd.idprodutodetalhado
                             and ct.idtipocomptransrem != 9
                             and ct.idfilialfavoritadestino = :P407_IDFILIALFAVORITA
                             and ct.idsituacao = 10 ),0) as "Qtd Comprada"
                     , nvl(( select sum(ic.quantidadecomprada)
                             from itenscomprastransferencias ic
                                , comprastransferencias ct
                             where ic.idcompratransferencia = ct.idcompratransferencia 
                             and ic.idprodutodetalhado = pd.idprodutodetalhado
                             and ct.idfilialfavoritadestino = :P407_IDFILIALFAVORITA
                             and ct.idtipocomptransrem     != 9
                             and ct.idsituacao in (0,2,3,5,7) ),0) as "Solicitaçã de transf."
                     , nvl(( select sum(ic.quantidadecomprada)
                             from itenscomprastransferencias ic
                                , comprastransferencias ct
                             where ic.idcompratransferencia = ct.idcompratransferencia 
                             and ic.idprodutodetalhado = pd.idprodutodetalhado
                             and ct.idfilialfavoritadestino = :P407_IDFILIALFAVORITA
                             and ct.idtipocomptransrem     != 9
                             and ct.idsituacao in (20, 30) ),0) as "Qtd Comprada Aguardando"
                     , nvl(( select max(ic.valorcusto)
                             from itenscomprastransferencias ic
                                , comprastransferencias ct
                             where ic.idcompratransferencia = ct.idcompratransferencia 
                             and ic.idprodutodetalhado      = pd.idprodutodetalhado
                             and ct.idfilialfavoritadestino = :P407_IDFILIALFAVORITA
                             and ct.idtipocomptransrem     != 9
                             and ct.idsituacao in (10, 20, 30) ),0) as "Valor Custo"
                     , nvl(( select sum(ic.quantidadecomprada) * max(ic.valorcusto) 
                             from itenscomprastransferencias ic
                                , comprastransferencias ct
                             where ic.idcompratransferencia = ct.idcompratransferencia 
                             and ct.idfilialfavoritadestino = :P407_IDFILIALFAVORITA
                             and ic.idprodutodetalhado      = pd.idprodutodetalhado
                             and ct.idtipocomptransrem     != 9
                             and ct.idsituacao in (10, 20, 30) ),0) as "Valor Custo Total"
                     , er.numeroedicao as "Nr Edição"
                     , er.nome as "Edição"
                     , e.idfilialfavorita
                     , pck_util_fav.fnc_nomefilialfavorita(e.idfilialfavorita) as "Filial Favorita"
                     , nvl(( select nvl('Sim','N')
                             from favorita.produtosdescontinuadospais pdc
                             where pdc.idprodutodetalhado = pd.idprodutodetalhado
                               and pdc.idpais = er.idpais
                               and pdc.idedicaorevista = er.idedicaorevista),'Não') as "Descontinuado"
                     , (select listagg(initcap(tg.nome), '<br>')
                       within group (order by initcap(tg.nome))
                       from classificacoesprodutos cfp,
                            tagsprodutos tg
                       where cfp.idtagproduto = tg.idtagproduto
                       and cfp.idprodutodetalhado = pd.idprodutodetalhado) as "Tags"
                from estoques e
                   , produtosdetedrevistas pd
                   , edicoesrevistas er
                where e.idprodutodetalhado = pd.idprodutodetalhado
                  and pd.idedicaorevista   = er.idedicaorevista 
                  and er.idedicaorevista   = :P407_IDEDICAOREVISTA
                  and trunc(sysdate) between er.datainicial and er.datafinal
                  and (:P407_TIPOVENDA = 'T' or (:P407_TIPOVENDA = 'L' and er.tipovenda = 'L')
                                             or (:P407_TIPOVENDA = 'R' and er.tipovenda = 'R') )
                  and exists ( select 1
                               from filiaisfavorita f
                               where f.idfilialfavorita = e.idfilialfavorita
                               and f.tipofilial in ('E', 'L') )
                  and ( :P407_IDFILIALFAVORITA is null or e.idfilialfavorita = :P407_IDFILIALFAVORITA )
                  
                  and ( :P407_FILTRARZERADOS = 'T' or ( (:P407_FILTRARZERADOS = 'S' and pck_estoque_fav.fnc_estoquedisponivel(e.idestoque) = 0)
                                                     or (:P407_FILTRARZERADOS = 'N' and pck_estoque_fav.fnc_estoquedisponivel(e.idestoque) > 0) ) )
                  /*Filtra as tags*/
                  and (exists (select 1
                             from classificacoesprodutos cp,
                                  table(pck_util_fav.fnc_array_to_table(:P407_TAGS_CONTEM)) tg
                             where cp.idtagproduto = tg.column_value
                             and cp.idprodutodetalhado = pd.idprodutodetalhado)
                       or :P407_TAGS_CONTEM is null)
                  and (not exists (select 1
                             from classificacoesprodutos cp,
                                  table(pck_util_fav.fnc_array_to_table(:P407_TAGS_NAO_CONTEM)) tg
                             where cp.idtagproduto = tg.column_value
                             and cp.idprodutodetalhado = pd.idprodutodetalhado)
                       or :P407_TAGS_NAO_CONTEM is null)
                group by er.idpais
                       , er.idedicaorevista
                       , er.tipovenda
                       , pd.idprodutodetalhado
                       , er.numeroedicao 
                       , er.nome
                       , e.idfilialfavorita
                
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: item=value
            item: P407_TIPORELATORIO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 52073904117325830
        }

