    region desativado (
        name: DESATIVADO
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct 
                       pck_util_fav.fnc_nomefilialfavorita(qtd1.idfilialfavorita) filialfavorita
                     , sum(distinct qtd1.quantidadeskugeral)     quantidadeskugeral
                     , sum(distinct qtd2.quantidadeskuzerado)    quantidadeskuzerado
                     , round( (sum(distinct qtd2.quantidadeskuzerado) * 100) / sum(distinct qtd1.quantidadeskugeral), 2) percentual
                     , sum(distinct qtd3.quantidadeskumaiorzero) quantidadeskumaiorzero
                from edicoesrevistas er
                   , ( select count(distinct e.idprodutodetalhado) quantidadeskugeral
                            , e.idfilialfavorita
                            , er.idpais
                            , er.tipovenda
                       from estoques e
                          , produtosdetedrevistas pdr 
                          , edicoesrevistas er
                       where pdr.idedicaorevista = er.idedicaorevista 
                       and e.idprodutodetalhado  = pdr.idprodutodetalhado
                       and er.idedicaorevista    = :P407_IDEDICAOREVISTA
                       and trunc(sysdate)        between er.datainicial and er.datafinal
                       and er.tipovenda in ( select decode(ff.tipofilial, 'E', 'R', 'L') 
                                             from filiaisfavorita ff
                                             where ff.idfilialfavorita = e.idfilialfavorita )
                       and er.idpais in ( select fil.idpais 
                                          from filiaisfavorita fil
                                          where fil.idfilialfavorita = e.idfilialfavorita )
                       and exists ( select 1
                                    from filiaisfavorita f
                                    where f.idfilialfavorita = e.idfilialfavorita
                                    and f.tipofilial in ('E', 'L') )
                       group by e.idfilialfavorita
                              , er.idpais
                              , er.tipovenda ) qtd1
                   , ( select count(distinct e.idprodutodetalhado) quantidadeskuzerado
                            , e.idfilialfavorita
                            , er.idpais
                            , er.tipovenda
                       from estoques e
                          , produtosdetedrevistas pdr
                          , edicoesrevistas er
                       where pdr.idedicaorevista = er.idedicaorevista 
                       and e.idprodutodetalhado  = pdr.idprodutodetalhado
                       and er.idedicaorevista    = :P407_IDEDICAOREVISTA
                       and trunc(sysdate)        between er.datainicial and er.datafinal
                       and pck_estoque_fav.fnc_estoquedisponivel(e.idestoque) = 0   
                       and exists ( select 1
                                    from filiaisfavorita f
                                    where f.idfilialfavorita = e.idfilialfavorita
                                    and f.tipofilial in ('E', 'L') )
                       group by e.idfilialfavorita
                              , er.idpais
                              , er.tipovenda ) qtd2
                   , ( select count(distinct e.idprodutodetalhado) quantidadeskumaiorzero
                            , e.idfilialfavorita
                            , er.idpais
                            , er.tipovenda
                       from estoques e
                          , produtosdetedrevistas pdr
                          , edicoesrevistas er
                       where pdr.idedicaorevista = er.idedicaorevista 
                       and e.idprodutodetalhado  = pdr.idprodutodetalhado
                       and er.idedicaorevista    = :P407_IDEDICAOREVISTA
                       and trunc(sysdate)        between er.datainicial and er.datafinal 
                       and pck_estoque_fav.fnc_estoquedisponivel(e.idestoque) > 0    
                       and exists ( select 1
                                    from filiaisfavorita f
                                    where f.idfilialfavorita = e.idfilialfavorita
                                    and f.tipofilial in ('E', 'L') )
                       group by e.idfilialfavorita
                              , er.idpais
                              , er.tipovenda ) qtd3
                 where qtd1.idfilialfavorita = qtd2.idfilialfavorita
                   and qtd2.idfilialfavorita = qtd3.idfilialfavorita 
                   and trunc(sysdate)       between er.datainicial and er.datafinal    
                   and er.idpais = qtd1.idpais 
                   and er.idpais = qtd2.idpais 
                   and er.idpais = qtd3.idpais
                   
                   and er.tipovenda = qtd1.tipovenda
                   and er.tipovenda = qtd2.tipovenda
                   and er.tipovenda = qtd3.tipovenda 
                   
                   and (:P407_TIPOVENDA = 'T' or (:P407_TIPOVENDA = 'L' and er.tipovenda = 'L')
                                              or (:P407_TIPOVENDA = 'R' and er.tipovenda = 'R') )
                   
                 group by qtd1.idfilialfavorita
                        , er.idpais  
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P407_TIPORELATORIO
            value: RRRRRRRR
        }
        componentAppearance {
            showNullValuesAs: -
        }
