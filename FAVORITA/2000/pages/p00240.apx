page 240 (
    name: Edições para Compra
    title: Edições para Compra
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region edições-para-compra (
        name: Edições para Compra
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "ROWID",
                "IDEDICAOREVISTA",
                "IDCOMPRATRANSFERENCIA"
                from "#OWNER#"."EDICOESREVISTASCOMPRAS"
                where idcompratransferencia = :P240_IDCOMPRATRANSFERENCIA
                ```
        }
        layout {
            sequence: 15
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhuma Edição Adicionada!
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 4
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column IDCOMPRATRANSFERENCIA (
            reportColumnQueryId: 3
            derivedColumn: N
            type: textField
            heading {
                heading: Nr Compra
                alignment: center
            }
            layout {
                sequence: 4
                columnAlignment: center
            }
            appearance {
                width: 16
            }
            default {
                type: item
                item: P240_IDCOMPRATRANSFERENCIA
            }
            advanced {
                customAttributes: readonly
            }
        )

        column IDEDICAOREVISTA (
            reportColumnQueryId: 2
            derivedColumn: N
            type: selectList
            heading {
                heading: Selecione a Edição
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select e.nome||' - '||e.numeroedicao display_value
                         , e.idedicaorevista return_value
                    from edicoesrevistas e
                    where e.liberarcompra = 'S'
                    order  by 1
                    ```
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
        )

        column ROWID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    pageItem P240_IDCOMPRATRANSFERENCIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @edições-para-compra
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button add (
        buttonName: ADD
        label: Adicionar Linha
        layout {
            sequence: 40
            region: @edições-para-compra
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.widget.tabular.addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @edições-para-compra
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 76
                items: {
                    P76_IDCOMPRATRANSFERENCIA: &P240_IDCOMPRATRANSFERENCIA.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button excluirlinha (
        buttonName: EXCLUIRLINHA
        label: Excluir
        layout {
            sequence: 20
            region: @edições-para-compra
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIRLINHA');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Salvar
        layout {
            sequence: 30
            region: @edições-para-compra
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation idedicaorevista-must-be-numeric (
        name: IDEDICAOREVISTA must be numeric
        execution {
            sequence: 20
        }
        validation {
            editableRegion: @edições-para-compra
            type: columnIsNumeric
            column: IDEDICAOREVISTA
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDEDICAOREVISTA
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @edições-para-compra
        target {
            tableName: EDICOESREVISTASCOMPRAS
            pkColumn: ROWID
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: #MRD_COUNT# registro(s) excluído(s).
        }
        advanced {
            executionMappingIdentifier: 572851732437836439
        }
        serverSideCondition {
            whenButtonPressed: @excluirlinha
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @edições-para-compra
        target {
            tableName: EDICOESREVISTASCOMPRAS
            pkColumn: ROWID
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# registro(s) atualizado(s), #MRI_COUNT# registro(s) inserido(s).
        }
        advanced {
            executionMappingIdentifier: 572851394928836437
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 240
            }
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

)

