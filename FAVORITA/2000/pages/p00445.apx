page 445 (
    name: Cadastro de TAG
    title: Cadastro de TAG
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region cadastro-de-tag (
        name: Cadastro de TAG
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P445_CONTABILIZARELATORIO (
        type: switch
        label {
            label: Contabiliza em Relatório?
            alignment: left
        }
        settings {
            useDefaults: false
            onValue: S
            onLabel: Sim
            offValue: N
            offLabel: Não
        }
        layout {
            sequence: 30
            region: @cadastro-de-tag
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P445_IDTAG (
        type: hidden
        layout {
            sequence: 10
            region: @cadastro-de-tag
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P445_MD5 (
        type: hidden
        layout {
            sequence: 40
            region: @cadastro-de-tag
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P445_NOME (
        type: textField
        label {
            label: Nome
            alignment: left
        }
        layout {
            sequence: 20
            region: @cadastro-de-tag
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 30
            region: @buttons
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P445_IDTAG is not null
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 20
            region: @buttons
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P445_IDTAG is not null
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 40
            region: @buttons
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P445_IDTAG is null
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 448
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction fechar (
        name: Fechar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @voltar
        }

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process dml-tags (
        name: Dml tags
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  --
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  #OWNER#.PCK_CADASTROS_FAV.prc_tagsprodutos(pidtagproduto         => :P445_IDTAG,
                                                             pnome                 => :P445_NOME,
                                                             pcontabilizarelatorio => :P445_CONTABILIZARELATORIO,
                                                             pmd5                  => :P445_MD5,
                                                             poperacao_dml         => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo executado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 36116825333240131
        }
    )

    process popula-formulário (
        name: Popula formulário
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  #OWNER#.PCK_CADASTROS_FAV.prc_tagsprodutos(pidtagproduto => :P445_IDTAG,
                                                             pnome         => :P445_NOME,
                                                             pcontabilizarelatorio => :P445_CONTABILIZARELATORIO,
                                                             pmd5          => :P445_MD5,
                                                             poperacao_dml => 'S');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 36117220006240135
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P445_IDTAG is not null
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 445
                items: {
                    P445_IDTAG: &P445_IDTAG.
                }
                action: resetPagination
            }
        }
    )

)

