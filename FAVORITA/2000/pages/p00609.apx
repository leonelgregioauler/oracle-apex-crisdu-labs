page 609 (
    name: Cadastro Campanhas Adimplencia
    title: Cadastro Campanhas Adimplencia
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG_26"';
    }

    region b-cadastro-de-campanhas-b (
        name: <b>Cadastro de Campanhas</b>
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P609_DATAFIM (
        type: datePickerJquery
        label {
            label: Data Fim
            alignment: left
        }
        layout {
            sequence: 40
            region: @b-cadastro-de-campanhas-b
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr
            width: 20
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: DATAFIM
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P609_DATAINICIO (
        type: datePickerJquery
        label {
            label: Data Inicio
            alignment: left
        }
        layout {
            sequence: 30
            region: @b-cadastro-de-campanhas-b
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr
            width: 20
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: DATAINICIO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P609_DESCONTO (
        type: numberField
        label {
            label: % Desconto
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 50
            region: @b-cadastro-de-campanhas-b
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 90D00
            width: 10
        }
        source {
            type: databaseColumn
            databaseColumn: DESCONTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P609_DESCONTOREP (
        type: numberField
        label {
            label: % Desconto Repr.
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 60
            region: @b-cadastro-de-campanhas-b
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 90D00
            width: 10
        }
        source {
            type: databaseColumn
            databaseColumn: DESCONTOREP
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P609_IDCAMPANHAADIMPLENCIA (
        type: hidden
        layout {
            sequence: 10
            region: @b-cadastro-de-campanhas-b
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDCAMPANHAADIMPLENCIA
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P609_IDFILIAL (
        type: selectList
        label {
            label: Franquia Romance
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-filiaisromance
        }
        layout {
            sequence: 20
            region: @b-cadastro-de-campanhas-b
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar / Voltar
        layout {
            sequence: 10
            region: @b-cadastro-de-campanhas-b
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 608
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Incluir
        layout {
            sequence: 40
            region: @b-cadastro-de-campanhas-b
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P609_IDCAMPANHAADIMPLENCIA
        }
    )

    button delete (
        buttonName: DELETE
        label: Excluir
        layout {
            sequence: 20
            region: @b-cadastro-de-campanhas-b
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: definedByDynamicAction
            executeValidations: false
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P609_IDCAMPANHAADIMPLENCIA
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar Alterações
        layout {
            sequence: 30
            region: @b-cadastro-de-campanhas-b
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P609_IDCAMPANHAADIMPLENCIA
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @delete
        }

        action native-confirm (
            action: confirm
            settings {
                message: Confirma exclusão do registro?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: DELETE
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process fetch-row-from-campanhasadimplencia (
        name: Fetch Row from CAMPANHASADIMPLENCIA
        type: autoRowFetch
        source {
            tableName: CAMPANHASADIMPLENCIA
            pkColumn: IDCAMPANHAADIMPLENCIA
            pkItem: P609_IDCAMPANHAADIMPLENCIA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1501375131251777872
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P609_IDCAMPANHAADIMPLENCIA is null then
                        select "#OWNER#"."SEQ_IDCAMPANHAADIMPLENCIA".nextval
                          into :P609_IDCAMPANHAADIMPLENCIA
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1501375591974777873
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-campanhasadimplencia (
        name: Process Row of CAMPANHASADIMPLENCIA
        type: autoRowProcessing
        target {
            tableName: CAMPANHASADIMPLENCIA
            pkColumn: IDCAMPANHAADIMPLENCIA
            pkItem: P609_IDCAMPANHAADIMPLENCIA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 1501375967403777873
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 1501376368913777873
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 608
            }
        }
    )

)

