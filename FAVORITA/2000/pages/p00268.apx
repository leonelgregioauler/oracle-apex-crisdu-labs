page 268 (
    name: Prêmios Favorita
    title: Prêmios Favorita
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='Deseja realmente gerar um novo lote de números? - Este procedimento é realizado apenas uma vez a cada sorteio';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region lote (
        name: Lote
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region prêmios-favorita (
        name: Prêmios Favorita
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select sn.numerorandomico
                     , sn.idpedido
                     , pck_util_fav.fnc_nomevendedora(p.idvendedora) vendedora
                     , sn.lote
                  from pedidos p
                     , sorteionumeros sn
                 where p.idpedido(+) = sn.idpedido
                  
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 2309885603902830083
        }

        column IDPEDIDO (
            type: plainText
            heading {
                heading: Pedido
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column LOTE (
            type: plainText
            heading {
                heading: Lote
                alignment: center
            }
            layout {
                sequence: 22
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        column NUMERORANDOMICO (
            type: plainText
            heading {
                heading: Número Randômico
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column VENDEDORA (
            type: plainText
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 12
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 7715740 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn IDPEDIDO (
                sequence: 2
            )

            displayColumn LOTE (
                sequence: 3
            )

            displayColumn NUMERORANDOMICO (
                sequence: 1
            )

            displayColumn VENDEDORA (
                sequence: 4
            )

        )

    )

    region resultado (
        name: Resultado
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P268_MENSAGEM
        }
    )

    region resultado-2 (
        name: Resultado
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @lote
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P268_DATAFINAL (
        type: datePickerJquery
        label {
            label: Vigência Final
            alignment: left
        }
        layout {
            sequence: 20
            region: @lote
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P268_DATAINICIAL (
        type: datePickerJquery
        label {
            label: Vigência Inicial
            alignment: left
        }
        layout {
            sequence: 10
            region: @lote
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P268_LOTE (
        type: selectList
        label {
            label: Lote
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct 
                       lote as d
                     , lote as r
                from sorteionumeros
                order by 1;
                ```
            nullDisplayValue: - Selecione o lote -
        }
        layout {
            sequence: 20
            region: @resultado-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P268_MENSAGEM (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 10
            region: @resultado
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P268_NUMEROSORTEADO (
        type: numberField
        label {
            label: Número sorteado
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 10
            region: @resultado-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button gerarnumeros (
        buttonName: GERARNUMEROS
        label: Gerar Números
        layout {
            sequence: 30
            region: @lote
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--danger
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-refresh fa-spin
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'GERARNUMEROS');
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button resultado (
        buttonName: RESULTADO
        label: Resultado
        layout {
            sequence: 30
            region: @resultado-2
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-money
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation lote-obrigatório (
        name: LOTE obrigatório
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P268_LOTE
        }
        error {
            errorMessage: Lote deve ser informado.
            associatedItem: @P268_LOTE
        }
        serverSideCondition {
            type: request=Value
            value: RESULTADO
        }
    )

    validation numerosorteado-obrigatório (
        name: NUMEROSORTEADO obrigatório
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P268_NUMEROSORTEADO
        }
        error {
            errorMessage: Número sorteado deve ser informado.
            associatedItem: @P268_NUMEROSORTEADO
        }
        serverSideCondition {
            type: request=Value
            value: RESULTADO
        }
    )

    process gerar-números-sorteio (
        name: Gerar Números Sorteio
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vdatainicial   date;
                  vdatafinal     date;
                begin
                  if v('REQUEST') = 'GERARNUMEROS' then
                    --
                    vdatainicial            := to_date(:P268_DATAINICIAL,    'DD/MM/RRRR');
                    vdatafinal               := to_date(:P268_DATAFINAL,     'DD/MM/RRRR');
                    --
                    pck_premiosfavorita_fav.prc_geranumerossorteio (vdatainicial, vdatafinal);
                  end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Lote gerado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 771575269533484938
        }
        serverSideCondition {
            type: request=Value
            value: GERARNUMEROS
        }
    )

    process resultado (
        name: Resultado
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if v('REQUEST') = 'RESULTADO' then
                    pck_premiosfavorita_fav.prc_consultaganhador (:P268_NUMEROSORTEADO, :P268_LOTE, :P268_MENSAGEM) ;
                  end if;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 771575647979484940
        }
        serverSideCondition {
            type: request=Value
            value: RESULTADO
        }
    )

)

