page 289 (
    name: Cadastro de Datas por Regiões
    title: Cadastro de Datas por Regiões
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-de-datas-por-regiões (
        name: Cadastro de Datas por Regiões
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select iddataregiaofilial
                     , iddataremessapedido
                     , idregiao
                     , observacao
                  from datasregioesfiliais
                 where iddataremessapedido in ( select drp.iddataremessapedido
                                                 from datasremessaspedidos drp
                                                 where drp.datalimitepedido > trunc(sysdate - 30) )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 3539767687769946861
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDREGIAO
                layout {
                    width: 300
                    sequence: 3
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDDATAREGIAOFILIAL
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDDATAREMESSAPEDIDO
                layout {
                    width: 438
                    sequence: 2
                }
            )

            displayColumn (
                column: @OBSERVACAO
                layout {
                    sequence: 4
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column IDDATAREGIAOFILIAL (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDDATAREGIAOFILIAL
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: seq_iddataregiaofilial
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDDATAREMESSAPEDIDO (
            type: selectList
            heading {
                heading: Data Limite para Pedidos / Data Retorno do Distribuidor
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select datalimitepedido ||'           -           '|| dataretorno as d,
                           iddataremessapedido as r
                      from datasremessaspedidos
                     where datalimitepedido >= sysdate - 30
                     order by datalimitepedido
                            , dataretorno
                    ```
                nullDisplayValue: - Selecione -
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                databaseColumn: IDDATAREMESSAPEDIDO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDREGIAO (
            type: selectList
            heading {
                heading: Região
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nomeregiao as d,
                           idregiao as r
                      from regioes
                     order by 1
                    ```
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                databaseColumn: IDREGIAO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column OBSERVACAO (
            type: textarea
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: OBSERVACAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

    )

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    button filtro (
        buttonName: FILTRO
        label: Filtrar
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-filter
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 20
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-reply
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 287
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process save-interactive-grid-data (
        name: " - Save Interactive Grid Data"
        type: interactiveGridAutoRowProcessing
        editableRegion: @cadastro-de-datas-por-regiões
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1375256064527542349
        }
    )

)

