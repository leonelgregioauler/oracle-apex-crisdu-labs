                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region ultimos-pedidos-montados (
        name: Ultimos Pedidos Montados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select numeropedido
                     , idvendedora
                     , filialromance
                     , dataclassificado
                from ( select p.numeropedido
                            , p.idvendedora
                            , p.filialromance
                            , c.dataclassificado
                       from vw_pedidos_fav p
                          , classificacoespedidos c
                       where c.idpedido  = p.idpedido
                         and p.ididioma  = :P0_IDIDIOMA
                         and c.idusuario = :P0_IDUSUARIO
                         and c.idcaracteristicapedido = 18
                         and c.dataclassificado >= trunc(sysdate)
                       order by c.dataclassificado desc )
                where rownum <= 5;
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 5
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

