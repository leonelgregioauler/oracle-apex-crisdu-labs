    process montarpedido (
        name: MONTARPEDIDO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidusuario number := :P0_IDUSUARIO;
                  vnumeropedido varchar2(100) := :P109_NUMEROPEDIDO;
                  vcodbarraspedido varchar2(100) := :P109_CODBARRASPEDIDO;
                  --
                  vidpedidoetiqueta number;
                  vidpedidofolha    number;
                  verro varchar2(1000);
                begin
                  --
                  select substr(vnumeropedido,2,length(vnumeropedido)-5)
                  into vidpedidoetiqueta
                  from dual;
                  --
                  select substr(vcodbarraspedido,2,length(vcodbarraspedido)-3)
                  into vidpedidofolha
                  from dual;
                  --
                  commit;
                  --
                  if vidusuario is null then
                    --
                    select idusuario
                    into vidusuario
                    from usuarios
                    where usuario = v('APP_USER');
                    --
                  end if;
                  -- alterado para já enviar o IDPEDIDO
                  --
                  :P109_NUMEROPEDIDO := null;
                  :P109_CODBARRASPEDIDO := null;
                  --
                  commit;
                  --
                  pck_movimentarpedidos_fav.prc_montapedidos(pidpedidofolha => vidpedidofolha,
                                                             pidpedidoetiqueta => vidpedidoetiqueta,
                                                             pidusuario => vidusuario);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 766427161434722167
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'MONTARPEDIDO'
                  and :P109_CODBARRASPEDIDO is not null
                ```
        }
    )

    branch (
        name: go to page 109
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 109
                items: {
                    P109_NUMEROPEDIDO:
                    P109_CODBARRASPEDIDO:
                }
                clearCache: 109
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: MONTARPEDIDO
        }
    )

)

