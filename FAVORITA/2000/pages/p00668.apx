        }
    )

    process recebe-iten-faltante-do-cupom (
        name: "Recebe iten faltante do cupom "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  -- 
                  viditemfaltante  number;
                  vqtdfaltante     number;
                  vidclassifbrinde number;
                  vvalidafalta     number;
                  vidusuario       number;
                  vidguia          number := :P668_GUIA;
                  vcupom           number := :P668_CUPOM;
                  --
                begin
                  -- 
                  select u.idusuario
                    into vidusuario
                  from catal.usuarios u 
                  where u.usuario =  v('APP_USER') ;
                  --
                  --Confirma o recebimento no cupom.
                  --
                  update roman.conquistoulevoucupons cl 
                  set cl.datarecebfilial = sysdate
                  where cl.datarecebfilial is null 
                    and cl.idconquistoulevoucupom = vcupom;
                  --
                  --Confirma o recebimento na guia de cupons. 
                  --
                  update roman.guiasentregascupons gec 
                  set gec.itensfaltantes = null 
                  where gec.idconquistoulevoucupom = vcupom;
                  --
                  --Busca quantidade de itens que ainda estão faltando receber.
                  --
                  select itf.iditemfaltante
                       , itf.qtdfaltante
                       , cbc.idclassifbrindeclub
                    into viditemfaltante
                       , vqtdfaltante
                       , vidclassifbrinde
                  from roman.itensfaltantes itf
                     , roman.classificacoesbrindesclub cbc 
                     , roman.itensconqlevcupons itc
                     , roman.conquistoulevoucupons clc
                  where itf.idclassifbrindeclub = cbc.idclassifbrindeclub
                    and itc.idbrindeclube = cbc.idbrindeclube
                    and clc.idconquistoulevoucupom = itc.idconquistoulevoucupom
                    and clc.idconquistoulevoucupom = vcupom;
                  --
                  --Ajusta a quantidade removendo um item que esta sendo recebido.
                  --
                  vqtdfaltante := (vqtdfaltante - 1);   
                  --
                  --Confirma o recebimento do item na tabela de itens faltantes.
                  --
                  update roman.itensfaltantes itx 
                  set itx.qtdfaltante = vqtdfaltante, itx.datarecebimento = sysdate, itx.idusuario = vidusuario
                  where itx.idclassifbrindeclub = vidclassifbrinde;
                  --
                  --Verifica se existe algum item faltante dentro da guia de entrega. 
                  --
                  begin
                    --
                    select 1
                      into vvalidafalta
                    from roman.itensfaltantes it 
                    where it.idguiaentregabrinde = vidguia
                      and it.qtdfaltante > 0 
                      and it.datarecebimento is null;
                
                   exception
                    when others then
                       vvalidafalta := 0;
                   end;
                 
                  --
                  -- Testa se existe algum brinde dentro da guia que falta recebimento. 
                  --
                  if  vqtdfaltante = 0 and  vvalidafalta = 0 then 
                    --
                    update roman.guiasentregasbrindes gb
                    set gb.datarecebimento = sysdate, gb.itensfaltantes = null
                    where gb.idguiaentregabrinde = vidguia;
                    --
                  end if; 
                  --
                  commit;
                  -- 
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1804097151372169425
        }
        serverSideCondition {
            whenButtonPressed: @receberbrinde
        }
    )

    branch (
        name: Go To Page 667
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 667
                items: {
                    P667_GUIAENVIO: &P668_GUIA.
                }
            }
        }
        serverSideCondition {
            whenButtonPressed: @voltar
        }
    )

)

