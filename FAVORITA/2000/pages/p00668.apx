page 668 (
    name: "Dados Cupom "
    title: "Dados Cupom "
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 40
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region brindes (
        name: Brindes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select b.nomebrinde 
                     , b.idbrindeclube
                     , it.qtditem 
                     , nvl(it.qtdrecebida,0) qtdrecebida
                     , (select descricao from table(catal.pck_util.fnc_siglasistema('TIPO_PRODUTO_BRINDE_CONQUISTOU_LEVOU',b.tipoproduto))) tipoproduto
                     , (select cc.nomeclassif
                        from roman.conquistoulevouclassificacoes cc
                        where cc.idclassificacao = it.idclassificacao) classificação
                     , (select cr.nomecaracteristica
                        from roman.conquistoulevoucaracteristicas cr
                        where cr.idcaracteristica = it.idcaracteristica ) característica
                from roman.brindesclub b
                   , roman.itensconqlevcupons it 
                where it.idbrindeclube = b.idbrindeclube
                  and it.idconquistoulevoucupom = :P668_CUPOM
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1803662234239703816
        }

        column CARACTERÍSTICA (
            type: plainText
            heading {
                heading: Característica
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column CLASSIFICAÇÃO (
            type: plainText
            heading {
                heading: Classificação
                alignment: center
            }
            layout {
