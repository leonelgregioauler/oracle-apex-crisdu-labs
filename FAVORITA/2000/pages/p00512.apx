    region lista-de-impressões (
        name: Lista de Impressões
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select cp.idlog
                     , cp.usuarioalteracao
                     , to_date(cp.dataalteracao,'dd/mm/rrrr hh24:mi:ss') dataimpressao
                from logfavorita.log_classificacoescomprast cp 
                where cp.idcompratransferencia = :P512_IDCOMPRATRANSFERENCIA 
                and cp.idcaracteristicacomptransf = 20 
                and cp.tipoalteracao = 'INSERT'
                union
                select cp.idlog
                     , cp.usuarioalteracao
                     , cp.dataalteracao dataimpressao
                from logfavorita.log_classificacoescomprast cp 
                where cp.idcompratransferencia = :P512_IDCOMPRATRANSFERENCIA 
                and cp.idcaracteristicacomptransf = 21 
                and cp.tipoalteracao = 'INSERT'
                order by 1 desc;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 116929958930469317
        }

        column DATAIMPRESSAO (
            type: plainText
            heading {
                heading: Dataimpressao
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            appearance {
                formatMask: dd/mm/rrrr hh24:mi:ss
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column IDLOG (
            type: plainText
            heading {
                heading: Idlog
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column USUARIOALTERACAO (
            type: plainText
            heading {
                heading: Usuarioalteracao
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 1170134 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAIMPRESSAO (
                sequence: 3
            )

            displayColumn IDLOG (
                sequence: 1
            )

            displayColumn USUARIOALTERACAO (
                sequence: 2
            )

        )

    )

    pageItem P512_IDCOMPRATRANSFERENCIA (
        type: hidden
        layout {
            sequence: 10
            region: @lista-de-impressões
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
                t-Button--iconRight
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 74
                items: {
                    P74_IDCOMPRATRANSFERENCIA: &P512_IDCOMPRATRANSFERENCIA.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

