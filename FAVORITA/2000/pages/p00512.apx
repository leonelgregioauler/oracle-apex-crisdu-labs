page 512 (
    name: Historico Compra/Transf
    title: Historico Compra/Transf
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region historico-transferencia (
        name: Historico Transferencia
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select cp.idlog,
                       cp.usuarioalteracao,
                       case 
                         when cp.tipoalteracao = 'INSERT' then
                           'Criado'
                         when cp.tipoalteracao = 'UPDATE' then
                           'Atualizado'
                         when cp.tipoalteracao = 'DELETE' then
                           'Excluido'
                         end tipoalteracao,
                       cp.dataalteracao dataalteracao,
                       cp.idcompratransferencia,
                       favorita.pck_util_fav.fnc_retornatipocomptransrem(cp.idtipocomptransrem,1) tipo,
                       favorita.pck_util_fav.fnc_retornasitcompratransf(cp.idsituacao,1) situacao,
                       favorita.pck_util_fav.fnc_nomeusuario(cp.idusuario) usuario_remessa,
                       cp.notafiscal,
                       cp.dataemissao dataemissao,
                       cp.datarecebimento datarecebimento,
                       cp.valortotalcompra,
                       cp.valortotalrecebido,
                       cp.valortotalavariado,
                       cp.cubagem,
                       cp.volume,
                       cp.peso,
                       cp.analiseconcluida
                from logfavorita.log_comprastransferencias cp
                where cp.idcompratransferencia = :P512_IDCOMPRATRANSFERENCIA
                order by 1 desc;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 116930195304469319
        }

        column ANALISECONCLUIDA (
            type: plainText
            heading {
                heading: Analise Concluída
                alignment: center
            }
            layout {
                sequence: 180
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: R
            }
        )

