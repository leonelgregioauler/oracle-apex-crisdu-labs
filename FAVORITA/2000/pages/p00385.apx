page 385 (
    name: Encerrar Evento
    title: Encerrar Evento
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG_22"';
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region encerrar-evento (
        name: Encerrar Evento
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P385_AVALCORDIALIDADE (
        type: radioGroup
        label {
            label: Com que nota você avalia a cordialidade, paciência e atenção do analista que o atendeu?
            alignment: left
        }
        settings {
            noOfCols: 4
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Excelente;E,Bom;B,Regular;R,Ruim;Z
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @encerrar-evento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: AVALCORDIALIDADE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P385_AVALIACAOATENDIMENTO (
        type: radioGroup
        label {
            label: Como você avalia a solução dada neste atendimento?
            alignment: left
        }
        settings {
            noOfCols: 4
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Excelente;E,Bom;B,Regular;R,Ruim;Z
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @encerrar-evento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: AVALIACAOATENDIMENTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P385_AVALIACAOTEMPO (
        type: radioGroup
        label {
            label: Como foi o tempo de espera para ser atendido?
            alignment: left
        }
        settings {
            noOfCols: 4
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Excelente;E,Bom;B,Regular;R,Ruim;Z
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @encerrar-evento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: AVALIACAOTEMPO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P385_DATAENCERRADO (
        type: hidden
        layout {
            sequence: 90
            region: @encerrar-evento
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: DATAENCERRADO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P385_IDCHAMADO (
        type: hidden
        layout {
            sequence: 10
            region: @encerrar-evento
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDCHAMADO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P385_IDSITUACAO (
        type: hidden
        layout {
            sequence: 80
            region: @encerrar-evento
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDSITUACAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P385_OBSERVACAOATENDIMENTO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        settings {
            charCounter: true
        }
        layout {
            sequence: 70
            region: @encerrar-evento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 2000
        }
        source {
            type: databaseColumn
            databaseColumn: OBSERVACAOATENDIMENTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button save (
        buttonName: SAVE
        label: Encerrar
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P385_IDCHAMADO
        }
    )

    process encerrar (
        name: Encerrar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  :P385_IDSITUACAO := 2; 
                  :P385_DATAENCERRADO := sysdate;
                  --
                end;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 461815044226599907
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process fetch-row-from-chamados (
        name: Fetch Row from CHAMADOS
        type: autoRowFetch
        source {
            tableOwner: ROMAN
            tableName: CHAMADOS
            pkColumn: IDCHAMADO
            pkItem: P385_IDCHAMADO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 3142000505703153603
        }
    )

    process process-row-of-chamados (
        name: Process Row of CHAMADOS
        type: autoRowProcessing
        target {
            tableOwner: ROMAN
            tableName: CHAMADOS
            pkColumn: IDCHAMADO
            pkItem: P385_IDCHAMADO
        }
        execution {
            sequence: 60
        }
        successMessage {
            successMessage: Evento encerrado!
        }
        advanced {
            executionMappingIdentifier: 3142000961770153603
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 3142001370616153603
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 157
                action: resetPagination
            }
        }
    )

)

