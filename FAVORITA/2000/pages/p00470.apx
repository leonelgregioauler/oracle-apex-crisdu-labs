page 470 (
    name: Revisar Saídas Diversas
    title: Revisar Saídas Diversas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    help {
        helpText: No help is available for this page.
    }

    region revisar-saídas (
        name: Revisar Saídas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDSAIDA
                     , IDSAIDA IDSAIDA_DISPLAY
                     , DATA
                     , VALORTOTAL
                     , DESCRICAO
                     , IDFECHAMENTO
                     , EMMAOS
                     , DECODE(s.tipo,'D','Dinheiro','O','Pagamento de Conta') TIPO
                     , IDCONTACONTABIL
                     , IDSUBCONTACONTABIL
                     , IDFILIALDEST
                     , null anexos
                     , ( select count(1)
                          from roman.anexossaidas a
                          where a.idsaida = s.idsaida ) qtdanexos
                     , case
                         when exists ( select 1
                                       from roman.subcontasfinanceiras ss
                                       where ss.idsubcontafinan = ( select sd.idsubcontacontabil
                                                                    from roman.saidasdiversas sd
                                                                    where sd.idsaida = s.idsaida ) 
                                         and ss.tipo is not null ) and s.idsubcontacontabil is not null then
                           ( select decode(s.tipo,'F','Fixa','V','Variável')
                             from roman.subcontasfinanceiras sf
                             where sf.idsubcontafinan = ( select sd.idsubcontacontabil
                                                          from roman.saidasdiversas sd
                                                          where sd.idsaida = s.idsaida ) )
                         else
                           ( select decode(c.tipo,'F','Fixa','V','Variável')
                             from roman.contasfinanceiras c
                             where c.idcontafinan = ( select se.idcontacontabil
                                                      from roman.saidasdiversas se
                                                      where se.idsaida = s.idsaida )
                               and c.tipo is not null )
                        end tiposaida
                   , null questionamento
                   , replace(replace(replace(DESCRICAO,',',' ')||' - '||replace(VALORTOTAL,',','.') ,'+',''),'-','.') questionar 
                   , OBSERVACAOCONTROLE
                   , idmatrizclassificacao
                from roman.SAIDASDIVERSAS s
                where idfechamento = :P0_IDFECHAMENTO
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 890573502996295526
        }

