        column IDMATRIZCLASSIFICACAO (
            type: selectList
            heading {
                heading: Classificação
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select ' - Sem Matriz -' d
                         , null r
                    from dual
                    union
                    select m.classificacaodespesa||' - Conta: '||( select nomeconta
                                                                   from roman.contasfinanceiras c
                                                                   where c.idcontafinan = m.idcontafinan)||' / SubConta: '||( select nomeconta
                                                                                                                              from roman.subcontasfinanceiras s
                                                                                                                              where s.idsubcontafinan = m.idsubcontafinan ) d
                         , m.idmatrizclassificacao r
                    from roman.matrizclassificacoesdespesas m
                    where  m.idfilial = :IDFILIALDEST
                      and m.ativo = 'S'
                    order by 1
                    ```
            }
            cascadingLov {
                parentColumns: IDFILIALDEST
            }
            layout {
                sequence: 200
                columnAlignment: center
            }
            source {
                databaseColumn: IDMATRIZCLASSIFICACAO
                dataType: number
            }
        )

