    region saídas-pendentes (
        name: Saídas Pendentes
        type: plugin/badgeList
        source {
            sqlQuery:
                ```sql
                select w.nomefilialfavorita
                     , count (s.idsaida) Qtd
                     , f.idfilialfavorita
                from roman.saidasdiversas s
                   , roman.fechamentossemanais f
                   , favorita.vw_filiaisfavorita w
                where f.idfilialfavorita = w.idfilialfavorita
                  and s.idfechamento = f.idfechamento
                  and nvl(s.emmaos,'N') = 'N'
                  and f.idsemana >= 909
                  and exists ( select 1
                               from catal.filiais ff
                               where ff.idfilial = f.idfilial
                                 and ff.tipofilial = 'L')
                having count(1) > 0
                group by f.idfilialfavorita,w.nomefilialfavorita
                order by 1;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: NOMEFILIALFAVORITA
            valueColumn: QTD
            linkTarget: {
                page: 470
                items: {
                    P0_IDFILIALCAIXA: &IDFILIALFAVORITA.
                    P0_IDFECHAMENTO:
                }
                action: resetPagination
            }
            layout: 5Columns
            color: yes
        }
    )

    pageItem P470_ORIGEM (
