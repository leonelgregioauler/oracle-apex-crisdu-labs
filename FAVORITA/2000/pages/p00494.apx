    button criar (
        buttonName: CRIAR
        label: Criar
        layout {
            sequence: 20
            region: @novo-cadastro
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @novo-cadastro
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 627
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction buscadados (
        name: BuscaDados
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P494_DOCUMENTOESTRANGEIRO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    
                    select p.nomepessoa
                         , (select telefonelimpo
                              from catal.telefonespessoas
                             where idtelefonepessoa = (select max(idtelefonepessoa)
                                                         from catal.telefonespessoas
                                                        where idpessoa = p.idpessoa) ) telefone
                         , p.email
                         , p.datanascimento
                         , p.enderecoprincipal
                         , p.numero
                         , p.bairro
                         , p.idcidade
                         , p.cep
                         , p.idpais
                      INTO
                       :P494_NOMECOMPLETO,
                       :P494_FONE,
                       :P494_EMAIL,
                       :P494_DATANASCIMENTO,
                       :P494_RUA,
                       :P494_NR,
                       :P494_BAIRRO,
                       :P494_IDCIDADE,
                       :P494_CEP,
                       :P494_IDPAIS
                      from catal.pessoas p
                     where p.documentoestrangeiro = REGEXP_REPLACE (:P494_DOCUMENTOESTRANGEIRO,'[^0-9A-Za-z]', '') ;
                    
                    exception
                     when others then 
                       raise_application_error(-20001,'Nenhum registro localizado para o DOCUMENTO: '||:P494_DOCUMENTOESTRANGEIRO);
                    
                    end;
                    
                    ```
                itemsToSubmit: P494_DOCUMENTOESTRANGEIRO
                itemsToReturn: [
                    P494_NOMECOMPLETO
                    P494_FONE
                    P494_EMAIL
                    P494_DATANASCIMENTO
                    P494_RUA
                    P494_BAIRRO
                    P494_NR
                    P494_CEP
                    P494_IDCIDADE
                    P494_IDPAIS
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process processo-dml-em-indicações-do-exterior (
        name: Processo DML em Indicações do Exterior
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidcontrolecontato number;
                  vdatanascimento date;
                  vdatacadastro date := sysdate;
                  vusuario varchar2(100) := v('APP_USER');
                  --
                begin
                  --
                  vdatanascimento := to_date(:P494_DATANASCIMENTO,'DD/MM/RRRR');
                  --
                  PCK_SAC_FAV.PRC_INDICACOESUEXTERIOR( PIDCONTROLECONTATOSSITE => vidcontrolecontato,
                                                       PNOMECOMPLETO => :P494_NOMECOMPLETO,
                                                       PDOCUMENTOESTRANGEIRO => :P494_DOCUMENTOESTRANGEIRO,
                                                       PDATANASCIMENTO => :P494_DATANASCIMENTO,
                                                       PRUA => :P494_RUA,
                                                       PNR => :P494_NR,
                                                       PCOMPLEMENTO => :P494_COMPLEMENTO,
                                                       PBAIRRO => :P494_BAIRRO,
                                                       PIDCIDADE => :P494_IDCIDADE,
                                                       PCEP => :P494_CEP,
                                                       PFONE => :P494_FONE,
                                                       PFONE2 => :P494_FONE2,
                                                       PEMAIL => :P494_EMAIL,
                                                       PMENSAGEM => :P494_MENSAGEM,
                                                       POBSERVACAO => :P494_OBSERVACAO,
                                                       PSITUACAO => :P494_SITUACAO,
                                                       PDATACADASTRO => vdatacadastro,
                                                       PORIGEM => :P494_ORIGEM,
                                                       PTIPO => :P494_TIPO,
                                                       PTIPOSOLICITACAO => :P494_TIPOSOLICITACAO,
                                                       PCIDADE => :P494_CIDADE,
                                                       PIDPAIS => :P494_IDPAIS,
                                                       PAUTORIZACAOCONSULTADOC => :P494_AUTORIZACAOCONSULTADOC,
                                                       PUSUARIO => vusuario,
                                                       POPERACAO_DML => 'I');
                  --
                  :P494_IDCONTROLECONTATOSSITE := vidcontrolecontato;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Cadastro incluído com sucesso!
        }
        advanced {
            executionMappingIdentifier: 103145962283738788
        }
        serverSideCondition {
            whenButtonPressed: @criar
        }
    )

    branch (
        name: Go To Page 124
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 626
                items: {
                    P626_IDCONTROLECONTATOSSITE: &P494_IDCONTROLECONTATOSSITE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @criar
        }
    )

    branch (
        name: Go To 494
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 494
            }
        }
        serverSideCondition {
            type: request=Value
            value: ATUALIZAR
        }
    )

)

