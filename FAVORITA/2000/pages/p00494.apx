page 494 (
    name: Cadastro SAC Exterior
    title: Cadastro SAC Exterior
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region novo-cadastro (
        name: Novo Cadastro
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--leftLabels
            ]
        }
        settings {
            outputAs: text
        }
    )

