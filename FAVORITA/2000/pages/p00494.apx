    pageItem P494_IDCIDADE (
        type: selectList
        label {
            label: Cidade
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nomecidade||' ('||e.nome||')' display_value
                     , c.idcidade return_value
                from ROMAN.cidades c
                   , ROMAN.estados e
                where e.idestado = c.idestado
                  and e.idpais in (2,4,6)
                  --and e.idpais   = :P494_IDPAIS 
                order by 1
                ```
        }
        layout {
            sequence: 150
            region: @novo-cadastro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

