    pageItem P494_ORIGEM (
        type: selectList
        label {
            label: Origem
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select o.origem
                     , o.idorigemsac
                from roman.origemsac o
                where not exists ( select 1
                                   from usuarios u
                                   where exists ( select 1
                                                  from favorita.filiaisfavorita ff
                                                  where ff.idfilialfavorita = u.idfilialfavorita
                                                    and ff.tipofilial       = 'L' )
                                     and u.usuario = v('APP_USER') )
                union
                select o.origem
                     , o.idorigemsac
                from roman.origemsac o
                where exists ( select 1
                               from usuarios u
                               where exists ( select 1
                                              from favorita.filiaisfavorita ff
                                              where ff.idfilialfavorita = u.idfilialfavorita
                                                and ff.tipofilial       = 'L' )
                                 and u.usuario = v('APP_USER') )
                   and o.idorigemsac = 'LF'
                order by 1
                ```
        }
        layout {
            sequence: 40
            region: @novo-cadastro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

