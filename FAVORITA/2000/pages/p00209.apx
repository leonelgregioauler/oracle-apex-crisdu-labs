page 209 (
    name: Inclusão de Produtos Extras
    title: Inclusão de Produtos Extras
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        executeWhenPageLoads: window.opener.location.reload();
    }
    readOnly {
        type: never
    }
    security {
        pageAccessProtection: unrestricted
    }

    region inclusão-de-produtos (
        name: Inclusão de Produtos
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P209_IDCOMPRATRANSFERENCIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @inclusão-de-produtos
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P209_IDITEMCOMPRATRANSFERENCIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @inclusão-de-produtos
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P209_IDPRODUTODETALHADO (
        type: popupLov
        label {
            label: Produto
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct(pck_util_fav.fnc_nomeprodutodetalhado(p.idprodutodetalhado,:P0_IDIDIOMA))display_value
                  , p.idprodutodetalhado return_value
                from produtosdetalhados p
                   , estoques e
                   , fornecedoresprodutos f
                where p.idprodutodetalhado = e.idprodutodetalhado
                  and f.idproduto          = p.idproduto
                  and f.idfornecedor       = ( select c.idfornecedor
                                               from comprastransferencias c
                                               where c.idcompratransferencia = :P209_IDCOMPRATRANSFERENCIA )
                ```
        }
        layout {
            sequence: 30
            region: @inclusão-de-produtos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P209_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @inclusão-de-produtos
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P209_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        layout {
            sequence: 70
            region: @inclusão-de-produtos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
            height: 5
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P209_OPERACAO_DML (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 100
            region: @inclusão-de-produtos
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P209_QUANTIDADECOMPRADA (
        type: textField
        label {
            label: Quantidade
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @inclusão-de-produtos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 20
            region: @inclusão-de-produtos
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: never
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Voltar
        layout {
            sequence: 10
            region: @inclusão-de-produtos
            slot: bottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-backward
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 87
                items: {
                    P87_IDCOMPRATRANSFERENCIA: &P209_IDCOMPRATRANSFERENCIA.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 30
            region: @inclusão-de-produtos
            slot: bottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-minus-square
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Adicionar
        layout {
            sequence: 40
            region: @inclusão-de-produtos
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-cart-plus
        }
        behavior {
            action: definedByDynamicAction
            executeValidations: false
        }
        serverSideCondition {
            type: itemIsNull
            item: P209_IDITEMCOMPRATRANSFERENCIA
        }
    )

    dynamicAction atualziar (
        name: atualziar
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @atualizar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: ATUALIZAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction inserir (
        name: inserir
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @inserir
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: INSERIR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process adiciona-produto-extra (
        name: Adiciona Produto Extra
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_comprastransf_fav.prc_incluiprodutoextra(pidcompratransferencia => :P209_IDCOMPRATRANSFERENCIA,
                                                               pidprodutodetalhado => :P209_IDPRODUTODETALHADO,
                                                               pquantidade => :P209_QUANTIDADECOMPRADA,
                                                               pobservacao => :P209_OBSERVACAO,
                                                               pidusuario => :P0_IDUSUARIO);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 573563070303151824
        }
    )

    branch (
        name: go to page 209
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 209
                items: {
                    P209_IDITEMCOMPRATRANSFERENCIA:
                    P209_IDCOMPRATRANSFERENCIA: &P209_IDCOMPRATRANSFERENCIA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @inserir
        }
    )

    branch (
        name: go to page 87
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 87
                items: {
                    P74_IDCOMPRATRANSFERENCIA: &P209_IDCOMPRATRANSFERENCIA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @excluir
        }
    )

)

