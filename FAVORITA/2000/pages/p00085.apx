    validation cep-dentro-do-range-da-cidade (
        name: CEP dentro do range da cidade
        execution {
            sequence: 105
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  l_cep_num VARCHAR2(20);
                  l_count   NUMBER;
                BEGIN
                  IF :P85_CEP IS NULL OR :P85_IDCIDADE IS NULL THEN
                    RETURN TRUE;
                  END IF;
                  l_cep_num := REGEXP_REPLACE(:P85_CEP, '[^0-9]', '');
                  SELECT COUNT(*)
                    INTO l_count
                    FROM catal.cidades
                   WHERE idcidade  = :P85_IDCIDADE
                     AND l_cep_num BETWEEN cepinicial AND cepfinal;
                  RETURN l_count > 0;
                END;
                ```
        }
        error {
            errorMessage: CEP informado não pertence a região da cidade selecionada.
            associatedItem: @P85_CEP
        }
        serverSideCondition {
            type: item!=value
            item: P85_FISICAJURIDICAESTRANG
            value: D
        }
    )

    validation cep-obrigatório (
        name: CEP obrigatório
        execution {
            sequence: 100
        }
        validation {
            type: itemIsNotNull
            item: P85_CEP
        }
        error {
            errorMessage: CEP deve ter um valor.
            associatedItem: @P85_CEP
        }
    )

    validation cep-válido (
        name: CEP válido
        execution {
            sequence: 90
        }
        validation {
            type: itemMatchesRegexp
            item: P85_CEP
            regexp: "^[0-9]{2}\\.[0-9]{3}-[0-9]{3}$"
        }
        error {
            errorMessage: CEP inválido. Informe um CEP válido no formato: 00.000-000
            associatedItem: @P85_CEP
        }
        serverSideCondition {
            type: item!=value
            item: P85_FISICAJURIDICAESTRANG
            value: D
        }
    )

