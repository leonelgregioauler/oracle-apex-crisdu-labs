    pageItem P85_CIDADES (
        type: checkboxGroup
        label {
            alignment: left
        }
        settings {
            noOfCols: 4
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct c.nomecidade as d
                     , p.idcidade as r
                from roman.cidades c
                   , pessoas p
                   , vendedoras v
                   , roman.notasvendas nv
                where v.idvendedora = nv.idvendedora
                and p.idpessoa = v.idpessoa
                and c.idcidade = p.idcidade
                and nv.idrepresentante in ( select idrepresentante
                                            from vendedoras
                                            where idvendedora = :P85_IDVENDEDORA )
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P85_IDVENDEDORA
        }
        layout {
            sequence: 40
            region: @cidades-atendidas-fora-do-prazo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

