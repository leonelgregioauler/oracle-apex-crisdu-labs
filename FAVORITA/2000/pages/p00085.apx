    region cupons-de-desconto (
        name: Cupons de Desconto
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nome
                     , c.valordesconto
                     , cc.codigo
                     , cc.idpedido
                from vw_codigoscuponsdescontos_fav cc
                   , vw_cuponsdescontos_fav c
                where cc.idcupomdesconto = c.idcupomdesconto
                  and ( cc.idvendedora     = :P85_IDVENDEDORA
                     or exists ( select 1
                                 from pedidos p
                                 where p.idpedido = cc.idpedido
                                   and p.idvendedora = :P85_IDVENDEDORA ))
                  
                ```
        }
        layout {
            sequence: 60
            slot: contentBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: - Não há cupons para esta pessoa -
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
        }
        advanced {
            savedReportMappingIdentifier: 1356469900010067454
        }

