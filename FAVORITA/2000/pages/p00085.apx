    process carregar-cidades-atendidas-pelos-distribuidores (
        name: Carregar Cidades Atendidas pelos Distribuidores
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  AS_CHECK_BOX APEX_APPLICATION_GLOBAL.VC_ARR2;
                  i            integer := 1;
                  vexiste      varchar2(1) := 'N';
                  --
                  vidvendedora                 number;
                  --
                  vconfirmarentregaatraso      varchar2(1);
                  vdataatualizadoentregaatraso date;
                  vdemaisregioesnaoligar       varchar2(1);
                  --
                begin
                  --
                  :P85_CIDADES := null;
                  --
                  begin
                    select idvendedora
                    into vidvendedora
                    from vendedoras
                    where idpessoa = :P85_IDPESSOA;
                    --
                    for c in ( select idcidade
                               from cidadesrepatendeforaprazo
                               where idrepresentante in ( select idrepresentante 
                                                          from vendedoras 
                                                          where idvendedora = vidvendedora ) )                                        
                    --
                    loop
                      --
                      AS_CHECK_BOX(i) := c.idcidade;
                      --
                      i := i + 1;
                      --
                      vexiste := 'S';
                      --
                    end loop;
                    --
                    select r.confirmarentregaatraso
                         , r.dataatualizadoentregaatraso
                         , r.demaisregioesnaoligar
                    into vconfirmarentregaatraso
                       , vdataatualizadoentregaatraso
                       , vdemaisregioesnaoligar
                    from representantes r
                       , vendedoras v
                    where r.idrepresentante = v.idrepresentante 
                    and v.idvendedora = vidvendedora;
                    --
                    :P85_CONFIRMARENTREGAATRASO    := vconfirmarentregaatraso;
                    :P85_DATAATUALIZAENTREGAATRASO := to_char(vdataatualizadoentregaatraso, 'DD/MM/RRRR HH24:MI:SS');
                    :P85_NAO_LIGAR_DEMAIS_REGIOES  := vdemaisregioesnaoligar;
                    --
                  exception
                    when others then
                      vexiste := 'N';
                      vconfirmarentregaatraso := 'S';
                  end;
                  --
                  if vexiste = 'S' then
                    :P85_CIDADES := APEX_UTIL.TABLE_TO_STRING(AS_CHECK_BOX, ':');
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 1439104921567095767
        }
    )

