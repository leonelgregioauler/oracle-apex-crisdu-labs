    region font-size-4-color-red-mensagem-informativa-font (
        name: <font size="4" color="red">Mensagem Informativa</font>
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                  if not pck_util_fav.fnc_validacpfcnpj(:P85_CPF) and :P85_FISICAJURIDICAESTRANG = 'F' then
                    htp.p('<h4 align="center" style="color:red;"> O CPF '||:P85_CPF ||' é inválido. Solicite o número correto.</h4>');
                  elsif not pck_util_fav.fnc_validacpfcnpj(:P85_CNPJ) and :P85_FISICAJURIDICAESTRANG = 'J' then
                    htp.p('<h4 align="center" style="color:red;"> O CNPJ '||:P85_CNPJ ||' é inválido. Solicite o número correto.</h4>');
                  end if;
                end;
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                if not (pck_util_fav.fnc_validacpfcnpj(:P85_CPF) or pck_util_fav.fnc_validacpfcnpj(:P85_CNPJ)) and :P85_IDPESSOA is not null then
                  return true;
                else 
                  return false;
                end if;
                ```
        }
    )

    region fotos-de-documentos (
        name: Fotos de Documentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.tipofoto
                     , decode(f.recebida,'S','Sim','N','Não') recebida
                     , f.datadadosrecebido
                     , null verfoto
                     , '<a href="http://fotos_documentos.romancemoda.com.br/'||f.nomearquivo||'" target="_blank"> <img src="http://fotos_documentos.romancemoda.com.br/'||f.nomearquivo||'" class="img_documento"><a>' foto
                     , nomearquivo
                from roman.fotosdocumentos f
                where f.documento = replace(replace(:P85_CPF,'.',''),'-','')
                order by 1
                ```
        }
        layout {
            sequence: 90
            slot: contentBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
