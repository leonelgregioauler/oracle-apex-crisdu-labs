    process seleciona-cidade-para-atender-fora-do-prazo (
        name: Seleciona cidade para atender fora do prazo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  AS_CHECK_BOX       APEX_APPLICATION_GLOBAL.VC_ARR2;
                  vidvendedora       number;
                  vidrepresentante   number;
                begin
                  --
                  if v('REQUEST') = 'ATUALIZARCIDADE' then
                    --
                    select idvendedora
                    into vidvendedora
                    from vendedoras
                    where idpessoa = :P85_IDPESSOA;
                    --
                    select idrepresentante 
                    into vidrepresentante
                    from vendedoras 
                    where idvendedora = vidvendedora;
                    --
                    delete from cidadesrepatendeforaprazo
                    where idrepresentante = vidrepresentante;
                    --
                    AS_CHECK_BOX := APEX_UTIL.STRING_TO_TABLE(:P85_CIDADES, ':');
                    --
                    for i in 1..AS_CHECK_BOX.COUNT 
                    loop
                      --
                      insert into cidadesrepatendeforaprazo
                      values (vidrepresentante, AS_CHECK_BOX(i));
                      --
                      commit;
                      --
                    end loop;
                    --
                    update representantes
                    set confirmarentregaatraso      = :P85_CONFIRMARENTREGAATRASO
                      , demaisregioesnaoligar       = :P85_NAO_LIGAR_DEMAIS_REGIOES
                      , dataatualizadoentregaatraso = sysdate
                    where idrepresentante = vidrepresentante;
                    --
                    commit;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 90
        }
        advanced {
            executionMappingIdentifier: 1439105231003097803
        }
    )

