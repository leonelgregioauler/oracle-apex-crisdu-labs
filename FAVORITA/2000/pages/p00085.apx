    process operação-dml-em-pessoas (
        name: Operação DML em Pessoas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                
                  voperacao_dml       varchar2(1);
                  vdatanascimento     date;
                  vultimaatualizacao  date;
                  vdatacadastro       date;
                  vlimitecredito      number(15,2);
                  vlimitecreditormc   number(15,2);
                
                begin
                
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  end if;
                
                  vdatanascimento    := to_date(:P85_DATANASCIMENTO     ,'DD/MM/RRRR');
                  vultimaatualizacao := to_date(:P85_ULTIMAATUALIZACAO  ,'DD/MM/RRRR HH24:MI:SS');
                  vdatacadastro      := to_date(:P85_DATACADASTRO       ,'DD/MM/RRRR HH24:MI:SS');
                  vlimitecredito     := to_number(:P85_LIMITECREDITO    ,'999G999G999G990D00');
                  vlimitecreditormc  := to_number(:P85_LIMITECREDITORMC ,'999G999G999G990D00');
                
                  if vlimitecredito is null and voperacao_dml = 'U' then
                    begin
                      select p.limitecredito
                        into vlimitecredito
                        from catal.pessoas p
                       where p.idpessoa = :P85_IDPESSOA;
                    exception
                      when no_data_found then
                        vlimitecredito := null;
                    end;
                  end if;
                
                  PCK_CADASTROS_FAV.PRC_PESSOAS( PIDPESSOA             => :P85_IDPESSOA
                                               , PNOMEPESSOA           => :P85_NOMEPESSOA
                                               , PENDERECOPRINCIPAL    => :P85_ENDERECOPRINCIPAL
                                               , PENDERECOSECUNDARIO   => :P85_ENDERECOSECUNDARIO
                                               , PIDCIDADE             => :P85_IDCIDADE
                                               , PEMAIL                => :P85_EMAIL
                                               , PCPF                  => :P85_CPF
                                               , PCNPJ                 => :P85_CNPJ
                                               , PAPELIDO              => :P85_APELIDO
                                               , PTIPOPESSOA           => :P85_FISICAJURIDICAESTRANG
                                               , POBSERVACAO           => :P85_OBSERVACAO
                                               , PREFERENCIA           => :P85_REFERENCIA
                                               , PATIVO                => :P85_ATIVO
                                               , PNUMERO               => :P85_NUMERO
                                               , PCOMPLEMENTO          => :P85_COMPLEMENTO
                                               , PBAIRRO               => :P85_BAIRRO
                                               , PCEP                  => :P85_CEP
                                               , PRG                   => :P85_RG
                                               , PCODIGOSISDIST        => :P85_CODIGOSISDIST
                                               , PDATANASCIMENTO       => vdatanascimento
                                               , PINSCRICAOESTADUAL    => :P85_INSCRICAOESTADUAL
                                               , PUSUARIOCADASTROU     => :P85_USUARIOCADASTROU
                                               , POBSERVACAOCOBRANCA   => :P85_OBSERVACAOCOBRANCA
                                               , PDOCUMENTOESTRANGEIRO => :P85_DOCUMENTOESTRANGEIRO
                                               , PSENHASITE            => :P85_SENHASITE
                                               , PLIMITECREDITO        => vlimitecredito
                                               , PULTIMAATUALIZACAO    => vultimaatualizacao
                                               , PSEXO                 => :P85_SEXO
                                               , PNROCONSULTASPC       => :P85_NROCONSULTASPC
                                               , PDOCUMENTOSRECEBIDOS  => :P85_DOCUMENTOSRECEBIDOS
                                               , PDATACADASTRO         => vdatacadastro
                                               , PSKYPE                => :P85_SKYPE
                                               , PSENHASKYPE           => :P85_SENHASKYPE
                                               , PSENHAEMAIL           => :P85_SENHAEMAIL
                                               , POBSERVACAOTI         => :P85_OBSERVACAOTI
                                               , POBSERVACAOCALLCENTER => :P85_OBSERVACAOCALLCENTER
                                               , PIDPAIS               => :P85_IDPAIS
                                               , PVENDEOUTROSCATALOGOS => :P85_VENDEOUTROSCATALOGOS
                                               , POBSERVACAOCATALOGOS  => :P85_OBSERVACAOCATALOGOS
                                               , PMATRICULA            => :P85_MATRICULA
                                               , PUNIDADE              => :P85_UNIDADE
                                               , PMD5                  => :P85_MD5
                                               , POPERACAO_DML         => voperacao_dml);
                   -- ============================================================
                  -- Documento estrangeiro ORIGINAL (campo novo p/ Membrezia Panama)
                  -- So atualiza quando o campo foi preenchido, para nao apagar
                  -- o valor existente em edicoes de outros clientes (BR/exterior).
                  -- ============================================================
                  if :P85_DOCUMENTOESTRANGEIRO_ORIG is not null then
                    update catal.pessoas p
                       set p.documentoestrangeiro_orig = :P85_DOCUMENTOESTRANGEIRO_ORIG
                     where p.idpessoa = :P85_IDPESSOA;
                  end if;
                  --
                  begin
                    if vlimitecreditormc is not null then
                      update catal.pessoas p
                         set p.limitecreditormc = vlimitecreditormc
                       where p.idpessoa = :P85_IDPESSOA;
                      commit;
                    end if;
                  exception
                    when others then
                      null;
                  end;
                
                  begin
                    if vlimitecredito is not null then
                      update vendedoras v
                         set v.updated_time = sysdate
                       where v.idvendedora = :P85_IDVENDEDORA;
                    end if;
                  end;
                
                end;
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 577516464927958588
        }
    )

