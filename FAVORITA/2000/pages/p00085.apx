        type: popupLov
        label {
            label: Cidade
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select (c.nomecidade||' - '||e.sigla||' - '||p.nome) display_value
                     , c.idcidade return_value
                  from catal.cidades c
                     , roman.estados e
                     , catal.paises p
                 where c.idestado = e.idestado
                   and e.idpais = p.idpais
                order by c.nomecidade
                ```
        }
        layout {
            sequence: 270
            region: @pessoas
            slot: regionBody
            alignment: left
        }
        appearance {
