    process consulta-em-pessoas (
        name: Consulta em Pessoas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                
                  vdatanascimento     date;
                  vultimaatualizacao  date;
                  vdatacadastro       date;
                  vlimitecredito      number(15,2);
                  vlimitecreditormc   number(15,2);
                  vcpf                varchar2(15);
                  vcnpj               varchar2(18);
                  vcep                varchar2(20);
                
                begin
                
                  -- Carrega Funcionário e Limite RMC
                  begin
                    select f.idfuncionario,
                           p.limitecreditormc
                      into :P85_IDFUNCIONARIO
                         , vlimitecreditormc
                      from catal.funcionarios f
                         , catal.pessoas p
                     where f.idpessoa(+) = p.idpessoa
                       and p.idpessoa = :P85_IDPESSOA;
                    exception
                      when others then
                        null;
                  end;
                
                  -- Chama pck Pessoas para carregar dados da página
                  PCK_CADASTROS_FAV.PRC_PESSOAS( PIDPESSOA             => :P85_IDPESSOA
                                               , PNOMEPESSOA           => :P85_NOMEPESSOA
                                               , PENDERECOPRINCIPAL    => :P85_ENDERECOPRINCIPAL
                                               , PENDERECOSECUNDARIO   => :P85_ENDERECOSECUNDARIO
                                               , PIDCIDADE             => :P85_IDCIDADE
                                               , PEMAIL                => :P85_EMAIL
                                               , PCPF                  => vcpf
                                               , PCNPJ                 => vcnpj
                                               , PAPELIDO              => :P85_APELIDO
                                               , PTIPOPESSOA           => :P85_FISICAJURIDICAESTRANG
                                               , POBSERVACAO           => :P85_OBSERVACAO
                                               , PREFERENCIA           => :P85_REFERENCIA
                                               , PATIVO                => :P85_ATIVO
                                               , PNUMERO               => :P85_NUMERO
                                               , PCOMPLEMENTO          => :P85_COMPLEMENTO
                                               , PBAIRRO               => :P85_BAIRRO
                                               , PCEP                  => vcep
                                               , PRG                   => :P85_RG
                                               , PCODIGOSISDIST        => :P85_CODIGOSISDIST
                                               , PDATANASCIMENTO       => vdatanascimento
                                               , PINSCRICAOESTADUAL    => :P85_INSCRICAOESTADUAL
                                               , PUSUARIOCADASTROU     => :P85_USUARIOCADASTROU
                                               , POBSERVACAOCOBRANCA   => :P85_OBSERVACAOCOBRANCA
                                               , PDOCUMENTOESTRANGEIRO => :P85_DOCUMENTOESTRANGEIRO
                                               , PSENHASITE            => :P85_SENHASITE
                                               , PLIMITECREDITO        => vlimitecredito
                                               , PULTIMAATUALIZACAO    => vultimaatualizacao
                                               , PSEXO                 => :P85_SEXO
                                               , PNROCONSULTASPC       => :P85_NROCONSULTASPC
                                               , PDOCUMENTOSRECEBIDOS  => :P85_DOCUMENTOSRECEBIDOS
                                               , PDATACADASTRO         => vdatacadastro
                                               , PSKYPE                => :P85_SKYPE
                                               , PSENHASKYPE           => :P85_SENHASKYPE
                                               , PSENHAEMAIL           => :P85_SENHAEMAIL
                                               , POBSERVACAOTI         => :P85_OBSERVACAOTI
                                               , POBSERVACAOCALLCENTER => :P85_OBSERVACAOCALLCENTER
                                               , PIDPAIS               => :P85_IDPAIS
                                               , PVENDEOUTROSCATALOGOS => :P85_VENDEUOUTROSCATALOGOS
                                               , POBSERVACAOCATALOGOS  => :P85_OBSERVACAOCATALOGOS
                                               , PMD5                  => :P85_MD5
                                               , POPERACAO_DML         => 'S');
                
                  -- Carrega Documento estrangeiro ORIGINAL (Membrezia Panamá)
                  begin
                    select p.documentoestrangeiro_orig
                      into :P85_DOCUMENTOESTRANGEIRO_ORIG
                      from catal.pessoas p
                     where p.idpessoa = :P85_IDPESSOA;
                  exception
                    when no_data_found then
                      :P85_DOCUMENTOESTRANGEIRO_ORIG := null;
                  end;
                
                  -- Formatação/Mascara nos campos
                  :P85_DATANASCIMENTO    := to_char(vdatanascimento   ,'DD/MM/RRRR');
                  :P85_ULTIMAATUALIZACAO := to_char(vultimaatualizacao,'DD/MM/RRRR HH24:MI:SS');
                  :P85_DATACADASTRO      := to_char(vdatacadastro     ,'DD/MM/RRRR HH24:MI:SS');
                  :P85_LIMITECREDITO     := to_char(vlimitecredito    ,'999G999G999G999G990D00');
                  :P85_LIMITECREDITORMC  := to_char(vlimitecreditormc ,'999G999G999G999G990D00');
                  :P85_CPF               := REGEXP_REPLACE(vcpf,  '^(\d{3})(\d{3})(\d{3})(\d{2})$', '\1.\2.\3-\4');
                  --:P85_CNPJ              := REGEXP_REPLACE(vcnpj, '^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})$', '\1.\2.\3/\4-\5');
                  :P85_CNPJ              := REGEXP_REPLACE(vcnpj, '^([A-Za-z0-9]{2})([A-Za-z0-9]{3})([A-Za-z0-9]{3})([A-Za-z0-9]{4})([0-9]{2})$', '\1.\2.\3/\4-\5');
                  :P85_CEP               := REGEXP_REPLACE(vcep,  '^(\d{2})(\d{3})(\d{3})$', '\1.\2-\3');
                
                end;
                ```
        }
        execution {
            sequence: 20
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 577516034364958587
        }
    )

