page 85 (
    name: Pessoas
    title: Pessoas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 90%
        height: 90%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG_21"';
            
            function validadocumento()
            { 
              var get = new htmldb_Get(null,&APP_ID.,'APPLICATION_PROCESS=validacpfcnpj',0);
              
               pValue  = 'F';
               void(0);
               pVCPF    = html_GetElement('P85_CPF').value;
               void(0);
                
               if (!!pVCPF){
                   get.add('F10008TIPO',pValue ); 
                   get.add('F10008CPF',pVCPF    );
                   gReturn = get.get();
                   if(gReturn=='V'){
                       html_GetElement('P85_VALIDO').value = 'S';
                   }
                   else{
                       if (pValue == 'F'){
                          alert('CPF é inválido!');
                       }
                       html_GetElement('P85_VALIDO').value = 'N';
                   }  
               get = null;
               }
            }
            
            function somenteNumeros(){ 
              tecla = event.keyCode; 
              
              if (tecla >= 48 && tecla <= 57){ 
                return true; 
              }else { 
                 return false; 
              } 
            }
            ```
        executeWhenPageLoads:
            ```javascript-browser
            
            
            ```
    }
    css {
        inline:
            ```css
            .img_documento {
                position: relative;
                max-width: 360px;
                width: 60%;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region buttons (
        name: Buttons
        type: staticContent
