        }
    )

    region cidades-atendidas-fora-do-prazo (
        name: Cidades Atendidas Fora do Prazo
        type: staticContent
        layout {
            sequence: 100
            slot: contentBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from vendedoras v 
                   , representantes r
                where v.idrepresentante = r.idrepresentante
                and v.idpessoa = r.idpessoa
                and r.idpessoa = :P85_IDPESSOA
                and r.ativo = 'S';
                ```
        }
        readOnly {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                if pck_util_fav.fnc_verificagrupoatendimento (4, :P0_IDUSUARIO) = 'N' then
                  return true;
                else 
                  return false;
                end if;
                ```
        }
    )

