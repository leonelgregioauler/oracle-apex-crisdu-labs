        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vidusuario number;
                begin
                  --
                  select idusuario
                  into vidusuario
                  from usuarios 
                  where idpessoa = :P85_IDPESSOA;
                  --
                  return vidusuario;
                  --
                exception
                  when others then
                    return null;
                end;
                ```
