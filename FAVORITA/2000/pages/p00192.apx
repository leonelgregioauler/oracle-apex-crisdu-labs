page 192 (
    name: Filtro de Impressão de Pedidos Remessas
    title: Filtro de Impressão de Pedidos Remessas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function imprime()
            {
                idcomp         = document.getElementById("P192_IDCOMPRATRANSFERENCIA").value;
                iddistribuidor = document.getElementById("P192_IDREPRESENTANTE").value;
                quantidade     = document.getElementById("P192_QUANTIDADE").value;
                
                pjanela = window.open('f?p=&APP_ID.:166:&SESSION.::NO::P166_IDCOMPRATRANSFERENCIA,P166_IDREPRESENTANTE,P166_QUANTIDADE:'+idcomp+','+iddistribuidor+','+quantidade,'page','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1280,height=1024,left=20,top=10','_blank');
                pjanela.focus();                          
            }
            
            function retornaSelecionado_old(nome) {
             var resultado;
             document.getElementsByName(nome).forEach(function(item){if (item.checked) resultado = item.value}); 
             return resultado;
            }
            
            function retornaSelecionado(nome) {
            var e = document.getElementById(nome);
            var resultado = e.options[e.selectedIndex].value;
                
             return resultado;
            }
            
            ```
    }
    security {
        authentication: public
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P192_BOLETO (
        type: radioGroup
        label {
            label: Boleto
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC:Sim;1,Não;2
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: 2
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P192_IDCOMPRATRANSFERENCIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P192_IDFILIAL (
        type: selectList
        label {
            label: Filial
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select vw.nome 
                 , vw.idfilial
                from roman.vw_filiais vw
                where exists ( select 1
                               from atendimentosfiliaisrmc a
                               where a.idfilialdestino = vw.idfilial
                                 and a.idfilialfavoritaorigem = ( select c.idfilialfavoritadestino
                                                                  from comprastransferencias c
                                                                  where c.idcompratransferencia = :P192_IDCOMPRATRANSFERENCIA ) ) 
                order by 1
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P192_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(idrepresentante) display_value
                 , idrepresentante return_value
                from representantes
                where idgerente = ( select idgerente 
                                    from gerentes 
                                    where idfilial = :P192_IDFILIAL )
                  and ativo = 'S'
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P192_IDFILIAL
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P192_PROMISSORIA (
        type: radioGroup
        label {
            label: Promissoria
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC:Sim;1,Não;2
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: 2
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P192_QUANTIDADE (
        type: selectList
        label {
            label: Qtd Impressão
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:10;10,20;20,30;30
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P192_SESSION_IMPRIME (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_url varchar2(2000);
                    l_app number := 2000;
                    l_session number := v('APP_SESSION');
                BEGIN
                    l_url := APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p=' || l_app || ':128:'||l_session||'::NO::P128_IDCOMPRATRANSFERENCIA,P128_IDDISTRIBUIDOR,P128_QUANTIDADE,P128_ETIQUETAGERADA,P128_ORDENACAO,P128_TIPO:'||:P192_IDCOMPRATRANSFERENCIA||','||:P192_DISTRIBUIDOR||','||:P192_QUANTIDADE||','||:P192_ETIQUETAGERADA||','||:P192_ORDENACAO||','||:P192_TIPO,
                        p_checksum_type => 'SESSION');
                    
                    return l_url;
                END;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P192_TIPO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button imprimirpedidos (
        buttonName: IMPRIMIRPEDIDOS
        label: Imprimir Pedidos
        layout {
            sequence: 10
            region: @filtros
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: imprime();
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 20
            region: @filtros
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 165
                items: {
                    P165_IDCOMPRATRANSFERENCIA: &P192_IDCOMPRATRANSFERENCIA.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

