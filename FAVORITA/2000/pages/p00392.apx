page 392 (
    name: Resultado de Emissão de Pedidos Por Filial
    title: Resultado de Emissão de Pedidos Por Filial
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region resultado-de-emissão-de-pedidos-por-filial-detalhado (
        name: Resultado de Emissão de Pedidos Por Filial Detalhado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(p.dataemissao,'MM/RRRR') MesEmissao
                     , favorita.pck_util_fav.fnc_nomefilialfavorita(p.idfilialfavorita) FilialFavorita
                     , nvl(sum(i.valorapagar*p.fatorconversao),0) TotalPagar
                     , count(distinct p.idpedido)           QtdPedidos
                from favorita.pedidos p
                   , favorita.itenspedidos i
                where p.idpedido = i.idpedido
                  and trunc(p.dataemissao) between to_date(:P392_DATAEMISSAO_INICIAL,'dd/mm/rrrr') and to_date(:P392_DATAEMISSAO_FINAL,'dd/mm/rrrr')
                  --and p.tipopedido = 'P'
                  and p.valorapagar > 0
                  and NOT exists ( select 1
                                    from classificacoespedidos c  
                                    where idpedido = p.idpedido
                                      and idcaracteristicapedido = 8 
                                      and idvalorcaracteristica  = 16 )
                  and p.datacancelamento is null
                  and ( (:P392_DISTRIBUIDORFEZCONSULTORA = 'T')
                     or (:P392_DISTRIBUIDORFEZCONSULTORA = 'N' and not exists ( select 1
                                                                                from favorita.classificacoespedidos cp
                                                                                where cp.idpedido = p.idpedido
                                                                                 and cp.idcaracteristicapedido = 2 ) )  
                     or (:P392_DISTRIBUIDORFEZCONSULTORA = 'S' and exists ( select 1
                                                                            from favorita.classificacoespedidos cp
                                                                            where cp.idpedido = p.idpedido
                                                                             and cp.idcaracteristicapedido = 2 ) ) )                    
                  and (:P392_IDFILIALFAVORITA is null 
                       or p.idfilialfavorita = :P392_IDFILIALFAVORITA)
                  and :P392_TIPORELATORIO = 1
                  and p.idsituacaoentrega >= 20000
                group by p.idfilialfavorita, to_char(p.dataemissao,'MM/RRRR')
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P392_TIPORELATORIO
            value: 1
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1548005664690482617
        }

        column FILIALFAVORITA (
            type: plainText
            heading {
                heading: Filial Favorita
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column MESEMISSAO (
            type: plainText
            heading {
                heading: Mês Emissão
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column QTDPEDIDOS (
            type: plainText
            heading {
                heading: Qtd Pedidos
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column TOTALPAGAR (
            type: plainText
            heading {
                heading: Total Pagar
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            appearance {
                formatMask: FML999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 15481167 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn FILIALFAVORITA (
                sequence: 2
            )

            displayColumn MESEMISSAO (
                sequence: 1
            )

            displayColumn QTDPEDIDOS (
                sequence: 4
            )

            displayColumn TOTALPAGAR (
                sequence: 3
            )

            sort (
                column: MESEMISSAO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: TOTALPAGAR
            )

            aggregate (
                column: QTDPEDIDOS
            )

        )

    )

    region resultado-de-emissão-de-pedidos-por-filial-resumido (
        name: Resultado de Emissão de Pedidos Por Filial Resumido
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomefilialfavorita(p.idfilialfavorita) FilialFavorita
                     , nvl(round(sum(p.valorapagar*p.fatorconversao),2),0) TotalPagar
                     , count(distinct p.idpedido)           QtdPedidos
                from pedidos p
                where trunc(p.dataemissao) between to_date(:P392_DATAEMISSAO_INICIAL) and to_date(:P392_DATAEMISSAO_FINAL)
                  and p.idsituacaoentrega  >= 20000
                  and p.valorapagar         > 0 
                  and p.datacancelamento is null
                  and NOT exists ( select 1
                                   from classificacoespedidos c  
                                   where idpedido = p.idpedido
                                     and idcaracteristicapedido = 8 
                                     and idvalorcaracteristica  = 16 ) 
                  and ( (:P392_DISTRIBUIDORFEZCONSULTORA = 'T')
                     or (:P392_DISTRIBUIDORFEZCONSULTORA = 'N' and not exists ( select 1
                                                                                from favorita.classificacoespedidos cp
                                                                                where cp.idpedido = p.idpedido
                                                                                 and cp.idcaracteristicapedido = 2 ) )  
                     or (:P392_DISTRIBUIDORFEZCONSULTORA = 'S' and exists ( select 1
                                                                            from favorita.classificacoespedidos cp
                                                                            where cp.idpedido = p.idpedido
                                                                             and cp.idcaracteristicapedido = 2 ) ) )     
                  and (:P392_IDFILIALFAVORITA is null 
                       or p.idfilialfavorita = :P392_IDFILIALFAVORITA)
                  and :P392_TIPORELATORIO = 2
                group by p.idfilialfavorita
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P392_TIPORELATORIO
            value: 2
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1548006879435482629
        }

        column FILIALFAVORITA (
            type: plainText
            heading {
                heading: Filial Favorita
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column QTDPEDIDOS (
            type: plainText
            heading {
                heading: Qtd Pedidos
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        column TOTALPAGAR (
            type: plainText
            heading {
                heading: Total Pagar
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            appearance {
                formatMask: FML999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 15481280 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn FILIALFAVORITA (
                sequence: 1
            )

            displayColumn QTDPEDIDOS (
                sequence: 3
