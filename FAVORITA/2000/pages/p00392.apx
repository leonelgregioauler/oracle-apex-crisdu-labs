    )

    pageItem P392_DATAEMISSAO_FINAL (
        type: datePickerJquery
        label {
            label: Data Emissão Final
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P392_DATAEMISSAO_INICIAL (
        type: datePickerJquery
        label {
            label: Data Emissão Inicial
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P392_DISTRIBUIDORFEZCONSULTORA (
        type: radioGroup
        label {
            label: Distribuidor fez para Consultora
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Sim;S,Não;N
            displayExtraValues: false
            nullDisplayValue: Todos
            nullReturnValue: T
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: T
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P392_IDFILIALFAVORITA (
        type: plugin/select
        label {
            label: Filial Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nomefilialfavorita showvalue
                     , f.idfilialfavorita returnvalue
                from favorita.vw_filiaisfavorita f;
                ```
            displayExtraValues: false
            nullDisplayValue: " - Todos -"
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P392_TIPORELATORIO (
        type: radioGroup
        label {
            label: Tipo Relatório
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Resumido;2,Detalhado;1
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
                t-Button--stretch
            ]
            icon: fa-filter
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 392
                items: {
                    P392_DATAEMISSAO_INICIAL: &P392_DATAEMISSAO_INICIAL.
                    P392_DATAEMISSAO_FINAL: &P392_DATAEMISSAO_FINAL.
                    P392_IDFILIALFAVORITA: &P392_IDFILIALFAVORITA.
                    P392_TIPORELATORIO: &P392_TIPORELATORIO.
                    P392_DISTRIBUIDORFEZCONSULTORA: &P392_DISTRIBUIDORFEZCONSULTORA.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

