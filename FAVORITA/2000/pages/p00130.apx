    process parcelamento-de-pedido (
        name: Parcelamento de Pedido
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidpedido              number      := :P130_IDPEDIDO;
                  vidusuario             number      := :P0_IDUSUARIO;
                  vidformapagamento      number      := 1;
                  vidformaentrega        number;
                  vqtdparcelas           number      := :P130_QUANTIDADEPARCELAS;
                  vnumbernull            number      := null;
                  vclobnull              clob;
                  vdatavencimento        date;
                  vcomentrada            varchar2(1) := :P130_PARCELAMENTOCOMENTRADA;
                  vdatavencimentoentrada date        := :P130_DATAVENCIMENTOENTRADA;
                  vvalorentrada          number      := :P130_VALORENTRADAPARCELAMENTO;
                  vdiasprazoparcelas     number      := :P130_DIASPRAZOPARCELAS;
                  l_json                 CLOB;
                  --
                begin
                  --
                  pck_pedidos_fav.prc_gerafinanceiropedido( pidpedido => vidpedido,
                                                            pidusuario => vidusuario,
                                                            pidformapagamento => vidformapagamento,
                                                            pidformaentrega => vidformaentrega,
                                                            pvalorapagar => vnumbernull,
                                                            pqtdparcelas => vqtdparcelas,
                                                            penviooperadora => vclobnull,
                                                            pretornooperadora => vclobnull,
                                                            pdatavencimento => vdatavencimento,
                                                            pcomentrada => vcomentrada,
                                                            pdatavencimentoentrada => vdatavencimentoentrada,
                                                            pvalorentrada => vvalorentrada,
                                                            pdiasprazoparcelas => vdiasprazoparcelas );
                 --
                 --registra novos boletos  
                    FOR r IN (
                        SELECT 
                            t.idpagamentopedido
                        FROM vw_vencimentospedidos_fav v
                        JOIN vw_pagamentospedidos_fav t
                          ON v.idvencimentopedido = t.idvencimentopedido
                        JOIN pedidos p on v.idpedido = p.idpedido
                        WHERE v.idpedido           = vidpedido
                          AND t.ididioma           = :P0_IDIDIOMA
                          AND p.idpais = 1
                          and t.IDFORMAPAGAMENTO in (1,5,12,17,18,20,26,27,34,36,37,43,44,46,47,48,66) --boleto
                          and v.CODSITUACAOVENCIMENTO = 'V'
                    )
                    LOOP
                
                        BEGIN
                
                            pck_integracao_bb_v2.prc_registra_boleto(
                                p_idpagamentopedido => r.idpagamentopedido,
                                r_json              => l_json
                            );
                
                        EXCEPTION
                            WHEN OTHERS THEN
                
                                DBMS_OUTPUT.PUT_LINE(
                                    'Erro ao reprocessar boleto ' ||
                                    r.idpagamentopedido || ' - ' || SQLERRM
                                );
                
                        END;
                
                    END LOOP;
                end;
                ```
        }
        execution {
            sequence: 160
        }
        successMessage {
            successMessage: Parcelamento efetuado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 1528859840114607205
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'EFETUAPARCELAMENTO'
        }
    )

    process processo-mdl-protoclo-de-atendimento (
        name: Processo MDL Protoclo de Atendimento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  voperacao_dml    varchar2(1);
                  vsituacao        varchar2(1);
                  vnumnull         number;
                  vvarnull         varchar2(1);
                  vdatenull        date;
                  vdataprorrogacao date   := :P130_DATAPRORROGACAO;
                  vidprotocolo     number := :P130_IDPROTOCOLOATENDIMENTO;
                  --
                begin
                  --
                  if v('REQUEST') = 'CONCLUIRATENDIMENTO' then
                    --
                    vsituacao := 'C';
                    --
                  elsif v('REQUEST') = 'REJEITARPROTOCOLO' then
                    --
                    vsituacao := 'R';
                    --
                  end if;
                  --
                  if v('REQUEST') = 'REJEITARPROTOCOLO' then
                    --
                    for i in ( select iditempedido
                               from itensexcluidos
                               where idpedido = :P130_IDPEDIDO )
                    loop               
                      --
                      pck_protocolosatendimentos_fav.prc_excluiitemexcluido( pidpedido     => :P130_IDPEDIDO
                                                                           , pidusuario    => :P0_IDUSUARIO
                                                                           , piditempedido => i.iditempedido
                                                                           , pidprotocolo  => :P130_IDPROTOCOLOATENDIMENTO);
                      --                                                           
                    end loop;                                                           
                    --
                    pck_protocolosatendimentos_fav.prc_excluiitemtrocado (:P130_IDPROTOCOLOATENDIMENTO);
                    --
                  end if;
                  --
                  PCK_PROTOCOLOSATENDIMENTOS_FAV.prc_protocolosatendimentos(pidprotocoloatendimento   => vidprotocolo,
                                                                            pidfilial                 => vnumnull,
                                                                            pidusuariosolicitou       => vnumnull,
                                                                            pdataprotocolo            => vvarnull,
                                                                            pidpedido                 => vnumnull,
                                                                            psituacao                 => vsituacao,
                                                                            pjustificativa            => vvarnull,
                                                                            pdataatendimento          => vdatenull,
                                                                            pobservacaointerna        => :P130_OBSERVACAOINTERNA,
                                                                            pidmotivoprotocolo        => vnumnull,
                                                                            pcpf                      => vvarnull,
                                                                            pidtipoprotocolo          => vnumnull,
                                                                            pidusuarioatendeu         => vnumnull,
                                                                            pnumerocomprovante        => vvarnull,
                                                                            pvalordepositado          => vnumnull,
                                                                            pdataprorrogacao          => vdataprorrogacao,
                                                                            pdatapagamento            => vdatenull,
                                                                            pcontapagamento           => vvarnull,
                                                                            pdocestrangeiro           => vvarnull,
                                                                            pidrepresentante          => vnumnull,
                                                                            pparcelamentocomentrada   => vvarnull,
                                                                            pdatavencimentoentrada    => vdatenull,
                                                                            pvalorentradaparcelamento => vnumnull,
                                                                            pquantidadeparcelas       => vnumnull,
                                                                            pdiasprazoparcelas        => vnumnull,
                                                                            pmd5                      => vvarnull,
                                                                            poperacao_dml             => 'U');
                  --
                end;
                ```
        }
        execution {
            sequence: 80
        }
        successMessage {
            successMessage: Processo atualizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 766370973500685460
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('CONCLUIRATENDIMENTO','REJEITARPROTOCOLO','SALVAR')
                ```
        }
    )

    process prorrogar-boleto (
        name: Prorrogar Boleto
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vdata              date   := to_date(:P130_DATAPRORROGACAO2,'DD/MM/RRRR');
                  vqtdparcelasdistr  number := :P130_QUANTIDADEPARCELAS_DISTR;
                  l_json             CLOB;
                  --
                begin 
                  --
                  pck_protocolosatendimentos_fav.prc_realizaprorrogacao(pidprotocoloatendimento => :P130_IDPROTOCOLOATENDIMENTO,
                                                                        pdataprorrogacao        => vdata,
                                                                        pidpedido               => :P130_IDPEDIDO,
                                                                        pidusuario              => :P0_IDUSUARIO,
                                                                        ptipoprorrogacao        => :P130_TIPOPRORROGACAO,
                                                                        pqtdparcelas            => :P130_QUANTIDADEPARCELAS_DISTR );
                  --
                  --registra novos boletos  
                    FOR r IN (
                        SELECT 
                            t.idpagamentopedido
                        FROM vw_vencimentospedidos_fav v
                        JOIN vw_pagamentospedidos_fav t
                          ON v.idvencimentopedido = t.idvencimentopedido
                        JOIN pedidos p on v.idpedido = p.idpedido
                        WHERE v.idpedido           = :P130_IDPEDIDO
                          AND t.ididioma           = :P0_IDIDIOMA
                          AND p.idpais = 1
                          in (1,5,12,17,18,20,26,27,34,36,37,43,44,46,47,48,66) --boleto
                          and v.CODSITUACAOVENCIMENTO = 'V'
                    )
                    LOOP
                
                        BEGIN
                
                            pck_integracao_bb_v2.prc_registra_boleto(
                                p_idpagamentopedido => r.idpagamentopedido,
                                r_json              => l_json
                            );
                
                        EXCEPTION
                            WHEN OTHERS THEN
                
                                DBMS_OUTPUT.PUT_LINE(
                                    'Erro ao reprocessar boleto ' ||
                                    r.idpagamentopedido || ' - ' || SQLERRM
                                );
                
                        END;
                
                    END LOOP;
                  --
                end;
                ```
        }
        execution {
            sequence: 90
        }
        successMessage {
            successMessage: Prorrogação realizada com sucesso com sucesso!
        }
        advanced {
            executionMappingIdentifier: 766371311995685461
        }
        serverSideCondition {
            whenButtonPressed: @confirmar
        }
    )

