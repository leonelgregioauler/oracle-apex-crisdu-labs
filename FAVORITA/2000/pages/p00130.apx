    process consulta-protocolo (
        name: Consulta Protocolo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vdataprotocolo date;
                  vdataprorrogacao date;
                  vdatapagamento date;
                  vvalordepositado number;
                  vdataatendimento date;
                begin
                  --
                  #OWNER#.PCK_PROTOCOLOSATENDIMENTOS_FAV.PRC_PROTOCOLOSATENDIMENTOS( PIDPROTOCOLOATENDIMENTO => :P130_IDPROTOCOLOATENDIMENTO,
                                                                                     PIDFILIAL => :P130_IDFILIAL,
                                                                                     PIDUSUARIOSOLICITOU => :P130_IDUSUARIOSOLICITOU,
                                                                                     PDATAPROTOCOLO => vdataprotocolo,
                                                                                     PIDPEDIDO => :P130_IDPEDIDO,
                                                                                     PSITUACAO => :P130_SITUACAO,
                                                                                     PJUSTIFICATIVA => :P130_JUSTIFICATIVA,
                                                                                     PDATAATENDIMENTO => vdataatendimento,
                                                                                     POBSERVACAOINTERNA => :P130_OBSERVACAOINTERNA,
                                                                                     PIDMOTIVOPROTOCOLO => :P130_IDMOTIVOPROTOCOLO,
                                                                                     PCPF => :P130_CPF,
                                                                                     PIDTIPOPROTOCOLO => :P130_IDTIPOPROTOCOLO,
                                                                                     PIDUSUARIOATENDEU => :P130_IDUSUARIOATENDEU,
                                                                                     PNUMEROCOMPROVANTE => :P130_NUMEROCOMPROVANTE,
                                                                                     PVALORDEPOSITADO => vvalordepositado,
                                                                                     PDATAPRORROGACAO => vdataprorrogacao,
                                                                                     PDATAPAGAMENTO => vdatapagamento,
                                                                                     PCONTAPAGAMENTO => :P130_CONTAPAGAMENTO,
                                                                                     pdocestrangeiro => :P130_DOCESTRANGEIRO,
                                                                                     pidrepresentante => :P130_IDREPRESENTANTE,
                                                                                     pparcelamentocomentrada => :P130_PARCELAMENTOCOMENTRADA,
                                                                                     pdatavencimentoentrada => :P130_DATAVENCIMENTOENTRADA,
                                                                                     pvalorentradaparcelamento => :P130_VALORENTRADAPARCELAMENTO,
                                                                                     pquantidadeparcelas => :P130_QUANTIDADEPARCELAS,
                                                                                     pdiasprazoparcelas => :P130_DIASPRAZOPARCELAS,
                                                                                     PMD5 => :P130_MD5,
                                                                                     POPERACAO_DML =>'S');
                  --
                  :P130_DATAPROTOCOLO := to_char(vdataprotocolo,'DD/MM/RRRR HH24:MI:SS');
                  :P130_VALORDEPOSITADO := to_char(vvalordepositado,'999G999G999G990D00');
                  :P130_DATAPRORROGACAO := to_char(vdataprorrogacao,'DD/MM/RRRR');
                  :P130_DATAPAGAMENTO := to_char(vdatapagamento,'DD/MM/RRRR');
                  :P130_DATAATENDIMENTO := to_char(vdataatendimento,'DD/MM/RRRR HH24:MI:SS');
                  --
                end;
                ```
