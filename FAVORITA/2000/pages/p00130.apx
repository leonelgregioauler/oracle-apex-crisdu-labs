            heading {
                heading: Quantidade trocada
                alignment: center
            }
            layout {
                sequence: 2
            }
        )

    )

    region itens-do-pedido-de-troca-deste-protocolo (
        name: Itens do Pedido de Troca deste Protocolo
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct nvl(pck_util_fav.fnc_nomeprodutodetalhado(ip.idprodutodetalhado,1), 'Pedido Muito Antigo')"Nome Produto"
                     , ip.quantidade "Quantidade"
                	 , ipt.idpedidogerado "Pedido Gerado"
                	 , ipt.idprotocoloatendimento "Protocolo"
                from favorita.itenspedidostrocados ipt
                   , itenspedidos ip 
                where ipt.idpedidogerado = ip.idpedido 
                  and ipt.idprotocoloatendimento = :P130_IDPROTOCOLOATENDIMENTO
                
                
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from favorita.protocolosatendimentos pp
                where pp.idprotocoloatendimento = :P130_IDPROTOCOLOATENDIMENTO
                  and pp.idtipoprotocolo = 6
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column "Nome Produto" (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Nome produto
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

