    button cancelar-pedido (
        buttonName: CANCELAR_PEDIDO
        label: Cancelar pedido
        layout {
            sequence: 60
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--danger
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P130_IDTIPOPROTOCOLO = 1
                  and :P130_DATAATENDIMENTO is not null
                  and pck_util.fnc_verificaacesso(28706,v('APP_USER')) = 'S'
                  and :P130_SITUACAO = 'P'
                  and not exists ( select 1 
                                   from classificacoespedidos c
                                   where c.idpedido = :P130_IDPEDIDO
                                     and c.idcaracteristicapedido = 25 )
                  and ( exists  ( select 1 
                                 from classificacoespedidos c
                                 where c.idpedido = :P130_IDPEDIDO
                                   and c.idcaracteristicapedido = 8
                                   and c.idvalorcaracteristica = 3 
                                   and exists ( select 1
                                                from classificacoespedidos cc
                                                where cc.idpedido = c.idpedido
                                                  and cc.idcaracteristicapedido = 53 ) )
                             or not exists ( select 1 
                                             from classificacoespedidos c
                                             where c.idpedido = :P130_IDPEDIDO
                                               and c.idcaracteristicapedido = 25 ) )
                ```
        }
    )

    button concluiratendimento (
        buttonName: CONCLUIRATENDIMENTO
        label: Concluir Atendimento
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
        }
