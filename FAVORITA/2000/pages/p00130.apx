    dynamicAction abre-tela-para-incluir-os-itens (
        name: Abre tela para Incluir os itens
        execution {
            sequence: 30
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where not exists ( select 1
                                   from itensdevolucaopedidos i
                                   where i.idprotocoloatendimento = :P130_IDPROTOCOLOATENDIMENTO)
                  and :P130_IDTIPOPROTOCOLO = 1
                  and not exists ( select 1
                                   from roman.usuariosgruposatendimento ug
                                   where ug.usuario = v('APP_USER'))
                  and 1 = 2                   
                ```
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: DEVOLUCAO
                showProcessing: false
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction abre-tela-para-incluir-os-protocolos (
        name: Abre tela para Incluir os protocolos
        execution {
            sequence: 40
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P130_IDTIPOPROTOCOLO = 10
                  and :P130_DATAATENDIMENTO is not null
                  and not exists ( select 1
                                   from protocolospedidos p
                                   where p.idprotocoloatendimento = :P130_IDPROTOCOLOATENDIMENTO )
                ```
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: ROUBO
                showProcessing: false
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction adiciona-itens-automaticamente (
        name: Adiciona itens automaticamente
        execution {
            sequence: 50
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P130_IDTIPOPROTOCOLO = 1
                  and exists ( select 1
                               from itenspedidos p
                               where p.idpedido = :P130_IDPEDIDO )
                  and not exists ( select 1
                                   from itensdevolucaopedidos it 
                                   where it.idpedido = :P130_IDPEDIDO 
                                     and it.idprotocoloatendimento = :P130_IDPROTOCOLOATENDIMENTO )
                  and :P130_SITUACAO = 'P'
                  /*
                  where not exists ( select 1
                                   from filiaisfavorita f
                                   where f.idfilialfavorita = :P0_IDFILIALFAVORITA
                                     and f.tipofilial       = 'L' )
                  and :P130_IDTIPOPROTOCOLO = 1
                  and exists ( select 1
                               from itenspedidos p
                               where p.idpedido = :P130_IDPEDIDO )
                  and exists ( select 1
                               from usuarios u
                               where u.idusuario = :P0_IDUSUARIO
                                 and exists ( select 1
                                              from roman.usuariosgruposatendimento ug
                                              where ug.usuario = u.usuario ) )
                  and not exists ( select 1
                                   from itensdevolucaopedidos it 
                                   where it.idpedido = :P130_IDPEDIDO 
                                     and it.idprotocoloatendimento = :P130_IDPROTOCOLOATENDIMENTO )
                  and :P130_SITUACAO = 'P'*/
                ```
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: AUTOMATICO
                showProcessing: false
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction esconder-campos (
        name: Esconder campos
        execution {
            sequence: 60
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: item=value
            item: P130_IDTIPOPROTOCOLO
            value: 10
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P130_CPF
                    P130_NOMEPESSOA
                    P130_DOCESTRANGEIRO
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P130_CPF
                    P130_NOMEPESSOA
                    P130_DOCESTRANGEIRO
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    dynamicAction inicia-atendimento (
        name: Inicia Atendimento
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @iniciaratendimento
        }
        clientSideCondition {
            type: item!=value
            item: P130_IDTIPOPROTOCOLO
            value: 10
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: INICIARATENDIMENTO
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction setar-apenas-1-parcela-para-consultora (
        name: Setar apenas 1 parcela para consultora
        execution {
            sequence: 70
        }
        when {
            event: click
            selectionType: region
            region: @prorrogação
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                :P130_IDTIPOPROTOCOLO = 2 and
                not exists ( select 1
                             from classificacoespedidos 
                             where idpedido = :P130_IDPEDIDO
                             and idcaracteristicapedido = 28 );
                ```
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: items
                items: P130_QUANTIDADEPARCELAS_DISTR
            }
            execution {
                sequence: 20
            }
        )

        action native-set-value (
            action: setValue
            settings {
                value: 1
            }
            affectedElements {
                selectionType: items
                items: P130_QUANTIDADEPARCELAS_DISTR
            }
            execution {
                sequence: 10
            }
        )

    )

    validation concluir-protocolo-troca-so-com-pedido-gerado (
        name: Concluir Protocolo Troca so com Pedido Gerado
        execution {
            sequence: 60
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                  select distinct i.idpedidogerado
                  from favorita.itenspedidostrocados i
                  where i.idprotocoloatendimento = :P130_IDPROTOCOLOATENDIMENTO
                    and i.idpedido = :P130_IDPEDIDO;
                ```
        }
        error {
            errorMessage: O Pedido de troca ainda não foi gerado, favor gerar o pedido antes de concluir o protocolo
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                v('REQUEST') = 'CONCLUIRATENDIMENTO'
                and :P130_IDTIPOPROTOCOLO = 6
                ```
        }
    )

    validation data-prorrogação-dia-atual (
        name: Data Prorrogação < Dia Atual
        execution {
            sequence: 30
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where to_date(:P130_DATAPRORROGACAO) < trunc(sysdate) 
                  and :P130_IDTIPOPROTOCOLO = 8
                ```
        }
        error {
            errorMessage: Não é permitido datas menores que o dia atual! Verifique a data informada!
        }
        serverSideCondition {
            whenButtonPressed: @confirmar
            type: item=value
            item: P130_IDTIPOPROTOCOLO
            value: 8
        }
    )

    validation obrigatório-pedido-estar-cancelado-para-concluir-protocolo-de-cancelamento (
        name: Obrigatório pedido estar cancelado para concluir protocolo de cancelamento
        execution {
            sequence: 50
        }
        validation {
            language: sql
            sqlExpression:
                ```sql
                :P130_IDTIPOPROTOCOLO = 1
                and exists ( select 1 
                             from classificacoespedidos c
                             where c.idpedido = :P130_IDPEDIDO
                             and c.idcaracteristicapedido = 25 )
                ```
        }
        error {
            errorMessage: O pedido deve estar cancelado para concluir o protocolo de cancelamento.
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'CONCLUIRATENDIMENTO' and :P130_IDTIPOPROTOCOLO = 1;
        }
    )

    validation valida-observação-interna (
        name: Valida Observação Interna
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P130_OBSERVACAOINTERNA
        }
        error {
            errorMessage: Por favor, informe uma observação!
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('CONCLUIRATENDIMENTO','REJEITARPROTOCOLO')
                ```
        }
    )

    validation valida-tipo-de-prorrogação (
        name: Valida tipo de prorrogação
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P130_TIPOPRORROGACAO
        }
        error {
            errorMessage: Selecione o tipo da Prorrogação
        }
        serverSideCondition {
            whenButtonPressed: @confirmar
        }
    )

    validation valída-conclusão-do-atendimento-de-roubo (
        name: Valída conclusão do atendimento de roubo
        execution {
            sequence: 40
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where not exists ( select 1
                                   from vencimentospedidos v
                                   where exists ( select 1
                                                  from protocolospedidos pp
                                                  where pp.idpedido = v.idpedido
                                                    and pp.idprotocoloatendimento = :P130_IDPROTOCOLOATENDIMENTO ) 
                                     and exists ( select 1
                                                  from pagamentospedidos pg
                                                  where pg.idvencimentopedido = v.idvencimentopedido 
                                                    and pg.idformapagamento   = 10 ) 
                                     and v.situacaovencimento = 'V' )
                ```
        }
        error {
            errorMessage: O protocolo não foi realizado todos os procedimentos, revise os pedidos informados!
        }
        serverSideCondition {
            whenButtonPressed: @concluiratendimento
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P130_IDTIPOPROTOCOLO = 10
                ```
        }
    )

    process cancela-pagamento (
        name: Cancela Pagamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vnumbernull              number        := null;
                  vvarnull                 varchar2(1)   := null;
                  vdatenull                date          := null;
                  vclob                    clob          := null;
                  vidpagamentopedido       number;
                  vidsituacaopagamento     number        := -1;
                  --
                  voperacao_dml            varchar2(1)   := 'U';
                  vmd5                     varchar2(50);
                  --
                begin
                  --
                  begin
                    for i in ( select idpagamentopedido
                               from pagamentospedidos  pp
                                  , vencimentospedidos vp
                               where pp.idvencimentopedido = vp.idvencimentopedido 
                                and ( vp.idpedido = :P130_IDPEDIDO
                                   or vp.idpedido in ( select pp.idpedido
                                                       from pagamentosprotocolos pp
                                                       where pp.idprotocoloatendimento = :P130_IDPROTOCOLOATENDIMENTO ) ) 
                                and vp.situacaovencimento = 'V'
                                and trunc(vp.datavencimento) = ( select trunc(min(v.datavencimento))
                                                                 from vencimentospedidos v
                                                                 where v.idpedido = vp.idpedido
                                                                 and v.situacaovencimento = 'V')
                                and exists ( select 1
                                             from pagamentospedidos pgto
                                             where pgto.idpagamentopedido = pp.idpagamentopedido 
                                             and pgto.idformapagamento = 4
                                             and pgto.idsituacao not in (-1, 20) ) )
                    loop
                      --
                      pck_pedidos_fav.prc_pagamentospedidos ( pidpagamentopedido   => i.idpagamentopedido,
                                                              pidvencimentopedido  => vnumbernull,
                                                              pidformapagamento    => vnumbernull,
                                                              pdatapagamento       => vdatenull,
                                                              pvalorpago           => vnumbernull,
                                                              porigempagamento     => vvarnull,
                                                              pnumeroboleto        => vvarnull,
