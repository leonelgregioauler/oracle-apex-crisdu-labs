    button iniciaratendimento (
        buttonName: INICIARATENDIMENTO
        label: Iniciar Atendimento
        layout {
            sequence: 40
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P130_IDUSUARIOATENDEU is null
                  and :P130_DATAATENDIMENTO is null
                  and :P130_SITUACAO not in ('R') 
                  and pck_util.fnc_verificaacesso(28706,v('APP_USER')) = 'S'
                  and exists ( select 1
                               from permissoestiposprotocolos p
                               where p.idusuario = :P0_IDUSUARIO
                                 and p.idtipoprotocolo = :P130_IDTIPOPROTOCOLO
                                 and p.atender = 'S' )
                  and (( :P130_IDTIPOPROTOCOLO = 1 and  ( select count(1)
                                                        from itensdevolucaopedidos id
                                                        where id.idpedido = :P130_IDPEDIDO
                                                          and id.quantidade > 0
                                                          and id.idprotocoloatendimento = :P130_IDPROTOCOLOATENDIMENTO ) = ( select count(1)
                                                                                                                             from itenspedidos i
                                                                                                                             where i.idpedido = :P130_IDPEDIDO
                                                                                                                               and i.quantidade > 0 ) 
                                                   or not exists ( select 1
                                                               from movimentosestoques me
                                                               where exists ( select 1
                                                                              from itenspedidos i
                                                                              where i.idpedido = :P130_IDPEDIDO 
                                                                                and i.iditempedido = me.iditempedido ) ) )
                    or :P130_IDTIPOPROTOCOLO != 1  )
                ```
        }
    )

