    pageItem P130_SESSION_IMPRIMIR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 310
            region: @protocolo-de-atendimento
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_url varchar2(2000);
                    l_app number := 2000;
                    l_session number := v('APP_SESSION');
                BEGIN
                    l_url := APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p=' || l_app || ':86:'||l_session||'::NO::P86_IDPEDIDO:'||:P130_IDPEDIDO,
                        p_checksum_type => 'SESSION');
                    
                    return l_url;
                END;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P130_SESSION_PEDIDO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 280
            region: @protocolo-de-atendimento
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_url varchar2(2000);
                    l_app number := 2000;
                    l_session number := v('APP_SESSION');
                    vidpedido number;
                BEGIN
                  --
                  if pck_util_fav.fnc_retornapedidowidecommerce(:P130_IDPEDIDO) is null then
                    --
                    l_url := APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p=' || l_app || ':68:'||l_session||'::NO::P68_IDPEDIDO:'||:P130_IDPEDIDO,
                        p_checksum_type => 'SESSION');
                    --
                  elsif pck_util_fav.fnc_retornapedidowidecommerce(:P130_IDPEDIDO) is not null then
                    --
                    l_url := APEX_UTIL.PREPARE_URL(
                      p_url => 'f?p=' || l_app || ':415:'||l_session||'::NO::P415_IDPEDIDO:'||:P130_IDPEDIDO,
                      p_checksum_type => 'SESSION');
                    --
                  end if;
                  --
                  return l_url;
                exception
                  when others then 
                     null;
                END;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

