    region itens-devolvidos-do-pedido-original (
        name: Itens Devolvidos do Pedido Original
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pf.nomeproduto "Nome Produto"
                     , pf.quantidadetrocada "Quantidade Trocada"
                     , :P130_IDPEDIDO "Pedido Origem"
                     , pf.idprotocoloatendimento "Protocolo Atendimento"
                from vw_produtostrocadosprot_fav pf
                where exists( select i.iditempedido
                              from favorita.itenspedidos i
                              where i.iditempedido = pf.iditempedidoorigem
                                and i.idpedido = :P130_IDPEDIDO)
                  and pf.idprotocoloatendimento = :P130_IDPROTOCOLOATENDIMENTO;
                ```
        }
        layout {
            sequence: 50
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from favorita.protocolosatendimentos pp
                where pp.idprotocoloatendimento = :P130_IDPROTOCOLOATENDIMENTO
                  and pp.idtipoprotocolo = 6
                ```
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column "Nome Produto" (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Nome produto
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column "Pedido Origem" (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Pedido origem
                alignment: center
            }
            layout {
                sequence: 3
            }
        )

        column "Protocolo Atendimento" (
