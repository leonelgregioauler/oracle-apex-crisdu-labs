page 130 (
    name: Cadastro de Protocolo de Atendimento
    title: Cadastro de Protocolo de Atendimento
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function abrepedido() 
            {
              vurl = document.getElementById("P130_SESSION_PEDIDO").value;
              pjan = window.open(vurl);
              pjan.focus();
            }
            
            function abrevencimento() 
            {
              vurl = document.getElementById("P130_SESSION_VENCIMENTO").value;
              pjan = window.open(vurl);
              pjan.focus();
            }
            
            
            function imprimeboleto()
            {
              var idpedido = document.getElementById("P130_IDPEDIDO").value;
              var idvendedora = document.getElementById("P130_IDVENDEDORA").value;
                
              /*vurl = 'https://boleto.romancemoda.com.br/boleto_bb_favorita_sem_iframe_com_pix_v2.php?cod1='+idpedido+'&cod2='+idvendedora;*/
              vurl = document.getElementById('P0_URLBOLETOBASE').value+'?cod1='+idpedido+'&cod2='+idvendedora;
              pjan = window.open(vurl,'boleto','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1024,height=1000,left=20,top=10','_blank'); 
              pjan.focus();
            }
            
            function imprimepedido()
            {
              vurl = document.getElementById("P130_SESSION_IMPRIMIR").value;
              pjan = window.open(vurl,'popup','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1024,height=1000,left=20,top=10','_blank'); 
              pjan.focus();
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

