    process gera-novo-boleto-com-juros (
        name: Gera Novo Boleto com Juros
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                    l_json       CLOB;
                begin
                  -- Call the procedure
                  pck_protocolosatendimentos_fav.prc_alteracaovalorboleto(pidprotocolo => :P130_IDPROTOCOLOATENDIMENTO,
                                                                          pidusuario => :P0_IDUSUARIO,
                                                                          pdatavencimento => :P130_DATAPRORROGACAO);
                  --
                  --registra novos boletos  
                    FOR r IN (
                        SELECT 
                            t.idpagamentopedido
                        FROM vw_vencimentospedidos_fav v
                        JOIN vw_pagamentospedidos_fav t
                          ON v.idvencimentopedido = t.idvencimentopedido
                        JOIN pedidos p on v.idpedido = p.idpedido
                        WHERE v.idpedido           = :P130_IDPEDIDO
                          AND t.ididioma           = :P0_IDIDIOMA
                          AND p.idpais = 1
                          and t.IDFORMAPAGAMENTO in (1,5,12,17,18,20,26,27,34,36,37,43,44,46,47,48,66) --boleto
                          and v.CODSITUACAOVENCIMENTO = 'V'
                    )
                    LOOP
                
                        BEGIN
                
                            pck_integracao_bb_v2.prc_registra_boleto(
                                p_idpagamentopedido => r.idpagamentopedido,
                                r_json              => l_json
                            );
                
                        EXCEPTION
                            WHEN OTHERS THEN
                
                                DBMS_OUTPUT.PUT_LINE(
                                    'Erro ao reprocessar boleto ' ||
                                    r.idpagamentopedido || ' - ' || SQLERRM
                                );
                
                        END;
                
                    END LOOP;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 130
        }
        successMessage {
            successMessage: Novo boleto com juros gerado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 766372587624685461
        }
        serverSideCondition {
            whenButtonPressed: @gerar-novo-boleto
        }
    )

