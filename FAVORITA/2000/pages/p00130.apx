    process inclui-histórico-no-pedido-de-troca (
        name: Inclui Histórico no Pedido de Troca
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidhistorico    number          := null;
                  vidpedido       number          := :P130_IDPEDIDO;
                  vdata           date            := sysdate;
                  vidusuario      number          := :P130_IDUSUARIOSOLICITOU;
                  vhistorico      varchar2(4000)  := :P130_JUSTIFICATIVA;
                  vvarchar        varchar2(1)     := null;
                  vmd5            varchar2(50);
                  vidpedidogerado number;
                begin
                  --
                  pck_pedidos_fav.prc_historicospedidos( pidhistoricopedido => vidhistorico,
                                                         pidpedido          => vidpedido,
                                                         pdatahistorico     => vdata,
                                                         pidusuario         => vidusuario,
                                                         pdescricao         => vhistorico,
                                                         pimprimirnopedido  => vvarchar,
                                                         pliberaedicao      => vvarchar,
                                                         pmd5               => vmd5,
                                                         poperacao_dml      => 'I' );
                  --
                  select distinct i.idpedidogerado
                  into   vidpedidogerado
                  from favorita.itenspedidostrocados i
                  where i.idprotocoloatendimento = :P130_IDPROTOCOLOATENDIMENTO
                    and i.idpedido = :P130_IDPEDIDO;
                  --
                  vidhistorico               := null;
                  vidpedido                  := :P130_IDPEDIDO;
                  vdata                      := sysdate;
                  vidusuario                 := :P130_IDUSUARIOSOLICITOU;
                  vhistorico                 := :P130_JUSTIFICATIVA;
                  vvarchar                   := null;
                  vmd5                       := null;
                  --
                end;
                ```
