    region pedidos-roubados (
        name: Pedidos Roubados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpedido
                     , p.numeropedido
                     , p.vendedora
                     , p.dataemissao
                     , p.dataentrega
                     , p.datavencimento
                     , p.valortotal
                     , p.valorapagar
                     , p.situacaoentregainterno
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||p.idpedido ,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' urlpedido
                from vw_pedidos_fav p
                   , protocolospedidos pp
                where p.ididioma  = 1
                  and pp.idpedido = p.idpedido
                  and pp.idprotocoloatendimento = :P130_IDPROTOCOLOATENDIMENTO
                order by 3
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from protocolospedidos p
                where p.idprotocoloatendimento = :P130_IDPROTOCOLOATENDIMENTO
                ```
        }
