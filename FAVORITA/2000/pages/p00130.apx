    region itens-que-estão-sendo-devolvidos (
        name: Itens que estão sendo Devolvidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select if.iditemdevolucaopedido
                     , if.iditempedido
                     , if.idpedido
                     , if.idproduto
                     , if.idprodutodetalhado
                     , if.nomeprodutodetalhado
                     , if.quantidade
                     , if.idprotocoloatendimento
                     , if.confirmacaoestoque
                     , if.dataconfirmacaoestoque
                     , if.usuarioestoque
                     , if.confirmacaofiscal
                     , if.dataconfirmacaofiscal
                     , if.usuariofiscal
                from vw_itensdevolucaopedidos_fav if
                where if.ididioma = 1
                  and if.idprotocoloatendimento = :P130_IDPROTOCOLOATENDIMENTO
                  and if.idpedido = :P130_IDPEDIDO
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from vw_itensdevolucaopedidos_fav if
                where if.ididioma = 1
                  and if.idprotocoloatendimento = :P130_IDPROTOCOLOATENDIMENTO
                  and if.idpedido = :P130_IDPEDIDO
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
