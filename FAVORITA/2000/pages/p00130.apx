    process inclui-pagamento (
        name: Inclui Pagamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vnumbernull           number;
                  vvarnull              varchar2(1);
                  vdatenull             date          := null;
                  vclob                 clob;
                  vidpagamentoprotocolo number;
                  vdatapagamento        date;
                  vidformapagamento     number        := 4;
                  vorigempagamento      varchar2(1)   := 'V';
                  vidsituacaopagamento  number        := 40;
                  vvalororiginal        number(15,2);
                  vtaxa                 number(15,2)  := 0;
                  vjuros                number(15,2)  := 0;
                  vacrescimo            number(15,2)  := 0;
                  vdesconto             number(15,2);
                  vvalorliquido         number(15,2);
                  vvalordepositado      number(15,2);
                  vidpedido             number;
                  vidvencimentopedido   number;
                  vdatavencimento       date;
                  vvalorpagar           number(15,2);
                  vvalorpago            number(15,2);
                  voperacao_dml         varchar2(1) := 'I';
                  vmd5 varchar2(50);
                  l_json       CLOB;
                begin
                  --
                  vdatapagamento   := to_date(:P130_DATAPAGAMENTO, 'dd/mm/rrrr');
                  vvalordepositado := to_number(:P130_VALORDEPOSITADO, '999G999G999G990D00'); 
                  --
                  select vp.idpedido
                       , vp.idvencimentopedido
                       , vp.datavencimento
                       , vp.valorpagar
                       , vp.valorpago
                       , vp.saldo
                       , case 
                         when (to_date(:P130_DATAPAGAMENTO, 'DD/MM/RRRR') > trunc(sysdate) and vp.saldo > 0)
                           or (to_date(:P130_DATAPAGAMENTO, 'DD/MM/RRRR') > vp.datavencimento and vp.saldo > 0) then
                             pck_util_fav.fnc_calculajuros( pvalororiginal      => vp.saldo,
                                                            pdatavencimentoorig => vp.datavencimento,
                                                            pdatavencimentonovo => to_date(:P130_DATAPAGAMENTO,'DD/MM/RRRR'),
                                                            ppercmulta          => 2,
                                                            ppercjuros          => 1)                                         
                         else
                           vp.valoratualizado
                       end valorliquido
                  into vidpedido
                     , vidvencimentopedido
                     , vdatavencimento
                     , vvalorpagar
                     , vvalorpago
                     , vvalororiginal
                     , vvalorliquido
                  from vw_vencimentospedidos_fav vp
                  where vp.idpedido = :P130_IDPEDIDO
                  and vp.codsituacaovencimento = 'V'
                  and trunc(vp.datavencimento) = 
                    ( select trunc(min(v.datavencimento))
                      from vencimentospedidos v
                      where v.idpedido = vp.idpedido
                      and v.situacaovencimento = 'V' );
                  --
                  vdatapagamento := to_date(:P130_DATAPAGAMENTO,    'DD/MM/RRRR');
                  --
                  vdatapagamento := to_date(:P130_DATAPAGAMENTO,    'DD/MM/RRRR');
                  --
                  if to_date(vdatapagamento, 'DD/MM/RRRR') > to_date(vdatavencimento, 'DD/MM/RRRR') and (vvalordepositado > vvalororiginal) then
                    vjuros     := vvalorliquido - vvalororiginal;
                    vacrescimo := vvalordepositado - vvalorliquido; 
                  elsif (to_date(vdatapagamento, 'DD/MM/RRRR') <= to_date(vdatavencimento, 'DD/MM/RRRR')) and
                    (vvalorliquido >= vvalororiginal) and (vvalordepositado > vvalororiginal) then
                    vacrescimo := vvalordepositado - vvalororiginal;
                  elsif vvalordepositado < vvalororiginal then
                    vdesconto := vvalororiginal - vvalordepositado;
                  end if;
                  --
                  if vjuros < 0 then
                    vjuros := 0;
                  end if;
                  --
                  insert into teste values('TESTE PAGAMENTO',';vnumbernull->'||vnumbernull||';vidvencimentopedido->'||vidvencimentopedido||';vidformapagamento->'||vidformapagamento||
                                           ';vdatapagamento->'||vdatapagamento||';vvalororiginal->'||vvalororiginal||';vorigempagamento->'||vorigempagamento||
                                           ';vvarnull->'||vvarnull||';vidsituacaopagamento->'||vidsituacaopagamento||';vnumbernull->'||vnumbernull||
                                           ';vjuros->'||vjuros||';vacrescimo->'||vacrescimo||';vdesconto->'||vdesconto||
                                           ';vvalordepositado->'||vvalordepositado||';P130_NUMEROCOMPROVANTE->'||:P130_NUMEROCOMPROVANTE||
                                           ';P130_CONTAPAGAMENTO->'||:P130_CONTAPAGAMENTO||';P130_OBSERVACAOINTERNA->'||:P130_OBSERVACAOINTERNA||
                                           ';P130_IDUSUARIOSOLICITOU->'||:P130_IDUSUARIOSOLICITOU,'','','');
                  --
                 pck_pedidos_fav.prc_pagamentospedidos 
                ( vnumbernull              , vidvencimentopedido
                , vidformapagamento        , vdatapagamento
                , vvalororiginal           , vorigempagamento
                , vvarnull                 , vidsituacaopagamento
                , vnumbernull              , vjuros
                , vacrescimo               , vdesconto
                , vvalordepositado         , :P130_NUMEROCOMPROVANTE
                , :P130_CONTAPAGAMENTO     , :P130_OBSERVACAOINTERNA
                , :P130_IDUSUARIOSOLICITOU , vnumbernull
                , vclob                    , vclob 
                , vvarnull                 , vnumbernull
                , vvarnull                 -- pjustificativadescacresc
                , vnumbernull              -- pidfechamento
                , vvarnull                 -- plinkboleto
                , vvarnull                 -- pcanalpagamento
                , voperacao_dml
                , vmd5 );
                  --
                    --registra novos boletos  
                    FOR r IN (
                        SELECT 
                            t.idpagamentopedido
                        FROM vw_vencimentospedidos_fav v
                        JOIN vw_pagamentospedidos_fav t
                          ON v.idvencimentopedido = t.idvencimentopedido
                        JOIN pedidos p on v.idpedido = p.idpedido
                        WHERE v.idpedido           = vidpedido
                          AND t.ididioma           = :P0_IDIDIOMA
                          AND p.idpais = 1
                          and t.IDFORMAPAGAMENTO in (1,5,12,17,18,20,26,27,34,36,37,43,44,46,47,48,66) --boleto
                          and v.CODSITUACAOVENCIMENTO = 'V'
                    )
                    LOOP
                
                        BEGIN
                
                            pck_integracao_bb_v2.prc_registra_boleto(
                                p_idpagamentopedido => r.idpagamentopedido,
                                r_json              => l_json
                            );
                
                        EXCEPTION
                            WHEN OTHERS THEN
                
                                DBMS_OUTPUT.PUT_LINE(
                                    'Erro ao reprocessar boleto ' ||
                                    r.idpagamentopedido || ' - ' || SQLERRM
                                );
                
                        END;
                
                    END LOOP;
                  --
                end;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 1444693279146987336
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                v('REQUEST') = 'INICIARATENDIMENTO'
                and :P130_IDTIPOPROTOCOLO in (11,3)
                ```
        }
    )

