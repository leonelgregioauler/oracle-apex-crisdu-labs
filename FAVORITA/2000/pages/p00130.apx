        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P130_IDUSUARIOATENDEU is not null
                  and :P130_DATAATENDIMENTO is not null
                  and :P130_SITUACAO = 'P'
                  and pck_util.fnc_verificaacesso(28706,v('APP_USER')) = 'S'
                  and ( :P130_IDTIPOPROTOCOLO = 1 and( exists ( select 1
                                                                from itensdevolucaopedidos i
                                                                where i.idpedido = :P130_IDPEDIDO
                                                                  and i.idprotocoloatendimento = :P130_IDPROTOCOLOATENDIMENTO)
                                                        or not exists ( select 1
                                                                        from favorita.itenspedidos ie
                                                                        where ie.idpedido = :P130_IDPEDIDO))
                     or exists (select 1
                                 from favorita.pedidos p
                                 where p.idpedido = :P130_IDPEDIDO
                                   and p.idsituacaoentrega > 20000)
                     or :P130_IDTIPOPROTOCOLO != 1)
                ```
        }
    )

