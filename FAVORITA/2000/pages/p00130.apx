    pageItem P130_AVISO_BOLETO_COM_JUROS (
        type: displayOnly
        label {
            label: Atenção:
            alignment: left
        }
        layout {
            sequence: 50
            region: @avisos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            postText: <font color="red"><h2> Esse pedido já possui um protocolo de prorrogação com juros, pois já consta um boleto com valor atualizado! </h2> </font>
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                                from classificacoespedidos c
                                where c.idpedido = :P130_IDPEDIDO
                                  and c.idcaracteristicapedido = 36 )
                  and :P130_IDTIPOPROTOCOLO = 8
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P130_AVISO_CARTAO_CREDITO (
        type: displayOnly
        label {
            label: Atenção:
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 30
            region: @avisos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            preText: <font color="red"> <h2> Esse pedido não pode ser cancelado por Protocolo, pois a Forma de Pagamento é Cartão de Crédito. Efetue o Procedimento Manual! </h2> </font>
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P130_IDTIPOPROTOCOLO = 1
                  and :P130_DATAATENDIMENTO is not null
                  and pck_util.fnc_verificaacesso(28706,v('APP_USER')) = 'S'
                  and :P130_SITUACAO = 'P'
                  and not exists ( select 1 
                                   from classificacoespedidos c
                                   where c.idpedido = :P130_IDPEDIDO
                                     and c.idcaracteristicapedido = 25 )
                  and not exists ( select 1 
                                   from classificacoespedidos c
                                   where c.idpedido = :P130_IDPEDIDO
                                     and c.idcaracteristicapedido = 53 )
                  and exists ( select 1 
                               from classificacoespedidos c
                               where c.idpedido = :P130_IDPEDIDO
                                and c.idcaracteristicapedido = 8
                                and c.idvalorcaracteristica = 3)
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P130_AVISO_CONCLUIR_ATENDIMENTO_SEMVIRTUAL (
        type: displayOnly
        label {
            label: Atenção:
            alignment: left
        }
        layout {
            sequence: 80
            region: @avisos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            postText: <font color="red"><h2> Para finalizar o atendimento do Protocolo é necessário que o Estoque confirme o recebimento de todas mercadorias!</h2> </font>
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where exists ( select 1
                               from pedidos p
                               where p.idpedido = :P130_IDPEDIDO
                                 and p.idpedidovirtualage is null
                                 and p.idfilialromance in (100,120,121,140,1041,123) )
                  and :P130_SITUACAO = 'P'
                  and ( select count(1)
                        from itensdevolucaopedidos id
                        where id.idpedido = :P130_IDPEDIDO
                          and id.idprotocoloatendimento = :P130_IDPROTOCOLOATENDIMENTO ) != ( select count(1)
                                                                                             from itensdevolucaopedidos id
                                                                                             where id.idpedido = :P130_IDPEDIDO
                                                                                               and id.idprotocoloatendimento = :P130_IDPROTOCOLOATENDIMENTO
                                                                                               and id.confirmacaoestoque is not null )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P130_AVISO_CONCLUIR_ATENDIMENTO_VIRTUAL (
        type: displayOnly
        label {
            label: Atenção:
            alignment: left
        }
        layout {
            sequence: 70
            region: @avisos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            postText: <font color="red"><h2> Para finalizar o atendimento do Protocolo é necessário que o Estoque confirme o recebimento de todas mercadorias e o Fiscal precisa realizar os ajustes no sistema!</h2> </font>
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where exists ( select 1
                               from pedidos p
                               where p.idpedido = :P130_IDPEDIDO
                                 and p.idpedidovirtualage is not null  )
                  and :P130_SITUACAO = 'P'
                  and ( select count(1)
                        from itensdevolucaopedidos id
                        where id.idpedido = :P130_IDPEDIDO
                          and id.idprotocoloatendimento = :P130_IDPROTOCOLOATENDIMENTO ) != ( select count(1)
                                                                                             from itensdevolucaopedidos id
                                                                                             where id.idpedido = :P130_IDPEDIDO
                                                                                               and id.idprotocoloatendimento = :P130_IDPROTOCOLOATENDIMENTO
                                                                                               and id.confirmacaoestoque is not null
                                                                                               and id.confirmacaofiscal  is not null )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P130_AVISO_DEVOLUCAO_ITENS (
        type: displayOnly
        label {
            label: Atenção:
            alignment: left
        }
        layout {
            sequence: 60
            region: @avisos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            postText: <font color="red"><h2> Não foi informado todos os itens para devolução, não será possivel atender o protocolo. Favor revise os itens informados!</h2> </font>
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from dual
                where ( select count(1)
                        from itensdevolucaopedidos id
                        where id.idpedido = :P130_IDPEDIDO
                          and id.quantidade > 0 
                          and id.idprotocoloatendimento = :P130_IDPROTOCOLOATENDIMENTO ) != ( select count(1)
                                                                                              from itenspedidos i
                                                                                              where i.idpedido = :P130_IDPEDIDO
                                                                                                and i.quantidade > 0 ) 
                  and exists ( select 1
                               from movimentosestoques me
                               where exists ( select 1
                                              from itenspedidos i
                                              where i.idpedido = :P130_IDPEDIDO 
                                                and i.iditempedido = me.iditempedido ) )
                   and :P130_IDTIPOPROTOCOLO = 1
                   and :P130_SITUACAO = 'P'
                                                         
                 
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P130_AVISO_REJEITA_CANCELAMENTO (
        type: displayOnly
        label {
            label: Atenção:
            alignment: left
        }
        layout {
            sequence: 40
            region: @avisos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            postText: <font color="red"><h2> Esse pedido não pode ser desfeito o cancelamento, pois já passou do prazo determinado ( 1 hora )! </h2> </font>
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where sysdate -
                      ( select dataclassificado
                        from classificacoespedidos c
                        where c.idpedido = :P130_IDPEDIDO
                          and c.idcaracteristicapedido = 25 ) > 0.0416666666666667
                  and :P130_IDTIPOPROTOCOLO = 7
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P130_CONTAPAGAMENTO (
        type: selectList
        label {
            label: Conta
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.beneficiario||' ('||b.nomebanco||' - Ag: '||c.agencia||'- CC: '||c.conta||')' d
                     , c.idcontabanc r
                from roman.contasbancarias c
                   , roman.bancos b
                where b.idbanco = c.idbanco
                  and c.ativo = 'S'
                  and c.usosetorcobranca = 'S'
                order by 1;
                ```
        }
        layout {
            sequence: 240
