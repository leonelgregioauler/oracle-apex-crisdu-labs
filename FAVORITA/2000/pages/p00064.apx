page 64 (
    name: Cadastro de Tipos Tarefas
    title: Tipos Tarefas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region tipos-tarefas (
        name: Tipos Tarefas
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P64_ATIVO (
        type: radioGroup
        label {
            label: Ativo
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-simnao
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @tipos-tarefas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P64_DESCRICAO (
        type: textField
        label {
            label: Descrição
            alignment: left
        }
        layout {
            sequence: 20
            region: @tipos-tarefas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 60
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P64_IDTIPOTAREFA (
        type: hidden
        layout {
            sequence: 10
            region: @tipos-tarefas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P64_MD5 (
        type: hidden
        layout {
            sequence: 40
            region: @tipos-tarefas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P64_OPERACAO_DML (
        type: hidden
        layout {
            sequence: 50
            region: @tipos-tarefas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 50
            region: @tipos-tarefas
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P64_IDTIPOTAREFA
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 40
            region: @tipos-tarefas
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P64_IDTIPOTAREFA
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 30
            region: @tipos-tarefas
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 63
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 20
            region: @tipos-tarefas
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P64_IDTIPOTAREFA
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @tipos-tarefas
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P64_IDTIPOTAREFA
        }
    )

    validation descricao-obrigatório (
        name: DESCRICAO obrigatório
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P64_DESCRICAO
        }
        error {
            errorMessage: Descrição deve ter um valor.
            associatedItem: @P64_DESCRICAO
        }
    )

    process consulta-tipos-tarefas (
        name: Consulta Tipos Tarefas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                #OWNER#.PCK_CADASTROS_FAV.PRC_TIPOSTAREFAS (
                  PIDTIPOTAREFA => :P64_IDTIPOTAREFA,
                  PDESCRICAO => :P64_DESCRICAO,
                  PATIVO => :P64_ATIVO,
                  PMD5 => :P64_MD5,
                  POPERACAO_DML => 'S');
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 3421350657300512
        }
    )

    process limpar-campos-ao-sair (
        name: Limpar Campos ao Sair
        type: clearSessionState
        execution {
            sequence: 10
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 3422269749300521
        }
    )

    process limpar-campos-para-adicionar (
        name: Limpar Campos para Adicionar
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 3422361764300522
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    process operação-dml-em-tipos-tarefas (
        name: Operação DML em Tipos Tarefas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  #OWNER#.PCK_CADASTROS_FAV.PRC_TIPOSTAREFAS (
                    PIDTIPOTAREFA => :P64_IDTIPOTAREFA,
                    PDESCRICAO => :P64_DESCRICAO,
                    PATIVO => :P64_ATIVO,
                    PMD5 => :P64_MD5,
                    POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro salvo com sucesso!
        }
        advanced {
            executionMappingIdentifier: 3437610339604827
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 64
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

)

