page 48 (
    name: Relatório de Brindes
    title: Brindes
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region lista-de-brindes (
        name: Lista de Brindes
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idbrinde
                     , nomeprodutodetalhado
                     , filialromance
                     , quantidade
                     , idfilialfavoritaorigem
                     , filialfavoritaorigem origem
                     , qtdpedidosconsultora
                     , valorpedido
                     , edicaorevista
                     , datainicial
                     , datafinal
                     , decode(valorutilizar, 'VP','Valor Pago','VC','Valor Catalogo') valorutilizar
                     , idbrinde  idbrinde2
                from vw_brindes_fav
                where ididioma = :P0_IDIDIOMA
                  and (
                     ( :P48_DATAINICIAL between trunc(datainicial) and trunc(datafinal))
                     or (:P48_DATAFINAL between trunc(datainicial) and trunc(datafinal))
                     or (trunc(datainicial) between nvl(:P48_DATAINICIAL, to_date('01/01/00')) and nvl(:P48_DATAINICIAL, to_date('31/12/25')) )
                     or (trunc(datafinal)   between nvl(:P48_DATAINICIAL, to_date('01/01/00')) and nvl(:P48_DATAINICIAL, to_date('31/12/25')) ) 
                     or (:P48_DATAINICIAL is null and :P48_DATAFINAL is null) 
                     )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 12881902661605633
        }

        savedReport 17942202 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDBRINDE
                layout {
                    width: 53
                    sequence: 1
                }
