page 232 (
    name: Log de Históricos do Pedido
    title: Log de Históricos do Pedido
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region logs-históricos-de-pedido (
        name: Logs Históricos de Pedido
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select h.idpedido 
                     , h.usuarioalteracao
                     , h.dataalteracao
                     , h.desctipoalteracao
                     , h.datahistorico
                     , h.nomeusuario
                     , h.descricao
                     , h.descrimprimirnopedido
                     , h.liberaedicao 
                from VW_LOG_HISTORICOSPEDIDOS_FAV h
                where h.idpedido = :P232_IDPEDIDO
                order by 3 desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1690164902033007510
        }

        column DATAALTERACAO (
            type: plainText
            heading {
                heading: Data Alteração
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column DATAHISTORICO (
            type: plainText
            heading {
                heading: Data Histórico
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: E
            }
        )

        column DESCRICAO (
            type: plainText
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column DESCRIMPRIMIRNOPEDIDO (
            type: plainText
            heading {
                heading: Imprime no Pedido
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column DESCTIPOALTERACAO (
            type: plainText
            heading {
                heading: Tipo Alteração
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column IDPEDIDO (
            type: plainText
            heading {
                heading: Nr Pedido
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column LIBERAEDICAO (
            type: plainText
            heading {
                heading: Libera Edição
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        column NOMEUSUARIO (
            type: plainText
            heading {
                heading: Usuário
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column USUARIOALTERACAO (
            type: plainText
            heading {
                heading: Usuario que Alterou
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 5727465 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAALTERACAO (
                sequence: 3
            )

            displayColumn DATAHISTORICO (
                sequence: 5
            )

            displayColumn DESCRICAO (
                sequence: 7
            )

            displayColumn DESCRIMPRIMIRNOPEDIDO (
                sequence: 8
            )

            displayColumn DESCTIPOALTERACAO (
                sequence: 4
            )

            displayColumn IDPEDIDO (
                sequence: 1
            )

            displayColumn LIBERAEDICAO (
                sequence: 9
            )

            displayColumn NOMEUSUARIO (
                sequence: 6
            )

            displayColumn USUARIOALTERACAO (
                sequence: 2
            )

        )

    )

    pageItem P232_IDPEDIDO (
        type: textField
        label {
            label: Nr Pedido
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 232
                items: {
                    P232_IDPEDIDO: &P232_IDPEDIDO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

