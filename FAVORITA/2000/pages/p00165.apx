    region selecione-a-remessa (
        name: Selecione a Remessa
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P165_IDCOMPRATRANSFERENCIA (
        type: selectList
        label {
            label: Remessa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.numero||' - NF: '||c.notafiscal display_value
                 , c.idcompratransferencia return_value
                from comprastransferencias c
                where c.idsituacao = 40
                  and c.idtipocomptransrem = 2
                  and ( c.idfilialromancedestino = (select roman.pck_romance.fnc_filialusuario(u.usuario)
                                                    from usuarios u
                                                    where u.idusuario = :P0_IDUSUARIO) 
                     or c.idfilialfavoritadestino = :P0_IDFILIALFAVORITA 
                     or v('APP_USER') in ('LUIZV','EVERTON','CESARH') )
                    
                ```
        }
        layout {
            sequence: 10
            region: @selecione-a-remessa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P165_IDFILIAL (
        type: selectList
        label {
            label: Filial
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select vw.nome 
                 , vw.idfilial
                from roman.vw_filiais vw
                where exists ( select 1
                               from atendimentosfiliaisrmc a
                               where a.idfilialdestino = vw.idfilial
                                 and a.idfilialfavoritaorigem = ( select c.idfilialfavoritadestino
                                                                  from comprastransferencias c
                                                                  where c.idcompratransferencia = :P165_IDCOMPRATRANSFERENCIA ) ) 
                order by 1
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 10
            region: @filtros-de-impressão
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P165_IDREPRESENTANTE (
        type: selectList
        label {
            label: Distribuidor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(idrepresentante) display_value
                 , idrepresentante return_value
                from representantes
                where idgerente = ( select idgerente 
                                    from gerentes 
                                    where idfilial = :P165_IDFILIAL )
                  and ativo = 'S'
                order by 1
                ```
            nullDisplayValue: - Todos -
        }
        cascadingLov {
            parentItems: P165_IDFILIAL
        }
        layout {
            sequence: 20
            region: @filtros-de-impressão
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P165_QTDPEDIDOS (
        type: textField
        label {
            label: Total de Pedidos
            alignment: left
        }
        layout {
            sequence: 10
            region: @pedidos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select count(1)
                from pedidosremessasct p
                where p.idcompratransferencia = :P165_IDCOMPRATRANSFERENCIA
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P165_QTDPEDIDOSFALTAIMPRIMIR (
        type: textField
        label {
            label: Pedidos Para Imprimir
            alignment: left
        }
        layout {
            sequence: 30
            region: @pedidos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select count(1)
                from pedidosremessasct p
                where p.idcompratransferencia = :P165_IDCOMPRATRANSFERENCIA
                  and not exists ( select 1
                               from classificacoespedidos c
                               where c.idpedido = p.idpedido
                                 and c.idcaracteristicapedido = 30 )
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P165_QTDPEDIDOSIMPRESSOS (
        type: textField
        label {
            label: Pedidos Impressos
            alignment: left
        }
        layout {
            sequence: 20
            region: @pedidos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select count(1)
                from pedidosremessasct p
                where p.idcompratransferencia = :P165_IDCOMPRATRANSFERENCIA
                  and exists ( select 1
                               from classificacoespedidos c
                               where c.idpedido = p.idpedido
                                 and c.idcaracteristicapedido = 30 )
                ```
            used: always
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P165_QUANTIDADE (
        type: selectList
        label {
            label: Quantidade
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:10;10,20;20,30;30
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @filtros-de-impressão
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: static
            staticValue: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P165_SESSION_LISTA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @pedidos
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_url varchar2(2000);
                    l_app number := 2000;
                    l_session number := v('APP_SESSION');
                BEGIN
                    l_url := APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p=' || l_app || ':148:'||l_session||'::NO::P148_IDCOMPRATRANSFERENCIA:'||:P165_IDCOMPRATRANSFERENCIA,
                        p_checksum_type => 'SESSION');
                    
                    return l_url;
                END;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P165_SESSION_PEDIDO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @pedidos
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_url varchar2(2000);
                    l_app number := 2000;
                    l_session number := v('APP_SESSION');
                BEGIN
                    l_url := APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p=' || l_app || ':166:'||l_session||'::NO::P166_IDCOMPRATRANSFERENCIA,P166_IDREPRESENTANTE,P166_QUANTIDADE:'||:P165_IDCOMPRATRANSFERENCIA||','||:P165_IDREPRESENTANTE||','||:P165_QUANTIDADE,
                        p_checksum_type => 'SESSION');
                    
                    return l_url;
                END;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button buscar (
        buttonName: BUSCAR
        label: Buscar
        layout {
            sequence: 20
            region: @selecione-a-remessa
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button impressao (
        buttonName: IMPRESSAO
        label: Imprimir
        layout {
            sequence: 10
            region: @filtros-de-impressão
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: imprimirpedidos_new();
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button imprimir (
        buttonName: IMPRIMIR
        label: Imprimir Pedidos
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 192
                items: {
                    P192_IDCOMPRATRANSFERENCIA: &P165_IDCOMPRATRANSFERENCIA.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P165_IDCOMPRATRANSFERENCIA
        }
    )

    button imprimir-listagem (
        buttonName: IMPRIMIR_LISTAGEM
        label: Imprimir Listagem
        layout {
            sequence: 20
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: imprimelista();
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P165_IDCOMPRATRANSFERENCIA
        }
    )

    branch (
        name: busca pedidos da remessa
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 165
                items: {
                    P165_IDCOMPRATRANSFERENCIA: &P165_IDCOMPRATRANSFERENCIA.
                }
                action: resetPagination
            }
        }
    )

)

