page 165 (
    name: Impressão de Pedidos Filial
    title: Impressão de Pedidos Filial
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function imprimirpedido() 
              {   
                  vurl = document.getElementById("P165_SESSION_PEDIDO").value;
                  pjan = window.open(vurl,'page','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1280,height=1024,left=20,top=10','_blank'); void(0);
                  pjan.focus();
              }
            
            function imprimelista() 
              {
                
                vurl = document.getElementById("P165_SESSION_LISTA").value;
                pjan = window.open(vurl,'page','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1280,height=1024,left=20,top=10','_blank'); void(0);
                pjan.focus(); 
                 
              }
            
            function imprimirpedidos_new()
             {
                idcomp         = document.getElementById("P118_IDCOMPRATRANSFERENCIA").value;
                iddistribuidor = $v("P165_IDREPRESENTANTE").value;
                quantidade     = $v("P165_QUANTIDADE").value;
                 
                pjanela = window.open('f?p=&APP_ID.:165:&SESSION.::NO::P165_IDCOMPRATRANSFERENCIA,P166_IDREPRESENTANTE,P165_QUANTIDADE:'+idcomp+','+iddistribuidor+','+quantidade,'page','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1280,height=1024,left=20,top=10','_blank');
                pjanela.focus();   
             }
            
            function retornaSelecionado_old(nome) {
             var resultado;
             document.getElementsByName(nome).forEach(function(item){if (item.checked) resultado = item.value}); 
             return resultado;
            }
            
            function retornaSelecionado(nome) {
            var e = document.getElementById(nome);
            var resultado = e.options[e.selectedIndex].value;
                
             return resultado;
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros-de-impressão (
        name: FIltros de Impressão
        type: staticContent
        layout {
            sequence: 10
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-size480x320
            ]
        }
        advanced {
            htmlDomId: FILTRO
            regionDisplaySelector: true
        }
    )

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pedidos (
        name: Pedidos
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P165_IDCOMPRATRANSFERENCIA
        }
    )

    region pedidos-detalhados (
        name: Pedidos Detalhados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.numeropedido
                 , p.vendedora
                 , p.representante
                 , p.valortotal
                 , p.valorapagar
                 , p.situacaoentregainterno
                 , p.situacaofinanceirointerno
                 , p.dataentrega
                 , ( select volume
                     from pedidosremessasct pr
                     where pr.idpedido = p.idpedido 
                       and pr.idcompratransferencia = :P165_IDCOMPRATRANSFERENCIA ) volume
                from vw_pedidos_fav p
                where exists ( select 1
                               from pedidosremessasct pr
                               where pr.idpedido = p.idpedido 
                                 and pr.idcompratransferencia = :P165_IDCOMPRATRANSFERENCIA )
                  and ididioma = :P0_IDIDIOMA
                ```
        }
        layout {
            sequence: 10
            parentRegion: @pedidos
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 30414041755112006
        }

