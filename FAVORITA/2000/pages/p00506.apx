page 506 (
    name: Cadastro Impressoras Argox
    title: Cadastro Impressoras Argox
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 60%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region new (
        name: New
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region usuarios-cadastrados (
        name: Usuarios Cadastrados
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select u.idusuario, u.idimpressoraargox
                from favorita.usuariosargox u
                where u.idimpressoraargox = :P506_IDIMPRESSORAARGOX;
                ```
        }
        layout {
            sequence: 40
            slot: contentBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P506_IDIMPRESSORAARGOX
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 113287206682803733
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDUSUARIO
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @IDIMPRESSORAARGOX
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @ROWID
                layout {
                    sequence: 7
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column IDIMPRESSORAARGOX (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: IDIMPRESSORAARGOX
                dataType: number
            }
            default {
                type: item
                item: P506_IDIMPRESSORAARGOX
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDUSUARIO (
            type: selectList
            heading {
                heading: Usuario
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select favorita.pck_util_fav.fnc_nomeusuario(u.idusuario) Usuario
                         , u.idusuario idusuario
                    from usuarios u
                    where u.idfilialfavorita = :P506_IDFILIALFAVORITA;
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDUSUARIO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column ROWID (
            type: hidden
            layout {
                sequence: 60
            }
            source {
                databaseColumn: ROWID
                dataType: rowid
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

    )

    pageItem P506_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Filial da Impressora
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) display_value
                     , idfilialfavorita   return_value
                from filiaisfavorita f
                where  exists ( select 1
                               from usuariosfiliaisfavorita u
                               where u.idfilialfavorita = f.idfilialfavorita
                                 and u.consultar = 'S'
                                 and u.idusuario = :P0_IDUSUARIO )
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @new
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P506_IDIMPRESSORAARGOX (
        type: hidden
        layout {
            sequence: 30
            region: @new
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P506_NOMEIMPRESSORAARGOX (
        type: textField
        label {
            label: Nome Impressora Argox
            alignment: left
        }
        layout {
            sequence: 10
            region: @new
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 20
            region: @new
            slot: delete
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 10
            region: @new
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 40
            region: @new
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P506_IDIMPRESSORAARGOX
        }
    )

    button salvar (
        buttonName: SALVAR
        label: Salvar
        layout {
            sequence: 30
            region: @new
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation usuario-ligado-a-só-uma-impressora (
        name: Usuario Ligado a só uma impressora
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @usuarios-cadastrados
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  vexist number;
                  --
                begin  
                     case :APEX$ROW_STATUS  
                     when 'C' then
                       --
                       select count(1)
                       into vexist
                       from favorita.usuariosargox u
                       where u.idusuario = :IDUSUARIO;
                       --
                       if vexist > 0 then
                         --
                         return 'Usuario ja esta ligado a outra impressora!';
                         --
                       end if;
                       --
                     when 'U' then  
                         null;
                     when 'D' then  
                         null;
                     end case;  
                end;
                ```
        }
    )

    process processo-dml (
        name: Processo DML
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vmd5 varchar2(4000);
                  --
                begin
                  --
                  pck_cadastros_fav.prc_impressorasargox ( pidimpressoraargox   => :P506_IDIMPRESSORAARGOX
                                                         , pnomeimpressoraargox => :P506_NOMEIMPRESSORAARGOX
                                                         , pidfilialfavorita    => :P506_IDFILIALFAVORITA
                                                         , pmd5                 => vmd5
                                                         , poperacao_dml        => 'S');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 110539688717043446
        }
    )

    process processo-dml-na-tabela (
        name: Processo DML na Tabela
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vmd5 varchar2(4000);
                  voperacao_dml varchar2(1);
                  --
                begin
                --
                  if v('REQUEST') = 'SALVAR' then
                    --
                    IF :P506_IDIMPRESSORAARGOX is null then
                      --
                      voperacao_dml := 'I';
                      --
                    elsif :P506_IDIMPRESSORAARGOX is not null then
                      --
                      voperacao_dml := 'U';
                      --
                    end if;
                    --
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  pck_cadastros_fav.prc_impressorasargox ( pidimpressoraargox   => :P506_IDIMPRESSORAARGOX
                                                         , pnomeimpressoraargox => :P506_NOMEIMPRESSORAARGOX
                                                         , pidfilialfavorita    => :P506_IDFILIALFAVORITA
                                                         , pmd5                 => vmd5
                                                         , poperacao_dml        => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo Efetuado Com Sucesso
        }
        error {
            errorMessage: Problema ao realizar o Processo
        }
        advanced {
            executionMappingIdentifier: 110539759991043447
        }
        serverSideCondition {
            type: request!=Value
            value: FECHAR
        }
    )

    process usuario-interactive-grid-data (
        name: Usuario - Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @usuarios-cadastrados
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 113287794460803738
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 506
                items: {
                    P506_NOMEIMPRESSORAARGOX: &P506_NOMEIMPRESSORAARGOX.
                    P506_IDFILIALFAVORITA: &P506_IDFILIALFAVORITA.
                    P506_IDIMPRESSORAARGOX: &P506_IDIMPRESSORAARGOX.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: SALVAR
        }
    )

    branch (
        name: Go To Page 506
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 506
                items: {
                    P506_NOMEIMPRESSORAARGOX:
                    P506_IDFILIALFAVORITA:
                    P506_IDIMPRESSORAARGOX:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: NOVO
        }
    )

    branch (
        execution {
            sequence: 30
        }
        behavior {
            target: {
                page: 503
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: FECHAR
        }
    )

)

