page 328 (
    name: Filtrar Referências
    title: Filtrar Referências
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG_22"';
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region filtrar-referências (
        name: Filtrar Referências
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 
                "ROWID",
                "IDUSUARIO",
                "IDPRODUTO"
                from "#OWNER#"."FILTROSPRODUTOSESTOQUES"
                where idusuario = :P0_IDUSUARIO
                ```
        }
        layout {
            sequence: 15
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhum Produto Informado!
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 4
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column IDPRODUTO (
            reportColumnQueryId: 3
            derivedColumn: N
            type: popupLovShowsDisplaysValue
            heading {
                heading: Produto
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select referencia||' - '||p.nomeproduto  display_value
                         , idproduto return_value
                    from produtos p
                    order by nomeproduto
                    ```
            }
            layout {
                sequence: 4
            }
            appearance {
                width: 30
            }
        )

        column IDUSUARIO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 3
            }
            default {
                type: item
                item: P0_IDUSUARIO
            }
        )

        column ROWID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    button add (
        buttonName: ADD
        label: Adicionar Produto
        layout {
            sequence: 40
            region: @filtrar-referências
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.widget.tabular.addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button multi-row-delete (
        buttonName: MULTI_ROW_DELETE
        label: Deletar
        layout {
            sequence: 20
            region: @filtrar-referências
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'MULTI_ROW_DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Salvar
        layout {
            sequence: 30
            region: @filtrar-referências
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @filtrar-referências
        target {
            tableName: FILTROSPRODUTOSESTOQUES
            pkColumn: ROWID
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: #MRD_COUNT# linha(s) deletada(s).
        }
        advanced {
            executionMappingIdentifier: 1412289096626035086
        }
        serverSideCondition {
            type: request=Value
            value: MULTI_ROW_DELETE
            executeCondition: once
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @filtrar-referências
        target {
            tableName: FILTROSPRODUTOSESTOQUES
            pkColumn: ROWID
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# linha(s) atualizada(s), #MRI_COUNT# linha(s) inserida(s).
        }
        advanced {
            executionMappingIdentifier: 1412288699959035084
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 328
            }
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

)

