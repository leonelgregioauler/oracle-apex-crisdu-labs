page 58 (
    name: Cadastro de Limites Consultoras
    title: Limites Consultoras
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region limites-consultoras (
        name: Limites Consultoras
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idlimiteconsultora
                     , idfilialromance
                     , valorcompra_de
                     , valorcompra_ate
                     , limiteliberado
                  from limitesconsultoras
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        messages {
            whenNoDataFound: Não encontrou informações.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 3351354941163484
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDLIMITECONSULTORA
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @VALORCOMPRA_DE
                layout {
                    width: 209
                    sequence: 4
                }
            )

            displayColumn (
                column: @VALORCOMPRA_ATE
                layout {
                    width: 253
                    sequence: 5
                }
            )

            displayColumn (
                column: @LIMITELIBERADO
                layout {
                    width: 248
                    sequence: 6
                }
            )

            displayColumn (
                column: @IDFILIALROMANCE
                layout {
                    width: 313
                    sequence: 3
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column IDFILIALROMANCE (
            type: selectList
            heading {
                heading: Filial Romance
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @lov-filiaisromance
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: IDFILIALROMANCE
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDLIMITECONSULTORA (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDLIMITECONSULTORA
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: seq_idlimiteconsultora
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column LIMITELIBERADO (
            type: numberField
            heading {
                heading: Limite Liberado
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: FML999G999G999G990D00
            }
            source {
                databaseColumn: LIMITELIBERADO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
            advanced {
                customAttributes: "onkeyup=\"formataMoeda(this);\" "
            }
        )

        column VALORCOMPRA_ATE (
            type: numberField
            heading {
                heading: Valor de Compra Até
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: FML999G999G999G990D00
            }
            source {
                databaseColumn: VALORCOMPRA_ATE
                dataType: number
            }
            columnFilter {
                lovType: none
            }
            advanced {
                customAttributes: "onkeyup=\"formataMoeda(this);\" "
            }
        )

        column VALORCOMPRA_DE (
            type: numberField
            heading {
                heading: Valor de Compra De
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: FML999G999G999G990D00
            }
            source {
                databaseColumn: VALORCOMPRA_DE
                dataType: number
            }
            columnFilter {
                lovType: none
            }
            advanced {
                customAttributes: "onkeyup=\"formataMoeda(this);\" "
            }
        )

    )

    validation filialromance-obrigatório (
        name: FILIALROMANCE obrigatório
        execution {
            sequence: 80
        }
        validation {
            editableRegion: @limites-consultoras
            type: columnIsNotNull
            column: IDFILIALROMANCE
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ter um valor.
            associatedColumn: IDFILIALROMANCE
        }
    )

    validation idfilialromance-unique (
        name: IDFILIALROMANCE unique
        execution {
            sequence: 70
        }
        validation {
            editableRegion: @limites-consultoras
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidfilialromance number;
                begin
                  select idfilialromance
                  into vidfilialromance
                  from limitesconsultoras
                  where idfilialromance = :IDFILIALROMANCE;
                  --
                  if vidfilialromance is not null then
                    return 'Existe um cadastro no sistema com estas informações. Não são permitidas informações repetidas para este cadastro.';
                  end if;
                  --
                exception
                  when no_data_found then
                    return '';
                end;
                ```
        }
        error {
            associatedColumn: IDFILIALROMANCE
        }
    )

    validation limiteliberado-numérico (
        name: LIMITELIBERADO numérico.
        execution {
            sequence: 60
        }
        validation {
            editableRegion: @limites-consultoras
            type: columnIsNumeric
            column: LIMITELIBERADO
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ter um valor.
            associatedColumn: LIMITELIBERADO
        }
    )

    validation limiteliberado-obrigatório (
        name: LIMITELIBERADO obrigatório
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @limites-consultoras
            type: columnIsNotNull
            column: LIMITELIBERADO
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ter um valor.
            associatedColumn: LIMITELIBERADO
        }
    )

    validation valorcompra-ate-numérico (
        name: VALORCOMPRA_ATE numérico.
        execution {
            sequence: 50
        }
        validation {
            editableRegion: @limites-consultoras
            type: columnIsNumeric
            column: VALORCOMPRA_ATE
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ser numérico.
            associatedColumn: VALORCOMPRA_ATE
        }
    )

    validation valorcompra-ate-obrigatório (
        name: VALORCOMPRA_ATE obrigatório
        execution {
            sequence: 20
        }
        validation {
            editableRegion: @limites-consultoras
            type: columnIsNotNull
            column: VALORCOMPRA_ATE
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ter um valor.
            associatedColumn: VALORCOMPRA_ATE
        }
    )

    validation valorcompra-de-numérico (
        name: VALORCOMPRA_DE numérico
        execution {
            sequence: 40
        }
        validation {
            editableRegion: @limites-consultoras
            type: columnIsNumeric
            column: VALORCOMPRA_DE
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ser numérico.
            associatedColumn: VALORCOMPRA_DE
        }
    )

    validation valorcompra-de-obrigatório (
        name: VALORCOMPRA_DE obrigatório
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @limites-consultoras
            type: columnIsNotNull
            column: VALORCOMPRA_DE
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ter um valor.
            associatedColumn: VALORCOMPRA_DE
        }
    )

    process save-interactive-grid-data (
        name: " - Save Interactive Grid Data"
        type: interactiveGridAutoRowProcessing
        editableRegion: @limites-consultoras
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 3356103456163487
        }
    )

)

