    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
            
            function  retornasituacao()
            {
              for(i=0;i<document.wwv_flow.length;i++)
               {
                      if( document.wwv_flow.f02[i].value == "")  
                      {
                        var ajaxRequest = new htmldb_Get(null,&APP_ID.,'APPLICATION_PROCESS=buscasituacao',0);
                        var ajaxRequest2 = new htmldb_Get(null,&APP_ID.,'APPLICATION_PROCESS=buscarepresentante',0);  
                        
                        
                        ajaxRequest.add('F2000117NRBOLETO',document.wwv_flow.f01[i].value);
            
                        ajaxResult = ajaxRequest.get();
                        ajaxResult2 = ajaxRequest2.get();
            
                        if (ajaxResult != "")
                            { document.wwv_flow.f02[i].value = ajaxResult;}
                        
                        if (ajaxResult2 != "")
                            { document.wwv_flow.f03[i].value = ajaxResult2;}
                        
            
                        ajaxRequest = null;
                        ajaxRequest2 = null;
                      }
               } 
            }
            
            function  retornasituacaobipagem()
            {
              for(i=0;i<document.wwv_flow.length;i++)
               {
                      if( document.wwv_flow.f02[i].value == "")  
                      {
                        var ajaxRequest = new htmldb_Get(null,&APP_ID.,'APPLICATION_PROCESS=situacaobipagem',0);
                        var ajaxRequest2 = new htmldb_Get(null,&APP_ID.,'APPLICATION_PROCESS=representantebipagem',0);  
                        
                        
                        ajaxRequest.add('F2000117ETIQUETA',document.wwv_flow.f01[i].value);
            
                        ajaxResult = ajaxRequest.get();
                        ajaxResult2 = ajaxRequest2.get();
            
                        if (ajaxResult != "")
                            { document.wwv_flow.f02[i].value = ajaxResult;}
                        
                        if (ajaxResult2 != "")
                            { document.wwv_flow.f03[i].value = ajaxResult2; }
                        
                        ajaxRequest = null;
                        ajaxRequest2 = null;            
                      }       
               } 
            }
            
            ```
    }
