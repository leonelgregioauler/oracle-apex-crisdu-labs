    dynamicAction avançar-linha-após-bipar (
        name: Avançar Linha após bipar
        execution {
            sequence: 20
        }
        when {
            selectionType: region
            region: @boletos-com-bipagem
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression:
                ```javascript-browser
                $(document).ready(function(){
                  /* ao pressionar uma tecla em um campo que seja de class="pula" */
                  $('.pula').keypress(function(e){
                    /* 
                     * verifica se o evento é Keycode (para IE e outros browsers)
                     * se não for pega o evento Which (Firefox)
                    */
                   var tecla = (e.keyCode?e.keyCode:e.which);
                
                   /* verifica se a tecla pressionada foi o ENTER */
                   if(tecla == 13){
                       /* guarda o seletor do campo que foi pressionado Enter */
                       campo =  $('.pula');
                       /* pega o indice do elemento*/
                       indice = campo.index(this);
                       /*soma mais um ao indice e verifica se não é null
                        *se não for é porque existe outro elemento
                       */
                      if(campo[indice+1] != null){
                         /* adiciona mais 1 no valor do indice */
                         proximo = campo[indice + 1];
                         /* passa o foco para o proximo elemento */
                         proximo.focus();
                      }
                   }
                    /* impede o sumbit caso esteja dentro de um form */
                	/*e.preventDefault(e);
                    return false;*/
                   
                })
                })
                ```
        }

        action native-alert (
            action: alert
            settings {
                message: 1
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process atualiza-promissórias (
        name: Atualiza Promissórias
        type: executeCode
        editableRegion: @boletos-sem-bipagem
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  verro           varchar2(2000);
                  vobservacao     varchar2(2000);
                  vvarnull        varchar2(1);
                  vnumnull        number := null;
                  vdata           date;
                  vidusuario      number := :P0_IDUSUARIO;
                  vidsituacaoprom number := :P117_IDSITUACAOPROMISSORIA;
                  vidpedido       number;
                  vcaracteristica number;
                  --
                  vregistratarefa varchar2(1);
                  vidpessoa       number;
                  --
                  vassinaturaterceiro varchar2(1000) := :ASSINATURATERCEIRO;
                  --
                begin
                  --
                  select catal.pck_util.fnc_verificaacesso(3541,v('APP_USER'))
                  into vregistratarefa
                  from dual;
                  --
                  select idpedido
                       , ( select idpessoa
                           from vendedoras v
                           where v.idvendedora = p.idvendedora ) idpessoa
                  into vidpedido
                     , vidpessoa
                  from pedidos p
                  where numeropedido like '%'||:NRPEDIDO;
                  --
                  if :RECUPERARPROMOSSORIA = 'S' then
                    --
                    vcaracteristica := 17;
                    vnumnull := null;
                    --
                    -- Identifica o pedido que precisa ser recuperada a promissoria
                    --
                    pck_pedidos_fav.prc_classificacoespedidos (pidclassificacaopedido  => vnumnull,
                                                               pidpedido               => vidpedido,
                                                               pdataclassificado       => vdata,
                                                               pidusuario              => vidusuario,
                                                               pidcaracteristicapedido => vcaracteristica,
                                                               pidvalorcaracteristica  => vnumnull,
                                                               pobservacao             => vvarnull,
                                                               poperacao_dml           => 'I',
                                                               pmd5                    => vvarnull);
                    --
                  end if;
                  --
                  -- Identifica o pedido que teve a promissoria recebida
                  --
                  vcaracteristica := 15;
                  vnumnull := null;
                  --
                  pck_pedidos_fav.prc_classificacoespedidos (pidclassificacaopedido  => vnumnull,
                                                             pidpedido               => vidpedido,
                                                             pdataclassificado       => vdata,
                                                             pidusuario              => vidusuario,
                                                             pidcaracteristicapedido => vcaracteristica,
                                                             pidvalorcaracteristica  => vnumnull,
                                                             pobservacao             => vvarnull,
                                                             poperacao_dml           => 'I',
                                                             pmd5                    => vvarnull);
                  --
                  -- Identifica no pedido a situacao da promissoria
                  --
                  vnumnull := null;
                  vcaracteristica := 16;
                  vidsituacaoprom := :P117_IDSITUACAOPROMISSORIA;
                  --
                  if vidsituacaoprom = 0 then
                    --
                    vobservacao := 'Promissoria Recebida'||' - '||:P117_IDSITUACAOPROMISSORIA||' - Assinatura de Terceiro: '||vassinaturaterceiro||'.';
                    --
                  else
                    --
                    vobservacao := 'Promissoria Recebida'||' - '||:P117_IDSITUACAOPROMISSORIA||', pelo usuário: '||v('APP_USER');
                    --
                  end if;
                  --
                  pck_pedidos_fav.prc_classificacoespedidos (pidclassificacaopedido  => vnumnull,
                                                             pidpedido               => vidpedido,
                                                             pdataclassificado       => vdata,
                                                             pidusuario              => vidusuario,
                                                             pidcaracteristicapedido => vcaracteristica,
                                                             pidvalorcaracteristica  => vidsituacaoprom,
                                                             pobservacao             => vobservacao,
                                                             poperacao_dml           => 'I',
                                                             pmd5                    => vvarnull);
                  --
                  vobservacao := 'Promissoria Recebida'||' - '||:P117_IDSITUACAOPROMISSORIA||', pelo usuário: '||v('APP_USER');
                  --
                  if vregistratarefa = 'S' then
                    --
                    insert into favorita.tarefas ( idtarefa
                                                 , idtipotarefa
                                                 , telefone
                                                 , datainclusao
                                                 , prioridade
                                                 , idsituacao
                                                 , observacao
                                                 , idusuario
                                                 , idpessoa
                                                 , idgrupoatendimento )
                    values ( favorita.seq_idtarefa.nextval          
                           , 33
                           , null
                           , sysdate
                           , null
                           , 0
                           , roman.pck_util.fnc_retornatelefones(vidpessoa)
                           , vidusuario
                           , vidpessoa
                           , 3 );
                    --
                  end if;
                  --
                exception 
                  when others then
                    --
                    verro := sqlerrm;
                    insert into teste ( coluna1 , coluna2 ) values ('erro atualiza promissória',verro||'-'||:NRPEDIDO||'-'|| :P117_IDSITUACAOPROMISSORIA||' - '||vobservacao );
                    --
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Pedido(s) Atualizado(s)!
        }
        advanced {
            executionMappingIdentifier: 477388383554415729
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process atualiza-promissórias-bipagem (
        name: Atualiza Promissórias Bipagem
        type: executeCode
        editableRegion: @boletos-sem-bipagem
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  verro           varchar2(2000);
                  vobservacao     varchar2(2000);
                  vvarnull        varchar2(1);
                  vnumnull        number := null;
                  vdata           date;
                  vidusuario      number := :P0_IDUSUARIO;
                  vidsituacaoprom number := :P117_IDSITUACAOPROMISSORIA;
                  vidpedido       number;
                  vcaracteristica number;
                  vlength         number;
                  vnumeropedido   number;
                  --
                  vregistratarefa varchar2(1);
                  vidpessoa       number;
                  --
                  vassinaturaterceiro varchar2(1000) := :ASSINATURATERCEIRO;
                  --
                begin
                  --
                  select catal.pck_util.fnc_verificaacesso(3541,v('APP_USER'))
                  into vregistratarefa
                  from dual;
                  --
                  select length(:NRPEDIDO)-3
                  into vlength
                  from dual;
                  --
                  select substr(:NRPEDIDO,2,vlength)
                  into vnumeropedido
                  from dual;
                  --
                  vidpedido := vnumeropedido;
                  --
                  select idpedido
                       , ( select idpessoa
                           from vendedoras v
                           where v.idvendedora = p.idvendedora ) idpessoa
                  into vidpedido
                     , vidpessoa
                  from pedidos p
                  where p.idpedido = vnumeropedido;
                  --
                  if :RECUPERARPROMOSSORIA = 'S' then
                    --
                    vcaracteristica := 17;
                    vnumnull := null;
                    --
                    -- Identifica o pedido que precisa ser recuperada a promissoria
                    --
                    pck_pedidos_fav.prc_classificacoespedidos (pidclassificacaopedido  => vnumnull,
                                                               pidpedido               => vidpedido,
                                                               pdataclassificado       => vdata,
                                                               pidusuario              => vidusuario,
                                                               pidcaracteristicapedido => vcaracteristica,
                                                               pidvalorcaracteristica  => vnumnull,
                                                               pobservacao             => vvarnull,
                                                               poperacao_dml           => 'I',
                                                               pmd5                    => vvarnull);
                    --
                  end if;
                  --
                  -- Identifica o pedido que teve a promissoria recebida
                  --
                  vcaracteristica := 15;
                  vnumnull := null;
                  --
                  pck_pedidos_fav.prc_classificacoespedidos (pidclassificacaopedido  => vnumnull,
                                                             pidpedido               => vidpedido,
                                                             pdataclassificado       => vdata,
                                                             pidusuario              => vidusuario,
                                                             pidcaracteristicapedido => vcaracteristica,
                                                             pidvalorcaracteristica  => vnumnull,
                                                             pobservacao             => vvarnull,
                                                             poperacao_dml           => 'I',
                                                             pmd5                    => vvarnull);
                  --
                  -- Identifica o pedido que teve a promissoria recebida pelo setor de cobrança
                  --
                  vcaracteristica := 71;
                  vnumnull := null;
                  --
                  pck_pedidos_fav.prc_classificacoespedidos (pidclassificacaopedido  => vnumnull,
                                                             pidpedido               => vidpedido,
                                                             pdataclassificado       => vdata,
                                                             pidusuario              => vidusuario,
                                                             pidcaracteristicapedido => vcaracteristica,
                                                             pidvalorcaracteristica  => vnumnull,
                                                             pobservacao             => vvarnull,
                                                             poperacao_dml           => 'I',
                                                             pmd5                    => vvarnull);
                  --
                  -- Identifica no pedido a situacao da promissoria
                  --
                  vnumnull := null;
                  vcaracteristica := 16;
                  vidsituacaoprom := :P117_IDSITUACAOPROMISSORIA;
                  --
                  if vidsituacaoprom = 0 then
                    --
                    vobservacao := 'Promissoria Recebida'||' - '||:P117_IDSITUACAOPROMISSORIA||' - Assinatura de Terceiro: '||vassinaturaterceiro||'.';
                    --
                  else
                    --
                    vobservacao := 'Promissoria Recebida'||' - '||:P117_IDSITUACAOPROMISSORIA||', pelo usuário: '||v('APP_USER');
                    --
                  end if;
                  --
                  pck_pedidos_fav.prc_classificacoespedidos (pidclassificacaopedido  => vnumnull,
                                                             pidpedido               => vidpedido,
                                                             pdataclassificado       => vdata,
                                                             pidusuario              => vidusuario,
                                                             pidcaracteristicapedido => vcaracteristica,
                                                             pidvalorcaracteristica  => vidsituacaoprom,
                                                             pobservacao             => vobservacao,
                                                             poperacao_dml           => 'I',
                                                             pmd5                    => vvarnull);
                  --
                  vobservacao := 'Promissoria Recebida'||' - '||:P117_IDSITUACAOPROMISSORIA||', pelo usuário: '||v('APP_USER');
                  --
                  if vregistratarefa = 'S' then
                    --
                    insert into favorita.tarefas ( idtarefa
                                                 , idtipotarefa
                                                 , telefone
                                                 , datainclusao
                                                 , prioridade
                                                 , idsituacao
                                                 , observacao
                                                 , idusuario
                                                 , idpessoa
                                                 , idgrupoatendimento )
                    values ( favorita.seq_idtarefa.nextval          
                           , 33
                           , null
                           , sysdate
                           , null
                           , 0
                           , roman.pck_util.fnc_retornatelefones(vidpessoa)
                           , vidusuario
                           , vidpessoa
                           , 3 );
                    --
                  end if;
                  --
                  commit;
                  --
                exception 
                  when others then
                    --
                    verro := sqlerrm;
                    insert into teste ( coluna1 , coluna2 ) values ('erro atualiza promissória',verro||'-'||:NRPEDIDO||'-'|| :P117_IDSITUACAOPROMISSORIA||' - '||vobservacao );
                    --
                end;
                
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Pedido(s) Atualizado(s)!
        }
        advanced {
            executionMappingIdentifier: 1444528361535760513
        }
        serverSideCondition {
            whenButtonPressed: @submit-2
        }
    )

    process atualiza-tarefas (
        name: Atualiza Tarefas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  for i in ( select t.idtarefa
                             from tarefas t
                                , vendedoras v
                                , pessoas p
                             where t.idsituacao < 30
                               and t.idtipotarefa = 33
                               and v.idpessoa = t.idpessoa
                               and p.idpessoa = t.idpessoa
                               and not exists ( select 1
                                                from vw_pedidosvencidos_fav pv
                                                   , vendedoras v
                                                where pv.idvendedora = v.idvendedora
                                                  and v.idpessoa = t.idpessoa )
                               and not exists ( select 1
                                                from roman.notasvendas nv
                                                where nv.idvendedora = v.idvendedora
                                                  and nv.saldo > 0
                                                 and nv.idsituacaonotavenda = 4 )
                               and not exists ( select 1
                                                from roman.pepinosrepresentantes pr
                                                where pr.valorsaldo > 0
                                                  and pr.cpf = p.cpf ) )
                  loop
                    --
                    update tarefas t
                    set t.idsituacao = 30
                    where t.idtarefa = i.idtarefa;
                    --
                  end loop;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Tarefas Atualizadas!
        }
        advanced {
            executionMappingIdentifier: 3089814135471784631
        }
        serverSideCondition {
            type: request=Value
            value: ATUALIZAR_TAREFAS
        }
    )

    branch (
        name: go to page 117 iniciar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 117
                items: {
                    P117_IDSITUACAOPROMISSORIA: &P117_IDSITUACAOPROMISSORIA.
                    P117_BIPAGEM: &P117_BIPAGEM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @iniciar
        }
    )

    branch (
        name: go to page 117 submit
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 117
                items: {
                    P117_IDSITUACAOPROMISSORIA:
                }
                action: resetPagination
            }
        }
