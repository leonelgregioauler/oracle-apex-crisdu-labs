            type: sqlQuery
            sqlQuery:
                ```sql
                select s.semana||'/'||s.ano||' - '||to_char(s.dt_ini,'DD/MM/RRRR')||' até '||to_char(s.dt_fim,'DD/MM/RRRR') display_value
                 , c.dataemissao return_value
                from roman.semana_dias s
                   , comprastransferencias c
                where c.idcompratransferencia = :P331_IDCOMPRATRANSFERENCIA
                  and s.idsemana = c.idsemanaentrega
                  and :P331_IDCOMPRATRANSFERENCIA is not null
