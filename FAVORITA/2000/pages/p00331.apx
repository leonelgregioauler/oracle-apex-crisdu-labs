page 331 (
    name: Confirmar Análise de Pedido
    title: Escolha de Remessa
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region escolha-de-remessa (
        name: Escolha de Remessa
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P331_DATAEMISSAOREMESSA (
        type: selectList
        label {
            label: Emissão
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(c.dataemissao,'DD/MM/RRRR') display_value
                 , c.dataemissao return_value
                from comprastransferencias c
                where c.idcompratransferencia = :P331_IDCOMPRATRANSFERENCIA
                  and :P331_IDCOMPRATRANSFERENCIA is not null
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P331_IDCOMPRATRANSFERENCIA
        }
        layout {
            sequence: 40
            region: @escolha-de-remessa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from comprastransferencias c
                where idfilialromancedestino = :P331_IDFILIALROMANCE
                   or exists ( select 1
                               from atendimentosfiliaisrmc a
                               where a.idfilialfavoritaorigem = c.idfilialfavoritadestino
                                 and a.idfilialdestino        = :P331_IDFILIALROMANCE )
                  and idsituacao in (0,3,5)
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P331_IDCOMPRATRANSFERENCIA (
        type: selectList
        label {
            label: Disponíveis
            alignment: left
        }
        lov {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                -- Created on 24/08/2020 by MAX.BERKEUER 
                declare 
                  --
                  vid_pedido number := :P331_IDPEDIDO;
                  vid_forma_entrega number;
                  vconsulta varchar2(2727);
                  vid_tipo_remessa number;
                  --
                begin
                  --
                  /*Busca a forma de entrega*/
                  select cl.idvalorcaracteristica,
                         case
                           when cl.idvalorcaracteristica = 2 then
                             7
                           when cl.idvalorcaracteristica = 4 then
                             10
                           when cl.idvalorcaracteristica = 5 then
                             8
                         end       
                  into vid_forma_entrega,
                       vid_tipo_remessa
                  from pedidos p,
                       classificacoespedidos cl
                  where p.idpedido = cl.idpedido
                  and cl.idcaracteristicapedido = 13
                  and p.idpedido = vid_pedido;
                  --
                  if vid_forma_entrega in (2,4,5) then /*Forma de entrega correios, total exp*/
                    --
                    vconsulta := '
                select numero||'' - ''|| pck_util_fav.fnc_retornatipocomptransrem(c.idtipocomptransrem,:P0_IDIDIOMA)
                             ||'' - ''||decode(analiseconcluida,''S'',''Concluida'',''Em Analise'')
                             ||'' - ''|| case
                                           when to_char(c.dataembarque,''HH24'') < 12 then
                                             ''Manhã''
                                           else
                                             ''Tarde''
                                         end
                             ||'' - ''||roman.pck_romance.fnc_nomepostoavancado(c.idpostoavancadodestino)
                             ||'' - ''||pck_util_fav.fnc_nomefilialfavorita(c.idfilialfavoritaorigem) 
                             ||'' - ''||c.dataembarque display_value,
                       idcompratransferencia return_value
                from comprastransferencias c
                where c.idtipocomptransrem = '||vid_tipo_remessa||'
                and c.idsituacao = 0 /*Filtra remessa em andamento*/
                order by c.dataembarque 
                    ';
                    --
                  else
                    --
                    vconsulta := '
                select numero||'' - ''|| pck_util_fav.fnc_retornatipocomptransrem(c.idtipocomptransrem,:P0_IDIDIOMA)
                             ||''(''  ||decode(identificacaointerna,''N'',''Normal'',''A'',''Antecipada'',''T'',''Pronta Entrega Tarde'',''M'',''Pronta Entrega Manhã'')
                             ||'') - ''||decode(analiseconcluida,''S'',''Concluida'',''Em Analise'')
                             ||'' - ''||roman.pck_romance.fnc_nomepostoavancado(c.idpostoavancadodestino)
                             ||'' - ''||pck_util_fav.fnc_nomefilialfavorita(c.idfilialfavoritaorigem) display_value
                 , idcompratransferencia return_value
                from comprastransferencias c
                where ( idfilialromancedestino = :P331_IDFILIALROMANCE
                      or exists ( select 1
                                  from atendimentosfiliaisrmc a
                                  where a.idfilialfavoritaorigem = c.idfilialfavoritadestino
                                    and a.idfilialdestino        = :P331_IDFILIALROMANCE )
                      or exists ( select 1
                                  from atendimentosfiliaisrmc a
                                  where a.idfilialdestino = :P331_IDFILIALROMANCE
                                  and a.idfilialfavoritaorigem = c.idfilialfavoritaorigem
                                  and c.idfilialromancedestino = 200  )
                      or exists ( select 1
                                  from classificacoespedidos c
                                  where c.idcaracteristicapedido = 13
                                   and c.idvalorcaracteristica  in (2,5)
                                   and c.idpedido               = :P331_IDPEDIDO ) 
                      and (:P331_IDPOSTOAVANCADO is null or idpostoavancadodestino = :P331_IDPOSTOAVANCADO ) )
                  and idtipocomptransrem = ( select idvalorcaracteristica
                                                 from classificacoespedidos cp
                                                 where cp.idpedido = :P331_IDPEDIDO
                                                   and cp.idcaracteristicapedido = 19 ) 
                  and idsituacao in (0,1,2)
                order by idsemanaentrega, c.dataemissao, identificacaointerna desc, idpostoavancadodestino desc    
                    ';
                    --
                  end if;
                  --
                  --dbms_output.put_line(vconsulta);
                  --
                  return vconsulta;
                  --
                end;
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: [
                P331_IDFILIALROMANCE
                P331_IDPOSTOAVANCADO
                P331_IDPEDIDO
            ]
        }
        layout {
            sequence: 20
            region: @escolha-de-remessa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vidcompra number;
                begin
                  --
                  select idcompratransferencia
                  into vidcompra
                  from comprastransferencias cc
                  where idcompratransferencia = ( select min(c.idcompratransferencia)
                                                  from comprastransferencias c
                                                  where ( idfilialromancedestino = :P331_IDFILIALROMANCE
                                                        or exists ( select 1
                                                                    from atendimentosfiliaisrmc a
                                                                    where a.idfilialfavoritaorigem = c.idfilialfavoritadestino
                                                                      and a.idfilialdestino        = :P331_IDFILIALROMANCE ) )
                                                    and exists ( select 1
                                                                 from classificacoespedidos cp
                                                                 where cp.idpedido = :P331_IDPEDIDO
                                                                   and cp.idcaracteristicapedido = 19
                                                                   and cp.idvalorcaracteristica = c.idtipocomptransrem ) 
                                                    and ( :P331_IDPOSTOAVANCADO is null or idpostoavancadodestino = :P331_IDPOSTOAVANCADO )
                                                    and idsituacao in (0,3,5) );
                  --
                  return(vidcompra);
                  --
                exception
                  when others then
                     return(null);
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

