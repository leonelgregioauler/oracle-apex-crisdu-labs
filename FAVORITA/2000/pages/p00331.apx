    button analise-remessa-aprovar (
        buttonName: ANALISE_REMESSA_APROVAR
        label: Aprovar
        layout {
            sequence: 10
            region: @escolha-de-remessa
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation valida-campo-de-remessa (
        name: Valida campo de remessa.
        execution {
            sequence: 10
        }
        validation {
            language: sql
            sqlExpression: :P331_IDCOMPRATRANSFERENCIA is not null
        }
        error {
            errorMessage: Campo de remessa deve ter algum valor!
            associatedItem: @P331_IDCOMPRATRANSFERENCIA
        }
        serverSideCondition {
            whenButtonPressed: @analise-remessa-aprovar
        }
    )

    process aprovar-análise (
        name: Aprovar Análise
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidtipo number;
                  vnumbernull  number;
                  vpedidocorreio number;
                  vidclassificacaopedido number;
                  vidpedido number := :P331_IDPEDIDO;             
                  vdataclassificado date := sysdate;   
                  vidusuario number := :P0_IDUSUARIO;            
                  vidcaracteristicapedido number := 100;
                  vidvalorcaracteristica number;
                  vobservacao varchar2(1000);            
                  vmd5 varchar2(1000);                   
                begin
                  --
                  begin
                    --
                    select idvalorcaracteristica
                    into vidtipo
                    from classificacoespedidos
                    where idpedido = :P331_IDPEDIDO
                      and idcaracteristicapedido = 19;
                    --
                    if vidtipo = 3 then
                      --
                      pck_movimentarpedidos_fav.prc_aprovaranalisepedido(pidpedido => :P331_IDPEDIDO,
                                                                         pidusuario => :P0_IDUSUARIO);
                      --
                      pck_comprastransf_fav.prc_processomanualpedidos( pidcompratransferencia => :P331_IDCOMPRATRANSFERENCIA,
                                                                       ptipoprocesso          => 'A',
                                                                       pnumeropedido          => :P331_IDPEDIDO,
                                                                       pidusuario             => :P0_IDUSUARIO );
                      --
                    elsif vidtipo = 2 then
                      --
                      pck_comprastransf_fav.prc_buscaitensremessa(pidcompratransferencia => :P331_IDCOMPRATRANSFERENCIA,
                                                                  pidpedido              => vnumbernull,
                                                                  pidusuario             => :P0_IDUSUARIO );
                      --
                      -- atualiza situações entrega e financeiro
                      pck_movimentarpedidos_fav.prc_atz_entrega_financ_auto( pidpedido  => :P331_IDPEDIDO
                                                                           , pidusuario => :P0_IDUSUARIO );
                      --
                    end if;
                    --
                    /*pck_pedidos_fav.prc_classificacoespedidos(pidclassificacaopedido  => vidclassificacaopedido,
                                                              pidpedido               => vidpedido,
                                                              pdataclassificado       => vdataclassificado,
                                                              pidusuario              => vidusuario,
                                                              pidcaracteristicapedido => vidcaracteristicapedido,
                                                              pidvalorcaracteristica  => vidvalorcaracteristica,
                                                              pobservacao             => vobservacao,
                                                              poperacao_dml           => 'I',
                                                              pmd5                    => vmd5);*/
                    --
                  end;
                  --
                  begin
                    --
                    select 1
                    into vpedidocorreio
                    from classificacoespedidos 
                    where idcaracteristicapedido = 13
                    and idvalorcaracteristica in (2,4,5)
                    and idpedido = :P331_IDPEDIDO;
                    --
                    pck_movimentarpedidos_fav.prc_aprovaranalisepedido(pidpedido => :P331_IDPEDIDO,
                                                                       pidusuario => :P0_IDUSUARIO);
                    --
                    pck_comprastransf_fav.prc_processomanualpedidos( pidcompratransferencia => :P331_IDCOMPRATRANSFERENCIA,
                                                                     ptipoprocesso          => 'A',
                                                                     pnumeropedido          => :P331_IDPEDIDO,
                                                                     pidusuario             => :P0_IDUSUARIO );
                    --
                    pck_pedidos_fav.prc_classificacoespedidos(pidclassificacaopedido  => vidclassificacaopedido,
                                                              pidpedido               => vidpedido,
                                                              pdataclassificado       => vdataclassificado,
                                                              pidusuario              => vidusuario,
                                                              pidcaracteristicapedido => vidcaracteristicapedido,
                                                              pidvalorcaracteristica  => vidvalorcaracteristica,
                                                              pobservacao             => vobservacao,
                                                              poperacao_dml           => 'I',
                                                              pmd5                    => vmd5);
                    --
                  exception
                    when others then
                      null;    
                  end;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Pedido Aprovado!
        }
        advanced {
            executionMappingIdentifier: 1417036195596961922
        }
        serverSideCondition {
            type: request=Value
            value: ANALISE_REMESSA_APROVAR
        }
    )

    branch (
        name: Go To Page 415 (Pedido Wide)
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 415
                items: {
                    P415_IDPEDIDO: &P331_IDPEDIDO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'ANALISE_REMESSA_APROVAR' and :P331_ORIGEM = 415
        }
    )

    branch (
        name: Go To Page 68 (Pedido)
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 68
                items: {
                    P68_IDPEDIDO: &P331_IDPEDIDO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'ANALISE_REMESSA_APROVAR' and :P331_ORIGEM = 68
        }
    )

    branch (
        name: Go To Page 360
        execution {
            sequence: 30
        }
        behavior {
            target: {
                page: 360
                action: resetPagination
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                v('REQUEST') = 'ANALISE_REMESSA_APROVAR' and 
                :P331_ORIGEM = 360
                ```
        }
    )

)

