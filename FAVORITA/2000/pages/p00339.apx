    process confirmar-entrada-de-cancelamento (
        name: Confirmar Entrada de Cancelamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                update itensdevolucaopedidos
                set confirmaentradafilial = 'S'
                where iditemdevolucaopedido = :P339_IDITEMCONFIRMA;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1438808572250455203
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMARENTRADACANCELA
        }
    )

