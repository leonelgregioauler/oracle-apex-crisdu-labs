page 339 (
    name: Relatórios de Itens Aguardando Devolução para Venda Direta
    title: Relatórios de Itens Aguardando Devolução para Venda Direta
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region itenspesquisa (
        name: ItensPesquisa
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region relatórios-de-itens-aguardando-devolução-para-venda-direta (
        name: Relatórios de Itens Aguardando Devolução para Venda Direta
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct
                       id.idprotocoloatendimento
                     , id.idpedido
                     , id.idprodutodetalhado
                   , id.nomeprodutodetalhado
                     , id.idfilialromance
                     , id.nomefilialromance
                     , trunc(id.dataconfirmacaoestoque) dataconfirmacaoestoque
                     , id.idtipoprotocolo
                     , id.tipoprotocolo
                     , id.valortotal
                     , id.valorapagar
                     , case
                        when id.confirmaentradafilial is null then
                             '<a href="javascript:apex.confirm(''Confirmar entrada do item no estoque de venda direta ? '', 
                             { request:''CONFIRMARENTRADACANCELA'', set:{''P339_IDITEMCONFIRMA'':'||iditemdevolucaopedido||' }})";><img src="#APP_IMAGES#ok.png"  border="0"></a>'
                        else
                             'Entrada realizada'
                       end confirmarentrada
                     , id.quantidade
                from vw_itensdevolucaopedidos_fav id
                where id.idfilialromance = :P339_IDFILIALROMANCE
                and id.ididioma = :P0_IDIDIOMA
                and (:P339_IDPEDIDO is null or id.idpedido = :P339_IDPEDIDO)
                and ( :P339_IDPEDIDOGERADO is null)
                and (:P339_TIPOPROTOCOLO = 1 or :P339_TIPOPROTOCOLO = 2)
                and id.dataconfirmacaoestoque is not null
                and not exists ( select 1
                                 from favorita.protocolosatendimentos pat
                                 where pat.idprotocoloatendimento = id.idprotocoloatendimento 
                                   and pat.situacao = 'R')                      
                union
                select distinct
                       it.idprotocoloatendimento 
                     , it.idpedido
                     , it.idprodutodetalhado
                   , it.nomeprodutodetalhado
                     , it.idfilialromance
                     , it.nomefilialromance
                     , trunc(it.dataconfirmacaoestoque) dataconfirmacaoestoque
                     , it.idtipoprotocolo
                     , it.tipoprotocolo
                     , it.valortotal
                     , it.valorapagar
                     , case
                        when it.confirmaentradafilial is null then
                             '<a href="javascript:apex.confirm(''Confirmar entrada do item no estoque de venda direta ? '', 
                             { request:''CONFIRMARENTRADATROCA'', set:{''P339_IDITEMCONFIRMA'':'||it.iditempedidotrocado||' }})";><img src="#APP_IMAGES#ok.png"  border="0"></a>'
                        else
                             'Entrada realizada'
                       end confirmarentrada
                     , it.quantidade
                from vw_itenstrocapedidos_fav it
                where it.idfilialromance = :P339_IDFILIALROMANCE
                and it.ididioma = :P0_IDIDIOMA
                and (:P339_IDPEDIDO is null or it.idpedido = :P339_IDPEDIDO)
                and ( :P339_IDPEDIDOGERADO is null or it.idpedidogerado = :P339_IDPEDIDOGERADO)
                and (:P339_TIPOPROTOCOLO = 1 or :P339_TIPOPROTOCOLO = 3)
                and it.dataconfirmacaoestoque is not null
                and exists ( select 1
                             from pedidos p
                             where p.idsituacaoentrega >= 32000
                             and p.idpedido = it.idpedido)      
                and not exists ( select 1
                                 from favorita.protocolosatendimentos pat
                                 where pat.idprotocoloatendimento = it.idprotocoloatendimento 
                                   and pat.situacao = 'R')                   
                union
                select distinct
                       ie.idprotocoloatendimento
                     , ie.idpedido
                     , ie.idprodutodetalhado
                   , ie.nomeprodutodetalhado
                     , ie.idfilialromance
                     , ie.nomefilialromance
                     , trunc(ie.dataconfirmacaoestoque) dataconfirmacaoestoque
                     , ie.idtipoprotocolo
                     , ie.tipoprotocolo
                     , ie.valortotal
                     , ie.valorapagar
                     , case
                        when ie.confirmaentradafilial is null then
                             '<a href="javascript:apex.confirm(''Confirmar entrada do item no estoque de venda direta ? '', 
                             { request:''CONFIRMARENTRADAEXCLUSAO'', set:{''P339_IDITEMCONFIRMA'':'||ie.iditemexcluido||' }})";><img src="#APP_IMAGES#ok.png"  border="0"></a>'
                        else
                             'Entrada realizada'
                       end confirmarentrada
                     , ie.quantidade
                from vw_itensexcluidospedidos_fav ie
                where ie.idfilialromance = :P339_IDFILIALROMANCE
                and ie.ididioma = :P0_IDIDIOMA
                and (:P339_IDPEDIDO is null or ie.idpedido = :P339_IDPEDIDO)
                and ( :P339_IDPEDIDOGERADO is null)
                and (:P339_TIPOPROTOCOLO = 1 or :P339_TIPOPROTOCOLO = 4)
                and ie.dataconfirmacaoestoque is not null
                and exists ( select 1
                             from pedidos p
                             where p.idsituacaoentrega >= 32000
                             and p.idpedido = ie.idpedido)
                and not exists ( select 1
                                 from favorita.protocolosatendimentos pat
                                 where pat.idprotocoloatendimento = ie.idprotocoloatendimento 
                                   and pat.situacao = 'R')
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1435867142937277432
        }

