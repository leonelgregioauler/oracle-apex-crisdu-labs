    pageItem P339_IDFILIALROMANCE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @itenspesquisa
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select fv.idfilialromance
                from filiaisfavorita fv
                where  exists ( select 1
                				from usuarios u
                				where u.idfilialfavorita = fv.idfilialfavorita
                				  and u.idusuario = :P0_IDUSUARIO)
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

