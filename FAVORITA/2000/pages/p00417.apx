        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 418
                items: {
                    P418_IDCONTROLECONTATOSSITE:
                    P418_PAGINA: 417
                }
                clearCache: 418
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 417
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 417
                items: {
                    P417_NRPROTOCOLO: &P417_NRPROTOCOLO.
                    P417_SITUACAO: &P417_SITUACAO.
                    P417_CPF: &P417_CPF.
                    P417_NOME: &P417_NOME.
                    P417_ORIGEM: &P417_ORIGEM.
                    P417_DATANASCIMENTO: &P417_DATANASCIMENTO.
                    P417_EMAIL: &P417_EMAIL.
                    P417_ESTADO: &P417_ESTADO.
                    P417_DATACADASTRO_FIM: &P417_DATACADASTRO_FIM.
                    P417_DATACADASTRO_INI: &P417_DATACADASTRO_INI.
                    P417_SITUACAO_CLIENTE: &P417_SITUACAO_CLIENTE.
                    P417_VALORRESTRICAO: &P417_VALORRESTRICAO.
                    P417_QTDRESTRICAO: &P417_QTDRESTRICAO.
                    P417_IDADE: &P417_IDADE.
                    P417_COMCONSULTA: &P417_COMCONSULTA.
                    P417_COMTAREFA: &P417_COMTAREFA.
                    P417_IDCIDADE: &P417_IDCIDADE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @buscar
        }
    )

)

