    pageItem P417_IDCIDADE (
        type: popupLov
        label {
            label: Cidade
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(c.nomecidade)||'/'||e.sigla d
                     , c.idcidade r
                from roman.cidades c 
                   , roman.estados e
                where e.idpais = 1
                  and c.idestado = e.idestado
                order by 1
                ```
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
