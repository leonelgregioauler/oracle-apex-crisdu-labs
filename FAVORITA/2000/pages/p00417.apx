    button atendimento-diario (
        buttonName: ATENDIMENTO_DIARIO
        label: Atend. Diário
        layout {
            sequence: 10
            region: @opções-2
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 432
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button buscar (
        buttonName: BUSCAR
        label: Buscar
        layout {
            sequence: 190
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
