    region relatório-de-controle-sac (
        name: Relatório de Controle SAC
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct(c.idcontrolecontatossite)
                     , c.nomecompleto
                     , c.cpf
                     , c.datanascimento
                     , c.rua
                     , c.nr
                     , c.complemento
                     , c.bairro
                     , c.idcidade
                     , c.cidade
                     , c.cep
                     , c.fone
                     , c.fone2
                     , c.email
                     , c.mensagem
                     , c.observacao
                     , c.situacao
                     , c.descricaosituacao
                     , c.datacadastro
                     , c.idfilial
                     , c.filialromance
                     , c.idrepresentante
                     , c.nomerepresentante
                     , c.dataliberadofilial
                     , c.datapassadorepres
                     , c.observacaofilial
                     , c.origemdesc origem
                     , c.tipo
                     , c.tiposolicitacaosac
                     , c.idfilialorig
                     , c.filialromanceorigem
                     , c.idrepresentanteorig
                     , c.nomerepresentanteorigem
                     , c.idvendedoraorig
                     , c.nomevendedoraorigem
                     , c.cadastrado
                     , c.tiposolicitacaomanual
                     , c.cidademanual
                     , c.inadimplente
                     , c.nroconsultaspc
                     , c.usuariocadastrou
                     , c.cadastrosistema
                     , c.situacaocliente
                     , cc.spc_quantidade
                     , cc.spc_valortotal
                     , cc.idade
                     , cc.idconsultaspc
                     , cc.ccf
                     , nvl((select 'Sim'
                            from dual
                            where exists ( select 1
                                           from roman.classificacoessac cc
                                           where cc.idcontrolecontatossite = c.idcontrolecontatossite 
                                             and cc.idcaracteristicasac in (21,22,23) )),'Não') possuitarefa
                from vw_controlecontatossite_fav c
                   , roman.consultaspc cc
                where replace(replace(c.cpf,'.',''),'-','') = cc.cpf(+)
                  --and sysdate - cc.dataconsulta <= 30
                  and trunc(c.datacadastro) >= to_date('17/11/2019','DD/MM/RRRR')
                  and nvl(c.idpais,1) = 1
                  and c.situacao != 'M'
                  and ( :P417_NRPROTOCOLO is null or c.idcontrolecontatossite = :P417_NRPROTOCOLO )
                  and ( :P417_SITUACAO = 'XX' or c.situacao = :P417_SITUACAO )
                  and ( :P417_VISUALIZARTODOS = 'S' or c.idfilialfavorita = :P0_IDFILIALFAVORITA )
                  and ( :P417_CPF is null or replace(replace(c.cpf,'.',''),'-','') = replace(replace(:P417_CPF,'.',''),'-','') )
                  and ( :P417_NOME is null or lower(c.nomecompleto) like '%'||lower(:P417_NOME)||'%' )
                  and ( :P417_EMAIL is null or lower(c.email) like '%'||lower(:P417_EMAIL)||'%' )
                  and ( :P417_ORIGEM is null or c.origem = :P417_ORIGEM )
                  and ( :P417_IDCIDADE is null or c.idcidade = :P417_IDCIDADE )
                  and ( :P417_DATANASCIMENTO is null or c.datanascimento = to_date(:P417_DATANASCIMENTO,'DD/MM/RRRR') )
                  and ( :P417_DATACADASTRO_INI is null or trunc(c.datacadastro) between to_date(:P417_DATACADASTRO_INI,'DD/MM/RRRR') and to_date(:P417_DATACADASTRO_FIM,'DD/MM/RRRR') )
                  and ( :P417_COMTAREFA is null or exists ( select 1
                                                            from roman.classificacoessac cc
                                                            where cc.idcontrolecontatossite = c.idcontrolecontatossite 
                                                              and cc.idcaracteristicasac in (21,22,23) ) ) 
                  and ( :P417_COMCONSULTA is null or exists ( select 1
                                                              from roman.consultaspc spc
                                                              where replace(replace(c.cpf,'.',''),'-','') = spc.cpf ) )
                  and ( :P417_SITUACAO_CLIENTE is null or exists ( select 1
                                                                   from vendedoras v
                                                                      , pessoas p
                                                                   where v.idpessoa = p.idpessoa
                                                                     and v.ativo    = :P417_SITUACAO_CLIENTE
                                                                     and p.cpf      = replace(replace(c.cpf,'.',''),'-','') ) )
                  and ( :P417_VALORRESTRICAO is null or cc.spc_valortotal <= :P417_VALORRESTRICAO )
                  and ( :P417_QTDRESTRICAO is null or cc.spc_quantidade <= :P417_QTDRESTRICAO )
                  and ( :P417_IDADE is null or cc.idade >= :P417_IDADE )
                  and exists ( select 1
                               from roman.cidades cc
                               where cc.idcidade = c.idcidade 
                                 and cc.idestado in (42,41,35,50,29,32,31,21,11,17,12,15,13,51,14,16,22) )
                order by 1 desc
                  
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum resultado obtido. Verifique os filtros!
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 1629164025556678158
        }

