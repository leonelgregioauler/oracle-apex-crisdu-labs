    region cobrança-de-boletos-uruguai (
        name: Cobrança de Boletos Uruguai
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    button gerararquivocobranca (
        buttonName: GERARARQUIVOCOBRANCA
        label: Gerar Arquivo de Cobrança
        layout {
            sequence: 10
            region: @cobrança-de-boletos-uruguai
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-upload
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process geração-de-arquivo-de-cobrança (
        name: Geração de arquivo de cobrança
        type: executeCode
        source {
            plsqlCode: #OWNER#.PCK_BOLETOSABITAB_FAV.PRC_COBRANCASBOLETOSABITAB;
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Cobrança gerada e enviada com sucesso ao Abitab.
        }
        advanced {
            executionMappingIdentifier: 7222951610053314
        }
    )

)

