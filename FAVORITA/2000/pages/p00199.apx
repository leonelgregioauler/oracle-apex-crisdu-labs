page 199 (
    name: Cobrança de Boletos Uruguai
    title: Cobrança de Boletos Uruguai
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region boletos-para-o-envio (
        name: Boletos para o Envio
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select b.idboleto
                     , b.idempresa
                     , b.dataemissao
                     , b.numero
                     , upper(roman.pck_romance.fnc_nomevendedora(b.idvendedora)) nomecliente
                     , b.vlrabatimento
                     , b.vlrdesconto
                     , b.outrasdeducoes
                     , b.jurosmulta
                     , b.outrosacrescimos
                     , b.valorcobrado
                     , b.datavencimento
                     , b.databaixa
                     , b.idpedido
                     , b.situacao
                     , roman.pck_romance.fnc_nomefilial(b.idfilial) filialromance
                     , b.tipoquitacao
                     , b.semanabaixa
                     , b.idpedidosite
                     , b.situacaocobranca
                     , b.valororiginal
                     , b.vencimentooriginal
                from catal.boletos b
                   , vw_boletosabitab_fav v
                where b.numero = v.numerodocumento; 
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 12883039505605644
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
