page 29 (
    name: Cadastro de Filiais para Edições Revistas
    title: Cadastro de Filiais para Edições Revistas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 40%
        height: 80%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region cadastro-de-filiais-para-edições-revistas (
        name: Cadastro de Filiais para Edições Revistas
        type: tabform
        source {
            sqlQuery:
                ```sql
                select idfilialedicaorevista
                     , idedicaorevista
                     , idfilial
                     , idfilialfavorita
                from filiaisedicoesrevistas
                where idedicaorevista = :P29_IDEDICAOREVISTA
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 200
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: showAll
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Não encontrou informações.
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 5
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            advanced {
                cellWidth: 50
            }
        )

        column IDEDICAOREVISTA (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 3
            }
            default {
                type: item
                item: P29_IDEDICAOREVISTA
            }
        )

        column IDFILIAL (
            reportColumnQueryId: 3
            derivedColumn: N
            type: selectList
            heading {
                heading: Filial Romance
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nome as d,
                           idfilial as r
                      from roman.vw_filiais
                     where ( (:P29_TIPOVENDA = 'P' and tipofilial = 'P')
                          or (:P29_TIPOVENDA = 'R' and tipofilial in ('C', 'D') ) )
                       and ativo = 'S'
                    union
                    select nome as d,
                           idfilial as r
                      from roman.vw_filiais
                     where idfilial = 200
                       and ativo = 'S'
                     order by 1
                    ```
                nullDisplayValue: - Selecione a Filial -
            }
            layout {
                sequence: 4
            }
            advanced {
                cellWidth: 180
            }
            serverSideCondition {
                type: item!=value
                item: P29_TIPOVENDA
                value: L
            }
        )

        column IDFILIALEDICAOREVISTA (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDFILIALEDICAOREVISTA
            }
        )

        column IDFILIALFAVORITA (
            reportColumnQueryId: 4
            derivedColumn: N
            type: selectList
            heading {
                heading: Filial Favorita
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) as d,
                           idfilialfavorita as r
                    from filiaisfavorita
                    where tipofilial = 'L'  
                    order by 1
                    ```
                nullDisplayValue: "- Selecione a Filial - "
            }
            layout {
                sequence: 5
            }
            serverSideCondition {
                type: item=value
                item: P29_TIPOVENDA
                value: L
            }
        )

    )

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
    )

    pageItem P29_IDEDICAOREVISTA (
        type: numberField
        label {
            label: Idedicaorevista
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P29_TIPOVENDA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button adicionarlinha (
        buttonName: ADICIONARLINHA
        label: Adicionar Linha
        layout {
            sequence: 10
            region: @cadastro-de-filiais-para-edições-revistas
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.widget.tabular.addRow();
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button excluirlinha (
        buttonName: EXCLUIRLINHA
        label: Excluir
        layout {
            sequence: 30
            region: @cadastro-de-filiais-para-edições-revistas
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIRLINHA');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from filiaisedicoesrevistas
                where idedicaorevista = :P29_IDEDICAOREVISTA
                ```
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 20
            region: @cadastro-de-filiais-para-edições-revistas
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 22
                items: {
                    P22_IDEDICAOREVISTA: &P29_IDEDICAOREVISTA.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inseriratualizar (
        buttonName: INSERIRATUALIZAR
        label: Inserir / Atualizar
        layout {
            sequence: 40
            region: @cadastro-de-filiais-para-edições-revistas
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation idedicaoidfilial-unique (
        name: IDEDICAOIDFILIAL unique
        execution {
            sequence: 50
        }
        validation {
            editableRegion: @cadastro-de-filiais-para-edições-revistas
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  videdicaorevista number;
                  vidfilial number;
                begin
                  select idedicaorevista
                       , idfilial
                  into videdicaorevista
                     , vidfilial
                  from filiaisedicoesrevistas
                  where idedicaorevista = :IDEDICAOREVISTA
                    and ( ( :P29_TIPOVENDA = 'L' and idfilialfavorita = :IDFILIALFAVORITA )
                         or :P29_TIPOVENDA in ('P','R') and idfilial = :IDFILIAL );
                  --
                  if videdicaorevista is not null and vidfilial is not null then
                    return 'Existe um cadastro no sistema com estas informações. Não são permitidas informações repetidas para este cadastro.';
                  end if;
                  --
                exception
                  when no_data_found then
                    return '';
                end;
                ```
        }
        error {
            associatedColumn: IDEDICAOREVISTA
        }
    )

    validation idedicaorevista-must-be-numeric (
        name: IDEDICAOREVISTA must be numeric
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @cadastro-de-filiais-para-edições-revistas
            type: columnIsNumeric
            column: IDEDICAOREVISTA
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDEDICAOREVISTA
        }
        serverSideCondition {
            whenButtonPressed: @inseriratualizar
        }
    )

    validation idedicaorevista-not-null (
        name: IDEDICAOREVISTA not null
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @cadastro-de-filiais-para-edições-revistas
            type: columnIsNotNull
            column: IDEDICAOREVISTA
        }
        error {
            errorMessage: #COLUMN_HEADER# must have a value.
            associatedColumn: IDEDICAOREVISTA
        }
        serverSideCondition {
            whenButtonPressed: @inseriratualizar
        }
    )

    validation idfilial-must-be-numeric (
        name: IDFILIAL must be numeric
        execution {
            sequence: 40
        }
        validation {
            editableRegion: @cadastro-de-filiais-para-edições-revistas
            type: columnIsNumeric
            column: IDFILIAL
        }
        error {
            errorMessage: #COLUMN_HEADER# must be numeric.
            associatedColumn: IDFILIAL
        }
        serverSideCondition {
            whenButtonPressed: @inseriratualizar
            type: item!=value
            item: P29_TIPOVENDA
            value: L
        }
    )

    validation idfilial-not-null (
        name: IDFILIAL not null
        execution {
            sequence: 40
        }
        validation {
            editableRegion: @cadastro-de-filiais-para-edições-revistas
            type: columnIsNotNull
            column: IDFILIAL
        }
        error {
            errorMessage: #COLUMN_HEADER# must have a value.
            associatedColumn: IDFILIAL
        }
        serverSideCondition {
            whenButtonPressed: @inseriratualizar
            type: item!=value
            item: P29_TIPOVENDA
            value: L
        }
    )

    validation idfilialfavorita-not-null (
        name: IDFILIALFAVORITA not null
        execution {
            sequence: 60
        }
        validation {
            editableRegion: @cadastro-de-filiais-para-edições-revistas
            type: columnIsNotNull
            column: IDFILIALFAVORITA
        }
        error {
            errorMessage: #COLUMN_HEADER# must have a value.
            associatedColumn: IDFILIALFAVORITA
        }
        serverSideCondition {
            whenButtonPressed: @inseriratualizar
            type: item=value
            item: P29_TIPOVENDA
            value: L
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @cadastro-de-filiais-para-edições-revistas
        target {
            tableName: FILIAISEDICOESREVISTAS
            pkColumn: IDFILIALEDICAOREVISTA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: #MRD_COUNT# registro(s) excluído(s).
        }
        error {
            errorMessage: Não é possível excluir este registro pois existe outra informação associada com esta sendo utilizada no sistema.
        }
        advanced {
            executionMappingIdentifier: 14747082236642692
        }
        serverSideCondition {
            whenButtonPressed: @excluirlinha
            type: request=Value
            value: EXCLUIRLINHA
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @cadastro-de-filiais-para-edições-revistas
        target {
            tableName: FILIAISEDICOESREVISTAS
            pkColumn: IDFILIALEDICAOREVISTA
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# registro(s) atualizado(s), #MRI_COUNT# registro(s) inserido(s).
        }
        advanced {
            executionMappingIdentifier: 14746632409642691
        }
        serverSideCondition {
            whenButtonPressed: @inseriratualizar
            type: request=Value
            value: INSERIRATUALIZAR
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 29
            }
        }
        serverSideCondition {
            whenButtonPressed: @inseriratualizar
        }
    )

)

