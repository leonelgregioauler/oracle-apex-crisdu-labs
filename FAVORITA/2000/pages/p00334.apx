    region por-negociadora (
        name: Por Negociadora
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa) responsavel
                     , nvl(( select sum(pn.valorapagar) 
                             from roman.notasvendas n
                                , roman.parcelamentosnotasvendas pn
                             where pn.idnotavenda = n.idnotavenda
                               and pn.situacao = 'Q'
                               and pn.idnegociacaoparceiro is null
                               and ( :P334_DATAINICIO is null or trunc(pn.databaixa) between to_date(:P334_DATAINICIO) and to_date(:P334_DATAFIM) ) 
                               and n.responsavelcobranca = u.usuario ),0)
                     + nvl(( select sum(pp.valorapagar) valor
                             from pedidos p
                                , parcelamentospedidos pp
                             where pp.idpedido = p.idpedido
                               and pp.situacao = 'Q'
                               and pp.idnegociacaoparceiro is null
                               and ( :P334_DATAINICIO is null or trunc(pp.databaixa) between to_date(:P334_DATAINICIO) and to_date(:P334_DATAFIM) )
                               and p.idnegociadoraresponsavel = u.idusuario ),0)
                     + nvl(( select sum(nvl(b.valorpagonegociacao,b.valorcobrado))
                             from boletos b
                             where b.situacao = 'Q'
                               and not exists ( select 1
                                                from catal.parcelamentosboletos pb
                                                where pb.idboleto = b.idboleto )
                               and ( :P334_DATAINICIO is null or trunc(b.databaixa) between to_date(:P334_DATAINICIO) and to_date(:P334_DATAFIM) ) 
                               and b.responsavelcobranca = u.usuario ),0)
                     + nvl(( select sum(ppr.valorapagar)
                             from roman.pepinosrepresentantes pr
                                , roman.parcelamentospepinosrepres ppr
                             where ppr.idpepinorepresentante = pr.idpepinosrepresentante
                               and ppr.situacao = 'Q'
                               and ( :P334_DATAINICIO is null or trunc(ppr.databaixa) between to_date(:P334_DATAINICIO) and to_date(:P334_DATAFIM) )
                               and pr.responsavelcobranca = u.usuario ),0)
                     + nvl(( select sum(pb.VALORAPAGAR)
                             from boletos b
                                , catal.parcelamentosboletos pb
                             where b.responsavelcobranca = u.usuario
                               and pb.idboleto = b.idboleto
                               and pb.idnegociacaoparceiro is null
                               and pb.situacao = 'Q'
                               and ( :P334_DATAINICIO is null or trunc(pb.databaixa) between to_date(:P334_DATAINICIO) and to_date(:P334_DATAFIM) ) ),0) total
                     , nvl( ( select sum(mc.valormeta)
                              from metascobrancas mc
                              where mc.idusuario = u.idusuario
                                and extract ( year from mc.datainicio ) = to_char(to_date(:P334_DATAINICIO,'DD/MM/RRRR'),'RRRR')
                                and extract ( month from mc.datainicio ) = to_char(to_date(:P334_DATAINICIO,'DD/MM/RRRR'),'MM') ),0 ) valormeta
                     , nvl(( select sum(pn.valorapagar) 
                             from roman.notasvendas n
                                , roman.parcelamentosnotasvendas pn
                             where pn.idnotavenda = n.idnotavenda
                               and pn.idnegociacaoparceiro is null
                               and pn.situacao in ('A','E')
                               and ( :P334_DATAINICIO is null or trunc(pn.datavencimento) between to_date(:P334_DATAINICIO) and to_date(:P334_DATAFIM) ) 
                               and n.responsavelcobranca = u.usuario ),0)
                     + nvl(( select sum(pp.valorapagar) valor
                             from pedidos p
                                , parcelamentospedidos pp
                             where pp.idpedido = p.idpedido
                               and pp.situacao in ('A','E')
                               and ( :P334_DATAINICIO is null or trunc(pp.datavencimento) between to_date(:P334_DATAINICIO) and to_date(:P334_DATAFIM) )
                               and p.idnegociadoraresponsavel = u.idusuario ),0)
                     + nvl(( select sum(nvl(b.valorpagonegociacao,b.valorcobrado))
                             from boletos b
                             where b.situacao in ('A','E')
                               and not exists ( select 1
                                                from catal.parcelamentosboletos pb
                                                where pb.idboleto = b.idboleto )
                               and ( :P334_DATAINICIO is null or trunc(b.datavencimento) between to_date(:P334_DATAINICIO) and to_date(:P334_DATAFIM) ) 
                               and b.responsavelcobranca = u.usuario ),0)
                     + nvl(( select sum(ppr.valorapagar)
                             from roman.pepinosrepresentantes pr
                                , roman.parcelamentospepinosrepres ppr
                             where ppr.idpepinorepresentante = pr.idpepinosrepresentante
                               and ppr.situacao in ('A','E')
                               and ( :P334_DATAINICIO is null or trunc(ppr.datavencimento) between to_date(:P334_DATAINICIO) and to_date(:P334_DATAFIM) )
                               and pr.responsavelcobranca = u.usuario ),0)
                     + nvl(( select sum(pb.VALORAPAGAR)
                             from boletos b
                                , catal.parcelamentosboletos pb
                             where b.responsavelcobranca = u.usuario
                               and pb.idboleto = b.idboleto
                               and pb.situacao in ('A','E')
                               and ( :P334_DATAINICIO is null or trunc(pb.datavencimento) between to_date(:P334_DATAINICIO) and to_date(:P334_DATAFIM) ) ),0) valorprevisto
                from usuarios u
                   , pessoas p
                where p.idpessoa  = u.idpessoa
                  and ( exists ( select 1
                                 from roman.usuariosgruposatendimento ug
                                 where ug.idgrupoatendimento = 3
                                   and ug.usuario = u.usuario )
                     or u.idgerente = 80 )
                 -- and u.ativo     = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
