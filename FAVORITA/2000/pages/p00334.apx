    region negociações (
        name: Negociações
        type: tabform
        source {
            sqlQuery:
                ```sql
                select 'Negociação Favorita' origem
                     , pck_util_fav.fnc_nomeusuario(p.idnegociadoraresponsavel) negociadora
                     , 'P'||p.idpedido pedido
                     , roman.pck_romance.fnc_nomevendedora(p.idvendedora) cliente
                     , regexp_replace(roman.pck_romance.fnc_cpfvendedora(p.idvendedora),'([0-9]{3})([0-9]{3})([0-9]{3})([0-9]{2})','\1.\2.\3-\4') cpf
                     , pp.valorapagar
                     , pp.datavencimento
                     , pp.comprovante
                     , pp.databaixa
                     , roman.pck_romance.fnc_nomefilial(p.idfilialromance) empresa
                     , roman.pck_romance.fnc_nomerepresentante(p.idrepresentante) distribuidor
                     , decode(pp.situacao,'Q','Quitado','V','Vencido','A','Aberto','E','Em Espera') situacao
                     , ( select v.datavencimento
                        from favorita.vencimentospedidos v
                        where v.idpedido = p.idpedido
                          and v.idvencimentopedido = ( select min(vp.idvencimentopedido)
                                                        from favorita.vencimentospedidos vp
                                                        where vp.idpedido = p.idpedido
                                                          and vp.valorpago < vp.valorpagar
                                                          and vp.situacaovencimento = 'V' ) ) datavencimentooriginal
                     , decode(pp.tipopagamento,'C','Cartão','D','Depósito') tipopagamento
                     , p.idpedido
                     , 'f' tipo
                     , p.idnegociadoraresponsavel idusuario
                from pedidos p
                   , parcelamentospedidos pp
                where pp.idpedido = p.idpedido
                  and idnegociacaoparceiro is null
                  and p.idnegociadoraresponsavel is not null
                  and ( :P334_IDFILIALROMANCE is null or p.idfilialromance = :P334_IDFILIALROMANCE )
                  and ( :P334_SITUACAO is null or pp.situacao = :P334_SITUACAO )
                  and ( :P334_IDNEGOCIADORA is null or p.idnegociadoraresponsavel = :P334_IDNEGOCIADORA )
                  and ( :P334_TIPODATA = 'T'
                     or ( :P334_TIPODATA = 'V' and trunc(pp.datavencimento) between to_date(:P334_DATAINICIO) and to_date(:P334_DATAFIM) )
                     or ( :P334_TIPODATA = 'B' and trunc(pp.databaixa) between to_date(:P334_DATAINICIO) and to_date(:P334_DATAFIM) ) )
                union all
                select 'Negociação Romance'
                     , ( select initcap(nomepessoa)
                         from pessoas ps
                            , usuarios u
                         where u.usuario = n.responsavelcobranca
                           and ps.idpessoa = u.idpessoa ) 
                     , 'N'||n.numeronota
                     , roman.pck_romance.fnc_nomevendedora(n.idvendedora)
                     , regexp_replace(roman.pck_romance.fnc_cpfvendedora(n.idvendedora),'([0-9]{3})([0-9]{3})([0-9]{3})([0-9]{2})','\1.\2.\3-\4') cpf
                     , pn.valorapagar
                     , pn.datavencimento
                     , pn.comprovante
                     , pn.databaixa
                     , roman.pck_romance.fnc_nomefilial(n.idfilial)
                     , roman.pck_romance.fnc_nomerepresentante(n.idrepresentante)
                     , decode(pn.situacao,'Q','Quitado','V','Vencido','A','Aberto','E','Em Espera') situacao
                     , n.dataretorno
                     , null
                     , n.idnotavenda
                     , 'n'
                     , ( select idusuario from usuarios where usuario = n.responsavelcobranca )
                from roman.notasvendas n
                   , roman.parcelamentosnotasvendas pn
                where pn.idnotavenda = n.idnotavenda
                  and idnegociacaoparceiro is null
                  and ( :P334_IDFILIALROMANCE is null or n.idfilial = :P334_IDFILIALROMANCE )
                  and ( :P334_SITUACAO is null or pn.situacao = :P334_SITUACAO )
                  and ( :P334_IDNEGOCIADORA is null or exists ( select 1
                                                                from usuarios u
                                                                where u.usuario = n.responsavelcobranca
                                                                  and u.idusuario = :P334_IDNEGOCIADORA ) )
                  and ( :P334_TIPODATA = 'T'
                     or ( :P334_TIPODATA = 'V' and trunc(pn.datavencimento) between to_date(:P334_DATAINICIO) and to_date(:P334_DATAFIM) )
                     or ( :P334_TIPODATA = 'B' and trunc(pn.databaixa) between to_date(:P334_DATAINICIO) and to_date(:P334_DATAFIM) ) )
                union all
                select 'Negociação Romance Antiga'
                     , ( select initcap(nomepessoa)
                         from pessoas ps
                            , usuarios u
                         where u.usuario = pr.responsavelcobranca
                           and ps.idpessoa = u.idpessoa ) 
                     , 'P'||pr.nrpedido
                     , pr.nomevendedora
                     , regexp_replace(pr.cpf,'([0-9]{3})([0-9]{3})([0-9]{3})([0-9]{2})','\1.\2.\3-\4') cpf
                     , ppr.valorapagar
                     , ppr.datavencimento
                     , ppr.comprovante
                     , ppr.databaixa
                     , roman.pck_romance.fnc_nomefilial(pr.idfilial)
                     , roman.pck_romance.fnc_nomerepresentante(pr.idrepresentante)
                     , decode(ppr.situacao,'Q','Quitado','V','Vencido','A','Aberto','E','Em Espera') situacao
                     , pr.datavencimento
                     , null
                     , pr.idpepinosrepresentante
                     , 'd'
                     , ( select idusuario from usuarios where usuario = pr.responsavelcobranca )
                from roman.pepinosrepresentantes pr
                   , roman.parcelamentospepinosrepres ppr
                where ppr.idpepinorepresentante = pr.idpepinosrepresentante
                  and ( :P334_IDFILIALROMANCE is null or pr.idfilial = :P334_IDFILIALROMANCE )
                  and ( :P334_SITUACAO is null or ppr.situacao = :P334_SITUACAO )
                  and ( :P334_IDNEGOCIADORA is null or exists ( select 1
                                                                from usuarios u
                                                                where u.usuario = pr.responsavelcobranca
                                                                  and u.idusuario = :P334_IDNEGOCIADORA ) )
                  and ( :P334_TIPODATA = 'T'
                     or ( :P334_TIPODATA = 'V' and trunc(ppr.datavencimento) between to_date(:P334_DATAINICIO) and to_date(:P334_DATAFIM) )
                     or ( :P334_TIPODATA = 'B' and trunc(ppr.databaixa) between to_date(:P334_DATAINICIO) and to_date(:P334_DATAFIM) ) )
                union all
                select 'Negociação Favorita Antiga'
                     , ( select initcap(nomepessoa)
                         from pessoas ps
                            , usuarios u
                         where u.usuario = b.responsavelcobranca
                           and ps.idpessoa = u.idpessoa ) 
                     , 'B'||b.numero
                     , roman.pck_romance.fnc_nomevendedora(b.idvendedora)
                     , regexp_replace(roman.pck_romance.fnc_cpfvendedora(b.idvendedora),'([0-9]{3})([0-9]{3})([0-9]{3})([0-9]{2})','\1.\2.\3-\4') cpf
                     , b.valorcobrado
                     , b.datavencimento
                     , b.numerocomprovante
                     , b.databaixa
                     , roman.pck_romance.fnc_nomefilial(b.idfilial)
                     , roman.pck_romance.fnc_nomerepresentante(b.idrepresentante)
                     , ( select s.descricao
                         from catal.situacoes s
                         where s.idsituacao = b.situacao )
                     , b.vencimentooriginal
                     , decode(b.tipoquitacao,'M','Em Mãos','D','Depósito','B','Boleto','C','Cartão')
                     , b.idboleto
                     , 'b'
                     , ( select idusuario from usuarios where usuario = b.responsavelcobranca )
                from boletos b
                where ( :P334_IDFILIALROMANCE is null or b.idfilial = :P334_IDFILIALROMANCE )
                  and not exists ( select 1
                                   from catal.parcelamentosboletos pb
                                   where pb.idboleto = b.idboleto )
                  and ( ( :P334_SITUACAO = 'A' and b.situacao = 'A' )
                     or ( :P334_SITUACAO = 'Q' and b.situacao = 'Q' )
                     or ( :P334_SITUACAO = 'V' and b.situacao in ( 'V', 'G' ) )
                     or ( :P334_SITUACAO = 'M' and b.situacao = 'M' ) )
                  and ( :P334_IDNEGOCIADORA is null or exists ( select 1
                                                                from usuarios u
                                                                where u.usuario = b.responsavelcobranca
                                                                  and u.idusuario = :P334_IDNEGOCIADORA ) )
                  and ( :P334_TIPODATA = 'T'
                     or ( :P334_TIPODATA = 'V' and trunc(b.datavencimento) between to_date(:P334_DATAINICIO) and to_date(:P334_DATAFIM) )
                     or ( :P334_TIPODATA = 'B' and trunc(b.databaixa) between to_date(:P334_DATAINICIO) and to_date(:P334_DATAFIM) ) )
                union all
                select 'Negociação Favorita Antiga Parc'
                     , ( select initcap(nomepessoa)
                         from pessoas ps
                            , usuarios u
                         where u.usuario = b.responsavelcobranca
                           and ps.idpessoa = u.idpessoa ) 
                     , 'B'||b.numero
                     , roman.pck_romance.fnc_nomevendedora(b.idvendedora)
                     , regexp_replace(roman.pck_romance.fnc_cpfvendedora(b.idvendedora),'([0-9]{3})([0-9]{3})([0-9]{3})([0-9]{2})','\1.\2.\3-\4') cpf
                     , pb.VALORAPAGAR
                     , b.datavencimento
                     , b.numerocomprovante
                     , b.databaixa
                     , roman.pck_romance.fnc_nomefilial(b.idfilial)
                     , roman.pck_romance.fnc_nomerepresentante(b.idrepresentante)
                     , ( select s.descricao
                         from catal.situacoes s
                         where s.idsituacao = b.situacao )
                     , b.vencimentooriginal
                     , decode(b.tipoquitacao,'M','Em Mãos','D','Depósito','B','Boleto','C','Cartão')
                     , b.idboleto
                     , 'b'
                     , ( select idusuario from usuarios where usuario = b.responsavelcobranca )
                from boletos b
                   , catal.parcelamentosboletos pb
                where pb.idboleto = b.idboleto
                  and idnegociacaoparceiro is null
                  and ( :P334_IDFILIALROMANCE is null or b.idfilial = :P334_IDFILIALROMANCE )
                  and ( ( :P334_SITUACAO = 'A' and pb.situacao = 'A' )
                     or ( :P334_SITUACAO = 'Q' and pb.situacao = 'Q' )
                     or ( :P334_SITUACAO = 'V' and pb.situacao = 'V' )
                     or ( :P334_SITUACAO = 'M' and pb.situacao = 'E' ) )
                  and ( :P334_IDNEGOCIADORA is null or exists ( select 1
                                                                from usuarios u
                                                                where u.usuario = b.responsavelcobranca
                                                                  and u.idusuario = :P334_IDNEGOCIADORA ) )
                  and ( :P334_TIPODATA = 'T'
                     or ( :P334_TIPODATA = 'V' and trunc(pb.datavencimento) between to_date(:P334_DATAINICIO) and to_date(:P334_DATAFIM) )
                     or ( :P334_TIPODATA = 'B' and trunc(pb.databaixa) between to_date(:P334_DATAINICIO) and to_date(:P334_DATAFIM) ) )
                order by 1, 2
                ```
        }
