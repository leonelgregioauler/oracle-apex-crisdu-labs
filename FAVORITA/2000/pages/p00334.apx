    pageItem P334_SESSION_IMPRIMIR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @impressão
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_url varchar2(2000);
                    l_app number := 2000;
                    l_session number := v('APP_SESSION');
                BEGIN
                    l_url := APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p=' || l_app || ':336:'||l_session||'::NO::P336_IDUSUARIO:'||:P334_IDUSUARIO,
                        p_checksum_type => 'SESSION');
                    
                    return l_url;
                END;
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

