    region negociações-por-empresa (
        name: Negociações por Empresa
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome empresa
                     , nvl(( select sum(pp.valorapagar) valor
                             from vw_parcelamentospedidos_fav pp
                             where pp.situacao = 'Q'
                               and pp.idnegociadoraresponsavel is not null
                               and ( :P334_DATAINICIO is null or trunc(pp.databaixa) between to_date(:P334_DATAINICIO) and to_date(:P334_DATAFIM) )
                               and pp.idfilialromance = f.idfilial ),0) valorfavorita
                     , nvl(( select sum(pn.valorapagar) 
                             from roman.notasvendas n
                                , roman.parcelamentosnotasvendas pn
                             where pn.idnotavenda = n.idnotavenda
                               and idnegociacaoparceiro is null
                               and n.responsavelcobranca is not null
                               and pn.situacao = 'Q'
                               and ( :P334_DATAINICIO is null or trunc(pn.databaixa) between to_date(:P334_DATAINICIO) and to_date(:P334_DATAFIM) ) 
                               and n.idfilial = f.idfilial ),0) valorromance
                     , nvl(( select sum(ppr.valorapagar) valor
                             from roman.pepinosrepresentantes pr
                                , roman.parcelamentospepinosrepres ppr
                             where ppr.idpepinorepresentante = pr.idpepinosrepresentante
                               and ppr.situacao = 'Q'
                               and ( :P334_DATAINICIO is null or trunc(ppr.databaixa) between to_date(:P334_DATAINICIO) and to_date(:P334_DATAFIM) )
                               and pr.idfilial = f.idfilial ),0) valorpepinos 
                     , nvl(( select sum(b.valorcobrado)
                             from boletos b
                             where b.responsavelcobranca is not null
                               and b.situacao = 'Q'
                               and not exists ( select 1
                                                from catal.parcelamentosboletos pb 
                                                where pb.idboleto = b.idboleto )
                               and ( :P334_DATAINICIO is null or trunc(b.databaixa) between to_date(:P334_DATAINICIO) and to_date(:P334_DATAFIM) ) 
                               and b.idfilial = f.idfilial ),0) valorboleto
                     , nvl(( select sum(pb.valorapagar)
                             from boletos b
                                , catal.parcelamentosboletos pb
                             where b.responsavelcobranca is not null
                               and pb.idboleto = b.idboleto
                               and idnegociacaoparceiro is null
                               and pb.situacao = 'Q'
                               and ( :P334_DATAINICIO is null or trunc(pb.databaixa) between to_date(:P334_DATAINICIO) and to_date(:P334_DATAFIM) ) 
                               and b.idfilial = f.idfilial ),0) valorfavoritaparc
                from roman.vw_filiais f
                where f.ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
