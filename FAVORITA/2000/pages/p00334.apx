    region geral (
        name: Geral
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Favorita' origem
                     , sum(pp.valorapagar) valorpago
                from vw_parcelamentospedidos_fav pp
                where pp.situacao = 'Q'
                  and ( :P334_DATAINICIO is null or trunc(pp.databaixa) between to_date(:P334_DATAINICIO) and to_date(:P334_DATAFIM) ) 
                union all
                select 'Romance'
                     , sum(nvl(pn.valorapagar,0)) valor
                from roman.parcelamentosnotasvendas pn
                where pn.situacao = 'Q'
                  and idnegociacaoparceiro is null
                  and exists ( select 1
                               from roman.notasvendas nv
                               where nv.idnotavenda = pn.idnotavenda
                                 and nv.responsavelcobranca is not null )
                  and exists ( select 1
                               from roman.vw_filiais f
                                  , roman.notasvendas nv
                               where nv.idnotavenda = pn.idnotavenda
                                 and f.idfilial     = nv.idfilial
                                 and f.idgrupo     != 5 )
                  and ( :P334_DATAINICIO is null or trunc(pn.databaixa) between to_date(:P334_DATAINICIO) and to_date(:P334_DATAFIM) ) 
                union all
                select 'Romance Antiga'
                     , sum(ppr.valorapagar) valor
                from roman.parcelamentospepinosrepres ppr
                where ppr.situacao = 'Q'
                  and ( :P334_DATAINICIO is null or trunc(ppr.databaixa) between to_date(:P334_DATAINICIO) and to_date(:P334_DATAFIM) ) 
                union all
                select 'Favorita Antiga'
                     , sum(b.valorcobrado) valor
                from boletos b
                where b.responsavelcobranca is not null
                  and b.situacao = 'Q'
                  and exists ( select 1
                               from roman.vw_filiais f
                               where f.idfilial = b.idfilial
                                 and f.idgrupo != 5 )
                  and not exists ( select 1
                                   from catal.parcelamentosboletos pb 
                                   where pb.idboleto = b.idboleto )
                  and ( :P334_DATAINICIO is null or trunc(b.databaixa) between to_date(:P334_DATAINICIO) and to_date(:P334_DATAFIM) ) 
                union all
                select 'Favorita Antiga Parcelamento'
                     , sum(pb.valorapagar) valor
                from boletos b
                   , catal.parcelamentosboletos pb
                where b.responsavelcobranca is not null
                  and idnegociacaoparceiro is null
                  and exists ( select 1
                               from roman.vw_filiais f
                               where f.idfilial = b.idfilial
                                 and f.idgrupo != 5 )
                  and pb.idboleto = b.idboleto
                  and pb.situacao = 'Q'
                  and ( :P334_DATAINICIO is null or trunc(pb.databaixa) between to_date(:P334_DATAINICIO) and to_date(:P334_DATAFIM) ) 
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P334_TIPORELATORIO
            value: G
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 13024366013681227615
        }

