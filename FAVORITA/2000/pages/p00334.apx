    process gerar-impressão-de-negociadora (
        name: Gerar impressão de Negociadora
        type: executeCode
        editableRegion: @negociações
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidusuario      number := :IDUSUARIO;
                  vidpedido       number;
                  vidboleto       number;
                  vidnotavenda    number;
                  vidpepinorepres number;
                  vorigem         varchar2(1) := :TIPO;
                  vdataimpressao  date := sysdate; 
                  vimpressao      varchar2(1) := 'N';
                  --
                begin
                  --
                  if :TIPO = 'f' then 
                    --
                    vidpedido := :IDPEDIDO;
                    --
                  elsif :TIPO = 'n' then
                    --
                    vidnotavenda := :IDPEDIDO;
                    --
                  elsif :TIPO = 'd' then
                    --
                    vidpepinorepres := :IDPEDIDO;
                    --
                  elsif :TIPO = 'b' then
                    --
                    vidboleto := :IDPEDIDO;
                    --
                  end if;
                  --
                  insert into reimpressoesnegociacoes
                  values ( vidusuario , vidpedido , vidboleto , vidnotavenda , vidpepinorepres , vorigem, :P334_DATAINICIO , :P334_DATAFIM , vdataimpressao , vimpressao );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 5874439902582249618
        }
        serverSideCondition {
            type: request=Value
            value: ADICIONAR
        }
    )

    branch (
        name: Go To Page 334
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 334
                items: {
                    P334_IDFILIALROMANCE: &P334_IDFILIALROMANCE.
                    P334_IDNEGOCIADORA: &P334_IDNEGOCIADORA.
                    P334_SITUACAO: &P334_SITUACAO.
                    P334_TIPODATA: &P334_TIPODATA.
                    P334_DATAINICIO: &P334_DATAINICIO.
                    P334_DATAFIM: &P334_DATAFIM.
                    P334_TIPORELATORIO: &P334_TIPORELATORIO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: never
        }
    )

)

