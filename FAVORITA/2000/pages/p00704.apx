    pageItem P704_FILIAL (
        type: selectList
        label {
            label: Franquia:
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select fl.nome
                     , fl.idfilial
                from roman.vw_filiais fl
                where exists ( select 1
                               from roman.comger_parametros p
                               where p.idfilialromance = fl.idfilial )
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--xlarge
            ]
            height: 1
        }
    )

    pageItem P704_GESTOR (
        type: selectList
        label {
            label: Gestor:
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomegerente(g.idgerente) d
                     , g.idgerente r
                from ( select distinct b.idgerente
                       from roman.comger_bonus b
                       where ( :P704_FILIAL is null or b.idfilialromance = :P704_FILIAL ) ) g
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Todos -
        }
        cascadingLov {
            parentItems: P704_FILIAL
        }
        layout {
            sequence: 15
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--xlarge
            ]
            height: 1
        }
    )

