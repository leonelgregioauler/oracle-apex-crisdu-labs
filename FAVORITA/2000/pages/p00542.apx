    pageItem P542_IDVENDEDORA (
        type: popupLov
        label {
            label: Cliente
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' ('||nvl(p.cpf,p.documentoestrangeiro)||')' display_value
                     , v.idvendedora
                from vendedoras v
                   , pessoas p
                where p.idpessoa = v.idpessoa
                  and (:P542_IDREPRESENTANTE is null or v.idrepresentante = :P542_IDREPRESENTANTE)
                order by 1
                ```
            nullDisplayValue: - Todos -
        }
        cascadingLov {
            parentItems: P542_IDREPRESENTANTE
        }
        layout {
            sequence: 70
            region: @filtros
