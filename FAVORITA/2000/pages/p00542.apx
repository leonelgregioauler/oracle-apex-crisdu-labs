        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(idrepresentante) display_value
                     , idrepresentante
                from representantes
                where (:P542_IDFILIALROMANCE is null or
                    ( :P542_IDFILIALROMANCE is not null and idgerente in ( select idgerente from gerentes where idfilial = :P542_IDFILIALROMANCE) ))
                order by 1
                ```
