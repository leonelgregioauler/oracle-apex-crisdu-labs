            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util_fav.fnc_verificaacesso(58005,:P0_IDUSUARIO) = 'S'
                ```
        }
        security {
            encryptSessionState: false
        }
    )

