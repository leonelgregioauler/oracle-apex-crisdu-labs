    pageItem P542_REMESSA (
        type: selectList
        label {
            label: Remessa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.numero||' - '||pck_util_fav.fnc_retornasitcompratransf(c.idsituacao,1)
                               ||' - '||roman.pck_romance.fnc_nomepostoavancado(c.idpostoavancadodestino)display_value
                 , c.idcompratransferencia return_value
                from comprastransferencias c
                where c.idfilialromancedestino = :P542_IDFILIALROMANCE
                  and :P542_IDPOSTOAVACADO is null or c.idpostoavancadodestino = :P542_IDPOSTOAVANCADO
                order by numero
                ```
            nullDisplayValue: "- Todas - "
        }
        cascadingLov {
            parentItems: P542_IDFILIALROMANCE
        }
