    button bt-filtrar (
        buttonName: BT_FILTRAR
        label: Filtrar
        layout {
            sequence: 40
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: openModal('FILTRO');
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 10
            region: @filtros
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
            ]
            icon: fa-filter
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button novopedido (
        buttonName: NOVOPEDIDO_1
        label: Novo Pedido
        layout {
            sequence: 20
            region: @filtros
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 80
                items: {
                    P80_IDVENDEDORA:
                    P80_IDPEDIDO:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P0_NUMEROPOSICAOATENDIMENTO
        }
    )

    dynamicAction abre-filtro (
        name: Abre Filtro
        execution {
            sequence: 20
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P542_FILTROAPLICADO is null
                  and :P0_NUMEROPOSICAOATENDIMENTO is not null
                ```
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: javascript: openModal('FILTRO');
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction selecionar-data (
        name: Selecionar data
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P542_DATA
        }
        clientSideCondition {
            type: item!=value
            item: P542_DATA
            value: N
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P542_DATAINI
                    P542_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P542_DATAINI
            }
            execution {
                sequence: 20
            }
        )

        action native-set-value (
            action: setValue
            affectedElements {
                selectionType: items
                items: [
                    P542_DATAINI
                    P542_DATAFIM
                ]
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P542_DATAINI
                    P542_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: Filtrar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 542
                items: {
                    P542_DATA: &P542_DATA.
                    P542_DATAINI: &P542_DATAINI.
                    P542_DATAFIM: &P542_DATAFIM.
                    P542_IDFILIALROMANCE: &P542_IDFILIALROMANCE.
                    P542_IDPOSTOAVANCADO: &P542_IDPOSTOAVANCADO.
                    P542_IDREPRESENTANTE: &P542_IDREPRESENTANTE.
                    P542_IDVENDEDORA: &P542_IDVENDEDORA.
                    P542_NRPEDIDO: &P542_NRPEDIDO.
                    P542_NRPROTOCOLO: &P542_NRPROTOCOLO.
                    P542_REMESSA: &P542_REMESSA.
                    P542_VOLUME: &P542_VOLUME.
                    P542_IDTAREFA: &P542_IDTAREFA.
                    P542_VLRTOTAL: &P542_VLRTOTAL.
                    P542_ENVIARCORREIO: &P542_ENVIARCORREIO.
                    P542_IDFILIALFAVORITA: &P542_IDFILIALFAVORITA.
                    P542_FILTROAPLICADO: S
                    P542_TIPOPEDIDO: &P542_TIPOPEDIDO.
                    P542_PA: &P542_PA.
                    P542_FUNCIONARIO: &P542_FUNCIONARIO.
                    P542_PROMISSORIARECEBIDA: &P542_PROMISSORIARECEBIDA.
                    P542_IDSITUACAOPROMISSORIA: &P542_IDSITUACAOPROMISSORIA.
                    P542_IDGERENTE: &P542_IDGERENTE.
                    P542_ATENDENTE: &P542_ATENDENTE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

