    pageItem P542_IDGERENTE (
        type: selectList
        label {
            label: Gerente
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomegerente(g.idgerente) d
                  , g.idgerente r
                from gerentes g
                where g.ativo = 'S'
                order by 1
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 280
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
