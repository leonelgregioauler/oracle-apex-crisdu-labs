    pageItem P147_SAIDA (
        type: selectList
        label {
            label: Origem de Saída
            alignment: left
        }
        lov {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                    l_sql varchar2(32767);
                    vusucall varchar2(1);
                begin
                    
                    begin
                      
                       select 'S'
                       into vusucall
                       from usuarios u
                       where u.usuario = v('APP_USER')
                         and u.idfilialfavorita = 1;
                    exception
                       when no_data_found then 
                        vusucall := 'N';
                    end;
                   
                    if :P147_TIPOPEDIDO = 'R' and vusucall = 'N' then
                        l_sql := '
                            select pck_util_fav.fnc_nomefilialfavorita(u.idfilialfavorita) franquia
                                 , u.idfilialfavorita idfilialfavorita
                            from usuarios u
                            where u.usuario = v(''APP_USER'')
                            
                            union 
                            
                            select pck_util_fav.fnc_nomefilialfavorita(at.idfilialfavoritaorigem) franquia
                                 , at.idfilialfavoritaorigem
                            from parametros p
                               , atendimentosestoques at
                            where p.idfilialfavorita = at.idfilialfavoritadestino
                              and p.nome = ''ROMANCECASALIBERACDABASTECEDOR''
                              and p.valor = ''S''
                              and p.idfilialfavorita = ( select u.idfilialfavorita
                                                         from usuarios u
                                                         where u.usuario = v(''APP_USER'') )
                            order by 1 desc
                        ';
                    elsif :P147_TIPOPEDIDO = 'P' and vusucall = 'N'  then
                        l_sql := '
                            select pck_util_fav.fnc_nomefilialfavorita(u.idfilialfavorita) franquia
                                 , u.idfilialfavorita idfilialfavorita
                            from usuarios u
                            where u.usuario = v(''APP_USER'')
                            
                            union 
                            
                            select pck_util_fav.fnc_nomefilialfavorita(at.idfilialfavoritaorigem) franquia
                                 , at.idfilialfavoritaorigem
                            from parametros p
                               , atendimentosestoques at
                            where p.idfilialfavorita = at.idfilialfavoritadestino
                              and p.nome = ''PEDIDONORMALCDABASTECEDOR''
                              and p.valor = ''S''
                              and p.idfilialfavorita = ( select u.idfilialfavorita
                                                         from usuarios u
                                                         where u.usuario = v(''APP_USER'') )
                            order by 1 desc
                        ';
                    elsif :P147_TIPOPEDIDO in ('R','P') and vusucall = 'S' then
                
                        l_sql := '
                            select pck_util_fav.fnc_nomefilialfavorita(u.idfilialfavorita) franquia
                                 , u.idfilialfavorita idfilialfavorita
                            from usuarios u
                            where u.usuario = v(''APP_USER'')';
                        
                    else
                        -- Retorna uma query padrão caso nenhum dos valores seja aplicado
                        l_sql := '
                            select pck_util_fav.fnc_nomefilialfavorita(u.idfilialfavorita) franquia
                                 , u.idfilialfavorita idfilialfavorita
                            from usuarios u
                            where u.usuario = v(''APP_USER'')';
                    end if;
                    
                    -- Retorna a query como SQL Dinâmico
                    return l_sql;
                end;
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 100
            region: @data-de-entrega-do-pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
    )

