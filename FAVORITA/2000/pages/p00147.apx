            slot: dialogHeader
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P147_CIDADES (
        type: checkboxGroup
        label {
            alignment: left
        }
        settings {
            noOfCols: 5
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct c.nomecidade as d
                     , p.idcidade as r
                from roman.cidades c
                   , pessoas p
                   , vendedoras v
                   , roman.notasvendas nv
                where v.idvendedora = nv.idvendedora
                and p.idpessoa = v.idpessoa
                and c.idcidade = p.idcidade
                and nv.idrepresentante in ( select idrepresentante
                                            from vendedoras
                                            where idvendedora = :P147_IDVENDEDORA )
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P147_IDVENDEDORA
        }
        layout {
            sequence: 40
            region: @cidades-atendidas-fora-do-prazo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P147_CONFIRMARENTREGAATRASO (
        type: checkboxGroup
        label {
            alignment: left
