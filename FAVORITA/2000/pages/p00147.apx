    pageItem P147_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Loja Emitente
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(a.idfilialfavoritadestino) d
                     , a.idfilialfavoritadestino r
                from atendimentosestoques a
                where a.idfilialfavoritaorigem = :P0_IDFILIALFAVORITA
                  and exists ( select 1
                               from filiaisfavorita ff
                               where ff.idfilialfavorita = a.idfilialfavoritadestino
                                 and ff.tipofilial = 'L' );
                ```
        }
        layout {
            sequence: 80
            region: @data-de-entrega-do-pedido
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from parametros
                where nome = 'FLUXO_DELIVERY'
                  and valor = 'S'
                  and idfilialfavorita = :P0_IDFILIALFAVORITA
                ```
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

