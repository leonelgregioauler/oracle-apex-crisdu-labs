    button proximopasso (
        buttonName: PROXIMOPASSO
        label: Próximo Passo
        layout {
            sequence: 10
            region: @new
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction proximo-passo (
        name: proximo passo
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @proximopasso
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                     declare
                      --
                      vidiniciaprepedido            number := :P147_IDPEDIDO;
                      vidfilialfavorita             number := :P0_IDFILIALFAVORITA;--:P147_SAIDA;
                      vidfilialfavoritaorig         number := :P147_IDFILIALFAVORITA;--:P0_IDFILIALFAVORITA;
                      vidvendedora                  number;
                      vidusuario                    number := nvl(:P147_USUARIO_PEDIDO,:P0_IDUSUARIO);
                      vnumeroposicaoatendimento     varchar2(10);
                      vtipopedido                   varchar2(1);
                      vidusuariodigitou             number := :P0_IDUSUARIO;
                      --
                    begin
                      --
                      --raise_application_error(-20001,'passei aqui'||'-'||vidfilialfavorita);
                    
                      if :P147_VENDAESPECIAL = 'S' then
                        vtipopedido := 'R';
                      end if;
                      pck_pedidos_fav.prc_iniciaprepedido (  vidiniciaprepedido
                                                           , vidfilialfavorita
                                                           , vidvendedora
                                                           , vidusuario
                                                           , vnumeroposicaoatendimento
                                                           , vtipopedido
                                                           , :P147_DATAENTREGA
                                                           , vidusuariodigitou
                                                           , vidfilialfavoritaorig
                                                           , 'U' );
                      --
                      :P147_IDPEDIDO := vidiniciaprepedido;
                      --
                    end;
                    ```
                itemsToSubmit: [
                    P147_IDPEDIDO
                    P147_USUARIO_PEDIDO
                    P147_IDUSUARIO
                    P147_SAIDA
                ]
                itemsToReturn: [
                    P147_IDPEDIDO
                    P147_USUARIO_PEDIDO
                    P147_IDUSUARIO
                    P147_SAIDA
                ]
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: PROXIMOPASSO
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

