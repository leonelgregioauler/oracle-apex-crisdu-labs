page 147 (
    name: Data de Entrega Pedido
    title: Data de Entrega Pedido
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 60%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        authentication: public
        pageAccessProtection: unrestricted
    }

    region cidades-atendidas-fora-do-prazo (
        name: Cidades Atendidas Fora do Prazo
        type: staticContent
        layout {
            sequence: 40
            slot: contentBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        readOnly {
            type: always
        }
    )

    region data-de-entrega-do-pedido (
        name: Data de Entrega do Pedido
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region new (
        name: New
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--hiddenOverflow
            ]
