    pageItem P147_USUARIO_PEDIDO (
        type: selectList
        label {
            label: Usuário Pedido
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(pe.nomepessoa) d,
                       u.idusuario r
                from usuarios u,
                     pessoas pe
                where u.idpessoa = pe.idpessoa
                and exists (select 1
                           from filiaisfavorita f
                           where f.idfilialfavorita = u.idfilialfavorita
                           and f.tipofilial = 'L')
                and u.idfilialfavorita = :P0_IDFILIALFAVORITA
                --and u.idusuario != :P0_IDUSUARIO -- comentado no ticket 8892923
                and :P147_IDFILIALFAVORITA is null
                union
                select initcap(pe.nomepessoa) d,
                       u.idusuario r
                from usuarios u,
                     pessoas pe
                where u.idpessoa = pe.idpessoa
                and exists (select 1
                           from filiaisfavorita f
                           where f.idfilialfavorita = u.idfilialfavorita
                           and f.tipofilial = 'L')
                and u.idfilialfavorita = :P147_IDFILIALFAVORITA
                and u.idusuario != :P0_IDUSUARIO
                and :P147_IDFILIALFAVORITA is not null
                
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: [
                P0_IDFILIALFAVORITA
                P147_IDFILIALFAVORITA
            ]
        }
        layout {
            sequence: 20
            region: @data-de-entrega-do-pedido
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                (select pck_util_fav.fnc_verificaacesso(pidaplicacao => 29106, pidusuario => :P0_IDUSUARIO)
                from dual) = 'S'
                ```
        }
        security {
            encryptSessionState: false
        }
    )

