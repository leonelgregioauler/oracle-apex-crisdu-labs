    )

    validation valida-data (
        name: valida data > 45
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where to_date(:P147_DATAENTREGA,'DD/MM/RRRR') - trunc(sysdate) > 45
                ```
        }
        error {
            errorMessage: Prazo de entrega do pedido inválido!
        }
        serverSideCondition {
            whenButtonPressed: @proximopasso
            type: never
        }
    )

    validation valida-data-2 (
        name: valida data < 5
        execution {
            sequence: 20
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where to_date(:P147_DATAENTREGA,'DD/MM/RRRR') - trunc(sysdate) < 5
                ```
        }
        error {
            errorMessage: Prazo de entrega do pedido inválido!
        }
        serverSideCondition {
            type: never
        }
    )

    process carregar-cidades-atendidas-pelos-distribuidores (
        name: Carregar Cidades Atendidas pelos Distribuidores
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  AS_CHECK_BOX APEX_APPLICATION_GLOBAL.VC_ARR2;
                  i            integer := 1;
                  vexiste      varchar2(1) := 'N';
                  --
                  vconfirmarentregaatraso varchar2(1);
                  vdemaisregioesnaoligar  varchar2(1);
                  --
                begin
                  --
                  :P147_CIDADES := null;
                  --
                  --raise_application_error(-20001,'LIMPOU CIDADES');
                  --
                  for c in ( select idcidade
                             from cidadesrepatendeforaprazo
                             where idrepresentante in ( select idrepresentante 
                                                        from vendedoras 
                                                        where idvendedora = :P147_IDVENDEDORA ) )                                        
                  --
                  loop
                    --
                    AS_CHECK_BOX(i) := c.idcidade;
                    --
                    i := i + 1;
                    --
                    vexiste := 'S';
                    --
                  end loop;
                  --
                  if vexiste = 'S' then
                    :P147_CIDADES := APEX_UTIL.TABLE_TO_STRING(AS_CHECK_BOX, ':');
                  end if;
                  --
                  select r.confirmarentregaatraso
                       , r.demaisregioesnaoligar
                  into vconfirmarentregaatraso
                     , vdemaisregioesnaoligar
                  from representantes r
                     , vendedoras v
                  where r.idrepresentante = v.idrepresentante 
                  and v.idvendedora = :P147_IDVENDEDORA;
                  --
                  :P147_CONFIRMARENTREGAATRASO   := vconfirmarentregaatraso;
                  :P147_NAO_LIGAR_DEMAIS_REGIOES := vdemaisregioesnaoligar;
                  --
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 1585671707794869541
        }
    )

    process excluir-pedido (
        name: Excluir pedido
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  delete from alteracoespedidos
                  where idpedido = :P147_IDPEDIDO;
                  --
                  delete from classificacoespedidos
                  where idpedido = :P147_IDPEDIDO;
                  --
                  delete from pedidos
                  where idpedido = :P147_IDPEDIDO;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Pedido excluído com sucesso.
        }
        advanced {
            executionMappingIdentifier: 1585670980070869539
        }
        serverSideCondition {
            type: request=Value
            value: EXCLUIR
        }
    )

    process limpa-cache-de-item (
