    process verificar-data-limite-e-data-de-entrega (
        name: Verificar Data Limite e Data de Entrega
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidvendedora                number := :P147_IDVENDEDORA;
                  vdatalimitepedidos          date;
                  vdataretornodistribuidor    date;
                  viddataregiao               number;
                  vfazeratemeiodia            varchar2(1);
                  vidpostoavancado            number;
                  vidrepresentante            number;
                  vobservacaocallcenter       varchar2(1000);
                  --
                begin
                  --
                  :P147_DATALIMITEPEDIDOS     := null;
                  :P147_RETORNODISTRIBUIDOR   := null;
                  --
                  select r.idrepresentante
                       , r.idpostoavancado
                       , (select observacaocallcenter
                          from pessoas
                          where idpessoa = r.idpessoa ) observacao
                  into vidrepresentante
                     , vidpostoavancado
                     , vobservacaocallcenter
                  from representantes r
                     , vendedoras v
                  where v.idrepresentante = r.idrepresentante
                    and v.idvendedora     = vidvendedora;
                  --
                  :P147_OBSERVACAO := vobservacaocallcenter;
                  --
                  if vidpostoavancado not in ( 0,1,529,800 ) then
                    vidpostoavancado := null;
                  end if;
                  --
                  begin
                    --
                    -- filial
                    for i in ( 
                    select min(datalimitepedidos) datalimitepedidos
                         , min(dataentrega) dataentrega
                         , min(iddataregiao) iddataregiao
                     from vw_dataslimitepedidos_fav d
                    where d.idvendedora = vidvendedora 
                      and d.idrepresentante = vidrepresentante
                      and vidpostoavancado is null
                      and not exists ( select 1
                                       from regioesfiliais rf
                                       where rf.idrepresentante = d.idrepresentante
                                         and rf.idfilialromance = d.idfilialromance )       
                      and datalimitepedidos >= trunc(sysdate)
                      and d.idrepresregiao is null and idpostoavancado is null  
                    union  
                    -- marina, julio e demais
                    select min(datalimitepedidos) datalimitepedidos
                         , min(dataentrega) dataentrega
                         , min(iddataregiao) iddataregiao
                     from vw_dataslimitepedidos_fav d
                    where d.idvendedora = vidvendedora 
                      and d.idrepresregiao = vidrepresentante  
                      and exists ( select 1
                                   from regioesfiliais rf
                                   where rf.idrepresentante = d.idrepresentante
                                     and rf.idfilialromance = d.idfilialromance)
                      and datalimitepedidos >= trunc(sysdate)
                      and d.idrepresregiao is not null and idpostoavancado is null  
                    union
                    -- posto avançado
                    select min(datalimitepedidos) datalimitepedidos
                         , min(dataentrega) dataentrega
                         , min(iddataregiao) iddataregiao
                     from vw_dataslimitepedidos_fav d
                    where d.idvendedora = vidvendedora 
                      and d.idrepresentante = vidrepresentante
                      and d.idpostoavancado = vidpostoavancado
                      and datalimitepedidos >= trunc(sysdate)
                      and d.idrepresregiao is null and idpostoavancado is not null )
                    --
                    loop
                    --
                     if i.datalimitepedidos is not null then
                        vdatalimitepedidos := i.datalimitepedidos;
                        vdataretornodistribuidor := i.dataentrega;
                        viddataregiao := i.iddataregiao;
                     end if;
                        --
                    end loop;
                    --    
                    select fazeratemeiodia
                    into vfazeratemeiodia
                    from datasregioes
                    where iddataregiao = viddataregiao;
                    --
                    if upper(vfazeratemeiodia) = 'S' then
                      :P147_DATALIMITEPEDIDOS   := vdatalimitepedidos || ' >> Até o meio-dia';
                    else 
                      :P147_DATALIMITEPEDIDOS   := vdatalimitepedidos;
                    end if;
                    --
                    :P147_RETORNODISTRIBUIDOR := vdataretornodistribuidor;
                    --
                  exception
                    when others then
                      null;
                  end;
                  --
                end;
                ```
        }
        execution {
            sequence: 20
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1585671309867869541
        }
    )

