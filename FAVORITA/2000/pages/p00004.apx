page 4 (
    name: Cadastro de Prateleiras Estoques
    title: Cadastro de Prateleiras Estoques
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region cadastro-de-prateleiras-estoques (
        name: Cadastro de Prateleiras Estoques
        type: tabform
        source {
            sqlQuery:
                ```sql
                select idprateleiraestoque
                	 , idcorredorestoque
                	 , ordem
                	 , descricao
                from prateleirasestoques
                where idcorredorestoque = :P4_IDCORREDORESTOQUE;
                
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            showNullValuesAs: (null)
        }
        pagination {
            type: setPaginationSelectList
            partialPageRefresh: false
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Não encontrou informações.
        }
        componentAdvanced {
            stripHtml: true
        }

        column CHECK$01 (
            reportColumnQueryId: 5
            derivedColumn: Y
            type: rowSelector
            heading {
                heading: Select Row
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column DESCRICAO (
            reportColumnQueryId: 4
            derivedColumn: N
            type: textField
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 4
            }
            appearance {
                width: 70
            }
        )

        column IDCORREDORESTOQUE (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 3
            }
            default {
                type: item
                item: P4_IDCORREDORESTOQUE
            }
        )

        column IDPRATELEIRAESTOQUE (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hiddenSavesState
            layout {
                sequence: 2
            }
            primaryKeySource {
                type: existingSequence
                name: SEQ_IDPRATELEIRAESTOQUE
            }
        )

        column ORDEM (
            reportColumnQueryId: 3
            derivedColumn: N
            type: textField
            heading {
                heading: Ordem
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: end
            }
            appearance {
                width: 16
            }
        )

    )

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
    )

    pageItem P4_IDCORREDORESTOQUE (
        type: numberField
        label {
            label: Idcorredorestoque
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button adicionarlinha (
        buttonName: ADICIONARLINHA
        label: Adicionar Linha
        layout {
            sequence: 10
            region: @cadastro-de-prateleiras-estoques
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.widget.tabular.addRow();
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button excluirlinha (
        buttonName: EXCLUIRLINHA
        label: Excluir
        layout {
            sequence: 30
            region: @cadastro-de-prateleiras-estoques
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIRLINHA');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from prateleirasestoques
                where idcorredorestoque = :P4_IDCORREDORESTOQUE;
                ```
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 20
            region: @cadastro-de-prateleiras-estoques
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 2
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inseriratualizar (
        buttonName: INSERIRATUALIZAR
        label: Inserir / Atualizar
        layout {
            sequence: 40
            region: @cadastro-de-prateleiras-estoques
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation corredordescricao-unique (
        name: CORREDORDESCRICAO unique
        execution {
            sequence: 90
        }
        validation {
            editableRegion: @cadastro-de-prateleiras-estoques
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidcorredorestoque number;
                  vdescricao varchar2(1000);
                begin
                  select idcorredorestoque
                       , descricao
                  into vidcorredorestoque
                     , vdescricao
                  from prateleirasestoques
                  where idcorredorestoque = :IDCORREDORESTOQUE
                  and descricao = :DESCRICAO;
                  --
                  if vidcorredorestoque is not null and vdescricao is not null then
                    return 'Existe um cadastro no sistema com estas informações. Não são permitidas informações repetidas para este cadastro.';
                  end if;
                  --
                exception
                  when no_data_found then
                    return '';
                end;
                ```
        }
        error {
            associatedColumn: DESCRICAO
        }
    )

    validation corredorordem-unique (
        name: CORREDORORDEM unique
        execution {
            sequence: 80
        }
        validation {
            editableRegion: @cadastro-de-prateleiras-estoques
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidcorredorestoque number;
                  vordem number;
                begin
                  select idcorredorestoque
                       , ordem
                  into vidcorredorestoque
                     , vordem
                  from prateleirasestoques
                  where idcorredorestoque = :IDCORREDORESTOQUE
                  and ordem = :ORDEM;
                  --
                  if vidcorredorestoque is not null and vordem is not null then
                    return 'Existe um cadastro no sistema com estas informações. Não são permitidas informações repetidas para este cadastro.';
                  end if;
                  --
                exception
                  when no_data_found then
                    return '';
                end;
                ```
        }
        error {
            associatedColumn: ORDEM
        }
    )

    validation descricao-obrigatório (
        name: DESCRICAO obrigatório
        execution {
            sequence: 50
        }
        validation {
            editableRegion: @cadastro-de-prateleiras-estoques
            type: columnIsNotNull
            column: DESCRICAO
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ter um valor.
            associatedColumn: DESCRICAO
        }
    )

    validation idcorredorestoque-must-be-numeric (
        name: IDCORREDORESTOQUE must be numeric
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @cadastro-de-prateleiras-estoques
            type: columnIsNumeric
            column: IDCORREDORESTOQUE
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ser numérico.
            associatedColumn: IDCORREDORESTOQUE
        }
        serverSideCondition {
            whenButtonPressed: @inseriratualizar
        }
    )

    validation idcorredorestoque-not-null (
        name: IDCORREDORESTOQUE not null
        execution {
            sequence: 30
        }
        validation {
            editableRegion: @cadastro-de-prateleiras-estoques
            type: columnIsNotNull
            column: IDCORREDORESTOQUE
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ter um valor.
            associatedColumn: IDCORREDORESTOQUE
        }
        serverSideCondition {
            whenButtonPressed: @inseriratualizar
        }
    )

    validation ordem-maior-que (
        name: ORDEM maior que 0
        execution {
            sequence: 70
        }
        validation {
            editableRegion: @cadastro-de-prateleiras-estoques
            plsqlExpression: :ORDEM > 0;
        }
        error {
            errorMessage: Ordem deve ser maior que zero (0).
            associatedColumn: ORDEM
        }
    )

    validation ordem-must-be-numeric (
        name: ORDEM must be numeric
        execution {
            sequence: 40
        }
        validation {
            editableRegion: @cadastro-de-prateleiras-estoques
            type: columnIsNumeric
            column: ORDEM
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ser numérico.
            associatedColumn: ORDEM
        }
        serverSideCondition {
            whenButtonPressed: @inseriratualizar
        }
    )

    validation ordem-obrigatório (
        name: ORDEM obrigatório
        execution {
            sequence: 60
        }
        validation {
            editableRegion: @cadastro-de-prateleiras-estoques
            type: columnIsNotNull
            column: ORDEM
        }
        error {
            errorMessage: #COLUMN_HEADER# deve ter um valor.
            associatedColumn: ORDEM
        }
    )

    process applymrd (
        name: ApplyMRD
        type: tabformDelete
        editableRegion: @cadastro-de-prateleiras-estoques
        target {
            tableName: PRATELEIRASESTOQUES
            pkColumn: IDPRATELEIRAESTOQUE
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: #MRD_COUNT# registro(s) excluído(s).
        }
        error {
            errorMessage: Não é possível excluir este registro pois existe outra informação associada com esta sendo utilizada no sistema.
        }
        advanced {
            executionMappingIdentifier: 13663069945908601
        }
        serverSideCondition {
            whenButtonPressed: @excluirlinha
            type: request=Value
            value: EXCLUIRLINHA
        }
    )

    process applymru (
        name: ApplyMRU
        type: tabformUpdate
        editableRegion: @cadastro-de-prateleiras-estoques
        target {
            tableName: PRATELEIRASESTOQUES
            pkColumn: IDPRATELEIRAESTOQUE
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: #MRU_COUNT# registro(s) atualizado(s), #MRI_COUNT# registro(s) inserido(s).
        }
        error {
            errorMessage: Informações incorretas.
        }
        advanced {
            executionMappingIdentifier: 13662631900908600
        }
        serverSideCondition {
            whenButtonPressed: @inseriratualizar
            type: request=Value
            value: INSERIRATUALIZAR
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 4
            }
        }
        serverSideCondition {
            whenButtonPressed: @inseriratualizar
        }
    )

)

