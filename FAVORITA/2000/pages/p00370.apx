page 370 (
    name: Gerar Tarefas Prospecção
    title: Gerar Tarefas Prospecção
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 80%
        height: 80%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region tarefas-geradas (
        name: Tarefas Geradas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idtarefa
                     , t.datainclusao
                     , t.tipotarefa
                     , t.telefone
                     , t.situacao
                     , t.observacao
                     , t.cliente
                from vw_tarefas_fav t
                where t.ididioma = 1
                  and t.idtipotarefa = 8
                  and trunc(datainclusao) = trunc(sysdate)
                order by 1
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        advanced {
            savedReportMappingIdentifier: 2800695142551703227
        }

        column CLIENTE (
            type: plainText
            heading {
                heading: Cliente
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column DATAINCLUSAO (
            type: plainText
            heading {
                heading: Inclusão
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: B
            }
        )

        column IDTAREFA (
            type: plainText
            heading {
                heading: Nr Tarefa
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column OBSERVACAO (
            type: plainText
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column SITUACAO (
            type: plainText
            heading {
                heading: Situação
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column TELEFONE (
            type: plainText
            heading {
                heading: Telefone
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column TIPOTAREFA (
            type: plainText
            heading {
                heading: Tipo da Tarefa
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 28232336 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CLIENTE (
                sequence: 7
            )

            displayColumn DATAINCLUSAO (
                sequence: 2
            )

            displayColumn IDTAREFA (
                sequence: 1
            )

            displayColumn OBSERVACAO (
                sequence: 6
            )

            displayColumn SITUACAO (
                sequence: 5
            )

            displayColumn TELEFONE (
                sequence: 4
            )

            displayColumn TIPOTAREFA (
                sequence: 3
            )

        )

    )

    pageItem P370_DATAFIM (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @tarefas-geradas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P370_DATAINICIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @tarefas-geradas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P370_DEBITO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @tarefas-geradas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P370_IDFILIALROMANCE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @tarefas-geradas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P370_IDREPRESENTANTE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @tarefas-geradas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P370_QTDNOTAS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @tarefas-geradas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction gera-as-tarefas (
        name: Gera as tarefas
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                      -- Call the procedure
                      pck_tarefas_fav.prc_geratarefaprospeccao(pidfilialromance => :P370_IDFILIALROMANCE,
                                                               pidrepresentante => :P370_IDREPRESENTANTE,
                                                               pdebito => :P370_DEBITO,
                                                               pqtdnotas => :P370_QTDNOTAS,
                                                               pdatainicio => :P370_DATAINICIO,
                                                               pdatafim => :P370_DATAFIM);
                    end;
                    ```
            }
            execution {
                sequence: 10
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @tarefas-geradas
            }
            execution {
                sequence: 20
            }
        )

    )

)

