page 432 (
    name: Atendimento Diário de Distribuidores
    title: Atendimento Diário de Distribuidores
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 60%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region atendimento-diário (
        name: Atendimento Diário
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(c.idrepresentante) distribuidor
                     , roman.pck_romance.fnc_nomefilial(c.idfilial) empresa
                     , count(distinct c.idcontrolecontatossite) qtd
                     , d.data
                from roman.dias d
                   , roman.controlecontatossite c
                where d.data between to_date(:P432_DATAINICIO) and to_date(:P432_DATAFIM)
                  and trunc(c.datapassadorepres) = d.data
                  and c.idrepresentante is not null
                  and c.situacao = 'E'
                  and exists ( select 1
                               from roman.parametros pr
                               where pr.idfilial = c.idfilial
                                 and pr.nome     = 'ENVIOINDICACAOAUTOMATICA' 
                                 and pr.valor    = 'S' )
                group by c.idrepresentante , d.data, idfilial
                ```
            pageItemsToSubmit: [
                P432_DATAINICIO
                P432_DATAFIM
            ]
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 4064531573075551609
        }

        column DATA (
            type: plainText
            heading {
                heading: Data Encaminhada
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column DISTRIBUIDOR (
            type: plainText
            heading {
                heading: Distribuidor
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column EMPRESA (
            type: plainText
            heading {
                heading: Empresa
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column QTD (
            type: plainText
            heading {
                heading: Qtd Encaminhada
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 40645620 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATA (
                sequence: 4
            )

            displayColumn DISTRIBUIDOR (
                sequence: 1
            )

            displayColumn EMPRESA (
                sequence: 2
            )

            displayColumn QTD (
                sequence: 3
            )

            sort (
                column: DATA
                sort {
                    sequence: 1
                }
            )

            sort (
                column: QTD
                sort {
                    direction: desc
                    sequence: 2
                }
            )

            aggregate (
                column: QTD
            )

            controlBreak (
                column: DATA
                layout {
                    sequence: 1
                }
            )

        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P432_DATAFIM (
        type: datePickerJquery
        label {
            label: Até
            alignment: left
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 14
        }
        default {
            type: expression
            plsqlExpression: trunc(sysdate)
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P432_DATAINICIO (
        type: datePickerJquery
        label {
            label: De
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR
            width: 14
        }
        default {
            type: expression
            plsqlExpression: trunc(sysdate)
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction refresh-data-fim (
        name: Refresh Data Fim
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P432_DATAFIM
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @atendimento-diário
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-data-inicio (
        name: Refresh Data Inicio
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P432_DATAINICIO
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @atendimento-diário
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

