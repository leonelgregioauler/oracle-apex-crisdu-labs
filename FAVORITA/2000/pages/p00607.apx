page 607 (
    name: Cad Liberações Vendas Esp.
    title: Cad Liberações Vendas Esp.
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG_24"';
    }

    region liberações-de-vendas-especiais (
        name: Liberações de Vendas Especiais
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P607_DISTRIBUIDORES (
        type: shuttle
        label {
            label: Distribuidores
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(r.idrepresentante) display_value
                     , r.idrepresentante return_value
                from catal.representantes r
                where idgerente = ( select idgerente 
                                      from catal.filiais
                                     where idfilial = :P607_IDFILIALROMANCE)
                order by 1;
                ```
        }
        cascadingLov {
            parentItems: P607_IDFILIALROMANCE
            itemsToSubmit: P607_IDFILIALROMANCE
        }
        layout {
            sequence: 40
            region: @liberações-de-vendas-especiais
            slot: regionBody
            alignment: left
            column: 1
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 5
        }
        source {
            type: databaseColumn
            databaseColumn: DISTRIBUIDORES
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P607_IDEDICAOREVISTA (
        type: selectList
        label {
            label: Edição Revista
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                  select pck_util_fav.fnc_edicaorevista(idedicaorevista) as d,
                       idedicaorevista as r
                  from edicoesrevistas
                  where vendaespecial = 'S'
                 order by 1
                ```
        }
        layout {
            sequence: 20
            region: @liberações-de-vendas-especiais
            slot: regionBody
            alignment: left
            column: 1
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDEDICAOREVISTA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P607_IDFILIALROMANCE (
        type: selectList
        label {
            label: Franquia Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome as d,
                       idfilial as r
                  from roman.vw_filiais
                 where tipofilial in ('C', 'D','A','F','L','T') -- ajusdo para atender o ticket 9461702
                   and ativo = 'S'
                   and idfilial in (select idfilial
                                      from filiaisedicoesrevistas
                                     where idedicaorevista = :P607_IDEDICAOREVISTA)
                ```
        }
        cascadingLov {
            parentItems: P607_IDEDICAOREVISTA
            itemsToSubmit: P607_IDEDICAOREVISTA
        }
        layout {
            sequence: 30
            region: @liberações-de-vendas-especiais
            slot: regionBody
            alignment: left
            column: 1
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIALROMANCE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P607_IDLIBERACAOVENDAESPECIAL (
        type: hidden
        layout {
            sequence: 10
            region: @liberações-de-vendas-especiais
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDLIBERACAOVENDAESPECIAL
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar / Voltar
        layout {
            sequence: 10
            region: @liberações-de-vendas-especiais
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 606
                request: &SESSION.
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Incluir
        layout {
            sequence: 40
            region: @liberações-de-vendas-especiais
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P607_IDLIBERACAOVENDAESPECIAL
        }
    )

    button delete (
        buttonName: DELETE
        label: Excluir
        layout {
            sequence: 20
            region: @liberações-de-vendas-especiais
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P607_IDLIBERACAOVENDAESPECIAL
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar Alterações
        layout {
            sequence: 30
            region: @liberações-de-vendas-especiais
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P607_IDLIBERACAOVENDAESPECIAL
        }
    )

    process atualiza-listagem (
        name: Atualiza Listagem
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_ti.prc_atualizalistaromancecasa;
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 3493348412373194033
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DELETE,SAVE,CREATE
        }
    )

    process fetch-row-from-liberacoesvendasespeciais (
        name: Fetch Row from LIBERACOESVENDASESPECIAIS
        type: autoRowFetch
        source {
            tableName: LIBERACOESVENDASESPECIAIS
            pkColumn: IDLIBERACAOVENDAESPECIAL
            pkItem: P607_IDLIBERACAOVENDAESPECIAL
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1500741895878235948
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P607_IDLIBERACAOVENDAESPECIAL is null then
                        select "#OWNER#"."SEQ_IDLIBERACAOVENDAESPECIAL".nextval
                          into :P607_IDLIBERACAOVENDAESPECIAL
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1500742246727235949
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-liberacoesvendasespeciais (
        name: Process Row of LIBERACOESVENDASESPECIAIS
        type: autoRowProcessing
        target {
            tableName: LIBERACOESVENDASESPECIAIS
            pkColumn: IDLIBERACAOVENDAESPECIAL
            pkItem: P607_IDLIBERACAOVENDAESPECIAL
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 1500742688469235949
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 1500743091287235949
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        name: Go To Page 606
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 606
            }
        }
    )

)

