    pageItem P585_ATENDIMENTO (
        type: selectOne
        label {
            label: Atendimento
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Financeiro', 'FIN'
                  from dual
                 where v('APP_USER') in ('BRUNASAUERESSING','FABIANAK','PALOMATAINA','LETICIAMEDEIROS','DEBORAC','ESTEFANISILVEIRA', 'ANDREPESSOA','JESSICAALTHAUS','GRAZIELEF',
                                         'OSIELF','JENNIFERSOUSA','JULIABARATER','PABLOFORTI','FRANCIELEPETRY','ANAPINHEIRO','RODRIGOJARDIM','MAICONAIMI','DIEGOPIECHO','MICHELEZIMPEL','OSIELF','CLEBERSILVA')
                union
                select 'Fiscal Comércio', 'COM'
                  from dual
                union
                select 'Fiscal Indústria', 'IND'
                  from dual
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        validation {
            valueRequired: true
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

