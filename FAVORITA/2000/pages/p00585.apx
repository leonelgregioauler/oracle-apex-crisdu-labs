    pageItem P585_IDFILIAL (
        type: selectOne
        label {
            label: Filial
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(f.idfilial) display_value 
                     , f.idfilial return_value 
                from filiais f
                where f.ativo = 'S'
                  and f.idfilial = (select g.idfilial
                                     from catal.usuarios u
                                        , catal.gerentes g
                                    where u.idgerente = g.idgerente
                                      and u.usuario = V('APP_USER'))
                  --and f.tipofilial in ( select idtipofilial
                                      --  from acessostiposfiliais
                union
                -- para uso do TI-
                select roman.pck_romance.fnc_nomefilial(f.idfilial) display_value 
                     , f.idfilial return_value 
                from filiais f
                where f.ativo = 'S'
                  and v('APP_USER') in ('MAICONAIMI')
                order by 1
                ```
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P585_SITUACAO (
        type: selectOne
        label {
            label: Situação
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.situacao display_value
                     , s.idsituacao return_value
                from roman.situacoesrequisicoes s
                -- Projeto fluxo paralelo: status onde o usu¿rio criador atua (1, 4) e status
                -- informacionais que ele acompanha (6, 7, 10, 11, 12, 13). Os status 11/13
                -- s¿o tratados internamente pelo fiscal; usu¿rio s¿ os v¿ como informa¿¿o.
                where s.idsituacao in (1, 4, 6, 7, 10, 11, 12, 13)
                order by s.idsituacao
                ```
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

