    region requisições-realizadas (
        name: Requisições Realizadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idrequisicaopgto
                     , t.Filial_origem
                     , t.Documento
                     , t.Tip_Documento
                     , t.datainclusao
                     , t.usuarioinclusao
                     , t.situacao
                     , t.Fornecedor
                     , t.contafinanceira
                     , t.subcontafinanceira
                     , t.valor
                     , t.desconto
                     , t.acrescimo
                     , t.valortotal
                     , t.vencimento
                     , t.parcelas
                     , t.qtdanexos "Qtd Anexos"
                     , t.comprovantepgto "comprovante pgto"
                     , t.usuarioaprovacao
                     , t.cnpjdest
                  from(
                select r.idrequisicaopgto
                     , roman.pck_romance.fnc_nomefilial(r.idfilial) Filial_origem
                     , r.documento Documento
                     , ( select descricao 
                         from roman.formaspagamentos fp
                         where fp.idformapagamento = r.idformapagamento)Tip_Documento
                     , r.datainclusao 
                     , r.usuarioinclusao
                     , decode(r.idsituacao,1,'Pendente',2,'Atendimento Financeiro',3,'Atendimento Fiscal',4,'Ajuste Lançamento',5,'Concluído Fiscal',6,'Programado',7,'Quitado',8,'Cancelado',10,'Programado - Fiscal Pendente',11,'Programado - Ajuste Fiscal Pendente',12,'Quitado - Fiscal Pendente',13,'Quitado - Ajuste Fiscal Pendente') situacao
                     , roman.pck_romance.fnc_nomefornecedor(r.idfornecedor)Fornecedor
                     , md.contafinanceira
                     , md.subcontafinanceira
                     , r.valor
                     , r.desconto 
                     , r.acrescimo
                     , r.valortotal
                     , r.vencimento
                     , r.parcelas
                     , ( select count(1) from roman.anexosrequisicoes a 
                        where a.idrequisicaopgto = r.idrequisicaopgto) qtdanexos
                     , ( select count(1) from roman.anexosrequisicoes a 
                         where a.idrequisicaopgto = r.idrequisicaopgto 
                           and a.comprovantepgto = 'S') comprovantepgto
                     , r.usuarioaprovacao
                     , case 
                         when r.idgrupo is null then
                             ( select rs.cnpj--||'-'||rs.razaosocial 
                                from roman.razoessociaisfiliais rs
                                   , roman.requisicoespagamentos rq
                               where rs.idfilial = rq.idfilialdestino
                                 and rs.idrazaosocialfilial = rq.idrazaosocialdest 
                                 and rq.idrequisicaopgto = r.idrequisicaopgto )
                           else 
                             ( select rs.cnpj--||'-'||rs.razaosocial 
                                 from roman.razoessociaisfiliais rs
                                    , roman.requisicoespagamentos rq
                                where rs.idfilial  = rq.idgrupo
                                  and rs.idrazaosocialfilial = rq.idfilialdestgr 
                                  and rq.idrequisicaopgto = r.idrequisicaopgto )
                        end cnpjdest
                from roman.requisicoespagamentos r
                   , roman.vw_matrizregrasdespesas md
                where r.idmatrizdespesa = md.idmatrizregra(+)
                 and ( :P585_TIPODATA = 'I' and  trunc(r.datainclusao) between to_date(:P585_DATAINICIO) and to_date(:P585_DATAFIM)
                        or :P585_TIPODATA = 'V' and  trunc(r.vencimento) between to_date(:P585_DATAINICIO) and to_date(:P585_DATAFIM))
                 and ( :P585_SITUACAO  is null or r.idsituacao = :P585_SITUACAO )
                 and :P585_FILTRAR = 'S'
                 and ( (:P585_IDFILIAL is null and
                       (r.usuarioinclusao = V('APP_USER')
                        or r.usuarioaprovacao = V('APP_USER')
                        or r.usuariofinalizadofiscal = V('APP_USER')))
                      or r.idfilial = :P585_IDFILIAL)
                 and (:P585_ANTECIPACAO is null or r.antecipacao = :P585_ANTECIPACAO )
                 and (:P585_COMPROVANTEPGTO is null or r.comprovantepgto = :P585_COMPROVANTEPGTO )
                 --and (:P585_ENVIAR_SETOR_FISCAL is null or r.fiscal = :P585_ENVIAR_SETOR_FISCAL)
                ) t
                /*where ( :P585_ATENDIMENTO = 'FIN' or
                       (:P585_ATENDIMENTO = 'COM' and substr(replace(t.cnpjdest,'.',''),1,8) in ('48320045','45397622','45300144','28800724','19321351','10571673','24737867','15551444','33354156','45612340','44671864','53923732','10571673')
                      or t.usuarioinclusao = 'MICHELEZIMPEL') or  --Equipe fiscal comercio, CNPJ RAIZ: 48.320.045, 45.397.622, 45.300.144.
                       :P585_ATENDIMENTO = 'IND' and substr(replace(t.cnpjdest,'.',''),1,8) =  ('07318638') ) -- Equipe fiscal indústria, CNPJ RAIZ: 07.318.638*/
                 order by 1
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1692338781203032696
        }

