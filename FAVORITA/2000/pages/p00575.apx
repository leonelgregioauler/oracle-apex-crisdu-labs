page 575 (
    name: Gerar Itens OC
    title: Preparar Itens da Ordem de Compra
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 80%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region gerar-itens-para-ordem-de-compra (
        name: Gerar Itens para Ordem de Compra
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    region itens (
        name: Itens
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select o.idtmpitens
                     , o.idpais
                     , o.idedicaorevista
                     , o.idsubcategoria
                     , c.nome "Categoria"
                     , o.idprodutodetalhado 
                     , pck_util_fav.fnc_nomeprodutodetalhado(idprodutodetalhado, o.idpais) "Produto Detalhado"
                     , o.idproduto
                     , o.qtdvendida
                     , o.qtdcomprar
                     , o.codigocd
                     , o.idordemcompra
                     , o.valorcusto
                     , (select nomefilialfavorita
                          from filiaisfavorita
                         where idfilialfavorita = o.codigocd )  "Filial Favorita"
                  from tmp_itenslancamentos_oc o
                     , subcategorias c
                 where o.usuario = v('APP_USER')
                   and o.idsubcategoria = c.idsubcategoria(+)
                
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        performance {
            lazyLoading: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        enableUsersTo {
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 101981701158668231
        }

