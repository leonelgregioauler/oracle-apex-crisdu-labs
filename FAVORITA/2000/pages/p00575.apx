        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: GerarOrdemCompra
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process incluiritenstmp (
        name: IncluirItensTMP
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  viditemordemcompra  number;
                  vidordemcompra      number := :P575_IDORDEMCOMPRA;
                  vidprodutodetalhado number;
                  vmd5                varchar2(4000);
                  vinclui             varchar2(1);
                  --
                  vdata               ordenscompras.dataemissao%type;
                  vtipo               ordenscompras.tipooc%type;
                  vidfornec           ordenscompras.idfornecedor%type;
                  vidusuarioemis      ordenscompras.idusuarioemissao%type;
                  videdicaorevista    ordenscompras.idedicaorevista%type;
                  vNumNull            number;
                  --
                  vqtdteste number;
                begin
                  --
                  --Inclui dados da OC na tabela temporaria
                  --
                  begin
                    delete from tmp_ordenscomprasprop
                     where idordemcompra = :P575_IDORDEMCOMPRA;
                  exception
                    when others then null;
                  end;
                  --
                  
                  begin
                        insert into tmp_ordenscomprasprop (idordemcompra, 
                                                       idfilialdestino, 
                                                       idedicaorevista, 
                                                       idproduto, 
                                                       idprodutodetalhado, 
                                                       qtdcomprar, 
                                                       valorcusto, 
                                                       idtmpordenscomprasprop)
                         select idordemcompra --:P575_IDORDEMCOMPRA
                              , codigocd --to_number(c007) --codigo_cd
                              , idedicaorevista --to_number(c002) --idedicaorevista
                              , idproduto --to_number(c004) --idproduto
                              , idprodutodetalhado --to_number(c005) --idprodutodetalhado
                              , qtdcomprar --to_number(c009) --qtdcomprar
                              , valorcusto --to_number(c010) --valorcusto
                              , seq_idtmpordenscomprasprop.nextval
                           from tmp_itenslancamentos_oc
                          where usuario = v('APP_USER');
                        --where collection_name = 'COL_ORDENSCOMPRAS'  tmp_itenslancamentos_oc
                        --  and C011 = :P575_IDORDEMCOMPRA;
                         
                  exception
                    when others then null;
                  end;
                  --
                
                  update ordenscompras
                     set idsituacaooc = 2
                   where idordemcompra = :P575_IDORDEMCOMPRA; 
                  --
                  COMMIT;
                  --  
                  end;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 3258622639741813
        }
        serverSideCondition {
            whenButtonPressed: @gerarordemcompra
        }
    )

    process new-save-interactive-grid-data (
        name: New - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @itens
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Alterações Salvas!
        }
        advanced {
            executionMappingIdentifier: 3258420444741811
        }
    )

    process popula-tmp (
        name: Popula_TMP
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                 l_dataini date;
                 l_datafim date;
                 l_ciclos  number;
                 l_qtdrev  number;
                 vqtdteste number;
                BEGIN 
                  --
                  select min(datainicial), -- to_date(min(datainicial)||' 00:00:01','dd/mm/rrrr hh24:mi:ss'), 
                         max(datafinal),  --to_date(max(datafinal)  ||' 23:59:59','dd/mm/rrrr hh24:mi:ss'),
                         count(*)
                    into l_dataini, l_datafim, l_qtdrev
                  from edicoesrevistas 
                 where numeroedicao in ( select regexp_substr(:P575_IDEDICAOORIGEM, '[^;]+', 1, level) ID
                                           from dual
                                        connect by level <= regexp_count(:P575_IDEDICAOORIGEM, ';') + 1 );   
                  --
                  select decode(qtdciclos,0,1,qtdciclos)
                    into l_ciclos
                    from ordenscompras
                   where idordemcompra = :P575_IDORDEMCOMPRA;
                
                --raise_application_error(-20001,'usuario= '||v('APP_USER') );
                
                  -- Gera produtos novos
                  DELETE FROM tmp_itenslancamentos_oc
                   WHERE usuario = v('APP_USER');
                  --
                  insert into tmp_itenslancamentos_oc (idtmpitens,
                                                       idpais,
                                                       idedicaorevista,
                                                       idsubcategoria,
                                                       idprodutodetalhado,
                                                       idproduto,
                                                       idordemcompra,
                                                       qtdvendida,
                                                       qtdcomprar,
                                                       codigocd,
                                                       valorcusto,
                                                       idgrade,
                                                       usuario)
                with t1 as ( SELECT distinct 
                                     ed.idpais, 
                                     ed.idedicaorevista, 
                                     pd.idcategoria,
                                     sc.idsubcategoria,
                                     ps.idprodutodetalhado,
                                     gr.sigla,
                                     GR.IDGRADE,
                                     pd.idproduto
                               FROM edicoesrevistas       ed
                                  , produtosdetedrevistas pr
                                  , subcategorias         sc
                                  , produtos              pd
                                  , produtosdetalhados    ps
                                  , grades                gr
                              WHERE ed.idedicaorevista = pr.idedicaorevista
                                AND ed.idedicaorevista = :P575_IDEDICAOREVISTA
                                AND pr.idprodutodetalhado not in ( select idprodutodetalhado  -- Produtos Novos
                                                                     from produtosdetedrevistas
                                                                    where idedicaorevista  in ( select regexp_substr(:P575_IDEDICAOORIGEM, '[^;]+', 1, level) ID
                                                                                                  from dual
                                                                                               connect by level <= regexp_count(:P575_IDEDICAOORIGEM, ';') + 1 ) ) 
                                AND pr.idprodutodetalhado = ps.idprodutodetalhado
                                AND ps.idproduto          = pd.idproduto
                                AND pd.idsubcategoria     = sc.idsubcategoria(+)
                                AND ps.idgrade            = gr.idgrade
                                AND ed.tipovenda = 'R' ),
                      --
                      t2 as ( SELECT idpais
                                   , idedicaorevista 
                                   , idproduto
                                   , nome_cd
                                   , codigo_cd
                                   , null idcategoria
                                   , sub_cat
                                   , idsubcategoria
                                   , sigla
                                   , idgrade
                                   --
                                   , ( sum(sum(qtd_vendida)) over (partition by idpais
                                                               , idedicaorevista 
                                                               , idproduto
                                                               , codigo_cd
                                                               , idsubcategoria
                                                               , idgrade
                                                               ) / l_qtdrev ) qtdComprar
                                   --
                                   , RANK() OVER (PARTITION BY idpais
                                                             , idedicaorevista
                                                             , idsubcategoria ORDER BY sum(qtd_vendida) DESC) num_rank
                                FROM (
                                  select x1.idpais
                                       , x1.idedicaorevista
                                       , d.idproduto
                                       , d.idsubcategoria
                                       , s.nome sub_cat 
                                       , p.idfilialromance
                                       , g.sigla 
                                       , g.idgrade
                                       , ( select ff.nomefilialfavorita
                                             from atendimentosfiliaisrmc a
                                                , filiaisfavorita ff
                                            where a.idfilialdestino        = p.idfilialromance 
                                              and a.idfilialfavoritaorigem = ff.idfilialfavorita
                                              and ff.tipofilial            = 'E' 
                                              and ff.idpais = x1.idpais )  nome_cd
                                       , ( select ff.idfilialfavorita
                                             from atendimentosfiliaisrmc a
                                                , filiaisfavorita ff
                                            where a.idfilialdestino        = p.idfilialromance 
                                              and a.idfilialfavoritaorigem = ff.idfilialfavorita
                                              and ff.tipofilial            = 'E' 
                                              and ff.idpais = x1.idpais )  codigo_cd
                                       , sum(i.quantidade) qtd_vendida
                                    from 
                                         ( SELECT distinct ed.idpais,
                                                  ed.idedicaorevista,
                                                  pd.idsubcategoria,
                                                  ps.idgrade
                                            FROM EDICOESREVISTAS       ed
                                               , produtosdetedrevistas pr
                                               , produtos              pd
                                               , produtosdetalhados    ps
                                           where ed.idedicaorevista    = pr.idedicaorevista
                                             and ed.idedicaorevista    = :P575_IDEDICAOREVISTA   
                                             and pr.idprodutodetalhado = ps.idprodutodetalhado
                                             and ps.idproduto          = pd.idproduto
                                             and ed.tipovenda = 'R') x1
                                       --
                                       , itenspedidos         i
                                       , pedidos              p
                                       , produtos             d
                                       , subcategorias        s
                                       , produtosdetalhados   l
                                       , grades               g
                                   where p.dataemissao between l_dataini
                                                           and l_datafim
                                     and s.idsubcategoria     = x1.idsubcategoria
                                     and p.idpais             = x1.idpais
                                     and p.idpedido           = i.idpedido
                                     and i.idproduto          = d.idproduto
                                     
                                     and d.idproduto in ( select idproduto
                                                            from ( select d.idproduto
                                                                        , RANK() OVER (PARTITION BY x1.idpais,
                                                                                                    x1.idedicaorevista,
                                                                                                    d.idsubcategoria
                                                                                                    ORDER BY sum(i.quantidade) DESC) num_rank
                                                                     from 
                                                                          ( SELECT distinct ed.idpais,
                                                                                   ed.idedicaorevista,
                                                                                   pd.idsubcategoria,
                                                                                   ps.idgrade
                                                                             FROM EDICOESREVISTAS       ed
                                                                                , produtosdetedrevistas pr
                                                                                , produtos              pd
                                                                                , produtosdetalhados    ps
                                                                            where ed.idedicaorevista    = pr.idedicaorevista
                                                                              and ed.idedicaorevista    = :P575_IDEDICAOREVISTA   
                                                                              and pr.idprodutodetalhado = ps.idprodutodetalhado
                                                                              and ps.idproduto          = pd.idproduto
                                                                              and ed.tipovenda          = 'R' ) x1
                                                                        --
                                                                        , itenspedidos         i
                                                                        , pedidos              p
                                                                        , produtos             d
                                                                        , produtosdetalhados   l
                                                                        , grades               g
                                                                    where p.dataemissao between l_dataini
                                                                                            and l_datafim
                                                                      and d.idsubcategoria     = x1.idsubcategoria
                                                                      and p.idpais             = x1.idpais
                                                                      and p.idpedido           = i.idpedido
                                                                      and i.idproduto          = d.idproduto
                                                                      and i.idprodutodetalhado = l.idprodutodetalhado
                                                                      and l.idgrade            = g.idgrade
                                                                      and l.idgrade            = x1.idgrade
                                                                      and p.idsituacaoentrega >= 20000
                                                                      and p.datacancelamento   is null
                                                                    --
                                                                    group by x1.idpais
                                                                           , x1.idedicaorevista
                                                                           , d.idproduto
                                                                           , d.idsubcategoria
                                                                           , G.IDGRADE )
                                                           where num_rank = 1 )
                                     
                                      and i.idprodutodetalhado = l.idprodutodetalhado
                                      and d.idsubcategoria     = s.idsubcategoria
                                      and l.idgrade            = g.idgrade
                                      and l.idgrade            = x1.idgrade
                                      and p.idsituacaoentrega >= 20000
                                      and p.datacancelamento   is null
                                    --
                                    group by x1.idpais
                                           , x1.idedicaorevista
                                           , p.idfilialromance 
                                           , d.idproduto
                                           , d.idsubcategoria
                                           , s.nome  
                                           , g.sigla
                                           , G.IDGRADE )
                                where nome_cd is not null
                                GROUP BY idpais, 
                                         idedicaorevista, 
                                         nome_cd, 
                                         codigo_cd, 
                                         idproduto,
                                         sub_cat, 
                                         idsubcategoria, 
                                         sigla, 
                                         idgrade 
                         ------------------
                         UNION ALL         
                         ------------------
                              SELECT idpais
                                   , idedicaorevista 
                                   , idproduto
                                   , nome_cd
                                   , codigo_cd
                                   , idcategoria
                                   , null sub_cat
                                   , null idsubcategoria
                                   , sigla
                                   , idgrade
                                   --
                                   , ( sum(sum(qtd_vendida)) over (partition by idpais
                                                               , idedicaorevista 
                                                               , idproduto
                                                               , codigo_cd
                                                               , idcategoria
                                                               ) / l_qtdrev ) qtdComprar
                                   
                                   , RANK() OVER (PARTITION BY idpais
                                                             , idedicaorevista
                                                             , idcategoria ORDER BY sum(qtd_vendida) DESC) num_rank
                                FROM (
                                  select x1.idpais
                                       , x1.idedicaorevista
                                       , d.idproduto
                                       , d.idcategoria
                                       , s.nome sub_cat 
                                       , p.idfilialromance
                                       , g.sigla 
                                       , g.idgrade
                                       , ( select ff.nomefilialfavorita
                                             from atendimentosfiliaisrmc a
                                                , filiaisfavorita ff
                                            where a.idfilialdestino        = p.idfilialromance 
                                              and a.idfilialfavoritaorigem = ff.idfilialfavorita
                                              and ff.tipofilial            = 'E' 
                                              and ff.idpais = x1.idpais )  nome_cd
                                       , ( select ff.idfilialfavorita
                                             from atendimentosfiliaisrmc a
                                                , filiaisfavorita ff
                                            where a.idfilialdestino        = p.idfilialromance 
                                              and a.idfilialfavoritaorigem = ff.idfilialfavorita
                                              and ff.tipofilial            = 'E' 
                                              and ff.idpais = x1.idpais )  codigo_cd
                                       , sum(i.quantidade) qtd_vendida
                                    from 
                                         ( SELECT distinct ed.idpais,
                                                  ed.idedicaorevista,
                                                  pd.idcategoria,
                                                  ps.idgrade
                                            FROM EDICOESREVISTAS       ed
                                               , produtosdetedrevistas pr
                                               , produtos              pd
                                               , produtosdetalhados    ps
                                           where ed.idedicaorevista    = pr.idedicaorevista
                                             and ed.idedicaorevista    = :P575_IDEDICAOREVISTA   
                                             and pr.idprodutodetalhado = ps.idprodutodetalhado
                                             and ps.idproduto          = pd.idproduto
                                             and ed.tipovenda = 'R') x1
                                       --
                                       , itenspedidos         i
                                       , pedidos              p
                                       , produtos             d
                                       , categorias           s
                                       , produtosdetalhados   l
                                       , grades               g
                                   where p.dataemissao between l_dataini
                                                           and l_datafim
                                     and s.idcategoria        = x1.idcategoria
                                     and p.idpais             = x1.idpais
                                     and p.idpedido           = i.idpedido
                                     and i.idproduto          = d.idproduto
                                     
                                     and d.idproduto in ( select idproduto
                                                            from ( select d.idproduto
                                                                        , RANK() OVER (PARTITION BY x1.idpais,
                                                                                                    x1.idedicaorevista,
                                                                                                    d.idcategoria
                                                                                                    ORDER BY sum(i.quantidade) DESC) num_rank
                                                                     from 
                                                                          ( SELECT distinct ed.idpais,
                                                                                   ed.idedicaorevista,
                                                                                   pd.idcategoria,
                                                                                   ps.idgrade
                                                                             FROM EDICOESREVISTAS       ed
                                                                                , produtosdetedrevistas pr
                                                                                , produtos              pd
                                                                                , produtosdetalhados    ps
                                                                            where ed.idedicaorevista    = pr.idedicaorevista
                                                                              and ed.idedicaorevista    = :P575_IDEDICAOREVISTA   
                                                                              and pr.idprodutodetalhado = ps.idprodutodetalhado
                                                                              and ps.idproduto          = pd.idproduto
                                                                              and ed.tipovenda          = 'R' ) x1
                                                                        --
                                                                        , itenspedidos         i
                                                                        , pedidos              p
                                                                        , produtos             d
                                                                        , produtosdetalhados   l
                                                                        , grades               g
                                                                    where p.dataemissao between l_dataini
                                                                                            and l_datafim
                                                                      and d.idcategoria     = x1.idcategoria
                                                                      and p.idpais             = x1.idpais
                                                                      and p.idpedido           = i.idpedido
                                                                      and i.idproduto          = d.idproduto
                                                                      and i.idprodutodetalhado = l.idprodutodetalhado
                                                                      and l.idgrade            = g.idgrade
                                                                      and l.idgrade            = x1.idgrade
                                                                      and p.idsituacaoentrega >= 20000
                                                                      and p.datacancelamento   is null
                                                                    --
                                                                    group by x1.idpais
                                                                           , x1.idedicaorevista
                                                                           , d.idproduto
                                                                           , d.idcategoria
                                                                           , G.IDGRADE )
                                                           where num_rank = 1 )
                                     
                                      and i.idprodutodetalhado = l.idprodutodetalhado
                                      and d.idcategoria        = s.idcategoria
                                      and l.idgrade            = g.idgrade
                                      and l.idgrade            = x1.idgrade
                                      and p.idsituacaoentrega >= 20000
                                      and p.datacancelamento   is null
                                    --
                                    group by x1.idpais
                                           , x1.idedicaorevista
                                           , p.idfilialromance 
                                           , d.idproduto
                                           , d.idcategoria
                                           , s.nome  
                                           , g.sigla
                                           , G.IDGRADE )
                                where nome_cd is not null
                                GROUP BY idpais, 
                                         idedicaorevista, 
                                         nome_cd, 
                                         codigo_cd, 
                                         idproduto,
                                         sub_cat, 
                                         idcategoria, 
                                         sigla, 
                                         idgrade  )
                 select rownum ordem 
                         , t1.idpais
                         , t2.idedicaorevista
                         , t1.idsubcategoria 
                         , t1.idprodutodetalhado 
                         , t1.idproduto
                         , :P575_IDORDEMCOMPRA
                         , round(t2.qtdComprar * l_ciclos)
                         , round(t2.qtdComprar * l_ciclos)
                         , t2.codigo_cd
                         --
                         , (select max(valorcusto)
                              from precosprodutos 
                             where idedicaorevista = :P575_IDEDICAOREVISTA  
                               and idprodutodetalhado in (select idprodutodetalhado
                                                            from produtosdetalhados
                                                           where idproduto = t1.idproduto)) valorcusto
                         --
                         , t2.idgrade
                         , v('APP_USER')
                         --
                      from t1, t2
                    where t1.idpais(+)            = t2.idpais
                      and t1.idedicaorevista(+)   = t2.idedicaorevista
                      and (t1.idsubcategoria is not null and t1.idsubcategoria = t2.idsubcategoria OR
                           t1.idsubcategoria is null     and t1.idcategoria    = t2.idcategoria )
                      and t1.sigla(+)             = t2.sigla;
                      
                  commit;
                  --
                 /* SELECT COUNT(*)
                    INTO VQTDTESTE
                    FROM tmp_itenslancamentos_oc;
                    
                    raise_application_error(-20001,'qtd REG '||VQTDTESTE); */
                      
                END;
                ```
        }
