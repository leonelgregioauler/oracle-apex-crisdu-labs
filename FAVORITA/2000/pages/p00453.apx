    pageItem P453_IDFILIALFAVORITADESTINO (
        type: popupLov
        label {
            label: Filial Favorita Destino
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) as d,
                       idfilialfavorita as r
                  from filiaisfavorita f
                where exists ( select 1
                               from usuariosfiliaisfavorita u
                               where u.idfilialfavorita = f.idfilialfavorita
                                 and u.consultar        = 'S' 
                                 and u.idusuario        = :P0_IDUSUARIO )
                 order by 1
                ```
        }
        layout {
            sequence: 80
            region: @criar-compra-remessa-transferência
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            width: 30
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                /*Filtra tipos de remessa*/
                :P453_IDTIPOCOMPTRANSREM in (1,9)
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P453_IDFILIALFAVORITAORIGEM (
        type: popupLov
        label {
            label: Filial Favorita Origem
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) as d,
                       idfilialfavorita as r
                  from filiaisfavorita f
                where exists ( select 1
                               from usuariosfiliaisfavorita u
                               where u.idfilialfavorita = f.idfilialfavorita
                                 and u.consultar        = 'S' 
                                 and u.idusuario        = :P0_IDUSUARIO )
                and (f.tipofilial = 'E' or :P453_IDTIPOCOMPTRANSREM not in (7,8,10) /*para remessas de correios, delivery e total exp, só lista estoques*/
                    )
                 order by 1
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P453_IDTIPOCOMPTRANSREM
            itemsToSubmit: P453_IDTIPOCOMPTRANSREM
        }
        layout {
            sequence: 30
            region: @criar-compra-remessa-transferência
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                /*Filtra tipos de remessa*/
                :P453_IDTIPOCOMPTRANSREM in (7,8,9,10)
                ```
        }
        security {
            encryptSessionState: false
        }
    )

