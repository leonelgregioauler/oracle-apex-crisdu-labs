    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 30
            region: @criar-compra-remessa-transferência
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 455
                items: {
                    P455_IDTIPOCOMPTRANSREM: &P453_IDTIPOCOMPTRANSREM.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Salvar
        layout {
            sequence: 20
            region: @criar-compra-remessa-transferência
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P453_IDCOMPRATRANSFERENCIA
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 40
            region: @criar-compra-remessa-transferência
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: never
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 10
            region: @criar-compra-remessa-transferência
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: never
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation valida-campos-remessa-delivery (
        name: Valida campos remessa delivery
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody: return null;
        }
    )

    process inseri-remessa (
        name: inseri remessa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vmensagem varchar2(3000);
                  vid_compra_transferencia number;
                  --
                begin
                  -- Call the procedure
                  pck_comprastransf_fav_v2.prc_inseri_comptransrem(pidcompratransferencia => vid_compra_transferencia,
                                                                   pidfornecedor => :P453_IDFORNECEDOR,
                                                                   pidfilialfavoritaorigem => :P453_IDFILIALFAVORITAORIGEM,
                                                                   pidfilialfavoritadestino => :P453_IDFILIALFAVORITADESTINO,
                                                                   pidfilialromancedestino => :P453_IDFILIALROMANCEDESTINO,
                                                                   pidpostoavancadodestino => :P453_IDPOSTOAVANCADODESTINO,
                                                                   pnumero => :P453_NUMERO,
                                                                   pnotafiscal => :P453_NOTAFISCAL,
                                                                   pdataemissao => :P453_DATAEMISSAO,
                                                                   pdatarecebimento => :P453_DATARECEBIMENTO,
                                                                   pdataembarque => :P453_DATAEMBARQUE,
                                                                   pdataprevisaoentrega => :P453_DATAPREVISAOENTREGA,
                                                                   pvalortotalcompra => :P453_VALORTOTALCOMPRA,
                                                                   pcubagem => :P453_CUBAGEM,
                                                                   pvolume => :P453_VOLUME,
                                                                   ppeso => :P453_PESO,
                                                                   pobservacao => :P453_OBSERVACAO,
                                                                   pidtipo => :P453_IDTIPOCOMPTRANSREM,
