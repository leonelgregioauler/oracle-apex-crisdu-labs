page 453 (
    name: Criar Compra/Remessa/Transferência
    title: Criar Compra/Remessa/Transferência
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG_25"';
    }

    region criar-compra-remessa-transferência (
        name: Criar Compra/Remessa/Transferência
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

