            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                /*Filtra tipos de remessa*/
                :P453_IDTIPOCOMPTRANSREM in (3)
                ```
        }
        security {
            encryptSessionState: false
        }
    )

