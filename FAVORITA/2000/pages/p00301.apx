page 301 (
    name: "Pedidos Pós Prospecção "
    title: "Pedidos Pós Prospecção "
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region pedidos-pós-prospecção (
        name: Pedidos Pós Prospecção
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select wp.idpedido
                     , wp.vendedora
                     , wp.representante
                     , wp.filialromance
                     , wp.dataemissao
                     , wp.datavencimento
                     , wp.dataentrega
                     , wp.valortotal
                     , wp.valorapagar
                     , wp.situacaoentregainterno
                     , wp.situacaofinanceirointerno
                     , wp.situacaopagamento                       
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||wp.idpedido,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' "Ver Pedido"
                from vw_pedidos_fav wp
                   , (select min(vp.idpedido) idpedido
                           , vp.idvendedora
                      from pedidos vp
                      where vp.idpedido > ( select max(p.idpedido)
                                            from pedidos p
                                            where p.idvendedora = vp.idvendedora
                                              and exists ( select 1
                                                           from itenspedidos i
                                                           where i.idpedido = p.idpedido
                                                             and i.idkitvenda = 72 )
                                              and not exists ( select 1
                                                               from classificacoespedidos c
                                                               where c.idpedido = p.idpedido
                                                                 and c.idcaracteristicapedido = 25))
                        and datacancelamento is null
                      group by  vp.idvendedora) wvp
                where wp.idpedido = wvp.idpedido
                  and wp.ididioma = 1;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1399624538847185614
        }

