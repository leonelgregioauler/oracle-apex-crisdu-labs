        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process produtos-da-edição-revista-save-interactive-grid-data (
        name: Produtos da Edição Revista - Save Interactive Grid Data
        type: executeCode
        editableRegion: @produtos-da-edição-revista
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  --
                  vmd5                      VARCHAR2(4000);
                  vidprecoproduto           NUMBER;
                  vidproduto                NUMBER;
                  vvalorcomissaoatendente   NUMBER;
                  vcustofiscaligrejinha     NUMBER;
                  vcustofiscalcampogrande   NUMBER;
                  vcustofiscalbelem         NUMBER;
                  vcustofiscalmanaus        NUMBER;
                  vidfilial                 NUMBER;
                  videdicaorevista          NUMBER := :IDEDICAOREVISTA;
                  vidprodutodetalhado       NUMBER := :LISTPRODUTOS;
                  --
                BEGIN
                  --
                  IF :APEX$ROW_STATUS = 'U' THEN
                    UPDATE favorita.precosprodutos pr
                    SET pr.valorvenda = replace(:VALORVENDA,'.',''),
                        pr.valorcusto = replace(:VALORCUSTO,'.',''),
                        pr.perccomissaoconsultora = :PERCCOMISSAOCONSULTORA,
                        pr.perccomissaodistribuidor = :PERCCOMISSAODISTRIBUIDOR,
                        pr.perccomissaogerente = :PERCCOMISSAOGERENTE,
                        pr.precosugerido = :PRECOSUGERIDO
                    WHERE pr.idprodutodetalhado = :IDPRODUTODETALHADO
                      AND pr.idedicaorevista = :IDEDICAOREVISTA;
                  END IF;
                  --
                  IF :APEX$ROW_STATUS = 'D' THEN
                    DELETE favorita.precosprodutos pr
                    WHERE pr.idprodutodetalhado = :IDPRODUTODETALHADO
                      AND pr.idedicaorevista = :IDEDICAOREVISTA;
                      
                    DELETE favorita.produtosdetedrevistas dt
                    WHERE dt.idprodutodetalhado = :IDPRODUTODETALHADO
                      AND dt.idedicaorevista = :IDEDICAOREVISTA;
                  END IF;
                  --
                  IF :APEX$ROW_STATUS = 'C' THEN
                    FOR rfil IN (SELECT fd.idfilial
                                  FROM favorita.filiaisedicoesrevistas fd
                                  WHERE fd.idedicaorevista = videdicaorevista
                                    AND fd.idfilial is not null) LOOP
                      
                    vidfilial := rfil.idfilial;
                
                      favorita.pck_cadastros_fav.prc_precosprodutos(pidprecoproduto           => vidprecoproduto,
                                                                    pidedicaorevista          => videdicaorevista,
                                                                    pidproduto                => vidproduto,
                                                                    pidprodutodetalhado       => vidprodutodetalhado,
                                                                    pidfilialromance          => vidfilial,
                                                                    pvalorcusto               => :VALORCUSTO,
                                                                    pvalorvenda               => :VALORVENDA,
                                                                    pperccomissaogerente      => :PERCCOMISSAOGERENTE,
                                                                    pperccomissaodistribuidor => :PERCCOMISSAODISTRIBUIDOR,
                                                                    pperccomissaoconsultora   => :PERCCOMISSAOCONSULTORA,
                                                                    pvalorcomissaoatendente   => vvalorcomissaoatendente,
                                                                    pcustofiscaligrejinha     => vcustofiscaligrejinha,
                                                                    pcustofiscalcampogrande   => vcustofiscalcampogrande,
                                                                    pcustofiscalbelem         => vcustofiscalbelem,
                                                                    pcustofiscalmanaus        => vcustofiscalmanaus,
                                                                    pmd5                      => vmd5,
                                                                    poperacao_dml             => 'I' ,
                                                                    pprecosugerido            => :PRECOSUGERIDO);
                
                    END LOOP;
                    --
                     FOR rfil IN ( SELECT distinct(at.idfilialdestino) idfilial
                                   FROM favorita.filiaisedicoesrevistas fd
                                      , favorita.atendimentosfiliaisrmc at
                                   WHERE fd.idfilialfavorita = at.idfilialfavoritaorigem
                                     AND fd.idedicaorevista = videdicaorevista
                                     AND fd.idfilial is null ) LOOP
                      
                    vidfilial := rfil.idfilial;
                
                      favorita.pck_cadastros_fav.prc_precosprodutos(pidprecoproduto           => vidprecoproduto,
                                                                    pidedicaorevista          => videdicaorevista,
                                                                    pidproduto                => vidproduto,
                                                                    pidprodutodetalhado       => vidprodutodetalhado,
                                                                    pidfilialromance          => vidfilial,
                                                                    pvalorcusto               => :VALORCUSTO,
                                                                    pvalorvenda               => :VALORVENDA,
                                                                    pperccomissaogerente      => :PERCCOMISSAOGERENTE,
                                                                    pperccomissaodistribuidor => :PERCCOMISSAODISTRIBUIDOR,
                                                                    pperccomissaoconsultora   => :PERCCOMISSAOCONSULTORA,
                                                                    pvalorcomissaoatendente   => vvalorcomissaoatendente,
                                                                    pcustofiscaligrejinha     => vcustofiscaligrejinha,
                                                                    pcustofiscalcampogrande   => vcustofiscalcampogrande,
                                                                    pcustofiscalbelem         => vcustofiscalbelem,
                                                                    pcustofiscalmanaus        => vcustofiscalmanaus,
                                                                    pmd5                      => vmd5,
                                                                    poperacao_dml             => 'I',
                                                                    pprecosugerido            => :PRECOSUGERIDO);
                
                    END LOOP;
                    
                    favorita.pck_cadastros_fav.prc_inclui_produtosdetedrevistas(pidedicaorevista    => videdicaorevista,
                                                                                pidprodutodetalhado => vidprodutodetalhado,
                                                                                poperacao_dml       => 'I' );
                  --
                  END IF;
                  --
                  COMMIT;
                 --
                END;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Alterado com Sucesso!
        }
        advanced {
            executionMappingIdentifier: 2203033377791531741
        }
    )

)

