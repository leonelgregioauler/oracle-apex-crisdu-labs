page 619 (
    name: Alterar Produtos de Edição
    title: Alterar produtos de Catalogo
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1500
        height: 700
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region pesquisa-de-produtos (
        name: Pesquisa de Produtos
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region produtos-da-edição-revista (
        name: Produtos da Edição Revista
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pc.valorcusto
                     , pc.valorvenda 
                     , pc.idprodutodetalhado listprodutos
                     , pc.idprodutodetalhado
                     , pc.idprecoproduto
                     , pc.idedicaorevista
                     --, pck_util_fav.fnc_nomeprodutodetalhado(pc.idprodutodetalhado, :P0_IDIDIOMA) produtodetalhado
                     , pc.perccomissaoconsultora
                     , pc.perccomissaodistribuidor
                     , pc.perccomissaogerente
                     , pc.precosugerido
                     , nvl(( select distinct 'Sim'
                             from favorita.precosprodutos pp
                             where pp.idprodutodetalhado = pc.idprodutodetalhado
                               and pp.idedicaorevista = pc.idedicaorevista),'Não') ExistePreco
                from favorita.precosprodutos pc
                where ( :P619_IDPAIS = 1 and pc.idfilialromance = 100
                     or :P619_IDPAIS = 4 and pc.idfilialromance = 1081
                     or :P619_IDPAIS = 2 and pc.idfilialromance = 1041
                     or :P619_IDPAIS = 6 and pc.idfilialromance = 1129
                     or :P619_IDPAIS = 13 and pc.idfilialromance = 1244) --add 21/07/2026 para loja Panamá
                  and pc.idedicaorevista = :P619_IDEDICAOREVISTA
                  and pck_util_fav.fnc_nomeprodutodetalhado(pc.idprodutodetalhado, :P0_IDIDIOMA) like '%'||:P619_PRODUTODETALHADO||'%'
                  /*and ( :P22_EXISTEPRECO = 0
                       or ( :P22_EXISTEPRECO = 1 and exists ( select 1
                                                              from favorita.precosprodutos pp
                                                              where pp.idprodutodetalhado = pc.idprodutodetalhado
                                                                and pp.idedicaorevista = pc.idedicaorevista) )
                       or ( :P22_EXISTEPRECO = 2 and not exists ( select 1
                                                                  from favorita.precosprodutos pp
                                                                  where pp.idprodutodetalhado = pc.idprodutodetalhado
                                                                    and pp.idedicaorevista = pc.idedicaorevista) ))*/
                
                ```
            pageItemsToSubmit: P619_PRODUTODETALHADO
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
            sendAsEmail: false
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 2203030427220531712
        }

