        }
        lov {
            type: staticValues
            staticValues: STATIC:Todos;0,Sim;1,Não;2
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @pesquisa-de-produtos
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: 0
        }
        security {
            encryptSessionState: false
        }
    )

