page 69 (
    name: Retorno de Tarefas
    title: Retorno de Tarefas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function abretarefa(pid)
            { 
              document.getElementById('P69_IDTAREFA').value = pid;
              apex.submit('FILTRAR');
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region retornar-tarefa (
        name: Retornar Tarefa
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region tarefas-para-retornar (
        name: Tarefas para Retornar
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.idtarefa 
                     , t.tipotarefa
                     , t.telefone
                     , t.datainclusao
                     , t.prioridade
                     , t.situacao
                     , t.observacao
                     , t.nomeusuario
                     , null verhistorico
                     , '<a href="javascript: abretarefa('||t.idtarefa||')"> <img src="/i/menu/pencil16x16.gif" alt="" /></a>'  "Abrir Tarefa"
                from vw_tarefas_fav t
                where t.idsituacao = 40
                  and t.ididioma = :P0_IDIDIOMA
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 69
                items: {
                    P69_IDTAREFA: #IDTAREFA#
                    P69_PRIORIDADE: #PRIORIDADE#
                    P69_OBSERVACAO: #OBSERVACAO#
                }
                action: resetPagination
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 11574032754854202
        }

        column "Abrir Tarefa" (
            type: hidden
            heading {
                heading: Abrir Tarefa
            }
            layout {
                sequence: 120
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: K
            }
            security {
                escapeSpecialChars: false
            }
        )

        column DATAINCLUSAO (
            type: plainText
            heading {
                heading: Data de Inclusão
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: dd/mm/rrrr hh24:mi:ss
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: C
            }
        )

        column IDTAREFA (
            type: plainText
            heading {
                heading: Tarefa
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column NOMEUSUARIO (
            type: plainText
            heading {
                heading: Atendente
                alignment: center
            }
            layout {
                sequence: 130
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: L
            }
        )

        column OBSERVACAO (
            type: plainText
            heading {
                heading: Observação
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column PRIORIDADE (
            type: plainText
            heading {
                heading: Prioridade
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column SITUACAO (
            type: plainText
            heading {
                heading: Situação
                alignment: center
            }
            layout {
                sequence: 100
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        column TELEFONE (
            type: plainText
            heading {
                heading: Telefone
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column TIPOTAREFA (
            type: plainText
            heading {
                heading: Tipo de Tarefa
                alignment: center
            }
            layout {
                sequence: 90
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column VERHISTORICO (
            type: link
            heading {
                heading: Ver Históricos
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: center
            }
            link {
                target: {
                    page: 70
                    items: {
                        P70_IDTAREFAP: #IDTAREFA#
                        P70_PAGINA: 69
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-view.png" class="apex-edit-view" alt="">
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: J
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 115939 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn "Abrir Tarefa" (
                sequence: 10
            )

            displayColumn DATAINCLUSAO (
                sequence: 4
            )

            displayColumn IDTAREFA (
                sequence: 2
            )

            displayColumn NOMEUSUARIO (
                sequence: 7
            )

            displayColumn OBSERVACAO (
                sequence: 8
            )

            displayColumn PRIORIDADE (
                sequence: 6
            )

            displayColumn SITUACAO (
                sequence: 5
            )

            displayColumn TELEFONE (
                sequence: 3
            )

            displayColumn TIPOTAREFA (
                sequence: 9
            )

            displayColumn VERHISTORICO (
                sequence: 1
            )

        )

    )

    pageItem P69_CONFIRMA (
        type: hidden
        layout {
            sequence: 20
            region: @retornar-tarefa
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P69_IDTAREFA (
        type: numberField
        label {
            label: Nr Tarefa
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 10
            region: @retornar-tarefa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 8
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P69_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        layout {
            sequence: 40
            region: @retornar-tarefa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 20
            height: 8
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P69_PRIORIDADE (
        type: textField
        label {
            label: Prioridade
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @retornar-tarefa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar Retorno
        layout {
            sequence: 60
            region: @retornar-tarefa
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Retornar Tarefa
        layout {
            sequence: 50
            region: @retornar-tarefa
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 70
            region: @retornar-tarefa
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-reply
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 94
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process confirma-retorno (
        name: Confirma Retorno
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  voperacao varchar2(1);
                  --
                begin
                  --
                  if v('REQUEST') = 'CANCEL' then
                    voperacao := 'N';
                  elsif v('REQUEST') = 'SUBMIT' then
                    voperacao := 'S';
                  end if;
                  --
                  pck_tarefas_fav.prc_retornartarefa(pidtarefa   => :P69_IDTAREFA,
                                                     pconfirma   => voperacao,
                                                     pprioridade => :P69_PRIORIDADE,
                                                     pobservacao => :P69_OBSERVACAO);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 11576715594854229
        }
    )

    branch (
        name: retornar para lista
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 69
                items: {
                    P69_IDTAREFA:
                    P69_PRIORIDADE:
                    P69_CONFIRMA:
                    P69_OBSERVACAO:
                }
                action: resetPagination
            }
        }
    )

)

