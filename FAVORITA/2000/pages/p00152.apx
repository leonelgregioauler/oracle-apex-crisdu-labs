page 152 (
    name: Históricos de Compras/Transf/Remessas
    title: Históricos de Compras/Transf/Remessas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region históricos-de-compras-transf-remessas (
        name: Históricos de Compras/Transf/Remessas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.grupoatendimento
                 , m.datainclusao
                 , m.mensagem
                 , m.usuarioleitura
                 , m.dataleitura
                from vw_mensagensinternas_fav m
                where m.idcompratransferencia = :P152_IDCOMPRATRANSFERENCIA
                order by datainclusao
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 29825667681565529
        }

        column DATAINCLUSAO (
            type: plainText
            heading {
                heading: Inclusão
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column DATALEITURA (
            type: plainText
            heading {
                heading: Leitura
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: I
            }
        )

        column GRUPOATENDIMENTO (
            type: plainText
            heading {
                heading: Grupo de Atendimento
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column MENSAGEM (
            type: plainText
            heading {
                heading: Mensagem
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column USUARIOLEITURA (
            type: plainText
            heading {
                heading: Usuário Leitura
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        savedReport 299927 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAINCLUSAO (
                sequence: 2
            )

            displayColumn DATALEITURA (
                sequence: 5
            )

            displayColumn GRUPOATENDIMENTO (
                sequence: 1
            )

            displayColumn MENSAGEM (
                sequence: 3
            )

            displayColumn USUARIOLEITURA (
                sequence: 4
            )

        )

    )

    pageItem P152_IDCOMPRATRANSFERENCIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @históricos-de-compras-transf-remessas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

