page 440 (
    name: Questionamento
    title: Questionamento
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 50%
        height: 60%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region form-on-questionamentoscontroladoria (
        name: Form on QUESTIONAMENTOSCONTROLADORIA
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    pageItem P440_CONFIRMACAOLEITURA (
        type: radioGroup
        label {
            label: Leitura Confirmada?
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 100
            region: @form-on-questionamentoscontroladoria
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: CONFIRMACAOLEITURA
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vresultado varchar2(1);
                begin
                  --
                  if :P440_IDQUESTIONAMENTO is not null then 
                    --
                    select confirmacaoleitura
                    into vresultado
                    from roman.questionamentoscontroladoria q
                    where q.idquestionamento = :P440_IDQUESTIONAMENTO;
                    --
                  else
                    --
                    vresultado := 'N';
                    --
                  end if;
                  --
                  return vresultado;
                  --
                end;
                    
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P440_IDQUESTIONAMENTO
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P440_DATALEITURA (
        type: datePickerJquery
        label {
            label: Data da Leitura
            alignment: left
        }
        layout {
            sequence: 110
            region: @form-on-questionamentoscontroladoria
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD/MM/RRRR HH24:MI:SS
            width: 20
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: DATALEITURA
            used: always
        }
        serverSideCondition {
            type: item=value
            item: P440_CONFIRMACAOLEITURA
            value: S
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P440_DESTINO (
        type: radioGroup
        label {
            label: Destino
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Empresa Romance;E,Pessoa;P
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @form-on-questionamentoscontroladoria
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            used: always
        }
        default {
            type: static
            staticValue: E
        }
        serverSideCondition {
            type: itemIsNull
            item: P440_IDQUESTIONAMENTO
        }
        readOnly {
            type: itemIsNotNull
            item: P440_IDQUESTIONAMENTO
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P440_IDFECHAMENTO (
        type: selectList
        label {
            label: Fechamento
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select semana
                     , fr.idfechamento
                from fechamentossemanais fr
                where fr.idfechamento = :P440_IDFECHAMENTO
                  and fr.idfilialfavorita is not null
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @form-on-questionamentoscontroladoria
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFECHAMENTO
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidfechamento number;
                begin
                  --
                  select :P0_IDFECHAMENTO
                  into vidfechamento
                  from dual;
                  --
                  return vidfechamento;
                  --
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P440_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nomefilialfavorita
                     , f.idfilialfavorita
                from vw_filiaisfavorita f
                where f.tipofilial = 'Loja'
                  and f.ativo = 'Sim'
                  and f.idfilialfavorita = nvl(:P440_IDFILIALFAVORITA,:P0_IDFILIALCAIXA)
                order by 1;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P0_IDFILIALCAIXA
        }
        layout {
            sequence: 50
            region: @form-on-questionamentoscontroladoria
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIALFAVORITA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P440_IDPESSOA (
        type: popupLov
        label {
            label: Pessoa
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' - CPF: '||p.cpf display_value
                     , p.idpessoa return_value
                from pessoas p
                order by 1
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 60
            region: @form-on-questionamentoscontroladoria
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: IDPESSOA
            used: always
        }
        serverSideCondition {
            type: itemIsNull
            item: P440_IDQUESTIONAMENTO
        }
        readOnly {
            type: itemIsNotNull
            item: P440_IDQUESTIONAMENTO
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P440_IDQUESTIONAMENTO (
        type: numberField
        label {
            label: "Cód. "
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 20
            region: @form-on-questionamentoscontroladoria
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: databaseColumn
            databaseColumn: IDQUESTIONAMENTO
            used: always
        }
        readOnly {
            type: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P440_ORIGEM (
        type: hidden
        layout {
            sequence: 130
            region: @form-on-questionamentoscontroladoria
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ORIGEM
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P440_PAGINA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @buttons
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P440_QUESTIONAMENTO (
        type: textarea
        label {
            label: Questionamento
            alignment: left
        }
        layout {
            sequence: 70
            region: @form-on-questionamentoscontroladoria
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 100
            height: 6
        }
        validation {
            maxLength: 4000
        }
        source {
            type: databaseColumn
            databaseColumn: QUESTIONAMENTO
            used: always
        }
        readOnly {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                                   from roman.usuariosgruposatendimento ug
                                   where ug.idgrupoatendimento in (0,2)
                                     and ug.usuario = v('APP_USER') )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P440_RESPOSTA (
        type: textarea
        label {
            label: Resposta
            alignment: left
        }
        layout {
            sequence: 80
            region: @form-on-questionamentoscontroladoria
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 100
            height: 6
        }
        validation {
            maxLength: 4000
        }
        source {
            type: databaseColumn
            databaseColumn: RESPOSTA
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P440_IDQUESTIONAMENTO
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.usuariosgruposatendimento ug
                where ( ug.idgrupoatendimento in (0,2)
                      and ug.usuario = v('APP_USER') )
                UNION
                SELECT 1
                FROM DUAL
                WHERE nvl(:P440_CONFIRMACAOLEITURA,'N') = 'S'
                  and :P440_RESPOSTA is not null
                      
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P440_USUARIO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @form-on-questionamentoscontroladoria
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: USUARIO
            used: always
        }
        default {
            type: expression
            plsqlExpression: v('APP_USER')
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P440_USUARIOLEITURA (
        type: textField
        label {
            label: Lido por
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 120
            region: @form-on-questionamentoscontroladoria
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            type: databaseColumn
            databaseColumn: USUARIOLEITURA
            used: always
        }
        serverSideCondition {
            type: item=value
            item: P440_CONFIRMACAOLEITURA
            value: S
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    button anexar (
        buttonName: ANEXAR
        label: Anexar Arquivo
        layout {
            sequence: 10
            region: @form-on-questionamentoscontroladoria
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 441
                items: {
                    P441_IDQUESTIONAMENTO: &P440_IDQUESTIONAMENTO.
                    P441_IDANEXODELETAR:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P440_IDQUESTIONAMENTO
        }
    )

    button confirmar-conclusao (
        buttonName: CONFIRMAR_CONCLUSAO
        label: "Concluir "
        layout {
            sequence: 20
            region: @buttons
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where :P440_IDQUESTIONAMENTO is not null
                  and exists ( select 1
                               from roman.usuariosgruposatendimento u
                               where u.idgrupoatendimento in (2,0)
                                 and u.usuario            = v('APP_USER') )
                ```
        }
    )

    button confirmar-envio (
        buttonName: CONFIRMAR_ENVIO
        label: Confirmar Envio
        layout {
            sequence: 40
            region: @buttons
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.usuariosgruposatendimento ug
                where ug.idgrupoatendimento in (0,2)
                  and ug.usuario = v('APP_USER')
                  and exists ( select 1
                               from roman.questionamentoscontroladoria q
                               where q.idquestionamento = :P440_IDQUESTIONAMENTO 
                                 and nvl(q.confirmarenvio,'N')   = 'N' )
                ```
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 90
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.usuariosgruposatendimento ug
                where ug.idgrupoatendimento in (0,2)
                  and ug.usuario = v('APP_USER')
                  and :P440_IDQUESTIONAMENTO is null
                ```
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 70
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Deseja realmente excluir?','DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.usuariosgruposatendimento ug
                where ug.idgrupoatendimento in (0,2)
                  and ug.usuario = v('APP_USER')
                  and :P440_IDQUESTIONAMENTO is not null
                ```
        }
    )

    button reenviar (
        buttonName: REENVIAR
        label: Reenviar Questionamento
        layout {
            sequence: 30
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.usuariosgruposatendimento ug
                where ug.idgrupoatendimento in (0,2)
                  and ug.usuario = v('APP_USER')
                  and exists ( select 1
                               from roman.questionamentoscontroladoria q
                               where q.idquestionamento = :P440_IDQUESTIONAMENTO 
                                 and nvl(q.conferido,'N')   = 'N' )
                ```
        }
    )

    button responder (
        buttonName: RESPONDER
        label: Responder
        layout {
            sequence: 50
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where(  exists ( select 1
                                from roman.usuariosgruposatendimento ug
                                 where ug.idgrupoatendimento != 2
                                   and ug.usuario = v('APP_USER') )
                     or not exists ( select 1
                                     from roman.usuariosgruposatendimento ug
                                     where ug.usuario = v('APP_USER') ) )
                  and :P440_IDQUESTIONAMENTO is not null
                  and ( nvl(:P440_CONFIRMACAOLEITURA,'N') = 'N'
                      or :P440_RESPOSTA is not null
                      or ( nvl(:P440_CONFIRMACAOLEITURA,'N') = 'S'
                         and :P440_RESPOSTA is null ) )
                  and ( select idfilialfavorita from usuarios u where u.usuario = v('APP_USER') ) = :P440_IDFILIALFAVORITA
                ```
        }
    )

    button revisado (
        buttonName: REVISADO
        label: Revisado
        layout {
            sequence: 10
            region: @buttons
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: "javascript:apex.confirm('Deseja realmente confirmar a Revisão deste Questionamento?', { request:'REVISADO'})"
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.usuariosgruposatendimento ug
                where ug.idgrupoatendimento in (0,2)
                  and ug.usuario = v('APP_USER')
                  and exists ( select 1
                               from roman.questionamentoscontroladoria q
                               where q.idquestionamento = :P440_IDQUESTIONAMENTO 
                                 and nvl(q.confirmarenvio,'N')   = 'S' 
                                 and q.resposta is not null
                                 and q.usuarioleitura is not null )
                ```
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 80
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P440_IDQUESTIONAMENTO is not null
                ```
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 60
            region: @buttons
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction inicia-leitura (
        name: Inicia Leitura
        execution {
            sequence: 20
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P440_IDQUESTIONAMENTO
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.questionamentoscontroladoria q
                   , usuarios u
                where nvl(q.confirmacaoleitura,'N') = 'N'
                  and q.idquestionamento = :P440_IDQUESTIONAMENTO
                  and u.usuario = v('APP_USER')
                  and ( q.idfilialfavorita = u.idfilialfavorita
                    or q.idpessoa = u.idpessoa )
                ```
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                      --
                      update roman.questionamentoscontroladoria q
                      set q.dataleitura = sysdate
                        , q.usuarioleitura = v('APP_USER')
                      where q.idquestionamento = :P440_IDQUESTIONAMENTO;
                      --
                      commit;
                      --
                    end;
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction seta-tipo (
        name: Seta Tipo
        execution {
            sequence: 30
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: itemIsNull
            item: P440_IDQUESTIONAMENTO
        }

        action native-set-value (
            action: setValue
            settings {
                value: E
            }
            affectedElements {
                selectionType: items
                items: P440_DESTINO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo-de-destino (
        name: Tipo de Destino
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P440_DESTINO
        }
        clientSideCondition {
            type: item=value
            item: P440_DESTINO
            value: E
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P440_IDFILIALFAVORITA
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P440_IDPESSOA
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P440_IDFILIALFAVORITA
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P440_IDPESSOA
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    validation valida-destino-emprpesa (
        name: Valida Destino Emprpesa
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P440_IDFILIALFAVORITA
        }
        error {
            errorMessage: Por favor, escolha uma empresa!
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P440_DESTINO = 'E'
                  and v('REQUEST') = 'CREATE'
                ```
        }
    )

    validation valida-destino-pessoa (
        name: Valida Destino Pessoa
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P440_IDPESSOA
        }
        error {
            errorMessage: Por favor, escolha uma Pessoa!
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P440_DESTINO = 'P'
                  and v('REQUEST') = 'CREATE'
                ```
        }
    )

    validation valida-resposta (
        name: Valida Resposta
        execution {
            sequence: 30
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where length(trim(:P440_RESPOSTA)) < 20
                ```
        }
        error {
            errorMessage: "Por favor, insira uma resposta válida. "
        }
        serverSideCondition {
            whenButtonPressed: @responder
        }
    )

    process busca-dados-questionamento (
        name: Busca Dados Questionamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vdatainclusao date;
                  vusuario varchar2(100);
                  vidfilialfavorita number;
                  vidpessoa number;
                  vidfechamento number;
                  vquestionamento varchar2(4000);
                  vresposta varchar2(4000);
                  vconfirmacaoleitura varchar2(1);
                  vdataleitura date;
                  vusuarioleitura varchar2(100);
                  vconfirmaenvio varchar2(1);
                  --
                begin
                  --
                  select DATAINCLUSAO
                       , USUARIO
                       , IDFILIAL
                       , IDPESSOA
                       , IDFECHAMENTO
                       , QUESTIONAMENTO
                       , RESPOSTA
                       , CONFIRMACAOLEITURA
                       , DATALEITURA
                       , USUARIOLEITURA
                       , CONFIRMARENVIO
                  into vdatainclusao 
                     , vusuario
                     , vidfilialfavorita
                     , vidpessoa 
                     , vidfechamento
                     , vquestionamento 
                     , vresposta 
                     , vconfirmacaoleitura 
                     , vdataleitura
                     , vusuarioleitura 
                     , vconfirmaenvio
                  from roman.questionamentoscontroladoria q
                  where q.idquestionamento = :P440_IDQUESTIONAMENTO;
                  --
                  :P440_IDFECHAMENTO := VIDFECHAMENTO;
                  :P440_USUARIO := VUSUARIO;
                  :P440_IDFILIALFAVORITA := VIDFILIALFAVORITA;
                  :P440_IDPESSOA := VIDPESSOA;
                  :P440_QUESTIONAMENTO := VQUESTIONAMENTO;
                  :P440_RESPOSTA := VRESPOSTA;
                  :P440_CONFIRMACAOLEITURA := VCONFIRMACAOLEITURA;
                  :P440_DATALEITURA := VDATALEITURA;
                  :P440_USUARIOLEITURA := VUSUARIOLEITURA;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 24262926595692534
        }
        serverSideCondition {
            type: never
        }
    )

    process busca-questionamento-ainda-em-aberto (
        name: Busca Questionamento ainda em Aberto
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidquestionamento number;
                  --
                begin
                  --
                  select idquestionamento
                  into vidquestionamento
                  from roman.questionamentoscontroladoria q
                  where q.idfilialfavorita = :P0_IDFILIALFAVORITA
                    and nvl(q.confirmarenvio,'N') = 'N';
                  --
                  :P440_IDQUESTIONAMENTO := vidquestionamento;
                  --
                exception 
                  when others then
                    :P440_IDQUESTIONAMENTO := null;
                end;
                ```
        }
        execution {
            sequence: 20
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 24262598269692533
        }
        serverSideCondition {
            type: never
        }
    )

    process conclui-questionamento (
        name: Conclui Questionamento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update roman.questionamentoscontroladoria q
                  set q.dataleitura = sysdate
                    , q.usuarioleitura = 'OPTIMUS'
                    , q.dataconferencia = sysdate
                    , q.usuarioconferencia = 'OPTIMUS'
                    , q.conferido = 'S'
                    , q.confirmarenvio = 'S'
                    , q.confirmacaoleitura = 'S'
                  where q.idquestionamento = :P440_IDQUESTIONAMENTO;
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 70
        }
        successMessage {
            successMessage: Questionamento Concluído sem Leitura!
        }
        advanced {
            executionMappingIdentifier: 24264124280692534
        }
        serverSideCondition {
            type: request=Value
            value: CONFIRMAR_CONCLUSAO
        }
    )

    process confirma-questionamento-revisado (
        name: Confirma questionamento Revisado
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update roman.questionamentoscontroladoria q
                  set q.conferido = 'S'
                    , q.dataconferencia = sysdate
                    , q.usuarioconferencia = v('APP_USER')
                  where q.idquestionamento = :P440_IDQUESTIONAMENTO;
                  --
                  commit;
                  --
                end;
                ```
        }
