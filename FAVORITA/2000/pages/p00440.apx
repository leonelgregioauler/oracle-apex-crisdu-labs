        }
    )

    process responder (
        name: Responder
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  if :P440_RESPOSTA is not null then
                    --
                    update roman.questionamentoscontroladoria q
                    set q.confirmacaoleitura = 'S'
                      , q.usuarioleitura = v('APP_USER')
                      , q.resposta = :P440_RESPOSTA
                    where q.idquestionamento = :P440_IDQUESTIONAMENTO;
                    --
                  end if;
                  --
                end;
                ```
