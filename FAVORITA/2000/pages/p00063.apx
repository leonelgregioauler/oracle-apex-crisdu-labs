page 63 (
    name: Relatório de Tipos Tarefas
    title: Tipos Tarefas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region tipos-tarefas (
        name: Tipos Tarefas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idtipotarefa
                     , descricao
                     , textotraduzido
                     , ativo
                     , idtexto
                from vw_tipostarefas_fav
                where ididioma = :P0_IDIDIOMA
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 12485253879301213
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDTIPOTAREFA
                layout {
                    width: 47
                    sequence: 1
                }
            )

            displayColumn (
                column: @DESCRICAO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @ATIVO
                layout {
                    width: 64
                    sequence: 3
                }
            )

            displayColumn (
                column: @IDTEXTO
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @TEXTOTRADUZIDO
                layout {
                    width: 277
                    sequence: 3
                }
            )

        )

        column ATIVO (
            type: selectList
            heading {
                heading: Ativo
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @lov-simnao
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ATIVO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column DESCRICAO (
            type: textarea
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 20
            }
            validation {
                valueRequired: true
                maxLength: 200
            }
            source {
                databaseColumn: DESCRICAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column IDTEXTO (
            type: link
            heading {
                heading: Tradução
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            link {
                target: {
                    page: 100
                    items: {
                        P100_IDTEXTOTRADUZIDO: &IDTEXTO.
                    }
                    action: resetPagination
                }
                linkText: <b>Visualizar / Atualizar texto traduzido</b>
                linkAttributes: class="t-Button t-Button--sucess"
            }
            source {
                databaseColumn: IDTEXTO
                dataType: number
            }
        )

        column IDTIPOTAREFA (
            type: link
            heading {
                heading: Editar
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 64
                    items: {
                        P64_IDTIPOTAREFA: &IDTIPOTAREFA.
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                databaseColumn: IDTIPOTAREFA
                dataType: number
            }
        )

        column TEXTOTRADUZIDO (
            type: textarea
            heading {
                heading: Tradução
                alignment: center
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: TEXTOTRADUZIDO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

    )

    button novo (
        buttonName: Novo
        label: Novo
        layout {
            sequence: 10
            region: @tipos-tarefas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 64
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button novo-2 (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 64
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

