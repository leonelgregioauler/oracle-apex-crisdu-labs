            associatedItem: @P53_VALORVENDA
        }
    )

    process consulta-preços-produtos (
        name: Consulta Preços Produtos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidproduto              number;
                  vvalorcusto             number;
                  vvalorvenda             number;
                  vvalorcomissaoatendente number;
                begin
                  --
                  #OWNER#.PCK_CADASTROS_FAV.PRC_PRECOSPRODUTOS ( PIDPRECOPRODUTO           => :P53_IDPRECOPRODUTO
                                                               , PIDEDICAOREVISTA          => :P53_IDEDICAOREVISTA
                                                               , PIDPRODUTO                => vidproduto
                                                               , PIDPRODUTODETALHADO       => :P53_IDPRODUTODETALHADO
                                                               , PIDFILIALROMANCE          => :P53_IDFILIALROMANCE
                                                               , PVALORCUSTO               => vvalorcusto
                                                               , PVALORVENDA               => vvalorvenda
                                                               , PPERCCOMISSAOGERENTE      => :P53_PERCCOMISSAOGERENTE
                                                               , PPERCCOMISSAODISTRIBUIDOR => :P53_PERCCOMISSAODISTRIBUIDOR
                                                               , PPERCCOMISSAOCONSULTORA   => :P53_PERCCOMISSAOCONSULTORA
                                                               , PVALORCOMISSAOATENDENTE   => vvalorcomissaoatendente
                                                               , pcustofiscaligrejinha     => :P53_CUSTO_FISCAL_IGREJINHA
                                                               , pcustofiscalcampogrande   => :P53_CUSTO_FISCAL_CAMPO_GRANDE
                                                               , pcustofiscalbelem         => :P53_CUSTO_FISCAL_BELEM
                                                               , pcustofiscalmanaus        => :P53_CUSTO_FISCAL_MANAUS
                                                               , PMD5                      => :P53_MD5
                                                               , POPERACAO_DML             => 'S');
                  --
                  :P53_VALORCUSTO             := to_char(vvalorcusto,             '999G999G999G990D00');
                  :P53_VALORVENDA             := to_char(vvalorvenda,             '999G999G999G990D00');
                  :P53_VALORCOMISSAOATENDENTE := to_char(vvalorcomissaoatendente, '999G999G999G990D00');
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 186381942065371922
        }
    )

    process limpar-campos-ao-sair (
        name: Limpar Campos ao Sair
        type: clearSessionState
        execution {
            sequence: 10
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 186382329818371922
        }
    )

    process limpar-campos-para-adicionar (
        name: Limpar Campos para Adicionar
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 186381576415371922
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    process operação-dml-em-preços-produtos (
        name: Operação DML em Preços Produtos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                  --
                  vidproduto              number;
                  vvalorcusto             number;
                  vvalorvenda             number;
                  vvalorcomissaoatendente number;
                  --
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  vvalorcusto                := to_number(:P53_VALORCUSTO                ,'999G999G999G990D00');
                  vvalorvenda                := to_number(:P53_VALORVENDA                ,'999G999G999G990D00'); 
                  vvalorcomissaoatendente    := to_number(:P53_VALORCOMISSAOATENDENTE    ,'999G999G999G990D00'); 
                  --
                  #OWNER#.PCK_CADASTROS_FAV.PRC_PRECOSPRODUTOS ( PIDPRECOPRODUTO           => :P53_IDPRECOPRODUTO
                                                               , PIDEDICAOREVISTA          => :P53_IDEDICAOREVISTA
                                                               , PIDPRODUTO                => vidproduto
                                                               , PIDPRODUTODETALHADO       => :P53_IDPRODUTODETALHADO
                                                               , PIDFILIALROMANCE          => :P53_IDFILIALROMANCE
                                                               , PVALORCUSTO               => vvalorcusto
                                                               , PVALORVENDA               => vvalorvenda
                                                               , PPERCCOMISSAOGERENTE      => :P53_PERCCOMISSAOGERENTE
                                                               , PPERCCOMISSAODISTRIBUIDOR => :P53_PERCCOMISSAODISTRIBUIDOR
                                                               , PPERCCOMISSAOCONSULTORA   => :P53_PERCCOMISSAOCONSULTORA
                                                               , PVALORCOMISSAOATENDENTE   => vvalorcomissaoatendente
                                                               , pcustofiscaligrejinha     => :P53_CUSTO_FISCAL_IGREJINHA
                                                               , pcustofiscalcampogrande   => :P53_CUSTO_FISCAL_CAMPO_GRANDE
                                                               , pcustofiscalbelem         => :P53_CUSTO_FISCAL_BELEM
                                                               , pcustofiscalmanaus        => :P53_CUSTO_FISCAL_MANAUS
                                                               , PMD5                      => :P53_MD5
                                                               , POPERACAO_DML             => voperacao_dml);
                                                              --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 186381102103371922
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 53
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

)

