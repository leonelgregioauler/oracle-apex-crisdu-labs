page 606 (
    name: Rel Liberações Vendas Esp.
    title: Rel Liberações Vendas Esp.
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region vendas-especiais (
        name: Vendas Especiais
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select IDLIBERACAOVENDAESPECIAL, 
                       IDEDICAOREVISTA,
                       IDFILIALROMANCE,
                       --DISTRIBUIDORES
                      (select listagg(initcap(nomepessoa),'; ') WITHIN GROUP (ORDER BY nomepessoa ASC) 
                        from pessoas p
                       where p.idpessoa in (select idpessoa 
                                              from representantes r
                                             where r.idrepresentante in ( select regexp_substr(L.Distribuidores, '[^:]+', 1, level) ID
                                                                           from dual
                                                                        connect by level <= regexp_count(L.Distribuidores, ':') + 1 ) ) ) "Distribuidores"
                from LIBERACOESVENDASESPECIAIS L
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: VENDAESP
        }
        link {
            linkColumn: customTarget
            target: {
                page: 607
                items: {
                    P607_IDLIBERACAOVENDAESPECIAL: #IDLIBERACAOVENDAESPECIAL#
                }
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="Edit">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 1500756925631267934
        }

        column Distribuidores (
            type: plainText
            heading {
                heading: Distribuidores
                alignment: center
            }
            layout {
                sequence: 13
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column IDEDICAOREVISTA (
            type: plainTextBasedOnLov
            heading {
                heading: Revista
            }
            lov {
                lov: @lov-edicoesrevistas
            }
            layout {
                sequence: 2
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column IDFILIALROMANCE (
            type: plainTextBasedOnLov
            heading {
                heading: Franquia
            }
            lov {
                lov: @lov-filiaisromance
            }
            layout {
                sequence: 3
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        column IDLIBERACAOVENDAESPECIAL (
            type: hidden
            heading {
                heading: Idliberacaovendaespecial
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport REL01 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn "Distribuidores" (
                sequence: 4
            )

            displayColumn IDEDICAOREVISTA (
                sequence: 2
            )

            displayColumn IDFILIALROMANCE (
                sequence: 3
            )

            displayColumn IDLIBERACAOVENDAESPECIAL (
                sequence: 1
            )

        )

    )

    pageItem P606_VOLTARPARA (
        type: hidden
        layout {
            sequence: 10
            region: @vendas-especiais
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Novo Registro
        layout {
            sequence: 30
            region: @vendas-especiais
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 607
                clearCache: 607
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

