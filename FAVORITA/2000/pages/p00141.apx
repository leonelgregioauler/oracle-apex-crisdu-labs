page 141 (
    name: Filtro Impressão Financeiro
    title: Filtro Impressão Financeiro
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function imprime()
            {
                idcomp     = document.getElementById("P141_IDCOMPRATRANSFERENCIA").value;
                volume     = document.getElementById("P141_VOLUME").value;
                ordenacao  = retornaSelecionado("P141_ORDENACAO");
                
                pjanela = window.open('f?p=&APP_ID.:142:&SESSION.::NO::P142_IDCOMPRATRANSFERENCIA,P142_VOLUME,P142_ORDENACAO:'+idcomp+','+volume+','+ordenacao,'page','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1280,height=1024,left=20,top=10','_blank');
                pjanela.focus();                          
            }
            
            function retornaSelecionado(nome) {
             var resultado;
             document.getElementsByName(nome).forEach(function(item){if (item.checked) resultado = item.value}); 
             return resultado;
            }
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region impressão-financeiro (
        name: Impressão Financeiro
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P141_IDCOMPRATRANSFERENCIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @impressão-financeiro
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P141_ORDENACAO (
        type: radioGroup
        label {
            label: Ordenação
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Nenhuma;0,Distribuidor;27,Valor;20
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @impressão-financeiro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: 0
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P141_SESSION_IMPRIME (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @impressão-financeiro
            slot: regionBody
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_url varchar2(2000);
                    l_app number := 2000;
                    l_session number := v('APP_SESSION');
                BEGIN
                    l_url := APEX_UTIL.PREPARE_URL(
                        p_url => 'f?p=' || l_app || ':142:'||l_session||'::NO::P142_IDCOMPRATRANSFERENCIA,P142_VOLUME,P142_ORDENACAO:'||:P141_IDCOMPRATRANSFERENCIA||','||:P141_VOLUME||','||:P141_ORDENACAO,
                        p_checksum_type => 'SESSION');
                    
                    return l_url;
                END;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P141_VOLUME (
        type: selectList
        label {
            label: Volume
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select DISTINCT volume display_value
                  , volume return_value
                from pedidosremessasct 
                where idcompratransferencia = :P141_IDCOMPRATRANSFERENCIA
                ```
            nullDisplayValue: < Todos >
        }
        layout {
            sequence: 10
            region: @impressão-financeiro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Fechar
        layout {
            sequence: 10
            region: @impressão-financeiro
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 74
                items: {
                    P74_IDCOMPRATRANSFERENCIA: &P141_IDCOMPRATRANSFERENCIA.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button imprimir (
        buttonName: IMPRIMIR
        label: Imprimir
        layout {
            sequence: 20
            region: @impressão-financeiro
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript: imprime();
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

