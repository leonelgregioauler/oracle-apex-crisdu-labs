                ```plsql
                declare
                  vvalor varchar2(1);
                begin
                  --
                  vvalor := pck_util_fav.fnc_verificaacesso(58005,:P0_IDUSUARIO);
                  --
                  return vvalor;
                  --
                exception
                when others then
                  vvalor := 'N';
                end;
                ```
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vvalor varchar2(1);
                begin
                  --
                  vvalor := pck_util_fav.fnc_verificaacesso(58005,:P0_IDUSUARIO);
