    dynamicAction atualiza-valor-de-juros (
        name: Atualiza Valor de Juros
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P537_DATAATUALIZADO
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P537_DATAATUALIZADO
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: DATAATUALIZADO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction mostra-data (
        name: Mostra Data
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P537_FILTRARDATA
        }
        clientSideCondition {
            type: itemIsInList
            item: P537_FILTRARDATA
            list: [
                E
                V
            ]
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P537_DATAINI
                    P537_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P537_DATAINI
                    P537_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    validation existe-filtro (
        name: Existe Filtro
        execution {
            sequence: 20
        }
        validation {
            plsqlExpression:
                ```plsql
                :P537_DATAINI is not null
                or :P537_DATAFIM is not null
                or :P537_SITUACAO is not null
                or :P537_FILIALFAVORITA is not null
                or :P537_FILIALROMANCE is not null
                or :P537_FILIALFAVORITA is not null
                or :P537_DISTRIBUIDORA is not null
                or :P537_CONSULTORA is not null
                or :P537_IDCIDADE is not null
                or :P537_NRPEDIDO is not null
                or :P537_NRBOLETO is not null
                ```
        }
        error {
            errorMessage: Não é possivel filtrar sem nenhum filtro, favor filtrar alguma informação
        }
    )

    validation valida-uso-da-data-atualizada (
        name: Valida Uso da Data Atualizada
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where to_date(:P537_DATAATUALIZADO,'DD/MM/RRRR') < trunc(sysdate)
                ```
        }
        error {
            errorMessage: Data não permitida, utilize uma data maior ou igual ao dia de hoje!
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P537_DATAATUALIZADO
        }
    )

    process gerar-tarefa-de-cobrança (
        name: Gerar Tarefa de Cobrança
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_tarefas_fav.prc_geratarefacobrancacall(pidpedido => :P537_IDEDITAR,
                                                             pidusuario => :P0_IDUSUARIO);
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Tarefa de Cobrança gerada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 768495823138010783
        }
        serverSideCondition {
            type: request=Value
            value: GERARTAREFA
        }
    )

    branch (
        name: go to page 537
        execution {
            sequence: 10
        }
        behavior {
            target: {
