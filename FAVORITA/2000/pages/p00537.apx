            )

            displayColumn VERPAGAMENTOS (
                sequence: 15
            )

            sort (
                column: SITUACAODOVENCIMENTO
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            filter ir-condition (
                column: SITUACAODOVENCIMENTO
                operator: in
                value: Valido (Aberto),Valido (Quitado),Valido (Vencido), Valido (Incobravel)
            )

            controlBreak (
                column: VENDEDORA
                layout {
                    sequence: 1
                }
            )

            controlBreak (
                column: SITUACAODOVENCIMENTO
                layout {
                    sequence: 2
                }
            )

        )

    )

    pageItem P537_CONSULTORA (
        type: popupLov
        label {
            label: Cliente
            alignment: left
        }
        settings {
            initialFetch: onUserRequest
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.nomepessoa)||' ('||nvl(p.cpf,p.documentoestrangeiro)||')' display_value
                     , v.idvendedora
                from vendedoras v
                   , pessoas p
                where p.idpessoa = v.idpessoa
                  and (:P537_DISTRIBUIDORA is null or v.idrepresentante = :P537_DISTRIBUIDORA) 
                order by 1
                ```
            nullDisplayValue: - Todas -
        }
        cascadingLov {
            parentItems: P537_DISTRIBUIDORA
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

