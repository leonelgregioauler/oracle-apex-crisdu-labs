page 537 (
    name: Vencimentos de Pedidos  - VPD
    title: "Vencimentos de Pedidos "
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function imprimeboleto(vidpedido,vidvendedora)
            {   
              /*vurl = 'https://boleto.romancemoda.com.br/boleto_bb_favorita_sem_iframe_com_pix_v2.php?cod1='+vidpedido+'&cod2='+vidvendedora;*/
              vurl = document.getElementById('P0_URLBOLETOBASE').value+'?cod1='+vidpedido+'&cod2='+vidvendedora;
              pjan = window.open(vurl,'boleto','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1024,height=1000,left=20,top=10','_blank'); 
              pjan.focus();
            }
            
            function fnc_gerartarefa(pid)
            {
              document.getElementById("P119_IDEDITAR").value = pid;
              apex.submit('GERARTAREFA');
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region vencimentos-de-pedidos (
        name: Vencimentos de Pedidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.*
                     , case 
                         when v.saldo > 0 and :P537_DATAATUALIZADO > v.datavencimento then
                           pck_util_fav.fnc_calculajuros(pidpedido           => v.idpedido,
                                                         pvalororiginal      => v.saldo,
                                                         pdatavencimentoorig => v.datavencimento,
                                                         pdatavencimentonovo => to_date(:P537_DATAATUALIZADO,'DD/MM/RRRR'),
                                                         ppercmulta          => 2,
                                                         ppercjuros          => 1)
                         when v.saldo > 0 and trunc(sysdate) > v.datavencimento then
                           pck_util_fav.fnc_calculajuros(pidpedido           => v.idpedido,
                                                         pvalororiginal      => v.saldo,
                                                         pdatavencimentoorig => v.datavencimento,
                                                         pdatavencimentonovo => to_date(:P537_DATAATUALIZADO,'DD/MM/RRRR'),
                                                         ppercmulta          => 2,
                                                         ppercjuros          => 1)         
                       else
                           v.saldo
                       end valoratualizado
                       --
                     , case 
                         when (select 1 
                               from pagamentospedidos pg
                                  , formaspagamentos fp
                               where pg.idvencimentopedido = v.idvencimentopedido
                                 and pg.idformapagamento   = fp.idformapagamento
                                 and fp.boleto = 'S'
                                 and rownum = 1 
                                 and exists (select 1
                                              from filiais f
                                              where f.idfilial = v.idfilialromance
                                                and f.ididioma = 1)) = 1 then
                           '<a href=javascript:imprimeboleto('||v.idpedido||','||v.idvendedora||');><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' 
                         else
                          '-'
                       end urlboleto  
                      , case 
                          when v.datavencimento < trunc(sysdate) and not exists ( select 1
                                                                                  from tarefas t
                                                                                  where t.idpedido = v.idpedido
                                                                                    and t.idtipotarefa = 4 
                                                                                    and t.idsituacao in (0,10,20,40) ) then
                            '<a href="javascript:fnc_gerartarefa('|| v.idpedido ||')" ><img src="#APP_IMAGES#ok.png"  border="0"></a>' 
                          else
                           '<font color="red">Tarefa já Gerada '||(select max(t.idtarefa)
                                                                   from tarefas t
                                                                   where t.idpedido = v.idpedido
                                                                     and t.idtipotarefa = 4
                                                                     and t.idsituacao = 0)||'</font>'
                        end tarefacobranca2
                      , null pix_boleto
                      , v.desconto desconto_va
                      , null lancardesconto
                      , null Cartao_credito
                  from VWFA_APP2000_P537_REL001 v
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                :P537_DATAINI is not null
                or :P537_DATAFIM is not null
                or :P537_SITUACAO is not null
                or :P537_FILIALFAVORITA is not null
                or :P537_FILIALROMANCE is not null
                or :P537_FILIALFAVORITA is not null
                or :P537_DISTRIBUIDORA is not null
                or :P537_CONSULTORA is not null
                or :P537_IDCIDADE is not null
                or :P537_NRPEDIDO is not null
                or :P537_NRBOLETO is not null
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Nenhum Vencimento encontrado!
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            savePublicReport: true
            subscription: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 17426925518060797121
        }

