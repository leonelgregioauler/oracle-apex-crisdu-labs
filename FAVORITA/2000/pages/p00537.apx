    pageItem P537_DISTRIBUIDORA (
        type: popupLov
        label {
            label: Distribuidora
            alignment: left
        }
        settings {
            initialFetch: onUserRequest
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROMAN.pck_romance.fnc_nomerepresentante(idrepresentante) DISPLAY_VALUE
                     , idrepresentante RETURN_VALUE
                from representantes
                where (:P537_FILIALROMANCE is null or
                    ( :P537_FILIALROMANCE is not null and idgerente in ( select idgerente from gerentes where idfilial = :P537_FILIALROMANCE) ))
                order by 1
