page 678 (
    name: Cadastro Usuários Integração RFID
    alias: CADASTRO-USUÁRIOS-INTEGRAÇÃO-RFID
    title: Usuários Integração RFID
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
    }
    dialog {
        height: 320
    }

    region cadastrar-usuário-rfid (
        name: Cadastrar Usuário RFID
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
    )

    pageItem P678_ATIVO (
        type: selectOne
        label {
            label: <b>Usuário &P678_USUARIO. <br><br></b>Ativo?
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: staticValues
            staticValues: STATIC:Sim;S,Não;N
        }
        layout {
            sequence: 40
            region: @cadastrar-usuário-rfid
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P678_IDUSUARIO
        }
    )

    pageItem P678_IDUSUARIO (
        type: hidden
        layout {
            sequence: 10
            region: @cadastrar-usuário-rfid
            slot: regionBody
        }
    )

    pageItem P678_SENHA (
        type: password
        label {
            label: <b>Senha</b>
            alignment: left
        }
        layout {
            sequence: 30
            region: @cadastrar-usuário-rfid
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 12
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        serverSideCondition {
            type: itemIsNull
            item: P678_IDUSUARIO
        }
    )

    pageItem P678_USUARIO (
        type: textField
        label {
            label: <b>Usuário</b>
            alignment: left
        }
        layout {
            sequence: 20
            region: @cadastrar-usuário-rfid
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 12
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        serverSideCondition {
            type: itemIsNull
            item: P678_IDUSUARIO
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @cadastrar-usuário-rfid
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--gapTop
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 677
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 10
            region: @cadastrar-usuário-rfid
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--gapTop
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P678_IDUSUARIO
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 10
            region: @cadastrar-usuário-rfid
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--gapTop
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P678_IDUSUARIO
        }
    )

    validation valida-usuario (
        name: Valida Usuario
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from favorita.rfid_users 
                where upper(usuario) = upper(:P678_USUARIO)
                ```
        }
        error {
            errorMessage: Usuário já cadastrado.
            associatedItem: @P678_USUARIO
        }
    )

    validation validasenhaforte (
        name: ValidaSenhaForte
        execution {
            sequence: 20
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                FROM dual
                WHERE 
                LENGTH(:P678_SENHA) >= 10
                AND REGEXP_LIKE(:P678_SENHA, '[[:lower:]]')
                AND REGEXP_LIKE(:P678_SENHA, '[[:upper:]]')
                AND REGEXP_LIKE(:P678_SENHA, '[[:digit:]]')
                AND REGEXP_LIKE(:P678_SENHA, '[!@#$%^&*.]');
                ```
        }
        error {
            errorMessage:
                ```
                A senha deve ter no mínimo 8 caracteres, incluindo letra maiúscula, minúscula, número e caractere especial..
                
                ```
            associatedItem: @P678_SENHA
        }
    )

    process carrega-dados (
        name: Carrega Dados
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    select 
                        usuario,
                        senha_hash,
                        ativo
                    into 
                        :P678_USUARIO,
                        :P678_SENHA,
                        :P678_ATIVO
                    from favorita.rfid_users
                    where idusuario = :P678_IDUSUARIO;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 33067049009282635
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P678_IDUSUARIO
        }
    )

    process criauser (
        name: CriaUser
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  v_sucesso VARCHAR2(1);
                BEGIN
                  favorita.pck_rfid.prc_rfid_users(
                    p_usuario  => :P678_USUARIO,
                    p_senha    => :P678_SENHA,
                    p_operacao => 'I',
                    r_sucesso  => v_sucesso
                  );
                
                  IF v_sucesso <> 'S' THEN
                    APEX_ERROR.ADD_ERROR(
                      p_message          => 'Erro ao criar usuário.',
                      p_display_location => apex_error.c_inline_in_notification
                    );
                  END IF;
                
                EXCEPTION
                  WHEN OTHERS THEN
                    APEX_ERROR.ADD_ERROR(
                      p_message          => 'Erro inesperado: ' || SQLERRM,
                      p_display_location => apex_error.c_inline_in_notification
                    );
                END;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Usuário criado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 33065405852282619
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process desativa-ativa-user (
        name: Desativa/Ativa User
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN  
                    UPDATE favorita.rfid_users
                    SET ativo = :P678_ATIVO
                    WHERE idusuario = :P678_IDUSUARIO;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Registro Atualizado.
        }
        error {
            errorMessage: Erro ao atualizar.
        }
        advanced {
            executionMappingIdentifier: 33067347488282638
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    branch (
        name: Go to 677
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 677
            }
        }
    )

)

