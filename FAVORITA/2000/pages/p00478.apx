page 478 (
    name: Compras Efetivadas
    title: Compras Efetivadas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function abrecompra(IDCOMPRATRANSFERENCIA) 
              {
                  vurl = 'f?p=&APP_ID.:74:&SESSION.::NO::P74_IDCOMPRATRANSFERENCIA:'+IDCOMPRATRANSFERENCIA;
                  pjan = window.open(vurl,'page','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1280,height=1024,left=20,top=10','_blank'); void(0);
                  pjan.focus();
              }
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region compras-efetivadas (
        name: Compras Efetivadas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.numero
                     , roman.pck_romance.fnc_nomefornecedor(c.idfornecedor) fornecedor
                     , pck_util_fav.fnc_retornasitcompratransf(c.idsituacao,:P0_IDIDIOMA) situacao
                     , c.notafiscal
                     , c.dataemissao
                     , c.dataprevisaoentrega
                     , ii.quantidadecomprada
                     , ii.quantidadecomprada*ii.valorcusto custocomprado
                     , c.IDCOMPRATRANSFERENCIA
                    -- , '<a href="f?p=2000:74:&SESSION.::NO::P74_IDCOMPRATRANSFERENCIA:'||c.IDCOMPRATRANSFERENCIA||'" target="_blank"><img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-view.png" class="apex-edit-view" alt=""></a>' b 
                from itenscomprastransferencias ii
                  , comprastransferencias c
                where c.idcompratransferencia   = ii.idcompratransferencia
                  and c.idfilialfavoritadestino = :P478_IDFILIALDESTINO
                  and ii.idprodutodetalhado     = :P478_IDPRODUTODETALHADO
                  and c.idsituacao in (20, 30, 10, 7, 5, 3, 1) 
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhuma compra encontrada.
        }
        advanced {
            savedReportMappingIdentifier: 1696022086454797601
        }

        column CUSTOCOMPRADO (
            type: plainText
            heading {
                heading: Total Custo
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column DATAEMISSAO (
            type: plainText
            heading {
                heading: Emissão
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column DATAPREVISAOENTREGA (
            type: plainText
