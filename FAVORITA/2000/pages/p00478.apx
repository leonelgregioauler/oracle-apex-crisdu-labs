            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column IDCOMPRATRANSFERENCIA (
            type: link
            heading {
                heading: Comp/Transf
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            link {
                target: {
                    type: url
                    url: javascript:abrecompra(#IDCOMPRATRANSFERENCIA#);
                }
                linkText: #IDCOMPRATRANSFERENCIA#
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: K
            }
            enableUsersTo {
                hide: false
                sort: false
                filter: false
                highlight: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
                pivot: false
            }
        )

        column NOTAFISCAL (
