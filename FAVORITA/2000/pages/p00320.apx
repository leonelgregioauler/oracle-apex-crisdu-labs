    button anexar (
        buttonName: ANEXAR
        label: Anexar
        layout {
            sequence: 50
            region: @anexos-pagamentos
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 20
            region: @anexos-pagamentos
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process excluir-anexo (
        name: Excluir Anexo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update pagamentospedidos
                  set numerocomprovante  = null
                    , attach_data        = null
                    , attach_mimetype    = null
                    , attach_filename    = null
                    , attach_last_update = null
                    , attach_charset     = null
                  where idpagamentopedido = :P320_IDPAGAMENTOPEDIDO; 
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Anexo excluído com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1408724348819423629
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where v('REQUEST') in ('EXCLUIR')
                ```
        }
    )

    process fetch-row-from-pagamentospedidos (
        name: Fetch Row from PAGAMENTOSPEDIDOS
        type: autoRowFetch
        source {
            tableName: PAGAMENTOSPEDIDOS
            pkColumn: IDPAGAMENTOPEDIDO
            pkItem: P320_IDPAGAMENTOPEDIDO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1408722751424423617
        }
    )

    process process-row-of-pagamentospedidos (
        name: Process Row of PAGAMENTOSPEDIDOS
        type: autoRowProcessing
        target {
            tableName: PAGAMENTOSPEDIDOS
            pkColumn: IDPAGAMENTOPEDIDO
            pkItem: P320_IDPAGAMENTOPEDIDO
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação processada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1408723567408423629
        }
        serverSideCondition {
            type: request=Value
            value: ANEXAR
        }
    )

    branch (
        name: go to page 321
        execution {
            sequence: 30
        }
        behavior {
            target: {
                page: 321
                items: {
                    P321_IDPAGAMENTOPEDIDO: &P320_IDPAGAMENTOPEDIDO.
                    P321_PAGINAORIGEM: 320
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where v('REQUEST') in ('FECHAR')
                and :P320_PAGINAORIGEM = 321;
                ```
        }
    )

    branch (
        name: go to page 320
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 320
                items: {
                    P320_IDPAGAMENTOPEDIDO: &P320_IDPAGAMENTOPEDIDO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where v('REQUEST') in ('ANEXAR')
                ```
        }
    )

    branch (
        name: go to page 322
        execution {
            sequence: 40
        }
        behavior {
