        }
    )

    pageItem P320_IDPAGAMENTOPEDIDO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @anexos-pagamentos
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDPAGAMENTOPEDIDO
            used: always
