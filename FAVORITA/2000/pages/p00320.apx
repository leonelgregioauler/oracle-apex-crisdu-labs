page 320 (
    name: Anexos Pagamentos
    title: Anexos Pagamentos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 85%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }

    region anexos-pagamentos (
        name: Anexos Pagamentos
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region arquivos-anexados (
        name: Arquivos Anexados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idpagamentopedido,
                       ATTACH_DATA,
                       ATTACH_MIMETYPE,
                       ATTACH_FILENAME,
                       ATTACH_LAST_UPDATE,
                       ATTACH_CHARSET,
                       round(sys.dbms_lob.getlength(ATTACH_DATA)/1024,2)||' kb' file_length,
                       sys.dbms_lob.getlength(ATTACH_DATA) download,
                       '<a href="javascript:apex.confirm(htmldb_delete_message,''EXCLUIR'')"> Excluir </a>' remover
                from pagamentospedidos p
                where p.idpagamentopedido = :P320_IDPAGAMENTOPEDIDO
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from pagamentospedidos p
                where p.idpagamentopedido = :P320_IDPAGAMENTOPEDIDO
                and p.attach_data is not null
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Não foi anexado documento.
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 1407567833124915028
        }

        column ATTACH_CHARSET (
            type: hidden
            heading {
                heading: Attach charset
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
            security {
                escapeSpecialChars: false
            }
        )

        column ATTACH_DATA (
            type: plainText
            heading {
                heading: Download
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: other
            }
            columnFilter {
                type: none
            }
            advanced {
                endUserAlias: B
            }
            enableUsersTo {
                sort: false
                filter: false
                highlight: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
                pivot: false
            }
        )

        column ATTACH_FILENAME (
            type: plainText
            heading {
                heading: Arquivo Anexado
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column ATTACH_LAST_UPDATE (
            type: hidden
            heading {
                heading: Attach last update
            }
            layout {
                sequence: 50
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: E
            }
            security {
                escapeSpecialChars: false
            }
        )

        column ATTACH_MIMETYPE (
            type: hidden
            heading {
                heading: Attach mimetype
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
            security {
                escapeSpecialChars: false
            }
        )

        column DOWNLOAD (
            type: downloadBlob
            heading {
                heading: Download
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            blobAttributes {
                tableName: PAGAMENTOSPEDIDOS
                blobColumn: ATTACH_DATA
                primaryKeyColumn1: IDPAGAMENTOPEDIDO
                mimeTypeColumn: ATTACH_MIMETYPE
                filenameColumn: ATTACH_FILENAME
                lastUpdatedColumn: ATTACH_LAST_UPDATE
                charSetColumn: ATTACH_CHARSET
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column FILE_LENGTH (
            type: plainText
            heading {
                heading: File length
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column IDPAGAMENTOPEDIDO (
            type: hidden
            heading {
                heading: Idpagamentopedido
            }
            layout {
                sequence: 10
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column REMOVER (
            type: plainText
            heading {
                heading: Remover
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
            security {
                escapeSpecialChars: false
            }
        )

        savedReport 14087753 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ATTACH_CHARSET (
                sequence: 6
            )

            displayColumn ATTACH_DATA (
                sequence: 2
            )

            displayColumn ATTACH_FILENAME (
                sequence: 4
            )

            displayColumn ATTACH_LAST_UPDATE (
                sequence: 5
            )

            displayColumn ATTACH_MIMETYPE (
                sequence: 3
            )

            displayColumn DOWNLOAD (
                sequence: 8
            )

            displayColumn FILE_LENGTH (
                sequence: 7
            )

            displayColumn IDPAGAMENTOPEDIDO (
                sequence: 1
            )

            displayColumn REMOVER (
                sequence: 9
            )

        )

    )

    pageItem P320_ATTACH_CHARSET (
        type: hidden
