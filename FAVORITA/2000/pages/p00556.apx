page 556 (
    name: Metas de Lojas
    title: Metas de Lojas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"CONFIRMA EXCLUSÃO DA META?"';
    }

    region metas-de-cobranças (
        name: METAS DE COBRANÇAS
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P556_DATAFIM (
        type: datePickerJquery
        label {
            label: Data Fim
            alignment: left
        }
        layout {
            sequence: 50
            region: @metas-de-cobranças
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr
            width: 10
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: DATAFIM
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P556_DATAINICIO (
        type: datePickerJquery
        label {
            label: Data de Inicío
            alignment: left
        }
        layout {
            sequence: 40
            region: @metas-de-cobranças
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr
            width: 10
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: DATAINICIO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P556_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Filial Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) as d,
                       idfilialfavorita as r
                  from filiaisfavorita f
                where tipofilial = 'L'
                  and ativo = 'S'
                 order by 1
                ```
        }
        layout {
            sequence: 60
            region: @metas-de-cobranças
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDFILIALFAVORITA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P556_IDGRUPOATENDIMENTO (
        type: selectList
        label {
            label: Grupo de atendimento
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DISTINCT
                       a.descricao d
                     , a.idgrupoatendimento r
                  FROM filiaisfavorita  f
                     , catal.usuarios   u
                     , roman.usuariosgruposatendimento g
                     , roman.gruposatendimento a
                WHERE f.idfilialfavorita = :P556_IDFILIALFAVORITA 
                  AND f.idfilialfavorita = u.idfilialfavorita
                  AND g.usuario = u.usuario
                  AND u.ativo = 'S'
                  AND g.idgrupoatendimento = a.idgrupoatendimento
                  AND a.idsistema = 2000
                ORDER BY 1
                ```
        }
        cascadingLov {
            parentItems: P556_IDFILIALFAVORITA
        }
        layout {
            sequence: 90
            region: @metas-de-cobranças
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDGRUPOATENDIMENTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P556_IDMETACOBRANCA (
        type: hidden
        layout {
            sequence: 10
            region: @metas-de-cobranças
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDMETACOBRANCA
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P556_IDUSUARIO (
        type: selectList
        label {
            label: Usuário(a)
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeusuario(idusuario)||' - '||u.usuario  display_value
                     , idusuario  return_value
                from usuarios         u
                where exists ( select 1
                               from usuariossistemas s 
                               where s.usuario = u.usuario 
                                 and s.idsistema = 2000 )
                  and ativo = 'S'
                  and idfilialfavorita = :P556_IDFILIALFAVORITA
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P556_IDFILIALFAVORITA
        }
        layout {
            sequence: 70
            region: @metas-de-cobranças
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDUSUARIO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P556_VALORMETA (
        type: numberField
        label {
            label: Valor da Meta
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 80
            region: @metas-de-cobranças
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: VALORMETA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @metas-de-cobranças
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 555
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Incluir
        layout {
            sequence: 40
            region: @metas-de-cobranças
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P556_IDMETACOBRANCA
        }
    )

    button delete (
        buttonName: DELETE
        label: Excluir
        layout {
            sequence: 20
            region: @metas-de-cobranças
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P556_IDMETACOBRANCA
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @metas-de-cobranças
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P556_IDMETACOBRANCA
        }
    )

    process fetch-row-from-metascobrancas (
        name: Fetch Row from METASCOBRANCAS
        type: autoRowFetch
        source {
            tableName: METASCOBRANCAS
            pkColumn: IDMETACOBRANCA
            pkItem: P556_IDMETACOBRANCA
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 20723769477642287
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P556_IDMETACOBRANCA is null then
                        select "#OWNER#"."SEQ_IDMETACOBRANCA".nextval
                          into :P556_IDMETACOBRANCA
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 20724178233642288
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process process-row-of-metascobrancas (
        name: Process Row of METASCOBRANCAS
        type: autoRowProcessing
        target {
            tableName: METASCOBRANCAS
            pkColumn: IDMETACOBRANCA
            pkItem: P556_IDMETACOBRANCA
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Action Processed.
        }
        advanced {
            executionMappingIdentifier: 20724535591642288
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 20724955667642288
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 555
            }
        }
    )

)

