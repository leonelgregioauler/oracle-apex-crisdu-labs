page 31 (
    name: Relatório Compre e Ganhe
    title: Compre e Ganhe
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region compre-e-ganhe (
        name: Compre e Ganhe
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idcompreeganhe
                     , idprodutodetalhado
                     , nomeprodutodetalhado
                     , idfilialromance
                     , filialromance
                     , datainicial
                     , datafinal
                     , quantidadecomprada
                     , quantidadebrinde
                     , idprodutodetalhadobrinde
                     , nomeprodutodetalhadobrinde
                     , descricao
                     , idedicaorevista
                     , nomeedicaorevista
                     , idtexto
                     , textotraduzido
                     , ididioma
                from vw_compreeganhe_fav
                where (
                      (:p31_datainicial between trunc(datainicial) and trunc(datafinal))
                   or (:p31_datafinal between trunc(datainicial) and trunc(datafinal))
                   or (trunc(datainicial) between nvl(:p31_datainicial, to_date('01/01/00')) and nvl(:p31_datafinal, to_date('31/12/25')) )
                   or (trunc(datafinal)   between nvl(:p31_datainicial, to_date('01/01/00')) and nvl(:p31_datafinal, to_date('31/12/25')) ) 
                   or (:p17_datainicial is null and :p31_datafinal is null) 
                    )
                and ididioma = :P0_IDIDIOMA;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 12996395621537144
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDCOMPREEGANHE
                layout {
