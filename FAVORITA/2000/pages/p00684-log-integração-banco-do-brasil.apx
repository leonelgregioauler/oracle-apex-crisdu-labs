    dynamicAction abre-tela (
        name: abre tela
        execution {
            sequence: 50
        }
        when {
            event: click
            selectionType: button
            button: @telaignorar
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var url = apex.util.makeApplicationUrl({
                        pageId: 693
                    });
                    
                    window.open(url, '_blank');
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

