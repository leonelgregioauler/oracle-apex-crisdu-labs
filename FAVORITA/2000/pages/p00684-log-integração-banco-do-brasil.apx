    region log-banco-do-brasil (
        name: "Log - Banco do Brasil "
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    l_sql VARCHAR2(32767);
                BEGIN
                    l_sql := q'[
                        SELECT 
                            CASE 
                                WHEN v.resp_status = 'ERRO' THEN '<span class="fa fa-times-circle status-erro"></span>'
                                ELSE '<span class="fa fa-check-circle status-ok"></span>'
                            END AS status_icon,
                            v.*
                        FROM vw_bb_log_erros_abertos v
                        WHERE 1 = 1
                    ]';
                
                    IF :P684_IDPEDIDO IS NOT NULL THEN
                        l_sql := l_sql || ' AND v.IDPEDIDO = :P684_IDPEDIDO ';
                    END IF;
                
                    IF :P684_DATAINICIAL IS NOT NULL THEN
                        l_sql := l_sql || ' AND v.DTHR_REQUISICAO >= :P684_DATAINICIAL ';
                    END IF;
                
                    IF :P684_IDFILIAL IS NOT NULL THEN
                        l_sql := l_sql || ' AND v.idfilialfavorita = :P684_IDFILIAL ';
                    END IF;
                
                    IF :P684_SITUACAO IS NOT NULL THEN
                        IF :P684_SITUACAO != 'ERRO' THEN
                            l_sql := l_sql || ' AND v.resp_status = :P684_SITUACAO ';
                        ELSE
                            l_sql := l_sql || ' AND v.erro_em_aberto = ''S'' ';
                        END IF;
                    END IF;
                
                    l_sql := l_sql || ' ORDER BY v.IDLOG DESC';
                
                    RETURN l_sql;
                END;
                ```
        }
        layout {
            sequence: 120
            slot: body
            rowCssClasses: #RESP_STATUS#
        }
