    process busca-dados-convenio (
        name: Busca Dados Convenio
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                    v_sul_reg NUMBER := 0;
                    v_sul_err NUMBER := 0;
                
                    v_norte_reg NUMBER := 0;
                    v_norte_err NUMBER := 0;
                
                    v_novonorte_reg NUMBER := 0;
                    v_novonorte_err NUMBER := 0;
                
                    v_comercial_reg NUMBER := 0;
                    v_comercial_err NUMBER := 0;
                
                BEGIN
                
                    FOR r IN (
                
                        SELECT
                              COUNT(DISTINCT idpagamentopedido) qtd_boletos,
                              convenio,
                              status_registro_bb
                        FROM
                        (
                
                            SELECT
                                  pp.idpedido,
                                  pp.idfilialfavorita,
                                  bb.idpagamentopedido,
                                  bb.status_registro_bb,
                                  lg.dthr_requisicao,
                                  COALESCE(
                                        (
                                            SELECT MAX(cb.convenio)
                                            FROM conveniosbancos cb
                                            JOIN atendimentosfiscais a
                                              ON cb.idempresaemitente = a.idempresavirtualorig
                                           WHERE a.idempresavirtualdest = pp.idempresavirtualage
                                        ),
                                        (
                                            SELECT MAX(cb.convenio)
                                            FROM controlearquivosbanco ca
                                            JOIN conveniosbancos cb
                                              ON cb.idconveniobanco = ca.idconveniobanco
                                           WHERE ca.idpagamentopedido = bb.idpagamentopedido
                                             AND ca.situacaobanco = 'A'
                                             AND ca.atualizacaositbanco = 1
                                        )
                                  ) convenio
                            FROM favorita.pagamentospedidos bb
                            JOIN favorita.vencimentospedidos vp
                                  ON bb.idvencimentopedido = vp.idvencimentopedido
                            JOIN favorita.pedidos pp
                                  ON vp.idpedido = pp.idpedido
                
                            -- JOIN COM LOG (DEDUPLICADO)
                            JOIN (
                                SELECT
                                    l.idpagamentopedido,
                                    MAX(l.dthr_requisicao) dthr_requisicao
                                FROM favorita.bb_log_requisicoes l
                                WHERE l.idpagamentopedido > 5703389
                                GROUP BY l.idpagamentopedido
                            ) lg
                              ON lg.idpagamentopedido = bb.idpagamentopedido
                
                            WHERE bb.status_registro_bb IS NOT NULL
                              AND bb.idpagamentopedido > 5703389
                              AND bb.IDSITUACAO <> -1
                
                              --  FILTRO DE DATA (AGORA NO LOG)
                              AND (lg.dthr_requisicao >= :P684_DATAINICIAL
                                   OR (:P684_DATAINICIAL IS NULL AND pp.DATAEMISSAO > SYSDATE -15))
                
                              --  FILTRO DE FILIAL
                              AND (pp.idfilialfavorita = :P684_IDFILIAL
                                   OR :P684_IDFILIAL IS NULL)
                                   
                            AND NOT EXISTS (select 1
                                from bb_pedidos_ignorados i
                               where i.idpedido = vp.idpedido
                                 and i.ativo    = 'S')
                              
                              and vp.SITUACAOVENCIMENTO = 'V'
                              AND NOT (
                                            bb.status_registro_bb = 'ERRO'
                                            AND trunc(vp.datavencimento) < TRUNC(SYSDATE)
                                        )
                              and pp.idpais = 1
                              AND NOT EXISTS (select 1
                                                from classificacoespedidos c
                                                where c.idcaracteristicapedido = 25
                                                  and c.idpedido = vp.idpedido)
                
                        )
                        GROUP BY
                              convenio,
                              status_registro_bb
                
                    )
                    LOOP
                
                        IF r.convenio = '3550636' THEN
                            IF r.status_registro_bb = 'ERRO' THEN
                                v_sul_err := r.qtd_boletos;
                            ELSE
                                v_sul_reg := r.qtd_boletos;
                            END IF;
                
                        ELSIF r.convenio = '3550401' THEN
                            IF r.status_registro_bb = 'ERRO' THEN
                                v_norte_err := r.qtd_boletos;
                            ELSE
                                v_norte_reg := r.qtd_boletos;
                            END IF;
                
                        ELSIF r.convenio = '3744145' THEN
                            IF r.status_registro_bb = 'ERRO' THEN
                                v_novonorte_err := r.qtd_boletos;
                            ELSE
                                v_novonorte_reg := r.qtd_boletos;
                            END IF;
                
                        ELSIF r.convenio = '3550633' THEN
                            IF r.status_registro_bb = 'ERRO' THEN
                                v_comercial_err := r.qtd_boletos;
                            ELSE
                                v_comercial_reg := r.qtd_boletos;
                            END IF;
                
                        END IF;
                
                    END LOOP;
                
                    :P684_SUL := '3550636';
                    :P684_SUL_ERRO := v_sul_err;
                    :P684_SUL_REGISTRO := v_sul_reg;
                
                    :P684_NORTE := '3550401';
                    :P684_NORTE_ERRO := v_norte_err;
                    :P684_NORTE_REGISTRO := v_norte_reg;
                
                    :P684_NOVONORTE := '3744145';
                    :P684_NOVONORTE_ERRO := v_novonorte_err;
                    :P684_NOVONORTE_REGISTRO := v_novonorte_reg;
                
                    :P684_COMERCIAL := '3550633';
                    :P684_COMERCIAL_ERRO := v_comercial_err;
                    :P684_COMERCIAL_REGISTRO := v_comercial_reg;
                
                    :P684_TOTAL_REGISTRO :=
                        v_sul_reg + v_norte_reg + v_novonorte_reg + v_comercial_reg;
                
                    :P684_TOTAL_ERRO :=
                        v_sul_err + v_norte_err + v_novonorte_err + v_comercial_err;
                
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 40594544839331710
        }
    )

    process reprocessaerros (
        name: ReprocessaErros
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_json     CLOB;
                    l_mensagem VARCHAR2(32767);
                BEGIN
                    prc_reprocessa_erros_bb(
                        p_limite       => 5,
                        p_delay_seg    => 1,
                        p_consultar_bb => 'N',
                        r_json         => l_json,
                        r_mensagem     => l_mensagem
                    );
                
                    apex_application.g_print_success_message := l_mensagem;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Reprocessado.
        }
        error {
            errorMessage: Erro ao processar.
        }
        advanced {
            executionMappingIdentifier: 2524710762396599334
        }
        serverSideCondition {
            whenButtonPressed: @reprocessa
        }
    )

)

