    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            document.querySelectorAll('.bb-donut').forEach(function(donut){
            
                const reg = parseInt(donut.dataset.reg) || 0;
                const err = parseInt(donut.dataset.err) || 0;
            
                const total = reg + err;
            
                // cálculo REAL (sem arredondar)
                const percent = total > 0 ? (reg / total) * 100 : 0;
            
                // regra de exibição (corrige 100% falso)
                let displayPercent;
            
                if(total === 0){
                    displayPercent = 0;
                }else if(reg === total){
                    displayPercent = 100;
                }else{
                    displayPercent = percent.toFixed(1); // ex: 99.6%
                }
            
                if(total === 0){
            
                    donut.style.background =
                        "conic-gradient(#e5e7eb 100%, #e5e7eb 0)";
            
                    donut.classList.add("bb-donut-empty");
            
                }else{
            
                    donut.style.background =
                        `conic-gradient(
                            #22c55e 0%,
                            #34d399 ${percent}%,
                            #ef4444 ${percent}%,
                            #ef4444 100%
                        )`;
            
                    donut.classList.remove("bb-donut-empty");
                }
            
                const value = donut.querySelector('.bb-donut-value');
                if(value){
                    value.innerText = displayPercent + "%";
                }
            
            });
            
            setTimeout(function(){
                location.reload();
            }, 60000); // 60000 ms = 1 minuto
            ```
    }
    css {
        inline:
            ```css
            .status-erro{ color:#ef4444; font-size:18px; } 
            .status-ok{ color:#22c55e; font-size:18px; }
            
            .btn-buscar-modern { 
                background: linear-gradient(135deg, #5ec6c9, #4b79d8); 
                border: none !important; 
                color: white !important; 
                font-weight: 600; 
                padding: 10px 20px; 
                border-radius: 10px; 
                box-shadow: 0 4px 10px rgba(75,121,216,0.25); 
                transition: transform .15s ease, box-shadow .15s ease, filter .15s ease; 
            }
            .btn-buscar-modern:hover { 
                transform: translateY(-1px); 
                box-shadow: 0 8px 18px rgba(75,121,216,0.35); 
                filter: brightness(1.03); 
            }
            .btn-buscar-modern:active { 
                transform: translateY(0px); 
                box-shadow: 0 3px 8px rgba(0,0,0,0.2); 
            }
            .btn-buscar-modern:focus { 
                outline: none; 
                box-shadow: 0 0 0 3px rgba(94,198,201,0.25); 
            }
            
            .t-Report-colHead{ color: #082a6e; }
            
            /* HEADER */
            .cx-page-header{
                display:grid;
                grid-template-columns:1fr auto;
                align-items:center;
                gap:40px;
                padding-bottom:20px;
                margin-bottom:28px;
                border-bottom:1px solid #eef2f6;
            }
            
            .cx-page-header-content{
                display:flex;
                flex-direction:column;
                gap:6px;
                max-width:520px;
            }
            
            .cx-page-title{
                font-size:30px;
                font-weight:700;
                letter-spacing:-0.02em;
                color:#334155;
                margin:0;
                position:relative;
                padding-left:16px;
            }
            
            .cx-page-title::before{
                content:"";
                position:absolute;
                left:0;
                top:6px;
                width:4px;
                height:26px;
                border-radius:3px;
                background:linear-gradient(180deg,#5ec6c9,#4b79d8,#8a4df0);
            }
            
            .cx-page-subtitle{
                font-size:14px;
                color:#64748b;
                margin-left:16px;
            }
            
            /* DASHBOARD DONUT */
            .bb-donut-dashboard{
                display:flex;
                align-items:center;
                gap:24px;
            
                overflow-x:auto;
                overflow-y:hidden;
            
                padding-bottom:8px;
                margin-right:40px;
            
                -webkit-overflow-scrolling: touch;
            }
            
            /* scrollbar bonita */
            .bb-donut-dashboard::-webkit-scrollbar{
                height:6px;
            }
            .bb-donut-dashboard::-webkit-scrollbar-thumb{
                background: rgba(100,116,139,0.3);
                border-radius:10px;
            }
            
            /* CARD */
            .bb-donut-card{
                display:flex;
                flex-direction:column;
                align-items:center;
                flex: 0 0 auto; /* ESSENCIAL pro scroll funcionar */
            
                transition:transform .18s ease, filter .18s ease;
            }
            
            .bb-donut-card:hover{
                transform:translateY(-2px);
            }
            
            /* DONUT */
            .bb-donut{
                width:120px;
                height:120px;
                border-radius:50%;
                border:2px solid #f1f5f9;
                background:#e5e7eb;
            
                display:flex;
                align-items:center;
                justify-content:center;
            
                box-shadow:
                    0 6px 14px rgba(0,0,0,0.08),
                    inset 0 2px 4px rgba(255,255,255,0.7);
            
                transition: transform .25s ease, box-shadow .25s ease;
            
                position:relative;
            }
            
            .bb-donut-card:hover .bb-donut{
                transform:scale(1.04);
                box-shadow:
                    0 10px 20px rgba(0,0,0,0.12),
                    inset 0 2px 4px rgba(255,255,255,0.8);
            }
            
            .bb-donut::after{
                content:"";
                position:absolute;
                width:120px;
                height:120px;
                border-radius:50%;
                background:radial-gradient(circle at 30% 25%, rgba(255,255,255,0.35), transparent 60%);
                pointer-events:none;
            }
            
            /* INNER */
            .bb-donut-inner{
                width:78px;
                height:78px;
                background:white;
                border-radius:50%;
            
                display:flex;
                flex-direction:column;
                align-items:center;
                justify-content:center;
            
                box-shadow:
                    0 6px 12px rgba(0,0,0,0.10),
                    inset 0 1px 2px rgba(255,255,255,0.8);
            }
            
            .bb-donut-value{
                font-size:18px;
                font-weight:500;
                color:#64748b;
            }
            
            .bb-donut-label{
                font-size:11px;
                font-weight:600;
                color:#0f172a;
            }
            
            /* LEGEND */
            .bb-donut-legend{
                margin-top:10px;
                display:flex;
                gap:14px;
                font-size:12px;
                color:#64748b;
            }
            
            .bb-donut-legend span{
                display:flex;
                align-items:center;
                gap:4px;
                font-size:12px;
            }
            
            .bb-donut-legend .ok{
                color:#16a34a;
            }
            .bb-donut-legend .erro{
                color:#dc2626;
            }
            
            .bb-donut-legend .ok::before{
                content:"";
                width:8px;
                height:8px;
                border-radius:50%;
                background:#22c55e;
            }
            
            .bb-donut-legend .erro::before{
                content:"";
                width:8px;
                height:8px;
                border-radius:50%;
                background:#ef4444;
            }
            
            /* RESPONSIVO */
            @media (max-width: 768px){
            
                .cx-page-header{
                    grid-template-columns:1fr;
                    gap:20px;
                }
            
                .bb-donut-dashboard{
                    margin-right:0;
                }
            
            }
            ```
