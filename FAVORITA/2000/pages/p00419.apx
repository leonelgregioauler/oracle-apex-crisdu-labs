    region relatório-de-controle-sac-especial (
        name: Relatório de Controle SAC Especial
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct(c.idcontrolecontatossite)
                     , c.nomecompleto
                     , c.cpf
                     , c.datanascimento
                     , c.rua
                     , c.nr
                     , c.complemento
                     , c.bairro
                     , c.idcidade
                     , c.cidade
                     , c.cep
                     , c.fone
                     , c.fone2
                     , c.email
                     , c.mensagem
                     , c.observacao
                     , c.situacao
                     , c.descricaosituacao
                     , c.datacadastro
                     , c.idfilial
                     , c.filialromance
                     , c.idrepresentante
                     , c.nomerepresentante
                     , c.dataliberadofilial
                     , c.datapassadorepres
                     , c.observacaofilial
                     , c.origemdesc origem
                     , c.tipo
                     , c.tiposolicitacaosac
                     , c.idfilialorig
                     , c.filialromanceorigem
                     , c.idrepresentanteorig
                     , c.nomerepresentanteorigem
                     , c.idvendedoraorig
                     , c.nomevendedoraorigem
                     , c.cadastrado
                     , c.tiposolicitacaomanual
                     , c.cidademanual
                     , c.inadimplente
                     , c.nroconsultaspc
                     , c.usuariocadastrou
                     , c.cadastrosistema
                     , c.situacaocliente
                     , c.observacaorepresentante obsrepres
                from vw_controlecontatossite_fav c
                where nvl(c.idpais,1) = 1
                  and ( :P419_NRPROTOCOLO is null or c.idcontrolecontatossite = :P419_NRPROTOCOLO )
                  and ( :P419_IDCIDADE is null or c.idcidade = :P419_IDCIDADE )
                  and ( :P419_IDFILIALROMANCE is null or c.idfilial = :P419_IDFILIALROMANCE )     
                  and exists ( select 1
                               from roman.parametros pr
                               where pr.idfilial = c.idfilial
                                 and pr.nome     = 'ENVIOINDICACAOAUTOMATICA' 
                                 and pr.valor    = 'S' )
                  and trunc(datacadastro) >= to_date('01/11/2019','DD/MM/RRRR')
                  and :P419_TIPO_RELATORIO is not null
                  and exists ( select 1
                               from roman.cidades cc
                               where cc.idcidade = c.idcidade 
                                 and cc.idestado in (43,42,41,35,50,29,32,31,21,11,17,12,15,13,51,14,16,22) )
                  and ( :P419_TIPO_RELATORIO is null
                     or ( :P419_TIPO_RELATORIO = 'EA' and exists ( select 1
                                                                   from roman.classificacoessac cc
                                                                   where cc.idcontrolecontatossite = c.idcontrolecontatossite
                                                                     and cc.idcaracteristicasac    = 31 ) ) -- enviado automaticamente
                     or ( :P419_TIPO_RELATORIO = 'RJ' and c.situacao in ('Z','F') )
                     or ( :P419_TIPO_RELATORIO = 'CG' and c.situacao = 'G' )
                     or ( :P419_TIPO_RELATORIO = 'AR' and exists ( select 1
                                                                   from roman.classificacoessac cc
                                                                   where cc.idcontrolecontatossite = c.idcontrolecontatossite
                                                                     and cc.idcaracteristicasac    = 30 ) ) -- aguardando retorno empresa
                     or ( :P419_TIPO_RELATORIO = 'LE' and exists ( select 1
                                                                   from roman.classificacoessac cc
                                                                   where cc.idcontrolecontatossite = c.idcontrolecontatossite
                                                                     and cc.idcaracteristicasac    = 29 )
                                                      and situacao in ('C','E') ) ) -- limite excedido 
                order by 1 desc
                  
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                <font color="green"><h4>
                    - Enviado Automaticamente = Após Expirar o primeiro envio, é enviado automaticamente pelo sistema.
                    </h4></font>
                <font color="red"><h4>
                    - Aguardando Retorno = Encaminhada indicação para a Empresa analisar.
                    </h4></font>
                <font color="blue"><h4>
                    - Limite Excedido = Após ter sido enviado mais de 2 vezes para ser atendido. 
                    </h4></font>
                <font color="red"><h4>
                    - Rejeitado = Rejeitado pela Filial ou pelo Distribuidor(a).
                    </h4></font>
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum resultado obtido. Verifique os filtros!
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 3229349943688043635
        }

