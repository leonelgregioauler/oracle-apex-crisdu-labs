    region acompanhamento-detalhado (
        name: Acompanhamento Detalhado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select count(1) qtd
                     , ( select initcap(cc.descricao)
                         from roman.caracteristicassac cc
                         where cc.idcaracteristicasac = c.idcaracteristicasac ) descricao
                from roman.vw_classificacoessac c
                where ( :P330_IDCARACTERISTICA = -1 or c.idcaracteristicasac = :P330_IDCARACTERISTICA )
                  and ( :P330_ANO is null or extract ( year from c.dataclassificado ) = :P330_ANO )
                  and ( :P330_MES is null or to_char(c.dataclassificado,'MM') = :P330_MES )
                group by c.idcaracteristicasac
                order by 2
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P330_TIPO
            value: D
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum dado encontrado, verifique os Filtros utilizados!
        }
        advanced {
            savedReportMappingIdentifier: 1417199246568372527
        }

