    region origem-do-mês (
        name: Origem do Mês
        type: plugin/flotPieChart
        source {
            sqlQuery:
                ```sql
                select decode( sac.origem, 'SR', 'Site Romance',
                                           'SF', 'Site Favorita',
                                           'MF', 'Minha Favorita',
                                           'FR', 'Facebook Romance',
                                           'FF', 'Facebook Favorita',
                                           'TF', 'Telefone',
                                           'EM', 'E-mail',
                                           'LF', 'Loja Favorita',
                                           'WA', 'WhatsApp',
                                           'PV', 'Pos Venda',
                                           'CF', 'Campanha Facebook',
                                           'LN', 'Loja Natal'
                                               , 'Desconhecido') origem
                     , count(1) quantidade
                from roman.controlecontatossite sac
                where extract ( month from sac.datacadastro ) = to_char(sysdate,'MM')
                  and extract ( year from sac.datacadastro ) = to_char(sysdate,'RRRR')  
                group by sac.origem
                ```
        }
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: ORIGEM
            valueColumn: QUANTIDADE
            width: 600
        }
    )

    region origens-do-dia (
        name: Origens do Dia
        type: plugin/flotPieChart
        source {
            sqlQuery:
                ```sql
                select decode( sac.origem, 'SR', 'Site Romance',
                                           'SF', 'Site Favorita',
                                           'MF', 'Minha Favorita',
                                           'FR', 'Facebook Romance',
                                           'FF', 'Facebook Favorita',
                                           'TF', 'Telefone',
                                           'EM', 'E-mail',
                                           'LF', 'Loja Favorita',
                                           'WA', 'WhatsApp',
                                           'PV', 'Pos Venda',
                                           'CF', 'Campanha Facebook',
                                           'LN', 'Loja Natal'
                                               , 'Desconhecido') origem
                     , count(1) quantidade
                from roman.controlecontatossite sac
                where trunc(sac.datacadastro) = trunc(sysdate)
                group by sac.origem
                ```
        }
        layout {
            sequence: 100
            slot: body
            startNewRow: false
        }
        appearance {
