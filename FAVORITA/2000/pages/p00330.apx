    region classificações (
        name: Classificações
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(total.idfilial) filial
                     , total.qtd
                     , nvl(round((total.qtd/mesanterior.qtd)*100,2),0) crescimento
                     , nvl(aprovacoes.qtd,0) aprovacoes
                     , nvl(aprovadorestricao.qtd,0) aprovadorestricao
                     , nvl(encaminhado.qtd,0) encaminhados
                     , nvl(respondido.qtd,0) respondido
                     , nvl(foradearea.qtd,0) foradearea
                     , nvl(restricoes.qtd,0) restricoes
                     , nvl(debito.qtd,0) debito
                     , nvl(cadastro.qtd,0) novoscadastros
                     , nvl(ativo.qtd,0) ativo
                     , nvl(utilizado.qtd,0) utilizado
                     , nvl(rejeitado.qtd,0) rejeitado
                     , nvl(rejeitadodist.qtd,0) rejeitadodist
                     , nvl(inativo.qtd,0) inativo
                     , nvl(cadastradosemindicacao.qtd,0) cadastradosemindicacao
                from ( select c.idfilial 
                            , count(c.idcontrolecontatossite) qtd
                       from roman.controlecontatossite c 
                       where c.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' ) 
                         and idfilial is not null
                         and ( :P330_IDFILIAL is null or c.idfilial = :P330_IDFILIAL )
                       group by c.idfilial ) total
                   , ( select rc.idfilial 
                            , count(1) qtd
                       from roman.controlecontatossite rc
                       where rc.idfilial is not null
                         and ( :P330_IDFILIAL is null or rc.idfilial = :P330_IDFILIAL )
                         and rc.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' )-30 and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )-30
                       group by rc.idfilial ) mesanterior 
                   , ( select count(1) qtd
                            , c.idfilial
                       from roman.controlecontatossite c
                          , roman.classificacoessac cc
                       where c.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss') and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss')
                         and cc.idcontrolecontatossite = c.idcontrolecontatossite
                         and cc.idcaracteristicasac = 2
                         and cc.dataclassificado between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss')
                      group by c.idfilial ) aprovacoes 
                   , ( select count(1) qtd
                            , c.idfilial
                       from roman.controlecontatossite c
                          , roman.classificacoessac cc
                       where c.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss') and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss')
                         and cc.idcontrolecontatossite = c.idcontrolecontatossite
                         and cc.idcaracteristicasac = 19
                         and cc.dataclassificado between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss')
                      group by c.idfilial ) aprovadorestricao
                   , ( select count(1) qtd
                            , c.idfilial
                       from roman.controlecontatossite c
                          , roman.classificacoessac cc
                       where c.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss') and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss')
                         and cc.idcontrolecontatossite = c.idcontrolecontatossite
                         and cc.idcaracteristicasac = 0
                         and cc.dataclassificado between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss')
                      group by c.idfilial ) encaminhado
                   , ( select count(1) qtd
                            , c.idfilial
                       from roman.controlecontatossite c
                          , roman.classificacoessac cc
                       where c.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss') and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss')
                         and cc.idcontrolecontatossite = c.idcontrolecontatossite
                         and cc.idcaracteristicasac = 3
                         and cc.dataclassificado between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss')
                      group by c.idfilial ) foradearea
                   , ( select count(1) qtd
                            , c.idfilial
                       from roman.controlecontatossite c
                       where c.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' ) 
                         and exists ( select 1
                                      from logroman.log_controlecontatossite lc
                                      where lc.idcontrolecontatossite = c.idcontrolecontatossite
                                        and lc.situacao               = 'S'
                                        and lc.dataalteracao between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )+10 )
                       group by c.idfilial ) restricoes
                   , ( select count(1) qtd
                            , c.idfilial
                       from roman.controlecontatossite c
                       where c.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' ) 
                         and exists ( select 1
                                      from logroman.log_controlecontatossite lc
                                      where lc.idcontrolecontatossite = c.idcontrolecontatossite
                                        and lc.situacao               = 'R'
                                        and lc.dataalteracao between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )+10 )
                       group by c.idfilial ) respondido 
                   , ( select count(1) qtd
                            , c.idfilial
                       from roman.controlecontatossite c
                          , roman.classificacoessac cc
                       where c.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss') and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss')
                         and cc.idcontrolecontatossite = c.idcontrolecontatossite
                         and cc.idcaracteristicasac = 7
                         and cc.dataclassificado between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss')
                      group by c.idfilial ) debito
                   , ( select count(1) qtd
                            , v.idfilial
                       from vendedoras v
                       where exists ( select 1
                                      from logcatal.log_vendedoras lv
                                      where lv.idvendedora = v.idvendedora
                                        and lv.tipoalteracao = 'INSERT'
                                        and lv.dataalteracao between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' ) )
                       group by v.idfilial ) cadastro
                   , ( select count(1) qtd
                            , v.idfilial
                       from vendedoras v
                       where exists ( select 1
                                      from logcatal.log_vendedoras lv
                                      where lv.idvendedora = v.idvendedora
                                        and lv.tipoalteracao = 'INSERT' )
                         and exists ( select 1
                                      from roman.controlecontatossite cc
                                         , pessoas pp
                                      where pp.idpessoa = v.idpessoa
                                        and replace(replace(cc.cpf,'-',''),'.','') = pp.cpf
                                        and cc.situacao not in ('R','U')
                                        and cc.idrepresentante is not null
                                        and cc.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )
                                        and cc.idfilial is not null ) 
                       group by v.idfilial ) cadastradosemindicacao
                   , ( select count(1) qtd
                            , c.idfilial
                       from roman.controlecontatossite c
                       where c.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )
                         and exists ( select 1
                                      from logroman.log_controlecontatossite lc
                                      where lc.idcontrolecontatossite = c.idcontrolecontatossite
                                        and lc.situacao               = 'A'
                                        and lc.dataalteracao between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )+10 )
                       group by c.idfilial ) ativo 
                   , ( select count(1) qtd
                            , c.idfilial
                       from roman.controlecontatossite c
                       where c.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )
                         and exists ( select 1
                                      from logroman.log_controlecontatossite lc
                                      where lc.idcontrolecontatossite = c.idcontrolecontatossite
                                        and lc.situacao               = 'F' )
                       group by c.idfilial ) rejeitado  
                   , ( select count(1) qtd
                            , c.idfilial
                       from roman.controlecontatossite c
                       where c.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )
                         and exists ( select 1
                                      from logroman.log_controlecontatossite lc
                                      where lc.idcontrolecontatossite = c.idcontrolecontatossite
                                        and lc.situacao               in ('U','R')
                                        and lc.datapassadorepres      is not null
                                        and lc.idrepresentante        is not null
                                        and lc.dataalteracao between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )+10 )
                       group by c.idfilial ) utilizado 
                    , ( select count(1) qtd
                            , c.idfilial
                       from roman.controlecontatossite c
                       where c.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )
                         and exists ( select 1
                                      from logroman.log_controlecontatossite lc
                                      where lc.idcontrolecontatossite = c.idcontrolecontatossite
                                        and lc.situacao               in ('Z','X') )
                       group by c.idfilial ) rejeitadodist
                    , ( select count(1) qtd
                            , c.idfilial
                       from roman.controlecontatossite c
                       where c.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )
                         and exists ( select 1
                                      from logcatal.log_vendedoras lv
                                         , pessoas p
                                      where lv.idpessoa = p.idpessoa
                                        and p.cpf = replace(replace(replace(c.cpf,'.',''),'-',''),' ','')
                                        and lv.ativo = 'N'
                                        and lv.dataalteracao between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' ) )
                       group by c.idfilial ) inativo
                where mesanterior.idfilial(+)            = total.idfilial
                  and aprovacoes.idfilial(+)             = total.idfilial
                  and aprovadorestricao.idfilial(+)      = total.idfilial
                  and foradearea.idfilial(+)             = total.idfilial
                  and restricoes.idfilial(+)             = total.idfilial
                  and debito.idfilial(+)                 = total.idfilial
                  and cadastro.idfilial(+)               = total.idfilial
                  and cadastradosemindicacao.idfilial(+) = total.idfilial
                  and encaminhado.idfilial(+)            = total.idfilial
                  and respondido.idfilial(+)             = total.idfilial
                  and ativo.idfilial(+)                  = total.idfilial
                  and utilizado.idfilial(+)              = total.idfilial
                  and rejeitado.idfilial(+)              = total.idfilial
                  and rejeitadodist.idfilial(+)          = total.idfilial
                  and inativo.idfilial(+)                = total.idfilial
                union
                select 'Sem Filial'
                     , total.qtd
                     , null
                     , nvl(aprovacoes.qtd,0) aprovacoes
                     , nvl(aprovadorestricao.qtd,0) aprovadorestricao
                     , nvl(encaminhado.qtd,0) encaminhados
                     , nvl(respondido.qtd,0) respondido
                     , nvl(foradearea.qtd,0) foradearea
                     , nvl(restricoes.qtd,0) restricoes
                     , nvl(debito.qtd,0) debito
                     , null
                     , nvl(ativo.qtd,0) ativo
                     , nvl(utilizado.qtd,0) utilizado
                     , nvl(rejeitado.qtd,0) rejeitado
                     , nvl(rejeitadodist.qtd,0) rejeitadodist
                     , nvl(inativo.qtd,0) inativo
                     , null
                from ( select count(distinct c.idcontrolecontatossite) qtd
                       from roman.controlecontatossite c 
                       where c.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )  
                         and idfilial is null
                         and ( :P330_IDFILIAL is null or c.idfilial = :P330_IDFILIAL )
                       group by c.idfilial ) total
                   , ( select count(distinct c.idcontrolecontatossite) qtd
                            , c.idfilial
                       from roman.controlecontatossite c
                       where c.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )
                         and idfilial is null
                         and exists ( select 1
                                      from logroman.log_controlecontatossite lc
                                      where lc.idcontrolecontatossite = c.idcontrolecontatossite
                                        and lc.situacao               = 'C'
                                        and lc.dataalteracao between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )+10 ) ) aprovacoes 
                   , ( select count(distinct c.idcontrolecontatossite) qtd
                       from roman.controlecontatossite c
                       where c.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )
                         and exists ( select 1
                                      from logroman.log_controlecontatossite lc
                                      where lc.idcontrolecontatossite = c.idcontrolecontatossite
                                        and lc.situacao               = 'B'
                                        and lc.dataalteracao between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )+10 )
                         and idfilial is null ) aprovadorestricao
                   , ( select count(distinct c.idcontrolecontatossite) qtd
                       from roman.controlecontatossite c
                       where c.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' ) 
                         and exists ( select 1
                                      from logroman.log_controlecontatossite lc
                                      where lc.idcontrolecontatossite = c.idcontrolecontatossite
                                        and lc.situacao               = 'E'
                                        and lc.dataalteracao between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )+10)
                         and not exists ( select 1
                                          from logroman.log_controlecontatossite lcc
                                          where lcc.idcontrolecontatossite = c.idcontrolecontatossite
                                            and lcc.situacao               = 'C'
                                            and lcc.dataalteracao between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )+10)
                         and idfilial is null ) encaminhado
                   , ( select count(distinct c.idcontrolecontatossite) qtd
                       from roman.controlecontatossite c
                       where c.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' ) 
                         and exists ( select 1
                                      from logroman.log_controlecontatossite lc
                                      where lc.idcontrolecontatossite = c.idcontrolecontatossite
                                        and lc.situacao               = 'N'
                                        and lc.dataalteracao between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )+10 )
                         and idfilial is null ) foradearea
                   , ( select count(distinct c.idcontrolecontatossite) qtd
                       from roman.controlecontatossite c
                       where c.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' ) 
                         and exists ( select 1
                                      from logroman.log_controlecontatossite lc
                                      where lc.idcontrolecontatossite = c.idcontrolecontatossite
                                        and lc.situacao               = 'S'
                                        and lc.dataalteracao between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )+10 )
                         and idfilial is null ) restricoes
                   , ( select count(distinct c.idcontrolecontatossite) qtd
                       from roman.controlecontatossite c
                       where c.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' ) 
                         and exists ( select 1
                                      from logroman.log_controlecontatossite lc
                                      where lc.idcontrolecontatossite = c.idcontrolecontatossite
                                        and lc.situacao               = 'R'
                                        and lc.dataalteracao between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )+10 )
                         and idfilial is null ) respondido 
                   , ( select count(distinct c.idcontrolecontatossite) qtd
                       from roman.controlecontatossite c
                       where c.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' ) 
                         and exists ( select 1
                                      from logroman.log_controlecontatossite lc
                                      where lc.idcontrolecontatossite = c.idcontrolecontatossite
                                        and lc.situacao               = 'D'
                                        and lc.dataalteracao between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )+10 )
                         and idfilial is null ) debito
                   , ( select count(distinct c.idcontrolecontatossite) qtd
                       from roman.controlecontatossite c
                       where c.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )
                         and exists ( select 1
                                      from logroman.log_controlecontatossite lc
                                      where lc.idcontrolecontatossite = c.idcontrolecontatossite
                                        and lc.situacao               = 'A'
                                        and lc.dataalteracao between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )+10 )
                         and idfilial is null ) ativo 
                   , ( select count(distinct c.idcontrolecontatossite) qtd
                       from roman.controlecontatossite c
                       where c.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )
                         and exists ( select 1
                                      from logroman.log_controlecontatossite lc
                                      where lc.idcontrolecontatossite = c.idcontrolecontatossite
                                        and lc.situacao               = 'F' )
                         and idfilial is null ) rejeitado  
                   , ( select count(distinct c.idcontrolecontatossite) qtd
                       from roman.controlecontatossite c
                       where c.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )
                         and exists ( select 1
                                      from logroman.log_controlecontatossite lc
                                      where lc.idcontrolecontatossite = c.idcontrolecontatossite
                                        and lc.situacao               in ('U','R')
                                        and lc.datapassadorepres      is not null
                                        and lc.idrepresentante        is not null
                                        and lc.dataalteracao between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )+10 )
                         and idfilial is null ) utilizado 
                    , ( select count(distinct c.idcontrolecontatossite) qtd
                       from roman.controlecontatossite c
                       where c.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )
                         and exists ( select 1
                                      from logroman.log_controlecontatossite lc
                                      where lc.idcontrolecontatossite = c.idcontrolecontatossite
                                        and lc.situacao               in ('Z','X') )
                         and idfilial is null ) rejeitadodist
                    , ( select count(distinct c.idcontrolecontatossite) qtd
                       from roman.controlecontatossite c
                       where c.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )
                         and exists ( select 1
                                      from logcatal.log_vendedoras lv
                                         , pessoas p
                                      where lv.idpessoa = p.idpessoa
                                        and p.cpf = replace(replace(replace(c.cpf,'.',''),'-',''),' ','')
                                        and lv.ativo = 'N'
                                        and lv.dataalteracao between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' ) )
                         and idfilial is null ) inativo
                order by 1
                ```
        }
        layout {
            sequence: 10
            parentRegion: @acompanhamento-por-empresa
            slot: subRegions
        }
