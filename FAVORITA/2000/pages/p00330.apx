        }
    )

    pageItem P330_ORIGEM (
        type: selectList
        label {
            label: Origem
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Site Romance;SR,Site Favorita;SF,Minha Favorita;MF,Facebook Romance;FR,Facebook Favorita;FF,Telefone;TF,E-mail;EM,Loja Favorita;LF,WhatsApp;WA,Campanha Facebook;CF,Pós Venda;PV,Loja Natal;LN
            nullDisplayValue: Todos
        }
        layout {
            sequence: 100
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        default {
            type: expression
            plsqlExpression: null
        }
