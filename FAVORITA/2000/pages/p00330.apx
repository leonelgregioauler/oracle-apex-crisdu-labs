    region acompanhamento-por-ano (
        name: Acompanhamento por Ano
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select null link
                     , to_number(to_char(datacadastro,'MM')) mes
                     , count(1) "2020"
                from roman.controlecontatossite c
                where extract( year from c.datacadastro) = 2020
                group by to_number(to_char(datacadastro,'RRRR')) 
                       , to_number(to_char(datacadastro,'MM'))
                order by to_number(to_char(datacadastro,'RRRR')) 
                       , to_number(to_char(datacadastro,'MM'))
