    region qtd-por-hora-do-dia-atual (
        name: QTD por Hora do dia Atual
        type: chart
        layout {
            sequence: 110
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
