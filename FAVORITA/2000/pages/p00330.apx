    branch (
        name: Go To Page 330
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 330
                items: {
                    P330_TIPO: &P330_TIPO.
                    P330_MES: &P330_MES.
                    P330_SEMANA: &P330_SEMANA.
                    P330_IDCARACTERISTICA: &P330_IDCARACTERISTICA.
                    P330_ANO: &P330_ANO.
                    P330_DATAINICIO: &P330_DATAINICIO.
                    P330_DATAFIM: &P330_DATAFIM.
                    P330_IDFILIAL: &P330_IDFILIAL.
                    P330_ORIGEM: &P330_ORIGEM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

