        series por-mês-qtd (
            name: Por mês Qtd
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select m.mes           mes
                         , o.nome          nome
                         , o.quantidade    quantidade
                    from roman.meses m
                       , (  select 'Total' nome
                                 , to_number(to_char(c.datacadastro,'MM')) mes
                                 , count(1) quantidade
                            from roman.controlecontatossite c
                            where extract (year from c.datacadastro) = :P330_ANO
                            group by  to_number(to_char(c.datacadastro,'MM'))  ) o
                    where m.numero  = o.mes(+)
                    order by m.numero
                    ```
            }
            columnMapping {
                seriesName: NOME
                label: MES
                value: QUANTIDADE
                customColumn: NOME
            }
            label {
                show: true
            }
