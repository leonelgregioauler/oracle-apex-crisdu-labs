    region acompanhamento-por-origem (
        name: Acompanhamento por Origem
        type: plugin/d3LineChart
        source {
            sqlQuery:
                ```sql
                select decode(c.origem , 'SR', 'Site Romance',
                                         'SF', 'Site Favorita',
                                         'MF', 'Minha Favorita',
                                         'FR', 'Facebook Romance',
                                         'FF', 'Facebook Favorita',
                                         'TF', 'Telefone',
                                         'EM', 'E-mail',
                                         'LF', 'Loja Favorita',
                                         'WA', 'WhatsApp',
                                         'PV', 'Pós Venda',
                                         'CF', 'Campanha Facebook',
                                         'LN', 'Loja Natal', 'Desconhecido' ) origem
                     , to_char(c.datacadastro,'DAY') dia
                     , to_number(to_char(c.datacadastro,'DAY', 'NLS_DATE_LANGUAGE=''numeric date language''')) sequencia
                     , count(1) qtd
                from roman.controlecontatossite c
                where trunc(c.datacadastro) between trunc(sysdate)-10 and trunc(sysdate)
                group by c.origem
                       , to_char(c.datacadastro,'DAY')
                       , to_char(c.datacadastro,'DAY', 'NLS_DATE_LANGUAGE=''numeric date language''')
                order by to_char(c.datacadastro,'DAY', 'NLS_DATE_LANGUAGE=''numeric date language''')
                ```
        }
        layout {
            sequence: 160
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            xValuesColumn: SEQUENCIA
            yValuesColumn: QTD
            multipleSeriesColumn: ORIGEM
            xAxisValueFormatMask: 144k
            yAxisValueFormatMask: 144k
            tooltips: [
                showSeriesName
                showXValue
                showYValue
                customColumn
            ]
            tooltipColumn: DIA
            legend: aboveChart
            showGridLines: yAxis
            colorScheme: metro
            heightMeasure: includeLabels
        }
    )

    region acompanhamento-por-origem-2 (
        name: Acompanhamento por Origem
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select count(1) qtd
                     , decode( c.origem, 'SR', 'Site Romance',
                                           'SF', 'Site Favorita',
                                           'MF', 'Minha Favorita',
                                           'FR', 'Facebook Romance',
                                           'FF', 'Facebook Favorita',
                                           'TF', 'Telefone',
                                           'EM', 'E-mail',
                                           'LF', 'Loja Favorita',
                                           'WA', 'WhatsApp',
                                           'PV', 'Pos Venda',
                                           'CF', 'Campanha Facebook',
                                           'LN', 'Loja Natal'
                                           , 'Desconhecido' ) origem
                from roman.controlecontatossite c
                where ( :P330_ANO is null or extract ( year from c.datacadastro ) = :P330_ANO )
                  and ( :P330_MES is null or to_char(c.datacadastro,'MM') = :P330_MES )
                group by c.origem
                order by 2
                ```
