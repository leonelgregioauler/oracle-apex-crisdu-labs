    region últimos-dias (
        name: Últimos Dias
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select to_char(c.datacadastro,'DD/MM/RRRR') datacadastro 
                     , c.qtd
                from ( select count(1) qtd
                            , trunc(c.datacadastro) datacadastro
                       from roman.controlecontatossite c
                       group by trunc(c.datacadastro)
                       order by 2 desc) c
                where rownum <= 10
                order by datacadastro
                ```
        }
        layout {
            sequence: 140
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            labelColumn: DATACADASTRO
            valueColumn: QTD
            colorScheme: modern2
            maximumRows: 10
        }
    )

    pageItem P330_ANO (
        type: numberField
        label {
            label: Ano
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        default {
            type: expression
            plsqlExpression: to_char(sysdate,'RRRR')
        }
        security {
            encryptSessionState: false
        }
    )

