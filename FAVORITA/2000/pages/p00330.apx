    region acompanhamento-diário (
        name: Acompanhamento Diário
        type: chart
        layout {
            sequence: 130
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chartAppearance {
            orientation: horizontal
            stack: true
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        animation {
            onDataChange: none
        }
        legend {
            show: false
        }
        autoRefresh {
            interval: 10
        }

        series diário (
            name: Diário
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT ( select initcap(cc.descricao)
                             from roman.caracteristicassac cc
                             where cc.idcaracteristicasac = cf.idcaracteristicasac ) caracteristica
                         , count(1) "TOTAL DO DIA"
                         , ROUND(RATIO_TO_REPORT(count(1)) OVER(PARTITION BY TRUNC(cf.dataclassificado)) * 100,2) "%DO DIA"
                    FROM roman.vw_classificacoessac cf 
                    where trunc(cf.dataclassificado) = trunc(sysdate)
                    GROUP BY cf.idcaracteristicasac, TRUNC(cf.dataclassificado)
                    ORDER BY 2 ASC, idcaracteristicasac;
                    ```
            }
            columnMapping {
                label: CARACTERISTICA
                value: TOTAL DO DIA
                z: %DO DIA
            }
            label {
                show: true
            }
        )

        axis x (
            name: x
            title: Classificação
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Quantidade
            minorTicks {
                show: false
            }
        )

        axis y-1 (
            name: y2
            showAxis: false
            minorTicks {
                show: false
            }
        )

    )

    region acompanhamento-mensal (
        name: Acompanhamento Mensal
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select total.qtd "Total Cadastros"
                     , aprovado.qtd "Aprovados"
                     , to_char((aprovado.qtd/total.qtd)*100,'999G999G999G999G990D00') "% Aprovados" 
                     , encaminhado.qtd "Encaminhados"
                     , to_char((encaminhado.qtd/total.qtd)*100,'999G999G999G999G990D00') "% Encaminhados"
                     , respondido.qtd "Respondidos"
                     , to_char((respondido.qtd/total.qtd)*100,'999G999G999G999G990D00') "% Respondidos"
                     , restricoes.qtd "Restrições"
                     , to_char((restricoes.qtd/total.qtd)*100,'999G999G999G999G990D00') "% Restrições"
                     , cliente.qtd "Quer ser Cliente"
                     , to_char((cliente.qtd/total.qtd)*100,'999G999G999G999G990D00') "% Quer ser Cliente"
                     , distribuidor.qtd "Quer ser Distribuidor"
                     , to_char((distribuidor.qtd/total.qtd)*100,'999G999G999G999G990D00') "% Quer ser Distribuidor"
                     , reclamacao.qtd "Reclamações"
                     , to_char((reclamacao.qtd/total.qtd)*100,'999G999G999G999G990D00') "% Reclamações"
                     , troca.qtd "Troca de Distribuidores"
                     , to_char((troca.qtd/total.qtd)*100,'999G999G999G999G990D00') "% Troca de Distribuidores"
                from ( select count(1) qtd
                       from roman.controlecontatossite c
                       where ( :P330_MES is null or to_char(c.datacadastro,'MM') = :P330_MES )
                         and extract( year from c.datacadastro ) = :P330_ANO ) total
                   , ( select count(1) qtd
                       from roman.classificacoessac cc
                       where ( :P330_MES is null or to_char(cc.dataclassificado,'MM') = :P330_MES )
                         and cc.idcaracteristicasac = 2
                         and extract( year from cc.dataclassificado ) = :P330_ANO ) aprovado
                   , ( select count(1) qtd
                       from roman.classificacoessac cc
                       where ( :P330_MES is null or to_char(cc.dataclassificado,'MM') = :P330_MES )
                         and cc.idcaracteristicasac = 0
                         and extract( year from cc.dataclassificado ) = :P330_ANO ) encaminhado
                   , ( select count(1) qtd
                       from roman.classificacoessac cc
                       where ( :P330_MES is null or to_char(cc.dataclassificado,'MM') = :P330_MES )
                         and cc.idcaracteristicasac = 13
                         and extract( year from cc.dataclassificado ) = :P330_ANO ) respondido
                   , ( select count(1) qtd
                       from roman.classificacoessac cc
                       where ( :P330_MES is null or to_char(cc.dataclassificado,'MM') = :P330_MES )
                         and cc.idcaracteristicasac = 1
                         and extract( year from cc.dataclassificado ) = :P330_ANO ) restricoes
                   , ( select count(1) qtd
                       from roman.classificacoessac cc
                       where ( :P330_MES is null or to_char(cc.dataclassificado,'MM') = :P330_MES )
                         and cc.idcaracteristicasac = 14
                         and extract( year from cc.dataclassificado ) = :P330_ANO ) cliente
                   , ( select count(1) qtd
                       from roman.classificacoessac cc
                       where ( :P330_MES is null or to_char(cc.dataclassificado,'MM') = :P330_MES )
                         and cc.idcaracteristicasac = 11
                         and extract( year from cc.dataclassificado ) = :P330_ANO ) distribuidor
                   , ( select count(1) qtd
                       from roman.classificacoessac cc
                       where ( :P330_MES is null or to_char(cc.dataclassificado,'MM') = :P330_MES )
                         and cc.idcaracteristicasac = 10
                         and extract( year from cc.dataclassificado ) = :P330_ANO ) reclamacao
                   , ( select count(1) qtd
                       from roman.classificacoessac cc
                       where ( :P330_MES is null or to_char(cc.dataclassificado,'MM') = :P330_MES )
                         and cc.idcaracteristicasac = 8
                         and extract( year from cc.dataclassificado ) = :P330_ANO ) troca
                where :P330_ANO is not null
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P330_TIPO
            value: M
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1417037290405961933
        }

