        series por-hora-qtd (
            name: Por hora Qtd
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select h.hora
                         , o.nome          nome
                         , o.quantidade    quantidade
                    from roman.horas h
                       , (  select 'Total' nome
                                 , to_number(to_char(c.datacadastro,'HH24')) hora
                                 , count(1) quantidade
                            from roman.controlecontatossite c
                            where trunc(c.datacadastro) = trunc(sysdate)
                            group by  to_number(to_char(c.datacadastro,'HH24'))  ) o
                    where h.hora  = o.hora(+)
                    order by 1
                    ```
            }
            columnMapping {
                seriesName: NOME
                label: HORA
                value: QUANTIDADE
            }
            label {
                show: true
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            minorTicks {
                show: false
            }
        )

    )

