            labelColumn: ORIGEM
            valueColumn: QUANTIDADE
            width: 600
        }
    )

    region por-estado-brasil (
        name: Por Estado (Brasil)
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select ( select e.nome||'/'||e.sigla
                         from roman.estados e
                         where e.idestado = cc.idestado ) estado
                     , count(distinct c.idcontrolecontatossite) qtd
                from roman.controlecontatossite c
                   , catal.cidades cc
                where extract ( month from c.datacadastro ) = :P330_MES
                  and extract ( year from c.datacadastro ) = :P330_ANO
                  and c.idcidade is not null
                  and cc.idcidade = c.idcidade
                  and cc.idestado is not null
                  and c.idpais = 1
                group by cc.idestado
                union
                select 'Sem Cidade (LEADS FACEBOOK)'
                     , count(distinct c.idcontrolecontatossite) qtd
                from roman.controlecontatossite c
                where extract ( month from c.datacadastro ) = :P330_MES
                  and extract ( year from c.datacadastro ) = :P330_ANO
                  and c.idcidade is null
                  and c.idpais = 1
                order by 2 desc
                ```
        }
        layout {
            sequence: 20
            parentRegion: @origem
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        settings {
            labelColumn: ESTADO
            valueColumn: QTD
            colorScheme: modern2
            maximumRows: 30
        }
    )

    region por-origem-nos-últimos-30-dias (
        name: Por Origem nos últimos 30 dias
        type: plugin/html5BarChart
        source {
            sqlQuery:
                ```sql
                select decode(c.origem, 'SR', 'Site Romance',
                                        'SF', 'Site Favorita',
                                        'MF', 'Minha Favorita',
                                        'FR', 'Facebook Romance',
                                        'FF', 'Facebook Favorita',
                                        'TF', 'Telefone',
                                        'EM', 'E-mail',
                                        'LF', 'Loja Favorita',
                                        'WA', 'WhatsApp',
                                        'PV', 'Pós Venda',
                                        'CF', 'Campanha Facebook',
                                        'LN', 'Loja Natal', 'Desconhecida') origem
                     , c.qtd
                from ( select count(1) qtd
                            , origem 
                       from roman.controlecontatossite 
                       where trunc(datacadastro) between trunc(sysdate)-30 and trunc(sysdate) 
                       group by origem ) c
                order by 2 desc
                ```
        }
        layout {
            sequence: 150
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
