    region quantidade-de-cadastros (
        name: Quantidade de Cadastros
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(c.idfilial) filial
                     , count(1) qtd
                from roman.controlecontatossite c 
                where c.idfilial is not null
                  and c.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )
                  and ( :P330_IDFILIAL is null or c.idfilial = :P330_IDFILIAL )
                GROUP BY ROLLUP (c.idfilial)
                union
                select ' - Sem Encaminhamento - '
                     , count(1) qtd
                from roman.controlecontatossite c 
                where c.idfilial is null
                  and c.situacao in ('E','C','B')
                  and c.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )
                union
                select ' - Pendentes Sem Empresa - '
                     , count(1) qtd
                from roman.controlecontatossite c 
                where c.idfilial is null
                  and c.situacao = 'P'
                  and c.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )
                union
                select ' - Cadastrado Sem Indicação - '
                     , count(1) qtd
                from roman.controlecontatossite c 
                where c.situacao = 'T'
                  and c.datacadastro between to_date(:P330_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss' ) and to_date(:P330_DATAFIM||' 23:59:59','dd/mm/rrrr hh24:mi:ss' )
                ```
        }
        layout {
            sequence: 20
            parentRegion: @acompanhamento-por-empresa
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
