            encryptSessionState: false
        }
    )

    pageItem P330_SEMANA (
        type: selectList
        label {
            label: Semana
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(s.semana,'00')||'/'||s.ano||' - '||to_char(s.dt_ini,'DD/MM')||' ate '||to_char(s.dt_fim,'DD/MM') display_value
                     , s.idsemana return_value
                from semana_dias s
                where s.ano between to_char(sysdate,'RRRR')-1 and to_char(sysdate,'RRRR')+1
                order by s.idsemana desc
                ```
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P330_TIPO (
        type: radioGroup
        label {
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Mensal;M,Semanal;S,Detalhado;D,Empresa;E,Restrições;R
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        source {
            used: always
        }
        default {
            type: static
            staticValue: M
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 110
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction escolha-do-tipo (
        name: Escolha do Tipo
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P330_TIPO
        }
        clientSideCondition {
            type: item=value
            item: P330_TIPO
            value: M
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P330_SEMANA
                    P330_IDCARACTERISTICA
                    P330_DATAINICIO
                    P330_DATAFIM
                    P330_IDFILIAL
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P330_MES
                    P330_ANO
                    P330_ORIGEM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

