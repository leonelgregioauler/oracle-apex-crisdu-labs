    region acompanhamento-semanal (
        name: Acompanhamento Semanal
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Abril' "Mês"
                     , total.qtd "Total Cadastros"
                     , aprovado.qtd "Aprovados"
                     , to_char((aprovado.qtd/total.qtd)*100,'999G999G999G999G990D00') "% Aprovados" 
                     , encaminhado.qtd "Encaminhados"
                     , to_char((encaminhado.qtd/total.qtd)*100,'999G999G999G999G990D00') "% Encaminhados"
                     , respondido.qtd "Respondidos"
                     , to_char((respondido.qtd/total.qtd)*100,'999G999G999G999G990D00') "% Respondidos"
                     , restricoes.qtd "Restrições"
                     , to_char((restricoes.qtd/total.qtd)*100,'999G999G999G999G990D00') "% Restrições"
                     , cliente.qtd "Quer ser Cliente"
                     , to_char((cliente.qtd/total.qtd)*100,'999G999G999G999G990D00') "% Quer ser Cliente"
                     , distribuidor.qtd "Quer ser Distribuidor"
                     , to_char((distribuidor.qtd/total.qtd)*100,'999G999G999G999G990D00') "% Quer ser Distribuidor"
                     , reclamacao.qtd "Reclamações"
                     , to_char((reclamacao.qtd/total.qtd)*100,'999G999G999G999G990D00') "% Reclamações"
                     , troca.qtd "Troca de Distribuidores"
                     , to_char((troca.qtd/total.qtd)*100,'999G999G999G999G990D00') "% Troca de Distribuidores"
                from ( select count(1) qtd
                       from roman.controlecontatossite c
                       where c.idsemana = :P330_SEMANA
                         and extract( year from c.datacadastro ) = '2018' ) total
                   , ( select count(1) qtd
                       from roman.controlecontatossite c
                       where c.idsemana = :P330_SEMANA
                         and extract( year from c.datacadastro ) = '2018' 
                         and exists ( select 1
                                      from logroman.log_controlecontatossite cc
                                      where cc.idcontrolecontatossite = c.idcontrolecontatossite
                                        and cc.situacao               = 'A' ) ) aprovado
                   , ( select count(1) qtd
                       from roman.controlecontatossite c
                       where c.idsemana = :P330_SEMANA
                         and extract( year from c.datacadastro ) = '2018' 
                         and exists ( select 1
                                      from logroman.log_controlecontatossite cc
                                      where cc.idcontrolecontatossite = c.idcontrolecontatossite
                                        and cc.situacao               = 'E' ) ) encaminhado
                   , ( select count(1) qtd
                       from roman.controlecontatossite c
                       where c.idsemana = :P330_SEMANA
                         and extract( year from c.datacadastro ) = '2018' 
                         and exists ( select 1
                                      from logroman.log_controlecontatossite cc
                                      where cc.idcontrolecontatossite = c.idcontrolecontatossite
                                        and cc.situacao               = 'R' ) ) respondido
                   , ( select count(1) qtd
                       from roman.controlecontatossite c
                       where c.idsemana = :P330_SEMANA
                         and extract( year from c.datacadastro ) = '2018' 
                         and c.situacao = 'S' ) restricoes
                   , ( select count(1) qtd
                       from roman.controlecontatossite c
                       where c.idsemana = :P330_SEMANA
                         and extract( year from c.datacadastro ) = '2018' 
                         and c.tipo = 2 ) cliente
                   , ( select count(1) qtd
                       from roman.controlecontatossite c
                       where c.idsemana = :P330_SEMANA
                         and extract( year from c.datacadastro ) = '2018' 
                         and c.tipo = 1 ) distribuidor
                   , ( select count(1) qtd
                       from roman.controlecontatossite c
                       where c.idsemana = :P330_SEMANA
                         and extract( year from c.datacadastro ) = '2018' 
                         and c.tipo = 3 ) reclamacao
                   , ( select count(1) qtd
                       from roman.controlecontatossite c
                       where c.idsemana = :P330_SEMANA
                         and extract( year from c.datacadastro ) = '2018' 
                         and c.tipo = 6 ) troca
                where :P330_SEMANA is not null
                
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P330_TIPO
            value: S
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1417196674466372501
        }

