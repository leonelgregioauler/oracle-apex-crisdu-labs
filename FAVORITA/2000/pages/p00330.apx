    region acompanhamento-mensal-de-cadastros-existentes (
        name: Acompanhamento Mensal de Cadastros Existentes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select total.qtd "Total Cadastros"
                     , debito.qtd "Debitos"
                     , to_char((debito.qtd/total.qtd)*100,'999G999G999G999G990D00') "% Debitos" 
                     , ativo.qtd "Ativos"
                     , to_char((ativo.qtd/total.qtd)*100,'999G999G999G999G990D00') "% Ativos"
                     , inativo.qtd "Inativos"
                     , to_char((inativo.qtd/total.qtd)*100,'999G999G999G999G990D00') "% Inativos"
                from ( select count(1) qtd
                       from roman.controlecontatossite c
                       where ( :P330_MES is null or to_char(c.datacadastro,'MM') = :P330_MES )
                         and ( :P330_ORIGEM is null or c.origem = :P330_ORIGEM )
                         and extract( year from c.datacadastro ) = :P330_ANO ) total
                   , ( select count(1) qtd 
                       from roman.controlecontatossite c
                          , pessoas p
                          , vendedoras v
                       where replace(replace(replace(c.cpf,'.',''),'-',''),' ','') = p.cpf
                         and v.idpessoa = p.idpessoa
                         and exists ( select 1
                                      from roman.notasvendas nv
                                      where nv.idvendedora = v.idvendedora
                                        and nv.idsituacaonotavenda = 4
                                        and nv.saldo > 0 )
                         and ( :P330_ORIGEM is null or c.origem = :P330_ORIGEM )
                         and ( :P330_MES is null or to_char(c.datacadastro,'MM') = :P330_MES )
                         and extract( year from c.datacadastro ) = :P330_ANO ) debito
                   , ( select count(1) qtd 
                       from roman.controlecontatossite c
                          , pessoas p
                          , vendedoras v
                       where replace(replace(replace(c.cpf,'.',''),'-',''),' ','') = p.cpf
                         and v.idpessoa = p.idpessoa
                         and v.ativo = 'S'
                         and ( :P330_ORIGEM is null or c.origem = :P330_ORIGEM )
                         and ( :P330_MES is null or to_char(c.datacadastro,'MM') = :P330_MES )
                         and extract( year from c.datacadastro ) = :P330_ANO ) ativo
                   , ( select count(1) qtd 
                       from roman.controlecontatossite c
                          , pessoas p
                          , vendedoras v
                       where replace(replace(replace(c.cpf,'.',''),'-',''),' ','') = p.cpf
                         and v.idpessoa = p.idpessoa
                         and v.ativo = 'N'
                         and ( :P330_ORIGEM is null or c.origem = :P330_ORIGEM )
                         and ( :P330_MES is null or to_char(c.datacadastro,'MM') = :P330_MES )
                         and extract( year from c.datacadastro ) = :P330_ANO ) inativo
                where :P330_ANO is not null
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P330_TIPO
            value: M
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
