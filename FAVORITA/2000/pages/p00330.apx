    region acompanhamento-de-restrições (
        name: Acompanhamento de Restrições
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select count(c.idcontrolecontatossite) qtd
                     , roman.pck_romance.fnc_nomefilial(c.idfilial) filial
                     , cp.spc_quantidade qtdrestricao
                     , sum(cp.spc_valortotal)  valortotal
                from roman.consultaspc cp
                   , roman.controlecontatossite c
                where c.cpf = cp.cpf
                  and trunc(c.datacadastro) between to_date(:P330_DATAINICIO) and to_date(:P330_DATAFIM)
                  and ( :P330_IDFILIAL is null or c.idfilial = :P330_IDFILIAL )
                group by c.idfilial , cp.spc_quantidade
                order by 2
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P330_TIPO
            value: R
        }
        componentAppearance {
            showNullValuesAs: 0
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum dado encontrado, verifique os Filtros utilizados!
        }
        advanced {
            savedReportMappingIdentifier: 2139127165514213648
        }

