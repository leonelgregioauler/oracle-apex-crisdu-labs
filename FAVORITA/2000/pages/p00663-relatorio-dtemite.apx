page 663 (
    name: Relatorio DTEMITE
    alias: RELATORIO-DTEMITE
    title: Relatorio DTEMITE
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region fecha-emission (
        name: Fecha Emission
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region relatorio-dtemite (
        name: Relatorio DTEMITE
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                return q'~
                select p.dataemissao
                     , (select idvalorcaracteristica
                          from favorita.classificacoespedidos c
                         where c.idpedido = p.idpedido
                           and c.idcaracteristicapedido = 121) tipoDTE
                     , p.rznsocrecep nomecliente
                     , p.correorecep
                     , p.idpedido
                     , p.folio
                     , p.valorpedido
                     , (select telefone
                          from telefonespessoas
                         where idtelefonepessoa = (select max(idtelefonepessoa)
                                                     from telefonespessoas 
                                                    where idpessoa = (select idpessoa
                                                                        from vendedoras
                                                                       where idvendedora = p.cdgintrecep))) telefone
                
                  from roman.vw_pedidos_dtemite p
                 where trunc(p.dataemissao) between :P663_DATAINICIO
                                                and :P663_DATAFIM
                   and (nvl(:P663_IDFILIALFAVORITA,0) = 0 or p.idfilialfavorita = :P663_IDFILIALFAVORITA)
                   and :P663_FILTRAR = 1
                   and exists (select 1 
                                 from favorita.classificacoespedidos c
                                where c.idpedido = p.idpedido
                                  and c.idcaracteristicapedido = 122)
                     
                ~';
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 1334545906034609194
        }

        column CORREORECEP (
            type: plainText
            heading {
                heading: Correo Recep
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

