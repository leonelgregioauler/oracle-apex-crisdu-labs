    )

    pageItem P663_IDFILIALFAVORITA (
        type: selectOne
        label {
            label: Tienda
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nomefilialfavorita
                     , f.idfilialfavorita
                from favorita.filiaisfavorita f
                where f.ativo = 'S'
                  and f.tipofilial = 'L'
                  and f.idpais = 6
                order by 1
                ```
        }
        layout {
            sequence: 10
            region: @fecha-emission
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    button filtrar (
