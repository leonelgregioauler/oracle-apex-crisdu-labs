page 221 (
    name: Recibo de Pagamento
    title: Recibo de Pagamento
    appearance {
        pageTemplate: @minimal-pedido
        templateOptions: #DEFAULT#
    }
    security {
        authentication: public
        pageAccessProtection: unrestricted
    }

    region recbido-de-pagamento (
        name: Recbido de Pagamento
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin 
                  --
                  pck_imprime_fav.prc_imprimerecibopagamento(pidpedido => :P221_IDPEDIDO);
                  --
                end;
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P221_IDPEDIDO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @recbido-de-pagamento
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

)

