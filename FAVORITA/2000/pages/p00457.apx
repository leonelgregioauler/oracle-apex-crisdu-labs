page 457 (
    name: Impressão Etiqueta Postagem Correios
    title: Impressão Etiqueta Postagem Correios
    appearance {
        pageTemplate: @imprimir
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region etiqueta-postagem-correios (
        name: Etiqueta Postagem Correios
        type: plSqlDynamicContent
        source {
            plsqlCode: pck_correios_fav.prc_geraetiqueta (pidpedido                     => :P457_IDPEDIDO );
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P457_IDPEDIDO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @etiqueta-postagem-correios
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

