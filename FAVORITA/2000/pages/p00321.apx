    pageItem P321_IDSITUACAO (
        type: selectList
        label {
            label: Situação
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct d, r
                  from(
                select distinct 
                       pp.situacaopagamentopedido as d
                     , pp.idsituacaopagamentoped as r
                from pagamentospedidos p
                   , vw_perfispagamentos_fav pp
                where p.origempagamento(+)  = pp.origempagamento
                  and p.idformapagamento(+) = pp.idformapagamento
                  and p.idsituacao(+)       = pp.idsituacaopagamentoped
                  and pck_util_fav.fnc_verificaacesso(28610,:P0_IDUSUARIO) = 'S'
                union all
                select distinct 
                       pp.situacaopagamentopedido as d
                     , pp.idsituacaopagamentoped as r
                from pagamentospedidos p
                   , vw_perfispagamentos_fav pp
                where p.origempagamento(+)  = pp.origempagamento
                  and p.idformapagamento(+) = pp.idformapagamento
                  and p.idsituacao(+)       = pp.idsituacaopagamentoped
                  and pp.idgrupoatendimento = :P321_IDGRUPOATENDIMENTO
                  and pp.idacesso is null
                union all
                select distinct 
                       pp.situacaopagamentopedido as d
                     , pp.idsituacaopagamentoped as r
                from pagamentospedidos p
                   , vw_perfispagamentos_fav pp
                where p.origempagamento(+)  = pp.origempagamento
                  and p.idformapagamento(+) = pp.idformapagamento
                  and p.idsituacao(+)       = pp.idsituacaopagamentoped
                  and p.idpagamentopedido   = :P321_IDPAGAMENTOPEDIDO
                union all
                select distinct 
                       sp.descricao as d
                     , p.idsituacao as r
                from  situacoespagamentosped sp
                    , pagamentospedidos p
                where sp.idsituacaopagamentoped = p.idsituacao 
                 and p.idpagamentopedido   =  :P321_IDPAGAMENTOPEDIDO
                union all
                select distinct 
                       pp.situacaopagamentopedido as d
                     , pp.idsituacaopagamentoped as r
                from pagamentospedidos p
                   , vw_perfispagamentos_fav pp
                where p.origempagamento(+)  = pp.origempagamento
                  and p.idformapagamento(+) = pp.idformapagamento
                  and p.idsituacao(+)       = pp.idsituacaopagamentoped
                  and pck_util_fav.fnc_verificaacesso(pp.idacesso,:P0_IDUSUARIO) = 'S');
                
                ```
            nullDisplayValue: - Selecione a Situação -
        }
        cascadingLov {
            parentItems: P321_IDGRUPOATENDIMENTO
            itemsToSubmit: P321_IDGRUPOATENDIMENTO
        }
        layout {
            sequence: 120
            region: @informar-pagamento
            slot: regionBody
            alignment: left
            columnSpan: 7
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vidsituacao number;
                begin
                  --Retorna a situação do pagamento que está sendo consultado / editado (junto com a ação dinâmica no page load )
                  if :P321_IDPAGAMENTOPEDIDO is not null then
                    select idsituacao
                    into vidsituacao
                    from pagamentospedidos
                    where idpagamentopedido = :P321_IDPAGAMENTOPEDIDO;
                  end if;
                  --
                  return vidsituacao;
                  --
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P321_IDUSUARIONEGOCIACAO (
        type: selectList
        label {
            label: Atendente da Negociação
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomeusuario(u.usuario) display_value
                     , idusuario return_value
                from usuarios u
                where u.idgerente = 80
                  and u.ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 130
            region: @informar-pagamento
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuarios
                where usuario = v('APP_USER')
                  and idgerente = 80
                ```
        }
        security {
            encryptSessionState: false
        }
    )

