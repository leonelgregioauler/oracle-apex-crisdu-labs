    validation valida-desconto-pagamento-em-atraso (
        name: Valida Desconto Pagamento em Atraso
        execution {
            sequence: 180
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                /*
                
                    Maicon Aimi / Cesar - 17/04/2024
                    Validação criada para atender o ticket 8919998
                
                */
                
                
                declare
                    
                    -- declaração das variaveis
                    vRetorno        boolean := true;
                    vValorDesconto  number  := nvl(to_number(:P321_DESCONTO, '999G999G999G990D00'),0);
                    vValorJuros     number  := nvl(to_number(:P321_JUROS, '999G999G999G990D00'),0);
                    vValorAcrescimo number  := nvl(to_number(:P321_ACRESCIMO, '999G999G999G990D00'),0);
                    vValorTaxaADM   number  := nvl(to_number(:P321_TAXAADMINISTRATIVA, '999G999G999G990D00'),0);
                    
                begin
                
                    -- Verifica se o pagamento está sendo realizado em atraso
                    if to_date(:P321_DATAVENCIMENTO) < to_date(:P321_DATAPAGAMENTO) then
                    
                        -- Verifica se o valor do desconto é > (juros + acrescimo + taxa cartão)
                        if nvl(to_number(:P321_DESCONTO, '999G999G999G990D00'),0) > (vValorJuros + vValorAcrescimo+ vValorTaxaADM) then
                        
                            -- Retorno da validação 
                            vRetorno := false;
                        
                        end if;
                        
                    end if;
                    
                    -- Retorno da validação
                    return vRetorno;
                    
                end;
                ```
        }
        error {
            errorMessage:
                ```
                Atenção! Pagamento em atraso.
                
                Valor de DESCONTO não pode ser maior que a soma de (JUROS + ACRESCIMO + TAXA ADMINISTRATIVA CARTÃO).
                ```
        }
    )

