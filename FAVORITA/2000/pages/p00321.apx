page 321 (
    name: Informar Pagamento
    title: Informar Pagamento
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 70%
        height: 90%
        resizable: false
    }
    htmlHeader {
        htmlHeader:
            ```html
            
            <script 
              src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js">
            </script>
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region informar-pagamento (
        name: Informar Pagamento
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P321_ACRESCIMO (
        type: textField
        label {
            label: Acrescimo
            alignment: left
        }
        layout {
            sequence: 190
            region: @informar-pagamento
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            cssClasses: alterarvalor
            width: 15
        }
        advanced {
            customAttributes: onkeyup="formataMoeda(this);" style="text-align:right"
        }
        default {
            type: static
            staticValue: 0,00
        }
        readOnly {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P321_DATAPAGAMENTO (
        type: datePicker
        label {
            label: Data Pagamento
            alignment: left
        }
        layout {
            sequence: 100
            region: @informar-pagamento
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: dd/mm/rrrr
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

