    validation desconto-não-pode-ser-maior-que-o-juros-acréscimo-taxa (
        name: Desconto não pode ser maior que o juros + acréscimo + taxa
        execution {
            sequence: 160
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                declare
                 vdescontoADL number := 0 ;
                 vparcelas    number := 1 ;
                 vretorno     boolean := false;
                begin
                  if nvl(to_number(:P321_DESCONTO, '999G999G999G990D00'),0) <= ( nvl(to_number(:P321_JUROS, '999G999G999G990D00'),0) +
                                                                                 nvl(to_number(:P321_ACRESCIMO, '999G999G999G990D00'),0) + 
                                                                                 nvl(to_number(:P321_TAXAADMINISTRATIVA, '999G999G999G990D00'),0) ) then
                    vretorno := true;
                  else
                    if to_date(:P321_DATAVENCIMENTO) >= to_date(:P321_DATAPAGAMENTO) and 
                       :P321_ORIGEMPAGAMENTO = 'L' and
                       (:P321_IDFORMAPAGAMENTO <> 3  or 
                        :P321_NRPARCELAS = 1 ) then
                      begin
                        select idvalorcaracteristica
                          into vdescontoADL
                          from classificacoespedidos
                         where idpedido = :P321_IDPEDIDO
                           and idcaracteristicapedido = 106;
                      exception
                        when no_data_found then
                          vdescontoADL := 0;
                      end;
                      --
                      begin
                        select count(*)
                          into vparcelas
                          from vencimentospedidos
                         where idpedido = :P321_IDPEDIDO
                           and situacaovencimento = 'V';
                      exception
                        when no_data_found then
                          vparcelas := 1;
                      end;
                      --
                      if nvl(to_number(:P321_DESCONTO, '999G999G999G990D00'),0) > round(vdescontoADL/vparcelas,2) then
                        vretorno := false;
                      else
                        vretorno := true;
                      end if;
                    else
                      vretorno := true;
                    end if;
                    --
                  end if;
                  --
                  return vretorno;
                  --
                end;
                ```
        }
        error {
            errorMessage: Desconto não pode ser maior que o juros + acréscimo + taxa
        }
    )

