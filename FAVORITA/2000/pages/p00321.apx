    dynamicAction new (
        name: New
        execution {
            sequence: 230
        }
        when {
            selectionType: items
            items: P321_NRPARCELAS
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      --
                      vvalorparcela         number(15,2);
                      vvalorpago            number(15,2) := to_number(nvl(:P321_VALORLIQUIDO, 0), '999G999G999G990D00');  -- Valor base deve ser com os juros
                      vnumeroparcelas       number       := :P321_NRPARCELAS;
                      vtaxaadm              number(15,2);
                      vtaxaadmtotal         number(15,2) := 0;
                      vvalorcomtaxaadm      number(15,2);
                      vobservacao           varchar2(500);
                      vdescontoADL          number;
                      --
                    begin
                      --
                      :P321_ACRESCIMO  := 0.00;
                      --
                      :P321_OBSERVACAO := :P321_OBSERVACAO;
                      --
                      if :P321_IDFORMAPAGAMENTO = 3 then
                        --
                        if :P321_NRPARCELAS > 3 then
                          --
                          vvalorparcela    := trunc((vvalorpago / vnumeroparcelas), 3);
                          -- Maicon Aimi - 02/07/2024 - ajuste na taxa adm cartão de crédito solicitada no ticket 9052256
                          --vtaxaadm         := trunc((vvalorparcela * ( 8.5 / 100 )), 3);
                          vtaxaadm := 0;
                          vvalorcomtaxaadm := vvalorparcela + vtaxaadm; 
                          --  
                          vvalorpago := vvalorparcela * 3; 
                          --
                          for i in 1 .. 3
                          loop
                            vobservacao := vobservacao || '- Parcela '||i||': R$ '||vvalorparcela||chr(13);
                          end loop;
                          --
                          for i in 4 .. vnumeroparcelas 
                          loop
                            vtaxaadmtotal := vtaxaadmtotal + vtaxaadm;
                            vvalorpago    := vvalorpago    + vvalorcomtaxaadm; 
                            --
                            vobservacao   := vobservacao || '- Parcela '||i||': R$ '||vvalorcomtaxaadm||chr(13);
                            --
                          end loop;
                          --
                          --:P321_VALORLIQUIDO := to_char(nvl(vvalorpago, 0), '999G999G999G990D00'); 
                          --
                          :P321_VALORLIQUIDO := to_char(to_number(nvl(vvalorpago, 0)) - 
                                                        to_number(nvl(:P321_DESCONTO,  0),          '999G999G999G990D00') + 
                                                        to_number(nvl(:P321_JUROS, 0),              '999G999G999G990D00') +
                                                        to_number(nvl(:P321_ACRESCIMO, 0),          '999G999G999G990D00') +
                                                        to_number(nvl(:P321_TAXAADMINISTRATIVA, 0), '999G999G999G990D00'), '999G999G999G990D00');
                          --
                          :P321_TAXAADMINISTRATIVA := to_char(nvl(vtaxaadmtotal, 0), '999G999G999G990D00'); 
                          --
                          vobservacao := 'Valores de cada parcela: '||chr(13)||chr(13)||vobservacao;
                          --
                          :P321_OBSERVACAO := vobservacao;
                          --
                        elsif :P321_NRPARCELAS between 1 and 3 then
                          --
                          :P321_TAXAADMINISTRATIVA := NULL;
                          --
                          vvalorparcela    := trunc((vvalorpago / vnumeroparcelas), 3);
                          --
                          for i in 1 .. vnumeroparcelas
                          loop
                            vobservacao := vobservacao || '- Parcela '||i||': R$ '||vvalorparcela||chr(13);
                          end loop;
                          --
                          vobservacao := 'Valores de cada parcela: '||chr(13)||chr(13)||vobservacao;
                          --
                          :P321_OBSERVACAO := vobservacao;
                          --
                        end if;
                        --
                      else 
                        :P321_OBSERVACAO := null;
                        :P321_JUSTIFICATIVADESCACRESC := null;
                        :P321_TAXAADMINISTRATIVA := 0;
                      end if;
                      --
                      begin
                        select idvalorcaracteristica
                          into vdescontoADL
                          from classificacoespedidos
                         where idpedido = :P321_IDPEDIDO
                           and idcaracteristicapedido = 106;
                      exception
                        when no_data_found then
                          vdescontoADL := 0;
                          :P321_DESCONTO   := 0.00;
                      end;
                      --
                      if :P321_IDFORMAPAGAMENTO = 3      and 
                         :P321_NRPARCELAS > 2            and 
                         :P321_DATAPAGAMENTO IS NOT NULL and
                         vdescontoADL > 0                then
                         --
                        :P321_DESCONTO := 0;
                        :P321_DATAPAGAMENTO := null;
                        --
                      end if;
                    end;
                    ```
                itemsToSubmit: [
                    P321_VALORPAGO
                    P321_NRPARCELAS
                    P321_VALORLIQUIDO
                    P321_JUROS
                    P321_ACRESCIMO
                    P321_DESCONTO
                    P321_IDFORMAPAGAMENTO
                    P321_OBSERVACAO
                ]
                itemsToReturn: [
                    P321_VALORLIQUIDO
                    P321_TAXAADMINISTRATIVA
                    P321_OBSERVACAO
                    P321_ACRESCIMO
                    P321_DESCONTO
                    P321_DATAPAGAMENTO
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

