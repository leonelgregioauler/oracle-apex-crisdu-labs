            templateOptions: #DEFAULT#
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vorigempagamento varchar2(2);
                begin
                  --Retorna a origem do pagamento que está sendo consultado / editado (junto com a ação dinâmica no page load )
                  if :P321_IDPAGAMENTOPEDIDO is not null then
                    select origempagamento
                    into vorigempagamento
                    from pagamentospedidos
                    where idpagamentopedido = :P321_IDPAGAMENTOPEDIDO;
                  end if;
                  --
                  return vorigempagamento;
                  --
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

