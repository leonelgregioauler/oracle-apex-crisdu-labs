    process operação-dml-em-pagamentos-pedidos (
        name: Operação DML em Pagamentos Pedidos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vvalorpago              number(15,2);
                  vjuros                  number(15,2);
                  vacrescimo              number(15,2);
                  vdesconto               number(15,2);
                  vvalorliquido           number(15,2);
                  vidusuarionegociacao    number := null;
                  vattach_data            varchar2(1) := 0; 
                  --
                  voperacao_dml           varchar2(1);
                  v_idformapag            number;
                  v_baixaboleto           varchar2(1);
                  --
                begin
                  --
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  if voperacao_dml = 'U' then
                    --
                    select 'S'
                      into v_baixaboleto
                      from vencimentospedidos v
                         , pagamentospedidos  p
                     where v.idvencimentopedido = :P321_IDVENCIMENTOPEDIDO
                       and v.idvencimentopedido = p.idvencimentopedido
                       and p.idsituacao <> -1
                       and v.datavencimento >= :P321_DATAPAGAMENTO
                       and p.idformapagamento in (select idformapagamento
                                                    from formaspagamentos
                                                   where boleto = 'S' )
                       and rownum = 1;
                    --
                  end if;
                  --
                  vvalorpago         := to_number(:P321_VALORPAGO          ,'999G999G999G990D00');
                  vjuros             := to_number(:P321_JUROS              ,'999G999G999G990D00');
                  vacrescimo         := to_number(:P321_ACRESCIMO          ,'999G999G999G990D00');
                  vdesconto          := to_number(:P321_DESCONTO           ,'999G999G999G990D00');
                  vvalorliquido      := to_number(:P321_VALORLIQUIDO       ,'999G999G999G990D00');
                  v_baixaboleto      := nvl(v_baixaboleto,'N');
                  --
                  pck_pedidos_fav.prc_pagamentospedidos( pidpagamentopedido           => :P321_IDPAGAMENTOPEDIDO
                                                       , pidvencimentopedido          => :P321_IDVENCIMENTOPEDIDO
                                                       , pidformapagamento            => :P321_IDFORMAPAGAMENTO
                                                       , pdatapagamento               => :P321_DATAPAGAMENTO
                                                       , pvalorpago                   => vvalorpago
                                                       , porigempagamento             => :P321_ORIGEMPAGAMENTO
                                                       , pnumeroboleto                => :P321_NUMEROBOLETO
                                                       , pidsituacao                  => :P321_IDSITUACAO
                                                       , ptaxa                        => :P321_TAXA
                                                       , pjuros                       => vjuros
                                                       , pacrescimo                   => vacrescimo
                                                       , pdesconto                    => vdesconto
                									   , pvalorliquido                => vvalorliquido
                                                       , pnumerocomprovante           => :P321_NUMEROCOMPROVANTE
                                                       , pidcontabancaria             => :P321_IDCONTABANCARIA
                                                       , pobservacao                  => :P321_OBSERVACAO
                                                       , pidusuariopagamento          => :P321_IDUSUARIOPAGAMENTO
                                                       , pidusuarionegociacao         => vidusuarionegociacao
                									   , penviooperadora              => :P321_ENVIOOPERADORA
                									   , pretornooperadora            => :P321_RETORNOOPERADORA
                                                       , pnrparcelas                  => :P321_NRPARCELAS
                                                       , pjustificativadescacresc     => :P321_JUSTIFICATIVADESCACRESC
                									   , poperacao_dml                => voperacao_dml
                									   , pmd5                         => :P321_MD5 
                                                       , pbaixaboleto                 => v_baixaboleto);                                   
                  --
                  if :P321_SEMANEXO = 'S' then
                    -- 
                    update pagamentospedidos
                    set attach_data = vattach_data
                    where idpagamentopedido = :P321_IDPAGAMENTOPEDIDO;
                    --
                    commit;
                    --
                  end if;
                  --
                end;                                       
                										
                										
                ```
        }
        execution {
            sequence: 1
        }
        advanced {
            executionMappingIdentifier: 1411568196808850694
        }
    )

