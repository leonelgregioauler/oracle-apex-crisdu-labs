    dynamicAction calcula-juros-taxa-administrativa (
        name: Calcula Juros / Taxa Administrativa
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P321_DATAPAGAMENTO
        }
        clientSideCondition {
            type: itemIsNull
            item: P321_IDPAGAMENTOPEDIDO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      vdatavencimento date;
                      vdatapagamento  date;
                      vvalorpagar     number(15,2); 
                      vvalorpago      number(15,2);
                      vsaldo          number(15,2);
                      vpercmulta      number := 2;
                      vpercjuros      number := 1;
                      vjuros          number;
                      --
                    begin
                      --
                      select vp.datavencimento
                           , vp.valorpagar
                           --, vp.valorpago
                           , nvl((select sum(nvl(pp.valorpago,0)) 
                                    from favorita.pagamentospedidos pp 
                                   where pp.idvencimentopedido = vp.idvencimentopedido
                                     and pp.idsituacao = 20
                                     and nvl(pp.valorpago,0) > 0 ),0) valorpago
                      into vdatavencimento
                         , vvalorpagar
                         , vvalorpago
                      from vencimentospedidos vp
                      where vp.idvencimentopedido = :P321_IDVENCIMENTOPEDIDO
                      and vp.situacaovencimento = 'V';
                      --
                      vdatapagamento := :P321_DATAPAGAMENTO;
                      --
                      if vdatavencimento <= :P321_DATAPAGAMENTO then 
                        --
                        --raise_application_error(-20001, ':P321_IDVENCIMENTOPEDIDO: '||:P321_IDVENCIMENTOPEDIDO);
                         --raise_application_error(-20001, 'vvalorpagar: '||vvalorpagar||' / vvalorpago: '||vvalorpago);
                        --
                        if (vvalorpagar - vvalorpago) > 0 then 
                          vsaldo := vvalorpagar - vvalorpago;
                        elsif :P321_IDPAGAMENTOPEDIDO is not null and (vvalorpagar - vvalorpago = 0) then
                          vsaldo := vvalorpagar;
                        end if;
                        --
                        
                        --.g_print_success_message := '<span style="color : white ">vsaldo: '||vsaldo||' </span>';
                        --raise_application_error(-20001, 'vsaldo: '||vsaldo);
                        --
                        :P321_VALORLIQUIDO := to_char(pck_util_fav.fnc_calculajuros( pidpedido           => :P321_IDPEDIDO,
                                                                                     pvalororiginal      => vsaldo,
                                                                                     pdatavencimentoorig => vdatavencimento,
                                                                                     pdatavencimentonovo => vdatapagamento,
                                                                                     ppercmulta          => vpercmulta,
                                                                                     ppercjuros          => vpercjuros), '999G999G999G990D00');                                                              
                        --
                        
                        --raise_application_error(-20001, ':P321_VALORLIQUIDO: '||:P321_VALORLIQUIDO||' / :P321_valorpago: '||:P321_valorpago);
                        -- Incluir pagamento
                        --if :P321_IDPAGAMENTOPEDIDO is null then          
                          --:P321_JUROS := to_char(to_number(nvl(:P321_VALORLIQUIDO, 0), '999G999G999G990D00') - to_number(nvl(:P321_SALDODEVEDOR, 0), '999G999G999G990D00'), '999G999G999G990D00');
                           vjuros := to_number(replace(nvl(trim(:P321_VALORLIQUIDO),0),'.','')) - to_number(replace(nvl(trim(:P321_valorpago),0),'.','')); -- original
                          --  raise_application_error(-20001, ':P321_VALORLIQUIDO '||:P321_VALORLIQUIDO||' / :P321_valorpago '||:P321_valorpago);
                            :P321_JUROS := ltrim(to_char(vjuros, '999G999G999G990D00'));--to_char((to_number(nvl(:P321_VALORLIQUIDO,0) - to_number(nvl(:P321_valorpago,0)), '999G999G999G990D00'))); -- original
                            
                        -- Editar pagamento
                       -- elsif :P321_IDPAGAMENTOPEDIDO is not null then
                       --   :P321_JUROS := to_char(to_number(nvl(:P321_VALORLIQUIDO, 0), '999G999G999G990D00') - to_number(nvl(vsaldo, 0), '999G999G999G990D00'), '999G999G999G990D00');
                       -- end if;
                        --
                        :P321_VALORLIQUIDO := to_char(to_number(nvl(:P321_VALORPAGO, 0), '999G999G999G990D00') + to_number(nvl(:P321_JUROS, 0), '999G999G999G990D00'), '999G999G999G990D00');
                        --
                      else
                        if :P321_IDPAGAMENTOPEDIDO is null then
                          :P321_VALORLIQUIDO := :P321_SALDODEVEDOR;
                        -- Editar pagamento
                        elsif :P321_IDPAGAMENTOPEDIDO is not null then
                          :P321_VALORLIQUIDO := :P321_VALORPAGO;
                        end if;
                        --
                        :P321_JUROS    := to_char(0, '999G999G999G990D00');
                        --
                      end if;
                      --
                    end;
                            
                    ```
                itemsToSubmit: [
                    P321_IDVENCIMENTOPEDIDO
                    P321_DATAPAGAMENTO
                    P321_IDPEDIDO
                    P321_IDPAGAMENTOPEDIDO
                    P321_SALDODEVEDOR
                    P321_VALORPAGO
                    P321_JUROS
                    P321_VALORLIQUIDO
                    P321_ORIGEMPAGAMENTO
                ]
                itemsToReturn: [
                    P321_VALORLIQUIDO
                    P321_JUROS
                    P321_DESCONTO
                    P321_DATAPAGAMENTO
                ]
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      vdescontoADL number;
                      vparcelas    number;
                      vdescontopag number;
                    begin
                    
                      if :P321_ORIGEMPAGAMENTO = 'L' then
                          begin
                            select idvalorcaracteristica
                              into vdescontoADL
                              from classificacoespedidos
                             where idpedido = :P321_IDPEDIDO
                               and idcaracteristicapedido = 106;
                          exception
                            when no_data_found then
                              vdescontoADL := 0;
                          end;
                          --
                          begin
                            select count(*)
                              into vparcelas
                              from vencimentospedidos
                             where idpedido = :P321_IDPEDIDO
                               and situacaovencimento = 'V';
                          exception
                            when no_data_found then
                              vparcelas := 1;
                          end;
                          --
                          if :P321_IDFORMAPAGAMENTO = 3 and :P321_NRPARCELAS > 2 then
                            :P321_DESCONTO := 0 ;
                          else
                            -- Busca desconto de ADL já incluso em outro pagamento deste vencimento
                            begin
                              select sum(desconto)
                                into vdescontopag
                                from pagamentospedidos
                               where idvencimentopedido = :P321_IDVENCIMENTOPEDIDO
                                 and idsituacao not in (-1);
                            exception
                              when others then 
                                vdescontopag := 0;
                            end;
                            --
                            vdescontoADL := (vdescontoADL/vparcelas) - nvl(vdescontopag,0);
                            --
                            if vdescontoADL > 0 and to_date(:P321_DATAVENCIMENTO) >= to_date(:P321_DATAPAGAMENTO) then
                            
                              --:P321_DESCONTO     :=  round(vdescontoADL,2); estava dando erro ajax - T15822068
                              :P321_DESCONTO     := to_char(round(vdescontoADL,2), '999G999G999G990D00');
                              :P321_VALORLIQUIDO := replace(:P321_VALORLIQUIDO,'.','') - :P321_DESCONTO;
                              :P321_JUSTIFICATIVADESCACRESC := 'Desconto referente a Campanha de Adimplência ADL';
                            end if;
                            --
                          end if;
                          --
                        end if;
                        --
                    end;
                    
                    ```
                itemsToSubmit: [
                    P321_IDPEDIDO
                    P321_IDVENCIMENTOPEDIDO
                    P321_IDFORMAPAGAMENTO
                    P321_NRPARCELAS
                    P321_ORIGEMPAGAMENTO
                    P321_DESCONTO
                    P321_DATAVENCIMENTO
                    P321_DATAPAGAMENTO
                ]
                itemsToReturn: [
                    P321_DESCONTO
                    P321_VALORLIQUIDO
                    P321_JUSTIFICATIVADESCACRESC
                    P321_NUMEROCOMPROVANTE
                ]
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction calcular-valor-lí-quido-acréscimo (
        name: Calcular Valor Lí­quido (Acréscimo)
