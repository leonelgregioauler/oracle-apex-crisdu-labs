    validation valida-se-existe-negociadora-responsável (
        name: Valida se existe Negociadora Responsável
        execution {
            sequence: 110
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where not exists ( select 1
                                   from pedidos p
                                   where p.idpedido = :P321_IDPEDIDO 
                                   and p.idusuarioresponsavelcobranca is null )
                   and pck_util_fav.fnc_retornatipofilial (:P0_IDFILIALFAVORITA) != 'L'
                ```
        }
        error {
            errorMessage: Não é possível incluir um pagamento, pois já existe uma negociadora responsável. Favor entrar em contato com o setor de Cobrança.
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where v('REQUEST') in ('INSERIR')
                ```
        }
    )

    validation valida-se-já-existe-negociação-da-cobrança (
        name: Valida se já existe Negociação da Cobrança
        execution {
            sequence: 100
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where ( exists ( select 1
                                 from parcelamentospedidos p
                                 where p.idpedido = ( select idpedido
                                                      from vencimentospedidos v
                                                      where v.idvencimentopedido = :P321_IDVENCIMENTOPEDIDO ) )
                     or exists ( select 1
                                 from pedidos ped
                                 where ped.idpedido = :P321_IDPEDIDO
                                   and ped.idnegociadoraresponsavel is not null )
                     or exists ( select 1
                                 from classificacoespedidos c
                                 where c.idcaracteristicapedido = 44
                                   and c.idpedido = ( select idpedido
                                                      from vencimentospedidos v
                                                      where v.idvencimentopedido = :P321_IDVENCIMENTOPEDIDO ) ) )
                   and (exists ( select 1
                                 from roman.usuariosgruposatendimento u
                                 where u.usuario = ( select usuario
                                                     from usuarios uu
                                                     where uu.idusuario = :P0_IDUSUARIO ) 
                                   and u.idgrupoatendimento != 3 ) 
                      or not exists ( select 1
                                      from roman.usuariosgruposatendimento u
                                      where u.usuario = ( select usuario
                                                          from usuarios uu
                                                          where uu.idusuario = :P0_IDUSUARIO ) ) )
                     and pck_util_fav.fnc_retornatipofilial (:P0_IDFILIALFAVORITA) != 'L'
                ```
        }
        error {
            errorMessage: Não é possível incluir um pagamento, pois já existe uma negociação com o setor de cobrança. Favor entrar em contato com o setor de Cobrança.
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where v('REQUEST') in ('INSERIR')
                ```
        }
    )

    validation valida-valor-pago-ao-inserir-atualizar (
        name: Valida valor pago ao inserir / atualizar
        execution {
            sequence: 120
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vsaldo              number(15,2);
                  vjuros              number(15,2);
                  vdatavencimento     date;
                  vvalorpagar         number(15,2);
                  vidpedido           number;
                  --
                  vvalorpago          number(15,2);
                  --
                begin
                  --
                  -- Se estiver inserindo
                  if v('REQUEST') in ('INSERIR') then
                    --
                    --INSERIR
                    select saldo
                         , datavencimento 
                         , valorpagar
                         , idpedido
                    into vsaldo
                       , vdatavencimento
                       , vvalorpagar
                       , vidpedido
                    from vw_vencimentospedidos_fav
                    where idvencimentopedido = :P321_IDVENCIMENTOPEDIDO;
                    --
                    if vdatavencimento < trunc(sysdate) AND vsaldo > 0 then
                      --
                      vjuros := ( pck_util_fav.fnc_calculajuros(pidpedido => vidpedido,
                                                                pvalororiginal => vvalorpagar,
                                                                pdatavencimentoorig => vdatavencimento,
                                                                pdatavencimentonovo => sysdate,
                                                                ppercmulta => 2,
                                                                ppercjuros => 1) - vvalorpagar );
                      --
                    else
                      vjuros := 0;
                    end if;
                    --
                    if (replace(:P321_VALORPAGO, '.', '')) > vsaldo+vjuros then
                      return 'O saldo de pagamento é R$ '||to_char(vsaldo+vjuros, '999G999G999G990D00')||'. Informe um valor menor.';
                    end if;
                    --
                  -- Se estiver atualizando
                  elsif v('REQUEST') in ('ATUALIZAR') then
                    --
                    -- ATUALIZAR
                    select valorpago
                    into vvalorpago
                    from pagamentospedidos
                    where idpagamentopedido = :P321_IDPAGAMENTOPEDIDO;
                    --
                    if (replace(:P321_VALORPAGO, '.', '')) > vvalorpago then
                      return 'Valor pago maior que devido. O valor devido é R$ '||to_char(vvalorpago, '999G999G999G990D00')||'. Informe um valor menor ou igual.';
                    end if;
                    --
                  end if;
                  --
                end;
                ```
        }
    )

    validation valor-líquido-não-pode-ser-zero (
        name: Valor Líquido não pode ser ZERO
        execution {
            sequence: 90
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where nvl(to_number(:P321_VALORLIQUIDO, '999G999G999G990D00'),0) + nvl(to_number(:P321_DESCONTO, '999G999G999G990D00'),0) = 0
                and :P321_IDSITUACAO != -1
                ```
        }
        error {
            errorMessage: Valor líquido deve ser maior que zero (0).
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where v('REQUEST') in ('INSERIR','ATUALIZAR')
                ```
        }
    )

