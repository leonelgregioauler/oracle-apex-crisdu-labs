    dynamicAction consulta-origem-forma-pagamento-e-situação (
        name: Consulta Origem, Forma Pagamento e Situação
        execution {
            sequence: 110
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      vorigempagamento  varchar2(1);
                      vidformapagamento number;
                      vidsituacao       number;
                    begin
                      --
                      if :P321_IDPAGAMENTOPEDIDO is not null then
                        --Retorna a origem, forma de pagamento e situação do pagamento que está sendo consultado / editado (junto com a funtion no default value de cada campo )
                        select pp.origempagamento
                             , pp.idformapagamento
                             , pp.idsituacao
                        into vorigempagamento
                           , vidformapagamento
                           , vidsituacao
                        from pagamentospedidos pp
                        where pp.idpagamentopedido = :P321_IDPAGAMENTOPEDIDO;
                        --
                        :P321_ORIGEMPAGAMENTO  := vorigempagamento;
                        :P321_IDFORMAPAGAMENTO := vidformapagamento;
                        :P321_IDSITUACAO       := vidsituacao;
                        --
                      end if;
                      --
                    end;
                       
                      
                    ```
                itemsToSubmit: P321_IDPAGAMENTOPEDIDO
                itemsToReturn: [
                    P321_ORIGEMPAGAMENTO
                    P321_IDFORMAPAGAMENTO
                    P321_IDSITUACAO
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction conta-bancaria (
        name: Conta Bancaria
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P321_IDFORMAPAGAMENTO
        }
        clientSideCondition {
            type: item=value
