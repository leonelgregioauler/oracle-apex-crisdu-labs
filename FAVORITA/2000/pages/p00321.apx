        }
    )

    process consulta-em-pagamentos-pedidos (
        name: Consulta em Pagamentos Pedidos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vvalorpago              number(15,2);
                  vjuros                  number(15,2);
                  vacrescimo              number(15,2);
                  vdesconto               number(15,2);
                  vvalorliquido           number(15,2);
                  vidusuarionegociacao    number := null;
                  --
                  vidpedido               number;
                  --
                  vsaldo                  number(15,2);
                  --
                begin
                  --
                  if (:P321_PAGINAORIGEM in (119, 537, 320, 325) and :P321_IDPAGAMENTOPEDIDO is not null ) then
                    --
                    pck_pedidos_fav.prc_pagamentospedidos( pidpagamentopedido           => :P321_IDPAGAMENTOPEDIDO
                                                         , pidvencimentopedido          => :P321_IDVENCIMENTOPEDIDO
                                                         , pidformapagamento            => :P321_IDFORMAPAGAMENTO
                                                         , pdatapagamento               => :P321_DATAPAGAMENTO
                                                         , pvalorpago                   => vvalorpago
                                                         , porigempagamento             => :P321_ORIGEMPAGAMENTO
                                                         , pnumeroboleto                => :P321_NUMEROBOLETO
                                                         , pidsituacao                  => :P321_IDSITUACAO
                                                         , ptaxa                        => :P321_TAXA
                                                         , pjuros                       => vjuros
                                                         , pacrescimo                   => vacrescimo
                                                         , pdesconto                    => vdesconto
                									     , pvalorliquido                => vvalorliquido
                                                         , pnumerocomprovante           => :P321_NUMEROCOMPROVANTE
                                                         , pidcontabancaria             => :P321_IDCONTABANCARIA
                                                         , pobservacao                  => :P321_OBSERVACAO
                                                         , pidusuariopagamento          => :P321_IDUSUARIOPAGAMENTO
                                                         , pidusuarionegociacao         => vidusuarionegociacao
                                                         , penviooperadora              => :P321_ENVIOOPERADORA
                                                         , pretornooperadora            => :P321_RETORNOOPERADORA
                                                         , poperacao_dml                => 'S'
                                                         , pmd5                         => :P321_MD5 );
                    --
                    :P321_VALORPAGO      := to_char(vvalorpago    ,'999G999G999G990D00');
                    :P321_JUROS          := to_char(vjuros        ,'999G999G999G990D00');
                    :P321_ACRESCIMO      := to_char(vacrescimo    ,'999G999G999G990D00');
                    :P321_DESCONTO       := to_char(vdesconto     ,'999G999G999G990D00');
                    :P321_VALORLIQUIDO   := to_char(vvalorliquido ,'999G999G999G990D00');
                    --
                  end if;
                  --
                  select idpedido, to_char(datavencimento,'dd/mm/rrrr')
                  into vidpedido, :P321_DATAVENCIMENTO
                  from vencimentospedidos
                  where idvencimentopedido = :P321_IDVENCIMENTOPEDIDO;
                  --
                  :P321_IDPEDIDO := vidpedido;
                  --
                  -- ao incluir consulta o saldo do vencimento. 
                  if (:P321_PAGINAORIGEM in (119, 537) and :P321_IDPAGAMENTOPEDIDO is null) then 
                    --
                    select saldo
                    into vsaldo
                    from vw_vencimentospedidos_fav
                    where idvencimentopedido = :P321_IDVENCIMENTOPEDIDO;
                    --
                    :P321_SALDODEVEDOR := to_char(vsaldo, '999G999G999G990D00');
                    --
                    :P321_VALORPAGO    := to_char(vsaldo, '999G999G999G990D00');
                    --
                  -- ao editar um pagamento após incluir o vencimento ou após incluir anexo e retornar para a página consulta o valor do pagamento 
                  elsif (:P321_PAGINAORIGEM in (119, 537) and :P321_IDPAGAMENTOPEDIDO is not null) then
                    -- 
                    select p.valorpago
                    into vvalorpago
                    from pagamentospedidos p
                       , vencimentospedidos v
                    where p.idvencimentopedido = v.idvencimentopedido
                    and p.idpagamentopedido = :P321_IDPAGAMENTOPEDIDO;
                    --
                    :P321_VALORPAGO := to_char(vvalorpago, '999G999G999G990D00');
                    --
                  end if;
                  --
                end;                                        
                
                										
                										                                        
                ```
        }
        execution {
            sequence: 20
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 1411610349333906187
        }
    )

