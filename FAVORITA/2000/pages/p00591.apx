    region pedidos-da-sub-remessa (
        name: Pedidos  da Sub-Remessa
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct idpedido
                     , idedicaorevista
                     , idfilialfavorita
                     , idrepresentante
                     , idvendedora
                     , dataemissao
                     , null imprimir
                     , null VerPedido
                     , pck_util_fav.fnc_situacaoentrega( p.idsituacaoentrega
                                                               , 'E'
                                                               , i.ididioma ) situacaoentrega
                     --
                  from pedidos p
                     , idiomas i
                 where ( p.idpais = i.ididioma  or i.ididioma = 1 )
                   and  p.idsubremessa = :P591_IDSUBREMESSA
                   
                ```
            pageItemsToSubmit: P591_IDSUBREMESSA
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 565883014977487948
        }

