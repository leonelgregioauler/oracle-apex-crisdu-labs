    region pedidos-da-sub-remessaxx (
        name: Pedidos  da Sub-Remessaxx
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct idpedido
                     , idedicaorevista
                     , pck_util_fav.fnc_nomefilialfavorita( p.idfilialfavorita ) "Filial Favorita"
                     , pck_util_fav.fnc_nomerepresentante( p.idrepresentante ) "Distribuidor"
                     , pck_util_fav.fnc_nomevendedora( p.idvendedora ) "Empreendedora"
                     , to_char(dataemissao,'dd/mm/rrrr hh24:mi:ss') "Data Emissão"
                --     , null imprimir
                --     , null VerPedido
                     , (select descricaosite
                          from situacoesentrega
                         where idsituacaoentrega = p.idsituacaoentrega) situacaoentrega
                     --
                  from pedidos p
                     , idiomas i
                 where ( p.idpais = i.ididioma  or i.ididioma = 1 )
                   and  p.idsubremessa = :P591_IDSUBREMESSA
                ```
            pageItemsToSubmit: P591_IDSUBREMESSA
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
