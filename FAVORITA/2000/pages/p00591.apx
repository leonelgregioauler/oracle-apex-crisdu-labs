    process deletalinhaspedido (
        name: DeletaLinhasPedido
        type: executeCode
        editableRegion: @pedidos-da-sub-remessaxx
        source {
            plsqlCode:
                ```plsql
                begin
                
                if :P591_DATAFECHAMENTO is null then
                    update pedidos 
                       set idsubremessa = null
                      where idpedido = :IDPEDIDO;
                end if;
                  raise_application_error(-20001,'NÃO PERMITIDO EXCLUIR ITENS APÓS O FECHAMENTO DA SUBREMESSA!');
                end;
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 801864567005597117
        }
    )

    process dml-remessas (
        name: DML Remessas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                vmd5 varchar2(4000);
                vdtfechamento timestamp;
                vdtabertura   timestamp;
                vdata date;
                vidusuariofecha number;
                vidusuarioabert number;
                begin 
                
                  if v('REQUEST') = 'INCLUIR' then
                     vidusuarioabert := :P0_IDUSUARIO;
                     vdtabertura     := sysdate;
                     pck_cadastros_fav.prc_subremessas 
                                      ( :P591_idsubremessa 
                                      , :P591_idremessa 
                                      , :P591_descricao
                                      , vidusuarioabert
                                      , vdtabertura
                                      , vdtfechamento
                                      , :P591_idfilialfavorita
                                      , :P591_tiposubremessa
                                      , vidusuariofecha
                                      , vmd5
                                      , 'I' ) ;
                   -- apex_application.g_print_success_message := '<span style=”color : yellow “>Sub-Remessa inclusa com sucesso! </span>';
                  end if;
                  --
                  if v('REQUEST') = 'SALVAR' then
                     vdata := to_date(:P591_DATAABERTURA,'dd/mm/rrrr hh24:mi:ss');
                     pck_cadastros_fav.prc_subremessas 
                                      ( :P591_idsubremessa 
                                      , :P591_idremessa 
                                      , :P591_descricao
                                      , :P591_IDUSUARIOABERTURA
                                      , vdata
                                      , :P591_DATAFECHAMENTO
                                      , :P591_idfilialfavorita
                                      , :P591_tiposubremessa
                                      , :P591_IDUSUARIOFECHAMENTO
                                      , vmd5
                                      , 'U' ) ;
                    --apex_application.g_print_success_message := '<span style=”color : yellow “>Sub-Remessa salva com sucesso! </span>';
                  end if;
                  --
                  if v('REQUEST') = 'FINALIZAR' then
                     vdtfechamento := sysdate;
