    region itens-34-103-0152-e-34-140-0172-campanha (
        name: Itens 34.103.0152 e 34.140.0172 - Campanha 2
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select *
                from(
                select idpedido
                     , favorita.pck_util_fav.fnc_nomerepresentante(idrepresentante) Distribuidor
                     , favorita.pck_util_fav.fnc_nomevendedora(idvendedora) Cliente
                     , valorapagar
                     , valorpago
                     , osdois QtdKits
                     , nvl(temcupom,'N')
                from (
                select p.idpedido
                     , p.idrepresentante
                     , p.idvendedora
                     , p.valorapagar
                     , p.valorpago    
                     , ( select sum(i.quantidade)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idproduto in (4634,4676)) osdois
                     , ( select sum(i.quantidade)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idproduto in (4634)) item1
                      , ( select sum(i.quantidade)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idproduto in (4676)) item2
                      , ( select 'S'
                          from favorita.codigoscuponsdescontos cp
                          where cp.idpedido = p.idpedido) temcupom
                from favorita.vw_pedidos_fav p
                where p.idfilialromance = 100
                  and p.ididioma = 1
                  and p.datacancelamento is null
                  and p.idfilialfavorita in (1)
                  and p.dataemissao between to_date('19/04/2021 00:00:00','dd/mm/rrrr hh24:mi:ss') and to_date('31/05/2021 23:59:59','dd/mm/rrrr hh24:mi:ss')
                  and exists ( select 1
                               from favorita.itenspedidos i
                               where i.idpedido = p.idpedido
                                 and ( i.idproduto = 4634 or  i.idproduto = 4676))))
                where QtdKits > 0
                  and :P495_TIPO_RELATORIO = 3;
                
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P495_TIPO_RELATORIO
            value: 3
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 107947786289913920
        }

