    region itens-34-140-0195-34-140-0168-e-34-140-0195-34-140-0194-campanha (
        name: Itens 34.140.0195/34.140.0168 e 34.140.0195/34.140.0194 - Campanha 1
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select *
                from(
                select idpedido
                     , favorita.pck_util_fav.fnc_nomerepresentante(idrepresentante) Distribuidor
                     , favorita.pck_util_fav.fnc_nomevendedora(idvendedora) Cliente
                     , valorapagar
                     , valorpago
                     , case
                       when item1 > 0 and item2> 0 then
                         case 
                           when item1 >= item2 then
                             item2
                         else
                           item1
                         end
                       else
                         0 
                       end QtdKits1
                     , 0 QtdKits2
                from (
                select p.idpedido
                     , p.idrepresentante
                     , p.idvendedora
                     , p.valorapagar
                     , p.valorpago    
                     , ( select sum(i.quantidade)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idproduto in (4672,4758)) osdois
                     , ( select sum(i.quantidade)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idproduto in (4758)) item1
                      , ( select sum(i.quantidade)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idproduto in (4672)) item2
                from favorita.vw_pedidos_fav p
                where p.idfilialromance = 100
                  and p.ididioma = 1
                  and p.datacancelamento is null
                  and p.idfilialfavorita in (1)
                  and p.dataemissao between to_date('15/03/2021 00:00:00','dd/mm/rrrr hh24:mi:ss') and to_date('19/04/2021 23:59:59','dd/mm/rrrr hh24:mi:ss')
                  and exists ( select 1
                               from favorita.itenspedidos i
                               where i.idpedido = p.idpedido
                                 and i.idproduto in (4672,4758)))
                union
                select idpedido
                     , favorita.pck_util_fav.fnc_nomerepresentante(idrepresentante) Distribuidor
                     , favorita.pck_util_fav.fnc_nomevendedora(idvendedora) Cliente
                     , valorapagar
                     , valorpago
                     , 0 QtdKits1
                     , case
                       when item1 > 0 and item2> 0 then
                         case 
                           when item1 >= item2 then
                             item2
                         else
                           item1
                         end
                       else
                         0 
                       end QtdKits2
                from (
                select p.idpedido
                     , p.idrepresentante
                     , p.idvendedora
                     , p.valorapagar
                     , p.valorpago
                     , ( select sum(i.quantidade)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idproduto in (4757,4758)) osdois
                     , ( select sum(i.quantidade)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idproduto in (4758)) item1
                      , ( select sum(i.quantidade)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idproduto in (4757)) item2
                from favorita.vw_pedidos_fav p
                where p.idfilialromance = 100
                  and p.ididioma = 1
                  and p.datacancelamento is null
                  and p.idfilialfavorita in (1)
                  and p.dataemissao between to_date('15/03/2021 00:00:00','dd/mm/rrrr hh24:mi:ss') and to_date('19/04/2021 23:59:59','dd/mm/rrrr hh24:mi:ss')
                  and exists ( select 1
                               from favorita.itenspedidos i
                               where i.idpedido = p.idpedido
                                 and i.idproduto in (4757,4758))))
                where (QtdKits2 > 0  
                      or QtdKits1 > 0)
                  and :P495_TIPO_RELATORIO = 2;
                ```
        }
