        action native-clear (
            action: clear
            affectedElements {
                selectionType: items
                items: P298_IDFILIALFAVORITAORIGEM
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-disable (
            action: disable
            affectedElements {
                selectionType: items
                items: P298_IDFILIALFAVORITAORIGEM
            }
            execution {
                sequence: 10
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: items
                items: [
                    P298_IDFILIALROMANCEORIGEM
                    P298_IDFILIALROMANCEDESTINO
                ]
            }
            execution {
                sequence: 30
            }
        )

        action native-enable-2 (
            action: enable
            affectedElements {
                selectionType: items
                items: P298_IDFILIALROMANCEORIGEM
            }
            execution {
                sequence: 20
            }
        )

