        }
    )

    validation valida-edição-de-revista (
        name: Valida Edição de Revista
        execution {
            sequence: 40
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vnumeroedicaoorigem number;
                  vnumeroedicaodestino number;
                  --
                  cursor c1 ( pidedicaorevistaorigem in number ) is
                  select distinct
                         est.idpais
                       , er.tipovenda
                  from roman.estados est
                     , roman.cidades cid
                     , pessoas pes
                     , filiais fil
                     , filiaisfavorita filfav
                     , filiaisedicoesrevistas fer
                     , edicoesrevistas er
                  where fer.idedicaorevista = er.idedicaorevista
                  and ( fil.idfilial = fer.idfilial
                   or filfav.idfilialfavorita = fer.idfilialfavorita )
                  and pes.idpessoa = fil.idpessoa
                  and cid.idcidade = pes.idcidade
                  and est.idestado = cid.idestado
                  and fer.idedicaorevista = pidedicaorevistaorigem;
                  -- 
                  r1 c1%rowtype;
                  --
                  cursor c2 ( pidedicaorevistadestino in number ) is
                  select distinct
                         est.idpais
                       , er.tipovenda
                  from roman.estados est
                     , roman.cidades cid
                     , pessoas pes
                     , filiais fil
                     , filiaisfavorita filfav
                     , filiaisedicoesrevistas fer
                     , edicoesrevistas er
                  where fer.idedicaorevista = er.idedicaorevista
                  and ( fil.idfilial = fer.idfilial
                   or filfav.idfilialfavorita = fer.idfilialfavorita )
                  and pes.idpessoa = fil.idpessoa
                  and cid.idcidade = pes.idcidade
                  and est.idestado = cid.idestado
                  and fer.idedicaorevista = pidedicaorevistadestino;
                  -- 
                  r2 c2%rowtype;
                  --
                begin
                  --
                  select numeroedicao
                  into vnumeroedicaoorigem
                  from edicoesrevistas
                  where idedicaorevista = :P298_IDEDICAOREVISTAORIGEM;
                  --
                  select numeroedicao
                  into vnumeroedicaodestino
                  from edicoesrevistas
                  where idedicaorevista = :P298_IDEDICAOREVISTADESTINO;
                  --
                  if vnumeroedicaoorigem > vnumeroedicaodestino then
                    return 'Edição de Origem deve ser anterior à Edição Destino';
                  end if;
                  --
                  --
                  open c1 (:P298_IDEDICAOREVISTAORIGEM);
                  loop
                    fetch c1 into r1;
                    --
                    if c1%rowcount = 0 then
                      return ('Não existe filial cadastrada para a edição de revista origem');
                    end if;
                    --  
                    exit when c1%notfound;
                    --
                    open c2 (:P298_IDEDICAOREVISTADESTINO);
                    loop
                      fetch c2 into r2;
                      --
                      if c2%rowcount = 0 then
                      return ('Não existe filial cadastrada para a edição de revista destino');
                      end if;
                      --
                      exit when c2%notfound;
                      --
                      if r1.tipovenda <> r2.tipovenda then
                        return ('Cópia de preços somente entre edições do mesmo tipo de venda');
                      end if;
                      --
                      if r1.idpais <> r2.idpais and (r1.tipovenda != 'L' or r2.tipovenda != 'L') then
                        return ('Cópia de Preços somente entre edições do mesmo país');
                      elsif r1.tipovenda = 'P' and r2.tipovenda <> 'P' then
                        return ('Cópia de Preços somente entre Filiais Romance ou entre Distribuidoras Parceiras');
                      elsif r1.tipovenda <> 'P' and r2.tipovenda = 'P' then
                        return ('Cópia de Preços somente entre Filiais Romance ou entre Distribuidoras Parceiras');
                      end if;
                      --
                    end loop;
                    close c2;
                    --
                  end loop;
                  close c1;
                  --
                end;
                ```
        }
        serverSideCondition {
            type: request=Value
            value: GERARPRECOSTODOSPRODUTOS
        }
    )

    validation valida-filiais (
        name: Valida Filiais
        execution {
            sequence: 30
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  null;
                  /*
                  if :P298_IDFILIALFAVORITAORIGEM is null and ( :P298_IDFILIALROMANCEORIGEM is null and :P298_IDFILIALROMANCEDESTINO is null ) then
                    return ('Informar a Filial Romance ou Favorita');
                  elsif :P298_IDFILIALFAVORITAORIGEM is null and ( :P298_IDFILIALROMANCEORIGEM is null or :P298_IDFILIALROMANCEDESTINO is null ) then
                    return ('Informar a Filial Romance');
                  end if;
                  */
                  --
                end;
                ```
            alwaysExecute: true
        }
        serverSideCondition {
            type: request=Value
            value: GERARPRECOSTODOSPRODUTOS
        }
    )

    process gerar-preços-edição-filial-romance-favorita (
        name: Gerar Preços Edição / Filial Romance / Favorita
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidprecoproduto     number       := null;
                  vidprodutodetalhado number       := null;
                begin
                  --
                  if v('REQUEST') = 'GERARPRECOSTODOSPRODUTOS' then
                    --
                    pck_cadastros_fav.prc_copiaprecosprodutos ( pidprecoproduto           => vidprecoproduto
                                                              , pidedicaorevistaorigem    => :P298_IDEDICAOREVISTAORIGEM
                                                              , pidedicaorevistadestino   => :P298_IDEDICAOREVISTADESTINO
                                                              , pidfilialromanceorigem    => :P298_IDFILIALROMANCEORIGEM
                                                              , pidfilialromancedestino   => :P298_IDFILIALROMANCEDESTINO
                                                              , pidfilialfavoritaorigem   => :P298_IDFILIALFAVORITAORIGEM
                                                              , pidprodutodetalhado       => vidprodutodetalhado
                                                              , pquantidadeprecoscopiados => :P298_QUANTIDADEPRECOSCOPIADOS );
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Foram gerados &P298_QUANTIDADEPRECOSCOPIADOS. preços com sucesso.
        }
        advanced {
            executionMappingIdentifier: 1397037697181792977
        }
        serverSideCondition {
            type: request=Value
            value: GERARPRECOSTODOSPRODUTOS
        }
    )

)

