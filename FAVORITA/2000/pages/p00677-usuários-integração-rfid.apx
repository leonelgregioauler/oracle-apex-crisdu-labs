                layout {
                    width: 70
                    sequence: 2
                }
            )

        )

        column ATIVO (
            type: textField
            heading {
                heading: Ativo
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            validation {
                maxLength: 1
            }
            source {
                databaseColumn: ATIVO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column DT_CRIACAO (
            type: datePicker
            heading {
                heading: Data Criação
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                databaseColumn: DT_CRIACAO
                dataType: date
            }
        )

        column Desativar (
            type: link
            heading {
                heading: Desativar
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            link {
                target: {
                    page: 678
                    items: {
                        P678_IDUSUARIO: &IDUSUARIO.
                    }
                    clearCache: 678
                }
                linkText: <span class="fa fa-user-slash"></span>
            }
            source {
                type: none
            }
        )

        column IDUSUARIO (
            type: hidden
            layout {
                sequence: 10
            }
            source {
                databaseColumn: IDUSUARIO
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column SENHA_HASH (
            type: password
            heading {
                heading: Senha
                alignment: center
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
                maxLength: 200
            }
            source {
                databaseColumn: SENHA_HASH
                dataType: varchar2
            }
        )

        column USUARIO (
