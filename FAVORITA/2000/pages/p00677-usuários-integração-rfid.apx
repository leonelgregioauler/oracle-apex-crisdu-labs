    region aviso (
        name: Aviso
        type: staticContent
        source {
            htmlCode:
                ```html
                <div style="
                    border: 1px solid #f0ad4e;
                    background-color: #fff8e5;
                    color: #8a6d3b;
                    padding: 16px;
                    border-radius: 6px;
                    font-size: 14px;
                ">
                    <strong>Atenção</strong>
                    <p style="margin-top: 8px; margin-bottom: 8px;">
                        Os usuários <strong>não devem ser excluídos</strong> e a <strong>senha não deve ser alterada</strong>.
                    </p>
                    <p style="margin: 0;">
                        Caso seja necessário substituir um usuário, <strong>desative o usuário antigo</strong> e <strong>crie um novo usuário</strong>.
                    </p>
                </div>
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    region usuários-integração-rfid (
        name: Usuários Integração RFID
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                    us.idusuario
                  , us.usuario
                  , '*********************' AS senha_hash
                  , decode(us.ativo, 'S', 'Sim', 'N', 'Não') ativo
                  , us.dt_criacao
                from favorita.rfid_users us
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 2429786875676379944
        }

        savedReport 330515 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDUSUARIO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @USUARIO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
