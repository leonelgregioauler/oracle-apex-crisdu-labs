page 114 (
    name: Cadastro Permissões Comp/Transf/Remessas
    title: Cadastro Permissões Comp/Transf/Remessas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region permissões-comp-transf-remessas (
        name: Permissões Comp/Transf/Remessas
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P114_CRIAR (
        type: selectList
        label {
            label: Cadastrar
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Sim;S,Não;N
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @permissões-comp-transf-remessas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P114_IDPERMISSAOTIPOCTRP (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @permissões-comp-transf-remessas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P114_IDTIPOCOMPTRANSREM (
        type: selectList
        label {
            label: Tipo
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_retornatipocomptransrem(t.idtipocomptransrem,:P0_IDIDIOMA) display_value
                 , t.idtipocomptransrem return_value
                from tiposcomptransrem t
                ```
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @permissões-comp-transf-remessas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P114_IDUSUARIO (
        type: popupLov
        label {
            label: Usuário
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sharedComponent
            lov: @lov-usuarios
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @permissões-comp-transf-remessas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P114_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @permissões-comp-transf-remessas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P114_OPERACAO_DML (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @permissões-comp-transf-remessas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P114_VISUALIZAR (
        type: selectList
        label {
            label: Visualizar
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @permissões-comp-transf-remessas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 30
            region: @permissões-comp-transf-remessas
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P114_IDPERMISSAOTIPOCTRP
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 20
            region: @permissões-comp-transf-remessas
            slot: help
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P114_IDPERMISSAOTIPOCTRP
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 40
            region: @permissões-comp-transf-remessas
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 113
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 50
            region: @permissões-comp-transf-remessas
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P114_IDPERMISSAOTIPOCTRP
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @permissões-comp-transf-remessas
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process consulta-permissão (
        name: Consulta Permissão
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                #OWNER#.PCK_COMPRASTRANSF_FAV.PRC_PERMISSOESTIPOSCTRP( PIDPERMISSAOTIPOCTRP => :P114_IDPERMISSAOTIPOCTRP,
                                                                         PIDUSUARIO => :P114_IDUSUARIO,
                                                                         PIDTIPOCOMPTRANSREM => :P114_IDTIPOCOMPTRANSREM,
                                                                         PVISUALIZAR => :P114_VISUALIZAR,
                                                                         PCRIAR => :P114_CRIAR,
                                                                         PMD5 => :P114_MD5,
                                                                         POPERACAO_DML => 'S');
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 14802045764484525
        }
    )

    process limpa-campos (
        name: Limpa Campos
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 14801984042484524
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('NOVO','INCLUIR')
                ```
        }
    )

    process operação-dml-em-permissões-ctrp (
        name: Operação DML em Permissões CTRP
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  --
                  voperacao_dml varchar2(1);
                  --
                begin
                  --
                  if v('REQUEST') = 'INSERIR' then
                    --
                    voperacao_dml := 'I';
                    --
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    --
                    voperacao_dml := 'U';
                    --
                  elsif v('REQUEST') = 'EXCLUIR' then
                    --
                    voperacao_dml := 'D';
                    --
                  end if;
                  --
                  #OWNER#.PCK_COMPRASTRANSF_FAV.PRC_PERMISSOESTIPOSCTRP( PIDPERMISSAOTIPOCTRP => :P114_IDPERMISSAOTIPOCTRP,
                                                                         PIDUSUARIO => :P114_IDUSUARIO,
                                                                         PIDTIPOCOMPTRANSREM => :P114_IDTIPOCOMPTRANSREM,
                                                                         PVISUALIZAR => :P114_VISUALIZAR,
                                                                         PCRIAR => :P114_CRIAR,
                                                                         PMD5 => :P114_MD5,
                                                                         POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro Atualizado!
        }
        advanced {
            executionMappingIdentifier: 14863299147426749
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ('INSERIR','ATUALIZAR','EXCLUIR')
                ```
        }
    )

    branch (
        name: go to page 114
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 114
                items: {
                    P114_IDPERMISSAOTIPOCTRP: &P114_IDPERMISSAOTIPOCTRP.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

    branch (
        name: go to page 113
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 113
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @excluir
        }
    )

    branch (
        name: go to page 114
        execution {
            sequence: 30
        }
        behavior {
            target: {
                page: 114
                items: {
                    P114_IDPERMISSAOTIPOCTRP:
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @inserir
        }
    )

)

