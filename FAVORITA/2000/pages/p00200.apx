page 200 (
    name: Baixa de Boletos Uruguai
    title: Baixa de Boletos Uruguai
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region boletos-com-problemas (
        name: Boletos com Problemas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                  select a.*
                    from pedidos p
                       , vencimentospedidos vp
                       , pagamentospedidos pp
                       , avisospagamentosbancos a
                    where pp.numeroboleto = substr(a.mensagem, 39, 17)
                    and vp.idvencimentopedido = pp.idvencimentopedido
                    and p.idpedido = vp.idpedido
                    and p.idfilialfavorita = 9
                    and a.mensagem like '%Erro%'
                  union all
                     select a.*
                    from boletos b
                       , avisospagamentosbancos a   
                    where b.numero = substr(a.mensagem, 39, 17)
                      and b.idfilial = 1041
                      and a.mensagem like '%Erro%'
                  order by 3 desc;
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum erro encontrado!
        }
        advanced {
            savedReportMappingIdentifier: 241321608780791614
        }

