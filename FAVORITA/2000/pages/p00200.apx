    process verifica-se-arquivo-foi-excluído-do-ftp (
        name: Verifica se arquivo foi excluído do FTP
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vexiste  varchar2(1);
                  vsql     varchar2(100);
                  --
                  TYPE texiste  IS REF CURSOR;
                  cexiste texiste;
                begin
                  --
                  begin
                  select 1
                  into vexiste
                  from all_tables
                  where table_name = 'LEARQUIVOPAGAMENTOSABITAB'
                  and owner = 'FAVORITA';
                  --
                  if vexiste = 1 then
                    --
                    vsql := 'select distinct 1
                             from learquivopagamentosabitab';
                    open cexiste for vsql;
                    loop 
                      fetch cexiste into vexiste;
                      exit when cexiste%notfound;
                    end loop;
                    close cexiste;
                    --  
                  end if;
                  --
                  exception
                    when no_data_found then 
                      null;
                    when others then
                      if sqlcode = -29913 then
                        execute immediate 'drop table LEARQUIVOPAGAMENTOSABITAB';
                        delete from importaarquivoabitab;
                      elsif sqlcode = -00942 then
                        null; --delete from importaarquivoabitab;
                      elsif sqlcode = -06512 then
                        null; --delete from importaarquivoabitab; 
                      end if;  
                  end;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 774857264385600521
        }
    )

)

