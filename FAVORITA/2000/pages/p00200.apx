    process download-do-arquivo-do-servidor-e-baixa-de-boletos (
        name: Download do arquivo do servidor e baixa de boletos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vnull     varchar2(1)  := null;
                begin
                  #OWNER#.PCK_BOLETOSABITAB_FAV.PRC_PAGAMENTOSBOLETOSABITAB ( vnull );
                  #OWNER#.PCK_INTEGRACAO_FAV.PRC_PROCESSAPGTOSBANCOS(PIDUSUARIO => :P0_IDUSUARIO);
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Baixa de boletos realizada com sucesso.
        }
        advanced {
            executionMappingIdentifier: 11895080153894603
        }
        serverSideCondition {
            whenButtonPressed: @baixarboletos
        }
    )

    process excluir-anexo-criar-tabela (
        name: Excluir Anexo - Criar Tabela
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- 
                  execute immediate 
                  ' create table learquivopagamentosabitab  
                     ( identificacaocliente varchar2(13)
                     , nomecliente varchar2(30)
                     , sobrenomecliente varchar2(30)
                     , numerodocumento varchar2(16)
                     , tipomoeda varchar2(1)
                     , valorcobrado varchar2(14)
                     , valormora varchar2(14)
                     , valorpago varchar2(14)
                     , conceito1 varchar2(40)
                     , agencia varchar2(3)
                     , subagencia varchar2(3)
                     , datapagamento varchar2(12)
                      )';
                  --
                end;
                ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Anexo excluído com sucesso.
        }
        advanced {
            executionMappingIdentifier: 55750479160147248
        }
        serverSideCondition {
            whenButtonPressed: @excluiranexo
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from all_tables
                where table_name = 'LEARQUIVOPAGAMENTOSABITAB'
                and owner = 'FAVORITA';
                ```
        }
    )

