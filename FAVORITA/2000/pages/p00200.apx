    region mensagens (
        name: Mensagens
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                    select a.idavisopagamentobanco
                         , a.dataaviso
                         , a.mensagem
                    from pedidos p
                       , vencimentospedidos vp
                       , pagamentospedidos pp
                       , avisospagamentosbancos a
                    where pp.numeroboleto = substr(a.mensagem, 11, 17)
                      and vp.idvencimentopedido = pp.idvencimentopedido
                      and p.idpedido = vp.idpedido
                      and p.idfilialfavorita = 9
                      and trunc(a.dataaviso) = trunc(sysdate)
                      and mensagem like '%sucesso%'
                  union all
                    select a.idavisopagamentobanco
                         , a.dataaviso
                         , a.mensagem
                    from boletos b
                       , avisospagamentosbancos a   
                    where b.numero = substr(a.mensagem, 11, 17)
                      and b.idfilial = 1041
                      and trunc(a.dataaviso) = trunc(sysdate)
                      and a.mensagem like '%sucesso%'
                  order by 2 desc;
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
