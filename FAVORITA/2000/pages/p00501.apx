page 501 (
    name: Cadastro de SubCategorias
    title: Cadastro de SubCategorias
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region subcategoria (
        name: SubCategoria
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P501_ATIVO (
        type: radioGroup
        label {
            label: Ativo
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Sim;S,Não;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @subcategoria
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P501_IDCATEGORIA (
        type: selectList
        label {
            label: Categoria
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nome showvalue
                     , c.idcategoria returnvalue
                from favorita.categorias c
                where c.ativo = 'S'
                  and c.idcategoriasite = :P501_IDCATEGORIASITE;
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P501_IDCATEGORIASITE
        }
        layout {
            sequence: 40
            region: @subcategoria
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P501_IDCATEGORIASITE (
        type: selectList
        label {
            label: Categoria Site
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.nomecategoria showvalue
                     , c.idcategoriasite returnvalue
                from favorita.categoriassite c
                where c.ativo = 'S'
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @subcategoria
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P501_IDSUBCATEGORIA (
        type: hidden
        layout {
            sequence: 60
            region: @subcategoria
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P501_NOME (
        type: textField
        label {
            label: Descrição
            alignment: left
        }
        layout {
            sequence: 10
            region: @subcategoria
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P501_OBSERVACAO (
        type: textarea
        label {
            label: Observação
            alignment: left
        }
        settings {
            autoHeight: true
        }
        layout {
            sequence: 50
            region: @subcategoria
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
            height: 5
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 30
            region: @subcategoria
            slot: bottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P501_IDSUBCATEGORIA
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 20
            region: @subcategoria
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconRight
            ]
            icon: fa-remove
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P501_IDSUBCATEGORIA
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 10
            region: @subcategoria
            slot: bottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-remove
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 40
            region: @subcategoria
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P501_IDSUBCATEGORIA
        }
    )

    process operacao-dml-s (
        name: OPERACAO_DML_S
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vmd5     varchar2(4000);
                  vdml     varchar2(1) := 'S';
                  vmsgerro varchar2(4000);
                  --
                begin
                  --
                  favorita.PCK_CADASTROS_FAV.prc_subcategorias ( pidsubcategoria   => :P501_IDSUBCATEGORIA
                                                               , pnome             => :P501_NOME
                                                               , pobservacao       => :P501_OBSERVACAO
                                                               , pativo            => :P501_ATIVO
                                                               , pidcategoria      => :P501_IDCATEGORIA
                                                               , pmd5              => vmd5
                                                               , poperacao_dml     => vdml
                                                               , msgerro           => vmsgerro);
                  --
                  if :P501_IDSUBCATEGORIA is not null then
                    --
                    select c.idcategoriasite
                    into :P501_IDCATEGORIASITE
                    from favorita.categorias c
                    where c.idcategoria = :P501_IDCATEGORIA;
                    --
                  end if;
                  --
                end;
                
                
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 107579374683165728
        }
    )

    process processo-dml (
        name: PROCESSO_DML
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vmd5     varchar2(4000);
                  vdml     varchar2(1) := 'S';
                  vmsgerro varchar2(4000);
                  --
                begin
                  --
                  if v('REQUEST') = 'INSERIR' then
                    vdml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    vdml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    vdml := 'D';
                  end if;
                  --
                  favorita.PCK_CADASTROS_FAV.prc_subcategorias ( pidsubcategoria   => :P501_IDSUBCATEGORIA
                                                               , pnome             => :P501_NOME
                                                               , pobservacao       => :P501_OBSERVACAO
                                                               , pativo            => :P501_ATIVO
                                                               , pidcategoria      => :P501_IDCATEGORIA
                                                               , pmd5              => vmd5
                                                               , poperacao_dml     => vdml
                                                               , msgerro           => vmsgerro);
                  --
                  if vmsgerro is null then
                    --
                    apex_application.g_print_success_message := 'Processo efetuado com sucesso';
                    --
                  else
                    --
                    apex_error.add_error(p_message          => vmsgerro,
                                         p_display_location => apex_error.c_inline_with_field_and_notif);
                    --
                  end if;
                  --
                end;
                
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 107579880816165733
        }
    )

    branch (
        name: Go To Page 499
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 499
                action: resetPagination
            }
        }
        serverSideCondition {
            type: request=Value
            value: FECHAR
        }
    )

)

