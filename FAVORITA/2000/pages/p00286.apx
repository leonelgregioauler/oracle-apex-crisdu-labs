    pageItem P286_IDPRODUTO (
        type: displayOnly
        label {
            label: Produto
            alignment: left
        }
        settings {
            format: htmlUnsafe
        }
        layout {
            sequence: 60
            region: @quantidades-de-devolução-defeito-ou-avaria
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeprodutodetalhado(id.idprodutodetalhado,:P0_IDIDIOMA) ||' <br> Quantidade: '||id.quantidade produto
                from itensdevolucaopedidos id
                where id.iditemdevolucaopedido = :P286_IDITEMDEVOLUCAOPEDIDO
                union
                select pck_util_fav.fnc_nomeprodutodetalhado(it.idprodutodetalhado,:P0_IDIDIOMA) ||' <br> Quantidade: '||it.quantidade produto
                from itenspedidostrocados it
                where it.iditempedidotrocado = :P286_IDITEMPEDIDOTROCADO
                union
                select pck_util_fav.fnc_nomeprodutodetalhado(ie.idprodutodetalhado,:P0_IDIDIOMA) ||' <br> Quantidade: '||ie.quantidade produto
                from itensexcluidos ie
                where ie.iditemexcluido = :P286_IDITEMEXCLUIDO
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

