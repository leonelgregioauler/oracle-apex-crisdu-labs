page 286 (
    name: Informar Devolução
    title: Informar Devolução
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function submit(evento)
            {
                   tecla = evento.keyCode;
                   if(tecla == 0)
                   {
                           tecla = evento.charCode;
                   }
                   if(tecla == 13)
                   {
                       confirm('Esta operação é irreversível! Confirma o recebimento? ');
                       apex.submit('CONFIRMAR');
                   }
            }
            
            function confirmaitem(event)
            {
             var tecla = event.keyCode ? event.keyCode : event.which ? event.which : event.charCode;
             console.log (tecla);
             if (tecla==13) 
             { 
              var answer = confirm("Confirma recebimento do produto?")
              if (answer)
              {
                apex.submit('CONFIRMAR');
              }
             } 
              else 
              { if([190,188,110,194].indexOf(tecla) !=-1) 
                {
                 alert('Informe uma Quantidade Válida!'); 
                 return false;
                }
              }
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region quantidades-de-devolução-defeito-ou-avaria (
        name: Quantidades de Devolução, Defeito ou Avaria
        type: staticContent
        layout {
