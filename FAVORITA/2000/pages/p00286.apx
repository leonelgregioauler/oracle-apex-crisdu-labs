    pageItem P286_IDDEFEITO (
        type: selectList
        label {
            label: Defeito
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select descricao||' - '||descorigem display_value
                     , iddefeito return_value
                from vw_defeitos_fav
                where aparecer = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 90
            region: @quantidades-de-devolução-defeito-ou-avaria
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

