            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            htmlDomId: DEVOLUCAODEFEITOAVARIA
            regionDisplaySelector: true
        }
    )

