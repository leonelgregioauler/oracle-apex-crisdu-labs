        }
        validation {
            type: itemIsNotNull
            item: P286_PRODUTODETALHADOTROCADO
        }
        error {
            errorMessage: Produto detalhado trocado deve ser informado
        }
        serverSideCondition {
            type: itemIsNotNullAndNotZero
            item: P286_QUANTIDADETROCADA
        }
    )

    validation valida-quantidades (
        name: Valida quantidades
        execution {
            sequence: 10
        }
        validation {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 
                from itensdevolucaopedidos
                where iditemdevolucaopedido = :P286_IDITEMDEVOLUCAOPEDIDO
                  and quantidade = (to_number(:P286_QUANTIDADEDEVOLVIDA,'0')
                                   +to_number(:P286_QUANTIDADEDEFEITO,'0')
                                   +to_number(:P286_QUANTIDADEAVARIA,'0')
                                   +to_number(:P286_QUANTIDADENAORECEBIDA,'0')
                                   +to_number(:P286_QUANTIDADETROCADA,'0'))
                union
                select 1 
                from itenspedidostrocados
                where iditempedidotrocado = :P286_IDITEMPEDIDOTROCADO
                  and quantidade = (to_number(:P286_QUANTIDADEDEVOLVIDA,'0')
                                   +to_number(:P286_QUANTIDADEDEFEITO,'0')
                                   +to_number(:P286_QUANTIDADEAVARIA,'0')
                                   +to_number(:P286_QUANTIDADENAORECEBIDA,'0')
                                   +to_number(:P286_QUANTIDADETROCADA,'0'))
                union                       
                select 1 
                from itensexcluidos
                where iditemexcluido = :P286_IDITEMEXCLUIDO
                  and quantidade = (to_number(:P286_QUANTIDADEDEVOLVIDA,'0')
                                   +to_number(:P286_QUANTIDADEDEFEITO,'0')
                                   +to_number(:P286_QUANTIDADEAVARIA,'0')
                                   +to_number(:P286_QUANTIDADENAORECEBIDA,'0')
                                   +to_number(:P286_QUANTIDADETROCADA,'0'))
                ```
        }
        error {
            errorMessage: A soma das quantidades deve ser igual a quantidade da devolução.
        }
        serverSideCondition {
            type: never
        }
    )

    process salvar-quantidades-devolvidas (
        name: Salvar QUANTIDADES DEVOLVIDAS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                   viditemdevolucaopedido      number := to_number(:P286_IDITEMDEVOLUCAOPEDIDO);
                   vquantidadedevolucao        number := to_number(:P286_QUANTIDADEDEVOLVIDA);
                   vquantidadedefeito          number := to_number(:P286_QUANTIDADEDEFEITO);
                   vquantidadeavaria           number := to_number(:P286_QUANTIDADEAVARIA);
                   vquantidadenaorecebida      number := to_number(:P286_QUANTIDADENAORECEBIDA);
                   vquantidadetrocada          number := to_number(:P286_QUANTIDADETROCADA);
                   vidprodutodetalhadotrocado  number := to_number(:P286_PRODUTODETALHADOTROCADO);
                begin
                  --
                  pck_protocolosatendimentos_fav.prc_confirmarecebimentoproduto( piditemdevolucao           => viditemdevolucaopedido   
                                                                               , pquantidadedevolvida       => vquantidadedevolucao     
                                                                               , pquantidadedefeito         => vquantidadedefeito    
                                                                               , piddefeito                 => :P286_IDDEFEITO
                                                                               , pquantidadeavaria          => vquantidadeavaria 
                                                                               , pquantidadetrocada         => vquantidadetrocada
                                                                               , pidprodutodetalhadotrocado => vidprodutodetalhadotrocado
                                                                               , pquantidadenaorecebida     => vquantidadenaorecebida 
                                                                               , pidusuario                 => :P0_IDUSUARIO);                                                                                                                    
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Processo executado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1383970255694291612
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                :P286_CONFIRMADO = 'N'
                and v('REQUEST') = 'CONFIRMARDEVOLUCAO'
                ```
        }
    )

    process salvar-quantidades-excluídas (
        name: Salvar QUANTIDADES EXCLUÍDAS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                   viditemexcluido                   number := to_number(:P286_IDITEMEXCLUIDO);
                   vquantidadedevolucao              number := to_number(:P286_QUANTIDADEDEVOLVIDA);
                   vquantidadedefeito                number := to_number(:P286_QUANTIDADEDEFEITO);
                   vquantidadeavaria                 number := to_number(:P286_QUANTIDADEAVARIA);
                   vquantidadetrocada                number := to_number(:P286_QUANTIDADETROCADA);
                   vidprodutodetalhadotrocado        number := to_number(:P286_PRODUTODETALHADOTROCADO);
                   vquantidadenaorecebida            number := to_number(:P286_QUANTIDADENAORECEBIDA);
                begin
                  -- Call the procedure
                  pck_protocolosatendimentos_fav.prc_confirmarecebimentoaltera ( piditemexcluido                 => viditemexcluido
                                                                               , pquantidadedevolvida            => vquantidadedevolucao     
                                                                               , pquantidadedefeito              => vquantidadedefeito    
                                                                               , piddefeito                      => :P286_IDDEFEITO
                                                                               , pquantidadeavaria               => vquantidadeavaria   
                                                                               , pquantidadetrocada              => vquantidadetrocada
                                                                               , pidprodutodetalhadotrocado      => vidprodutodetalhadotrocado
                                                                               , pquantidadenaorecebida          => vquantidadenaorecebida 
                                                                               , pidusuario                      => :P0_IDUSUARIO);
                                                                               
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Processo executado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1383971051781291614
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                :P286_CONFIRMADO = 'N'
                and v('REQUEST') = 'CONFIRMAREXCLUSAO'
                ```
        }
    )

    process salvar-quantidades-troca (
        name: Salvar QUANTIDADES TROCA
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                   viditempedidotrocado              number := to_number(:P286_IDITEMPEDIDOTROCADO);
                   vquantidadedevolucao              number := to_number(:P286_QUANTIDADEDEVOLVIDA);
                   vquantidadedefeito                number := to_number(:P286_QUANTIDADEDEFEITO);
                   vquantidadeavaria                 number := to_number(:P286_QUANTIDADEAVARIA);
                   vquantidadetrocada                number := to_number(:P286_QUANTIDADETROCADA);
                   vidprodutodetalhadotrocado        number := to_number(:P286_PRODUTODETALHADOTROCADO);
                   vquantidadenaorecebida            number := to_number(:P286_QUANTIDADENAORECEBIDA);
                begin
                  -- Call the procedure
                  pck_protocolosatendimentos_fav.prc_confirmarecebimentotroca ( piditempedidotroca               => viditempedidotrocado
                                                                               , pquantidadedevolvida            => vquantidadedevolucao     
                                                                               , pquantidadedefeito              => vquantidadedefeito    
                                                                               , piddefeito                      => :P286_IDDEFEITO
                                                                               , pquantidadeavaria               => vquantidadeavaria      
                                                                               , pquantidadetrocada              => vquantidadetrocada
                                                                               , pidprodutodetalhadotrocado      => vidprodutodetalhadotrocado
                                                                               , pquantidadenaorecebida          => vquantidadenaorecebida 
                                                                               , pidusuario                      => :P0_IDUSUARIO);                                                                                                                    
                end;
                ```
        }
        execution {
