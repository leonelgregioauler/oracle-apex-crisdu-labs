page 461 (
    name: Cadastro de Operação Padrão
    title: Cadastro de Operação Padrão
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG_24"';
    }

    region cadastro-de-operação-padrão (
        name: Cadastro de Operação Padrão
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P461_CODIGOOPERACAO (
        type: selectList
        label {
            label: Código Operação
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select o.codigo||'-'||o.descricao d,
                       o.codigo r
                from operacoesfiscais o
                where o.idtipo = :P461_IDTIPOOPERACAOFISCAL
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P461_IDTIPOOPERACAOFISCAL
        }
        layout {
            sequence: 30
            region: @cadastro-de-operação-padrão
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: CODIGOOPERACAO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P461_EMPRESADESTINO (
        type: shuttle
        label {
            label: Empresa Destino
            alignment: left
        }
        settings {
            showControls: movingOnly
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.idempresavirtualage||'-'||initcap(e.nome) d, 
                       e.idempresavirtualage r
                from empresasvirtualage e
                order by e.idempresavirtualage
                ```
        }
        layout {
            sequence: 90
            region: @cadastro-de-operação-padrão
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 5
        }
        source {
            type: databaseColumn
            databaseColumn: EMPRESADESTINO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P461_EMPRESASVIRTUALAGE (
        type: shuttle
        label {
            label: Empresa
            alignment: left
        }
        settings {
            showControls: movingOnly
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.idempresavirtualage||'-'||initcap(e.nome) d, 
                       e.idempresavirtualage r
                from empresasvirtualage e
                order by e.idempresavirtualage
                ```
        }
        layout {
            sequence: 70
            region: @cadastro-de-operação-padrão
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            height: 5
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: EMPRESASVIRTUALAGE
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P461_ESTADOS (
        type: shuttle
        label {
            label: Estados
            alignment: left
        }
        settings {
            showControls: movingOnly
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(es.nome)d,
                       es.idestado r
                from estadoscatal es
                where es.idpais = 1
                order by es.nome
                ```
        }
        layout {
            sequence: 80
            region: @cadastro-de-operação-padrão
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 5
        }
        source {
            type: databaseColumn
            databaseColumn: ESTADOS
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P461_IDOPERACAOPADRAO (
        type: hidden
        layout {
            sequence: 20
            region: @cadastro-de-operação-padrão
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDOPERACAOPADRAO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P461_IDTIPOOPERACAOFISCAL (
        type: selectList
        label {
            label: Tipo Operação
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(t.nome) d,
                       t.idtipooperacaofiscal r
                from tiposoperacoesfiscais t
                order by t.idtipooperacaofiscal
                ```
            displayExtraValues: false
        }
        layout {
            sequence: 10
            region: @cadastro-de-operação-padrão
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: IDTIPOOPERACAOFISCAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P461_ORDEM (
        type: numberField
        label {
            label: Ordem
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 60
            region: @cadastro-de-operação-padrão
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            type: databaseColumn
            databaseColumn: ORDEM
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P461_ORIGEM (
        type: plugin/select
        label {
            label: Origem
            alignment: left
        }
        settings {
            width: 100
        }
        lov {
            type: staticValues
            staticValues: STATIC:Call Center;C,Ecommerce;E
            displayExtraValues: false
            nullDisplayValue: - Nenhum -
        }
        layout {
            sequence: 50
            region: @cadastro-de-operação-padrão
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: ORIGEM
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P461_PRESENCIAL (
        type: switch
        label {
            label: Presencial
            alignment: left
        }
        settings {
            useDefaults: false
            onValue: S
            onLabel: Sim
            offValue: N
            offLabel: Não
        }
        layout {
            sequence: 40
            region: @cadastro-de-operação-padrão
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            type: databaseColumn
            databaseColumn: PRESENCIAL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 30
            region: @cadastro-de-operação-padrão
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 460
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Salvar
        layout {
            sequence: 10
            region: @cadastro-de-operação-padrão
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P461_IDOPERACAOPADRAO
        }
    )

    button delete (
        buttonName: DELETE
        label: Deletar
        layout {
            sequence: 40
            region: @cadastro-de-operação-padrão
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm('Deseja excluir este registro?','DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P461_IDOPERACAOPADRAO
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar Alterações
        layout {
            sequence: 20
            region: @cadastro-de-operação-padrão
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P461_IDOPERACAOPADRAO
        }
    )

    dynamicAction mostra-campo-de-empresa (
        name: Mostra campo de empresa
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P461_IDTIPOOPERACAOFISCAL
        }
        clientSideCondition {
            type: itemIsInList
            item: P461_IDTIPOOPERACAOFISCAL
            list: [
                1
                2
                6
            ]
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P461_EMPRESADESTINO
            }
            execution {
                sequence: 10
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P461_ESTADOS
                    P461_PRESENCIAL
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-set-value (
            action: setValue
            affectedElements {
                selectionType: items
                items: P461_EMPRESADESTINO
            }
            execution {
                sequence: 30
            }
        )

        action native-set-value-2 (
            action: setValue
            affectedElements {
                selectionType: items
                items: P461_ESTADOS
            }
            execution {
                sequence: 30
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P461_ESTADOS
                    P461_PRESENCIAL
                ]
            }
            execution {
                sequence: 20
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P461_EMPRESADESTINO
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

    )

    validation valida-campo-de-estados (
        name: Valida campo de estados
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                -- Created on 09/03/2021 by MAXBE 
                declare 
                  --
                  
                  --
                begin
                  --
                  if :P461_IDTIPOOPERACAOFISCAL in (1,2) and :P461_ESTADOS is null then
                    --
                    return false;
                    --
                  else
                    --
                    return true;
                    --
                  end if;
                  --
                end;
                ```
        }
        error {
            errorMessage: Campo de estados deve ter algum valor!
            associatedItem: @P461_ESTADOS
        }
        serverSideCondition {
            type: request!=Value
            value: DELETE
        }
    )

    validation valida-operação-duplicada (
        name: Valida operação duplicada
        execution {
            sequence: 20
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                -- Created on 08/06/2020 by MAX.BERKEUER 
                declare 
                  --
                  varray_estados varchar2(500) := :P461_ESTADOS;
                  varray_empresas varchar2(300) := :P461_EMPRESASVIRTUALAGE;
                  vpresencial char(1) := :P461_PRESENCIAL;
                  vmensagem_erro varchar2(500);
                  vnome_empresa varchar2(200);
                  vorigem varchar2(2) := :P461_ORIGEM;
                  --
                begin
                  --
                  /*Faz um for em cima de todas as operações*/
                  for c in (select o.idoperacaopadrao,
                                   es.column_value as estado,
                                   emp.column_value as empresa,
                                   o.presencial as presencial,
                                   o.ordem as ordem,
                                   o.idtipooperacaofiscal,
                                   o.origem 
                           from operacoespadroes o,
                                table(pck_util_fav.fnc_array_to_table(o.estados)) es,
                                table(pck_util_fav.fnc_array_to_table(o.empresasvirtualage)) emp)
                  loop
                    --
                    /*faz um for em cima das operações sendo cadastradas*/
                    for x in (select es2.column_value as estado,
                                     emp2.column_value as empresa,
                                     vpresencial as presencial,
                                     vorigem as origem
                             from table(pck_util_fav.fnc_array_to_table(varray_estados)) es2,
                                  table(pck_util_fav.fnc_array_to_table(varray_empresas)) emp2)
                    loop
                      --
                      if c.estado = x.estado and c.empresa = x.empresa and c.presencial = x.presencial and c.origem = x.origem
                         and c.ordem = :P461_ORDEM
                         and c.idtipooperacaofiscal = :P461_IDTIPOOPERACAOFISCAL
                         and (c.idoperacaopadrao != :P461_IDOPERACAOPADRAO or :P461_IDOPERACAOPADRAO is null) then
                        --
                        select initcap(e.nome)
                        into vnome_empresa
                        from empresasvirtualage e
                        where e.idempresavirtualage = x.empresa;
                        --
                        vmensagem_erro := 'Já existe uma operação para o estado '||pck_util_fav.fnc_retornanomeestado(x.estado)||'<br>'||
                                          'Empresa '||vnome_empresa||'<br>'||
                                          'Ordem '||:P461_ORDEM||'<br>'||
                                          'Presencial '||case
                                                           when :P461_PRESENCIAL = 'S' then
                                                             'Sim'
                                                           when :P461_PRESENCIAL = 'N' then
                                                             'Não'
                                                         end ||
                                          'Origem '||case
                                                       when :P461_ORIGEM = 'E' then
                                                         'Ecommerce'
                                                       when :P461_ORIGEM = 'C' then
                                                         'Call Center'
                                                     end 
                                          ||'<br>'||
                                          'ID Operação = '||c.idoperacaopadrao;
                        --
                        --dbms_output.put_line(vmensagem_erro);
                        --
                        return vmensagem_erro;
                        --
                      end if;
                      --
                    end loop;
                    --
                  end loop;
                  --
                end;
                ```
        }
    )

    process fetch-row-from-operacoespadroes (
        name: Fetch Row from OPERACOESPADROES
        type: autoRowFetch
        source {
            tableName: OPERACOESPADROES
            pkColumn: IDOPERACAOPADRAO
            pkItem: P461_IDOPERACAOPADRAO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 52155544055764010
        }
    )

    process process-row-of-operacoespadroes (
        name: Process Row of OPERACOESPADROES
        type: autoRowProcessing
        target {
            tableName: OPERACOESPADROES
            pkColumn: IDOPERACAOPADRAO
            pkItem: P461_IDOPERACAOPADRAO
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Ação Processada!
        }
        advanced {
            executionMappingIdentifier: 52155907471764012
        }
    )

    process reset-page (
        name: reset page
        type: clearSessionState
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 52156359944764012
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    branch (
        name: Go to page 460
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 460
                action: resetPagination
            }
        }
    )

)

