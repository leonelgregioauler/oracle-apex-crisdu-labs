page 102 (
    name: Relatório de Tipos de Protocolos de Atendimento
    title: Relatório de Tipos de Protocolos de Atendimento
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region tipos-de-protocolos-de-atenidmento (
        name: TIpos de Protocolos de Atenidmento
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.idtipoprotocolo
                     , v.descricao
                     , v.idtexto
                     , v.idtipoprotocolo editar
                from VW_TIPOSPROTOCOLOSATEND_FAV v
                where v.ididioma = :P0_IDIDIOMA
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 16465994772881717
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDTIPOPROTOCOLO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @DESCRICAO
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDTEXTO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @EDITAR
                layout {
                    sequence: 0
                }
            )

        )

        column DESCRICAO (
            type: textarea
            heading {
                heading: Descrição
            }
            layout {
                sequence: 20
            }
            validation {
                valueRequired: true
                maxLength: 100
            }
            source {
                databaseColumn: DESCRICAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column EDITAR (
            type: link
            heading {
                heading: Ver/Editar
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            link {
                target: {
                    page: 134
                    items: {
                        P134_IDTIPOPROTOCOLO: &IDTIPOPROTOCOLO.
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                databaseColumn: EDITAR
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column IDTEXTO (
            type: link
            heading {
                heading: Tradução Sistema
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            link {
                target: {
                    page: 100
                    items: {
                        P100_IDTEXTOTRADUZIDO: &IDTEXTO.
                    }
                    action: resetPagination
                }
                linkText: <b>Visualizar / Atualizar texto traduzido</b>
                linkAttributes: class="t-Button t-Button--sucess"
            }
            source {
                databaseColumn: IDTEXTO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column IDTIPOPROTOCOLO (
            type: numberField
            heading {
                heading: Código
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDTIPOPROTOCOLO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 134
                items: {
                    P134_IDTIPOPROTOCOLO:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

