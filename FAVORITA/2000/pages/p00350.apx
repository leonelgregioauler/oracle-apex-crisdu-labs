page 350 (
    name: Mapeamento dos Dados
    title: Mapeamento dos Dados
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    css {
        inline: ".rc-content-main {height: 400px; overflow: auto !important;}"
    }
    security {
        pageAccessProtection: unrestricted
    }

    region mapeamento-dos-dados (
        name: Mapeamento dos Dados
        type: dataUploadColMapping
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            customAttributes: style="width:100%;max-width:none;"
        }
        settings {
            dataLoadDefinition: @importar-arquivo-leads
        }
    )

    region progresso (
        name: Progresso
        type: list
        source {
            list: @data-load-wizard-progress-importar-arquivo-leads
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            excludeTitleFromTranslation: true
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 20
            region: @mapeamento-dos-dados
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 349
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button next (
        buttonName: NEXT
        label: Próximo
        layout {
            sequence: 30
            region: @mapeamento-dos-dados
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button previous (
        buttonName: PREVIOUS
        label: Anterior
        layout {
            sequence: 10
            region: @mapeamento-dos-dados
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 349
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process prepare-uploaded-data (
        name: Prepare Uploaded Data
        type: prepareUploadedData
        dataLoading {
            dataLoadDefinition: @importar-arquivo-leads
        }
        processingResult {
            insertCountItem: P352_INSERT_COUNT
            updateCountItem: P352_UPDATE_COUNT
            errorCountItem: P352_ERROR_COUNT
            reviewCountItem: P352_REVIEW_COUNT
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1436103967731817191
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 351
            }
        }
        serverSideCondition {
            whenButtonPressed: @next
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                                   begin
                                            for c1 in (select skip_validation
                                                      from apex_appl_load_tables
                                                      where name = 'Importar Arquivo Leads' and application_id = apex_application.g_flow_id )
                                            loop
                                                if c1.skip_validation = 'N' then return true;
                                                else return false;
                                                end if;
                                            end loop;
                                        end;
                ```
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 352
            }
        }
        serverSideCondition {
            whenButtonPressed: @next
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                                   begin
                                            for c1 in (select skip_validation
                                                      from apex_appl_load_tables
                                                      where name = 'Importar Arquivo Leads' and application_id = apex_application.g_flow_id )
                                            loop
                                                if c1.skip_validation = 'Y' then return true;
                                                else return false;
                                                end if;
                                            end loop;
                                        end;
                ```
        }
    )

)

