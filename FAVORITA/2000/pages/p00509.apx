page 509 (
    name: Cadastro de CEST
    title: Cadastro de CEST
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-cest (
        name: Cadastro CEST
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ee.idcest, ee.descricao
                from favorita.CEST ee
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 116885007627991410
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDCEST
                layout {
                    width: 556
                    sequence: 2
                }
            )

            displayColumn (
                column: @DESCRICAO
                layout {
                    width: 820
                    sequence: 3
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column DESCRICAO (
            type: textarea
            heading {
                heading: Descrição
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: DESCRICAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column IDCEST (
            type: numberField
            heading {
                heading: Código CEST
                alignment: center
            }
            settings {
                numberAlignment: center
                virtualKeyboard: text
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDCEST
                dataType: number
                primaryKey: true
            }
            columnFilter {
                lovType: none
            }
        )

    )

    region mensagem-retorno (
        name: Mensagem Retorno
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P509_RESPOSTA
        }
    )

    pageItem P509_RESPOSTA (
        type: textField
        label {
            label: Resposta
            alignment: left
        }
        layout {
            sequence: 10
            region: @mensagem-retorno
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    process operacao-dml (
        name: OPERACAO_DML
        type: executeCode
        editableRegion: @cadastro-cest
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vmd5   varchar(4000);
                  vdml   varchar(2);
                  vmensagemerro varchar(4000);
                  --
                begin  
                     --
                     :P509_RESPOSTA := '';
                     --
                     case :APEX$ROW_STATUS  
                     when 'C' then
                       --
                       PCK_CADASTROS_FAV.prc_cest    ( pidcest       => :IDCEST
                                                     , pdescricao    => :DESCRICAO
                                                     , pmd5          => vmd5
                                                     , poperacao_dml => 'I'
                                                     , pmensagemerro => vmensagemerro);
                       --
                     when 'U' then  
                       --
                       PCK_CADASTROS_FAV.prc_cest    ( pidcest       => :IDCEST
                                                     , pdescricao    => :DESCRICAO
                                                     , pmd5          => vmd5
                                                     , poperacao_dml => 'U'
                                                     , pmensagemerro => vmensagemerro);
                       --
                     when 'D' then  
                       --
                       PCK_CADASTROS_FAV.prc_cest    ( pidcest       => :IDCEST
                                                     , pdescricao    => :DESCRICAO
                                                     , pmd5          => vmd5
                                                     , poperacao_dml => 'D'
                                                     , pmensagemerro => vmensagemerro);
                       --
                     end case;  
                     --
                     :P509_RESPOSTA := vmensagemerro;
                     --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 116885711696991417
        }
    )

)

