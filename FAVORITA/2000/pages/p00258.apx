page 258 (
    name: Saídas Diversas
    title: Saídas Diversas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region saídas (
        name: Saídas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.idfechamento
                     , roman.pck_romance.fnc_nomefilial(s.idfilial) filial
                     , to_number(substr(f.semana,4,4)) "Ano"
                     , to_number(substr(f.semana,1,2)) "Semana"
                     , f.semana
                     , s.idsaida
                     , s.idfilialdest
                     , roman.pck_romance.fnc_nomefilial(s.idfilialdest) filialdestino
                     , s.descricao
                     , s.valortotal
                     , decode(s.tipo,'D','Dinheiro','Pagamento de Conta') tipo
                     , roman.pck_romance.fnc_nomecontafinan(s.idcontacontabil) "Conta Contabil" 
                     , roman.pck_romance.fnc_nomesubcontafinan(s.idsubcontacontabil) "Sub Conta Contabil"
                     , S.DATA
                     , s.idsaida ID
                     , ( select md.classificacaodespesa
                         from roman.matrizclassificacoesdespesas md
                         where md.idmatrizclassificacao = s.idmatrizclassificacao ) classificacao
                     , nvl((select count(1)
                            from roman.anexossaidas a
                            where a.idsaida = s.idsaida),0) qtdanexos
                     , nvl(s.valortotal*ff.fatorconversao,0) valorpagoconversao 
                     , 'S' origem
                from roman.fechamentossemanais f
                   , roman.saidasdiversas      s
                   , roman.vw_filiais ff
                where f.idfechamento = s.idfechamento
                  and f.idfilial = ff.idfilial
                  and  f.idfilialfavorita = :P0_IDFILIALCAIXA
                  and (:P0_IDFECHAMENTO = 999999999999  
                        or f.idfechamento = :P0_IDFECHAMENTO )
                order by 1, 2 desc, 3 desc
                ```
        }
        layout {
            sequence: 10
            slot: body-3
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Nenhuma saída incluída.
            whenMoreDataFound: This query returns more than #MAX_ROW_COUNT# rows, please filter your data to ensure complete results.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            pivot: false
            savePublicReport: true
        }
        download {
            formats: [
                csv
                html
            ]
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 5000585788632219194
        }

