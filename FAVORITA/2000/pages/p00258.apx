    button novasaida (
        buttonName: NOVASAIDA
        label: Nova Saída
        layout {
            sequence: 10
            region: @saídas
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 469
                items: {
                    P469_IDSAIDA:
                    P469_IDFECHAMENTO: &P0_IDFECHAMENTO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from fechamentossemanais s
                where idfechamento = :P0_IDFECHAMENTO
                  and concluido = 'N'
                ```
        }
    )

    button revisar-saidas (
        buttonName: REVISAR_SAIDAS
        label: Revisar Saídas
        layout {
            sequence: 20
            region: @saídas
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 470
                items: {
                    P470_ORIGEM: S
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util.fnc_verificaacesso(2309,v('APP_USER') ) = 'S'
                ```
        }
    )

