    process confirma-ajustes-fiscais (
        name: "Confirma Ajustes Fiscais "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_protocolosatendimentos_fav.prc_confirmaajustesfiscais(pidprotocoloatendimento => :P242_IDEDITAR,
                                                                            pidusuario => :P0_IDUSUARIO);
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 766397224537688871
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 242
                items: {
                    P242_IDPEDIDO: &P242_IDPEDIDO.
                    P242_TIPORELATORIO: &P242_TIPORELATORIO.
                    P242_IDPROTOCOLOATENDIMENTO: &P242_IDPROTOCOLOATENDIMENTO.
