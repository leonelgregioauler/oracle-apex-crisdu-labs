page 242 (
    name: Confirmar Ajustes Fiscais
    title: Confirmar Ajustes Fiscais
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_confirmarajustes(pid)
            {
              document.getElementById("P242_IDEDITAR").value = pid;
              apex.submit('CONFIRMAR');
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region confirmar-ajustes-fiscais-de-devoluções-de-pedidos (
        name: Confirmar Ajustes Fiscais de Devoluções de Pedidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.idprotocoloatendimento
                     , ( select pa.justificativa
                         from protocolosatendimentos pa
                         where pa.idprotocoloatendimento = i.idprotocoloatendimento ) observacaoprotocolo
                     , i.idpedido 
                     , ( select p.idpedidovirtualage
                         from pedidos p
                         where p.idpedido = i.idpedido
                           and p.idpedidovirtualage is not null ) codvirtualage
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||i.idpedido ,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' irparapedido
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':130:'||v('APP_SESSION')||'::NO::P130_IDPROTOCOLOATENDIMENTO:'||i.idprotocoloatendimento ,'SESSION')||''',''_blank''); void(0)"><img src="#IMAGE_PREFIX#magnifying_glass_white_bg.gif" alt=""/></a>' irparaprotocolo
                     , '<a href="javascript:apex.confirm(''Deseja realmente confirmar os ajustes do pedido '||i.idpedido||' do protocolo '||idprotocoloatendimento||'?'', { request:''CONFIRMAR'',set:{''P242_IDEDITAR'':'|| idprotocoloatendimento ||'}})";><img src="#APP_IMAGES#ok.png"  border="0"></a>' confirmarajustes
                from vw_itensdevolucaopedidos_fav i
                where i.ididioma = 1
                  and i.idusuariofiscal is null
                  and i.dataconfirmacaofiscal is null
                  and exists ( select 1
                               from pedidos p
                               where p.idpedido = i.idpedido
                                 and p.idpedidovirtualage is not null )
                  and ( :P242_TIPORELATORIO = 'PD' and i.idpedido = :P242_IDPEDIDO
                      or :P242_TIPORELATORIO = 'PP' and exists ( select 1
                                                                 from protocolosatendimentos
                                                                 where idpedido = i.idpedido 
                                                                   and idprotocoloatendimento = :P242_IDPROTOCOLOATENDIMENTO ))
                group by i.idpedido , i.idprotocoloatendimento
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 3271887067720283150
        }

