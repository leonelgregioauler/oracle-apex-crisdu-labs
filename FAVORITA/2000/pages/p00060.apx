page 60 (
    name: Cadastro de Permissões Tipos Tarefas
    title: Permissões Tipos Tarefas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region permissões-tipos-tarefas (
        name: Permissões Tipos Tarefas
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P60_BUSCARTAREFA (
        type: radioGroup
        label {
            label: Permite Buscar Tarefa
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-simnao
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @permissões-tipos-tarefas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P60_IDPERMISSAOTIPOTAREFA (
        type: hidden
        layout {
            sequence: 10
            region: @permissões-tipos-tarefas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P60_IDTIPOTAREFA (
        type: selectList
        label {
            label: Tipo de Tarefa
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-tipostarefas
            nullDisplayValue: - Selecione o Tipo de Tarefa -
        }
        layout {
            sequence: 30
            region: @permissões-tipos-tarefas
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P60_IDUSUARIO (
        type: popupLov
        label {
            label: Usuários
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sharedComponent
            lov: @lov-usuarios
        }
        layout {
            sequence: 20
            region: @permissões-tipos-tarefas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: "- Selecione o usuário - "
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P60_INCLUIRTAREFA (
        type: radioGroup
        label {
            label: Permite Incluir Tarefa
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-simnao
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @permissões-tipos-tarefas
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P60_MD5 (
        type: hidden
        layout {
            sequence: 60
            region: @permissões-tipos-tarefas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P60_OPERACAO_DML (
        type: hidden
        layout {
            sequence: 70
            region: @permissões-tipos-tarefas
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 50
            region: @permissões-tipos-tarefas
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P60_IDPERMISSAOTIPOTAREFA
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 40
            region: @permissões-tipos-tarefas
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P60_IDPERMISSAOTIPOTAREFA
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 30
            region: @permissões-tipos-tarefas
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 59
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 20
            region: @permissões-tipos-tarefas
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P60_IDPERMISSAOTIPOTAREFA
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @permissões-tipos-tarefas
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P60_IDPERMISSAOTIPOTAREFA
        }
    )

    validation idtipotarefa-obrigatório (
        name: IDTIPOTAREFA obrigatório
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P60_IDTIPOTAREFA
        }
        error {
            errorMessage: Tipo de Tarefa deve ser informado.
            associatedItem: @P60_IDTIPOTAREFA
        }
    )

    validation idusuario-obrigatório (
        name: IDUSUARIO obrigatório
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P60_IDUSUARIO
        }
        error {
            errorMessage: Usuário deve ser informado.
            associatedItem: @P60_IDUSUARIO
        }
    )

    process consulta-permissões-tipos-tarefas (
        name: Consulta Permissões Tipos Tarefas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                #OWNER#.PCK_CADASTROS_FAV.PRC_PERMISSOESTIPOSTAREFAS (
                  PIDPERMISSAOTIPOTAREFA => :P60_IDPERMISSAOTIPOTAREFA,
                  PIDUSUARIO => :P60_IDUSUARIO,
                  PIDTIPOTAREFA => :P60_IDTIPOTAREFA,
                  PBUSCARTAREFA => :P60_BUSCARTAREFA,
                  PINCLUIRTAREFA => :P60_INCLUIRTAREFA,
                  PMD5 => :P60_MD5,
                  POPERACAO_DML => 'S');
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 3253950265384338
        }
    )

    process limpar-campos-ao-sair (
        name: Limpar Campos ao Sair
        type: clearSessionState
        execution {
            sequence: 10
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 3389139715953801
        }
    )

    process limpar-campos-para-adicionar (
        name: Limpar Campos para Adicionar
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 3389239494953802
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    process operação-dml-em-permissões-tipos-tarefas (
        name: Operação DML em Permissões Tipos Tarefas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  #OWNER#.PCK_CADASTROS_FAV.PRC_PERMISSOESTIPOSTAREFAS (
                    PIDPERMISSAOTIPOTAREFA => :P60_IDPERMISSAOTIPOTAREFA,
                    PIDUSUARIO => :P60_IDUSUARIO,
                    PIDTIPOTAREFA => :P60_IDTIPOTAREFA,
                    PBUSCARTAREFA => :P60_BUSCARTAREFA,
                    PINCLUIRTAREFA => :P60_INCLUIRTAREFA,
                    PMD5 => :P60_MD5,
                    POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 3383133919857597
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 60
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

)

