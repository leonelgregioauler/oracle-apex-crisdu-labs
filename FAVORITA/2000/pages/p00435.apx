page 435 (
    name: Monitoramento Integrações WideCommerce
    title: Monitoramento Integrações WideCommerce
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    htmlHeader {
        htmlHeader:
            ```html
            <!-- <meta http-equiv="refresh" content="50">   -->
            
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region contadores (
        name: Contadores
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select count(distinct pes.idpessoa) qtdpessoas
                from pessoas pes
                   , vendedoras v
                where pes.idpessoa = v.idpessoa
                and trunc(nvl(pes.dataintegracao, sysdate)) >= trunc(sysdate) - 3
                and pes.situacaointegracao = 'I'
                and pes.idpais = 1
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/badge-list
            templateOptions: [
                #DEFAULT#
                t-BadgeList--xlarge
                t-BadgeList--fixed
                t-BadgeList--circular
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column QTDPESSOAS (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: Pessoas Integradas
                alignment: center
            }
            layout {
                sequence: 1
            }
            link {
                target: {
                    page: 436
                    items: {
                        P436_SITUACAOINTEGRACAO: I
                    }
                    action: resetPagination
                }
                linkText: #QTDPESSOAS#
            }
        )

    )

    region contadores-2 (
        name: Contadores
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select count(distinct pes.idpessoa) qtdpessoas
                from pessoas pes
                   , vendedoras v
                where pes.idpessoa = v.idpessoa
                --and trunc(nvl(dataintegracao, sysdate)) >= trunc(sysdate)
                and situacaointegracao = 'E'
                and pes.idpais = 1
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/badge-list
            templateOptions: [
                #DEFAULT#
                t-BadgeList--xlarge
                t-BadgeList--fixed
                t-BadgeList--circular
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

        column QTDPESSOAS (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: Pessoas não integradas
                alignment: center
            }
            layout {
                sequence: 1
            }
            link {
                target: {
                    page: 436
                    items: {
                        P436_SITUACAOINTEGRACAO: E
                    }
                    action: resetPagination
                }
                linkText: #QTDPESSOAS#
            }
        )

    )

)

