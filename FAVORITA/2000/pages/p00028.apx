page 28 (
    name: Cadastro de Situações Cobrança
    title: Situações Cobrança
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }
    advanced {
        reloadOnSubmit: always
    }

    region situações-cobrança (
        name: Situações Cobrança
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P28_DESCRICAOSISTEMA (
        type: textField
        label {
            label: Descrição do Sistema
            alignment: left
        }
        layout {
            sequence: 20
            region: @situações-cobrança
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P28_DESCRICAOSITE (
        type: textField
        label {
            label: Descrição do Site
            alignment: left
        }
        layout {
            sequence: 30
            region: @situações-cobrança
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P28_IDSITUACAOCOBRANCA (
        type: hidden
        layout {
            sequence: 10
            region: @situações-cobrança
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P28_IDTEXTOSISTEMA (
        type: hidden
        layout {
            sequence: 50
            region: @situações-cobrança
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P28_IDTEXTOSITE (
        type: hidden
        layout {
            sequence: 60
            region: @situações-cobrança
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P28_MD5 (
        type: hidden
        layout {
            sequence: 70
            region: @situações-cobrança
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P28_OPERACAO_DML (
        type: hidden
        layout {
            sequence: 80
            region: @situações-cobrança
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 50
            region: @situações-cobrança
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P28_IDSITUACAOCOBRANCA
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 40
            region: @situações-cobrança
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P28_IDSITUACAOCOBRANCA
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 30
            region: @situações-cobrança
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 27
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 20
            region: @situações-cobrança
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P28_IDSITUACAOCOBRANCA
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @situações-cobrança
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P28_IDSITUACAOCOBRANCA
        }
    )

    validation descricaosistema-obrigatório (
        name: DESCRICAOSISTEMA obrigatório
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P28_DESCRICAOSISTEMA
        }
        error {
            errorMessage: Descrição do sistema deve ter um valor.
            associatedItem: @P28_DESCRICAOSISTEMA
        }
    )

    validation descricaosite-obrigatório (
        name: DESCRICAOSITE obrigatório
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P28_DESCRICAOSITE
        }
        error {
            errorMessage: Descrição do site deve ter um valor.
            associatedItem: @P28_DESCRICAOSITE
        }
    )

    process consulta-situações-cobrança (
        name: Consulta Situações Cobrança
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                #OWNER#.PCK_CADASTROSSITUACOES_FAV.PRC_SITUACOESCOBRANCA (
                  PIDSITUACAOCOBRANCA => :P28_IDSITUACAOCOBRANCA,
                  PDESCRICAOSISTEMA => :P28_DESCRICAOSISTEMA,
                  PDESCRICAOSITE => :P28_DESCRICAOSITE,
                  PMD5 => :P28_MD5,
                  POPERACAO_DML => 'S');
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 3450092252339649
        }
    )

    process limpar-campos-ao-sair (
        name: Limpar Campos ao Sair
        type: clearSessionState
        execution {
            sequence: 10
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 3010861238390108
        }
    )

    process limpar-campos-para-adicionar (
        name: Limpar Campos para Adicionar
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 3010900799390109
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    process operação-dml-em-situações-cobrança (
        name: Operação DML em Situações Cobrança
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  #OWNER#.PCK_CADASTROSSITUACOES_FAV.PRC_SITUACOESCOBRANCA (
                    PIDSITUACAOCOBRANCA => :P28_IDSITUACAOCOBRANCA,
                    PDESCRICAOSISTEMA => :P28_DESCRICAOSISTEMA,
                    PDESCRICAOSITE => :P28_DESCRICAOSITE,
                    PMD5 => :P28_MD5,
                    POPERACAO_DML => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 3009192330357532
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 28
            }
        }
        serverSideCondition {
            whenButtonPressed: @atualizar
        }
    )

)

