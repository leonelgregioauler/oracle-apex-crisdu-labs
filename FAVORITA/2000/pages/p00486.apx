page 486 (
    name: Relatório de pedidos
    title: Relatório de pedidos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-size720x480
            ]
        }
        advanced {
            htmlDomId: FILTRO
            regionDisplaySelector: true
        }
    )

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pedidos (
        name: Pedidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select * from table(pck_relatorios_fav.fnc_listapedidos2 (  popcao                   => :P486_OPCAO,
                                                                           pidpedido                => :P486_NRPEDIDO,
                                                                           pidfilialfavorita        => :P486_IDFILIALFAVORITA,
                                                                           pidfilialromance         => :P486_IDFILIALROMANCE,
                                                                           pidrepresentante         => :P486_IDREPRESENTANTE,
                                                                           pidvendedora             => :P486_IDVENDEDORA,
                                                                           pidpedidowidecomm        => :P486_NRPEDIDOWIDECOMMERCE, 
                                                                           pdataemissaoinicial      => :P486_DATAEMISSAOINICIAL,
                                                                           pdataemissaofinal        => :P486_DATAEMISSAOFINAL,
                                                                           pdata                    => :P486_DATA,
                                                                           pdatainicial             => :P486_DATAINI,
                                                                           pdatafinal               => :P486_DATAFIM,
                                                                           pformaentrega            => :P486_FORMAENTREGA,
                                                                           pfiltroaplicado          => :P486_FILTROAPLICADO,
                                                                           pidpostoavancado         => :P486_IDPOSTOAVANCADO,
                                                                           pidtarefa                => :P486_IDTAREFA,
                                                                           pvalortotal              => :P486_VLRTOTAL,
                                                                           ptipopedido              => :P486_TIPOPEDIDO,
                                                                           ppa                      => :P486_PA,
                                                                           ppedidocancelado         => :P486_PEDIDOCANCELADO,
                                                                           patendente               => :P486_ATENDENTE,
                                                                           pidusuario               => :P0_IDUSUARIO ));
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P486_OPCAO
            value: P
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 93998923938735735
        }

