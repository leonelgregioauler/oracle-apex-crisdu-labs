    dynamicAction abre-filtro (
        name: Abre Filtro
        execution {
            sequence: 20
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P486_FILTROAPLICADO is null
                  and :P0_NUMEROPOSICAOATENDIMENTO is not null
                ```
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: javascript: openModal('FILTRO');
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction selecionar-data (
        name: Selecionar data
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P486_DATA
        }
        clientSideCondition {
            type: item!=value
            item: P486_DATA
            value: N
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P486_DATAINI
                    P486_DATAFIM
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P486_DATAINI
            }
            execution {
                sequence: 20
            }
        )

        action native-set-value (
            action: setValue
            affectedElements {
                selectionType: items
                items: [
                    P486_DATAINI
                    P486_DATAFIM
                ]
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P486_DATAINI
                    P486_DATAFIM
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    validation valida-período-de-emissão (
        name: Valida Período de Emissão
        execution {
            sequence: 10
        }
        validation {
            type: functionBodyReturningBoolean
            plsqlFunctionBody:
                ```plsql
                begin
                 case when months_between (:P486_DATAEMISSAOFINAL,:P486_DATAEMISSAOINICIAL) > 6 then 
                            return false;
                        else 
                            return true;
                       end case;
                end;
                ```
        }
        error {
            errorMessage: Selecione um período máximo de 6 meses
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

    branch (
        name: Filtrar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 486
                items: {
                    P486_DATA: &P486_DATA.
                    P486_DATAINI: &P486_DATAINI.
                    P486_DATAFIM: &P486_DATAFIM.
                    P486_IDFILIALROMANCE: &P486_IDFILIALROMANCE.
                    P486_IDPOSTOAVANCADO: &P486_IDPOSTOAVANCADO.
                    P486_IDREPRESENTANTE: &P486_IDREPRESENTANTE.
                    P486_IDVENDEDORA: &P486_IDVENDEDORA.
                    P486_NRPEDIDO: &P486_NRPEDIDO.
                    P486_IDTAREFA: &P486_IDTAREFA.
                    P486_VLRTOTAL: &P486_VLRTOTAL.
                    P486_FORMAENTREGA: &P486_FORMAENTREGA.
                    P486_IDFILIALFAVORITA: &P486_IDFILIALFAVORITA.
                    P486_FILTROAPLICADO: S
                    P486_TIPOPEDIDO: &P486_TIPOPEDIDO.
                    P486_PA: &P486_PA.
                    P486_ATENDENTE: &P486_ATENDENTE.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

