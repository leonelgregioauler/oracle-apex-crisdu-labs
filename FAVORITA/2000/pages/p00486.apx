                ```sql
                select roman.pck_romance.fnc_nomerepresentante(idrepresentante) display_value
                     , idrepresentante
                from representantes
                where (:P486_IDFILIALROMANCE is null or
                    ( :P486_IDFILIALROMANCE is not null and idgerente in ( select idgerente from gerentes where idfilial = :P486_IDFILIALROMANCE) ))
                order by 1
