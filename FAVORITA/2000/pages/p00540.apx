        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select k.referencia||' - '||k.descricao d
                     , k.idkitvenda r
                from kitsvendas k
                --where k.ativo = 'S'
                order by 1
                ```
        }
        layout {
            sequence: 120
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

