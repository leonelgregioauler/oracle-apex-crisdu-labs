    dynamicAction filtra-referencias (
        name: Filtra Referencias
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P540_REFERENCIA
        }
        clientSideCondition {
            type: item=value
            item: P540_REFERENCIA
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: button
                button: @filtrar-referencias
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: button
                button: @filtrar-referencias
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction filtrar (
        name: Filtrar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

