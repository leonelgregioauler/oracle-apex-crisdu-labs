page 540 (
    name: Relatorio Estoques - VPD
    title: "Relatorio Estoques "
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function buscar_virtual(vitem)
            {
              apex.item('P173_IDESTOQUEAJUSTAR').setValue(vitem);
              var answer = confirm("Confirma que quer INTEGRAR o estoque do item com o valor que esta no Virtual Age?")
              if (answer)
              {
                apex.submit('BUSCAVIRTUAL');
              }
                
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util_fav.fnc_verificaacesso(34251,:P0_IDUSUARIO) = 'S'
                ```
        }
    )

    region estoques (
        name: Estoques
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.*
                  from VWFA_APP2000_P540_REL001 V
                 where :P540_FILTRAR = 'S'
                   and (:P540_IDFILIALFAVORITA   is not null or 
                        :P540_IDPRODUTODETALHADO is not null or 
                        :P540_IDFORNECEDOR  is not null or 
                        :P540_FILIAIS = 'S')
                 
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 10000
        }
        messages {
            whenNoDataFound: Utilize os Filtros!
        }
        advanced {
            savedReportMappingIdentifier: 2187753800621985722
        }

