        }
        value {
            format: decimal
        }

        series contas-do-ano (
            name: Contas do Ano
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select roman.pck_romance.fnc_nomecontafinan(d.idcontacontabil) conta
                         , d.valor
                    from ( select d.idcontacontabil
                                , sum(d.valor) valor
                           from roman.despesas d
                           where d.idfilialfavorita is not null
                             and d.idcontacontabil is not null
                             and ( :P393_TIPO_DATA = 'T'
                                or ( :P393_TIPO_DATA = 'P' and trunc(d.datalancamento) between to_date(:P393_DATAINICIO_G) and to_date(:P393_DATAFIM_G) ) )
                             and exists ( select 1
                                          from filiaisfavorita f
                                          where f.idfilialfavorita = d.idfilialfavorita
                                            and ( :P393_IDFILIALFAVORITA_G = -1 or f.idfilialfavorita = :P393_IDFILIALFAVORITA_G )
                                            and f.tipofilial       = 'L' )
                             and d.ano = to_char(sysdate,'RRRR')
                           group by d.idcontacontabil ) d
                    ```
                pageItemsToSubmit: [
                    P393_DATAINICIO_G
                    P393_DATAFIM_G
                    P393_TIPO_DATA
                    P393_IDFILIALFAVORITA_G
                ]
            }
            columnMapping {
                label: CONTA
                value: VALOR
            }
        )

    )

    region despesas-por-subconta (
        name: Despesas por SubConta
        type: chart
