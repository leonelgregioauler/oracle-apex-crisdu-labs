        series subcontas-do-ano (
            name: SubContas do Ano
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select d.subconta
                         , valor
                    from ( select roman.pck_romance.fnc_nomesubcontafinan(d.idsubcontacontabil) subconta
                                , d.valor
                           from ( select d.idsubcontacontabil
                                       , sum(d.valor) valor
                                  from roman.despesas d
                                  where d.idfilialfavorita is not null
                                    and d.idsubcontacontabil is not null
                                    and ( :P393_TIPO_DATA = 'T'
                                      or ( :P393_TIPO_DATA = 'P' and trunc(d.datalancamento) between to_date(:P393_DATAINICIO_G) and to_date(:P393_DATAFIM_G) ) )
                                    and exists ( select 1
                                                 from filiaisfavorita f
                                                 where f.idfilialfavorita = d.idfilialfavorita
                                                   and ( :P393_IDFILIALFAVORITA_G = -1 or f.idfilialfavorita = :P393_IDFILIALFAVORITA_G )
                                                   and f.tipofilial       = 'L' )
                                    and d.ano = to_char(sysdate,'RRRR')
                                  group by d.idsubcontacontabil
                                  order by 2 desc ) d
                           where rownum <= 15 ) d
                    ```
                pageItemsToSubmit: [
                    P393_DATAINICIO_G
                    P393_DATAFIM_G
                    P393_TIPO_DATA
                    P393_IDFILIALFAVORITA_G
                ]
            }
            columnMapping {
                label: SUBCONTA
                value: VALOR
            }
        )

    )

