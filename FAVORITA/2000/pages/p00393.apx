    region controle-de-despesas (
        name: Controle de Despesas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nomefilialfavorita
                     , nvl(d.qtd,0) qtd
                     , nvl(d.valor,0) valor
                from filiaisfavorita f
                   , ( select d.idfilialfavorita
                            , count(1) qtd
                            , sum(d.valor) valor
                       from roman.despesas d
                       where d.idfilialfavorita is not null 
                         and ( :P393_TIPOSEMANA is null
                            or ( :P393_TIPOSEMANA = 'S' and exists ( select 1
                                                                     from fechamentossemanais fs
                                                                     where fs.idfechamento     = d.idfechamento
                                                                       and fs.idfilialfavorita = d.idfilialfavorita
                                                                       and fs.idsemana = :P393_SEMANA ) )
                            or ( :P393_TIPOSEMANA = 'P' and trunc(d.datalancamento) between to_date(:P393_DATAINICIO) and to_date(:P393_DATAFIM) ) )
                         and ( :P393_TIPOCONTA = 'T'
                            or ( :P393_TIPOCONTA = 'C' and d.idcontacontabil = :P393_IDCONTA )
                            or ( :P393_TIPOCONTA = 'S' and d.idsubcontacontabil = :P393_IDSUBCONTA ) ) 
                       group by d.idfilialfavorita ) d
                where f.tipofilial = 'L'
                  and f.ativo = 'S'
                  and f.idfilialfavorita = d.idfilialfavorita(+)
                  and ( :P393_IDFILIALFAVORITA = -1 or f.idfilialfavorita = :P393_IDFILIALFAVORITA )
                order by f.idfilialfavorita
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1548136984110207809
        }

        column NOMEFILIALFAVORITA (
            type: plainText
            heading {
