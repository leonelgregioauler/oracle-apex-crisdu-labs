    region acompanhamento-de-despesas-por-mês (
        name: Acompanhamento de Despesas Por Mês
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select null link
                     , to_number(to_char(datalancamento,'MM')) mes
                     , sum(d.valor) "2018"
                from roman.despesas d
                where extract ( year from d.datalancamento) = 2018
                  and exists ( select 1
                               from filiaisfavorita f
                               where f.idfilialfavorita = d.idfilialfavorita
                                 and f.tipofilial       = 'L'
                                 and f.ativo            = 'S' )
                group by to_number(to_char(datalancamento,'RRRR')) 
                       , to_number(to_char(datalancamento,'MM'))
                order by to_number(to_char(datalancamento,'RRRR')) 
                       , to_number(to_char(datalancamento,'MM'))
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        security {
            escapeSpecialChars: false
        }
        chart {
            type: line
        }
        title {
            title: Acompanhamento de Despesas Por Mês
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        animation {
            onDataChange: none
        }
        tooltip {
            showSeriesName: false
        }
        legend {
            position: top
            hideAndShowBehavior: none
        }

