    region despesas-conta (
        name: Despesas Conta
        type: chart
        layout {
            sequence: 10
            parentRegion: @gráfico-de-despesas
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
