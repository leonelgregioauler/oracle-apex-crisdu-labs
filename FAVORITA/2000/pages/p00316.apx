page 316 (
    name: Leitura de Mensagem
    title: Leitura de Mensagem
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 80%
        height: 80%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region mensagem (
        name: Mensagem
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.mensagem
                from favorita.mensagensinternas m
                where m.idmensageminterna = :P316_IDMENSAGEMINTERNA
                ```
        }
        layout {
            sequence: 10
            parentRegion: @mensagem-2
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1441652704974675130
        }

        column MENSAGEM (
            type: plainText
            heading {
                heading: Mensagem
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 14766187 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn MENSAGEM (
                sequence: 1
            )

        )

    )

    region mensagem-2 (
        name: Mensagem
        type: staticContent
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region new (
        name: New
        type: staticContent
        layout {
            sequence: 50
            slot: contentBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region resposta (
        name: Resposta
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @mensagem-2
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from favorita.mensagensinternas m
                where m.idmensageminterna = :P316_IDMENSAGEMINTERNA
                  and m.idchamado is not null
                ```
        }
    )

    pageItem P316_IDMENSAGEMINTERNA (
        type: hidden
        layout {
            sequence: 20
            region: @mensagem
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P316_RESPOSTA (
        type: textarea
        label {
            label: Resposta
            alignment: left
        }
        settings {
            autoHeight: true
        }
        layout {
            sequence: 10
            region: @resposta
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--xlarge
            ]
            width: 30
            height: 5
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button responder (
        buttonName: RESPONDER
        label: Responder
        layout {
            sequence: 20
            region: @new
            slot: bottom
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from favorita.mensagensinternas m
                where m.idmensageminterna = :P316_IDMENSAGEMINTERNA
                  and m.idchamado is not null
                ```
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 10
            region: @new
            slot: bottom
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconRight
            ]
            icon: fa-reply
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 358
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process insere-chamado (
        name: Insere Chamado
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidchamado  number;
                  --
                begin
                  --
                  select m.idchamado
                  into vidchamado
                  from favorita.mensagensinternas m
                  where m.idmensageminterna = :P316_IDMENSAGEMINTERNA;
                  --
                  insert into roman.historicochamados values(roman.seq_idhistoricochamado.nextval,vidchamado,sysdate,:P316_RESPOSTA,'S',v('APPUSER'),sysdate,'S',null,0);
                  --
                  commit;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Resposta Enviada
        }
        error {
            errorMessage: Erro ao enviar resposta
        }
        advanced {
            executionMappingIdentifier: 1441654025456675143
        }
        serverSideCondition {
            whenButtonPressed: @responder
        }
    )

    process verificar-e-marcar-lido (
        name: Verificar E marcar Lido
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  update favorita.mensagensinternas m
                     set m.dataleitura = sysdate
                       , m.idusuarioleitura = :P0_IDUSUARIO
                  where m.dataleitura is null
                    and m.idmensageminterna = :P316_IDMENSAGEMINTERNA;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 1441653955874675142
        }
    )

)

