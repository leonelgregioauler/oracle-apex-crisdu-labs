page 409 (
    name: Documentação Favorita
    title: Documentação Favorita
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 90%
        height: 90%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region documentação-favorita (
        name: Documentação Favorita
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    region itens-documentação-favorita (
        name: Itens Documentação Favorita
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id.iditemdocumentacao,
                       id.iddocumentacao,
                       id.tituloitemdocumentacao,
                       id.descricaoitemdocumentacao,
                       id.datainclusao,
                       id.dataatualizacao
                from itensdocumentacaofavorita id
                where id.iddocumentacao = :P409_IDDOCUMENTACAO;
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 6323570797204785335
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDITEMDOCUMENTACAO
                layout {
                    width: 80
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDDOCUMENTACAO
                layout {
                    show: false
                    sequence: 1
                }
            )

            displayColumn (
                column: @TITULOITEMDOCUMENTACAO
                layout {
                    width: 300
                    sequence: 2
                }
            )

            displayColumn (
                column: @DESCRICAOITEMDOCUMENTACAO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @DATAINCLUSAO
                layout {
                    width: 150
                    sequence: 4
                }
            )

            displayColumn (
                column: @DATAATUALIZACAO
                layout {
                    width: 150
                    sequence: 5
                }
            )

        )

        column DATAATUALIZACAO (
            type: datePickerJquery
            heading {
                heading: Data Atualização
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                databaseColumn: DATAATUALIZACAO
                dataType: date
            }
        )

        column DATAINCLUSAO (
            type: datePickerJquery
            heading {
                heading: Data Inclusão
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                databaseColumn: DATAINCLUSAO
                dataType: date
            }
        )

        column DESCRICAOITEMDOCUMENTACAO (
            type: textarea
            heading {
                heading: Descrição Item
                alignment: center
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: DESCRICAOITEMDOCUMENTACAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column IDDOCUMENTACAO (
            type: numberField
            heading {
                heading: Iddocumentacao
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                databaseColumn: IDDOCUMENTACAO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column IDITEMDOCUMENTACAO (
            type: numberField
            heading {
                heading: Editar
                alignment: center
            }
            settings {
                numberAlignment: center
                virtualKeyboard: text
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            link {
                target: {
                    page: 410
                    items: {
                        P410_IDITEMDOCUMENTACAO: &IDITEMDOCUMENTACAO.
                        P410_IDITEMDOCUMENTACAOANEXO: &IDITEMDOCUMENTACAO.
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                databaseColumn: IDITEMDOCUMENTACAO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column TITULOITEMDOCUMENTACAO (
            type: textarea
            heading {
                heading: Título Item
                alignment: center
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 500
            }
            source {
                databaseColumn: TITULOITEMDOCUMENTACAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

    )

    pageItem P409_DATAATUALIZACAO (
        type: datePickerJquery
        label {
            label: Data Atualização
            alignment: left
        }
        layout {
            sequence: 50
            region: @documentação-favorita
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 30
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P409_DATAINCLUSAO (
        type: datePickerJquery
        label {
            label: Data Inclusão
            alignment: left
        }
        layout {
            sequence: 40
            region: @documentação-favorita
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 30
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P409_DESCRICAODOCUMENTACAO (
        type: textarea
        label {
            label: Descrição
            alignment: left
        }
        layout {
            sequence: 30
            region: @documentação-favorita
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 145
            height: 5
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P409_IDDOCUMENTACAO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @documentação-favorita
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P409_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @documentação-favorita
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P409_OPERACAO_DML (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @documentação-favorita
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P409_TITULODOCUMENTACAO (
        type: textField
        label {
            label: Título
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @documentação-favorita
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 175
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 50
            region: @documentação-favorita
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from permissoesdocumentacaofavorita pd
                where pd.idusuario      = :P0_IDUSUARIO
                and pd.permissaototal   = 'S'
                and :P409_IDDOCUMENTACAO is not null
                ```
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 30
            region: @documentação-favorita
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from permissoesdocumentacaofavorita pd
                where pd.idusuario      = :P0_IDUSUARIO
                and pd.permissaototal   = 'S'
                and :P409_IDDOCUMENTACAO is not null
                ```
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 40
            region: @documentação-favorita
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from permissoesdocumentacaofavorita pd
                where pd.idusuario      = :P0_IDUSUARIO
                and pd.permissaototal   = 'S'
                and :P409_IDDOCUMENTACAO is null
                ```
        }
    )

    button novo (
        buttonName: NOVO
        label: Adicionar Documento
        layout {
            sequence: 10
            region: @documentação-favorita
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from permissoesdocumentacaofavorita pd
                where pd.idusuario      = :P0_IDUSUARIO
                and pd.permissaototal   = 'S'
                and :P409_IDDOCUMENTACAO is not null
                ```
        }
    )

    button novoitem (
        buttonName: NOVOITEM
        label: Adicionar Item
        layout {
            sequence: 10
            region: @itens-documentação-favorita
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 410
                items: {
                    P410_IDDOCUMENTACAO: &P409_IDDOCUMENTACAO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from permissoesdocumentacaofavorita pd
                where pd.idusuario      = :P0_IDUSUARIO
                and pd.permissaototal   = 'S'
                and :P409_IDDOCUMENTACAO is not null
                ```
        }
    )

    button voltar (
        buttonName: VOLTAR
        label: Voltar
        layout {
            sequence: 20
            region: @documentação-favorita
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-reply
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 408
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process consulta-documentação-favorita (
        name: Consulta Documentação Favorita
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                pck_cadastros_fav.prc_documentacao( piddocumentacao        => :P409_IDDOCUMENTACAO,
                                                    ptitulodocumentacao    => :P409_TITULODOCUMENTACAO,
                                                    pdescricaodocumentacao => :P409_DESCRICAODOCUMENTACAO,
                                                    pdatainclusao          => :P409_DATAINCLUSAO,
                                                    pdataatualizacao       => :P409_DATAATUALIZACAO,
                                                    pmd5                   => :P409_MD5,
                                                    poperacao_dml          => 'S');
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 1585188460154509674
        }
    )

    process limpar-campos-ao-sair (
        name: Limpar Campos ao Sair
        type: clearSessionState
        execution {
            sequence: 10
            point: afterRegions
        }
        advanced {
            executionMappingIdentifier: 1585189216543509674
        }
    )

    process limpar-campos-para-adicionar (
        name: Limpar Campos para Adicionar
        type: clearSessionState
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 1585188854072509674
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'NOVO'
        }
    )

    process operação-dml-em-documentação-favorita (
        name: Operação DML em Documentação Favorita
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  pck_cadastros_fav.prc_documentacao( piddocumentacao        => :P409_IDDOCUMENTACAO,
                                                      ptitulodocumentacao    => :P409_TITULODOCUMENTACAO,  
                                                      pdescricaodocumentacao => :P409_DESCRICAODOCUMENTACAO,
                                                      pdatainclusao          => :P409_DATAINCLUSAO,
                                                      pdataatualizacao       => :P409_DATAATUALIZACAO,
                                                      pmd5                   => :P409_MD5,
                                                      poperacao_dml          => voperacao_dml );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 1585189615398509675
        }
    )

    branch (
        name: Go To Page 409
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 409
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'ATUALIZAR'
        }
    )

)

