page 523 (
    name: Pedidos acima do limite
    title: Pedidos acima do limite
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pedidos-acima-do-limite (
        name: Pedidos Acima do Limite
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                        select pe.idpedido,
                               pe.filialfavorita,
                               pe.filialromance, 
                               pe.gerente,
                               pe.representante,
                               pe.vendedora,
                               pe.numeropedido,
                               pe.valortotalcomdesconto,
                               pck_controle_fav.fnc_limitepedido(pe.idpedido) limite,
                               pe.valortotalcomdesconto * pe.fatorconversao vlrConvertido,
                               (select sum(nvl(pp.juros,0)) + sum(nvl(pp.acrescimo,0))
                                  from vencimentospedidos vp
                                     , pagamentospedidos  pp
                                 where vp.idpedido = pe.idpedido
                                   and vp.idvencimentopedido = pp.idvencimentopedido) vlrJurosAcrescimos
                          from vw_pedidos_fav  pe
                         where pe.dataemissao between to_date( :P523_DATAINICIO||' 00:00:00','dd/mm/rrrr hh24:mi:ss')
                                                  and to_date( :P523_DATAFIM   ||' 23:59:59','dd/mm/rrrr hh24:mi:ss')
                           and (:P523_IDFILIALFAVORITA is null or pe.idfilialfavorita = :P523_IDFILIALFAVORITA)
                           and (:P523_IDFIILIALROMANCE IS NULL OR pe.idfilialromance  = :P523_IDFIILIALROMANCE)
                           and pe.datacancelamento is null
                           and pe.valortotalcomdesconto > pck_controle_fav.fnc_limitepedido(pe.idpedido)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Utilize os Filtros!
        }
        advanced {
            savedReportMappingIdentifier: 1419908910012791728
        }

        column FILIALFAVORITA (
            type: plainText
            heading {
                heading: Filial Favorita
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column FILIALROMANCE (
            type: plainText
            heading {
                heading: Filial Romance
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AA
            }
        )

        column GERENTE (
            type: plainText
            heading {
                heading: Gerente
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AB
            }
        )

        column IDPEDIDO (
            type: plainText
            heading {
                heading: Idpedido
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: Z
            }
        )

        column LIMITE (
            type: plainText
            heading {
                heading: Limite
                alignment: end
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: AG
            }
        )

        column NUMEROPEDIDO (
            type: plainText
            heading {
                heading: Pedido
            }
            layout {
                sequence: 90
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AE
            }
        )

        column REPRESENTANTE (
            type: plainText
            heading {
                heading: Representante
            }
            layout {
                sequence: 70
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AC
            }
        )

        column VALORTOTALCOMDESCONTO (
            type: plainText
            heading {
                heading: Valor Total
                alignment: end
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: AF
            }
        )

        column VENDEDORA (
            type: plainText
            heading {
                heading: Vendedora
            }
            layout {
                sequence: 80
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AD
            }
        )

        column VLRCONVERTIDO (
            type: plainText
            heading {
                heading: Valor Convertido
                alignment: end
            }
            layout {
                sequence: 130
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: AI
            }
        )

        column VLRJUROSACRESCIMOS (
            type: plainText
            heading {
                heading: Acréscimos/Juros
                alignment: end
            }
            layout {
                sequence: 120
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: AH
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 81227 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn FILIALFAVORITA (
                sequence: 1
            )

            displayColumn FILIALROMANCE (
                sequence: 3
            )

            displayColumn GERENTE (
                sequence: 4
            )

            displayColumn IDPEDIDO (
                sequence: 2
            )

            displayColumn LIMITE (
                sequence: 9
            )

            displayColumn NUMEROPEDIDO (
                sequence: 7
            )

            displayColumn REPRESENTANTE (
                sequence: 5
            )

            displayColumn VALORTOTALCOMDESCONTO (
                sequence: 8
            )

            displayColumn VENDEDORA (
                sequence: 6
            )

            displayColumn VLRCONVERTIDO (
                sequence: 11
            )

            displayColumn VLRJUROSACRESCIMOS (
                sequence: 10
            )

            aggregate (
                column: QUANTIDADEDISPONIVEL
            )

            aggregate (
                column: QUANTIDADE
            )

            aggregate (
                column: QUANTIDADERESERVADA
            )

        )

    )

    pageItem P523_DATAFIM (
        type: datePickerJquery
        label {
            label: Data Final
            alignment: left
        }
        layout {
            sequence: 210
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            formatMask: DD/MM/YYYY
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P523_DATAINICIO (
        type: datePickerJquery
        label {
            label: Data Início
            alignment: left
        }
        layout {
            sequence: 200
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            formatMask: DD/MM/YYYY
            width: 10
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P523_IDFIILIALROMANCE (
        type: selectList
        label {
            label: Filial Romance
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-filiaisromance
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 230
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util_fav.fnc_verificaacesso(58005,:P0_IDUSUARIO) = 'S'
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P523_IDFILIALFAVORITA (
        type: selectList
        label {
            label: "Filial Favorita "
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) as d,
                       idfilialfavorita as r
                  from filiaisfavorita f
                where exists ( select 1
                               from usuariosfiliaisfavorita u
                               where u.idfilialfavorita = f.idfilialfavorita
                                 and u.consultar        = 'S' 
                                 and u.idusuario        = :P0_IDUSUARIO )
                 order by 1
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 220
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util_fav.fnc_verificaacesso(58005,:P0_IDUSUARIO) = 'S'
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 240
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-filter
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
            point: afterSubmit
        }
        behavior {
            target: {
                page: 523
                items: {
                    P523_DATAINICIO: &P523_DATAINICIO.
                    P523_DATAFIM: &P523_DATAFIM.
                    P523_IDFILIALFAVORITA: &P523_IDFILIALFAVORITA.
                }
                action: resetPagination
            }
        }
    )

)

