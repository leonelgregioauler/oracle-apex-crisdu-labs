    dynamicAction imprimir (
        name: Imprimir
        execution {
            sequence: 10
        }
        when {
            event: apexbeforepagesubmit
        }
        serverSideCondition {
            type: never
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: items
                items: P78_NUMEROPEDIDO
            }
            execution {
                sequence: 31
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      vidpedido number;
                      vsucesso varchar2(1);
                    begin
                      --
                      vidpedido := pck_movimentarpedidos_fav.fnc_localizapedidoimpressao(pnumeropedido => :P78_NUMEROPEDIDO, pidcompratransferencia => :P78_IDCOMPRATRANSFERENCIA , pidusuario => :P0_IDUSUARIO );
                      --
                      :P78_IDPEDIDO := vidpedido;
                      --
                      if vidpedido = -1 then
                        vsucesso := 'N';
                      else
                        vsucesso := 'S';
                      end if;
                      --
                      :P78_SUCESSO := vsucesso;
                      --
                    exception
                      when others then
                        null;
                    end;
                    ```
                itemsToSubmit: [
                    P78_NUMEROPEDIDO
                    P78_IDCOMPRATRANSFERENCIA
                    P0_IDUSUARIO
                ]
                itemsToReturn: [
                    P78_IDPEDIDO
                    P78_SUCESSO
                ]
                showProcessing: true
            }
            execution {
                sequence: 1
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    void(0);//  
                    SUCESSO = document.getElementById('P78_SUCESSO').value;
                    SESSAO = document.getElementById("P78_SESSAO").value;
                    IDPEDIDO = document.getElementById("P78_NUMEROPEDIDO").value;
                    IDPEDIDO = IDPEDIDO.substr(8, 7);
                    IDCOMPRA = document.getElementById("P78_IDCOMPRATRANSFERENCIA").value;
                    
                    //IDPEDIDO = document.getElementById("P78_IDPEDIDO").value;
                    
                    if (IDPEDIDO != -1) {    
                      document.getElementById('P78_SUCESSO').value = 'N';  
                      vurl = "f?p=2000:86:" + SESSAO + "::NO::P86_IDPEDIDO,P86_IDCOMPRATRANSFERENCIA,P86_PAGINA:"+ IDPEDIDO +","+ IDCOMPRA +",78"
                    
                      pjan = window.open(vurl,'page','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1280,height=1024,left=20,top=10','_blank'); 
                      void(0);
                      pjan.focus();
                    }
                    ```
            }
            affectedElements {
                selectionType: items
                items: [
                    P78_NUMEROPEDIDO
                    P78_SUCESSO
                ]
            }
            execution {
                sequence: 21
                fireOnInit: false
            }
        )

    )

    dynamicAction imprimir-danfe (
        name: Imprimir DANFE
        execution {
            sequence: 19
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P78_NOMEARQUIVOXML is not null and (:P0_IDUSUARIO in (1916,2728));
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      vnomearquivoxml          varchar2(100);
                    begin
                      --
                      select nf.nomearquivoxml
                      into vnomearquivoxml
                      from pedidos p
                         , crisdu.notasfiscais nf
                      where p.idpedido = nf.idpedidofavorita 
                      and idpedido = ltrim(rtrim(substr(:P78_NUMEROPEDIDO, 2, 20), 0), 0);
                      --
                      :P78_NOMEARQUIVOXML := vnomearquivoxml;
                      --
                    exception
                      when others then 
                        null;
                    end;
                    
                    
                    ```
                itemsToSubmit: P78_NUMEROPEDIDO
                itemsToReturn: P78_NOMEARQUIVOXML
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    SESSAO   = document.getElementById("P78_SESSAO").value;
                    IDPEDIDO = document.getElementById("P78_NUMEROPEDIDO").value;
                    NOMEARQUIVOXML = document.getElementById("P78_NOMEARQUIVOXML").value;
                    
                    
                    IDPEDIDO = IDPEDIDO.match(/1[0]+([3-9][0-9]{6})[0-9]*/)[1];
                    
                    vurl = "f?p=2000:405:" + SESSAO + "::NO::P405_NOMEARQUIVOXML:"+ NOMEARQUIVOXML
                      
                    pjan = window.open(vurl,'page','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1280,height=1024,left=20,top=10','_blank'); 
                    void(0);
                    pjan.focus();
                        
                      
                    ```
            }
            execution {
                sequence: 20
            }
        )

    )

