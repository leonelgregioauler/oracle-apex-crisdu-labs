    dynamicAction valida-pedido-da-remessa-e-informa-mensagem (
        name: Valida pedido da remessa e informa mensagem
        execution {
            sequence: 20
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P78_NUMEROPEDIDO is not null
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      vidpedido number;
                      vsucesso varchar2(1);
                    begin
                      --
                      vidpedido := null;
                      :P78_MENSAGEM := null;
                      --
                      begin
                        vidpedido := pck_movimentarpedidos_fav.fnc_localizapedidoimpressao(pnumeropedido => :P78_NUMEROPEDIDO, pidcompratransferencia => :P78_IDCOMPRATRANSFERENCIA , pidusuario => :P0_IDUSUARIO );
                      exception
                      when no_data_found then
                        vidpedido := -1;
                      end;
                      --
                      if vidpedido != -1 then
                        :P78_MENSAGEM := '-- Pedido localizado --';
                        :P78_SUCESSO  := 'S';
                        --apex_util.pause(2);
                      else
                        :P78_MENSAGEM := '-- Pedido pertence à outra remessa. Não pode ser impresso --';
                        :P78_SUCESSO  := 'N';
                        --apex_util.pause(2); 
                      end if;
                      --
                      :P78_NUMEROPEDIDO := null;
                      --
                    end;
                    ```
                itemsToSubmit: [
                    P78_NUMEROPEDIDO
                    P78_IDCOMPRATRANSFERENCIA
                    P0_IDUSUARIO
                ]
                itemsToReturn: [
                    P78_SUCESSO
                    P78_MENSAGEM
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    void(0); 
                    SUCESSO = document.getElementById('P78_SUCESSO').value;
                    SESSAO = document.getElementById("P78_SESSAO").value;
                    IDPEDIDO = document.getElementById("P78_NUMEROPEDIDO").value;
                    
                    //NUMEROPEDIDO = IDPEDIDO;
                    //INICIAL  = NUMEROPEDIDO.indexOf('3');
                    //IDPEDIDO = IDPEDIDO.substr(INICIAL, 7);
                    
                    
                    IDPEDIDO = IDPEDIDO.match(/1[0]+([3-9][0-9]{6})[0-9]*/)[1];
                    IDCOMPRA = document.getElementById("P78_IDCOMPRATRANSFERENCIA").value;
                    
                    //IDPEDIDO = document.getElementById('P78_IDPEDIDO').value;
                    
                    //if (SUCESSO == 'S') {    
                      document.getElementById('P78_SUCESSO').value = 'N'; 
                        
                      vurl = "f?p=2000:86:" + SESSAO + "::NO::P86_IDPEDIDO,P86_IDCOMPRATRANSFERENCIA,P86_PAGINA:"+ IDPEDIDO +","+ IDCOMPRA +",78"
                    
                      pjan = window.open(vurl,'page','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1280,height=1024,left=20,top=10','_blank'); 
                      void(0);
                      pjan.focus();
                        
                      document.getElementById('P78_NUMEROPEDIDO').value = '';
                      //document.getElementById('P78_IDPEDIDO').value = '';
                    
                    ```
            }
            execution {
                sequence: 20
            }
        )

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
