    region pedidos-que-faltam-realizar-a-impressão (
        name: Pedidos que Faltam realizar a Impressão
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.numeropedido
                     , p.vendedora
                     , p.representante
                     , p.valortotal
                     , p.valorapagar
                     , p.situacaoentregainterno
                     , p.situacaofinanceirointerno
                     , p.dataentrega
                     , ( select distinct(volume)
                         from pedidosremessasct pr
                         where pr.idpedido = p.idpedido 
                           and pr.idcompratransferencia = :P78_IDCOMPRATRANSFERENCIA ) volume
                     , p.regiaocliente
                from vw_pedidos_fav p
                where exists ( select 1
                               from pedidosremessasct pr
                               where pr.idpedido = p.idpedido 
                                 and pr.idcompratransferencia = :P78_IDCOMPRATRANSFERENCIA )
                  and ididioma = :P0_IDIDIOMA
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P78_IDCOMPRATRANSFERENCIA
        }
        componentAppearance {
            showNullValuesAs: -
        }
