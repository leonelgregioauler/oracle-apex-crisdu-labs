page 78 (
    name: Impressão de Pedido/Boleto
    title: Impressão de Pedido/Boleto
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function imprimepedido() 
              {
                var vidpedido = document.getElementById("P78_IDPEDIDO").value;
                if ( vidpedido > 0 ) {
                  vurl = document.getElementById("P78_SESSION_PEDIDO").value;
                  pjan = window.open(vurl,'page','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1280,height=1024,left=20,top=10','_blank'); void(0);
                  pjan.focus(); }
                  
                document.getElementById("P78_IDPEDIDO").value = ""; 
                document.getElementById("P78_NUMEROPEDIDO").value = "";
              }
            
            function imprimeboleto()
            {
              var idpedido = document.getElementById("P78_IDPEDIDO").value;
              var idvendedora = document.getElementById("P78_IDVENDEDORA").value;
                
              vurl = 'http://boletos.romancemoda.com.br:7777/boleto/boleto_bb_favorita_novo.php?cod1='+idpedido+'&cod2='+idvendedora;
              if ( idpedido > 0 ) 
                {
                  pjan = window.open(vurl,'boleto','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1024,height=1000,left=20,top=10','_blank'); 
                  pjan.focus();
                  document.getElementById("P78_IDPEDIDO").value = '';
                }
              
              document.getElementById("P78_IDPEDIDO").value = '';
              window.opener.location.reload() 
            }
            
            function imprimelista() 
              {
                
                vurl = document.getElementById("P78_SESSION_LISTA").value;
                pjan = window.open(vurl,'page','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1280,height=1024,left=20,top=10','_blank'); void(0);
                pjan.focus(); 
                 
              }
            
            
            function teclaenter() {
                if (window.event.keyCode==13) {
                       vurl = document.getElementById("P78_SESSION_PEDIDO").value;
                       pjan = window.open(vurl,'page','toolbar=no,location=no,status=no,menubar=yes,scrollbars=yes,resizable=no,width=1280,height=1024,left=20,top=10','_blank'); void(0);
                       pjan.focus();
                }
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region localizar-pedido (
