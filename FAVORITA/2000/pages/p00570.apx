page 570 (
    name: Convênios Bancários
    title: Convênios Bancários
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region convênios-bancários (
        name: Convênios Bancários
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idconveniobanco
                     , b.nomebanco banco
                     , e.nome empresaemitente
                     , cb.beneficiario
                     , cb.agencia
                     , cb.conta
                     , c.convenio
                     , decode(c.ativado,'S','Sim','N','Não') ativado
                from conveniosbancos c
                   , empresasvirtualage e
                   , roman.contasbancarias cb
                   , roman.bancos b
                where c.idcontabancaria = cb.idcontabanc
                  and cb.idbanco = b.idbanco
                  and e.idempresavirtualage = c.idempresaemitente
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum registro localizado
        }
        advanced {
            savedReportMappingIdentifier: 98859679501063248
        }

        column AGENCIA (
            type: plainText
            heading {
                heading: Agência
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column ATIVADO (
            type: plainText
            heading {
                heading: Ativado
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column BANCO (
            type: plainText
            heading {
                heading: Banco
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column BENEFICIARIO (
            type: plainText
            heading {
                heading: Beneficiário
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column CONTA (
            type: plainText
            heading {
                heading: Conta
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column CONVENIO (
            type: plainText
            heading {
                heading: Convênio
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column EMPRESAEMITENTE (
            type: plainText
            heading {
                heading: Empresa Emitente
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column IDCONVENIOBANCO (
            type: link
            heading {
                heading: Ver/Editar
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 571
                    items: {
                        P571_IDCONVENIOBANCO: #IDCONVENIOBANCO#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 1003676 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn AGENCIA (
                sequence: 5
            )

            displayColumn ATIVADO (
                sequence: 8
            )

            displayColumn BANCO (
                sequence: 2
            )

            displayColumn BENEFICIARIO (
                sequence: 4
            )

            displayColumn CONTA (
                sequence: 6
            )

            displayColumn CONVENIO (
                sequence: 7
            )

            displayColumn EMPRESAEMITENTE (
                sequence: 3
            )

            displayColumn IDCONVENIOBANCO (
                sequence: 1
            )

        )

    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 571
                items: {
                    P571_ATIVADO:
                    P571_CONVENIO:
                    P571_IDBANCO:
                    P571_IDCONTABANCARIA:
                    P571_IDCONVENIOBANCO:
                    P571_IDEMPRESAEMITENTE:
                    P571_OPERACAO_DML:
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

