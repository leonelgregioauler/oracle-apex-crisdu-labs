    region edições-revistas (
        name: Edições Revistas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idedicaorevista
                     , nome
                     , numeroedicao
                     , tiragem
                     , datainicial
                     , datafinal
                     , qtdpaginas
                     , idpais
                     , nomepais
                     , quantidadeprodutos
                     , descliberarcompra
                     , tipovenda
                     , vendaespecial
                from vw_edicoesrevistas
                ```
