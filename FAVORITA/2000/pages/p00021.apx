        }
        serverSideCondition {
            type: request=Value
            value: GERARPRODUTOSDETALHADOSEDICAO
        }
    )

    validation valida-edição-de-revista (
        name: Valida Edição de Revista
        execution {
            sequence: 30
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vnumeroedicaoorigem number;
                  vnumeroedicaodestino number;
                  --
                  cursor c1 (pidedicaorevistaorigem in number) is 
                  select distinct
                         est.idpais
                       , fil.tipofilial
                  from roman.estados est
                     , roman.cidades cid
                     , pessoas pes
                     , filiais fil
                     , filiaisedicoesrevistas fer
                     , edicoesrevistas er
                  where fer.idedicaorevista = er.idedicaorevista
                  and fil.idfilial = fer.idfilial
                  and pes.idpessoa = fil.idpessoa 
                  and cid.idcidade = pes.idcidade
                  and est.idestado = cid.idestado
                  and er.idedicaorevista = pidedicaorevistaorigem;
                  --
                  r1 c1%rowtype;
                  --
                  cursor c2 (pidedicaorevistadestino in number) is 
                  select distinct
                         est.idpais
                       , fil.tipofilial
                  from roman.estados est
                     , roman.cidades cid
                     , pessoas pes
                     , filiais fil
                     , filiaisedicoesrevistas fer
                     , edicoesrevistas er
                  where fer.idedicaorevista = er.idedicaorevista
                  and fil.idfilial = fer.idfilial
                  and pes.idpessoa = fil.idpessoa 
                  and cid.idcidade = pes.idcidade
                  and est.idestado = cid.idestado
                  and er.idedicaorevista = pidedicaorevistadestino;
                  --
                  r2 c2%rowtype;
                  --
                  --
                begin
                  --
                  select numeroedicao
                  into vnumeroedicaoorigem
                  from edicoesrevistas
                  where idedicaorevista = :P21_IDEDICAOORIGEM;
                  --
                  select numeroedicao
                  into vnumeroedicaodestino
                  from edicoesrevistas
                  where idedicaorevista = :P21_IDEDICAODESTINO;
                  --
                  if vnumeroedicaoorigem > vnumeroedicaodestino then
                    return 'Edição de Origem deve ser anterior à Edição Destino';
                  end if;
                  --
                  --
                  open c1 (:P21_IDEDICAOORIGEM);
                  loop
                    fetch c1 into r1;
                    --
                    if c1%rowcount = 0 then
                      return ('Não existe filial cadastrada para a edição de revista origem');
                    end if;
                    --  
                    exit when c1%notfound;
                    --
                    open c2 (:P21_IDEDICAODESTINO);
                    loop
                      fetch c2 into r2;
                      --
                      if c2%rowcount = 0 then
                        return ('Não existe filial cadastrada para a edição de revista destino');
                      end if;
                      --
                      exit when c2%notfound;
                      --
                      if r1.idpais <> r2.idpais then
                        return ('Cópia de Preços somente entre edições do mesmo país');
                      elsif r1.tipofilial = 'P' and r2.tipofilial <> 'P' then
                        return ('Cópia de Preços somente entre Filiais Romance ou entre Distribuidoras Parceiras');
                      elsif r1.tipofilial <> 'P' and r2.tipofilial = 'P' then
                        return ('Cópia de Preços somente entre Filiais Romance ou entre Distribuidoras Parceiras');
                      end if;
                      --
                    end loop;
                    close c2;
                    --
                  end loop;
                  close c1;
                  --
                  --
                end;
                ```
        }
        serverSideCondition {
            type: request=Value
            value: GERARPRODUTOSDETALHADOSEDICAO
        }
    )

    process gerar-produtos-detalhados-edição-anterior (
        name: Gerar Produtos Detalhados Edição Anterior
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vidprodutodetedrevista number       := null;
                  vidprodutodetalhado    number       := null;
                begin
                  --
                  pck_cadastros_fav.prc_copiaprodutosdetalhados ( pidprodutodetedrevista    => vidprodutodetedrevista
                                                                , pidedicaorevistaorigem    => :P21_IDEDICAOORIGEM
                                                                , pidedicaorevistadestino   => :P21_IDEDICAODESTINO
                                                                , pidprodutodetalhado       => vidprodutodetalhado
                                                                , pquantidadeitenscopiados => :P21_QUANTIDADEITENSCOPIADOS );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Foram gerados &P21_QUANTIDADEITENSCOPIADOS. produtos detalhados com sucesso.
        }
        advanced {
            executionMappingIdentifier: 538068694858750445
        }
        serverSideCondition {
            type: request=Value
            value: GERARPRODUTOSDETALHADOSEDICAO
        }
    )

)

