    validation idedicaodestino-obrigatório (
        name: IDEDICAODESTINO obrigatório
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P21_IDEDICAODESTINO
            alwaysExecute: true
        }
        error {
            errorMessage: Edição de Destino deve ser informada.
        }
        serverSideCondition {
            type: request=Value
            value: GERARPRODUTOSDETALHADOSEDICAO
        }
    )

    validation idedicaoorigem-obrigatório (
        name: IDEDICAOORIGEM obrigatório
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P21_IDEDICAOORIGEM
            alwaysExecute: true
        }
        error {
