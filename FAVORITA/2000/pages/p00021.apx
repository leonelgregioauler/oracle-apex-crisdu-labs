    pageItem P21_IDEDICAODESTINO (
        type: selectList
        label {
            label: Edição Destino
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                  select pck_util_fav.fnc_edicaorevista(e.idedicaorevista) as d,
                       e.idedicaorevista as r
                  from edicoesrevistas e
                 where /*e.tipovenda in ( select er.tipovenda
                                          from edicoesrevistas er
                                          where er.idedicaorevista = :P21_IDEDICAOORIGEM )*/
                     nvl(e.idpais, 1) in nvl(( select er.idpais
                                                 from edicoesrevistas er
                                                 where er.idedicaorevista = :P21_IDEDICAOORIGEM ), 1)
                 order by 1;
                ```
            nullDisplayValue: - Selecione -
        }
        cascadingLov {
            parentItems: P21_IDEDICAOORIGEM
        }
        layout {
            sequence: 20
            region: @gerar-produtos-detalhados-edição-completa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

