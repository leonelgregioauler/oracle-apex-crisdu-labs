    pageItem P391_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Filial
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nomefilialfavorita
                     , f.idfilialfavorita
                from favorita.usuariosfiliaisfavorita u
                   , favorita.filiaisfavorita f
                where f.idfilialfavorita = u.idfilialfavorita
                  and f.tipofilial in ('F','L')
                  and u.idusuario = :P0_IDUSUARIO
                  and u.consultar = 'S'
                ```
            nullDisplayValue: - Todas -
            nullReturnValue: -9999
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

