page 391 (
    name: Relatório de Pedidos Favorita Paris
    title: Relatório de Pedidos Favorita Paris
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            footerText:
                ```html
                <font color="green"><h3>
                    Valor total a Pagar = 10.90
                    </h3></font>
                ```
        }
    )

    region pedidos-favorita-paris-completo (
        name: Pedidos Favorita Paris Completo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.dataemissao
                     , p.representante
                     , p.vendedora
                     , p.idpedido
                     , p.valorapagar valortotal
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2215) "7 Ervas 60gr"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2216) "Sebo De Carneiro 60g"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2343) "1 Milha"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2344) "812 Men Vip"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2345) "812 Vip Rosé"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2346) "812 Sexy"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2347) "Man In Black"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2348) "Girl S"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2349) "Fabulosa"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2350) "Crystals"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2351) "Champion"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2352) "J Adoro"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2827) "Miss Lady"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2819) "Apolo"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2820) "Vida Bela"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2817) "Chic"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2818) "Ok Ele & Ela"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2824) "Intense (Woman)"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2825) "Infinite Blue"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2821) "Atitude"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2822) "Red Love"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2826) "Afrodite"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2559) "Caixinha Preta"
                     , ( select nvl(sum(i.quantidade),0)
                         from favorita.itenspedidos i
                         where i.idpedido = p.idpedido
                           and i.idprodutodetalhado = 2560) "Estojo"
                     , p.filialromance 
                from favorita.vw_pedidos_fav p
                where p.ididioma = 1
                  and ( :P391_IDFILIALFAVORITA = -9999 or p.idfilialfavorita = :P391_IDFILIALFAVORITA )
                  and ((:P391_DATA_INICIAL is null and :P391_DATA_FINAL is null) or (trunc(p.dataemissao) between to_date(:P391_DATA_INICIAL,'dd/mm/rrrr') and to_date(:P391_DATA_FINAL,'dd/mm/rrrr')))
                  and not exists ( select 1
                                   from favorita.classificacoespedidos cp
                                   where cp.idpedido = p.idpedido 
                                     and cp.idcaracteristicapedido = 25)
                order by 1 desc;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
