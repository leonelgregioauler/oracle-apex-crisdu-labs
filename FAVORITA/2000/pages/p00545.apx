page 545 (
    name: Relatório de Diferencas do Inventário
    title: Relatorio Diferencas Inventario
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region diferenca-fisico-fiscal (
        name: Diferenca FIsico Fiscal
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeprodutodetalhado(i.idprodutodetalhado,1) Produto
                     , i.divfisicofiscal QtdDiv
                     , nvl(i.vlrCusto,0)  Custo
                     , i.divfisicofiscal * i.vlrcusto vlrDiv
                          from inventarioCiclico        c
                             , itensInventarioCiclico   i
                             , tiposSituacoesInventario t
                          where c.idInventarioCiclico = i.idInventarioCiclico(+)
                            and c.idtiposituacao      = t.idtiposituacao
                            and c.idinventariociclico = :P545_IDINVENTARIO
                            and i.divfisicofiscal != 0
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P545_TIPOREL
            value: FF
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhum registro localizado!
        }
        componentAdvanced {
            stripHtml: true
        }

        column CUSTO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Custo
                alignment: center
            }
            layout {
                sequence: 3
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
        )

        column PRODUTO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column QTDDIV (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: QTD_Divergencia
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
        )

        column VLRDIV (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Valor Divergência
                alignment: end
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
        )

    )

    region diferenca-fisico-optimus (
        name: Diferenca FIsico Optimus
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeprodutodetalhado(i.idprodutodetalhado,1) Produto
                     , i.divfisicooptimus QtdDiv
                     , nvl(i.vlrCusto,0)  Custo
                     , i.divfisicooptimus * i.vlrcusto vlrDiv
                          from inventarioCiclico        c
                             , itensInventarioCiclico   i
                             , tiposSituacoesInventario t
                          where c.idInventarioCiclico = i.idInventarioCiclico(+)
                            and c.idtiposituacao      = t.idtiposituacao
                            and c.idinventariociclico = :P545_IDINVENTARIO
                            and i.divfisicooptimus != 0
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: P545_TIPOREL
            value: FO
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Nenhum registro localizado!
        }
        componentAdvanced {
            stripHtml: true
        }

        column CUSTO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Custo
                alignment: center
            }
            layout {
                sequence: 3
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
        )

        column PRODUTO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Produto
                alignment: center
            }
            layout {
                sequence: 1
            }
        )

        column QTDDIV (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: QTD_Divergencia
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
        )

        column VLRDIV (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Valor Divergência
                alignment: end
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
        )

    )

    pageItem P545_IDINVENTARIO (
        type: hidden
        layout {
            sequence: 10
            region: @diferenca-fisico-optimus
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P545_TIPOREL (
        type: hidden
        layout {
            sequence: 20
            region: @diferenca-fisico-optimus
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

