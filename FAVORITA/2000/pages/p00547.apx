page 547 (
    name: Relatorio Viradas de Catalogo
    title: Relatorio Viradas de Catalogo
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region virada-de-catálogo (
        name: Virada de Catálogo
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select V.IDVIRADADECATALOGO
                     , V.NOME
                     , V.DATAVALIDADEINI
                     , V.DATAVALIDADEFIM
                     , V.IDEDICAOREVISTAORIGEM
                     , V.IDEDICAOREVISTAORIGEM IDEDICAOREVISTA
                     , V.IDEDICAOREVISTADESTINO
                     , V.IDPAIS
                     , V.LINKCATALOGO
                     , V.IDUSUARIOINCLUSAO
                     , V.DATAINCLUSAO
                     , V.IDUSUARIOMORTEPROG
                     , V.DATAMORTEPROG
                     , V.IDUSUARIOAJUSTEITENS
                     , V.DATAAJUSTEITENS
                     , V.IDUSUARIOITENSMORTEPROG
                     , V.DATAITENSMORTEPROG
                     , V.ETAPA
                     , R.DATAINICIAL
                     , R.DATAFINAL
                     , case when v.etapa = 0 then 'Iniciando a Virada'
                            when v.etapa = 1 then 'Definindo Itens e MP'
                            when v.etapa = 2 then 'Ajustando Itens Revista'
                            when v.etapa = 3 then 'Ajustando Morte Programada'
                       else 
                            'Edições Geradas'
                       end "Situação"
                     , case when nvl(v.etapa,0) = 1 then 'Definir Itens e MP'          else '' end LINKETAPA1
                     , case when nvl(etapa,0)   = 2 then 'Ajustar/Gerar Itens Revista' else '' end LINKETAPA2
                     , case when nvl(etapa,0)   = 3 then 'Ajustar/Gerar Itens MP'      else '' end LINKETAPA3
                  from VIRADASDECATALOGO V
                     , EDICOESREVISTAS   R
                 where V.IDEDICAOREVISTAORIGEM = R.IDEDICAOREVISTA
                  
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 548
                items: {
                    P548_IDVIRADADECATALOGO: #IDVIRADADECATALOGO#
                }
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 24091576662349429
        }

