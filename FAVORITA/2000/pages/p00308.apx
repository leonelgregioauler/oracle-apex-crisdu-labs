page 308 (
    name: Cartões Fidelidades
    title: Cartões Fidelidades
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cartões-clube (
        name: Cartões Clube
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idcartaoclube
                     , c.idcategoriaclube
                     , categoriaclube
                     , c.idvendedora
                     , nomevendedora
                     , c.datacartao
                     , c.ativo
                     , descativo
                from vw_cartoesclube_fav c
                order by 1
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum registro encontrado.
        }
        advanced {
            savedReportMappingIdentifier: 1401982900009047341
        }

        column ATIVO (
            type: hidden
            heading {
                heading: Ativo
            }
            layout {
                sequence: 70
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
            security {
                escapeSpecialChars: false
            }
        )

        column CATEGORIACLUBE (
            type: plainText
            heading {
                heading: Categoria
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column DATACARTAO (
            type: plainText
            heading {
                heading: Data Cartão
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: F
            }
        )

        column DESCATIVO (
            type: plainText
            heading {
                heading: Ativo
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column IDCARTAOCLUBE (
            type: plainText
            heading {
                heading: Cod. Cartão
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column IDCATEGORIACLUBE (
            type: plainText
            heading {
                heading: Cód. Categoria
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )

        column IDVENDEDORA (
            type: plainText
            heading {
                heading: Cod. Consultora
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column NOMEVENDEDORA (
            type: plainText
            heading {
                heading: Consultora
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 14033123 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ATIVO (
                sequence: 7
            )

            displayColumn CATEGORIACLUBE (
                sequence: 3
            )

            displayColumn DATACARTAO (
                sequence: 6
            )

            displayColumn DESCATIVO (
                sequence: 8
            )

            displayColumn IDCARTAOCLUBE (
                sequence: 1
            )

            displayColumn IDCATEGORIACLUBE (
                sequence: 2
            )

            displayColumn IDVENDEDORA (
                sequence: 4
            )

            displayColumn NOMEVENDEDORA (
                sequence: 5
            )

        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

)

