page 135 (
    name: Importar Arquivo BB
    title: Importar Arquivo BB
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG_18"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region importar-arquivo (
        name: Importar Arquivo
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P135_ARQUIVO (
        type: fileUpload
        label {
            label: Arquivo
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
        }
        layout {
            sequence: 20
            region: @importar-arquivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            type: databaseColumn
            databaseColumn: ARQUIVO
            used: always
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1 
                from importacoesbb
                ```
        }
    )

    pageItem P135_ROWID (
        type: hidden
        layout {
            sequence: 10
            region: @importar-arquivo
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: ROWID
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Importar Arquivo
        layout {
            sequence: 50
            region: @importar-arquivo
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from importacoesbb
                ```
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Recomeçar
        layout {
            sequence: 30
            region: @importar-arquivo
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from importacoesbb
                ```
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 20
            region: @importar-arquivo
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 127
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button processar (
        buttonName: PROCESSAR
        label: Processar
        layout {
            sequence: 60
            region: @importar-arquivo
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from importacoesbb
                ```
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 40
            region: @importar-arquivo
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P135_ROWID
        }
    )

    validation valida-arquivo (
        name: valida arquivo
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P135_ARQUIVO
        }
        error {
            errorMessage: Por favor, adicione um arquivo!
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process atualiza-data-entrega-pedidos-correios (
        name: Atualiza Data Entrega Pedidos Correios
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  cursor c1 is
                    select vp.idpedido
                         , cp.idvalorcaracteristica
                      from pagamentospedidos pp
                         , vencimentospedidos vp
                         , classificacoespedidos cp
                      where vp.idpedido = cp.idpedido
                      and pp.idvencimentopedido = vp.idvencimentopedido
                      and cp.idcaracteristicapedido = 6
                      and pp.idformapagamento = 1
                      and pp.datapagamento is not null
                      and pp.valorpago > 0
                      --and pp.idsituacao = 20
                      and pp.origempagamento = 'B';
                    --
                  r1 c1%rowtype;
                  --
                begin
                  open c1;
                  loop
                    fetch c1 into r1;
                    exit when c1%notfound;
                    --
                    -- Atualiza data de entrega do pedido com o número de dias estipulado pelo correio (2 dias prazo interno de estoque já estão no prazo na característica) 
                    -- a partir da data atual
                    update pedidos
                    set dataentrega = trunc(sysdate) + r1.idvalorcaracteristica
                    where idpedido = r1.idpedido;
                    --
                  end loop;
                  close c1;
                  --
                end;
                  
                    
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 538200053230826309
        }
        serverSideCondition {
            whenButtonPressed: @processar
        }
    )

    process fetch-row-from-importacoesbb (
        name: Fetch Row from IMPORTACOESBB
        type: autoRowFetch
        source {
            tableName: IMPORTACOESBB
            pkColumn: ROWID
            pkItem: P135_ROWID
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 538198863417826308
        }
    )

    process process-row-of-importacoesbb (
        name: Process Row of IMPORTACOESBB
        type: autoRowProcessing
        target {
            tableName: IMPORTACOESBB
            pkColumn: ROWID
            pkItem: P135_ROWID
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Arquivo Importado!
        }
        advanced {
            executionMappingIdentifier: 538199246877826309
        }
    )

    process processar (
        name: processar
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_integracao_fav.prc_importa_arquivo_bb(:P0_IDUSUARIO);
                  pck_integracao_fav.prc_processapgtosbancos(pidusuario => :P0_IDUSUARIO);
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Arquivo Processado!
        }
        advanced {
            executionMappingIdentifier: 538198047002826308
        }
        serverSideCondition {
