            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: D
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P414_IDFILIALFAVORITA (
        type: selectList
        label {
            label: "Filial Favorita "
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) as d,
                       idfilialfavorita as r
                  from filiaisfavorita
                  where (tipofilial in ('L', 'S', 'C') and pck_util_fav.fnc_retornatipofilial(:P0_IDFILIALFAVORITA, :P0_IDIDIOMA) != 'L'
                      or tipofilial  = ('L')           and pck_util_fav.fnc_retornatipofilial(:P0_IDFILIALFAVORITA, :P0_IDIDIOMA)  = 'L' and idfilialfavorita = :P0_IDFILIALFAVORITA )           
                  
                 order by 1
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 50
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util_fav.fnc_verificaacesso(58005,:P0_IDUSUARIO) = 'S'
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P414_TIPODATA (
        type: radioGroup
        label {
            alignment: left
        }
        lov {
            type: staticValues
