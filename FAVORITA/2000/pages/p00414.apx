page 414 (
    name: Pagamentos com Desconto/Acréscimo
    title: Pagamentos com Desconto/Acréscimo
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pagamentos-com-desconto-acréscimo (
        name: Pagamentos com Desconto/Acréscimo
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ( select v.idpedido
                         from vencimentospedidos v
                         where v.idvencimentopedido = p.idvencimentopedido ) idpedido 
                       , ped.idfilialfavorita
                       , pck_util_fav.fnc_nomefilialfavorita(ped.idfilialfavorita) nomefilialfavorita
                       , p.idformapagamento
                       , p.formapagamento
                       , p.datapagamento
                       , p.databaixa
                       , p.valorpago
                       , p.taxa
                       , p.juros
                       , p.acrescimo
                       , p.desconto
                       , p.justificativadescontoacrescimo
                       , p.valorliquido
                       , p.valorrecebido        
                       , p.numerocomprovante
                       , p.idsituacao
                       , p.situacaopagamento
                       , p.origempagamento
                       , p.descorigempagamento
                       , p.idusuariopagamento
                       , p.nomeusuario
                       , p.observacao
                 from vw_pagamentospedidos_fav p
                    , vencimentospedidos vp
                    , pedidos ped
                 where vp.idpedido         = ped.idpedido 
                 and p.idvencimentopedido  = vp.idvencimentopedido 
                 and vp.situacaovencimento = 'V'
                 and p.ididioma            = :P0_IDIDIOMA
                 and ( (:P414_DESCONTOACRESCIMO = 'D' and p.desconto > 0) or (:P414_DESCONTOACRESCIMO= 'A' and p.acrescimo > 0) )
                 and idformapagamento != 1
                 and (pck_util_fav.fnc_verificaacesso(28607,:P0_IDUSUARIO) = 'S' and ped.idfilialfavorita = :P414_IDFILIALFAVORITA )
                 and ( :P414_TIPODATA = 'N' or ( :P414_TIPODATA = 'B' and trunc(p.databaixa) between to_date(:P414_DATAINICIO,'dd/mm/rrrr') and to_date(:P414_DATAFIM,'dd/mm/rrrr') )
                                            or ( :P414_TIPODATA = 'P' and trunc(p.datapagamento) between to_date(:P414_DATAINICIO,'dd/mm/rrrr') and to_date(:P414_DATAFIM,'dd/mm/rrrr') ) );
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
