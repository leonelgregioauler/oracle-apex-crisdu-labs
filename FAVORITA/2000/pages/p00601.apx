page 601 (
    name: Configurar Usuário Perfil
    title: Configurar Usuário Perfil
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: true
    }
    advanced {
        reloadOnSubmit: always
    }

    region perfil-do-usuário (
        name: Perfil do Usuário
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P601_PERFIL (
        type: selectList
        label {
            label: <b>Perfil</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(p.descricao) display_value
                     , p.idperfil return_value
                  from roman.perfil p
                 where p.idsistema = 2000
                ```
        }
        layout {
            sequence: 20
            region: @perfil-do-usuário
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P601_USUARIO (
        type: selectList
        label {
            label: <b>Usuário</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct(us.usuario)  display_value
                     , us.usuario return_value
                  from roman.usuariossistemas us
                 where us.idsistema = 2000
                   and us.ativo = 'S'
                order by 1;
                ```
        }
        layout {
            sequence: 10
            region: @perfil-do-usuário
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Aplicar Acessos
        layout {
            sequence: 10
            region: @perfil-do-usuário
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process aplicar-acessos (
        name: Aplicar Acessos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  delete roman.acessos a
                   where a.usuario = :P601_USUARIO
                     and a.idaplicacao in ( select aa.idaplicacao
                                              from roman.aplicacoes aa
                                             where aa.idsistema = 2000 );
                     
                  for a in (select p.idaplicacao
                              from roman.perfilacesso p
                             where p.idperfil = :P601_PERFIL)
                  --
                  loop
                    --
                    insert into roman.acessos (idacesso, usuario, idaplicacao, ativo)
                    values (roman.seq_idacessos.nextval, :P601_USUARIO, a.idaplicacao, 'S');
                    --
                  end loop;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: "Copiado os Acessos com Sucesso! "
        }
        advanced {
            executionMappingIdentifier: 575282812258314313
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

)

