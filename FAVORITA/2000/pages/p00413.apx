page 413 (
    name: Tempos de Entrega de Fornecedores
    title: Tempos de Entrega de Fornecedores
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region tempos-de-entrega-de-fornecedores (
        name: Tempos de Entrega de Fornecedores
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.idforncedortempoentrega
                     , f.idfornecedor
                     , f.idfilialfavorita
                     , f.tempoproducao
                     , f.tempoentrega
                from favorita.fornecedorestemposentrega f
                where (f.idfornecedor = :P413_IDFORNECEDOR or :P413_IDFORNECEDOR is null)
                  and (f.idfilialfavorita = :P413_IDFILIALFAVORITA or :P413_IDFILIALFAVORITA is null);
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 1588799872056777902
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDFORNCEDORTEMPOENTREGA
                layout {
                    show: false
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDFORNECEDOR
                layout {
                    width: 296
                    sequence: 3
                }
            )

            displayColumn (
                column: @IDFILIALFAVORITA
                layout {
                    width: 242
                    sequence: 4
                }
            )

            displayColumn (
                column: @TEMPOPRODUCAO
                layout {
                    width: 200
                    sequence: 4
                }
            )

            displayColumn (
                column: @TEMPOENTREGA
                layout {
                    width: 200
                    sequence: 5
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column IDFILIALFAVORITA (
            type: selectList
            heading {
                heading: Filial Favorita
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select favorita.pck_util_fav.fnc_nomefilialfavorita(f.idfilialfavorita) showvalue
                         , f.idfilialfavorita returnvalue
                    from favorita.filiaisfavorita f
                    where f.tipofilial = 'E'
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 60
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDFILIALFAVORITA
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDFORNCEDORTEMPOENTREGA (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDFORNCEDORTEMPOENTREGA
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: SEQ_idforncedortempoentrega
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDFORNECEDOR (
            type: selectList
            heading {
                heading: Fornecedor
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select favorita.pck_util_fav.fnc_nomefornecedor(f.idfornecedor) showvalue
                         , f.idfornecedor returnvalue
                    from catal.fornecedores f
                    
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDFORNECEDOR
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column TEMPOENTREGA (
            type: numberField
            heading {
                heading: Tempo Entrega(Dias)
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            source {
                databaseColumn: TEMPOENTREGA
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column TEMPOPRODUCAO (
            type: numberField
            heading {
                heading: Tempo Produção(Dias)
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                databaseColumn: TEMPOPRODUCAO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

    )

    pageItem P413_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Filial Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nomefilialfavorita showvalue
                     , f.idfilialfavorita returnvalue
                from favorita.filiaisfavorita f
                where f.tipofilial = 'E'
                ```
            displayExtraValues: false
            nullDisplayValue: " - Todos -"
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P413_IDFORNECEDOR (
        type: plugin/select
        label {
            label: Fornecedor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nomepessoa showvalue
                     , f.idfornecedor returnvalue
                from catal.fornecedores f
                   , catal.pessoas p
                where f.idpessoa = p.idpessoa
                ```
            displayExtraValues: false
            nullDisplayValue: " - Todos -"
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
                t-Button--iconRight
                t-Button--stretch
            ]
            icon: fa-filter
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process tempos-de-entrega-de-fornecedores-save-interactive-grid-data (
        name: Tempos de Entrega de Fornecedores - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @tempos-de-entrega-de-fornecedores
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1588800849100777912
        }
    )

)

