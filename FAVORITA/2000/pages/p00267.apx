    region ultimas-importações (
        name: Ultimas Importações
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select data
                from ( select distinct trunc(dataprocessado) data
                       from extratosbancos t
                       where t.idcontabancaria = :P267_IDCONTABANCARIA
                       order by 1 desc )
                where rownum <= 10
                ```
        }
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P267_IDCONTABANCARIA
        }
        componentAppearance {
