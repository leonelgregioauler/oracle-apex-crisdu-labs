    region extratos-com-problemas (
        name: Extratos com Problemas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.idavisoextratobanco
                     , a.dataaviso
                     , a.mensagem
                from avisosextratosbancos a
                   , extratosbancos e
                where a.idextratobanco = e.idextratobanco
                  and e.situacao       = 'V'
                  and trunc(a.dataaviso) = trunc(sysdate)
                  and ( :P267_FILTRO is null or a.mensagem like '%'||:P267_FILTRO||'%' ) 
                  and e.idcontabancaria = :P267_IDCONTABANCARIA
                order by a.dataaviso desc
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum erro encontrado!
        }
        advanced {
            savedReportMappingIdentifier: 3907409222856289022
        }

