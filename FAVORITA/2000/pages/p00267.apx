    button importar (
        buttonName: IMPORTAR
        label: Importar Arquivo
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 269
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 267
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 267
                items: {
                    P267_FILTRO: &P267_FILTRO.
                    P267_IDCONTABANCARIA: &P267_IDCONTABANCARIA.
                    P267_TIPO_CONTA: &P267_TIPO_CONTA.
                    P267_IDBANCO: &P267_IDBANCO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

