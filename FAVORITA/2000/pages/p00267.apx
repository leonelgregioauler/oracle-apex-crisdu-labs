    region extratos-não-encontrados-no-sistema (
        name: Extratos Não Encontrados no Sistema
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ltrim(e.numerocomprovante,0) comprovante
                     , e.valorextrato 
                     , e.nomedepositante
                     , e.datadeposito
                from extratosbancos e
                where nvl(e.processado,'N') = 'N'
                  and e.situacao is null
                  and trunc(e.dataprocessado) = trunc(sysdate)
                  and e.idcontabancaria = :P267_IDCONTABANCARIA
                order by datadeposito
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 4064533094139551624
        }

        column COMPROVANTE (
            type: plainText
            heading {
                heading: Comprovante
                alignment: center
            }
            layout {
