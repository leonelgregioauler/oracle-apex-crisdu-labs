    pageItem P267_FILTRO (
        type: textField
        label {
            label: Consultar
            alignment: left
        }
        layout {
            sequence: 20
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P267_IDBANCO (
        type: radioGroup
        label {
            label: Banco
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ' - Todos - ' d
                     , -1 r
                from dual
                union
                select initcap(b.nomebanco) d
                     , b.idbanco r
                from roman.bancos b
                where exists ( select 1
                               from roman.contasbancarias c
                               where c.idbanco = b.idbanco
                                 and c.usosetorcobranca = 'S' )
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        default {
            type: expression
            plsqlExpression: null
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P267_IDCONTABANCARIA (
        type: selectList
        label {
            label: Conta Bancaria
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.beneficiario||' ('||b.nomebanco||' - Ag: '||c.agencia||'- CC: '||c.conta||')' d
                     , c.idcontabanc r
                from roman.contasbancarias c
                   , roman.bancos b
                where b.idbanco = c.idbanco
                  and ( :P267_IDBANCO = -1 or b.idbanco = :P267_IDBANCO )
                  and ( :P267_TIPO_CONTA = 'A' 
                     or ( :P267_TIPO_CONTA = 'C' and lower(c.beneficiario) like '%crisdu%' )
                     or ( :P267_TIPO_CONTA = 'R' and lower(c.beneficiario) not like '%crisdu%' ) )
                  and c.ativo = 'S'
                  and c.usosetorcobranca = 'S'
                order by 1;
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: [
                P267_TIPO_CONTA
                P267_IDBANCO
            ]
        }
        layout {
            sequence: 50
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P267_TIPO_CONTA (
        type: radioGroup
        label {
