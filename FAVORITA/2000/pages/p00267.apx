    region placar-do-dia (
        name: Placar do Dia
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nvl(( select count(e.idextratobanco)
                             from extratosbancos e
                             where e.situacao = 'S'
                               and e.processado = 'S'
                               and e.idcontabancaria = :P267_IDCONTABANCARIA
                               and trunc(e.dataprocessado) = trunc(sysdate) ),0) sucesso
                     , nvl(( select count(e.idextratobanco)
                             from extratosbancos e
                             where e.situacao = 'V'
                               and e.processado = 'S'
                               and e.idcontabancaria = :P267_IDCONTABANCARIA
                               and trunc(e.dataprocessado) = trunc(sysdate) ),0) valorerrado
                     , nvl(( select count(e.idextratobanco)
                             from extratosbancos e
                             where nvl(e.situacao,'N') = 'N'
                               and nvl(e.processado,'N') = 'N'
                               and e.idcontabancaria = :P267_IDCONTABANCARIA
                               and trunc(e.dataprocessado) = trunc(sysdate) ),0) naolocalizado
                from dual
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/badge-list
            templateOptions: [
                #DEFAULT#
                t-BadgeList--xlarge
                t-BadgeList--fixed
                t-BadgeList--circular
            ]
            showNullValuesAs: -
        }
        pagination {
            type: setPaginationSelectList
        }

