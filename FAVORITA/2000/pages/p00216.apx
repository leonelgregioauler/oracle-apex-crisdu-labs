    region parcelamentos-realizados (
        name: Parcelamentos Realizados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||p.idpedido ,'SESSION')||''',''_blank''); void(0)">'||p.numeropedido||'</a>' numeropedido
                     , p.representante
                     , p.vendedora
                     , p.filialromance
                     , p.conta
                     , p.comprovante
                     , p.valororiginal
                     , p.juros
                     , p.valorapagar
                     , p.enviadaspc
                     , p.descsituacaoparcela
                     , p.cpf
                     , descbonificacaopaga
                     , p.databaixa
                     , ( select pck_util_fav.fnc_nomeusuario(pp.idusuarionegociacao)
                         from pagamentospedidos pp
                         where pp.origempagamento = 'C'
                           and pp.idsituacao != 40
                           and rownum = 1
                           and exists ( select 1
                                        from vencimentospedidos v
                                        where v.idvencimentopedido = pp.idvencimentopedido
                                          and v.idpedido           = p.idpedido
                                          and v.situacaovencimento = 'V'
                                          and rownum = 1 ) ) negociadora
                     , p.datavencimento 
                     , 'P'||p.idpedido nrpedido
                     , case
                         when ( select 1
                                from classificacoespedidos c
                                where c.idcaracteristicapedido = 28
                                  and c.idpedido               = p.idpedido
                                  and not exists ( select 1
                                                   from classificacoespedidos c
                                                   where c.idcaracteristicapedido = 27
                                                     and c.idpedido               = p.idpedido ) ) = 1 then
                           'Sim'
                         else 
                           'Não'
                       end pedidodistribuidor
                     , ( select pck_util_fav.fnc_formapagamento(pg.idformapagamento)
                         from pagamentospedidos pg
                         where pg.origempagamento = 'C'
                           and pg.idsituacao != 40
                           and rownum = 1
                           and exists ( select 1
                                        from vencimentospedidos v
                                        where v.idvencimentopedido = pg.idvencimentopedido
                                          and v.idpedido = p.idpedido
                                          and v.situacaovencimento = 'V'
                                          and rownum = 1 ) ) formapagamento
                     , ( select u.USUARIO
                         from pagamentospedidos pp
                            , usuarios u
                         where pp.origempagamento = 'C'
                           and pp.idsituacao != 40
                           and pp.idusuarionegociacao = u.idusuario
                           and rownum = 1
                           and exists ( select 1
                                        from vencimentospedidos v
                                        where v.idvencimentopedido = pp.idvencimentopedido
                                          and v.idpedido           = p.idpedido
                                          and v.situacaovencimento = 'V'
                                          and rownum = 1 ) ) USUARIO
                     , dataparcelamento
                     , p.telefones
                from vw_parcelamentospedidos_fav p
                where :P216_FILTRAR = 1
                  and ( :P216_DATAINICIO is null or ( :P216_TIPODATA = 'B' and trunc(p.databaixa) between to_date(:P216_DATAINICIO,'DD/MM/RRRR') and to_date(:P216_DATAFIM,'DD/MM/RRRR') )
                                                 or ( :P216_TIPODATA = 'V' and trunc(p.datavencimento) between to_date(:P216_DATAINICIO,'DD/MM/RRRR') and to_date(:P216_DATAFIM,'DD/MM/RRRR') )
                                                 or ( :P216_TIPODATA = 'P' and trunc(p.dataparcelamento) between to_date(:P216_DATAINICIO,'DD/MM/RRRR') and to_date(:P216_DATAFIM,'DD/MM/RRRR') ) )
                  and ( :P216_COMPROVANTE is null or p.comprovante like '%'||:P216_COMPROVANTE||'%' )
                  and ( :P216_IDFILIALROMANCE is null or p.idfilialromance = :P216_IDFILIALROMANCE )
                  and ( :P216_IDREPRESENTANTE is null or p.idrepresentante = :P216_IDREPRESENTANTE )
                  and ( :P216_IDVENDEDORA is null or p.idvendedora = :P216_IDVENDEDORA )
                  and ( :P216_BONIFICACAOPAGA is null or nvl(p.bonificacaopaga,'N') = :P216_BONIFICACAOPAGA )
                  and ( :P216_SITUACAO is null or p.situacao = :P216_SITUACAO )
                  and ( :P216_IDUSUARIONEGOCIACAO is null or  p.idnegociadoraresponsavel = :P216_IDUSUARIONEGOCIACAO )
                  /*and ( :P216_IDUSUARIONEGOCIACAO is null or exists ( select 1
                                                                      from pagamentospedidos pg
                                                                      where pg.idusuarionegociacao = :P216_IDUSUARIONEGOCIACAO
                                                                        and exists ( select 1
                                                                                     from vencimentospedidos vp
                                                                                     where vp.idpedido = p.idpedido 
                                                                                       and pg.idvencimentopedido = vp.idvencimentopedido ) ) )*/
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
