        }
    )

    button pagar-bonificacao (
        buttonName: PAGAR_BONIFICACAO
        label: Pagar Bonificação
        layout {
            sequence: 10
            region: @parcelamentos-realizados
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--success
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P216_BONIFICACAOPAGA = 'N'
                  and v('APP_USER') in ('GUILHERME','ADINA')
                ```
        }
    )

    dynamicAction confirma-pagamento-bonificação (
        name: Confirma pagamento bonificação
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @pagar-bonificacao
        }

        action native-confirm (
            action: confirm
            settings {
                message: Deseja realmente pagar a bonificação dos resultados obtidos na pesquisa?
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: PAGARBONIFICACAO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process pagar-bonificação (
        name: Pagar Bonificação
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  pck_negociacoes_fav.prc_pagarbonificacaoparcelas( ptipodata            => :P216_TIPODATA,
                                                                    pdatainicio          => :P216_DATAINICIO,
                                                                    pdatafim             => :P216_DATAFIM,
                                                                    pidfilialromance     => :P216_IDFILIALROMANCE,
                                                                    pidrepresentante     => :P216_IDREPRESENTANTE,
                                                                    pidvendedora         => :P216_IDVENDEDORA,
                                                                    psituacao            => :P216_SITUACAO,
                                                                    pidusuarionegociacao => :P216_IDUSUARIONEGOCIACAO,
                                                                    pcpf                 => :P216_CPF,
                                                                    pcomprovante         => :P216_COMPROVANTE,
                                                                    pidusuario           => :P0_IDUSUARIO );
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Bonificação paga com sucesso!
        }
        advanced {
            executionMappingIdentifier: 477483615971558315
        }
        serverSideCondition {
            type: request=Value
            value: PAGARBONIFICACAO
        }
    )

    branch (
        name: Go To Page 216
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 216
                items: {
                    P216_TIPODATA: &P216_TIPODATA.
                    P216_IDFILIALROMANCE: &P216_IDFILIALROMANCE.
                    P216_IDREPRESENTANTE: &P216_IDREPRESENTANTE.
                    P216_IDVENDEDORA: &P216_IDVENDEDORA.
                    P216_SITUACAO: &P216_SITUACAO.
                    P216_IDUSUARIONEGOCIACAO: &P216_IDUSUARIONEGOCIACAO.
                    P216_CPF: &P216_CPF.
                    P216_COMPROVANTE: &P216_COMPROVANTE.
                    P216_BONIFICACAOPAGA: &P216_BONIFICACAOPAGA.
                    P216_DATAINICIO: &P216_DATAINICIO.
                    P216_DATAFIM: &P216_DATAFIM.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') in ( 'PAGARBONIFICACAO' , 'FILTRAR' )
                ```
        }
    )

)

