    pageItem P216_IDFILIALROMANCE (
        type: popupLov
        label {
            label: Filial
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomefilial(idfilial) display_value
                     , idfilial return_value
                from filiais f
                where f.ativo  = 'S'
                  and f.tipofilial = 'D'
                order by 1
                ```
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P216_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(idrepresentante) display_value
                     , idrepresentante return_value
                from representantes
                where (:P216_IDFILIALROMANCE is null or
                    ( :P216_IDFILIALROMANCE is not null and idgerente in ( select idgerente from gerentes where idfilial = :P216_IDFILIALROMANCE) ))
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P216_IDFILIALROMANCE
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P216_IDUSUARIONEGOCIACAO (
        type: selectList
        label {
            label: Responsável Cob.
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomeusuario(usuario) display_value   
                , idusuario return_value
                from usuarios
                where idgerente = 80
                  and ativo = 'S'
                order by 1 
                ```
        }
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P216_IDVENDEDORA (
        type: popupLov
        label {
            label: Consultora
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(nomepessoa)||' - '||p.cpf display_value
                     , idvendedora return_value
                from vendedoras v
                   , pessoas p
                where p.idpessoa = v.idpessoa 
                  and (:P216_IDREPRESENTANTE is null or v.idrepresentante = :P216_IDREPRESENTANTE)
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P216_IDREPRESENTANTE
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
