page 237 (
    name: Logs de Vencimentos
    title: Logs de Vencimentos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region logs-de-vencimentos (
        name: Logs de Vencimentos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.idpedido
                     , v.usuarioalteracao
                     , v.desctipoalteracao
                     , v.dataalteracao
                     , v.idvencimentopedido
                     , v.datavencimento
                     , v.valorpagar
                     , v.valorpago
                     , v.situacaovencimento
                from vw_log_vencimentospedidos_fav v
                where v.idpedido = :P237_IDPEDIDO
                order by 4 desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1690509515237351844
        }

        column DATAALTERACAO (
            type: plainText
            heading {
                heading: Data Alteração
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR HH24:MI:SS
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: D
            }
        )

        column DATAVENCIMENTO (
            type: plainText
            heading {
                heading: Data Vencimento
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            appearance {
                formatMask: DD/MM/RRRR
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: F
            }
        )

        column DESCTIPOALTERACAO (
            type: plainText
            heading {
                heading: Tipo de Alteração
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column IDPEDIDO (
            type: plainText
            heading {
                heading: Nr Pedido
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column IDVENCIMENTOPEDIDO (
            type: plainText
            heading {
                heading: Cod. Vencimento
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        column SITUACAOVENCIMENTO (
            type: plainText
            heading {
                heading: Situação Vencimento
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        column USUARIOALTERACAO (
            type: plainText
            heading {
                heading: Usuário que Alterou
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column VALORPAGAR (
            type: plainText
            heading {
                heading: A Pagar
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column VALORPAGO (
            type: plainText
            heading {
                heading: Pago
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 5727827 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATAALTERACAO (
                sequence: 4
            )

            displayColumn DATAVENCIMENTO (
                sequence: 6
            )

            displayColumn DESCTIPOALTERACAO (
                sequence: 3
            )

            displayColumn IDPEDIDO (
                sequence: 1
            )

            displayColumn IDVENCIMENTOPEDIDO (
                sequence: 5
            )

            displayColumn SITUACAOVENCIMENTO (
                sequence: 9
            )

            displayColumn USUARIOALTERACAO (
                sequence: 2
            )

            displayColumn VALORPAGAR (
                sequence: 7
            )

            displayColumn VALORPAGO (
                sequence: 8
            )

        )

    )

    pageItem P237_IDPEDIDO (
        type: textField
        label {
            label: Nr Pedido
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 237
                items: {
                    P237_IDPEDIDO: &P237_IDPEDIDO.
                }
                action: resetPagination
            }
        }
    )

)

