page 11 (
    name: Relatório de Cores
    title: Cores
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cores (
        name: Cores
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idcor
                     , descricao
                     , descricaotraduzida
                     , idtexto
                from vw_cores_fav
                where ididioma = :P0_IDIDIOMA
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 7686820145972750
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDCOR
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @DESCRICAO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDTEXTO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @DESCRICAOTRADUZIDA
                layout {
                    sequence: 2
                }
            )

        )

        column DESCRICAO (
            type: textarea
            heading {
                heading: Descrição
            }
            layout {
                sequence: 20
            }
            validation {
                valueRequired: true
                maxLength: 200
            }
            source {
                databaseColumn: DESCRICAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column DESCRICAOTRADUZIDA (
            type: textarea
            heading {
                heading: Descrição Traduzida
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: DESCRICAOTRADUZIDA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column IDCOR (
            type: link
            heading {
                heading: Editar
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 12
                    items: {
                        P12_IDCOR: &IDCOR.
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                databaseColumn: IDCOR
                dataType: number
            }
        )

        column IDTEXTO (
            type: link
            heading {
                heading: Tradução
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            link {
                target: {
                    page: 100
                    items: {
                        P100_IDTEXTOTRADUZIDO: &IDTEXTO.
                    }
                    action: resetPagination
                }
                linkText: <b>Visualizar / Atualizar texto traduzido</b>
                linkAttributes: class="t-Button t-Button--sucess"
            }
            source {
                databaseColumn: IDTEXTO
                dataType: number
            }
        )

    )

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    button novo (
        buttonName: Novo
        label: Novo
        layout {
            sequence: 10
            region: @cores
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 12
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button novo-2 (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 12
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

