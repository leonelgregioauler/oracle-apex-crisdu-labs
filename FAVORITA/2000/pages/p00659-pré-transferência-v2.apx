    pageItem P659_IDEDICAOREVISTA (
        type: selectList
        label {
            label: Edição de Revsita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.nome
                     , e.idedicaorevista
                from edicoesrevistas e
                where e.idpais = 1
                  and e.tipovenda = 'R'
                  and e.liberarcompra = 'S'
                order by e.numeroedicao desc
                ```
        }
        layout {
