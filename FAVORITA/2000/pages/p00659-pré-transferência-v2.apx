    region itens-extras-selecionados (
        name: Itens Extras Selecionados
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.iditemextra,
                       i.qtdextra,
                       pck_util_fav.fnc_nomeprodutodetalhado(d.idprodutodetalhado, :P0_IDIDIOMA) descricao
                  from produtosdetalhados d
                     , itenspretransfextras i
                 where d.idprodutodetalhado = i.idprodutodetalhado
                   and i.idusuario = :P0_IDUSUARIO
                
                ```
        }
        layout {
            sequence: 10
            parentRegion: @itens-extras-p-pré-transferência
            slot: subRegions
