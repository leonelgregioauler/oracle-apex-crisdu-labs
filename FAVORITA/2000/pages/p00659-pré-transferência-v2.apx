    region itens-preselecionados (
        name: Itens_PreSelecionados_2
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select nomeProduto
                     , t.iditempretransferencia
                     --, t.iditempretransferencia_display
                     , t.idpretransferencia
                     , t.idprodutodetalhado
                     , t.quantidade
                     , t.quantidadeestoqueorigem
                     , t.quantidadeestoquedestino
                     , nvl(t.selecionado,'N') as selecionado
                     , qtdcomptransf comptransf     
                     , t.qtdAjuste
                     , (select distinct 'R' -- Distinct adicionado no T12627147
                          from itenspretransfextras i
                         where i.idprodutodetalhado = t.idprodutodetalhado
                           and nvl(t.selecionado,'N') = 'N'
                           and i.idusuario = :P0_IDUSUARIO ) Extra
                     , t.categoriasite
                     , t.categoria
                     , t.subcategoria
                     , t.alvo
                     , p.venda_mensal
                  from (
                        select i.iditempretransferencia
                             , i.iditempretransferencia iditempretransferencia_display
                             , i.idpretransferencia
                             , i.idprodutodetalhado
                             , pck_util_fav.fnc_nomeprodutodetalhado(i.idprodutodetalhado,:P0_IDIDIOMA) nomeProduto
                             , i.quantidade
                             , i.qtdestoqueorigem quantidadeestoqueorigem
                             , i.qtdestoquedestino quantidadeestoquedestino
                             , i.selecionado
                             , i.qtdcomptransf   
                             , (select sum(quantidade)
                                  from movimentosestoques m
                                 where m.datamovimento between p.datainicio and p.datafim
                                   and m.iditemcompratransf is null
                                   and m.iditempedido is null
                                   and m.idfilialfavorita = :P659_IDFILIALFAVORITADESTINO
                                   and m.idprodutodetalhado = i.idprodutodetalhado) qtdAjuste
                             , (select cs.nomecategoria
                                  from favorita.categorias c
                                     , favorita.categoriassite cs
                                     , favorita.produtos p
                                     , favorita.produtosdetalhados pd
                                 where c.idcategoriasite = cs.idcategoriasite
                                   and p.idcategoria = c.idcategoria
                                   and p.idproduto = pd.idproduto
                                   and pd.idprodutodetalhado = i.idprodutodetalhado) categoriasite
                             , (select c.nome
                                  from favorita.categorias c
                                     , favorita.categoriassite cs
                                     , favorita.produtos p
                                     , favorita.produtosdetalhados pd
                                 where c.idcategoriasite = cs.idcategoriasite
                                   and p.idcategoria = c.idcategoria
                                   and p.idproduto = pd.idproduto
                                   and pd.idprodutodetalhado = i.idprodutodetalhado) categoria
                             , (select sc.nome
                                  from favorita.subcategorias sc
                                     , favorita.categorias c
                                     , favorita.categoriassite cs
                                     , favorita.produtos p
                                     , favorita.produtosdetalhados pd
                                 where sc.idcategoria = c.idcategoria
                                   and c.idcategoriasite = cs.idcategoriasite
                                   and p.idcategoria = c.idcategoria
                                   and p.idsubcategoria = sc.idsubcategoria
                                   and p.idproduto = pd.idproduto
                                   and pd.idprodutodetalhado = i.idprodutodetalhado) subcategoria
                             , i.alvo
                          from itenspretransferencias i
                             , pretransferencias      p
                         where p.idpretransferencia = :P659_IDPRETRANSFERENCIA
                           and p.idpretransferencia = i.idpretransferencia
                       ) t
                     , (
                        select sum(i.quantidade) venda_mensal
                             , i.idprodutodetalhado 
                        from favorita.vw_itenspedidos_fav i
                           , favorita.pedidos p
                        where i.idpedido = p.idpedido 
                        and i.ididioma = :P0_IDIDIOMA
                        and i.idfilialfavorita = :P659_IDFILIALFAVORITADESTINO
                        and trunc(p.dataemissao) between trunc(add_months(sysdate, -1)) and trunc(sysdate)
                        and p.datacancelamento is null
                        and not exists ( select 1
                                         from classificacoespedidos c
                                         where c.idpedido = p.idpedido
                                         and c.idcaracteristicapedido = 25 )
                        group by i.idprodutodetalhado
                     ) p
                where p.idprodutodetalhado(+) = t.idprodutodetalhado
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
