    process operação-dml-grid-interativo (
        name: Operação DML Grid Interativo
        type: interactiveGridAutoRowProcessing
        editableRegion: @itens-preselecionados
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                declare  
                  --
                  vrequest varchar2(1);
                  vidpretransferencia number := :P659_IDPRETRANSFERENCIA;
                  videstoqueo number;
                  videstoqued number;
                  --
                begin
                  --
                    case 
                    when :APEX$ROW_STATUS != 'D' then
                
                        if :IDITEMPRETRANSFERENCIA is not null then
                          --
                          update itenspretransferencias it
                             set it.selecionado = :SELECIONADO
                               , it.quantidade = :QUANTIDADE
                          where it.iditempretransferencia = :IDITEMPRETRANSFERENCIA;
                          --
                        elsif :IDITEMPRETRANSFERENCIA is null then
                          --
                          select idestoque 
                            into videstoqueo 
                            from estoques 
                           where idprodutodetalhado = :IDPRODUTODETALHADO 
                             and idfilialfavorita = :P659_IDFILIALFAVORITAORIGEM;
                
                          select idestoque 
                            into videstoqued
                            from estoques 
                           where idprodutodetalhado = :IDPRODUTODETALHADO 
                             and idfilialfavorita = :P659_IDFILIALFAVORITADESTINO;
                
                          select SEQ_IDITEMPRETRANSFERENCIA.NEXTVAL
                            into :IDITEMPRETRANSFERENCIA
                            from dual;
                        
                          INSERT INTO ITENSPRETRANSFERENCIAS ( IDITEMPRETRANSFERENCIA 
                                                             , IDPRETRANSFERENCIA 
                                                             , idprodutodetalhado
                                                             , quantidade
                                                             , selecionado
                                                             , qtdestoqueorigem
                                                             , qtdestoquedestino
                                                             , qtdcomptransf)
                           VALUES ( :IDITEMPRETRANSFERENCIA
                                  , vidpretransferencia
                                  , :IDPRODUTODETALHADO
                                  , :QUANTIDADE
                                  , NVL(:SELECIONADO,'N')
                                  , pck_estoque_fav.fnc_estoquedisponivel(videstoqueo)
                                  , pck_estoque_fav.fnc_estoquedisponivel(videstoqued)
                                  , 0);          --
                        end if;
                    else 
                        delete itenspretransferencias it
                         where it.iditempretransferencia = :IDITEMPRETRANSFERENCIA;
                    end case;
                end;
                
                ```
        }
        lockRow {
            lockRow: false
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 379272673156943508
        }
    )

