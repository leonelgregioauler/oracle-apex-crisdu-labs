    process operação-dml-em-pre-transferencias (
        name: Operação DML em Pre Transferencias
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vdatainicio date;
                  vdatafim    date;
                  vatendente  number;
                  vidcompratransferencia number;
                  --
                begin
                  --
                  delete itenspretransferencias
                   where idpretransferencia = :P659_IDPRETRANSFERENCIA
                     and nvl(selecionado,'N') != 'S';
                  --
                  commit;
                  --
                  pck_comprastransf_fav.prc_confirmapretransferencia_v2(pidpretransferencia => :P659_IDPRETRANSFERENCIA,
                                                                        pidusuario => :P0_IDUSUARIO,
                                                                        pidcompratransferencia => vidcompratransferencia);
                  --
                  commit;
                  --
                  :P659_IDCOMPRATRANSFERENCIA := vidcompratransferencia;
                  --
                end;
                ```
