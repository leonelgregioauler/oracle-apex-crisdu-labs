    process buscar-produtos-com-pouco-estoque (
        name: Buscar Produtos com Pouco Estoque
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_comprastransf_fav.prc_atualizatransferencia_loja(pidpretransferencia => :P659_IDPRETRANSFERENCIA,
                                                                       pidfilialorigem => :P659_IDFILIALFAVORITAORIGEM,
                                                                       pidfilialdestino => :P659_IDFILIALFAVORITADESTINO,
                                                                       pidedicaorevista => :P659_IDEDICAOREVISTA,
                                                                       pqtdbalizadora => :P659_QTD_BALIZADORA );
                end;
                
                ```
        }
        execution {
            sequence: 70
        }
        successMessage {
            successMessage: Produtos Atualizados!
        }
        advanced {
            executionMappingIdentifier: 379282018521943531
        }
        serverSideCondition {
            type: request=Value
            value: BUSCAR
        }
    )

    process consulta-pretransferencia (
        name: Consulta PreTransferencia
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vdata date;
                  vdatainicio date;
                  vdatafim date;
                  --
                begin
                  --
                 PCK_COMPRASTRANSF_FAV.PRC_PRETRANSFERENCIAS( PIDPRETRANSFERENCIA      => :P659_IDPRETRANSFERENCIA,
                                                              PIDUSUARIO               => :P659_IDUSUARIO,
                                                              PIDFILIALFAVORITAORIGEM  => :P659_IDFILIALFAVORITAORIGEM,
                                                              PIDFILIALFAVORITADESTINO => :P659_IDFILIALFAVORITADESTINO,
                                                              PDATA                    => vdata,
                                                              PIDCOMPRATRANSFERENCIA   => :P659_IDCOMPRATRANSFERENCIA,
                                                              PDATAINICIO              => vdatainicio,
                                                              PDATAFIM                 => vdatafim,
                                                              PTEMPOREPOSICAO          => :P659_TEMPO_REPOSICAO,
                                                              PMD5                     => :P659_MD5,
                                                              POPERACAO_DML            => 'S' );
                  --
                  :P659_DATA           := to_char(vdata,'DD/MM/RRRR hh24:MI:SS');
                  :P659_DATAINICIO     := to_char(vdatainicio,'DD/MM/RRRR');
                  :P659_DATAFIM        := to_char(vdatafim,'DD/MM/RRRR');
                  :P659_PERIODO_FILTRO := vdatafim - vdatainicio;
                  --
                  
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 379280866239943531
        }
    )

