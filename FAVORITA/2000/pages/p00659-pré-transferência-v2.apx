    pageItem P659_PRODUTOS (
        type: displayOnly
        label {
            alignment: left
        }
        layout {
            sequence: 10
            region: @produtos-com-necessidade-de-solicitação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vprodutos varchar2(4000);
                begin
                  --
                  select listagg(e.produto||' - Qtd em Estoque: '||pck_estoque_fav.fnc_estoquedisponivel(e.idestoque),' ') within group (order by 1)  info
                  into vprodutos
                  from vw_estoques_fav e
                  where e.idfilialfavorita = :P0_IDFILIALFAVORITA
                    and nvl(e.quantidade,0) - nvl(e.quantidadereservada,0) <= 1
                    and e.ativo = 'S'
                    and exists ( select 1
                                 from itenspedidos it
                                    , pedidos p
                                    , pretransferencias pr
                                 where it.idestoque = e.idestoque
                                   and it.idpedido  = p.idpedido
                                   and pr.idpretransferencia = :P659_IDPRETRANSFERENCIA
                                   and p.idfilialfavorita = pr.idfilialfavoritadestino
                                   and not exists ( select 1
                                                    from classificacoespedidos cp
                                                    where cp.idcaracteristicapedido = 25
                                                      and cp.idpedido               = p.idpedido )
                                   and not exists ( select 1
                                                    from itenspretransferencias itp
                                                    where itp.idpretransferencia = pr.idpretransferencia )
                                   and trunc(p.dataemissao) between trunc(sysdate)-5 and trunc(sysdate) );
                  --
                  return vprodutos;
                  --
                exception
                  when others then
                    return 'Produtos OK!';
                end;
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from vw_estoques_fav e
                  where e.idfilialfavorita = :P0_IDFILIALFAVORITA
                    and nvl(e.quantidade,0) - nvl(e.quantidadereservada,0) <= 1
                    and e.ativo = 'S'
                    and exists ( select 1
                                 from itenspedidos it
                                    , pedidos p
                                    , pretransferencias pr
                                 where it.idestoque = e.idestoque
                                   and it.idpedido  = p.idpedido
                                   and pr.idpretransferencia = :P659_IDPRETRANSFERENCIA
                                   and p.idfilialfavorita = pr.idfilialfavoritadestino
                                   and not exists ( select 1
                                                    from classificacoespedidos cp
                                                    where cp.idcaracteristicapedido = 25
                                                      and cp.idpedido               = p.idpedido )
                                   and not exists ( select 1
                                                    from itenspretransferencias itp
                                                    where itp.idpretransferencia = pr.idpretransferencia )
                                   and trunc(p.dataemissao) between trunc(sysdate)-5 and trunc(sysdate) )
                ```
        }
        security {
            encryptSessionState: false
        }
    )

