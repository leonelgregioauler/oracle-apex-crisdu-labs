    dynamicAction copia (
        name: Copia
        execution {
            sequence: 20
        }
        when {
            event: custom
            customEvent: copy Selection Type
            selectionType: jQuerySelector
            jquerySelector: body
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var text, i, selection, gridSel;
                    
                    var event = this.browserEvent.originalEvent; // need the clipboard event
                    
                    // we only care about copy from a grid cell ignore the rest
                    
                    if ( !$(document.activeElement).hasClass("a-GV-cell") ) {
                    
                        return;
                    
                    }
                    
                    var view = apex.region("ITENSPRE").widget().interactiveGrid("getCurrentView"); //change "emp" to you IG static id
                    
                    if ( view.internalIdentifier === "grid") {
                    
                        text = "";
                    
                        selection = window.getSelection();
                        //console.log(selection)
                        gridSel = view.view$.grid("getSelection");
                        //console.log(gridSel)
                    
                    
                        for (i = 0; i < gridSel.length; i++) {
                            selection.selectAllChildren(gridSel[i][1]);
                            console.log($($(document.getElementsByClassName("is-selected")[1])[0].cells[0]).text());
                            
                            //text += selection.toString();
                            text += $(document.getElementsByClassName("is-selected")[1])[0].cells[0];
                            //if (gridSel[i].length > 1) {
                    
                              //  selection.selectAllChildren(gridSel[i][1]);
                    
                              //  text += " \t" + selection.toString();
                    
                            //}
                    
                           // text += "";
                    
                        }
                    
                        selection.removeAllRanges();
                    
                        event.clipboardData.setData('text/plain', text);
                    
                        event.preventDefault();
                    
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction existe (
        name: Existe
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P659_PRODUTOEXTRA
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    vExiste number;
                    begin
                      select count(*) into vExiste
                        from itenspretransferencias
                       where idpretransferencia = :P659_IDPRETRANSFERENCIA
                         and idprodutodetalhado = :P659_PRODUTOEXTRA;
                      if nvl(vExiste,0) > 0 then
                         raise_application_error(-20001,'Item já está incluso na pré-transferência!');
                      end if;
                    end;
                    ```
                itemsToSubmit: [
                    P659_IDPRETRANSFERENCIA
                    P659_PRODUTOEXTRA
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

