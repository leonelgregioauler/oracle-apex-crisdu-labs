    region rank-de-pedidos-agrupado (
        name: Rank de Pedidos Agrupado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idfilialromance as "ID Filial"
                     , roman.pck_romance.fnc_nomefilial(p.idfilialromance) filial
                     , sum(qtdfavorita) qtd
                     , sum(QTDfavoritaparis) QTDfavoritaparis
                     , sum(nvl(p.valorapagarfavorita, 0))      valorapagarfavorita
                     , sum(nvl(p.valorapagarfavorita, 0) * p.fatorconversao)  valorapagarfavoritaconv
                     , sum(nvl(p.valorapagarfavoritaparis, 0)) valorapagarfavoritaparis
                     , sum(nvl(p.valorapagarfavorita, 0)) + sum(nvl(p.valorapagarfavoritaparis, 0)) total
                     , nomepais
                from vw_rank_pedidos_agrp p
                where p.dataemissao between to_date(:P257_DATAINICIO||' 00:00:01' ,'dd/mm/rrrr hh24:mi:ss' ) and to_date(:P257_DATAFIM||' 23:59:59' ,'dd/mm/rrrr hh24:mi:ss' )
                  and (:P257_IDFILIALROMANCE is null 
                          OR ( p.idfilialromance in (select regexp_substr(:P257_IDFILIALROMANCE, '[^:]+', 1, level) 
                                                        from dual
                                                      connect by level <= regexp_count(:P257_IDFILIALROMANCE, ':') + 1)  ))
                  and ( :P257_PEDIDONUMERO = 'N'
                     or exists ( select 1
                                 from classificacoespedidos cp
                                 where cp.idpedido = p.idpedido
                                   and cp.idcaracteristicapedido = 11
                                   and ( ( :P257_PEDIDONUMERO = 1 and cp.idvalorcaracteristica = 1 )
                                      or ( :P257_PEDIDONUMERO = 2 and cp.idvalorcaracteristica = 2 )
                                      or ( :P257_PEDIDONUMERO = 3 and cp.idvalorcaracteristica >= 3 ) ) ) )
                  and :P257_FILTRAR = 'S'
                  and (:P257_IDPAIS = -1 or p.idpais = :P257_IDPAIS)
                group by p.nomepais, p.idfilialromance 
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P257_TIPORELATORIO  = 'A'
                  and :P257_SITUACAOPEDIDO = 'F'
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum resultado encontrado, verifique os filtros informados.
        }
        advanced {
            savedReportMappingIdentifier: 580823960373871626
        }

