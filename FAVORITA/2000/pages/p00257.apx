    region rank-de-pedidos-pagos-por-canal-de-venda (
        name: Rank de Pedidos Pagos por Canal de Venda
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idfilialromance as "ID Filial"
                     , roman.pck_romance.fnc_nomefilial(p.idfilialromance) empresa
                     , pck_util_fav.fnc_nomefilialfavorita(p.idfilialfavorita) favorita
                     , roman.pck_romance.fnc_nomerepresentante(p.idrepresentante) distribuidor
                     , count(p.valorpago) qtd
                     , sum(nvl(p.valorapagofavorita, 0)) valorapagofavorita
                     , sum(nvl(p.valorapagofavorita, 0) * p.fatorconversao) valorapagofavoritaConv
                     , p.idrepresentante as "ID Distribuidor"
                from vw_rank_pedidos_dist_v2 p
                where p.dataemissao between to_date(:P257_DATAINICIO||' 00:00:00' ,'dd/mm/rrrr hh24:mi:ss' ) and to_date(:P257_DATAFIM||' 23:59:59' ,'dd/mm/rrrr hh24:mi:ss' )
                  and (:P257_IDFILIALROMANCE is null 
                          OR ( p.idfilialromance in (select regexp_substr(:P257_IDFILIALROMANCE, '[^:]+', 1, level) 
                                                        from dual
                                                      connect by level <= regexp_count(:P257_IDFILIALROMANCE, ':') + 1)  ))
                  and ( :P257_PEDIDONUMERO = 'N'
                     or exists ( select 1
                                 from classificacoespedidos cp
                                 where cp.idpedido = p.idpedido
                                   and cp.idcaracteristicapedido = 11
                                   and ( ( :P257_PEDIDONUMERO = 1 and cp.idvalorcaracteristica = 1 )
                                      or ( :P257_PEDIDONUMERO = 2 and cp.idvalorcaracteristica = 2 )
                                      or ( :P257_PEDIDONUMERO = 3 and cp.idvalorcaracteristica >= 3 ) ) ) )
                  and :P257_FILTRAR = 'S'
                  and (:P257_IDPAIS = -1 or p.idpais = :P257_IDPAIS)
                group by p.idrepresentante, p.idfilialromance, p.idfilialfavorita, p.idrepresentante
                order by 2 desc
                ```
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P257_TIPORELATORIO  = 'C'
                  and :P257_SITUACAOPEDIDO = 'P'
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum pedido encontrado.
        }
        advanced {
            savedReportMappingIdentifier: 5565946827634656910
        }

