    region rank-de-pedidos-por-canal-de-venda (
        name: Rank de Pedidos por Canal de Venda
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idfilialromance as "ID Filial"
                     , empresa
                     , favorita
                     , distribuidor
                     , sum(qtd) qtd 
                     , sum(QTDfavoritaparis) QTDfavoritaparis
                     , sum(valorapagarfavorita) valorapagarfavorita
                     , sum(valorapagarfavoritaconversao) valorapagarfavoritaconversao
                     , sum(valorapagarfavoritaparis) valorapagarfavoritaparis
                     , sum(total) total
                     , sum(ValorPagoAvista) ValorPagoAvista
                     , sum(ValorPagoAvistaconversao) ValorPagoAvistaconversao
                     , idrepresentante as "ID Distribuidor"
                  from (select p.idfilialromance
                             , roman.pck_romance.fnc_nomefilial(p.idfilialromance) empresa
                             , pck_util_fav.fnc_nomefilialfavorita(nvl(pp.idfilialfavoritaorig, p.idfilialfavorita)) favorita
                             , roman.pck_romance.fnc_nomerepresentante(p.idrepresentante) distribuidor
                             , sum(QTDfavorita) qtd
                             , sum(QTDfavoritaparis) QTDfavoritaparis
                             , round(sum(nvl(p.valorapagarfavorita, 0)),2)      valorapagarfavorita
                             , round(sum(nvl(p.valorapagarfavorita* pp.fatorconversao, 0)),2)      valorapagarfavoritaconversao
                             , round(sum(nvl(p.valorapagarfavoritaparis, 0)),2) valorapagarfavoritaparis
                             , round(sum(nvl(p.valorapagarfavorita, 0)) + sum(nvl(p.valorapagarfavoritaparis, 0)),2) total
                             , nvl(( select round(sum(nvl(pg.valorpago, 0)),2) PagoAvista
                                       from favorita.pagamentospedidos pg
                                          , favorita.vencimentospedidos v
                                          , favorita.vw_rank_pedidos_dist pp
                                      where pg.idvencimentopedido = v.idvencimentopedido
                                        and v.idpedido = p.idpedido
                                        and p.idpedido = pp.idpedido
                                        and v.situacaovencimento = 'V'
                                        and trunc (pg.datapagamento) = trunc (p.dataemissao) ),0) ValorPagoAvista
                             , nvl(( select round(sum(nvl(pg.valorpago*pp.fatorconversao, 0)),2)  PagoAvista
                                       from favorita.pagamentospedidos pg
                                          , favorita.vencimentospedidos v
                                          , favorita.vw_rank_pedidos_dist_v2 pp
                                      where pg.idvencimentopedido = v.idvencimentopedido
                                        and v.idpedido = p.idpedido
                                        and p.idpedido = pp.idpedido
                                        and v.situacaovencimento = 'V'
                                        and trunc (pg.datapagamento) = trunc (p.dataemissao) ),0) ValorPagoAvistaconversao
                             , p.idrepresentante
                        from vw_rank_pedidos_dist_v2 p
                           , favorita.pedidos pp
                       where p.IDPEDIDO = pp.IDPEDIDO 
                         and trunc(p.dataemissao) between :P257_DATAINICIO and :P257_DATAFIM
                         and (:P257_IDFILIALROMANCE is null 
                                  OR ( p.idfilialromance in (select regexp_substr(:P257_IDFILIALROMANCE, '[^:]+', 1, level) 
                                                                from dual
                                                              connect by level <= regexp_count(:P257_IDFILIALROMANCE, ':') + 1)  ))
                          and ( :P257_PEDIDONUMERO = 'N'
                             or exists ( select 1
                                         from classificacoespedidos cp
                                         where cp.idpedido = p.idpedido
                                           and cp.idcaracteristicapedido = 11
                                           and ( ( :P257_PEDIDONUMERO = 1 and cp.idvalorcaracteristica = 1 )
                                              or ( :P257_PEDIDONUMERO = 2 and cp.idvalorcaracteristica = 2 )
                                              or ( :P257_PEDIDONUMERO = 3 and cp.idvalorcaracteristica >= 3 ) ) ) )
                        and :P257_FILTRAR = 'S'
                        and (:P257_IDPAIS = -1 or p.idpais = :P257_IDPAIS)
                        group by  p.idrepresentante ,p.idfilialfavorita,p.idfilialromance, p.idpedido, p.dataemissao, p.idrepresentante, pp.idfilialfavoritaorig )
                  group by idfilialromance
                         , empresa
                         , favorita
                         , distribuidor
                         , idrepresentante
                 order by 2 desc
                
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P257_TIPORELATORIO  = 'C'
                  and :P257_SITUACAOPEDIDO = 'F'
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Nenhum pedido encontrado.
        }
        advanced {
            savedReportMappingIdentifier: 5370339240995931050
        }

