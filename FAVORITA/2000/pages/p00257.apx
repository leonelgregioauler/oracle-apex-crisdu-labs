    pageItem P257_IDFILIALROMANCE (
        type: selectOne
        label {
            label: Distribuidora
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome 
                     , idfilial 
                from roman.vw_filiais
                where tipofilial in ('D')
                and ativo = 'S'
                and (:P257_IDPAIS = -1 or ididioma = :P257_IDPAIS)
                union
                select f.nome
                     , f.idfilial
                from roman.vw_filiais f
                where f.idfilial in (1220,1216)
                and (:P257_IDPAIS = -1 or ididioma = :P257_IDPAIS)
                ```
        }
        cascadingLov {
            parentItems: P257_IDPAIS
            itemsToSubmit: P257_IDFILIALROMANCE
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P257_IDPAIS (
        type: selectOne
        label {
            label: País
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Todos'
                      , -1
                  from dual
                 union
                select distinct p.nome 
                    , f.ididioma
                  from roman.vw_filiais f
                     , catal.paises p
                  where f.ididioma = p.idpais
                order by 2
                ```
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            type: staticValue
            staticValue: -1
        }
    )

    pageItem P257_PEDIDONUMERO (
        type: radioGroup
        label {
            label: Pedido Número
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Não Filtrar;N,1º Pedido;1,2º Pedido;2,3º Pedido ou mais;3
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 90
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P257_SELFILIAIS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 110
            region: @filtros
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P257_SITUACAOPEDIDO (
        type: radioGroup
        label {
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Pedidos Feitos;F,Pedidos Pagos;P
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        default {
            type: static
            staticValue: F
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P257_TIPOFILIAL (
        type: radioGroup
        label {
            label: Tipo Pesquisa
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Franquia;F,Todas;T
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        default {
            type: static
            staticValue: F
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P257_TIPORELATORIO (
        type: radioGroup
        label {
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Agrupado;A,Por Distribuidora;D,Por Canal de Venda;C
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        default {
            type: static
            staticValue: A
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 100
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction mostra-franquia (
        name: mostra franquia
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P257_TIPOFILIAL
        }
        clientSideCondition {
            type: item=value
            item: P257_TIPOFILIAL
            value: F
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P257_IDFILIALROMANCE
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P257_IDFILIALROMANCE
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new (
        name: New_1
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P257_IDPAIS
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P257_IDFILIALROMANCE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new-2 (
        name: New
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P257_IDFILIALROMANCE
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select regexp_substr(:P257_IDFILIALROMANCE, '[^:]+', 1, level) 
                                                            from dual
                                                          connect by level <= regexp_count(:P257_IDFILIALROMANCE, ':') + 1
                    ```
                itemsToSubmit: P257_IDFILIALROMANCE
            }
            affectedElements {
                selectionType: items
                items: P257_SELFILIAIS
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction tipo-franquia (
        name: Tipo Franquia
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P257_TIPOPESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P257_TIPOPESQUISA
            value: F
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P257_IDFILIAL
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-hide-2 (
            action: hide
            affectedElements {
                selectionType: items
                items: P257_IDFILIALROMANCE
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P257_IDFILIAL
            }
            execution {
                sequence: 10
            }
        )

        action native-show-2 (
            action: show
            affectedElements {
                selectionType: items
                items: P257_IDFILIALROMANCE
            }
            execution {
                sequence: 10
            }
        )

    )

    branch (
        name: Go To Page 257
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 257
                items: {
                    P257_TIPORELATORIO: &P257_TIPORELATORIO.
                    P257_DATAINICIO: &P257_DATAINICIO.
                    P257_DATAFIM: &P257_DATAFIM.
                    P257_PEDIDONUMERO: &P257_PEDIDONUMERO.
                    P257_FILTRAR: S
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

