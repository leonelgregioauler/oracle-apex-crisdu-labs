    process fetch-row-from-perfisatendimentos (
        name: Fetch Row from PERFISATENDIMENTOS
        type: autoRowFetch
        source {
            tableName: PERFISATENDIMENTOS
            pkColumn: IDPERFILATENDIMENTO
            pkItem: P563_IDPERFILATENDIMENTO
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 99876120654784274
        }
    )

    process get-pk (
        name: Get PK
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    if :P563_IDPERFILATENDIMENTO is null then
                        select "#OWNER#"."SEQ_IDPERFILATENDIMENTO".nextval
                          into :P563_IDPERFILATENDIMENTO
                          from sys.dual;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 99876599355784274
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

