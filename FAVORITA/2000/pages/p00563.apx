page 563 (
    name: Cadastro de Perfis de Atendimento
    title: Cadastro de Perfis de Atendimento
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG_26"';
    }

    region perfis-de-atendimento (
        name: Perfis de Atendimento
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P563_IDGRUPOATENDIMENTO (
        type: selectList
        label {
            label: Grupo de Atendimento
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select g.descricao
                     , g.idgrupoatendimento
                from roman.gruposatendimento g
                where g.idgrupoatendimento in (34,33,4)
                order by 1
                ```
        }
        layout {
            sequence: 50
            region: @perfis-de-atendimento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDGRUPOATENDIMENTO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P563_IDIDIOMA (
        type: selectList
        label {
            label: Idioma
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select idpais || ' - ' || nome display_value
                     , ididioma return_value
                  from IDIOMAS
                 order by ididioma
                ```
        }
        layout {
            sequence: 40
            region: @perfis-de-atendimento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDIDIOMA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P563_IDPERFIL (
        type: selectList
        label {
            label: Perfil
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select descricao display_value,
                       idperfil  return_value
                from perfis
                order by 1
                ```
        }
        layout {
            sequence: 20
            region: @perfis-de-atendimento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDPERFIL
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P563_IDPERFILATENDIMENTO (
        type: hidden
        layout {
            sequence: 10
            region: @perfis-de-atendimento
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: IDPERFILATENDIMENTO
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    pageItem P563_IDPERFILVENDA (
        type: selectList
        label {
            label: Perfil Venda
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select descricao display_value,
                       idperfilvenda  return_value
                from perfisvendas
                where idperfil = :P563_IDPERFIL
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P563_IDPERFIL
        }
        layout {
            sequence: 30
            region: @perfis-de-atendimento
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            type: databaseColumn
            databaseColumn: IDPERFILVENDA
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
