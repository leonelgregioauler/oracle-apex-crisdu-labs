    validation valida-inteiro (
        name: Valida Inteiro
        execution {
            sequence: 20
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  vquantidade number:= :P77_QUANTIDADECOMPRADA;
                  --
                begin
                  --
                  if (vquantidade - floor(vquantidade)) > 0 then
                    --
                    Return 'Valor deve ser inteiro';
                    --
                  end if;
                  --
                end;
                ```
            alwaysExecute: true
        }
    )

    validation valida-positivo (
        name: Valida Positivo
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  vquantidade number:= :P77_QUANTIDADECOMPRADA;
                  --
                begin
                  --
                  if (vquantidade) < 0 then
                    --
                    Return 'Valor deve ser positivo';
                    --
                  end if;
                  --
                end;
                ```
            alwaysExecute: true
        }
    )

    validation valida-se-prod-det-ja-esta-inserido (
        name: Valida se Prod. Det. ja esta inserido
        execution {
            sequence: 40
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  vexists number:= 0;
                  --
                begin
                  --
                  select 1
                  into vexists
                  from favorita.itenscomprastransferencias i
                  where i.idcompratransferencia = :P77_IDCOMPRATRANSFERENCIA
                    and i.idprodutodetalhado    = :P77_IDPRODUTODETALHADO;
                  -- 
                  if vexists = 1 then
                    --
                    Return 'Iten ja esta na remessa, favor alterar sua quantidade';        
                    --
                  end if;
                  exception
                    when others then 
                      null;     
                  --
                end;
                ```
            alwaysExecute: true
        }
        serverSideCondition {
            whenButtonPressed: @inserir
        }
    )

