    dynamicAction atualizar (
        name: atualizar
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @atualizar
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      --
                      vnumber       number;
                      voperacao_dml varchar2(1);
                      --
                    begin
                      --
                      if :P77_IDDEFEITO is null then
                        --
                        raise_application_error(-20001,'Informe o Defeito');
                        --
                      end if;
                      --
                      PCK_COMPRASTRANSF_FAV.prc_itenscomprastransferencias ( piditemcompratransferencia   => :P77_iditemcompratransferencia
                                                                           , pidcompratransferencia       => :P77_IDCOMPRATRANSFERENCIA
                                                                           , pidprodutodetalhado          => :P77_IDPRODUTODETALHADO
                                                                           , pquantidadecomprada          => :P77_quantidadecomprada
                                                                           , pquantidaderecebida          => :P77_quantidaderecebida
                                                                           , pquantidadeavariada          => :P77_quantidadeavariada
                                                                           , pquantidaderecebidaadicional => vnumber
                                                                           , pobservacao                  => :P77_observacao
                                                                           , pobservacaoavaria            => :P77_observacaoavaria
                                                                           , pmd5                         => :P77_md5
                                                                           , poperacao_dml                => 'U'
                                                                           , pidestoquefilorigem          => :P77_idestoquefilorigem
                                                                           , pidestoquefildestino         => :P77_idestoquefildestino 
                                                                           , pvalorcusto                  => :P77_valorcusto
                                                                           , porigemestoque               => :P77_ORIGEMESTOQUE
                                                                           , pquantidadedevolvida         => :P77_QUANTIDADEDEVOLVIDA
                                                                           , piddefeito                   => :P77_IDDEFEITO);
                      --
                      :P77_IDPRODUTODETALHADO := null;
                      :P77_IDITEMCOMPRATRANSFERENCIA := null;
                      :P77_QUANTIDADECOMPRADA := null;
                      :P77_QUANTIDADEDEVOLVIDA := null;
                      :P77_QUANTIDADEDISPONIVEL := null;
                      --
                    end;
                    ```
                itemsToSubmit: [
                    P77_IDPRODUTODETALHADO
                    P77_IDCOMPRATRANSFERENCIA
                    P77_ORIGEMESTOQUE
                    P77_QUANTIDADEDEVOLVIDA
                    P77_QUANTIDADECOMPRADA
                ]
                itemsToReturn: [
                    P77_IDITEMCOMPRATRANSFERENCIA
                    P77_QUANTIDADECOMPRADA
                    P77_QUANTIDADEDEVOLVIDA
                    P77_QUANTIDADEDISPONIVEL
                    P77_IDPRODUTODETALHADO
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction botão-inserir (
        name: Botão Inserir
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P77_MENSAGEM_AVISO
        }
        clientSideCondition {
            type: itemIsNull
            item: P77_MENSAGEM_AVISO
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: button
                button: @inserir
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: button
                button: @inserir
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction consultar-estoque-disponível-do-produto-selecionado (
        name: Consultar Estoque Disponível do Produto Selecionado
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P77_IDPRODUTODETALHADO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      --
                      vexiste number;
                      --
                      -- Esta validação foi inativada - T9509666
                      --
                    begin
                      --
                      select 1
                        into vexiste
                      from favorita.itenscomprastransferencias i
                      where i.idcompratransferencia = :P77_IDCOMPRATRANSFERENCIA
                        and i.idprodutodetalhado = :P77_IDPRODUTODETALHADO;
                      --
                      if vexiste is not null then
                        --
                        :P77_MENSAGEM_AVISO := ' Produto ja incluido na remessa';
                        --
                      else 
                        --
                        :P77_MENSAGEM_AVISO := null;
                        --
                      end if;
                      --
                    exception
                      when others then
                        null;
                    end;
                    ```
                itemsToSubmit: P77_IDPRODUTODETALHADO
                itemsToReturn: [
                    P77_IDITEMCOMPRATRANSFERENCIA
                    P77_MENSAGEM_AVISO
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      videstoque    number;
                    begin
                      --
                      if :P77_IDPRODUTODETALHADO is not null then
                        --
                        select idestoque
                        into videstoque
                        from estoques
                        where idfilialfavorita = :P77_IDFILIALORIGEM
                        and idprodutodetalhado = :P77_IDPRODUTODETALHADO;
                        --
                        :P77_QUANTIDADEDISPONIVEL := pck_estoque_fav.fnc_estoquedisponivel(videstoque);
                        --
                      else 
                        :P77_QUANTIDADEDISPONIVEL := null;
                      end if;
                      --
                    exception
                      when others then
                        null;
                    end;
                    ```
                itemsToSubmit: [
                    P77_IDFILIALORIGEM
                    P77_IDPRODUTODETALHADO
                ]
                itemsToReturn: P77_QUANTIDADEDISPONIVEL
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction excluir (
        name: excluir
        execution {
