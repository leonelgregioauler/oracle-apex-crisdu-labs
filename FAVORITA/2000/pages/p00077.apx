    pageItem P77_IDPRODUTODETALHADO (
        type: popupLov
        label {
            label: Produto
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeprodutodetalhado(p.idprodutodetalhado,:P0_IDIDIOMA) display_value
                  , p.idprodutodetalhado return_value
                from produtosdetalhados p
                   , estoques e
                where p.idprodutodetalhado = e.idprodutodetalhado
                  and e.idfilialfavorita   = :P77_IDFILIALORIGEM
                  and :P77_TIPO           != 0
                union 
                select pck_util_fav.fnc_nomeprodutodetalhado(p.idprodutodetalhado,:P0_IDIDIOMA) display_value
                  , p.idprodutodetalhado return_value
                from produtosdetalhados p
                   , estoques e
                where p.idprodutodetalhado = e.idprodutodetalhado
                  and e.idfilialfavorita   = :P77_IDFILIALDESTINO
                  and :P77_TIPO            = 0
                ```
        }
        layout {
            sequence: 40
            region: @inclusão-de-produtos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

