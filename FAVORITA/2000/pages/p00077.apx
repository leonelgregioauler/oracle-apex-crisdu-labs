    process operação-dml-em-itens-compras-e-transf (
        name: Operação DML em Itens Compras e Transf
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vnumber       number;
                  voperacao_dml varchar2(1);
                  --
                begin
                  --
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  PCK_COMPRASTRANSF_FAV.prc_itenscomprastransferencias ( piditemcompratransferencia   => :P77_iditemcompratransferencia
                                                                       , pidcompratransferencia       => :P77_IDCOMPRATRANSFERENCIA
                                                                       , pidprodutodetalhado          => :P77_IDPRODUTODETALHADO
                                                                       , pquantidadecomprada          => :P77_quantidadecomprada
                                                                       , pquantidaderecebida          => :P77_quantidaderecebida
                                                                       , pquantidadeavariada          => :P77_quantidadeavariada
                                                                       , pquantidaderecebidaadicional => vnumber
                                                                       , pobservacao                  => :P77_observacao
                                                                       , pobservacaoavaria            => :P77_observacaoavaria
                                                                       , pmd5                         => :P77_md5
                                                                       , poperacao_dml                => voperacao_dml
                                                                       , pidestoquefilorigem          => :P77_idestoquefilorigem
                                                                       , pidestoquefildestino         => :P77_idestoquefildestino 
                                                                       , pvalorcusto                  => :P77_valorcusto
                                                                       , porigemestoque               => :P77_ORIGEMESTOQUE
                                                                       , pquantidadedevolvida         => :P77_QUANTIDADEDEVOLVIDA
                                                                       , piddefeito                   => :P77_IDDEFEITO);
                  --
                  :P77_IDITEMCOMPRATRANSFERENCIA := null;
                  :P77_QUANTIDADECOMPRADA := null;
                  :P77_QUANTIDADEDEVOLVIDA := null;
                  :P77_QUANTIDADEDISPONIVEL := null;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 12694172126974505
        }
        serverSideCondition {
            type: never
        }
    )

