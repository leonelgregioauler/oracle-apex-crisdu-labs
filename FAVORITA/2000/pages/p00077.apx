page 77 (
    name: Inclusão de Produtos Transferência
    title: Inclusão de Produtos Transferência
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    javaScript {
        executeWhenPageLoads: window.opener.location.reload();
    }
    readOnly {
        type: never
    }
    security {
        pageAccessProtection: unrestricted
    }

    region inclusão-de-produtos (
        name: Inclusão de Produtos
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P77_IDCOMPRATRANSFERENCIA (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @inclusão-de-produtos
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P77_IDDEFEITO (
        type: popupLov
        label {
            label: Defeito
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.descricao display_value
                     , d.iddefeito return_value
                  from favorita.defeitos d
                 where d.aparecer = 'S'
                order by d.descricao
                ```
        }
        layout {
            sequence: 210
            region: @inclusão-de-produtos
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        source {
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from favorita.comprastransferencias c
                 where c.idcompratransferencia = :P77_IDCOMPRATRANSFERENCIA
                   and c.idtipocomptransrem = 11 -- Descarte
                ```
        }
    )

    pageItem P77_IDESTOQUEFILDESTINO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 170
