        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P77_IDESTOQUEFILORIGEM (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 160
            region: @inclusão-de-produtos
            slot: regionBody
        }
        source {
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  videstoquefilorigem number;
                begin
                  --
                  select idestoquefilorigem
                  into videstoquefilorigem
                  from itenscomprastransferencias it
                  where it.iditemcompratransferencia = :P77_IDITEMCOMPRATRANSFERENCIA;
                  --
                  return videstoquefilorigem;
                  --
                exception
                  when others then
                    null;
                end;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

