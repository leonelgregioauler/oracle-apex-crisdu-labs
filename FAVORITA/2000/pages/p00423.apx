page 423 (
    name: Controle de Associados do SPC
    title: Controle de Associados do SPC
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region associados-spc (
        name: Associados SPC
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.idassociadospc
                     , a.nomeassociado
                from roman.associadosspc a
                where ( :P423_ASSOCIADO is null
                      or upper(a.nomeassociado) like '%'||UPPER(:P423_ASSOCIADO)||'%' )
                  and exists ( select 1
                               from roman.filiaisassociadosspc fl
                               where fl.idassociadosspc = a.idassociadospc 
                                 and ( :P423_IDFILIAL is null or fl.idfilial = :P423_IDFILIAL)
                                 and ( :P423_LIBERADO = 'A'
                                  or ( :P423_LIBERADO = 'S' and fl.liberacadastro = 'S' )
                                  or ( :P423_LIBERADO = 'N' and fl.liberacadastro = 'N' )))
                order by 2
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: Nenhum resultado Encontrado!
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 5826105827469287
        }

        column IDASSOCIADOSPC (
            type: link
            heading {
                heading: Ver/ Editar
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            link {
                target: {
                    page: 424
                    items: {
                        P424_IDASSOCIADOSPC: #IDASSOCIADOSPC#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-view.png" class="apex-edit-view" alt="">
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column NOMEASSOCIADO (
            type: plainText
            heading {
                heading: Associado
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 58313 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn IDASSOCIADOSPC (
                sequence: 1
            )

            displayColumn NOMEASSOCIADO (
                sequence: 2
            )

        )

    )

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P423_ASSOCIADO (
        type: textField
        label {
            label: Associado
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P423_IDFILIAL (
        type: selectList
        label {
            label: Franquias
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select fl.nome display_value
                     , fl.idfilial return_value
                from roman.vw_filiais fl
                where fl.tipofilial = 'D'
                   and fl.ativo = 'S'
                   and fl.ididioma in (1,6)
                   and fl.grupo is not null;
                ```
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P423_LIBERADO (
        type: radioGroup
        label {
            label: Libera Cadastro?
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N,Ambos;A
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: A
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar-associados (
