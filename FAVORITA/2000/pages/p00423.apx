            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--primary
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @ações
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 424
                items: {
                    P424_IDASSOCIADOSPC:
                    P424_LIBERACADASTRO:
                    P424_NOMEASSOCIADO:
                }
                clearCache: 424
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction create-button-dialog-closed (
        name: Create Button - Dialog Closed
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @novo
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @associados-spc
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @associados-spc
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @associados-spc
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process busca-novos-associados (
        name: Busca Novos Associados
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  --
                  for i in ( select r.nomeassociado
                                  , count(distinct r.idconsultaspc) QTD
                             from roman.restricoesconsultaspc r
                             where not exists ( select 1
                                                from roman.associadosspc a
                                                where a.nomeassociado = r.nomeassociado )
                              and exists ( select 1
                                           from roman.consultaspc sp
                                           where sp.idconsultaspc = r.idconsultaspc
                                             and trunc(sp.dataconsulta) >= trunc(sysdate) )
                                group by r.nomeassociado
                                having count(distinct r.idconsultaspc) >= 5
                                order by 1 )
                  loop
                    --
                    -- Variável para armazenar o idassociadospc gerado
                    declare
                      v_idassociadospc roman.associadosspc.idassociadospc%type;
                    begin
                      -- Inserir na tabela associadosspc e obter o id gerado
                      insert into roman.associadosspc ( idassociadospc
                                                      , nomeassociado)
                      values ( roman.seq_idassociadospc.nextval
                             , I.NOMEASSOCIADO)
                      returning idassociadospc into v_idassociadospc;
                
                      -- Agora, fazer o loop sobre as filiais e inserir na tabela filiaisassociadosspc
                      for f in ( select fl.idfilial
                                 from roman.vw_filiais fl
                                 where fl.tipofilial = 'D'
                                   and fl.ativo = 'S'
                                   and fl.ididioma = 1
                                   and fl.grupo is not null )
                      loop
                        --
                        insert into roman.filiaisassociadosspc (idfilialassociadospc,
                                                                 idassociadosspc,
                                                                 idfilial,
                                                                 liberacadastro)
                        values (roman.seq_idfilialassociadosspc.nextval,
                                v_idassociadospc,
                                f.idfilial,
                                'N');
                        --
                      end loop;
                    end;
                    --
                  end loop;
                  --
                  commit;
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Associados atualizados com sucesso!
        }
        advanced {
            executionMappingIdentifier: 5860069535895808
        }
        serverSideCondition {
            type: request=Value
            value: ATUALIZAR_ASSOCIADOS
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 423
                items: {
                    P423_ASSOCIADO: &P423_ASSOCIADO.
                    P423_LIBERADO: &P423_LIBERADO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtrar
        }
    )

)

