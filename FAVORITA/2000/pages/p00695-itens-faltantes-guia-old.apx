    pageItem P695_LOJA (
        type: selectList
        label {
            label: Loja :
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select favorita.pck_util_fav.fnc_nomefilialfavorita(u.idfilialfavorita) loja  --Somente a filial do usuário 
                     , u.idfilialfavorita
                from catal.usuarios u 
                where u.usuario = v('APP_USER')
                  and u.usuario not in (select ug.usuario
                                        from roman.usuariosgruposatendimento ug
                                        where ug.usuario = v('APP_USER')
                                          and ug.idgrupoatendimento = 0 ) --Não lista junto a filial do usuário do TI. 
                 
                union 
                select favorita.pck_util_fav.fnc_nomefilialfavorita(u.idfilialfavorita) loja --Para usuários do TI mostra todas as filiais que tenham cupom gerado. 
                     , u.idfilialfavorita
                from catal.usuarios u 
                where exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.usuario = v('APP_USER')
                                 and ug.idgrupoatendimento = 0 )-- Grupo TI
                 and exists ( select 1 
                              from roman.conquistoulevoucupons cl
                              where cl.idfilialretira = u.idfilialfavorita 
                                and exists ( select 1 
                                             from roman.guiasentregascupons g
                                             where g.idconquistoulevoucupom = cl.idconquistoulevoucupom ))
                ```
        }
        layout {
            sequence: 10
            region: @recebimento-de-brindes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        readOnly {
            type: always
        }
    )

