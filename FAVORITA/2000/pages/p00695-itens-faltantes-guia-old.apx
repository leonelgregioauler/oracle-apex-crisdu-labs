    pageItem P695_CAMPANHA (
        type: selectList
        label {
            label: "Campanha : "
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select cp.nomecampanha
                     , cp.idconquistoulevou
                from roman.campanhasconquistoulevou cp
                where /*cp.status = 'S'
                  and trunc(sysdate) between cp.datadivulgacao and cp.datafimdivulgacao --valida campanha vigente.
                  and*/ cp.idpais = (select u.ididioma
                                   from catal.usuarios u 
                                   where u.usuario = v('APP_USER')
                                     and u.usuario not in (select ug.usuario
                                                           from roman.usuariosgruposatendimento ug
                                                           where ug.usuario = v('APP_USER')
                                                             and ug.idgrupoatendimento = 0 ))--Não lista filial do usuário do TI. )  
                union 
                select cp.nomecampanha
                     , cp.idconquistoulevou
                from roman.campanhasconquistoulevou cp
                where /*cp.status = 'S'
                  and trunc(sysdate) between cp.datadivulgacao and cp.datafimdivulgacao --valida campanha vigente.
                  and */ cp.idpais = ( select f.idpais
                                    from favorita.filiaisfavorita f
                                    where f.idfilialfavorita = :P667_LOJA)
                  and exists ( select 1
                               from roman.usuariosgruposatendimento ug
                               where ug.usuario = v('APP_USER')
                                 and ug.idgrupoatendimento = 0 ) -- usuários TI
                ```
        }
        layout {
            sequence: 20
            region: @recebimento-de-brindes
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
