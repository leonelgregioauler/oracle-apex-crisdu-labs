    region itens-faltantes (
        name: "Itens Faltantes "
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select cb.idbrindeclube 
                     , cb.idclassifbrindeclub
                     , it.qtdfaltante
                     , nvl(it.qtdrecebida,0) qtdrecebida
                     , it.datarecebimento
                     , it.iditemfaltante
                from roman.itensfaltantes it 
                   , roman.classificacoesbrindesclub cb
                where cb.idclassifbrindeclub = it.idclassifbrindeclub
                  and it.idguiaentregabrinde = :P695_GUIAENVIO
                ```
            pageItemsToSubmit: P695_GUIAENVIO
        }
        layout {
            sequence: 30
            slot: body
        }
