    process itens-faltantes (
        name: Itens Faltantes
        type: executeCode
        editableRegion: @itens-faltantes
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  --
                  vseqgrid        number;
                  vexcluifaltante number;
                  vidbrinde       number;
                  --
                BEGIN
                  -- Linha NOVA (Create)
                  IF :APEX$ROW_STATUS = 'C' THEN
                    --
                    select clb.idbrindeclube
                    into vidbrinde
                    from roman.classificacoesbrindesclub clb
                    where clb.idclassifbrindeclub = :IDCLASSIFBRINDECLUB;
                    --
                    select roman.seq_iditemfaltante.nextval
                    into vseqgrid
                    from dual;
                    --
                    insert into roman.itensfaltantes(iditemfaltante,
                                                     idguiaentregabrinde,
                                                     idclassifbrindeclub,
                                                     qtdfaltante,
                                                     datarecebimento,
                                                     idbrindeclube)
                    values(vseqgrid,
                           :P695_GUIAENVIO,
                           :IDCLASSIFBRINDECLUB,
                           :QTDFALTANTE,
                           null,
                           vidbrinde)
                    RETURNING iditemfaltante INTO :IDITEMFALTANTE;
                    --
                    update roman.guiasentregasbrindes g
                    set g.itensfaltantes = 'S'
                    where g.idguiaentregabrinde = :P695_GUIAENVIO;
                    --
                  -- Linha ALTERADA (Update) – somente a linha editada
                  ELSIF :APEX$ROW_STATUS = 'U' THEN
                    --
                    select clb.idbrindeclube
                    into vidbrinde
                    from roman.classificacoesbrindesclub clb
                    where clb.idclassifbrindeclub = :IDCLASSIFBRINDECLUB;
                    --
                    update roman.itensfaltantes it
                    set it.datarecebimento     = to_date(:DATARECEBIMENTO, 'DD/MM/YYYY HH24:MI:SS')
                      , it.qtdfaltante         = :QTDFALTANTE
                      , it.qtdrecebida         = :QTDRECEBIDA
                      , it.idclassifbrindeclub = :IDCLASSIFBRINDECLUB
                      , it.idbrindeclube       = vidbrinde
                    where it.iditemfaltante      = :IDITEMFALTANTE
                      and it.idguiaentregabrinde = :P695_GUIAENVIO;
                    --
                  -- Linha EXCLUÍDA (Delete)
                  ELSIF :APEX$ROW_STATUS = 'D' THEN
                    --
                    begin
                      select 1
                      into vexcluifaltante
                      from roman.conquistoulevoucupons clc
                         , roman.guiasentregascupons gec
                      where clc.idconquistoulevoucupom = gec.idconquistoulevoucupom
                        and gec.idguiaentregabrinde = :P695_GUIAENVIO
                        and clc.datarecebfilial is null
                        and rownum = 1;
                    exception
                      when no_data_found then
                        vexcluifaltante := 0;
                    end;
                    --
                    if vexcluifaltante = 1 then
                      --
                      delete roman.itensfaltantes it
                      where it.iditemfaltante      = :IDITEMFALTANTE
                        and it.idguiaentregabrinde = :P695_GUIAENVIO;
                      --
                      -- Só limpa a flag da guia se não restou nenhum item faltante.
                      update roman.guiasentregasbrindes g
                      set g.itensfaltantes = null
                      where g.idguiaentregabrinde = :P695_GUIAENVIO
                        and not exists (select 1
                                        from roman.itensfaltantes it
                                        where it.idguiaentregabrinde = g.idguiaentregabrinde);
                      --
                    else
                      --
                      raise_application_error(-20001, 'Existem cupons recebidos para esta guia, não é permitido excluir o item faltante informado.');
                      --
                    end if;
                  END IF;
                END;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 758794512564044924
        }
        serverSideCondition {
            whenButtonPressed: @salvar
        }
    )

    process itens-faltantes-2 (
        name: Itens faltantes
        type: executeCode
        editableRegion: @itens-faltantes
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  --
                  vseqgrid number;
                  vexcluifaltante number;
                  vidbrinde number;
                  --
                BEGIN
                  -- Linha NOVA (Create)
                  IF :APEX$ROW_STATUS = 'C' THEN
                    --
                    select clb.idbrindeclube
                      into vidbrinde
                    from roman.classificacoesbrindesclub clb
                    where clb.idclassifbrindeclub = :IDCLASSIFBRINDECLUB;
                    --
                    --raise_application_error(-20001,'xxxxxxxxx');
                    select roman.seq_iditemfaltante.nextval
                      into vseqgrid
                    from dual;
                    --
                    insert into roman.itensfaltantes(iditemfaltante,
                                                     idguiaentregabrinde,
                                                     idclassifbrindeclub,
                                                     qtdfaltante,
                                                     datarecebimento,
                                                     idbrindeclube)
                    values(vseqgrid,
                           :P695_GUIAENVIO,
                           :IDCLASSIFBRINDECLUB,
                           :QTDFALTANTE,
                           null,
                           vidbrinde)
                
                    RETURNING iditemfaltante INTO :IDITEMFALTANTE;
                    --
                    update roman.guiasentregasbrindes g
                    set g.itensfaltantes = 'S'
                    where g.idguiaentregabrinde = :P695_GUIAENVIO;
                    --
                  -- Linha ALTERADA (Update)
                  ELSIF :APEX$ROW_STATUS = 'U' THEN
                    --
                    update roman.itensfaltantes it 
                    set it.datarecebimento = to_date((:DATARECEBIMENTO),'DD/MM/YYYY HH24:MI:SS')
                      , it.qtdfaltante = :QTDFALTANTE
                      , it.idclassifbrindeclub = :IDCLASSIFBRINDECLUB
                    where it.iditemfaltante = :IDITEMFALTANTE;
                
                  -- Linha EXCLUÍDA (Delete)
                   ELSIF :APEX$ROW_STATUS = 'D' THEN
                    --
                    begin
                      --
                      select 1
                        into vexcluifaltante
                      from roman.conquistoulevoucupons clc
                         , roman.guiasentregascupons gec 
                         , roman.guiasentregasbrindes ge
                      where clc.idconquistoulevoucupom = gec.idconquistoulevoucupom
                        and gec.idguiaentregabrinde = ge.idguiaentregabrinde
                        and ge.idguiaentregabrinde = :P695_GUIAENVIO
                        and clc.datarecebfilial is null;
                    exception
                        when others then
                          vexcluifaltante := 0;   
                    end;
                    --
                    if vexcluifaltante = 1 then
                    --
                    delete  roman.itensfaltantes it 
                    where it.iditemfaltante = :IDITEMFALTANTE;
                    --
                    update roman.guiasentregasbrindes g
                    set g.itensfaltantes = null
                    where g.idguiaentregabrinde = :P695_GUIAENVIO;
                    --
                    else 
                      --
                      raise_application_error(-20001,'Existe cupons recebidos para esta guia, não permitido exluir o item faltante informado'); 
                      --
                    end if;
                  END IF;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1218983804223421426
        }
        serverSideCondition {
            whenButtonPressed: @salvar
            type: never
        }
    )

    process recebe-itens-faltantes-da-guia (
        name: Recebe itens faltantes da guia
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidusuario number;
                  vidguia    number := :P695_GUIAENVIO;
                  vpendente  number;
                  --
                begin
                  --
                  select u.idusuario
                  into vidusuario
                  from catal.usuarios u
                  where u.usuario = v('APP_USER');
                  --
                  -- Confirma o recebimento somente dos itens DESTA guia com data informada.
                  --
                  -- Mantém a qtd faltante original e registra a qtd recebida.
                  --
                  update roman.itensfaltantes it
                  set it.qtdrecebida = case when nvl(it.qtdrecebida, 0) = 0 then it.qtdfaltante else it.qtdrecebida end
                    , it.idusuario   = vidusuario
                  where it.idguiaentregabrinde = vidguia
                    and it.datarecebimento is not null;
                  --
                  -- Verifica se ainda existe item faltante sem recebimento na guia.
                  --
                  select count(*)
                  into vpendente
                  from roman.itensfaltantes it
                  where it.idguiaentregabrinde = vidguia
                    and it.datarecebimento is null;
                  --
                  if vpendente = 0 then
                    --
                    -- Confirma o recebimento nos cupons da guia.
                    --
                    update roman.conquistoulevoucupons cl
                    set cl.datarecebfilial = sysdate
                    where cl.datarecebfilial is null
                      and cl.idconquistoulevoucupom in (select gc.idconquistoulevoucupom
                                                        from roman.guiasentregascupons gc
                                                        where gc.idguiaentregabrinde = vidguia);
                    --
                    -- Confirma o recebimento na guia de cupons.
                    --
                    update roman.guiasentregascupons gc
                    set gc.itensfaltantes = null
                    where gc.idguiaentregabrinde = vidguia;
                    --
                    -- Encerra a guia.
                    --
                    update roman.guiasentregasbrindes gb
                    set gb.datarecebimento = sysdate
                      , gb.itensfaltantes  = null
                    where gb.idguiaentregabrinde = vidguia;
                    --
                  end if;
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 758794675186044925
        }
        serverSideCondition {
            whenButtonPressed: @receberbrinde
        }
    )

    process recebe-itens-faltantes-da-guia-2 (
        name: "Recebe itens faltantes da guia "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                  -- 
                  vqtdfaltante     number;
                  vvalidafalta     number;
                  vidusuario       number;
                  vidguia          number := :P695_GUIAENVIO;
                  --
                begin
                  --
                  select u.idusuario
                    into vidusuario
                  from catal.usuarios u 
                  where u.usuario =  v('APP_USER') ;
                  -- 
                  for f in (select it.iditemfaltante
                                 , it.idclassifbrindeclub
                                 , it.qtdfaltante
                                 , it.datarecebimento
                                 , clb.idbrindeclube
                                 , clb.idcaracteristica
                                 , clb.idclassificacao
                            from roman.itensfaltantes it 
                               , roman.classificacoesbrindesclub clb
                            where clb.idclassifbrindeclub = it.idclassifbrindeclub
                              and it.datarecebimento is not null
                              and it.idguiaentregabrinde = vidguia )
                    loop
                      --
                      vqtdfaltante := f.qtdfaltante;
                      --
                      for i in ( select ic.idbrindeclube
                                      , ic.idcaracteristica
                                      , ic.idclassificacao
                                      , ic.idconquistoulevoucupom
                                      , gc.idguiaentregabrinde
                                      , gc.itensfaltantes
                                 from roman.itensconqlevcupons ic 
                                    , roman.guiasentregascupons gc
                                 where ic.idconquistoulevoucupom = gc.idconquistoulevoucupom
                                   and ic.idbrindeclube = f.idbrindeclube
                                   and ic.idclassificacao = f.idclassificacao
                                   and ic.idcaracteristica = f.idcaracteristica
                                   and gc.itensfaltantes = 'S'
                                   and gc.idguiaentregabrinde = vidguia)
                      loop
                        -- 
                        --Confirma o recebimento no cupom.
                        --
                        update roman.conquistoulevoucupons cl 
                        set cl.datarecebfilial = sysdate
                        where cl.idconquistoulevoucupom = i.idconquistoulevoucupom
                          and cl.datarecebfilial is null;
                        --
                        --Confirma o recebimento na guia de cupons. 
                        --
                        update roman.guiasentregascupons gec 
                        set gec.itensfaltantes = null 
                        where gec.idconquistoulevoucupom = i.idconquistoulevoucupom;
                        --
                        
                        vqtdfaltante := (vqtdfaltante - 1);
                      
                        --
                        --Confirma o recebimento do item na tabela de itens faltantes.
                        --
                        update roman.itensfaltantes itx 
                        set itx.qtdfaltante = vqtdfaltante, itx.idusuario = vidusuario, itx.datarecebimento = sysdate
                        where itx.idbrindeclube = f.idbrindeclube
                          and (itx.idclassifbrindeclub = f.idclassifbrindeclub or itx.idclassifbrindeclub is null);
                        --
                      end loop; 
                    --
                    end loop;
                    --
                    select count(*)
                      into vvalidafalta 
                    from roman.guiasentregascupons guc
                    where guc.itensfaltantes = 'S' 
                      and guc.idguiaentregabrinde = vidguia;
                    --
                    if  vvalidafalta = 0 then 
                      --
                      update roman.guiasentregasbrindes gb
                      set gb.datarecebimento = sysdate, gb.itensfaltantes = null
                      where gb.idguiaentregabrinde = vidguia;
                      --
                    end if; 
                    
                  commit;
                  -- 
                end; 
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 1218988267600421432
        }
        serverSideCondition {
            whenButtonPressed: @receberbrinde
            type: never
        }
    )

