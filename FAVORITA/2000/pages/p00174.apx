    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 70
            region: @filtro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-filter
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction filtrar (
        name: Filtrar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @filtrar
        }

        action native-submit-page (
            action: submitPage
            settings {
                requestButtonName: FILTRAR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    branch (
        name: Filtrar
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 174
                items: {
                    P174_IDFILIALFAVORITA: &P174_IDFILIALFAVORITA.
                    P174_IDPRODUTODETALHADO: &P174_IDPRODUTODETALHADO.
                    P174_IDFORNECEDOR: &P174_IDFORNECEDOR.
                    P174_IDPRODUTO: &P174_IDPRODUTO.
                    P174_FILTRAR: S
                }
                action: resetPagination
            }
        }
    )

)

