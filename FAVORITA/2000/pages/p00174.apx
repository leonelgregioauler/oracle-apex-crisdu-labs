page 174 (
    name: Estoque Valorizado
    title: Estoque Valorizado
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region estoque-valorizado-detalhado (
        name: Estoque Valorizado Detalhado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select filialfavorita
                     , e.produtodetalhado
                     , valorcusto
                     , nvl(quantidade,0) quantidade
                     , nvl(quantidadereservada,0) quantidadereservada
                     , nvl(quantidadereservadacgd,0) quantidadereservadacgd
                     , (nvl(quantidade,0)  - nvl(quantidadereservada,0)) quantidadedisponivel
                     , (nvl(quantidade,0) * nvl(valorcusto,1))    totalcusto
                     , nvl(quantidadecomprada,0) quantidadecomprada
                     , nvl(custocomprado,0) custocomprado
                 /*    , nvl(( select distinct pr.valorcusto
                         from precosprodutos pr
                         where pr.idprodutodetalhado = e.idprodutodetalhado
                           and rownum = 1
                           and pr.idedicaorevista = ( select ed.idedicaorevista
                                                      from edicoesrevistas ed
                                                      where ed.tipovenda = tp.tipovenda
                                                        and ed.numeroedicao = ( select max(ee.numeroedicao)
                                                                                from edicoesrevistas ee
                                                                                where ee.tipovenda = tp.tipovenda
                                                                                  and trunc(sysdate) between ee.datainicial and ee.datafinal
                                                                                  and ee.liberarcompra = 'S'
                                                                                  and exists ( select 1
                                                                                               from filiaisedicoesrevistas fe
                                                                                               where fe.idedicaorevista  = ee.idedicaorevista 
                                                                                                 and ( fe.idfilialfavorita = e.idfilialfavorita
                                                                                                  or exists ( select 1
                                                                                                              from atendimentosfiliaisrmc a
                                                                                                              where a.idfilialfavoritaorigem = e.idfilialfavorita
                                                                                                                and a.idfilialdestino = fe.idfilial ) ) ) ) ) ),0) precovenda */
                from vw_estoques_fav_mv e
                   , ( select case
                               when f.tipofilial = 'E' then
                                 'R'
                               when f.tipofilial = 'L' then
                                 'L'
                             end tipovenda
                      from filiaisfavorita f
                      where f.idfilialfavorita = :P174_IDFILIALFAVORITA ) tp
                where e.ididioma = :P0_IDIDIOMA
                  and idfilialfavorita        = :P174_IDFILIALFAVORITA
                  and (:P174_IDPRODUTODETALHADO is null     or idprodutodetalhado      = :P174_IDPRODUTODETALHADO)
                  and (:P174_IDPRODUTO          is null     or idproduto               = :P174_IDPRODUTO)
                  and (:P174_IDFORNECEDOR       is null     or exists ( select 1 
                                                                       from fornecedoresprodutos f
                                                                       where f.idfornecedor = :P174_IDFORNECEDOR
                                                                         and f.idproduto    = e.idproduto ))
                order by e.produto
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <font color="blue">
                    <h1>
                    O preço de venda informado é referente o cadastro de preços da ultima revista vigente!
                    </h1>
                </font>
                ```
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression:
                ```sql
                :P174_IDPRODUTODETALHADO is null 
                and :P174_IDPRODUTO          is null 
                and :P174_IDFORNECEDOR       is null 
                and :P174_IDFILIALFAVORITA   is null
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 580550733344535450
        }

