    region estoques (
        name: Estoques
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select filialfavorita
                     , sum(quantidade)                        quantidade
                     , sum(quantidadereservada)               quantidadereservada
                     , sum(quantidadereservadacgd)            quantidadereservadacgd
                     , sum(quantidade  - quantidadereservada) quantidadedisponivel
                     , sum(quantidade * valorcusto)    totalcusto
                     , sum(quantidadecomprada)                quantidadecomprada
                     , sum(custocomprado)                     custocomprado 
                from vw_estoques_fav_mv e
                where /*(:P174_IDFILIALFAVORITA   is not null or :P174_IDPRODUTODETALHADO is not null or :P174_IDFORNECEDOR  is not null )
                  and */(:P174_IDFILIALFAVORITA   is null     or idfilialfavorita        = :P174_IDFILIALFAVORITA)
                  and (:P174_IDPRODUTODETALHADO is null     or idprodutodetalhado      = :P174_IDPRODUTODETALHADO)
                  and (:P174_IDPRODUTO          is null     or idproduto               = :P174_IDPRODUTO)
                  and (:P174_IDFORNECEDOR       is null     or exists ( select 1 
                                                                       from fornecedoresprodutos f
                                                                       where f.idfornecedor = :P174_IDFORNECEDOR
                                                                         and f.idproduto    = e.idproduto ))
                  and ididioma = :P0_IDIDIOMA
                  and :P174_FILTRAR = 'S'
                  and exists ( select 1
                               from usuariosfiliaisfavorita u
                               where u.idfilialfavorita = e.idfilialfavorita
                                 and u.consultar = 'S'
                                 and u.idusuario = :P0_IDUSUARIO )
                group by filialfavorita
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 201599942420321811
        }

