    region filtro (
        name: Filtro
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P174_ATUALIZADO (
        type: displayOnly
        label {
            label: " "
            alignment: left
        }
        layout {
            sequence: 10
            region: @estoques
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select case
                         when a.THIS_SEC is null then
                           'Atualizado às '||last_sec||'. Próxima atualização às '||next_sec 
                         else
                           'Atualização em andamento'
                         end display
                from all_jobs a
                where job = 2505952
                ```
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P174_FILTRAR (
        type: hidden
        layout {
            sequence: 60
            region: @filtro
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P174_IDFILIALFAVORITA (
        type: selectList
        label {
            label: Filial Favorita
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialfavorita(idfilialfavorita) display_value
                     , idfilialfavorita   return_value
                from filiaisfavorita f
                where  exists ( select 1
                               from usuariosfiliaisfavorita u
                               where u.idfilialfavorita = f.idfilialfavorita
                                 and u.consultar = 'S'
                                 and u.idusuario = :P0_IDUSUARIO )
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 20
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P174_IDFORNECEDOR (
        type: popupLov
        label {
            label: Fornecedor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.nomepessoa display_value
                     , f.idfornecedor return_value
                from pessoas p
                   , fornecedores f
                where p.idpessoa = f.idpessoa
                  and f.ativo    = 'S'
                  and exists ( select 1 
                               from fornecedoresprodutos fp
                               where fp.idfornecedor = f.idfornecedor  )
                order by 1 
                ```
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 50
            region: @filtro
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

