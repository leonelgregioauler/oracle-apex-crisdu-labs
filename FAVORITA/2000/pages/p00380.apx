    pageItem P380_TIPO_ENTREGA (
        type: radioGroup
        label {
            label: Tipo Entrega
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.descricao d,
                       f.idformaentrega r
                from formasentregas f
                order by f.idformaentrega
                ```
            displayExtraValues: false
            nullDisplayValue: Todos
        }
        layout {
            sequence: 90
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    button filtro (
        buttonName: FILTRO
        label: Filtro
        layout {
            sequence: 130
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
            icon: fa-filter
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction filtro-por-data (
        name: Filtro por Data
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P380_FILTRARDATA
        }
        clientSideCondition {
            type: item=value
            item: P380_FILTRARDATA
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P380_DATAINICIAL
                    P380_DATAFINAL
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P380_DATAINICIAL
                    P380_DATAFINAL
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    validation data-final-obrigatória (
        name: Data Final obrigatória
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P380_DATAFINAL
        }
        error {
            errorMessage: Data Final deve ser informada.
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P380_FILTRARDATA = 'S';
        }
    )

    validation data-inicial-obrigatório (
        name: Data Inicial Obrigatório
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P380_DATAINICIAL
        }
        error {
            errorMessage: Data Inicial deve ser informada.
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P380_FILTRARDATA = 'S';
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 380
                items: {
                    P380_TIPORELATORIO: &P380_TIPORELATORIO.
                    P380_PEDIDOFEITOPOR: &P380_PEDIDOFEITOPOR.
                    P380_IDFILIALROMANCE: &P380_IDFILIALROMANCE.
                    P380_DISTRIBUIDOR: &P380_DISTRIBUIDOR.
                    P380_FILTRARDATA: &P380_FILTRARDATA.
                    P380_TIPO_ENTREGA: &P380_TIPO_ENTREGA.
                    P380_TIPOVALOR: &P380_TIPOVALOR.
                    P380_DATAINICIAL: &P380_DATAINICIAL.
                    P380_DATAFINAL: &P380_DATAFINAL.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtro
        }
    )

)

