    region relatório-pedidos-loja-resumido (
        name: Relatório Pedidos Loja - Resumido
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select count(idpedido) quantidadepedidos
                     , pck_util_fav.fnc_nomevendedora(p.idvendedora) nomeconsultora
                     , pck_util_fav.fnc_nomerepresentante(p.idrepresentante) nomerepresentante  
                     , sum(p.valortotal) valortotal
                     , sum(p.valorapagar) valorapagar
                     , sum(p.valorpago) valorpago
                     , pck_util_fav.fnc_nomefilialfavorita(p.idfilialfavorita) as "Filial"
                     , case 
                        when exists ( select 1
                                         from favorita.classificacoespedidos cl
                                        where cl.idpedido = p.idpedido
                                          and cl.idcaracteristicapedido = 13
                                          and cl.Idvalorcaracteristica = 4) then count(idpedido) * nvl(( select t.valortaxa
                                                                                                        from favorita.taxasdelivery t
                                                                                                       where t.idfilialfavorita = p.idfilialfavorita
                                                                                                         and p.dataemissao between t.datainicio and t.datafim
                                                                                                         and p.valorapagar >= t.valorpedidominimo),0) 
                                                        
                      else 0
                        end taxa_delivery 
                from vw_pedidos_fav p
                where p.ididioma = 1
                  and (:P380_DISTRIBUIDOR    is null or p.idrepresentante = :P380_DISTRIBUIDOR)
                  and (:P380_IDFILIALROMANCE is null or p.idfilialromance = :P380_IDFILIALROMANCE)
                  and p.idfilialfavorita in ( select idfilialfavorita 
                                              from filiaisfavorita ff
                                              where ff.idfilialfavorita = p.idfilialfavorita
                                                and ff.tipofilial = 'L')
                  and exists ( select 1 /*Verifica o acesso a filial*/
                               from usuariosfiliaisfavorita usf
                               where usf.idfilialfavorita = p.idfilialfavorita 
                                 and usf.idusuario = :P0_IDUSUARIO)
                  and p.datacancelamento is null
                  and ( :P380_TIPOVALOR = 2
                     or ( :P380_TIPOVALOR = 1 and p.valorapagar > 0 )
                     or ( :P380_TIPOVALOR = 0 and p.valorapagar = 0 ) )
                  /*Filtra o tipo de entrega*/
                  and (:P380_TIPO_ENTREGA is null or :P380_TIPO_ENTREGA = ( select clp.idvalorcaracteristica
                                                                            from classificacoespedidos clp
                                                                            where clp.idpedido = p.idpedido
                                                                              and clp.idcaracteristicapedido = 13 ) )
                  /**********************************/
                  and ( :P380_FILTRARDATA = 'N' 
                    or ( :P380_FILTRARDATA = 'S' and trunc(p.dataemissao) between to_date(:P380_DATAINICIAL, 'DD/MM/RRRR') and to_date(:P380_DATAFINAL, 'DD/MM/RRRR') ) )               
                  and (:P380_PEDIDOFEITOPOR = 'T' 
                    or (:P380_PEDIDOFEITOPOR = 'C' and not exists ( select 1
                                                                    from classificacoespedidos cp
                                                                    where cp.idpedido = p.idpedido
                                                                      and cp.idcaracteristicapedido = 2 ) )  -- Não listar pedidos que distribuidor fez para consultora
                    or (:P380_PEDIDOFEITOPOR = 'D' and exists ( select 1
                                                                from classificacoespedidos cp
                                                                where cp.idpedido = p.idpedido
                                                                  and cp.idcaracteristicapedido = 2 ) ) ) -- Listar pedidos que distribuidor fez para consultora 
                  and ( :P380_PEDIDOCREDEV is null or ( :P380_PEDIDOCREDEV = 'N' and not exists ( select 1
                                                                                                  from classificacoespedidos c
                                                                                                  where c.idpedido = p.idpedido
                                                                                                    and c.idcaracteristicapedido = 8
                                                                                                    and c.idvalorcaracteristica = 25 ) )
                                                   or ( :P380_PEDIDOCREDEV = 'S' and exists ( select 1
                                                                                              from classificacoespedidos c
                                                                                              where c.idpedido = p.idpedido
                                                                                                and c.idcaracteristicapedido = 8
                                                                                                and c.idvalorcaracteristica = 25 ) )
                                                   or ( :P380_PEDIDOCREDEV = 'C' ))
                group by p.idvendedora
                       , p.idrepresentante
                       , p.idfilialfavorita
                       , p.idpedido
                       , p.dataemissao
                       , p.valorapagar;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P380_TIPORELATORIO = 'R'
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 52181038778020823
        }

