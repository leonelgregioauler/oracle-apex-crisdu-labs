    pageItem P380_DISTRIBUIDOR (
        type: popupLov
        label {
            label: Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(r.idrepresentante) display_value
                     , r.idrepresentante return_value
                from representantes r
                where r.ativo = 'S'
                  and r.idgerente = ( select idgerente
                                      from gerentes 
                                      where idfilial = nvl(:P380_IDFILIALROMANCE, roman.pck_romance.fnc_filialusuario(v('APP_USER')) ) )
                order by 1
                ```
        }
        cascadingLov {
            parentItems: P380_IDFILIALROMANCE
        }
        layout {
            sequence: 60
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P380_FILTRARDATA (
        type: radioGroup
        label {
            label: Filtrar Data
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Sim;S,Não;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        default {
            type: static
            staticValue: S
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P380_IDFILIALROMANCE (
        type: popupLov
        label {
            label: Filial Romance
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomefilialromance(f.idfilial) display_value
                     , f.idfilial
                from roman.vw_filiais f
                where f.idfilial in ( select afr.idfilialdestino
                                      from atendimentosfiliaisrmc afr
                                      where afr.idfilialfavoritaorigem = pck_util_fav.fnc_retornaidfilialfavusuario(pck_util_fav.fnc_idusuario(v('APP_USER'))) )
                                      
                                      
                union 
                /*
                    Maicon Aimi - 23/05/2024 - 9076126
                    criado a opção para exibir todas as filiais
                    
                    Questionei no grupo do desenvolvimento, não tive resposta, então criei temporariamente esse union, se tiver errado arrumamos depois 
                */
                
                select favorita.pck_util_fav.fnc_nomefilialromance(f.idfilial) display_value
                     , f.idfilial
                from roman.vw_filiais f
                where v('APP_USER') in ('HAYANES','MAICONAIMI','EDUARDAZOTTI')
                order by 1
                
                ```
        }
        layout {
            sequence: 50
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P380_PEDIDOCREDEV (
        type: radioGroup
        label {
            label: Pedido Credev
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Sem Credev;N,Somente Credev;S,Credev Com Valor;C
            displayExtraValues: false
            nullDisplayValue: - Todos -
        }
        layout {
            sequence: 110
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P380_PEDIDOFEITOPOR (
        type: radioGroup
        label {
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Pedido feito pela consultora;C,Pedido feito pelo distribuidor;D
            displayExtraValues: false
            nullDisplayValue: Todos
            nullReturnValue: T
        }
        layout {
            sequence: 40
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        default {
            type: static
            staticValue: T
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P380_PRIMEIRAEXPRESS (
        type: radioGroup
        label {
            label: Primeira Compra Express
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Sim;S,Não;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 120
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        default {
            type: static
