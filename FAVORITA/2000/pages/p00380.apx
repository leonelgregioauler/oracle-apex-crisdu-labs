                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 574604 (
            visibility: primaryDefault
            view {
                groupBy: true
                default: groupBy
                rowsPerPage: 100000
            }

            displayColumn "Filial" (
                sequence: 1
            )

            displayColumn NOMECONSULTORA (
                sequence: 2
            )

            displayColumn NOMEREPRESENTANTE (
                sequence: 3
            )

            displayColumn QUANTIDADEPEDIDOS (
                sequence: 4
            )

            displayColumn TAXA_DELIVERY (
                sequence: 8
            )

            displayColumn VALORAPAGAR (
                sequence: 7
            )

            displayColumn VALORPAGO (
                sequence: 6
            )

            displayColumn VALORTOTAL (
                sequence: 5
            )

            aggregate (
                column: QUANTIDADEPEDIDOS
            )

            aggregate (
                column: VALORAPAGAR
            )

            aggregate (
                column: VALORTOTAL
            )

            aggregate (
                column: VALORPAGO
            )

            aggregate (
                function: countDistinct
                column: NOMECONSULTORA
            )

            aggregate (
                function: countDistinct
                column: NOMEREPRESENTANTE
            )

            aggregate (
                function: countDistinct
                column: "Filial"
            )

            groupByColumn (
                column: "Filial"
                layout {
                    sequence: 1
                }
            )

            groupByAggregate (
                heading: Qtd Pedidos
                aggregate {
                    column: QUANTIDADEPEDIDOS
                    displaySum: true
                }
                appearance {
                    formatMask: 999G999G999G999G990
                }
                layout {
                    sequence: 1
                }
            )

            groupByAggregate (
                heading: Valor Total
                aggregate {
                    column: VALORTOTAL
                    displaySum: true
                }
                appearance {
                    formatMask: 999G999G999G999G990D00
                }
                layout {
                    sequence: 2
                }
            )

            groupByAggregate (
                heading: Valor Pago
                aggregate {
                    column: VALORPAGO
                    displaySum: true
                }
                appearance {
                    formatMask: 999G999G999G999G990D00
                }
                layout {
                    sequence: 3
                }
            )

            groupByAggregate (
                heading: Valor a Pagar
                aggregate {
                    column: VALORAPAGAR
                    displaySum: true
                }
                appearance {
                    formatMask: 999G999G999G999G990D00
                }
                layout {
                    sequence: 4
                }
            )

            groupBySort (
                column: "Filial"
                sort {
                    sequence: 1
                }
            )

        )

    )

