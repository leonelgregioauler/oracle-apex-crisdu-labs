    region vendedoras (
        name: Vendedoras
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                return q'~
                select p.idpessoa,
                       upper(p.nomepessoa) "EMPREENDEDORA",
                       v.idvendedora,
                       v.ativo,
                       v.idfilial,
                       roman.pck_romance.fnc_nomefilial(v.idfilial) filial,
                       
                       (select decode(count(*), 0, 'Não', 'Sim')
                          from favorita.pedidos ped
                         where v.idvendedora = ped.idvendedora
                           and ped.datacancelamento is null ) "COMPRA FAVORITA",
                
                       case
                         when p.idpais = 1 then p.cpf
                         else p.documentoestrangeiro
                       end "DOCUMENTO",
                
                       p.tipopessoa "TIPO PESSOA",
                
                       (select c.nomecategoria
                          from roman.categoriasclubes c
                             , roman.pontuacoesclubedesucesso pcs
                         where c.idcategoriaclube = pcs.idcategoriaclube
                           and pcs.idvendedora = v.idvendedora ) "CATEGORIA ESTRELA",
                
                       (select c.nomecidade
                          from catal.cidades c
                         where c.idcidade = p.idcidade) "CIDADE",
                
                       (select e.nome
                          from catal.cidades c, catal.estados e
                         where c.idestado = e.idestado
                           and c.idcidade = p.idcidade) "ESTADO",
                
                       (select e.sigla
                          from catal.cidades c, catal.estados e
                         where c.idestado = e.idestado
                           and c.idcidade = p.idcidade) "UF",
                
                       (select ps.nome 
                          from catal.paises ps 
                         where ps.idpais = f.ididioma) "PAÍS",
                
                       (select listagg(tf.telefonelimpo, '; ') 
                               within group(order by tf.ranking asc)
                          from (
                                select tp.idpessoa,
                                       tp.telefonelimpo,
                                       row_number() over (
                                         partition by tp.idpessoa 
                                         order by tp.idtelefonepessoa desc
                                       ) as ranking
                                  from catal.telefonespessoas tp
                                 where tp.idpessoa = p.idpessoa
                               ) tf
                         where tf.ranking <= 3
                         group by tf.idpessoa) "TELEFONES"
                
                  from catal.pessoas    p
                     , catal.vendedoras v
                     , catal.filiais    f
                
                 where p.idpessoa = v.idpessoa
                   and v.idfilial = f.idfilial
                
                   -- obrigatório
                   and f.ididioma = :P690_IDPAIS
                   and :P690_FILTRAR = 'S'
                
                ~'
                ||
                case 
                  when :P690_IDFILIAL is not null and :P690_IDFILIAL <> '-1'
                  then ' and v.idfilial = :P690_IDFILIAL '
                  else ''
                end
                ||
                case 
                  when :P690_BASERMC is not null and :P690_BASERMC <> 'A'
                  then ' and v.ativo = :P690_BASERMC '
                  else ''
                end
                ||
                case 
                  when :P690_SELECAO = 'S' 
                  then ' and p.datahigienizacao is not null '
                  else ''
                end
                ||
                case 
                  when :P690_SELECAO = 'N' 
                  then ' and p.datahigienizacao is null '
                  else ''
                end
                ||
                case 
                  when :P690_COMPRAFAV = 'S'
                  then q'[
                        and exists (
                            select 1
                              from favorita.pedidos ped
                             where v.idvendedora = ped.idvendedora
                               and ped.datacancelamento is null
                        )
                      ]'
                  when :P690_COMPRAFAV = 'N'
                  then q'[
                        and not exists (
                            select 1
                              from favorita.pedidos ped
                             where v.idvendedora = ped.idvendedora
                               and ped.datacancelamento is null
                        )
                      ]'
                  else ''
                end
                ||
                case 
                  when :P690_CATEGORIA is not null and :P690_CATEGORIA <> '-1'
                  then q'[
                        and exists (
                            select 1
                              from roman.pontuacoesclubedesucesso pcs
                             where pcs.idvendedora = v.idvendedora
                               and pcs.idcategoriaclube = :P690_CATEGORIA
                        )
                      ]'
                  else ''
                end
                ||
                  case
                    when :P690_QTDDIASEMISSAO is not null
                    then q'[
                          and trunc(sysdate) - ( select max(trunc(dataemissao))
                                                   from vw_pedidos_fav pp
                                                  where pp.idvendedora = v.idvendedora
                                                    and pp.ididioma    = 1
                                                    and pp.codpedidocancelado = 'N'
                                               ) >= :P690_QTDDIASEMISSAO
                        ]'
                    else ''
                  end
                ||
                
                q'~
                
                   -- regras fixas
                   and not exists (
                         select 1
                           from catal.representantes rep
                          where p.idpessoa = rep.idpessoa
                       )
                
                   and not exists (
                         select 1
                           from catal.funcionarios fun
                          where p.idpessoa = fun.idpessoa
                       )
                
                ~';
                ```
            pageItemsToSubmit: [
                P690_IDPAIS
                P690_IDFILIAL
                P690_BASERMC
                P690_CATEGORIA
                P690_COMPRAFAV
                P690_SELECAO
            ]
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
