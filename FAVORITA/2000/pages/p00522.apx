page 522 (
    name: Consultoras no prazo de pedido
    title: Consultoras no prazo de pedido
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region consultoras-no-prazo-de-pedido (
        name: Consultoras no Prazo de Pedido
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select fi.idfilial, fi.nome filial
                     , ve.idvendedora, initcap(pv.nomepessoa) vendedora, pv.cpf 
                     , re.idrepresentante, initcap(pr.nomepessoa) representante
                     , ge.idgerente, initcap(pg.nomepessoa) gerente
                     , pck_util_fav.fnc_data_limite_pedido(ve.idvendedora) datalimite
                     , pv.idpessoa Cadastro
                  from catal.vendedoras     ve
                     , catal.pessoas        pv
                     , catal.representantes re
                     , catal.pessoas        pr
                     , roman.vw_filiais     fi
                     , catal.gerentes       ge
                     , catal.pessoas        pg
                 where ve.ativo    = 'S'
                   and re.ativo    = 'S'
                   and ( fi.idfilial = :P522_IDFILIALROMANCE or :P522_IDFILIALROMANCE is null)
                   and (:P522_IDREPRESENTANTE is null or :P522_IDREPRESENTANTE = re.idrepresentante )
                   ----- nao considera representantes que sao vendedores
                   and not exists (select 1 
                                     from catal.representantes 
                                    where idpessoa = ve.idpessoa
                                      and ativo = 'S')
                   -----------------------------------------------------
                   and ve.idrepresentante = re.idrepresentante
                   and re.idgerente       = ge.idgerente
                   and ge.idfilial        = fi.idfilial
                   and ve.idpessoa        = pv.idpessoa
                   and ge.idpessoa        = pg.idpessoa
                   and re.idpessoa        = pr.idpessoa
                   -----------------------------------------------------
                   and pck_util_fav.fnc_data_limite_pedido(ve.idvendedora) between trunc(sysdate + 2) and trunc(sysdate + 3)
                   and ( select nvl(sum(cp.valorpagar - cp.valorpago),0)
                                           from favorita.vencimentospedidos cp
                                              , favorita.pedidos p
                                           where p.idpedido = cp.idpedido
                                             and p.datacancelamento is null
                                             and p.idvendedora = ve.idvendedora
                                             and cp.situacaovencimento = 'V'
                                             and cp.datavencimento < sysdate
                                             and cp.valorpagar > cp.valorpago) <= 0 
                   and not exists ( select 1 
                                      from favorita.pedidos
                                     where idSituacaoEntrega in (20000, 30000, 31000, 
                                                                 32000, 34000, 34500, 40000) 
                                       and idvendedora = ve.idvendedora)
                   and exists (select 1 
                                 from favorita.pedidos p 
                                where p.idvendedora = ve.idvendedora) 
                 order by pr.nomepessoa, 
                          pv.nomepessoa
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1554621647141583175
        }

        column CADASTRO (
            type: link
            heading {
                heading: Cadastro
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 85
                    items: {
                        P85_IDPESSOA: #CADASTRO#
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-view.png" class="apex-edit-view" alt="">
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: Z
            }
        )

        column CPF (
            type: plainText
            heading {
                heading: CPF
            }
            layout {
                sequence: 110
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: Y
            }
        )

        column DATALIMITE (
            type: plainText
            heading {
                heading: Data Limite
            }
            layout {
                sequence: 100
            }
            appearance {
                formatMask: dd/mm/rrrr
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: X
            }
        )

        column FILIAL (
            type: plainText
            heading {
                heading: Filial
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: R
            }
        )

        column GERENTE (
            type: plainText
            heading {
                heading: Gerente
            }
            layout {
                sequence: 90
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: W
            }
        )

        column IDFILIAL (
            type: plainText
            heading {
                heading: Idfilial
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: Q
            }
        )

        column IDGERENTE (
            type: plainText
            heading {
                heading: Idgerente
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: V
            }
        )

        column IDREPRESENTANTE (
            type: plainText
            heading {
                heading: Idrepresentante
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: U
            }
        )

        column IDVENDEDORA (
            type: plainText
            heading {
                heading: Idvendedora
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: S
            }
        )

        column REPRESENTANTE (
            type: plainText
            heading {
                heading: Distribuidor
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column VENDEDORA (
            type: plainText
            heading {
                heading: Vendedora
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: T
            }
        )

        page {
            size: a4
            units: millimeters
            width: 210
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 101950 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CADASTRO (
                sequence: 1
            )

            displayColumn CPF (
                sequence: 6
            )

            displayColumn DATALIMITE (
                sequence: 7
            )

            displayColumn FILIAL (
                sequence: 2
            )

            displayColumn GERENTE (
                sequence: 3
            )

            displayColumn REPRESENTANTE (
                sequence: 4
            )

            displayColumn VENDEDORA (
                sequence: 5
            )

            filter ir-condition (
                column: DATALIMITE
                operator: isNotNull
            )

        )

    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P522_IDFILIALROMANCE (
        type: plugin/select
        label {
            label: Filial Romance
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome     showvalue
                     , f.idfilial returnvalue
                from roman.vw_filiais f
                where f.tipofilial = 'D'
                ```
            displayExtraValues: false
            nullDisplayValue: "- Todos - "
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P522_IDREPRESENTANTE (
        type: plugin/select
        label {
            label: Representante:
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select roman.pck_romance.fnc_nomerepresentante(idrepresentante) display_value
                     , idrepresentante
                from representantes
                where (:P522_IDFILIALROMANCE is null or 
                         ( :P522_IDFILIALROMANCE is not null 
                           and idgerente in ( select idgerente from gerentes where idfilial = :P522_IDFILIALROMANCE) ))
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: "- Todos - "
        }
        cascadingLov {
            parentItems: P522_IDFILIALROMANCE
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        name: Go To Page 522
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 522
                items: {
                    P522_IDFILIALROMANCE: &P522_IDFILIALROMANCE.
                    P522_IDREPRESENTANTE: &P522_IDREPRESENTANTE.
                }
                action: resetPagination
            }
        }
    )

)

