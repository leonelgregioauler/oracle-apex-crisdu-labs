    validation conta-do-pagamento (
        name: Conta do Pagamento
        execution {
            sequence: 70
        }
        validation {
            type: itemIsNotNull
            item: P133_CONTAPAGAMENTO
        }
        error {
            errorMessage: Por favor, informe a Conta do Pagamento/Dep¿o!
        }
        serverSideCondition {
            type: item=value
            item: P133_IDTIPOPROTOCOLO
            value: 3
        }
    )

    validation data-de-prorrogacao (
        name: Data de Prorrogacao
        execution {
            sequence: 10
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where to_date(:P133_DATAPRORROGACAO) < trunc(sysdate)
                ```
        }
        error {
            errorMessage: Por favor, insira uma Data Valida! Nao  e datas menores que o dia atual.
            associatedItem: @P133_DATAPRORROGACAO
        }
        serverSideCondition {
            whenButtonPressed: @finalizar
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P133_IDTIPOPROTOCOLO in (2,8)
                ```
        }
    )

    validation data-pgto (
        name: Data Pgto
        execution {
