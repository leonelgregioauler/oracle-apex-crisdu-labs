page 133 (
    name: 3a Etapa
    title: Terceira Etapa
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region novo-protocolo-de-atendimento (
        name: Novo Protocolo de Atendimento
        type: list
        source {
            list: @novo-protocolo-de-atendimento
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    region passo-3-protocolo (
        name: Passo 3 Protocolo
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P133_CONTAPAGAMENTO (
        type: selectList
        label {
            label: Conta
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.beneficiario||' ('||b.nomebanco||' - Ag: '||c.agencia||'- CC: '||c.conta||')' d
                     , c.idcontabanc r
                from roman.contasbancarias c
                   , roman.bancos b
                where b.idbanco = c.idbanco
                  and c.ativo = 'S'
                  and c.usosetorcobranca = 'S'
                order by 1;
                ```
        }
        layout {
            sequence: 150
            region: @passo-3-protocolo
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P133_IDTIPOPROTOCOLO in (11, 3)
        }
        security {
            encryptSessionState: false
        }
    )

