    pageItem P133_IDMOTIVOPROTOCOLO (
        type: selectList
        label {
            label: Motivo
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_retornamotivoprotocolo(m.idmotivoprotocolo,:P0_IDIDIOMA) display_value
                     , m.idmotivoprotocolo return_value
                from motivosprotocolos m
                where m.idtipoprotocolo = :P133_IDTIPOPROTOCOLO
                and m.aparecercall = 'S'
                and pck_util_fav.fnc_verificagrupoatendimento (4, :P0_IDUSUARIO) = 'S'
                union
                select pck_util_fav.fnc_retornamotivoprotocolo(m.idmotivoprotocolo,:P0_IDIDIOMA) display_value
                     , m.idmotivoprotocolo return_value
                from motivosprotocolos m
                where m.idtipoprotocolo = :P133_IDTIPOPROTOCOLO
                and m.aparecerfilial = 'S'
                and pck_util_fav.fnc_verificagrupoatendimento (4, :P0_IDUSUARIO) = 'N'   
                union
                select pck_util_fav.fnc_retornamotivoprotocolo(m.idmotivoprotocolo,:P0_IDIDIOMA) display_value
                     , m.idmotivoprotocolo return_value
                from motivosprotocolos m
                where m.idtipoprotocolo = :P133_IDTIPOPROTOCOLO
                and m.aparecercall = 'S'
                and pck_util_fav.fnc_verificagrupoatendimento (33, :P0_IDUSUARIO) = 'S'
                union
                select pck_util_fav.fnc_retornamotivoprotocolo(m.idmotivoprotocolo,:P0_IDIDIOMA) display_value
                     , m.idmotivoprotocolo return_value
                from motivosprotocolos m
                where m.idtipoprotocolo = :P133_IDTIPOPROTOCOLO
                and m.aparecercall = 'S'
                and pck_util_fav.fnc_verificagrupoatendimento (34, :P0_IDUSUARIO) = 'S'
                order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 210
            region: @passo-3-protocolo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P133_IDTIPOPROTOCOLO not in (11, 3)
        }
        security {
            encryptSessionState: false
        }
    )

