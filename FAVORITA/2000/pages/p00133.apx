    button finalizar (
        buttonName: FINALIZAR
        label: Finalizar
        layout {
            sequence: 20
            region: @passo-3-protocolo
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
            cssClasses: finalizar
        }
        behavior {
            action: definedByDynamicAction
            executeValidations: false
        }
    )

    dynamicAction calcula-juros (
        name: Calcula Juros
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P133_DATAPAGAMENTO
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P133_IDTIPOPROTOCOLO in (3)
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      vdatavencimento date;
                      vdatapagamento  date;
                      vsaldo          number(15,2);
                      --
                    begin
                      --
                      select vp.datavencimento
                           , vp.saldo
                      into vdatavencimento
                         , vsaldo
                      from vw_vencimentospedidos_fav vp
                      where vp.idpedido = :P133_IDPEDIDO;
                      --
                      vdatapagamento := :P133_DATAPAGAMENTO;
                      --
                      if vdatavencimento < nvl(:P133_DATAPAGAMENTO, trunc(sysdate)) then
                        --
                        :P133_VALORDEPOSITADO := to_char(pck_util_fav.fnc_calculajuros( pidpedido           => :P133_IDPEDIDO,
                                                                                        pvalororiginal      => vsaldo,
                                                                                        pdatavencimentoorig => vdatavencimento,
                                                                                        pdatavencimentonovo => vdatapagamento,
                                                                                        ppercmulta          => 2,
                                                                                        ppercjuros          => 1), '999G999G999G990D00');                                                              
                        --
                      else
                        :P133_VALORDEPOSITADO := vsaldo;
                      end if;
                      --
                      :P133_VALORDESTEPEDIDO := :P133_VALORDEPOSITADO;
                    end;
                            
                    ```
                itemsToSubmit: [
                    P133_IDPEDIDO
                    P133_DATAPAGAMENTO
                ]
                itemsToReturn: [
                    P133_VALORDEPOSITADO
                    P133_VALORDESTEPEDIDO
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction confirma-protocolo (
        name: Confirma Protocolo
        execution {
            sequence: 50
        }
        when {
            event: click
            selectionType: button
            button: @finalizar
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                     $(".finalizar").hide();
                        
                       setInterval(function() {
                         $(".finalizar").show();
                       }, 8000);
                       
                       apex.message.confirm('Confirma a criação do protocolo?', function(simnao) {
                         if (simnao) {
                           apex.submit('FINALIZAR');
                         } 
                         else {
                            $(".finalizar").show();
                         }
                         
                       });
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction parcelamento-com-entrada (
        name: Parcelamento Com Entrada
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P133_PARCELAMENTOCOMENTRADA
        }
        clientSideCondition {
            type: item=value
            item: P133_PARCELAMENTOCOMENTRADA
            value: S
        }

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P133_DATAVENCIMENTOENTRADA
                    P133_VALORENTRADAPARCELAMENTO
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction parcelamento-sem-entrada (
        name: Parcelamento Sem Entrada
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P133_PARCELAMENTOCOMENTRADA
        }
        clientSideCondition {
            type: itemIsNull
            item: P133_PARCELAMENTOCOMENTRADA
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P133_DATAVENCIMENTOENTRADA
                    P133_VALORENTRADAPARCELAMENTO
                ]
            }
            execution {
