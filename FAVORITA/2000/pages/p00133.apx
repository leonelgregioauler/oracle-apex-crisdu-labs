    validation data-vencimento-entrada-obrigatório (
        name: Data Vencimento Entrada Obrigatório
        execution {
            sequence: 130
        }
        validation {
            language: sql
            sqlExpression: :P133_DATAVENCIMENTOENTRADA is not null
            alwaysExecute: true
        }
        error {
            errorMessage: Data Vencimento deve ser informada
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'FINALIZAR' and :P133_IDTIPOPROTOCOLO = 12 and :P133_PARCELAMENTOCOMENTRADA = 'S';
        }
    )

    validation dias-prazo-parcelas (
        name: Dias Prazo Parcelas
        execution {
            sequence: 120
        }
        validation {
            language: sql
            sqlExpression: :P133_DIASPRAZOPARCELAS is not null
            alwaysExecute: true
        }
        error {
            errorMessage: Prazo deve ser informado
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'FINALIZAR' and :P133_IDTIPOPROTOCOLO = 12;
        }
    )

    validation justificativa (
        name: Justificativa
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P133_JUSTIFICATIVA
        }
        error {
            errorMessage: Por favor, informe uma justificativa!
        }
        serverSideCondition {
            whenButtonPressed: @finalizar
        }
    )

    validation motivo (
        name: Motivo
        execution {
            sequence: 40
        }
        validation {
            type: itemIsNotNull
            item: P133_IDMOTIVOPROTOCOLO
        }
        error {
            errorMessage: Por favor, informe um motivo!
        }
        serverSideCondition {
            type: item!=value
            item: P133_IDTIPOPROTOCOLO
            value: 3
        }
    )

    validation quantidade-de-dias-inteiro (
        name: Quantidade de Dias Inteiro
        execution {
            sequence: 90
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  verro varchar2(1000);
                begin
                  if instr(:P133_DIASPRAZOPARCELAS, ',') > 0 or
                     instr(:P133_DIASPRAZOPARCELAS,'.') > 0 then
                    --
                    return 'Dias Prazo Parcela deve ser um número inteiro';
                    --
                  else
                    null;
                  end if;
                end;
                ```
            alwaysExecute: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'FINALIZAR' and :P133_IDTIPOPROTOCOLO = 12;
        }
    )

    validation quantidade-de-dias-maior-que (
        name: Quantidade de Dias Maior que 0
        execution {
            sequence: 100
        }
        validation {
            language: sql
            sqlExpression: :P133_DIASPRAZOPARCELAS > 0
            alwaysExecute: true
        }
        error {
            errorMessage: "Dias Prazo Parcela deve ser maior que zero (0) "
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'FINALIZAR' and :P133_IDTIPOPROTOCOLO = 12 and instr(:P133_DIASPRAZOPARCELAS, '.') = 0;
        }
    )

    validation quantidade-parcelas-obrigatório (
        name: Quantidade Parcelas Obrigatório
        execution {
            sequence: 110
        }
        validation {
            language: sql
            sqlExpression: :P133_QUANTIDADEPARCELAS is not null
            alwaysExecute: true
        }
        error {
            errorMessage: Quantidade de Parcelas deve ser informada
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'FINALIZAR' and :P133_IDTIPOPROTOCOLO = 12;
        }
    )

    validation valida-data-vencimento-entrada (
        name: Valida Data Vencimento Entrada
        execution {
            sequence: 80
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where exists ( select 1
                               from pedidos 
                               where idpedido = :P133_IDPEDIDO
                               and trunc(dataentrega) >= to_date(:P133_DATAVENCIMENTOENTRADA, 'dd/mm/rrrr') );
                ```
            alwaysExecute: true
        }
        error {
            errorMessage: Data de vencimento da entrada deve ser maior que a data de entrega do pedido.
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'FINALIZAR' and :P133_IDTIPOPROTOCOLO = 12;
        }
    )

    validation valida-se-existe-negociadora-responsável (
        name: Valida se existe Negociadora Responsável
        execution {
            sequence: 160
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where not exists ( select 1
                                   from pedidos p
                                   where p.idpedido = :P133_IDPEDIDO 
                                   and p.idusuarioresponsavelcobranca is null )
                ```
            alwaysExecute: true
        }
        error {
            errorMessage: Não é possível incluir um pagamento, pois já existe uma negociadora responsável. Favor entrar em contato com o setor de Cobrança.
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where v('REQUEST') in ('FINALIZAR')
                and :P133_IDTIPOPROTOCOLO = 3
                ```
        }
    )

    validation valida-se-já-existe-negociação-da-cobrança (
        name: Valida se já existe Negociação da Cobrança
        execution {
            sequence: 150
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where ( exists ( select 1
                                 from parcelamentospedidos p
                                 where p.idpedido = :P133_IDPEDIDO )
                     or exists ( select 1
                                 from pedidos ped
                                 where ped.idpedido = :P133_IDPEDIDO
                                   and ped.idnegociadoraresponsavel is not null )
                     or exists ( select 1
                                 from classificacoespedidos c
                                 where c.idcaracteristicapedido = 44
                                   and c.idpedido = :P133_IDPEDIDO ) )
                   and (exists ( select 1
                                 from roman.usuariosgruposatendimento u
                                 where u.usuario = ( select usuario
                                                     from usuarios uu
                                                     where uu.idusuario = :P0_IDUSUARIO ) 
                                   and u.idgrupoatendimento != 3 ) 
                      or not exists ( select 1
                                      from roman.usuariosgruposatendimento u
                                      where u.usuario = ( select usuario
                                                          from usuarios uu
                                                          where uu.idusuario = :P0_IDUSUARIO ) ) )
                ```
            alwaysExecute: true
        }
        error {
            errorMessage: Não é possível incluir um pagamento, pois já existe uma negociação com o setor de cobrança. Favor entrar em contato com o setor de Cobrança.
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where v('REQUEST') in ('FINALIZAR')
                and :P133_IDTIPOPROTOCOLO = 3
                ```
        }
    )

    validation valor-entrada-parcelamento-obrigatório (
        name: Valor Entrada Parcelamento Obrigatório
        execution {
            sequence: 140
        }
        validation {
            language: sql
            sqlExpression: :P133_VALORENTRADAPARCELAMENTO is not null
            alwaysExecute: true
        }
        error {
            errorMessage: Valor Entrada deve ser informado
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') = 'FINALIZAR' and :P133_IDTIPOPROTOCOLO = 12 and :P133_PARCELAMENTOCOMENTRADA = 'S';
        }
    )

    validation valor-pagamento (
        name: Valor Pagamento
        execution {
            sequence: 60
        }
        validation {
            type: itemIsNotNull
            item: P133_VALORDEPOSITADO
        }
        error {
            errorMessage: Por favor, informe o valor do Pagamento/Dep¿o!
        }
        serverSideCondition {
            type: item=value
            item: P133_IDTIPOPROTOCOLO
            value: 3
        }
    )

    process limpa-cache (
        name: Limpa Cache
        type: clearSessionState
        clear {
            type: pages
            pages: [
                131
                132
            ]
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 15854110281402133
        }
    )

    process processo-dml-em-protocolos-de-atendimentos (
        name: Processo DML em Protocolos de Atendimentos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidprotocoloatendimento number;
                  vidfilial               number;
                  vdataprotocolo          date := sysdate;
                  vidpedido               number;
                  vsituacao               varchar2(1) := 'P';
                  vjustificativa          varchar2(2000);
                  vdataatendimento        date;
                  vobservacaointerna      varchar2(2000);
                  vidmotivoprotocolo      number;
                  vcpf                    varchar2(11);
                  vidtipoprotocolo        number;
                  vidusuarioatendeu       number;
                  vnumerocomprovante      varchar2(30);
                  vvalordepositado        number;
                  vdataprorrogacao        date;
                  vdatapagamento          date;
                  vcontapagamento         varchar2(30);
                  vmd5                    varchar2(2000);
                  vidjustificativaprorrog number;
                  --
                begin
                  --
                  vvalordepositado := to_number(:P133_VALORDEPOSITADO, '999G999G999D99');
                  --
                  pck_protocolosatendimentos_fav.prc_protocolosatendimentos( pidprotocoloatendimento     => vidprotocoloatendimento
                                                                           , pidfilial                   => vidfilial
                                                                           , pidusuariosolicitou         => :P0_IDUSUARIO
                                                                           , pdataprotocolo              => VDATAPROTOCOLO
                                                                           , pidpedido                   => :P133_IDPEDIDO
                                                                           , psituacao                   => vsituacao
                                                                           , pjustificativa              => :P133_JUSTIFICATIVA
                                                                           , pdataatendimento            => vdataatendimento
                                                                           , pobservacaointerna          => vobservacaointerna
                                                                           , pidmotivoprotocolo          => :P133_IDMOTIVOPROTOCOLO
                                                                           , pcpf                        => :P133_CPF
                                                                           , pidtipoprotocolo            => :P133_IDTIPOPROTOCOLO
                                                                           , pidusuarioatendeu           => vidusuarioatendeu
                                                                           , pnumerocomprovante          => :P133_NUMEROCOMPROVANTE
                                                                           , pvalordepositado            => vvalordepositado
                                                                           , pdataprorrogacao            => :P133_DATAPRORROGACAO
                                                                           , pdatapagamento              => :P133_DATAPAGAMENTO
                                                                           , pcontapagamento             => :P133_CONTAPAGAMENTO
                                                                           , pdocestrangeiro             => :P133_DOCESTRANGEIRO
                                                                           , pidrepresentante            => :P133_IDREPRESENTANTE
                                                                           , pparcelamentocomentrada     => :P133_PARCELAMENTOCOMENTRADA
                                                                           , pdatavencimentoentrada      => :P133_DATAVENCIMENTOENTRADA
                                                                           , pvalorentradaparcelamento   => :P133_VALORENTRADAPARCELAMENTO
                                                                           , pquantidadeparcelas         => :P133_QUANTIDADEPARCELAS
                                                                           , pdiasprazoparcelas          => :P133_DIASPRAZOPARCELAS
                                                                           , pmd5                        => vmd5
                                                                           , poperacao_dml               => 'I'   );
                  --
                  :P133_IDPROTOCOLOATENDIMENTO := vidprotocoloatendimento;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Protocolo criado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 16333466039140178
        }
        serverSideCondition {
            whenButtonPressed: @finalizar
        }
    )

    branch (
        name: finaliza protocolo
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 130
                items: {
                    P130_IDPROTOCOLOATENDIMENTO: &P133_IDPROTOCOLOATENDIMENTO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P133_IDTIPOPROTOCOLO not in 11
        }
    )

    branch (
        name: protocolo para vários pedidos
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 335
                items: {
                    P335_IDPROTOCOLOATENDIMENTO: &P133_IDPROTOCOLOATENDIMENTO.
                }
                clearCache: 335
                action: resetPagination
            }
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P133_IDTIPOPROTOCOLO = 11
        }
    )

)

