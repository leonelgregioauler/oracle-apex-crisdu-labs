            sequence: 30
            region: @cadastro-de-tarefa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 15
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        security {
            encryptSessionState: false
        }
    )

    button atualizar (
        buttonName: ATUALIZAR
        label: Atualizar
        layout {
            sequence: 50
            region: @cadastro-de-tarefa
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconRight
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P72_IDTAREFA
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir
        layout {
            sequence: 20
            region: @cadastro-de-tarefa
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'EXCLUIR');
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where pck_util.fnc_verificaacesso(58090,v('APP_USER')) = 'S'
                ```
        }
    )

    button fechar (
        buttonName: FECHAR
        label: Fechar
        layout {
            sequence: 10
            region: @cadastro-de-tarefa
            slot: close
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-remove
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 94
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button inserir (
        buttonName: INSERIR
        label: Inserir
        layout {
            sequence: 40
            region: @cadastro-de-tarefa
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P72_IDTAREFA
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 30
            region: @cadastro-de-tarefa
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation idsituacao (
        name: IDSITUACAO
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P72_IDSITUACAO
        }
        error {
            errorMessage: Informe a situação da Tarefa!
        }
        serverSideCondition {
            whenButtonPressed: @inserir
        }
    )

    validation idtipotarefa (
        name: IDTIPOTAREFA
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P72_IDTIPOTAREFA
        }
        error {
            errorMessage: Informe o Tipo da Tarefa!
        }
        serverSideCondition {
            whenButtonPressed: @inserir
        }
    )

    validation telefone (
        name: TELEFONE
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P72_TELEFONE
        }
        error {
            errorMessage: Informe o Telefone!
        }
        serverSideCondition {
            whenButtonPressed: @inserir
        }
    )

    process consulta-tarefa (
        name: Consulta Tarefa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    --
                    pck_tarefas_fav.prc_tarefas(pidtarefa           => :P72_IDTAREFA,
                                                pidtipotarefa       => :P72_IDTIPOTAREFA,
                                                pidticketcallcenter => :P72_IDTICKETCALLCENTER,
                                                ptelefone           => :P72_TELEFONE,
                                                pdatainclusao       => :P72_DATAINCLUSAO,
                                                pprioridade         => :P72_PRIORIDADE,
                                                pidsituacao         => :P72_IDSITUACAO,
                                                pobservacao         => :P72_OBSERVACAO,
                                                pidusuario          => :P72_IDUSUARIO,
                                                pidpessoa           => :P72_IDPESSOA,
                                                pidgrupoatendimento => :P72_IDGRUPOATENDIMENTO,
                                                pdatainicio         => :P72_DATAINICIO,
                                                pdataconclusao      => :P72_DATACONCLUSAO,
                                                pnumeroposicaoatendimento  => :P72_NUMEROPOSICAOATENDIMENTO,
                                                pidpedido           => :P72_IDPEDIDO,
                                                pcodigoarea         => :P72_CODIGOAREA,
                                                pmd5                => :P72_MD5,
                                                poperacao_dml       => 'S');
                  --
                end;
                
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 11577814477373657
        }
    )

    process limpa-campos-para-adicionar (
        name: Limpa Campos para Adicionar
        type: clearSessionState
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 11578252470373657
        }
        serverSideCondition {
            whenButtonPressed: @novo
        }
    )

    process operação-dml-em-lista-de-tarefas (
        name: Operação DML em Lista de Tarefas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                  end if;
                  --
                  if substr(:P72_TELEFONE,1,1) = '(' then
                    --
                    :P72_CODIGOAREA := substr(:P72_TELEFONE,2,2); 
                    --
                  else
                    --
                    :P72_CODIGOAREA := substr(:P72_TELEFONE,1,2); 
                    --
                  end if;
                  --
                  #OWNER#.pck_tarefas_fav.prc_tarefas(pidtarefa           => :P72_IDTAREFA,
                                                      pidtipotarefa       => :P72_IDTIPOTAREFA,
                                                      pidticketcallcenter => :P72_IDTICKETCALLCENTER,
                                                      ptelefone           => :P72_TELEFONE,
                                                      pdatainclusao       => :P72_DATAINCLUSAO,
                                                      pprioridade         => :P72_PRIORIDADE,
                                                      pidsituacao         => :P72_IDSITUACAO,
                                                      pobservacao         => :P72_OBSERVACAO,
                                                      pidusuario          => :P72_IDUSUARIO,
                                                      pidpessoa           => :P72_IDPESSOA,
                                                      pidgrupoatendimento => :P72_IDGRUPOATENDIMENTO,
                                                      pdatainicio         => :P72_DATAINICIO,
                                                      pdataconclusao      => :P72_DATACONCLUSAO,
                                                      pnumeroposicaoatendimento => :P72_NUMEROPOSICAOATENDIMENTO,
                                                      pidpedido           => :P72_IDPEDIDO,
                                                      pcodigoarea         => :P72_CODIGOAREA,
                                                      pidpais             => :P0_IDIDIOMA,
                                                      pmd5                => :P72_MD5,
                                                      poperacao_dml       => voperacao_dml);
                  --
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Registro Atualizado!
        }
        advanced {
            executionMappingIdentifier: 11577430564373656
        }
        serverSideCondition {
            type: request!=Value
            value: NOVO
        }
    )

    branch (
        name: Go To Page 94
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 94
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @inserir
        }
    )

)

