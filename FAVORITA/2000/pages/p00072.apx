    pageItem P72_IDSITUACAO (
        type: selectList
        label {
            label: Situação
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.descricao
                 , s.idsituacaotarefa
                from situacoestarefas s
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 90
            region: @cadastro-de-tarefa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: 0
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P72_IDTAREFA (
        type: textField
        label {
            label: Nr Tarefa
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 10
            region: @cadastro-de-tarefa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 5
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P72_IDTICKETCALLCENTER (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @cadastro-de-tarefa
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P72_IDTIPOTAREFA (
        type: selectList
        label {
            label: Tipo Tarefa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initcap(descricao) display_value
                     , idtipotarefa return_value
                from tipostarefas t
                where t.idtipotarefa in ( select idtipotarefa 
                                          from permissoestipostarefas p 
                                          where p.idusuario = ( select idusuario
                                                                from usuarios
                                                                where usuario = v('APP_USER') )
                                            and p.incluirtarefa = 'S')
                order by 2 DESC;
                ```
            nullDisplayValue: " - Selecione o Tipo de Tarefa - "
        }
        layout {
            sequence: 50
            region: @cadastro-de-tarefa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P72_IDUSUARIO (
        type: popupLov
        label {
            label: Usuário
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeusuario(idusuario) display_value
                     , u.idusuario return_value
                from usuarios u  
                   , roman.usuariosgruposatendimento ug    
                where u.ativo = 'S'
                  and ug.usuario = u.usuario
                  and ug.idgrupoatendimento in ( select uu.idgrupoatendimento
                                                 from roman.usuariosgruposatendimento uu
                                                 where uu.usuario = v('APP_USER') )
                order by 1 
                ```
        }
        layout {
            sequence: 60
            region: @cadastro-de-tarefa
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: " - Selecione o Usuário - "
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P72_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 170
            region: @cadastro-de-tarefa
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P72_NUMEROPOSICAOATENDIMENTO (
