page 72 (
    name: Cadastro de Tarefa
    title: Cadastro de Tarefa
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 80%
        height: 80%
        resizable: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-de-tarefa (
        name: Cadastro de Tarefa
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent5
                t-Region--scrollBody
            ]
        }
        settings {
            outputAs: text
        }
    )

    pageItem P72_CODIGOAREA (
        type: selectList
        label {
            label: Codigo Area
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select substr(:P72_TELEFONE,2,2) display_value
                     , substr(:P72_TELEFONE,2,2) return_value
                from dual;
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P72_TELEFONE
        }
        layout {
            sequence: 190
            region: @cadastro-de-tarefa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  --
                  return substr(:P72_TELEFONE,2,2);
                  --
                end;
                ```
        }
        serverSideCondition {
            type: never
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P72_DATACONCLUSAO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 140
            region: @cadastro-de-tarefa
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P72_DATAINCLUSAO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @cadastro-de-tarefa
            slot: regionBody
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

