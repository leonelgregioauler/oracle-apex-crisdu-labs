        layout {
            sequence: 100
            region: @cadastro-de-tarefa
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
            height: 5
        }
        validation {
            maxLength: 4000
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P72_OPERACAO_DML (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 180
            region: @cadastro-de-tarefa
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P72_PRIORIDADE (
        type: numberField
        label {
            label: Prioridade
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 40
            region: @cadastro-de-tarefa
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 5
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P72_TELEFONE (
