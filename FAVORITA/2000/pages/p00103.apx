page 103 (
    name: Relatório de Fluxogramas Pedidos
    title: Fluxogramas Pedidos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region fluxogramas-pedidos (
        name: Fluxogramas Pedidos
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idfluxogramapedido
                     , nome
                     , descricao
                     , tipofluxograma
                     , idsituacaofluxogramapedido
                     , situacao
                     , ordem
                     , ididioma
                from vw_fluxogramaspedidos_fav
                where ididioma = :P0_IDIDIOMA;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 14439108372770844
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @TIPOFLUXOGRAMA
                layout {
                    show: false
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDSITUACAOFLUXOGRAMAPEDIDO
                layout {
                    show: false
                    sequence: 4
                }
            )

            displayColumn (
                column: @SITUACAO
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @ORDEM
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @IDIDIOMA
                layout {
                    show: false
                    sequence: 7
                }
            )

            displayColumn (
                column: @IDFLUXOGRAMAPEDIDO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @NOME
                layout {
                    show: false
                    sequence: 2
                }
            )

            displayColumn (
                column: @DESCRICAO
                layout {
                    show: false
                    sequence: 4
                }
            )

            controlBreak (
                column: @TIPOFLUXOGRAMA
                sort {
                    nulls: last
                }
                layout {
                    sequence: 1
                }
            )

            controlBreak (
                column: @NOME
                sort {
                    nulls: last
                }
                layout {
                    sequence: 2
                }
            )

        )

        column DESCRICAO (
            type: numberField
            heading {
                heading: Descrição
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                databaseColumn: DESCRICAO
                dataType: number
            }
        )

        column IDFLUXOGRAMAPEDIDO (
            type: numberField
            heading {
                heading: Editar
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            link {
                target: {
                    page: 104
                    items: {
                        P104_IDFLUXOGRAMAPEDIDO: &IDFLUXOGRAMAPEDIDO.
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                databaseColumn: IDFLUXOGRAMAPEDIDO
                dataType: number
            }
        )

        column IDIDIOMA (
            type: numberField
            heading {
                heading: Ididioma
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDIDIOMA
                dataType: number
            }
        )

        column IDSITUACAOFLUXOGRAMAPEDIDO (
            type: numberField
            heading {
                heading: Idsituacaofluxogramapedido
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDSITUACAOFLUXOGRAMAPEDIDO
                dataType: number
            }
        )

        column NOME (
            type: textarea
            heading {
                heading: Nome
                alignment: center
            }
            layout {
                sequence: 30
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: NOME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ORDEM (
            type: numberField
            heading {
                heading: Ordem
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                databaseColumn: ORDEM
                dataType: number
            }
        )

        column SITUACAO (
            type: textarea
            heading {
                heading: Situação
                alignment: center
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: SITUACAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column TIPOFLUXOGRAMA (
            type: textField
            heading {
                heading: Tipo de Fluxograma
                alignment: center
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 10
            }
            source {
                databaseColumn: TIPOFLUXOGRAMA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

    )

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 104
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

