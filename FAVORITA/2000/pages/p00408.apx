                heading: Usuario
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: USUARIO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

    )

    pageItem P408_IDDOCUMENTACAO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @documentação-favorita
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P408_IDGRUPOATENDIMENTO (
        type: plugin/select
        label {
            label: Grupo Atendimento
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select descricao as d
                     , idgrupoatendimento as r
                from roman.gruposatendimento;
                ```
        }
        layout {
            sequence: 20
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P408_SELECIONARTODOS (
        type: checkboxGroup
        label {
            label: Selecionar Todos
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Todos;T
        }
        layout {
            sequence: 30
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            cssClasses: selecionartodos
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P408_USUARIOSGRUPOATENDIMENTO (
        type: checkboxGroup
        label {
            label: Usuários Grupo Atendimento
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select u.usuario   as d
                     , u.idusuario as r
                from roman.usuariosgruposatendimento uga
                   , usuarios u
                where  uga.usuario = u.usuario
                and uga.idgrupoatendimento = :P408_IDGRUPOATENDIMENTO;
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P408_IDGRUPOATENDIMENTO
        }
        layout {
            sequence: 40
            region: @opções
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        security {
            encryptSessionState: false
        }
    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 409
                items: {
                    P409_IDDOCUMENTACAO: &P409_IDDOCUMENTACAO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from permissoesdocumentacaofavorita pd
                where pd.idusuario      = :P0_IDUSUARIO
                and pd.permissaototal   = 'S'
                ```
        }
    )

    dynamicAction selecionar-deselecionar-todos-usuários (
        name: Selecionar / Deselecionar Todos Usuários
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .selecionartodos
        }
        clientSideCondition {
            type: item=value
            item: P408_SELECIONARTODOS
            value: T
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: "$('input:checkbox[name=P408_USUARIOSGRUPOATENDIMENTO]').prop( \"checked\", true );"
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode: "$('input:checkbox[name=P408_USUARIOSGRUPOATENDIMENTO]').prop( \"checked\", false );"
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
                fireOnInit: false
            }
        )

    )

    process libera-permissão (
        name: Libera Permissão
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  AS_CHECK_BOX          APEX_APPLICATION_GLOBAL.VC_ARR2;
                  --
                  vidpermissao          number;
                  viddocumentacao       number          := :P408_IDDOCUMENTACAO;
                  viditemdocumentacao   number;
                  vidfilialfavorita     number          := :P0_IDFILIALFAVORITA;
                  vidgrupoatendimento   number          := :P408_IDGRUPOATENDIMENTO;
                  vmd5                  varchar2(20);
                  voperacao_dml         varchar2(1)     := 'I';
                  --
                begin
                  --
                  AS_CHECK_BOX := APEX_UTIL.STRING_TO_TABLE(:P408_USUARIOSGRUPOATENDIMENTO, ':');
                  --
                  for i in 1 .. AS_CHECK_BOX.COUNT
                  loop
                    --
                    pck_cadastros_fav.prc_permissoesdocumentacao ( pidpermissaodocumentacao => vidpermissao,
                                                                   piddocumentacao          => viddocumentacao,
                                                                   piditemdocumentacao      => viditemdocumentacao,
                                                                   pidfilialfavorita        => vidfilialfavorita,
                                                                   pidgrupoatendimento      => vidgrupoatendimento,
                                                                   pidusuario               => AS_CHECK_BOX(i),
                                                                   pmd5                     => vmd5,
                                                                   poperacao_dml            => voperacao_dml );
                    --
                    commit;
                    --
                  end loop;
                  --
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1585173930413504290
        }
    )

    process usuários-com-acesso-save-interactive-grid-data (
        name: Usuários com Acesso - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @usuários-com-acesso
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 1585169897359504284
        }
    )

)

