                alignment: center
            }
            layout {
                sequence: 30
            }
            validation {
                maxLength: 500
            }
            source {
                databaseColumn: TITULODOCUMENTACAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
        )

    )

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region usuários-com-acesso (
        name: Usuários com Acesso
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeusuario(idusuario) usuario
                    , iddocumentacao
                from permissoesdocumentacaofavorita
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        masterDetail {
            masterRegion: @documentação-favorita
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from permissoesdocumentacaofavorita pd
                where pd.idusuario      = :P0_IDUSUARIO
                and pd.permissaototal   = 'S'
                ```
        }
        edit {
            enabled: true
            allowedOperations: delete
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 4749808383460432291
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @USUARIO
                layout {
                    width: 1334
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDDOCUMENTACAO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @ROWID
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column IDDOCUMENTACAO (
            type: hidden
            layout {
                sequence: 50
            }
            source {
                databaseColumn: IDDOCUMENTACAO
                dataType: number
            }
            masterDetail {
                masterColumn: @IDDOCUMENTACAO
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column ROWID (
            type: hidden
            layout {
