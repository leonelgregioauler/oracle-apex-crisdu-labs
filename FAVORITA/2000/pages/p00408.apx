page 408 (
    name: Documentação Favorita
    title: Documentação Favorita
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region documentação-favorita (
        name: Documentação Favorita
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.iddocumentacao,
                       d.titulodocumentacao,
                       d.descricaodocumentacao,
                       d.datainclusao,
                       d.dataatualizacao,
                       '<a href="javascript:apex.confirm(''Liberar permissão para os usuários selecionados ?'', { request:''LIBERARACESSO'',set:{''P408_IDDOCUMENTACAO'':'||d.iddocumentacao||'}})";><img src=/i/menu/pencil16x16.gif border=0 width=16 height=16></a>' idaplicacao
                from documentacaofavorita d
                where exists ( select 1 
                               from permissoesdocumentacaofavorita pd
                               where pd.iddocumentacao = d.iddocumentacao
                               and ( pd.idusuario      = :P0_IDUSUARIO ) )
                   or exists ( select 1
                               from permissoesdocumentacaofavorita pd
                               where pd.idusuario      = :P0_IDUSUARIO
                               and pd.permissaototal   = 'S' )             
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 6323474378864181069
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDAPLICACAO
                layout {
                    width: 150
                    sequence: 5
                }
            )

            displayColumn (
                column: @IDDOCUMENTACAO
                layout {
                    width: 150
                    sequence: 0
                }
            )

            displayColumn (
                column: @TITULODOCUMENTACAO
                layout {
                    width: 306
                    sequence: 2
                }
            )

            displayColumn (
                column: @DESCRICAODOCUMENTACAO
                layout {
                    width: 502
                    sequence: 3
                }
            )

            displayColumn (
                column: @DATAINCLUSAO
                layout {
                    width: 150
                    sequence: 3
                }
            )

            displayColumn (
                column: @DATAATUALIZACAO
                layout {
                    width: 150
                    sequence: 4
                }
            )

        )

        column DATAATUALIZACAO (
            type: datePickerJquery
            heading {
                heading: Data Atualização
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                databaseColumn: DATAATUALIZACAO
                dataType: date
            }
        )

        column DATAINCLUSAO (
            type: datePickerJquery
            heading {
                heading: Data Inclusão
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                databaseColumn: DATAINCLUSAO
                dataType: date
            }
        )

        column DESCRICAODOCUMENTACAO (
            type: textarea
            heading {
                heading: Descrição
                alignment: center
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: DESCRICAODOCUMENTACAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
        )

        column IDAPLICACAO (
            type: displayOnly
            heading {
                heading: Liberar Permissão
                alignment: center
            }
            settings {
                format: html
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                databaseColumn: IDAPLICACAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
        )

        column IDDOCUMENTACAO (
            type: numberField
            heading {
                heading: Editar
                alignment: center
            }
            settings {
                numberAlignment: center
                virtualKeyboard: text
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            validation {
                valueRequired: true
            }
            link {
                target: {
                    page: 409
                    items: {
                        P409_IDDOCUMENTACAO: &IDDOCUMENTACAO.
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                databaseColumn: IDDOCUMENTACAO
