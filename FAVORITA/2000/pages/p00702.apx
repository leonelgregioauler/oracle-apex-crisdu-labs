page 702 (
    name: Franquias Participantes
    title: Bônus Adimplência - Franquias
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    css {
        inline:
            ```css
            /* Bonus Adimplencia - visual comum das paginas 702, 703 e 704 */
            .bonus-card { border-radius: 10px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.06); margin-bottom: 16px; }
            .bonus-card > .t-Region-header, .bonus-card .t-IRR-region > .t-Region-header { background: #f4f6f9; }
            .bonus-card .t-Region-title { font-weight: 600; color: #1f2a37; }
            .bonus-card .a-IRR-header { background: #f4f6f9; font-weight: 600; color: #3d4a5c; }
            .bonus-card .a-IRR-table tr:hover td { background: #eef5ff; }
            .bonus-card .a-IRR-table td { border-color: #edf0f3; vertical-align: middle; }
            .bonus-filtros { border: 0; border-radius: 10px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.08); }
            .bonus-filtros > .t-Region-header { background: linear-gradient(90deg, #0b5394, #1c7ed6); border: 0; }
            .bonus-filtros .t-Region-title { color: #fff; font-weight: 600; letter-spacing: .3px; }
            .bonus-filtros .t-Region-title::before { content: "\f0b0"; font-family: "Font APEX", FontAwesome; margin-right: 8px; opacity: .9; }
            .bonus-filtros .t-Form-label { font-weight: 600; color: #3d4a5c; }
            .bonus-filtros .t-Button--primary { border-radius: 8px; font-weight: 600; margin-top: 8px; }
            .bonus-toolbar { margin-bottom: 6px; }
            .bonus-toolbar .t-Button--success { border-radius: 8px; font-weight: 600; }
            .bonus-nota { border: 1px dashed #1c7ed6; background: #f2f8ff; border-radius: 8px; box-shadow: none; }
            .bonus-nota .t-Region-body { color: #1f2a37; }
            .bonus-nova-faixa { background: #fbfcfd; }
            .bonus-ajuda .t-Form-inputContainer, .bonus-ajuda { color: #5d6b7c; font-size: 12.5px; }
            .bonus-badge { display: inline-block; padding: 2px 12px; border-radius: 12px; font-size: 12px; font-weight: 600; white-space: nowrap; }
            .bonus-badge--vigente, .bonus-badge--pago { background: #e3fcef; color: #006644; }
            .bonus-badge--pendente, .bonus-badge--futura { background: #fff4d6; color: #8a5a00; }
            .bonus-badge--cancelado { background: #ffebe6; color: #bf2600; }
            .bonus-badge--encerrada, .bonus-badge--desativada { background: #eceff3; color: #5d6b7c; }
            .bonus-valor { font-weight: 700; color: #006644; }
            .bonus-total { font-weight: 700; color: #0b5394; }
            .bonus-alerta { color: #bf2600; font-weight: 600; }
            .bonus-editar { color: #0b5394; font-size: 15px; }
            ```
    }
    security {
        authorizationScheme: @valida-acesso-a-página
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
            cssClasses: bonus-toolbar
        }
        advanced {
            htmlDomId: acoes-702
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: bonus-filtros
        }
        advanced {
            htmlDomId: filtros-702
        }
    )

    region franquias-participantes (
        name: Franquias Participantes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select x.*
                     , lower(x.situacao) situacao_css
                from (
                select p.idparametro
                     , p.idfilialromance
                     , favorita.pck_util_fav.fnc_nomefilialromance(p.idfilialromance) franquia
                     , case
                         when p.ativo = 'N' then 'Desativada'
                         when p.dtiniciovigencia > trunc(sysdate) then 'Futura'
                         when nvl(p.dtfimvigencia, date '9999-12-31') < trunc(sysdate) then 'Encerrada'
                         else 'Vigente'
                       end situacao
                     , to_char(p.dtiniciovigencia,'DD/MM/YYYY')||' -> '||nvl(to_char(p.dtfimvigencia,'DD/MM/YYYY'),'sem fim') vigencia
                     , p.dtiniciovigencia
                     , nvl(( select listagg(f.descricao||' ('||to_char(f.inad_de,'FM990D00')||'% a '
                                        ||nvl2(f.inad_ate, to_char(f.inad_ate,'FM990D00')||'%', 'mais')
                                        ||' = +'||to_char(f.perc_bonus,'FM990D0099')||'%)', '<br>')
                                 within group (order by f.inad_de)
                         from roman.comger_faixas f
                         where f.idfilialromance = p.idfilialromance
                           and f.ativo           = 'S'
                           and nvl(f.dtfimvigencia, date '9999-12-31') >= trunc(sysdate) ), '<span class="bonus-alerta">Sem faixas</span>') faixas
                     , ( select d.perc_inad
                         from roman.comger_inad_diaria d
                         where d.idfilialromance = p.idfilialromance
                           and d.dtreferencia    = ( select max(x.dtreferencia)
                                                     from roman.comger_inad_diaria x
                                                     where x.idfilialromance = p.idfilialromance ) ) ultima_inad
                     , ( select max(x.dtreferencia)
                         from roman.comger_inad_diaria x
                         where x.idfilialromance = p.idfilialromance ) dt_ultima_inad
                     , p.usuario
                     , p.datacadastro
                from roman.comger_parametros p
                ) x
                where ( :P702_FRANQUIA is null or x.idfilialromance = :P702_FRANQUIA )
                  and ( :P702_SITUACAO is null or x.situacao = :P702_SITUACAO )
                ```
            pageItemsToSubmit: [
                P702_FRANQUIA
                P702_SITUACAO
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
            cssClasses: bonus-card
        }
        advanced {
            htmlDomId: franquias-participantes
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 9820226930000202
        }

