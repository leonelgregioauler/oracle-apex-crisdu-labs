    pageItem P702_FRANQUIA (
        type: selectList
        label {
            label: Franquia:
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select fl.nome
                     , fl.idfilial
                from roman.vw_filiais fl
                where exists ( select 1
                               from roman.comger_parametros p
                               where p.idfilialromance = fl.idfilial )
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: - Todas -
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--xlarge
            ]
            height: 1
        }
    )

    pageItem P702_SITUACAO (
        type: radioGroup
        label {
            label: Situação:
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Vigente;Vigente,Futura;Futura,Encerrada;Encerrada,Desativada;Desativada
            displayExtraValues: false
            nullDisplayValue: Todas
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            alignment: left
