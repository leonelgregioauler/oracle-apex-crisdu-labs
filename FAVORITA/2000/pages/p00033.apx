page 33 (
    name: Relatório Vendas Limitadas
    title: Vendas Limitadas
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region vendas-limitadas (
        name: Vendas Limitadas
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idvendalimitada
                     , idprodutodetalhado
                     , pck_util_fav.fnc_nomeprodutodetalhado(idprodutodetalhado, :P0_IDIDIOMA) produtodetalhado
                     , quantidademaxima
                     , ativo
                from vw_vendaslimitadas_fav
                where ididioma = :P0_IDIDIOMA
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 13160374150082904
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDVENDALIMITADA
                layout {
                    width: 66
                    sequence: 1
                }
            )

            displayColumn (
                column: @QUANTIDADEMAXIMA
                layout {
                    width: 160
                    sequence: 3
                }
            )

            displayColumn (
                column: @ATIVO
                layout {
                    width: 90
                    sequence: 4
                }
            )

            displayColumn (
                column: @PRODUTODETALHADO
                layout {
                    width: 521
                    sequence: 2
                }
            )

            displayColumn (
                column: @IDPRODUTODETALHADO
                layout {
                    sequence: 5
                }
            )

        )

        column ATIVO (
            type: textFieldWithAutocomplete
            heading {
                heading: Ativo
                alignment: center
            }
            settings {
                fetchOnType: false
            }
            lov {
                type: sharedComponent
                lov: @lov-simnao
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            validation {
                maxLength: 1
            }
            source {
                databaseColumn: ATIVO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column IDPRODUTODETALHADO (
            type: numberField
            heading {
                heading: Idprodutodetalhado
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: IDPRODUTODETALHADO
                dataType: number
            }
        )

        column IDVENDALIMITADA (
            type: link
            heading {
                heading: Editar
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    page: 34
                    items: {
                        P34_IDVENDALIMITADA: &IDVENDALIMITADA.
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                databaseColumn: IDVENDALIMITADA
                dataType: number
            }
        )

        column PRODUTODETALHADO (
            type: textarea
            heading {
                heading: Produto Detalhado
                alignment: center
            }
            layout {
                sequence: 20
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: PRODUTODETALHADO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column QUANTIDADEMAXIMA (
            type: numberField
            heading {
                heading: Quantidade Máxima
                alignment: center
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: QUANTIDADEMAXIMA
                dataType: number
            }
        )

    )

    button novo (
        buttonName: NOVO
        label: Novo
        layout {
            sequence: 10
            region: @opções
            slot: top
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 34
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button novo-2 (
        buttonName: Novo
        label: Novo
        layout {
            sequence: 10
            region: @vendas-limitadas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 34
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

