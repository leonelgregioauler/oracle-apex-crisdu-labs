page 290 (
    name: Cadastro de Regiões
    title: Cadastro de Regiões
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 60%
        height: 80%
        resizable: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region cadastro-de-regiões (
        name: Cadastro de Regiões
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idregiao,
                       nomeregiao
                  from regioes
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                saveButton
            ]
        }
        enableUsersTo {
            download: false
        }
        advanced {
            savedReportMappingIdentifier: 3539868792688735651
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 0
                }
            )

            displayColumn (
                column: @IDREGIAO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @NOMEREGIAO
                layout {
                    width: 500
                    sequence: 2
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column IDREGIAO (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: IDREGIAO
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: seq_idregiao
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column NOMEREGIAO (
            type: textarea
            heading {
                heading: Região
                alignment: center
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 200
            }
            source {
                databaseColumn: NOMEREGIAO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

    )

    validation região-obrigatório (
        name: Região obrigatório
        execution {
            sequence: 20
        }
        validation {
            editableRegion: @cadastro-de-regiões
            type: columnIsNotNull
            column: NOMEREGIAO
        }
        error {
            errorMessage: #COLUMN_HEADER# must have a value.
            associatedColumn: NOMEREGIAO
        }
    )

    validation região-unique (
        name: Região Unique
        execution {
            sequence: 10
        }
        validation {
            editableRegion: @cadastro-de-regiões
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  vnomeregiao varchar2(1000);
                begin
                  select nomeregiao
                  into vnomeregiao
                  from regioes
                  where nomeregiao = :NOMEREGIAO;
                  --
                  if vnomeregiao is not null then
                    return 'Existe um cadastro no sistema com estas informações. Não são permitidas informações repetidas para este cadastro.';
                  end if;
                  --
                exception
                  when no_data_found then
                    return '';
                end;
                ```
        }
        error {
            associatedColumn: NOMEREGIAO
        }
    )

    process save-interactive-grid-data (
        name: " - Save Interactive Grid Data"
        type: interactiveGridAutoRowProcessing
        editableRegion: @cadastro-de-regiões
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 1375261819593545237
        }
    )

)

