page 295 (
    name: Comparativo Protocolos / Pedidos Recebidos
    title: Comparativo Protocolos / Pedidos Recebidos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region comparativo-protocolos-pedidos-recebidos (
        name: Comparativo Protocolos / Pedidos Recebidos
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
