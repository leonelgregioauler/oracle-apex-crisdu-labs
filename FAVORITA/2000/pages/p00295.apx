    button filtrar (
        buttonName: FILTRAR
        label: Filtrar
        layout {
            sequence: 80
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-filter
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation data-protocolo-final (
        name: Data Protocolo Final
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P295_DATAPROTOCOLOFINAL
        }
        error {
            errorMessage: Informe a data final do protocolo
            associatedItem: @P295_DATAPROTOCOLOFINAL
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where v('REQUEST') = 'FILTRAR'
                ```
        }
    )

