            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region data-protocolos (
        name: Data Protocolos
        type: staticContent
        layout {
            sequence: 10
