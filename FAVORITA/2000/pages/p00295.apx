        advanced {
            regionDisplaySelector: true
        }
    )

    region pedidos-com-recebimento-confirmado (
        name: Pedidos com Recebimento Confirmado
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct
                       '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':130:'||v('APP_SESSION')||'::NO::P130_IDPROTOCOLOATENDIMENTO:'||id.idprotocoloatendimento ,'SESSION')||''',''_blank''); void(0)">'||id.idprotocoloatendimento||'</a>' idprotocoloatendimento
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||id.idpedido ,'SESSION')||''',''_blank''); void(0)">'||id.idpedido||'</a>' idpedido
                     , id.idfilialromance
                     , id.nomefilialromance
                     , trunc(id.dataconfirmacaoestoque) dataconfirmacaoestoque
                     , id.idtipoprotocolo
                     , id.tipoprotocolo
                     , id.valortotal
                     , id.valorapagar
                from vw_itensdevolucaopedidos_fav id
                where (:P295_IDTIPOPROTOCOLO = 99 or :P295_IDTIPOPROTOCOLO = 1)
                and (:P295_IDPROTOCOLOATENDIMENTO is null or id.idprotocoloatendimento = :P295_IDPROTOCOLOATENDIMENTO)
                and (:P295_IDFILIALROMANCE is null or id.idfilialromance = :P295_IDFILIALROMANCE)
                and (id.dataconfirmacaoestoque is not null and trunc(id.dataconfirmacaoestoque) between :P295_DATARECEBIDOINICIAL and :P295_DATARECEBIDOFINAL)
                and (:P295_IDPEDIDO is null or id.idpedido = :P295_IDPEDIDO)
                and ( :P295_IDPEDIDOGERADO is null)
                and exists ( select 1
                             from pedidos p
                             where p.idsituacaoentrega >= 32000
                             and p.idpedido = id.idpedido )
                and exists ( select 1
                             from pedidos p
                             where ( ( p.idpedidovirtualage is not null and :P295_INTEGRADOVIRTUALAGE = 'S')
                                  or ( :P295_INTEGRADOVIRTUALAGE is null ) ) ) 
                and (:P295_IDESTOQUEFAVORITA is null 
                     or exists ( select 1
                                 from favorita.atendimentosfiliaisrmc ate
                                 where id.idfilialromance = ate.idfilialdestino
                                   and ate.idfilialfavoritaorigem = :P295_IDESTOQUEFAVORITA))
                and not exists ( select 1
                                 from favorita.protocolosatendimentos pat
                				 where pat.idprotocoloatendimento = id.idprotocoloatendimento 
                				   and pat.situacao = 'R')                      
                union
                select distinct
                       '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':130:'||v('APP_SESSION')||'::NO::P130_IDPROTOCOLOATENDIMENTO:'||it.idprotocoloatendimento ,'SESSION')||''',''_blank''); void(0)">'||it.idprotocoloatendimento||'</a>' idprotocoloatendimento
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||it.idpedido ,'SESSION')||''',''_blank''); void(0)">'||it.idpedido||'</a>' idpedido
                     , it.idfilialromance
                     , it.nomefilialromance
                     , trunc(it.dataconfirmacaoestoque) dataconfirmacaoestoque
                     , it.idtipoprotocolo
                     , it.tipoprotocolo
                     , it.valortotal
                     , it.valorapagar
                from vw_itenstrocapedidos_fav it
                where (:P295_IDTIPOPROTOCOLO = 99 or :P295_IDTIPOPROTOCOLO = 6)
                and (:P295_IDPROTOCOLOATENDIMENTO is null or it.idprotocoloatendimento = :P295_IDPROTOCOLOATENDIMENTO)
                and it.idfilialromance = :P295_IDFILIALROMANCE
                and (it.dataconfirmacaoestoque is not null and trunc(it.dataconfirmacaoestoque) between :P295_DATARECEBIDOINICIAL and :P295_DATARECEBIDOFINAL)
                and (:P295_IDPEDIDO is null or it.idpedido = :P295_IDPEDIDO)
                and ( :P295_IDPEDIDOGERADO is null or it.idpedidogerado = :P295_IDPEDIDOGERADO)
                and exists ( select 1
                             from pedidos p
                             where p.idsituacaoentrega >= 32000
                             and p.idpedido = it.idpedido)
                and exists ( select 1
                             from pedidos p
                             where ( ( p.idpedidovirtualage is not null and :P295_INTEGRADOVIRTUALAGE = 'S')
                                  or ( :P295_INTEGRADOVIRTUALAGE is null ) ) )   
                and (:P295_IDESTOQUEFAVORITA is null 
                     or exists ( select 1
                                 from favorita.atendimentosfiliaisrmc ate
                                 where it.idfilialromance = ate.idfilialdestino
                                   and ate.idfilialfavoritaorigem = :P295_IDESTOQUEFAVORITA))       
                and not exists ( select 1
                                 from favorita.protocolosatendimentos pat
                				 where pat.idprotocoloatendimento = it.idprotocoloatendimento 
                				   and pat.situacao = 'R')                   
                union
                select distinct
                       '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':130:'||v('APP_SESSION')||'::NO::P130_IDPROTOCOLOATENDIMENTO:'||ie.idprotocoloatendimento ,'SESSION')||''',''_blank''); void(0)">'||ie.idprotocoloatendimento||'</a>' idprotocoloatendimento
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||ie.idpedido ,'SESSION')||''',''_blank''); void(0)">'||ie.idpedido||'</a>' idpedido
                     , ie.idfilialromance
                     , ie.nomefilialromance
                     , trunc(ie.dataconfirmacaoestoque) dataconfirmacaoestoque
                     , ie.idtipoprotocolo
                     , ie.tipoprotocolo
                     , ie.valortotal
                     , ie.valorapagar
                from vw_itensexcluidospedidos_fav ie
                where (:P295_IDTIPOPROTOCOLO = 99 or :P295_IDTIPOPROTOCOLO = 4)
                and (:P295_IDPROTOCOLOATENDIMENTO is null or ie.idprotocoloatendimento = :P295_IDPROTOCOLOATENDIMENTO)
                and ie.idfilialromance = :P295_IDFILIALROMANCE
                and (ie.dataconfirmacaoestoque is not null and trunc(ie.dataconfirmacaoestoque) between :P295_DATARECEBIDOINICIAL and :P295_DATARECEBIDOFINAL)
                and (:P295_IDPEDIDO is null or ie.idpedido = :P295_IDPEDIDO)
                and ( :P295_IDPEDIDOGERADO is null)
                and exists ( select 1
                             from pedidos p
                             where p.idsituacaoentrega >= 32000
                             and p.idpedido = ie.idpedido)
                and exists ( select 1
                             from pedidos p
                             where ( ( p.idpedidovirtualage is not null and :P295_INTEGRADOVIRTUALAGE = 'S')
                                  or ( :P295_INTEGRADOVIRTUALAGE is null ) ) )             
                and (:P295_IDESTOQUEFAVORITA is null 
                     or exists ( select 1
                                 from favorita.atendimentosfiliaisrmc ate
                                 where ie.idfilialromance = ate.idfilialdestino
                                   and ate.idfilialfavoritaorigem = :P295_IDESTOQUEFAVORITA)) 
                and not exists ( select 1
                                 from favorita.protocolosatendimentos pat
                				 where pat.idprotocoloatendimento = ie.idprotocoloatendimento 
                				   and pat.situacao = 'R')
                ```
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
