    region protocolos (
        name: Protocolos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':68:'||v('APP_SESSION')||'::NO::P68_IDPEDIDO:'||idpedido ,'SESSION')||''',''_blank''); void(0)">'||idpedido||'</a>' idpedido
                     , '<a href="javascript:window.open('''||APEX_UTIL.PREPARE_URL('f?p=' || 2000 || ':130:'||v('APP_SESSION')||'::NO::P130_IDPROTOCOLOATENDIMENTO:'||idprotocoloatendimento ,'SESSION')||''',''_blank''); void(0)">'||idprotocoloatendimento||'</a>' idprotocoloatendimento
                     , idfilial  
                     , nomefilial 
                     , dataprotocolo
                     , situacao
                     , descsituacao
                     , dataatendimento
                     , case 
                         when idtipoprotocolo = 1 then
                           ( select distinct trunc(id.dataconfirmacaoestoque)
                             from vw_itensdevolucaopedidos_fav id
                             where id.idprotocoloatendimento = pf.idprotocoloatendimento
                             and id.ididioma = :P0_IDIDIOMA
                             and rownum = 1 )
                         when idtipoprotocolo = 4 then
                           ( select distinct trunc(ie.dataconfirmacaoestoque)
                             from vw_itensexcluidospedidos_fav ie
                             where ie.idprotocoloatendimento = pf.idprotocoloatendimento
                             and ie.ididioma = :P0_IDIDIOMA
                             and rownum = 1 )
                         when idtipoprotocolo = 6 then
                           ( select distinct trunc(it.dataconfirmacaoestoque)
                             from vw_itenstrocapedidos_fav it
                             where it.idprotocoloatendimento = pf.idprotocoloatendimento 
                             and it.ididioma = :P0_IDIDIOMA
                             and rownum = 1 )
                       end dataconfirmacaoestoque
                     , idtipoprotocolo
                     , tipoprotocolo
                     , valortotal
                     , valorapagar
                from vw_protocolosatendimentos_fav pf
                where pf.idtipoprotocolo in (1, 4, 6)
                and ( :P295_IDTIPOPROTOCOLO = 99 or pf.idtipoprotocolo = :P295_IDTIPOPROTOCOLO)
                and ( :P295_IDPROTOCOLOATENDIMENTO is null or pf.idprotocoloatendimento = :P295_IDPROTOCOLOATENDIMENTO )
                and ( :P295_IDFILIALROMANCE is null or pf.idfilial = :P295_IDFILIALROMANCE)
                and ( pf.dataprotocolo is not null and trunc(pf.dataprotocolo) between :P295_DATAPROTOCOLOINICIAL and :P295_DATAPROTOCOLOFINAL )
                and exists( select distinct(p.idpedido)
                            from favorita.pedidos p
                			where pf.idpedido = pf.idpedido
                			  and p.idsituacaoentrega >= 32000 )
                and (:P295_IDPEDIDO is null or pf.idpedido = :P295_IDPEDIDO)
                and (:P295_IDESTOQUEFAVORITA is null 
                     or exists ( select 1
                                 from favorita.atendimentosfiliaisrmc ate
                                 where pf.idfilial = ate.idfilialdestino
                                   and ate.idfilialfavoritaorigem = :P295_IDESTOQUEFAVORITA))
                and not exists ( select 1
                                 from favorita.protocolosatendimentos pat
                				 where pat.idprotocoloatendimento = pf.idprotocoloatendimento 
                				   and pat.situacao = 'R')       
                and ( :P295_IDPEDIDOGERADO is null or exists ( select distinct 1
                                                              from favorita.itenspedidostrocados itr
                					                          where itr.idpedidogerado = :P295_IDPEDIDOGERADO
                                                                and itr.idpedido = pf.idpedido))
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 1384224547409969510
        }

