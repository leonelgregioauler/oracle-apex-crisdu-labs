    button consulta-equifax (
        buttonName: CONSULTA_EQUIFAX
        label: Consulta Equifax
        layout {
            sequence: 40
            region: @opções-2
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P124_IDCONTROLECONTATOSSITE is not null
                  and :P124_DOCUMENTOESTRANGEIRO is not null
                  and ( not exists ( select 1
                                     from roman.consultaspc c
                                     where c.runrut = replace(replace(replace(:P124_DOCUMENTOESTRANGEIRO,'.',''),'-',''),' ','') )
                       
                        or not exists ( select 1
                                        from roman.vw_consultaspc_rmc c
                                        where c.runrut = replace(replace(replace(:P124_DOCUMENTOESTRANGEIRO,'.',''),'-',''),' ','') ) 
                      )
                ```
        }
    )

    button consulta-equifax-bkp (
        buttonName: CONSULTA_EQUIFAX_BKP
        label: Consulta Equifax bkp
        layout {
            sequence: 50
            region: @opções-2
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--stretch
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 647
                items: {
                    P647_IDFILIAL: &P0_IDFILIAL.
                    P647_USUARIO: &P0_USUARIO.
                    P647_RUT: &P124_DOCUMENTOESTRANGEIRO.
                    P647_DOCESTRANGEIRO: &P124_DOCUMENTOESTRANGEIRO.
                    P647_IDPAIS: &P124_IDPAIS.
                }
                clearCache: 647
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where :P124_IDCONTROLECONTATOSSITE is not null
                  and :P124_DOCUMENTOESTRANGEIRO is not null
                  and ( not exists ( select 1
                                     from roman.consultaspc c
                                     where c.runrut = replace(replace(replace(:P124_DOCUMENTOESTRANGEIRO,'.',''),'-',''),' ','') )
                       
                        or not exists ( select 1
                                        from roman.vw_consultaspc_rmc c
                                        where c.runrut = replace(replace(replace(:P124_DOCUMENTOESTRANGEIRO,'.',''),'-',''),' ','') ) 
                      )
                 
                 AND 1 = 2
                ```
        }
    )

