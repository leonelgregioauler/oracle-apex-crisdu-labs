    dynamicAction busca-informações-do-cep (
        name: Busca Informações do CEP
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P124_CEP
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P124_CEP
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                      vendereco varchar2(50);
                      vbairro   varchar2(50);
                      vidcidade number;
                      vcidade   varchar2(20);
                    begin
                      --
                      select c.bairro
                           , c.endereco
                           , c.cidade
                      into vbairro
                         , vendereco
                         , vcidade
                      from roman.vw_logradouro_por_cep c
                      where c.cep = trim(replace(replace(:P124_CEP,'.',''),'-',''))
                        and rownum = 1;
                      --
                      :P124_BAIRRO   := vbairro;
                      :P124_RUA      := vendereco;
                      --
                    end;
                    ```
                itemsToSubmit: [
                    P124_CEP
                    P124_RUA
                    P124_BAIRRO
                ]
                itemsToReturn: [
                    P124_RUA
                    P124_BAIRRO
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction buscadados (
        name: BuscaDados
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P124_CPF
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    
                    select p.nomepessoa
                         , (select telefonelimpo
                              from catal.telefonespessoas
                             where idtelefonepessoa = (select max(idtelefonepessoa)
                                                         from catal.telefonespessoas
                                                        where idpessoa = p.idpessoa) ) telefone
                         , p.email
                         , to_char(p.datanascimento,'dd/mm/rrrr')
                         , p.enderecoprincipal
                         , p.numero
                         , p.bairro
                         , p.idcidade
                         , p.cep
                         --
                         , (select idrepresentante
                              from vendedoras 
                             where idpessoa = p.idpessoa) representante
                         --
                         , (select idfilial
                              from vendedoras
                             where idpessoa = p.idpessoa) filial
                         , nvl(e.idpais,p.idpais) pais
                      INTO
                       :P124_NOMECOMPLETO,
                       :P124_FONE,
                       :P124_EMAIL,
                       :P124_DATANASCIMENTO,
                       :P124_RUA,
                       :P124_NR,
                       :P124_BAIRRO,
                       :P124_IDCIDADE,
                       :P124_CEP,
                       :P124_IDREPRESENTANTE,
                       :P124_IDFILIAL,
                       :P124_IDPAIS
                      from catal.pessoas p
                         , catal.cidades c
                         , catal.estados e
                     where p.idcidade = c.idcidade
                       and c.idestado = e.idestado
                       and p.cpf = REGEXP_REPLACE (:P124_CPF,'[^0-9A-Za-z]', '') 
                       and :P124_CPF is not null;
                    
                    exception
                     when others then 
                       :P124_NOMECOMPLETO := null;
                       :P124_FONE := null;
                       :P124_EMAIL := null;
                       :P124_DATANASCIMENTO := null;
                       :P124_RUA := null;
                       :P124_NR := null;
                       :P124_BAIRRO := null;
                       :P124_IDCIDADE := null;
                       :P124_CEP := null;
                       :P124_IDREPRESENTANTE := null;
                       :P124_IDFILIAL := null;
                       :P124_IDPAIS := null;
                      -- raise_application_error(-20001,'Nenhum registro localizado para o CPF '||:P124_CPF);
                    
                    end;
                    ```
                itemsToSubmit: P124_CPF
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction buscadados-2 (
        name: Buscadados2
        execution {
            sequence: 80
        }
        when {
            selectionType: items
            items: P124_DOCUMENTOESTRANGEIRO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    
                    select p.nomepessoa
                         , (select telefonelimpo
                              from catal.telefonespessoas
                             where idtelefonepessoa = (select max(idtelefonepessoa)
                                                         from catal.telefonespessoas
                                                        where idpessoa = p.idpessoa) ) telefone
                         , p.email
                         , to_char(p.datanascimento,'dd/mm/rrrr')
                         , p.enderecoprincipal
                         , p.numero
                         , p.bairro
                         , p.idcidade
                         , p.cep
                         --
                         , (select idrepresentante
                              from vendedoras 
                             where idpessoa = p.idpessoa) representante
                         --
                         , (select idfilial
                              from vendedoras
                             where idpessoa = p.idpessoa) filial
                         , nvl(e.idpais,p.idpais) pais
                      INTO
                       :P124_NOMECOMPLETO,
                       :P124_FONE,
                       :P124_EMAIL,
                       :P124_DATANASCIMENTO,
                       :P124_RUA,
                       :P124_NR,
                       :P124_BAIRRO,
                       :P124_IDCIDADE,
                       :P124_CEP,
                       :P124_IDREPRESENTANTE,
                       :P124_IDFILIAL,
                       :P124_IDPAIS
                      from catal.pessoas p
                         , catal.cidades c
                         , catal.estados e
                     where p.idcidade = c.idcidade(+)
                       and c.idestado = e.idestado(+)
                       and p.documentoestrangeiro = :P124_DOCUMENTOESTRANGEIRO
                       and :P124_DOCUMENTOESTRANGEIRO is not null;
                    
                    exception
                     when others then 
                       --
                       :P124_NOMECOMPLETO := null;
                       :P124_FONE := null;
                       :P124_EMAIL := null;
                       :P124_DATANASCIMENTO := null;
                       :P124_RUA := null;
                       :P124_NR := null;
                       :P124_BAIRRO := null;
                       :P124_IDCIDADE := null;
                       :P124_CEP := null;
                       :P124_IDREPRESENTANTE := null;
                       :P124_IDFILIAL := null;
                       :P124_IDPAIS := null;
                       --
                       --raise_application_error(-20001,'Nenhum registro localizado para o Documento Estrangeiro '||:P124_DOCUMENTOESTRANGEIRO);
                    
                    end;
                    ```
                itemsToSubmit: P124_DOCUMENTOESTRANGEIRO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction cadastrado (
        name: CADASTRADO
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P124_CADASTRADO
        }
        clientSideCondition {
            type: item=value
            item: P124_CADASTRADO
            value: S
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P124_RUA
                    P124_NR
                    P124_BAIRRO
                    P124_COMPLEMENTO
                    P124_MSN
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P124_IDFILIAL
                    P124_NOMECOMPLETO
                    P124_IDREPRESENTANTE
                    P124_CPF
                    P124_DATANASCIMENTO
                    P124_RUA
