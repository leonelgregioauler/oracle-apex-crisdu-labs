    pageItem P124_RUT_MD5 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 680
            region: @mesa-de-crédito-dados-pessoais
            slot: regionBody
        }
        source {
            used: always
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  v_input VARCHAR2(2000) := replace(replace(:P124_DOCUMENTOESTRANGEIRO,'.',''),'-','');
                  --hexkey VARCHAR2(32) := NULL;
                  vmd5 varchar2(300);
                BEGIN
                  --
                  --hexkey := rawtohex(dbms_obfuscation_toolkit.md5(input => utl_raw.cast_to_raw(v_input)));
                  --
                  vmd5 := roman.pck_ti.fnc_md5(v_input);
                  --
                  return vmd5;
                  --
                exception
                  when others then
                    return null;
                END;
                ```
        }
        security {
            encryptSessionState: false
        }
    )

