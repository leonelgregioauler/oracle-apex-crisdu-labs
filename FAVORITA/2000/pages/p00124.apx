    pageItem P124_EMDEBITO_MSG (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: html
            sendOnPageSubmit: false
        }
        layout {
            sequence: 20
            region: @mesa-de-crédito-dados-pessoais
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                -- T10116968
                select '<font color="RED"><h2>Este CPF possui débito na Empresa! (Débito total R$ '|| to_char(nvl(sum(t.debito),0),'FM999G999G990D00')|| '). Considerar somente débito maior que R$ 5,00!'  msg
                  from(
                select ( nvl(sum( (select sum(saldo)
                                     from roman.notasvendas n
                                    where n.idvendedora = :P124_IDVENDEDORA
                                      and n.idsituacaonotavenda = 4
                                     and n.saldo > 0 ) ) ,0)
                      +  nvl(sum(( select sum(p.valorpago)
                                     from roman.pepinosrepresentantes p
                                    where regexp_replace(p.cpf,'[^0-9]','') = regexp_replace(:P124_CPF,'[^0-9]','')
                                      and p.valorsaldo > 0)),0))  debito
                  from dual
                  ) t
                having sum(t.debito) > 0
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P124_IDVENDEDORA
        }
    )

    pageItem P124_EMDEBITO_MSG_FAV (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: html
            sendOnPageSubmit: false
        }
        layout {
            sequence: 30
            region: @mesa-de-crédito-dados-pessoais
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<font color="RED"><h2> Este CPF possui débito na empresa!' msg
                  from(
                select 
                       nvl(( select sum(v.saldodevedor)
                             from vw_pedidos_fav v
                             where idvendedora    = :P124_IDVENDEDORA
                               and ididioma       = :P0_IDIDIOMA
                               and v.tipopedido   = 'P'
                               and v.saldodevedor > 0)  ,0)
                     + nvl(( select sum(nvl(b.valornegociado,valororiginal))
                             from catal.boletos b
                             where idvendedora    = :P124_IDVENDEDORA
                               and b.situacao in ('V','G','S','M','K','E','A') ) ,0)
                     + nvl(( select sum(t.saldodevedor)
                             from vw_pedidos_fav t
                             where idvendedora    = :P124_IDVENDEDORA
                               and ididioma       = 1
                               and t.tipopedido   = 'T'
                               and t.valorapagar  > 0
                               and t.saldodevedor > 0) ,0) debito
                from dual
                  ) t
                where t.debito > 0
                ```
        }
    )

    pageItem P124_ENVIADO_COBRANCA (
        type: textField
        label {
            label: Enviado Cobrança
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 280
            region: @mesa-de-crédito-dados-pessoais
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vcobranca varchar2(100);
                begin
                  --
                  select 'Sim'
                  into vcobranca
                  from dual
                  where exists ( select 1
                                 from roman.notasvendas n
                                 where n.idvendedora = :P124_IDVENDEDORA
                                   and n.saldo       > 0
                                   and n.idsituacaonotavenda = 4 
                                   and n.enviadocobranca = 'S')
                     or exists ( select 1
                                 from vendedoras v
                                 where v.idvendedora = :P124_IDVENDEDORA
                                   and v.SPC = 'S' )
                     or exists ( select 1
                                 from catal.pedidos po
                                 where po.idvendedora = :P124_IDVENDEDORA
                                   and po.situacao not in ('Q','Z')
                                   and exists ( select 1
                                                from catal.boletos b
                                                where b.idpedido = po.idpedido
                                                  and b.situacao not in ('Q','Z')
                                                  and b.responsavelcobranca is not null ) )
                     or exists ( select 1
                                 from pedidos p
                                 where p.idvendedora = :P124_IDVENDEDORA
                                   and p.datacancelamento is null
                                   and p.idsituacaocobranca > 50 
                                   and exists ( select 1
                                                from vencimentospedidos v
                                                where v.idpedido = p.idpedido
                                                  and v.situacaovencimento = 'V'
                                                  and v.datavencimento < trunc(sysdate)
                                                  and v.valorpago < v.valorpagar ) );
                  --
                  return vcobranca;
                  --
                exception
                  when others then
                    return 'Não';
                end;
                ```
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P124_IDVENDEDORA
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

