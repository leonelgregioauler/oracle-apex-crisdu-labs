    region consulta-cep (
        name: Consulta CEP
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.cep
                     , c.logradouro
                     , c.complemento
                     , c.bairro
                     , c.cidade||' - '||c.uf cidade
                     , c.ibge
                     , c.idconsultacepsac
                     , c.idcontrolecontatossite
                     , '<a href="javascript:apex.confirm(''Confirma a atualização dos dados encontrados do CEP? '', 
                             { request:''CONFIRMACEP'', set:{''P124_IDCONSULTACEPSAC'':'||idconsultacepsac||' }} )";><img src="#APP_IMAGES#ok.png"  border="0"></a>' utilizar
                from roman.consultascepsac c
                where c.idcontrolecontatossite = :P124_IDCONTROLECONTATOSSITE
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual
                where ( select count(1)
                        from roman.consultascepsac c
                        where c.idcontrolecontatossite = :P124_IDCONTROLECONTATOSSITE ) > 1
                ```
        }
