    process operação-dml-em-controle-sac (
        name: Operação DML em Controle SAC
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1);
                  vdatacadastro date;
                  vsubtiposol   varchar2(100);
                  vidpais       number; -- := 1;
                  vnumeroprocesso number;
                begin
                  if v('REQUEST') = 'INSERIR' then
                    voperacao_dml := 'I';
                    vdatacadastro := sysdate;
                  elsif v('REQUEST') = 'ATUALIZAR' then
                    voperacao_dml := 'U';
                  elsif v('REQUEST') = 'EXCLUIR' then
                    voperacao_dml := 'D';
                    vdatacadastro := to_date(:P124_DATACADASTRO,'DD/MM/RRRR HH24:MI:SS');
                  end if;
                  --
                #OWNER#.PCK_SAC_FAV.PRC_CONTROLECONTATOSSITE(
                  PIDCONTROLECONTATOSSITE => :P124_IDCONTROLECONTATOSSITE,
                  PNOMECOMPLETO => :P124_NOMECOMPLETO,
                  PCPF => :P124_CPF,
                  PDATANASCIMENTO => :P124_DATANASCIMENTO,
                  PRUA => :P124_RUA,
                  PNR => :P124_NR,
                  PCOMPLEMENTO => :P124_COMPLEMENTO,
                  PBAIRRO => :P124_BAIRRO,
                  PIDCIDADE => :P124_IDCIDADE,
                  PCEP => :P124_CEP,
                  PFONE => :P124_FONE,
                  PFONE2 => :P124_FONE2,
                  PEMAIL => :P124_EMAIL,
                  PMSN => :P124_MSN,
                  PMENSAGEM => :P124_MENSAGEM,
                  POBSERVACAO => :P124_OBSERVACAO,
                  PSITUACAO => :P124_SITUACAO,
                  PDATACADASTRO => vdatacadastro,
                  PIDFILIAL => :P124_IDFILIAL,
                  PIDREPRESENTANTE => :P124_IDREPRESENTANTE,
                  PDATALIBERADOFILIAL => :P124_DATALIBERADOFILIAL,
                  PDATAPASSADOREPRES => :P124_DATAPASSADOREPRES,
                  POBSERVACAOFILIAL => :P124_OBSERVACAOFILIAL,
                  PORIGEM => :P124_ORIGEM,
                  PTIPO => :P124_TIPO,
                  PIDFILIALORIG => :P124_IDFILIALORIG,
                  PIDREPRESENTANTEORIG => :P124_IDREPRESENTANTEORIG,
                  PIDVENDEDORAORIG => :P124_IDVENDEDORAORIG,
                  PCADASTRADO => :P124_CADASTRADO,
                  PTIPOSOLICITACAO => :P124_TIPOSOLICITACAOMANUAL,
                  PCIDADE => :P124_CIDADEMANUAL,
                  PINADIMPLENTE => :P124_INADIMPLENTE,
                  PNROCONSULTASPC => :P124_NROCONSULTASPC,
                  PUSUARIOCADASTROU => :P124_USUARIOCADASTROU,
                  PCADASTROSISTEMA => :P124_CADASTROSISTEMA,
                  PIDFILIALFAVORITA => :P124_IDFILIALFAVORITA,
                  PIDUSUARIO => :P0_IDUSUARIO,
                  PDOCUMENTOESTRANGEIRO => :P124_DOCUMENTOESTRANGEIRO,
                  PHORAATENDIMENTO => :P124_HORARIOATENDIMENTO,
                  PMD5 => :P124_MD5,
                  POPERACAO_DML => voperacao_dml,
                  PTIPOPROTOCOLO   => :P124_TIPOPROTOCOLO,
                  PIDSETOR         => :P124_IDSETOR,
                  PSUBTIPOSOL      => vsubtiposol,
                  pidpais          => :P124_IDPAIS,--vidpais,
                  PNUMEROPROCESSO => vnumeroprocesso);
                  
                  
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Registro atualizado com sucesso.
        }
        advanced {
            executionMappingIdentifier: 15605856416761041
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from dual 
                where v('REQUEST') in ('INSERIR','EXCLUIR','ATUALIZAR')
                ```
        }
    )

