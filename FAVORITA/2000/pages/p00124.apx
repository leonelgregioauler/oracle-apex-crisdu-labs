    region font-size-4-color-red-mensagem-informativa-font (
        name: <font size="4" color="red">Mensagem Informativa</font>
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                  htp.p('<h4 align="center" style="color:red;"> O cliente '||:P124_NOMECOMPLETO ||' possui idade menor de 18 anos</h4>');
                end;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P124_DATANASCIMENTO > add_months(trunc(sysdate), -216)
        }
    )

    region font-size-4-color-red-mensagem-informativa-font-2 (
        name: <font size="4" color="red">Mensagem Informativa</font>
        type: plSqlDynamicContent
        source {
            plsqlCode:
                ```plsql
                begin
                    htp.p('<h4 align="center" style="color:red;"> O CPF '||:P124_CPF ||' é inválido. Solicite o número correto.</h4>');
                end;
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                if :P124_CPF is not null then
                  if not pck_util_fav.fnc_validacpfcnpj(:P124_CPF) and :P124_IDCONTROLECONTATOSSITE is not null AND :P124_DOCUMENTOESTRANGEIRO IS NULL then
                    return true;
                  else 
                    return false;
                  end if;
