    region verifica-protocolos (
        name: Verifica Protocolos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.idcontrolecontatossite protocolo
                     , decode(c.tipoprotocolo,'S','SAC','C','Crédito',' ') tp_protocolo
                     , c.datacadastro
                     ,( select ss.descricao from roman.situacoessac ss where ss.idsituacao = c.situacao ) situacao
                     , initcap(c.nomecompleto) nome
                     , c.email
                     , c.cpf
                     , c.documentoestrangeiro
                     , c.mensagem
                  from roman.controlecontatossite c
                 where c.idcontrolecontatossite != :P124_IDCONTROLECONTATOSSITE
                   and ( (:P124_FILTRO_CONSULTA_PROTOCOLO = 'EMAIL'  and trim(c.email) = ltrim(:P124_EMAIL) ) or
                         (:P124_FILTRO_CONSULTA_PROTOCOLO = 'CPF'    and replace(replace(c.cpf,'.',''),'-','') = replace(replace(:P124_CPF,'.',''),'-','')) or
                         (:P124_FILTRO_CONSULTA_PROTOCOLO = 'DOCEST' and replace(replace(c.documentoestrangeiro,'.',''),'-','') = replace(replace(:P124_DOCUMENTOESTRANGEIRO,'.',''),'-','')) )
                         
                  
                ```
        }
        layout {
            sequence: 80
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-size600x400
