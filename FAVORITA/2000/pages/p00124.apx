    pageItem P124_DEBITO_FAVORITA (
        type: textField
        label {
            label: Débito Favorita
            alignment: left
        }
        layout {
            sequence: 270
            region: @mesa-de-crédito-dados-pessoais
            slot: regionBody
            alignment: left
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select to_char(
                       nvl(( select sum(v.saldodevedor)
                             from vw_pedidos_fav v
                             where idvendedora    = :P124_IDVENDEDORA
                               and ididioma       = :P0_IDIDIOMA
                               and v.tipopedido   = 'P'
                               and v.saldodevedor > 0)  ,0)
                     + nvl(( select sum(nvl(b.valornegociado,valororiginal))
                             from catal.boletos b
                             where idvendedora    = :P124_IDVENDEDORA
                               and b.situacao in ('V','G','S','M','K','E','A') ) ,0)
                     + nvl(( select sum(t.saldodevedor)
                             from vw_pedidos_fav t
                             where idvendedora    = :P124_IDVENDEDORA
                               and ididioma       = 1
                               and t.tipopedido   = 'T'
                               and t.valorapagar  > 0
                               and t.saldodevedor > 0) ,0), 'FM999G999G990D00', 'NLS_NUMERIC_CHARACTERS = '',.''')  debito
                from dual
                ```
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P124_IDVENDEDORA
        }
        readOnly {
            type: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P124_DEBITO_ROMANCE (
        type: textField
        label {
            label: Débito Romance
            alignment: left
