    process atualiza-situações (
        name: Atualiza Situações
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  voperacao_dml varchar2(1) := 'U';
                  vsituacao varchar2(1);
                  vdatacadastro date;
                  vsubtiposol   varchar2(100);
                  vnumeroprocesso number;
                begin
                  --
                  vdatacadastro := to_date(:P124_DATACADASTRO,'DD/MM/RRRR HH24:MI:SS');
                  --
                  if v('REQUEST') = 'PENDENTE' then
                    vsituacao := 'P';
                  elsif v('REQUEST') = 'APROVADO' then
                    vsituacao := 'C';
                  elsif v('REQUEST') = 'ENCAMINHADO' then
                    vsituacao := 'E';
                  elsif v('REQUEST') = 'POSSUI_DEBITO' then
                    vsituacao := 'D';
                  elsif v('REQUEST') = 'RESTRICAO' then
                    vsituacao := 'S';
                  elsif v('REQUEST') = 'RESPONDIDO' then
                    vsituacao := 'R';
                  elsif v('REQUEST') = 'REGIAO_NAO_ATENDIDA' then
                    vsituacao := 'N';
                  elsif v('REQUEST') = 'ATIVO' then
                    vsituacao := 'A';
                  elsif v('REQUEST') = 'INATIVO' then
                    vsituacao := 'I';
                  elsif v('REQUEST') = 'APROVADO_RESTRICAO' then
                    vsituacao := 'B';
                  elsif v('REQUEST') = 'CONCLUIDO' then
                    vsituacao := 'G';
                  elsif v('REQUEST') = 'DEBITO_TERCEIRIZADA' then
                    vsituacao := 'J';
                  elsif v('REQUEST') = 'CADASTRO_DUPLO' then
                    vsituacao := 'K';
                  elsif v('REQUEST') = 'LOJA' then
                    vsituacao := 'L';
                  elsif v('REQUEST') = 'VINCULO_DEBITO' then
                    vsituacao := 'V';
                  elsif v('REQUEST') = 'INCOMPLETO' then
                    vsituacao := 'H';
                  elsif v('REQUEST') = 'CANCELAR' then
                    vsituacao := 'W';
                  end if;
                  --
                  PCK_SAC_FAV.PRC_CONTROLECONTATOSSITE( PIDCONTROLECONTATOSSITE => :P124_IDCONTROLECONTATOSSITE,
                                                        PNOMECOMPLETO => :P124_NOMECOMPLETO,
                                                        PCPF => :P124_CPF,
                                                        PDATANASCIMENTO => :P124_DATANASCIMENTO,
                                                        PRUA => :P124_RUA,
                                                        PNR => :P124_NR,
                                                        PCOMPLEMENTO => :P124_COMPLEMENTO,
                                                        PBAIRRO => :P124_BAIRRO,
                                                        PIDCIDADE => :P124_IDCIDADE,
                                                        PCEP => :P124_CEP,
                                                        PFONE => :P124_FONE,
                                                        PFONE2 => :P124_FONE2,
                                                        PEMAIL => :P124_EMAIL,
                                                        PMSN => :P124_MSN,
                                                        PMENSAGEM => :P124_MENSAGEM,
                                                        POBSERVACAO => :P124_OBSERVACAO,
                                                        PSITUACAO => vsituacao,
                                                        PDATACADASTRO => vdatacadastro,
                                                        PIDFILIAL => :P124_IDFILIAL,
                                                        PIDREPRESENTANTE => :P124_IDREPRESENTANTE,
                                                        PDATALIBERADOFILIAL => :P124_DATALIBERADOFILIAL,
                                                        PDATAPASSADOREPRES => :P124_DATAPASSADOREPRES,
                                                        POBSERVACAOFILIAL => :P124_OBSERVACAOFILIAL,
                                                        PORIGEM => :P124_ORIGEM,
                                                        PTIPO => :P124_TIPO,
                                                        PIDFILIALORIG => :P124_IDFILIALORIG,
                                                        PIDREPRESENTANTEORIG => :P124_IDREPRESENTANTEORIG,
                                                        PIDVENDEDORAORIG => :P124_IDVENDEDORAORIG,
                                                        PCADASTRADO => :P124_CADASTRADO,
                                                        PTIPOSOLICITACAO => :P124_TIPOSOLICITACAOMANUAL,
                                                        PCIDADE => :P124_CIDADEMANUAL,
                                                        PINADIMPLENTE => :P124_INADIMPLENTE,
                                                        PNROCONSULTASPC => :P124_NROCONSULTASPC,
                                                        PUSUARIOCADASTROU => :P124_USUARIOCADASTROU,
                                                        PCADASTROSISTEMA => :P124_CADASTROSISTEMA,
                                                        PIDFILIALFAVORITA => :P124_IDFILIALFAVORITA,
                                                        PIDUSUARIO => :P0_IDUSUARIO,
                                                        PDOCUMENTOESTRANGEIRO => :P124_DOCUMENTOESTRANGEIRO,
                                                        PMD5 => :P124_MD5,
                                                        POPERACAO_DML    => voperacao_dml,
                                                        PTIPOPROTOCOLO   => :P124_TIPOPROTOCOLO,
                                                        PIDSETOR         => :P124_IDSETOR,
                                                        PSUBTIPOSOL      => vsubtiposol,
                                                        PIDPAIS          => :P124_IDPAIS,
                                                        PNUMEROPROCESSO => vnumeroprocesso);
                  --
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Cadastro atualizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1438872646687602116
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: v('REQUEST') in ('APROVADO','ATIVO','ENCAMINHADO','POSSUI_DEBITO','RESTRICAO','REGIAO_NAO_ATENDIDA','RESPONDIDO','APROVADO_RESTRICAO','INATIVO','PENDENTE','CONCLUIDO','DEBITO_TERCEIRIZADA','CADASTRO_DUPLO','LOJA','VINCULO_DEBITO','INCOMPLETO','CANCELAR')
        }
    )

    process consulta-cep (
        name: Consulta CEP
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  -- Call the procedure
                  pck_sac_fav.prc_consultacepsac(pidcontrolecontatossite => :P124_IDCONTROLECONTATOSSITE);
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: "CEP consultado com sucesso! "
        }
        advanced {
            executionMappingIdentifier: 1444666041403095134
        }
        serverSideCondition {
            type: request=Value
            value: CONSULTAR_CEP
        }
    )

    process consulta-controle-sac (
        name: Consulta Controle SAC
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  vcpf                varchar2(15);
                  vcep                varchar2(20);
                  vdatacadastro       date;
                  vdatanascimento     date;
                  vidpessoa           number;
                  vidvendedora        number;
                  vsubtiposol         varchar2(100);
                  vidpais             number;
                  vnumeroprocesso     number;
                begin
                  --
                  PCK_SAC_FAV.PRC_CONTROLECONTATOSSITE( PIDCONTROLECONTATOSSITE => :P124_IDCONTROLECONTATOSSITE,
                                                        PNOMECOMPLETO           => :P124_NOMECOMPLETO,
                                                        PCPF                    => vcpf,
                                                        PDATANASCIMENTO         => vdatanascimento,
                                                        PRUA                    => :P124_RUA,
                                                        PNR                     => :P124_NR,
                                                        PCOMPLEMENTO            => :P124_COMPLEMENTO,
                                                        PBAIRRO                 => :P124_BAIRRO,
                                                        PIDCIDADE               => :P124_IDCIDADE,
                                                        PCEP                    => vcep,
                                                        PFONE                   => :P124_FONE,
                                                        PFONE2                  => :P124_FONE2,
                                                        PEMAIL                  => :P124_EMAIL,
                                                        PMSN                    => :P124_MSN,
                                                        PMENSAGEM               => :P124_MENSAGEM,
                                                        POBSERVACAO             => :P124_OBSERVACAO,
                                                        PSITUACAO               => :P124_SITUACAO,
                                                        PDATACADASTRO           => vdatacadastro,
                                                        PIDFILIAL               => :P124_IDFILIAL,
                                                        PIDREPRESENTANTE        => :P124_IDREPRESENTANTE,
                                                        PDATALIBERADOFILIAL     => :P124_DATALIBERADOFILIAL,
                                                        PDATAPASSADOREPRES      => :P124_DATAPASSADOREPRES,
                                                        POBSERVACAOFILIAL       => :P124_OBSERVACAOFILIAL,
                                                        PORIGEM                 => :P124_ORIGEM,
                                                        PTIPO                   => :P124_TIPO,
                                                        PIDFILIALORIG           => :P124_IDFILIALORIG,
                                                        PIDREPRESENTANTEORIG    => :P124_IDREPRESENTANTEORIG,
                                                        PIDVENDEDORAORIG        => :P124_IDVENDEDORAORIG,
                                                        PCADASTRADO             => :P124_CADASTRADO,
                                                        PTIPOSOLICITACAO        => :P124_TIPOSOLICITACAOMANUAL,
                                                        PCIDADE                 => :P124_CIDADEMANUAL,
                                                        PINADIMPLENTE           => :P124_INADIMPLENTE,
                                                        PNROCONSULTASPC         => :P124_NROCONSULTASPC,
                                                        PUSUARIOCADASTROU       => :P124_USUARIOCADASTROU,
                                                        PCADASTROSISTEMA        => :P124_CADASTROSISTEMA,
                                                        PIDFILIALFAVORITA       => :P124_IDFILIALFAVORITA,
                                                        PIDUSUARIO              => :P124_IDUSUARIO,
                                                        PDOCUMENTOESTRANGEIRO   => :P124_DOCUMENTOESTRANGEIRO,
                                                        PHORAATENDIMENTO        => :P124_HORARIOATENDIMENTO,
                                                        PMD5                    => :P124_MD5,
                                                        POPERACAO_DML           => 'S',
                                                        PTIPOPROTOCOLO          => :P124_TIPOPROTOCOLO,
                                                        PIDSETOR                => :P124_IDSETOR,
                                                        PSUBTIPOSOL             => vsubtiposol,
                                                        pidpais                 => vidpais,
                                                        PNUMEROPROCESSO         => vnumeroprocesso);
                  --
                  :P124_CPF            := REGEXP_REPLACE(vcpf,  '^(\d{3})(\d{3})(\d{3})(\d{2})$', '\1.\2.\3-\4');
                  :P124_CEP            := REGEXP_REPLACE(vcep,  '^(\d{2})(\d{3})(\d{3})$', '\1.\2-\3');
                  :P124_DATACADASTRO   := to_char(vdatacadastro,'DD/MM/RRRR HH24:MI:SS');
                  :P124_DATANASCIMENTO := to_char(vdatanascimento,'DD/MM/RRRR');
                  :P124_IDPAIS         := vidpais;
                  --
                  -- busca numero de serie para enviar ao consultaequifax
                  begin
                    select documentoestrangeiro
                      into :P124_NUMEROSERIE
                      from roman.consultaspc p
                     where idconsultaspc = (select max(idconsultaspc)
                                              from roman.consultaspc 
                                             where runrut = :P124_DOCUMENTOESTRANGEIRO
                                               and idpais = vidpais) ;
                  exception
                    when others then null;
                  end;
                  -- Maicon Aimi - 16/09/2024 - 9364857
                  -- busca id pessoa e id vendedora
                  begin
                    select v.idpessoa
                         , v.idvendedora
                      into :P124_IDPESSOA
                         , :P124_IDVENDEDORA
                      from catal.vendedoras v
                     where (    ( v.idpessoa = (select p.idpessoa
                                                  from catal.pessoas p
                                                 where p.cpf = regexp_replace(:P124_CPF,'[^0-9]','')))
                             or
                                ( v.idpessoa = (select p.idpessoa
                                                  from catal.pessoas p
                                                 where trim(p.documentoestrangeiro) = trim(:P124_DOCUMENTOESTRANGEIRO))));
                  exception
                    when others then
                      :P124_IDPESSOA := null;
                      :P124_IDVENDEDORA := null;
                  end;
                
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterHeader
        }
        advanced {
            executionMappingIdentifier: 14554527043925030
        }
    )

    process deletar-tarefa (
        name: Deletar Tarefa
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidtipotarefa        number;
                  vidticketcallcenter  number;
                  vtelefone            varchar2(20);
                  vdatainclusao        date;
                  vprioridade          number;
                  vidsituacao          number;
                  vobservacao          varchar2(100);
                  vidusuario           number;
                  vidpessoa            number;
                  vidgrupoatendimento  number;
                  vdatainicio          date;
                  vdataconclusao       date;
                  vnumeroposicaoatendimento varchar2(10);
                  vidpedido            number;
                  vcodigoarea          number;
                  vmd5                 varchar2(1000);
                  --
                  vidcaracteristicasac number;
                  --
                begin
                  --
                  select idtipotarefa
                  into vidtipotarefa
                  from tarefas t
                  where t.idtarefa = :P124_IDEDITAR;
                  --
                  if vidtipotarefa = 23 then
                    --
                    vidcaracteristicasac := 21;
                    --
                  elsif vidtipotarefa = 10 then
                    --
                    vidcaracteristicasac := 23;
                    --
                  elsif vidtipotarefa = 15 then
                    --
                    vidcaracteristicasac := 22;
                    --
                  end if;
                  --
                  delete roman.classificacoessac c
                  where c.idcontrolecontatossite = :P124_IDCONTROLECONTATOSSITE
                    and c.idcaracteristicasac = vidcaracteristicasac;
                  --
                  pck_tarefas_fav.prc_tarefas(pidtarefa => :P124_IDEDITAR,
                                              pidtipotarefa => vidtipotarefa,
                                              pidticketcallcenter => vidticketcallcenter,
                                              ptelefone => vtelefone,
                                              pdatainclusao => vdatainclusao,
                                              pprioridade => vprioridade,
                                              pidsituacao => vidsituacao,
                                              pobservacao => vobservacao,
                                              pidusuario => vidusuario,
                                              pidpessoa => vidpessoa,
                                              pidgrupoatendimento => vidgrupoatendimento,
                                              pdatainicio => vdatainicio,
                                              pdataconclusao => vdataconclusao,
                                              pnumeroposicaoatendimento => vnumeroposicaoatendimento,
                                              pidpedido => vidpedido,
                                              pcodigoarea => vcodigoarea,
                                              pmd5 => vmd5,
                                              poperacao_dml => 'D');
                  --
                end;
                ```
        }
        execution {
            sequence: 70
        }
        successMessage {
            successMessage: Tarefa Excluída com sucesso!
        }
        advanced {
            executionMappingIdentifier: 1495077391519765305
        }
        serverSideCondition {
            type: request=Value
            value: EXCLUIR_TAREFA
        }
    )

    process envia-indicação-para-o-painel (
        name: Envia indicação para o Painel
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vidclassificacaosac number;
                  vidcaracteristicasac number := 37;
                  vdataclassificado date := sysdate;
                  vidusuario number;
                  vidvalorclassificacao number;
                  vobservacao varchar2(1000);
                  vmd5 varchar2(1000);
                  --
                  vidcontrolecontatossite number := :P124_IDCONTROLECONTATOSSITE;
                  vidfilial number := :P124_IDFILIAL;
                  
                begin
                  --
                  select idusuario
                  into vidusuario 
                  from usuarios 
                  where usuario = v('APP_USER');
                  --
                  roman.pck_cadastros_rmc.prc_classificacoessac(pidclassificacaosac     => vidclassificacaosac,
                                                          pidcontrolecontatossite => :P124_IDCONTROLECONTATOSSITE,
                                                          pidcaracteristicasac    => vidcaracteristicasac,
                                                          pdataclassificado       => vdataclassificado,
                                                          pidusuario              => vidusuario,
                                                          pidvalorclassificacao   => vidvalorclassificacao,
                                                          pobservacao             => vobservacao,
                                                          pmd5                    => vmd5,
                                                          poperacao_dml           => 'I');
                  --
                  insert into roman.painelcontatossite (idpainelcontatossite,
                                                        idcontrolecontatossite,
                                                        idsituacaopainel,
                                                        datasituacao,
                                                        iddistribuidor,
                                                        idfilial,
                                                        observacao)
                  values  ( roman.seq_painelcontatossite.nextval
                         , vidcontrolecontatossite
                         , 0
                         , sysdate
                         , null
                         , vidfilial
                         , null);
                end;
                ```
        }
        execution {
            sequence: 80
        }
        successMessage {
            successMessage: Indicação disponibilizada com sucesso!
        }
        advanced {
            executionMappingIdentifier: 3737924440612245
        }
        serverSideCondition {
            type: request=Value
            value: ENVIAR_PAINEL
        }
    )

    process gerar-tarefa-de-contato-lead (
        name: Gerar Tarefa de Contato Lead
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  --
                  vtipotarefa number;
                  videstado   number;
                  vidusuario  number;
                  --
                begin
                  --
                  begin
                    select c.idestado
                    into videstado
                    from roman.cidades c
                    where c.idcidade = :P124_IDCIDADE;
                  exception
                    when others then
                      videstado := 0;
                  end;
                  --
                  if v('REQUEST') = 'GERAR_TARAFA_ANL' then
                    --
                    vtipotarefa := 36;
                    vidusuario := :P124_IDUSUARIO_RECEBER;
                    --
                    /*if videstado = 43 then
                      vtipotarefa := 36;
                      vidusuario := :P124_IDUSUARIO_RECEBER;
                    else
                      vtipotarefa := 23;
                      vidusuario := :P124_IDUSUARIO_RECEBER;
                    end if;*/
                    --
                  elsif v('REQUEST') = 'GERARTAREFACOB' then
                    vtipotarefa := 10;
                    vidusuario := :P0_IDUSUARIO;
                  elsif v('REQUEST') = 'GERARTAREFAPOS' then
                    vtipotarefa := 15;
                    vidusuario := :P0_IDUSUARIO;
                  end if;
                  --
                  pck_sac_fav.prc_gerartarefaatendimento( pidcontrolecontatossite => :P124_IDCONTROLECONTATOSSITE
                                                        , pidtipotarefa => vtipotarefa 
                                                        , pidusuario => vidusuario );
                  --
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Tarefa Criada com Sucesso!
        }
        advanced {
            executionMappingIdentifier: 2058534779290183350
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
