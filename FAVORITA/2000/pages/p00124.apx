    region consulta-ao-spc (
        name: Consulta ao SPC
        type: interactiveReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                  --
                  v_sql clob;
                  --
                begin
                  --
                  if :P124_IDPAIS = 4 then
                    v_sql := q'~
                        select c.dataconsulta
                             , c.protocolo
                             , c.nome
                             , c.nomemae
                             , c.datanascimento
                             , c.email
                             , c.regiaocpf
                             , c.situacaocpf
                             , c.rua
                             , c.numeroendereco
                             , c.complemento
                             , c.bairro
                             , c.cep
                             , c.spc_quantidade
                             , c.spc_valortotal
                             , c.spc_valorultimaocorrencia
                             , c.restricao
                             , c.idconsultaspc
                             , c.cpf
                        from favorita.vw_consultaspc_fav c
                        where c.documentoestrangeiro = replace(replace(:P124_DOCUMENTOESTRANGEIRO,'.',''),'-','') ~';
                    --
                  elsif :P124_IDPAIS = 6 then
                    --
                    v_sql := q'~
                        select c.dataconsulta
                             , c.protocolo
                             , c.nome
                             , c.nomemae
                             , c.datanascimento
                             , c.email
                             , c.regiaocpf
                             , c.situacaocpf
                             , c.rua
                             , c.numeroendereco
                             , c.complemento
                             , c.bairro
                             , c.cep
                             , c.spc_quantidade
                             , c.spc_valortotal
                             , c.spc_valorultimaocorrencia
                             , c.restricao
                             , c.idconsultaspc
                             , c.cpf
                        from favorita.vw_consultaspc_fav c
                        where c.runrut = replace(replace(:P124_DOCUMENTOESTRANGEIRO,'.',''),'-','') ~';
                    --
                  elsif :P124_IDPAIS = 2 then
                    --
                    v_sql := q'~
                        select c.dataconsulta
                             , c.protocolo
                             , c.nome
                             , c.nomemae
                             , c.datanascimento
                             , c.email
                             , c.regiaocpf
                             , c.situacaocpf
                             , c.rua
                             , c.numeroendereco
                             , c.complemento
                             , c.bairro
                             , c.cep
                             , c.spc_quantidade
                             , c.spc_valortotal
                             , c.spc_valorultimaocorrencia
                             , c.restricao
                             , c.idconsultaspc
                             , c.cpf
                        from favorita.vw_consultaspc_fav c
                        where c.documentoestrangeiro = replace(replace(:P124_DOCUMENTOESTRANGEIRO,'.',''),'-','') ~';
                    --
                  else
                    --
                    v_sql := q'~
                        select c.dataconsulta
                             , c.protocolo
                             , c.nome
                             , c.nomemae
                             , c.datanascimento
                             , c.email
                             , c.regiaocpf
                             , c.situacaocpf
                             , c.rua
                             , c.numeroendereco
                             , c.complemento
                             , c.bairro
                             , c.cep
                             , c.spc_quantidade
                             , c.spc_valortotal
                             , c.spc_valorultimaocorrencia
                             , c.restricao
                             , c.idconsultaspc
                             , c.cpf
                        from favorita.vw_consultaspc_fav c
                        where c.cpf = replace(replace(:P124_CPF,'.',''),'-','') ~';
                    --
                  end if;
                  --
                  return v_sql;
                  --
                end ;
                
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from vw_consultaspc_fav c
                where coalesce(c.cpf, c.runrut, c.documentoestrangeiro) = replace(replace(nvl(:P124_CPF,:P124_DOCUMENTOESTRANGEIRO),'.',''),'-','')
                ```
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1438873282707602122
        }

