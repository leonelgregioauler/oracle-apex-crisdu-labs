    pageItem P124_IDREPRESENTANTE (
        type: popupLov
        label {
            label: Indicar Distribuidor
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROMAN.pck_romance.fnc_nomerepresentante(idrepresentante) DISPLAY_VALUE
                     , idrepresentante RETURN_VALUE
                from representantes r
                where (:P124_IDFILIAL is null or
                    ( :P124_IDFILIAL is not null and idgerente in ( select idgerente from gerentes where idfilial = :P124_IDFILIAL) ) or
                    ( :P124_IDFILIAL is not null and r.idpostoavancado = (select 1
                                                                          from roman.postoavancado p
                                                                          where p.idpostoavancado = r.idpostoavancado )))
                  and r.ativo = 'S' 
                order by 1
                ```
            nullDisplayValue: Não Informar
        }
        cascadingLov {
            parentItems: P124_IDFILIAL
        }
        layout {
            sequence: 470
            region: @mesa-de-crédito-dados-pessoais
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuarios u
                where u.idfilialfavorita is null
                  and u.usuario = v('APP_USER')
                union
                select 1
                from roman.usuariosgruposatendimento ug
                where ug.usuario = v('APP_USER')
                  and ug.idgrupoatendimento in (48,22)
                ```
        }
        security {
            encryptSessionState: false
        }
    )

