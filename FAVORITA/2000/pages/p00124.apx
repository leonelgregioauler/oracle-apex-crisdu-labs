    pageItem P124_MENSAGEMCADASTRODUPLO (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: html
            sendOnPageSubmit: false
        }
        layout {
            sequence: 80
            region: @mesa-de-crédito-dados-pessoais
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select case when t.verifica = 1 then
                                 '<font color="green"><h2>'||t.verifica||' Protocolo possui o mesmo email cadastrado! Clique aqui para visualizar.</h2></font>'
                                 when t.verifica > 1 then
                                 '<font color="green"><h2>'||t.verifica||' Protocolos possuem o mesmo email cadastrado! Clique aqui para visualizar.</h2></font>'
                                 else
                                 null
                       end msg
                  from ( select COUNT(c.idcontrolecontatossite) verifica
                           from roman.controlecontatossite c
                          where c.idcontrolecontatossite != :P124_IDCONTROLECONTATOSSITE
                            and c.email = :P124_EMAIL
                  ) t
                ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.controlecontatossite c
                where c.idcontrolecontatossite != :P124_IDCONTROLECONTATOSSITE
                  and c.email = :P124_EMAIL
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P124_MENSAGEMCPF (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: html
            sendOnPageSubmit: false
        }
        layout {
            sequence: 40
            region: @mesa-de-crédito-dados-pessoais
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select case when t.verifica = 1 then
                                 '<font color="blue"><h2>'||t.verifica||' Protocolo possui o mesmo CPF cadastrado! Clique aqui para visualizar.</h2></font>'
                                 when t.verifica > 1 then
                                 '<font color="blue"><h2>'||t.verifica||' Protocolos possuem o mesmo CPF cadastrado! Clique aqui para visualizar.</h2></font>'
                                 else
                                 null
                       end msg
                  from(
                select count(c.idcontrolecontatossite) verifica
                from roman.controlecontatossite c
                where c.idcontrolecontatossite != :P124_IDCONTROLECONTATOSSITE
                  and replace(replace(c.cpf,'.',''),'-','') = replace(replace(:P124_CPF,'.',''),'-','')
                  and c.cpf is not null
                  and :P124_CPF is not null
                  ) t
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.controlecontatossite c
                where c.idcontrolecontatossite != :P124_IDCONTROLECONTATOSSITE
                  and replace(replace(c.cpf,'.',''),'-','') = replace(replace(:P124_CPF,'.',''),'-','')
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P124_MENSAGEM_DEBITOANTIGO (
        type: displayOnly
