    pageItem P124_SITUACAOCLIENTE (
        type: displayOnly
        label {
            label: SItuação da Cliente
            alignment: left
        }
        layout {
            sequence: 200
            region: @mesa-de-crédito-dados-pessoais
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare 
                  vsituacao varchar2(100);
                begin
                  --
                  begin 
                    --
                    select situacao
                      into vsituacao
                     from(
                    select decode(v.ativo,'S','Ativa','N','Inativa') situacao
                    from vendedoras v
                       , pessoas p
                       , roman.controlecontatossite c
                    where v.idpessoa = p.idpessoa
                      and p.cpf      = trim(replace(replace(c.cpf,'.',''),'-',''))
                      and :P124_cpf is not null
                      and :P124_documentoestrangeiro is null
                      and c.idcontrolecontatossite = :P124_IDCONTROLECONTATOSSITE
                    union
                    select decode(v.ativo,'S','Ativa','N','Inativa') situacao
                    from vendedoras v
                       , pessoas p
                       , roman.controlecontatossite c
                    where v.idpessoa = p.idpessoa
                      and p.documentoestrangeiro = c.documentoestrangeiro
                      and :P124_cpf is null
                      and :P124_documentoestrangeiro is not null
                      and c.idcontrolecontatossite = :P124_IDCONTROLECONTATOSSITE);
                    --
                  exception
                    when no_data_found then
                      vsituacao := 'Não Cadastrado!';
                  end;
                  --
                  return vsituacao;
                  --
                end;
                ```
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P124_IDCONTROLECONTATOSSITE
        }
        security {
            encryptSessionState: false
        }
    )

