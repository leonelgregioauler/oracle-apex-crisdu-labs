        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select '<font color="RED"><h2>Esse CPF possui '||sum(pr.valorsaldo)||' de Saldo em Débitos Antigos!' msg 
                from roman.pepinosrepresentantes pr
                where pr.cpf = replace(replace(:P124_CPF,'-',''),'.','')
                  and pr.valorsaldo > 0
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman. pepinosrepresentantes pr
                where pr.cpf = replace(replace(:P124_CPF,'-',''),'.','')
                  and pr.valorsaldo > 0
                    
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P124_MENSAGEM_DOCESTR (
        type: displayOnly
        label {
            alignment: left
        }
        settings {
            format: html
            sendOnPageSubmit: false
        }
        layout {
            sequence: 50
            region: @mesa-de-crédito-dados-pessoais
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select case when t.verifica = 1 then
                                 '<font color="blue"><h2>'||t.verifica||' Protocolo possui o mesmo Doc Estrangeiro cadastrado! Clique aqui para visualizar</h2></font>'
                                 when t.verifica > 1 then
                                 '<font color="blue"><h2>'||t.verifica||' Protocolos possuem o mesmo Doc Estrangeiro cadastrado! Clique aqui para visualizar</h2></font>'
                                 else
                                 null
                       end msg
                  from( select count(*) verifica
                          from roman.controlecontatossite c
                         where c.idcontrolecontatossite != :P124_IDCONTROLECONTATOSSITE
                           and replace(replace(c.documentoestrangeiro,'.',''),'-','') = replace(replace(:P124_DOCUMENTOESTRANGEIRO,'.',''),'-','')
                      ) t;
                ```
            used: always
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                from roman.controlecontatossite c
                where c.idcontrolecontatossite != :P124_IDCONTROLECONTATOSSITE
                  and replace(replace(c.documentoestrangeiro,'.',''),'-','') = replace(replace(:P124_DOCUMENTOESTRANGEIRO,'.',''),'-','')
                ```
        }
        security {
            encryptSessionState: false
        }
    )

