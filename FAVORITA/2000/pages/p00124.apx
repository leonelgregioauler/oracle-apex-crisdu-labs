page 124 (
    name: Mesa de Crédito
    title: Mesa de Crédito
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        fileUrls: [
            https://websocket.romancemoda.com.br/romance_spc.js
            https://websocket.romancemoda.com.br/romance_equifax.js
            https://websocket.romancemoda.com.br/romance_equifax_py.js
            https://websocket.romancemoda.com.br/romance_equifax_uy.js
        ]
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function fnc_excluir(pid)
            {
              document.getElementById("P124_IDEDITAR").value = pid;
              apex.submit('EXCLUIR_TAREFA');
            }
            ```
    }
    security {
        pageAccessProtection: unrestricted
    }

    region ações (
        name: Ações
        type: staticContent
        layout {
            sequence: 20
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery:
                ```sql
                select 1
                from usuarios u
                where exists ( select 1
                               from favorita.filiaisfavorita ff
                               where ff.idfilialfavorita = u.idfilialfavorita
                                 and ff.tipofilial       = 'L' )
                  and u.usuario = v('APP_USER')
                ```
        }
    )

    region ações-especiais (
        name: Ações Especiais
        type: staticContent
        layout {
            sequence: 40
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: favorita.pck_util_fav.fnc_verificaacesso(52108,:P0_IDUSUARIO) = 'S'
        }
    )

    region classificações (
        name: Classificações
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.idclassificacaosac
                     , w.dataclassificado
                     , w.usuario
                     , w.caracteristica
                     , w.observacao
                from roman.vw_classificacoessac w
                where w.idcontrolecontatossite = :P124_IDCONTROLECONTATOSSITE  
                order by w.dataclassificado desc 
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 1414247545868133335
        }

