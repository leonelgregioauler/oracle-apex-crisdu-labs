    pageItem P124_IDFILIAL (
        type: selectList
        label {
            label: Indicar Empresa
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.nome
                     , f.idfilial
                from roman.vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'D'
                union
                select f.nome
                     , f.idfilial
                from roman.vw_filiais f
                where f.idfilial in (360,1222) 
                union
                select f.nome
                     , f.idfilial
                from roman.vw_filiais f
                where f.ativo = 'S'
                  and f.tipofilial = 'A'
                union        
                select listagg(a.nome || ' - ' || coalesce(roman.pck_romance.fnc_nomefilial(a.idfilial), ' '), '; ')
                        within group ( order by a.nome ) nome
                    ,  a.idpostoavancado 
                  from roman.postoavancado a
                  where ativo = 'S'
                group by a.idpostoavancado 
                ```
        }
        layout {
            sequence: 110
            region: @mesa-de-crédito-dados-pessoais
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

