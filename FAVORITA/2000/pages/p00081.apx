page 81 (
    name: Relatório de Categorias Site
    title: Categorias Site
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region categorias-site (
        name: Categorias Site
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select idcategoriasite
                     , nomecategoria
                     , textotraduzido
                     , ativo
                     , ididioma
                     , idtexto
                  from vw_categoriassite_fav
                 where ididioma = :P0_IDIDIOMA
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        messages {
            whenNoDataFound: Não encontrou informações.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 12456852049957360
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @IDCATEGORIASITE
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @ATIVO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IDTEXTO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @NOMECATEGORIA
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @TEXTOTRADUZIDO
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @IDIDIOMA
                layout {
                    sequence: 11
                }
            )

        )

        column ATIVO (
            type: selectList
            heading {
                heading: Ativo
                alignment: center
            }
            lov {
                type: sharedComponent
                lov: @lov-simnao
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                databaseColumn: ATIVO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column IDCATEGORIASITE (
            type: link
            heading {
                heading: Editar
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            link {
                target: {
                    page: 82
                    items: {
                        P82_IDCATEGORIASITE: &IDCATEGORIASITE.
                    }
                    action: resetPagination
                }
                linkText: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            }
            source {
                databaseColumn: IDCATEGORIASITE
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDIDIOMA (
            type: hidden
            layout {
                sequence: 60
            }
            source {
                databaseColumn: IDIDIOMA
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column IDTEXTO (
            type: link
            heading {
                heading: Tradução
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            link {
                target: {
                    page: 100
                    items: {
                        P100_IDTEXTOTRADUZIDO: &IDTEXTO.
                    }
                    action: resetPagination
                }
                linkText: <b>Visualizar / Atualizar texto traduzido</b>
                linkAttributes: class="t-Button t-Button--sucess"
            }
            source {
                databaseColumn: IDTEXTO
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column NOMECATEGORIA (
            type: textarea
            heading {
                heading: Categoria
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: NOMECATEGORIA
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column TEXTOTRADUZIDO (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: TEXTOTRADUZIDO
                dataType: varchar2
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

    )

    region opções (
        name: Opções
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--scrollBody
            ]
        }
    )

    button novo (
        buttonName: Novo
        label: Novo
        layout {
            sequence: 10
            region: @opções
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 82
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

