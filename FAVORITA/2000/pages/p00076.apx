    dynamicAction tipo-de-pesquisa (
        name: Tipo de Pesquisa
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P76_TIPOPESQUISA
        }
        clientSideCondition {
            type: item=value
            item: P76_TIPOPESQUISA
            value: R
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P76_REFERENCIA
                    P76_IDPRODUTO
                ]
            }
            execution {
                sequence: 20
