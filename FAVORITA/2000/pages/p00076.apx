                ```sql
                select 1
                from dual
                where not exists ( select 1
                                   from itenscomprastransferencias i
                                   where i.idcompratransferencia = :P76_IDCOMPRATRANSFERENCIA )
                  and exists ( select 1
                               from edicoesrevistascompras e 
                               where e.idcompratransferencia = :P76_IDCOMPRATRANSFERENCIA )
                union
                select 1
                from dual
                where v('APP_USER') in ('GUILHERME','FELIPEGB')
                ```
