    region produtos-para-efetuar-compra-remessa (
        name: Produtos para Efetuar Compra/Remessa
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pck_util_fav.fnc_nomeprodutodetalhado(i.idprodutodetalhado,1) prod
                     , ( select pck_estoque_fav.fnc_estoquedisponivel(e.idestoque)
                         from estoques e
                         where e.idprodutodetalhado = i.idprodutodetalhado
                           and e.idfilialfavorita = ( select c.idfilialfavoritadestino
                                                      from comprastransferencias c
                                                      where c.idcompratransferencia = i.idcompratransferencia ) ) qtdestoque
                     , (select qtdestoqueminimo
                        from estoques e
                        where e.idestoque = i.idestoquefildestino ) qtdestoqueminimo  
                     , (select qtdestoquemaximo
                        from estoques e
                        where e.idestoque = i.idestoquefildestino ) qtdestoquemaximo
                     , nvl(( select sum(Ip.QUANTIDADE)
                             from pedidos p
                                , itenspedidos ip
                             where p.idpedido   = ip.idpedido
                               and ip.idestoque = i.idestoquefildestino
                               and p.idedicaorevista in ( select e.idedicaorevista
                                                          from edicoesrevistascompras e 
                                                          where e.idcompratransferencia = :P76_IDCOMPRATRANSFERENCIA )
                               and trunc(p.dataemissao) between  to_date(:P76_DATAINI,'DD/MM/RRRR') and to_date(:P76_DATAFIM,'DD/MM/RRRR')),0) "Qtd Total Saída" 
                     , NVL(( select sum(itc.quantidadecomprada) 
                             from comprastransferencias ct 
                                , itenscomprastransferencias itc
                             where itc.idprodutodetalhado = i.idprodutodetalhado
                               and itc.idcompratransferencia = ct.idcompratransferencia
                               and itc.idcompratransferencia != :P76_IDCOMPRATRANSFERENCIA
                               and ct.idsituacao in (10,20,30)
                               and ct.idcompratransferencia != :P76_IDCOMPRATRANSFERENCIA
                               and ct.idfilialfavoritadestino = :P76_IDFILIALFAVORITA),0) "Qtd Comprada"
                     , nvl(( select sum(Ip.QUANTIDADE)
                             from pedidos p
                                , itenspedidos ip
                             where p.idpedido   = ip.idpedido
                               and ip.idestoque = i.idestoquefildestino
                               and trunc(p.dataemissao) between  to_date(:P76_DATAINI,'DD/MM/RRRR') and to_date(:P76_DATAFIM,'DD/MM/RRRR')),0) "Qtd Total Saída Acumulada" 
                   , i.valorcusto
                   , quantidadecomprada 
                   , i.quantidadecomprada * i.valorcusto "Total Item"
                   , i.observacao
                   ,  ( select descontinuado
                        from produtosdetalhados 
                        where idprodutodetalhado = i.idprodutodetalhado ) descontinuado
                from itenscomprastransferencias i
                where i.idcompratransferencia = :P76_IDCOMPRATRANSFERENCIA
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent5
                t-Region--scrollBody
