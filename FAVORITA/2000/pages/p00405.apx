page 405 (
    name: Nota Fiscal PDF
    title: Nota Fiscal PDF
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region new (
        name: New
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P405_NOMEARQUIVOXML (
        type: textField
        label {
            label: Nome arquivo XML
            alignment: left
        }
        layout {
            sequence: 10
            region: @new
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    process abrir-pdf-da-nota-fiscal (
        name: Abrir PDF da Nota Fiscal
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  varquivopdf varchar2(100) := replace(:P405_NOMEARQUIVOXML,'.xml','.pdf');
                begin
                  -- Call the procedure
                  crisdu.pck_notasfiscais_crd.prc_abreaqruivo_web(pnomearquivo => varquivopdf);
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 1560812280608066949
        }
    )

)

