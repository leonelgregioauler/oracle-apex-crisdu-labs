page 238 (
    name: Logs de Pagamentos
    title: Logs de Pagamentos
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: unrestricted
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region log-pagamentos-pedidos (
        name: Log Pagamentos Pedidos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.idlog
                     , p.usuarioalteracao
                     , p.idpagamentopedido
                     , p.desctipoalteracao  
                     , p.dataalteracao
                     , p.idvencimentopedido
                     , p.formapagamento
                     , p.datapagamento
                     , p.valorpago
                     , p.descorigempagamento
                     , p.idtarefa
                     , p.numeroboleto
                     , p.situacaopagamento
                     , p.taxa
                     , p.acrescimo
                     , p.desconto
                     , p.valorliquido
                     , p.numerocomprovante
                     , p.idcontabancaria
                     , p.observacao
                     , p.idsemanapago
                     , p.usuarionegociacao
                     , p.nomeusuario
                     , p.juros
                from favorita.vw_log_pagamentospedidos_fav p
                where p.ididioma = :P0_IDIDIOMA
                  and p.idvencimentopedido in (select idvencimentopedido
                                                 from vencimentospedidos
                                                where idpedido = :P238_IDPEDIDO)
                order by 1 desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1145294317968273119
        }

