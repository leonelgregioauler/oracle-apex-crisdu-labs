    pageItem P238_IDPEDIDO (
        type: textField
        label {
            label: Nr Pedido
            alignment: left
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button filtros (
        buttonName: FILTROS
        label: Filtrar
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 238
                items: {
                    P238_IDPEDIDO: &P238_IDPEDIDO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @filtros
        }
    )

)

